 687:./inc/cmsis_gcc.h ****   uint32_t result;
 688:./inc/cmsis_gcc.h ****   __ASM volatile ("MRS %0, psplim_ns"  : "=r" (result) );
 689:./inc/cmsis_gcc.h ****   return result;
 690:./inc/cmsis_gcc.h **** #endif
 691:./inc/cmsis_gcc.h **** }
 692:./inc/cmsis_gcc.h **** #endif

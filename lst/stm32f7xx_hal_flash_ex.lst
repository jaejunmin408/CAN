 700:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= FLASH_CR_STRT;
 701:./src/stm32f7xx_hal_flash_ex.c ****   
 702:./src/stm32f7xx_hal_flash_ex.c ****   /* Data synchronous Barrier (DSB) Just after the write operation
 703:./src/stm32f7xx_hal_flash_ex.c ****      This will force the CPU to respect the sequence of instruction (no optimization).*/
 704:./src/stm32f7xx_hal_flash_ex.c ****   __DSB();
 705:./src/stm32f7xx_hal_flash_ex.c **** }

 131:./src/stm32f7xx_hal_flash_ex.c **** /** @defgroup FLASHEx_Exported_Functions_Group1 Extended IO operation functions
 132:./src/stm32f7xx_hal_flash_ex.c ****  *  @brief   Extended IO operation functions 
 133:./src/stm32f7xx_hal_flash_ex.c ****  *
 134:./src/stm32f7xx_hal_flash_ex.c **** @verbatim   
 135:./src/stm32f7xx_hal_flash_ex.c ****  ===============================================================================
 136:./src/stm32f7xx_hal_flash_ex.c ****                 ##### Extended programming operation functions #####
 137:./src/stm32f7xx_hal_flash_ex.c ****  ===============================================================================  
 138:./src/stm32f7xx_hal_flash_ex.c ****     [..]
 139:./src/stm32f7xx_hal_flash_ex.c ****     This subsection provides a set of functions allowing to manage the Extension FLASH 
 140:./src/stm32f7xx_hal_flash_ex.c ****     programming operations Operations.
 141:./src/stm32f7xx_hal_flash_ex.c **** 
 142:./src/stm32f7xx_hal_flash_ex.c **** @endverbatim
 143:./src/stm32f7xx_hal_flash_ex.c ****   * @{
 144:./src/stm32f7xx_hal_flash_ex.c ****   */
 145:./src/stm32f7xx_hal_flash_ex.c **** /**
 146:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Perform a mass erase or erase the specified FLASH memory sectors 
 147:./src/stm32f7xx_hal_flash_ex.c ****   * @param[in]  pEraseInit pointer to an FLASH_EraseInitTypeDef structure that
 148:./src/stm32f7xx_hal_flash_ex.c ****   *         contains the configuration information for the erasing.
 149:./src/stm32f7xx_hal_flash_ex.c ****   * 
 150:./src/stm32f7xx_hal_flash_ex.c ****   * @param[out]  SectorError pointer to variable  that
 151:./src/stm32f7xx_hal_flash_ex.c ****   *         contains the configuration information on faulty sector in case of error 
 152:./src/stm32f7xx_hal_flash_ex.c ****   *         (0xFFFFFFFF means that all the sectors have been correctly erased)
 153:./src/stm32f7xx_hal_flash_ex.c ****   * 
 154:./src/stm32f7xx_hal_flash_ex.c ****   * @retval HAL Status
 155:./src/stm32f7xx_hal_flash_ex.c ****   */
 156:./src/stm32f7xx_hal_flash_ex.c **** HAL_StatusTypeDef HAL_FLASHEx_Erase(FLASH_EraseInitTypeDef *pEraseInit, uint32_t *SectorError)
 157:./src/stm32f7xx_hal_flash_ex.c **** {
 158:./src/stm32f7xx_hal_flash_ex.c ****   HAL_StatusTypeDef status;
 159:./src/stm32f7xx_hal_flash_ex.c ****   uint32_t index = 0;
 160:./src/stm32f7xx_hal_flash_ex.c ****   
 161:./src/stm32f7xx_hal_flash_ex.c ****   /* Process Locked */
 162:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_LOCK(&pFlash);
 163:./src/stm32f7xx_hal_flash_ex.c **** 
 164:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 165:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_FLASH_TYPEERASE(pEraseInit->TypeErase));
 166:./src/stm32f7xx_hal_flash_ex.c **** 
 167:./src/stm32f7xx_hal_flash_ex.c ****   /* Wait for last operation to be completed */
 168:./src/stm32f7xx_hal_flash_ex.c ****   status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 169:./src/stm32f7xx_hal_flash_ex.c **** 
 170:./src/stm32f7xx_hal_flash_ex.c ****   if(status == HAL_OK)
 171:./src/stm32f7xx_hal_flash_ex.c ****   {
 172:./src/stm32f7xx_hal_flash_ex.c ****     /*Initialization of SectorError variable*/
 173:./src/stm32f7xx_hal_flash_ex.c ****     *SectorError = 0xFFFFFFFFU;
 174:./src/stm32f7xx_hal_flash_ex.c ****     
 175:./src/stm32f7xx_hal_flash_ex.c ****     if(pEraseInit->TypeErase == FLASH_TYPEERASE_MASSERASE)
 176:./src/stm32f7xx_hal_flash_ex.c ****     {
 177:./src/stm32f7xx_hal_flash_ex.c ****       /*Mass erase to be done*/
 178:./src/stm32f7xx_hal_flash_ex.c **** #if defined (FLASH_OPTCR_nDBANK)      
 179:./src/stm32f7xx_hal_flash_ex.c ****       FLASH_MassErase((uint8_t) pEraseInit->VoltageRange, pEraseInit->Banks);
 180:./src/stm32f7xx_hal_flash_ex.c **** #else
 181:./src/stm32f7xx_hal_flash_ex.c ****       FLASH_MassErase((uint8_t) pEraseInit->VoltageRange);      
 182:./src/stm32f7xx_hal_flash_ex.c **** #endif /* FLASH_OPTCR_nDBANK */
 183:./src/stm32f7xx_hal_flash_ex.c ****                       
 184:./src/stm32f7xx_hal_flash_ex.c ****       /* Wait for last operation to be completed */
 185:./src/stm32f7xx_hal_flash_ex.c ****       status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 186:./src/stm32f7xx_hal_flash_ex.c ****       
 187:./src/stm32f7xx_hal_flash_ex.c ****       /* if the erase operation is completed, disable the MER Bit */
 188:./src/stm32f7xx_hal_flash_ex.c ****       FLASH->CR &= (~FLASH_MER_BIT);
 189:./src/stm32f7xx_hal_flash_ex.c ****     }
 190:./src/stm32f7xx_hal_flash_ex.c ****     else
 191:./src/stm32f7xx_hal_flash_ex.c ****     {
 192:./src/stm32f7xx_hal_flash_ex.c ****       /* Check the parameters */
 193:./src/stm32f7xx_hal_flash_ex.c ****       assert_param(IS_FLASH_NBSECTORS(pEraseInit->NbSectors + pEraseInit->Sector));
 194:./src/stm32f7xx_hal_flash_ex.c **** 
 195:./src/stm32f7xx_hal_flash_ex.c ****       /* Erase by sector by sector to be done*/
 196:./src/stm32f7xx_hal_flash_ex.c ****       for(index = pEraseInit->Sector; index < (pEraseInit->NbSectors + pEraseInit->Sector); index++
 197:./src/stm32f7xx_hal_flash_ex.c ****       {
 198:./src/stm32f7xx_hal_flash_ex.c ****         FLASH_Erase_Sector(index, (uint8_t) pEraseInit->VoltageRange);
 199:./src/stm32f7xx_hal_flash_ex.c **** 
 200:./src/stm32f7xx_hal_flash_ex.c ****         /* Wait for last operation to be completed */
 201:./src/stm32f7xx_hal_flash_ex.c ****         status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 202:./src/stm32f7xx_hal_flash_ex.c ****         
 203:./src/stm32f7xx_hal_flash_ex.c ****         /* If the erase operation is completed, disable the SER Bit and SNB Bits */
 204:./src/stm32f7xx_hal_flash_ex.c ****         CLEAR_BIT(FLASH->CR, (FLASH_CR_SER | FLASH_CR_SNB)); 
 205:./src/stm32f7xx_hal_flash_ex.c **** 
 206:./src/stm32f7xx_hal_flash_ex.c ****         if(status != HAL_OK) 
 207:./src/stm32f7xx_hal_flash_ex.c ****         {
 208:./src/stm32f7xx_hal_flash_ex.c ****           /* In case of error, stop erase procedure and return the faulty sector*/
 209:./src/stm32f7xx_hal_flash_ex.c ****           *SectorError = index;
 210:./src/stm32f7xx_hal_flash_ex.c ****           break;
 211:./src/stm32f7xx_hal_flash_ex.c ****         }
 212:./src/stm32f7xx_hal_flash_ex.c ****       }
 213:./src/stm32f7xx_hal_flash_ex.c ****     }
 214:./src/stm32f7xx_hal_flash_ex.c ****   }
 215:./src/stm32f7xx_hal_flash_ex.c **** 
 216:./src/stm32f7xx_hal_flash_ex.c ****   /* Process Unlocked */
 217:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_UNLOCK(&pFlash);
 218:./src/stm32f7xx_hal_flash_ex.c **** 
 219:./src/stm32f7xx_hal_flash_ex.c ****   return status;
 220:./src/stm32f7xx_hal_flash_ex.c **** }
 221:./src/stm32f7xx_hal_flash_ex.c **** 
 222:./src/stm32f7xx_hal_flash_ex.c **** /**
 223:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Perform a mass erase or erase the specified FLASH memory sectors  with interrupt enable
 224:./src/stm32f7xx_hal_flash_ex.c ****   * @param  pEraseInit pointer to an FLASH_EraseInitTypeDef structure that
 225:./src/stm32f7xx_hal_flash_ex.c ****   *         contains the configuration information for the erasing.
 226:./src/stm32f7xx_hal_flash_ex.c ****   * 
 227:./src/stm32f7xx_hal_flash_ex.c ****   * @retval HAL Status
 228:./src/stm32f7xx_hal_flash_ex.c ****   */
 229:./src/stm32f7xx_hal_flash_ex.c **** HAL_StatusTypeDef HAL_FLASHEx_Erase_IT(FLASH_EraseInitTypeDef *pEraseInit)
 230:./src/stm32f7xx_hal_flash_ex.c **** {
 231:./src/stm32f7xx_hal_flash_ex.c ****   HAL_StatusTypeDef status = HAL_OK;
 232:./src/stm32f7xx_hal_flash_ex.c **** 
 233:./src/stm32f7xx_hal_flash_ex.c ****   /* Process Locked */
 234:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_LOCK(&pFlash);
 235:./src/stm32f7xx_hal_flash_ex.c **** 
 236:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 237:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_FLASH_TYPEERASE(pEraseInit->TypeErase));
 238:./src/stm32f7xx_hal_flash_ex.c **** 
 239:./src/stm32f7xx_hal_flash_ex.c ****   /* Enable End of FLASH Operation interrupt */
 240:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_FLASH_ENABLE_IT(FLASH_IT_EOP);
 241:./src/stm32f7xx_hal_flash_ex.c ****   
 242:./src/stm32f7xx_hal_flash_ex.c ****   /* Enable Error source interrupt */
 243:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_FLASH_ENABLE_IT(FLASH_IT_ERR);
 244:./src/stm32f7xx_hal_flash_ex.c ****   
 245:./src/stm32f7xx_hal_flash_ex.c ****   /* Clear pending flags (if any) */  
 246:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP    | FLASH_FLAG_OPERR | FLASH_FLAG_WRPERR |\
 247:./src/stm32f7xx_hal_flash_ex.c ****                          FLASH_FLAG_PGAERR | FLASH_FLAG_PGPERR| FLASH_FLAG_ERSERR);  
 248:./src/stm32f7xx_hal_flash_ex.c ****   
 249:./src/stm32f7xx_hal_flash_ex.c ****   if(pEraseInit->TypeErase == FLASH_TYPEERASE_MASSERASE)
 250:./src/stm32f7xx_hal_flash_ex.c ****   {
 251:./src/stm32f7xx_hal_flash_ex.c ****     /*Mass erase to be done*/
 252:./src/stm32f7xx_hal_flash_ex.c ****     pFlash.ProcedureOnGoing = FLASH_PROC_MASSERASE;
 253:./src/stm32f7xx_hal_flash_ex.c **** #if defined (FLASH_OPTCR_nDBANK)    
 254:./src/stm32f7xx_hal_flash_ex.c ****     FLASH_MassErase((uint8_t) pEraseInit->VoltageRange, pEraseInit->Banks);
 255:./src/stm32f7xx_hal_flash_ex.c **** #else
 256:./src/stm32f7xx_hal_flash_ex.c ****     FLASH_MassErase((uint8_t) pEraseInit->VoltageRange);      
 257:./src/stm32f7xx_hal_flash_ex.c **** #endif /* FLASH_OPTCR_nDBANK */    
 258:./src/stm32f7xx_hal_flash_ex.c ****   }
 259:./src/stm32f7xx_hal_flash_ex.c ****   else
 260:./src/stm32f7xx_hal_flash_ex.c ****   {
 261:./src/stm32f7xx_hal_flash_ex.c ****     /* Erase by sector to be done*/
 262:./src/stm32f7xx_hal_flash_ex.c **** 
 263:./src/stm32f7xx_hal_flash_ex.c ****     /* Check the parameters */
 264:./src/stm32f7xx_hal_flash_ex.c ****     assert_param(IS_FLASH_NBSECTORS(pEraseInit->NbSectors + pEraseInit->Sector));
 265:./src/stm32f7xx_hal_flash_ex.c **** 
 266:./src/stm32f7xx_hal_flash_ex.c ****     pFlash.ProcedureOnGoing = FLASH_PROC_SECTERASE;
 267:./src/stm32f7xx_hal_flash_ex.c ****     pFlash.NbSectorsToErase = pEraseInit->NbSectors;
 268:./src/stm32f7xx_hal_flash_ex.c ****     pFlash.Sector = pEraseInit->Sector;
 269:./src/stm32f7xx_hal_flash_ex.c ****     pFlash.VoltageForErase = (uint8_t)pEraseInit->VoltageRange;
 270:./src/stm32f7xx_hal_flash_ex.c **** 
 271:./src/stm32f7xx_hal_flash_ex.c ****     /*Erase 1st sector and wait for IT*/
 272:./src/stm32f7xx_hal_flash_ex.c ****     FLASH_Erase_Sector(pEraseInit->Sector, pEraseInit->VoltageRange);
 273:./src/stm32f7xx_hal_flash_ex.c ****   }
 274:./src/stm32f7xx_hal_flash_ex.c **** 
 275:./src/stm32f7xx_hal_flash_ex.c ****   return status;
 276:./src/stm32f7xx_hal_flash_ex.c **** }

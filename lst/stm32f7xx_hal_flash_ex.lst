 469:./src/stm32f7xx_hal_flash_ex.c **** /**
 470:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Erase the specified FLASH memory sector
 471:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Sector FLASH sector to erase
 472:./src/stm32f7xx_hal_flash_ex.c ****   *         The value of this parameter depend on device used within the same series      
 473:./src/stm32f7xx_hal_flash_ex.c ****   * @param  VoltageRange The device voltage range which defines the erase parallelism.  
 474:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter can be one of the following values:
 475:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_1: when the device voltage range is 1.8V to 2.1V, 
 476:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by byte (8-bit) 
 477:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_2: when the device voltage range is 2.1V to 2.7V,
 478:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by half word (16-bit)
 479:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_3: when the device voltage range is 2.7V to 3.6V,
 480:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by word (32-bit)
 481:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_4: when the device voltage range is 2.7V to 3.6V + External
 482:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by double word (64-bit)
 483:./src/stm32f7xx_hal_flash_ex.c ****   * 
 484:./src/stm32f7xx_hal_flash_ex.c ****   * @retval None
 485:./src/stm32f7xx_hal_flash_ex.c ****   */
 486:./src/stm32f7xx_hal_flash_ex.c **** void FLASH_Erase_Sector(uint32_t Sector, uint8_t VoltageRange)
 487:./src/stm32f7xx_hal_flash_ex.c **** {
 488:./src/stm32f7xx_hal_flash_ex.c ****   uint32_t tmp_psize = 0;
 489:./src/stm32f7xx_hal_flash_ex.c **** 
 490:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 491:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_FLASH_SECTOR(Sector));
 492:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_VOLTAGERANGE(VoltageRange));
 493:./src/stm32f7xx_hal_flash_ex.c ****   
 494:./src/stm32f7xx_hal_flash_ex.c ****   if(VoltageRange == FLASH_VOLTAGE_RANGE_1)
 495:./src/stm32f7xx_hal_flash_ex.c ****   {
 496:./src/stm32f7xx_hal_flash_ex.c ****      tmp_psize = FLASH_PSIZE_BYTE;
 497:./src/stm32f7xx_hal_flash_ex.c ****   }
 498:./src/stm32f7xx_hal_flash_ex.c ****   else if(VoltageRange == FLASH_VOLTAGE_RANGE_2)
 499:./src/stm32f7xx_hal_flash_ex.c ****   {
 500:./src/stm32f7xx_hal_flash_ex.c ****     tmp_psize = FLASH_PSIZE_HALF_WORD;
 501:./src/stm32f7xx_hal_flash_ex.c ****   }
 502:./src/stm32f7xx_hal_flash_ex.c ****   else if(VoltageRange == FLASH_VOLTAGE_RANGE_3)
 503:./src/stm32f7xx_hal_flash_ex.c ****   {
 504:./src/stm32f7xx_hal_flash_ex.c ****     tmp_psize = FLASH_PSIZE_WORD;
 505:./src/stm32f7xx_hal_flash_ex.c ****   }
 506:./src/stm32f7xx_hal_flash_ex.c ****   else
 507:./src/stm32f7xx_hal_flash_ex.c ****   {
 508:./src/stm32f7xx_hal_flash_ex.c ****     tmp_psize = FLASH_PSIZE_DOUBLE_WORD;
 509:./src/stm32f7xx_hal_flash_ex.c ****   }
 510:./src/stm32f7xx_hal_flash_ex.c ****   
 511:./src/stm32f7xx_hal_flash_ex.c ****   /* Need to add offset of 4 when sector higher than FLASH_SECTOR_11 */
 512:./src/stm32f7xx_hal_flash_ex.c ****   if(Sector > FLASH_SECTOR_11) 
 513:./src/stm32f7xx_hal_flash_ex.c ****   {
 514:./src/stm32f7xx_hal_flash_ex.c ****     Sector += 4;
 515:./src/stm32f7xx_hal_flash_ex.c ****   }  
 516:./src/stm32f7xx_hal_flash_ex.c **** 
 517:./src/stm32f7xx_hal_flash_ex.c ****   /* If the previous operation is completed, proceed to erase the sector */
 518:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR &= CR_PSIZE_MASK;
 519:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= tmp_psize;
 520:./src/stm32f7xx_hal_flash_ex.c ****   CLEAR_BIT(FLASH->CR, FLASH_CR_SNB);
 521:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= FLASH_CR_SER | (Sector << FLASH_CR_SNB_Pos);
 522:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= FLASH_CR_STRT;
 523:./src/stm32f7xx_hal_flash_ex.c ****   
 524:./src/stm32f7xx_hal_flash_ex.c ****   /* Data synchronous Barrier (DSB) Just after the write operation
 525:./src/stm32f7xx_hal_flash_ex.c ****      This will force the CPU to respect the sequence of instruction (no optimization).*/
 526:./src/stm32f7xx_hal_flash_ex.c ****   __DSB();
 527:./src/stm32f7xx_hal_flash_ex.c **** }
 528:./src/stm32f7xx_hal_flash_ex.c **** 
 529:./src/stm32f7xx_hal_flash_ex.c **** /**
 530:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Return the FLASH Write Protection Option Bytes value.
 531:./src/stm32f7xx_hal_flash_ex.c ****   * @retval uint32_t FLASH Write Protection Option Bytes value
 532:./src/stm32f7xx_hal_flash_ex.c ****   */
 533:./src/stm32f7xx_hal_flash_ex.c **** static uint32_t FLASH_OB_GetWRP(void)
 534:./src/stm32f7xx_hal_flash_ex.c **** {
 535:./src/stm32f7xx_hal_flash_ex.c ****   /* Return the FLASH write protection Register value */
 536:./src/stm32f7xx_hal_flash_ex.c ****   return ((uint32_t)(FLASH->OPTCR & 0x0FFF0000));
 537:./src/stm32f7xx_hal_flash_ex.c **** }
 538:./src/stm32f7xx_hal_flash_ex.c **** 
 539:./src/stm32f7xx_hal_flash_ex.c **** /**
 540:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Program the FLASH User Option Byte: IWDG_SW / RST_STOP / RST_STDBY.    
 541:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Wwdg Selects the IWDG mode
 542:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter can be one of the following values:
 543:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_WWDG_SW: Software WWDG selected
 544:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_WWDG_HW: Hardware WWDG selected
 545:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Iwdg Selects the WWDG mode
 546:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter can be one of the following values:
 547:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_IWDG_SW: Software IWDG selected
 548:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_IWDG_HW: Hardware IWDG selected
 549:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Stop Reset event when entering STOP mode.
 550:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter  can be one of the following values:
 551:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_STOP_NO_RST: No reset generated when entering in STOP
 552:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_STOP_RST: Reset generated when entering in STOP
 553:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Stdby Reset event when entering Standby mode.
 554:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter  can be one of the following values:
 555:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_STDBY_NO_RST: No reset generated when entering in STANDBY
 556:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_STDBY_RST: Reset generated when entering in STANDBY
 557:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Iwdgstop Independent watchdog counter freeze in Stop mode.
 558:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter  can be one of the following values:
 559:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_IWDG_STOP_FREEZE: Freeze IWDG counter in STOP
 560:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_IWDG_STOP_ACTIVE: IWDG counter active in STOP
 561:./src/stm32f7xx_hal_flash_ex.c ****   * @param  Iwdgstdby Independent watchdog counter freeze in standby mode.
 562:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter  can be one of the following values:
 563:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_IWDG_STDBY_FREEZE: Freeze IWDG counter in STANDBY
 564:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_IWDG_STDBY_ACTIVE: IWDG counter active in STANDBY
 565:./src/stm32f7xx_hal_flash_ex.c ****   * @param  NDBank Flash Single Bank mode enabled.
 566:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter  can be one of the following values:
 567:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_NDBANK_SINGLE_BANK: enable 256 bits mode (Flash is a single bank)
 568:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_NDBANK_DUAL_BANK: disable 256 bits mode (Flash is a dual bank in 128 bits mo
 569:./src/stm32f7xx_hal_flash_ex.c ****   * @param  NDBoot Flash Dual boot mode disable.
 570:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter  can be one of the following values:
 571:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_DUAL_BOOT_DISABLE: Disable Dual Boot
 572:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg OB_DUAL_BOOT_ENABLE: Enable Dual Boot
 573:./src/stm32f7xx_hal_flash_ex.c **** 
 574:./src/stm32f7xx_hal_flash_ex.c ****   * @retval HAL Status
 575:./src/stm32f7xx_hal_flash_ex.c ****   */
 576:./src/stm32f7xx_hal_flash_ex.c **** static HAL_StatusTypeDef FLASH_OB_UserConfig(uint32_t Wwdg, uint32_t Iwdg, uint32_t Stop, uint32_t 
 577:./src/stm32f7xx_hal_flash_ex.c ****                                              uint32_t Iwdgstdby, uint32_t NDBank, uint32_t NDBoot)
 578:./src/stm32f7xx_hal_flash_ex.c **** {
 579:./src/stm32f7xx_hal_flash_ex.c ****   uint32_t useroptionmask = 0x00;
 580:./src/stm32f7xx_hal_flash_ex.c ****   uint32_t useroptionvalue = 0x00;
 581:./src/stm32f7xx_hal_flash_ex.c **** 
 582:./src/stm32f7xx_hal_flash_ex.c ****   HAL_StatusTypeDef status = HAL_OK;
 583:./src/stm32f7xx_hal_flash_ex.c **** 
 584:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 585:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_WWDG_SOURCE(Wwdg));
 586:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_IWDG_SOURCE(Iwdg));
 587:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_STOP_SOURCE(Stop));
 588:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_STDBY_SOURCE(Stdby));
 589:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_IWDG_STOP_FREEZE(Iwdgstop));
 590:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_IWDG_STDBY_FREEZE(Iwdgstdby));
 591:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_NDBANK(NDBank));
 592:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OB_NDBOOT(NDBoot));
 593:./src/stm32f7xx_hal_flash_ex.c ****   
 594:./src/stm32f7xx_hal_flash_ex.c ****   /* Wait for last operation to be completed */
 595:./src/stm32f7xx_hal_flash_ex.c ****   status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 596:./src/stm32f7xx_hal_flash_ex.c ****   
 597:./src/stm32f7xx_hal_flash_ex.c ****   if(status == HAL_OK)
 598:./src/stm32f7xx_hal_flash_ex.c ****   {
 599:./src/stm32f7xx_hal_flash_ex.c ****     useroptionmask = (FLASH_OPTCR_WWDG_SW | FLASH_OPTCR_IWDG_SW | FLASH_OPTCR_nRST_STOP | \
 600:./src/stm32f7xx_hal_flash_ex.c ****                       FLASH_OPTCR_nRST_STDBY | FLASH_OPTCR_IWDG_STOP | FLASH_OPTCR_IWDG_STDBY | \
 601:./src/stm32f7xx_hal_flash_ex.c ****                       FLASH_OPTCR_nDBOOT | FLASH_OPTCR_nDBANK);
 602:./src/stm32f7xx_hal_flash_ex.c ****                       
 603:./src/stm32f7xx_hal_flash_ex.c ****     useroptionvalue = (Iwdg | Wwdg | Stop | Stdby | Iwdgstop | Iwdgstdby | NDBoot | NDBank);
 604:./src/stm32f7xx_hal_flash_ex.c ****         
 605:./src/stm32f7xx_hal_flash_ex.c ****     /* Update User Option Byte */               
 606:./src/stm32f7xx_hal_flash_ex.c ****     MODIFY_REG(FLASH->OPTCR, useroptionmask, useroptionvalue);
 607:./src/stm32f7xx_hal_flash_ex.c ****   }
 608:./src/stm32f7xx_hal_flash_ex.c ****   
 609:./src/stm32f7xx_hal_flash_ex.c ****   return status; 
 610:./src/stm32f7xx_hal_flash_ex.c **** }
 611:./src/stm32f7xx_hal_flash_ex.c **** 
 612:./src/stm32f7xx_hal_flash_ex.c **** /**
 613:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Return the FLASH User Option Byte value.
 614:./src/stm32f7xx_hal_flash_ex.c ****   * @retval uint32_t FLASH User Option Bytes values: WWDG_SW(Bit4), IWDG_SW(Bit5), nRST_STOP(Bit6),
 615:./src/stm32f7xx_hal_flash_ex.c ****   *         nRST_STDBY(Bit7), nDBOOT(Bit28), nDBANK(Bit29), IWDG_STDBY(Bit30) and IWDG_STOP(Bit31).
 616:./src/stm32f7xx_hal_flash_ex.c ****   */
 617:./src/stm32f7xx_hal_flash_ex.c **** static uint32_t FLASH_OB_GetUser(void)
 618:./src/stm32f7xx_hal_flash_ex.c **** {
 619:./src/stm32f7xx_hal_flash_ex.c ****   /* Return the User Option Byte */
 620:./src/stm32f7xx_hal_flash_ex.c ****   return ((uint32_t)(FLASH->OPTCR & 0xF00000F0U));
 621:./src/stm32f7xx_hal_flash_ex.c **** }
 622:./src/stm32f7xx_hal_flash_ex.c **** #else
 623:./src/stm32f7xx_hal_flash_ex.c **** 
 624:./src/stm32f7xx_hal_flash_ex.c **** /**
 625:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Full erase of FLASH memory sectors 
 626:./src/stm32f7xx_hal_flash_ex.c ****   * @param  VoltageRange The device voltage range which defines the erase parallelism.  
 627:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter can be one of the following values:
 628:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg VOLTAGE_RANGE_1: when the device voltage range is 1.8V to 2.1V, 
 629:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by byte (8-bit) 
 630:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg VOLTAGE_RANGE_2: when the device voltage range is 2.1V to 2.7V,
 631:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by half word (16-bit)
 632:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg VOLTAGE_RANGE_3: when the device voltage range is 2.7V to 3.6V,
 633:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by word (32-bit)
 634:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg VOLTAGE_RANGE_4: when the device voltage range is 2.7V to 3.6V + External Vpp, 
 635:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by double word (64-bit)
 636:./src/stm32f7xx_hal_flash_ex.c ****   *
 637:./src/stm32f7xx_hal_flash_ex.c ****   * @retval HAL Status
 638:./src/stm32f7xx_hal_flash_ex.c ****   */
 639:./src/stm32f7xx_hal_flash_ex.c **** static void FLASH_MassErase(uint8_t VoltageRange)
 640:./src/stm32f7xx_hal_flash_ex.c **** {
 641:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 642:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_VOLTAGERANGE(VoltageRange));
 643:./src/stm32f7xx_hal_flash_ex.c **** 
 644:./src/stm32f7xx_hal_flash_ex.c ****   /* if the previous operation is completed, proceed to erase all sectors */
 645:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR &= CR_PSIZE_MASK;
 646:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= FLASH_CR_MER;
 647:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= FLASH_CR_STRT | ((uint32_t)VoltageRange <<8);
 648:./src/stm32f7xx_hal_flash_ex.c ****   /* Data synchronous Barrier (DSB) Just after the write operation
 649:./src/stm32f7xx_hal_flash_ex.c ****      This will force the CPU to respect the sequence of instruction (no optimization).*/
 650:./src/stm32f7xx_hal_flash_ex.c ****   __DSB();
 651:./src/stm32f7xx_hal_flash_ex.c **** }
 652:./src/stm32f7xx_hal_flash_ex.c **** 
 653:./src/stm32f7xx_hal_flash_ex.c **** /**
 654:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Erase the specified FLASH memory sector

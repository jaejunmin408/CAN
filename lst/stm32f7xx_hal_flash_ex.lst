 406:./src/stm32f7xx_hal_flash_ex.c **** 
 407:./src/stm32f7xx_hal_flash_ex.c **** #if defined (FLASH_OPTCR2_PCROP)
 408:./src/stm32f7xx_hal_flash_ex.c ****   /*Get PCROP Sectors */
 409:./src/stm32f7xx_hal_flash_ex.c ****   pOBInit->PCROPSector = FLASH_OB_GetPCROP();
 410:./src/stm32f7xx_hal_flash_ex.c ****   
 411:./src/stm32f7xx_hal_flash_ex.c ****   /*Get PCROP_RDP Value */

 657:./src/stm32f7xx_hal_flash_ex.c ****   * @param  VoltageRange The device voltage range which defines the erase parallelism.  
 658:./src/stm32f7xx_hal_flash_ex.c ****   *          This parameter can be one of the following values:
 659:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_1: when the device voltage range is 1.8V to 2.1V, 
 660:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by byte (8-bit) 
 661:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_2: when the device voltage range is 2.1V to 2.7V,
 662:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by half word (16-bit)
 663:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_3: when the device voltage range is 2.7V to 3.6V,
 664:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by word (32-bit)
 665:./src/stm32f7xx_hal_flash_ex.c ****   *            @arg FLASH_VOLTAGE_RANGE_4: when the device voltage range is 2.7V to 3.6V + External
 666:./src/stm32f7xx_hal_flash_ex.c ****   *                                  the operation will be done by double word (64-bit)
 667:./src/stm32f7xx_hal_flash_ex.c ****   * 
 668:./src/stm32f7xx_hal_flash_ex.c ****   * @retval None
 669:./src/stm32f7xx_hal_flash_ex.c ****   */
 670:./src/stm32f7xx_hal_flash_ex.c **** void FLASH_Erase_Sector(uint32_t Sector, uint8_t VoltageRange)
 671:./src/stm32f7xx_hal_flash_ex.c **** {
 672:./src/stm32f7xx_hal_flash_ex.c ****   uint32_t tmp_psize = 0;
 673:./src/stm32f7xx_hal_flash_ex.c **** 
 674:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 675:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_FLASH_SECTOR(Sector));
 676:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_VOLTAGERANGE(VoltageRange));
 677:./src/stm32f7xx_hal_flash_ex.c ****   
 678:./src/stm32f7xx_hal_flash_ex.c ****   if(VoltageRange == FLASH_VOLTAGE_RANGE_1)
 679:./src/stm32f7xx_hal_flash_ex.c ****   {
 680:./src/stm32f7xx_hal_flash_ex.c ****      tmp_psize = FLASH_PSIZE_BYTE;
 681:./src/stm32f7xx_hal_flash_ex.c ****   }
 682:./src/stm32f7xx_hal_flash_ex.c ****   else if(VoltageRange == FLASH_VOLTAGE_RANGE_2)
 683:./src/stm32f7xx_hal_flash_ex.c ****   {
 684:./src/stm32f7xx_hal_flash_ex.c ****     tmp_psize = FLASH_PSIZE_HALF_WORD;
 685:./src/stm32f7xx_hal_flash_ex.c ****   }
 686:./src/stm32f7xx_hal_flash_ex.c ****   else if(VoltageRange == FLASH_VOLTAGE_RANGE_3)
 687:./src/stm32f7xx_hal_flash_ex.c ****   {
 688:./src/stm32f7xx_hal_flash_ex.c ****     tmp_psize = FLASH_PSIZE_WORD;
 689:./src/stm32f7xx_hal_flash_ex.c ****   }
 690:./src/stm32f7xx_hal_flash_ex.c ****   else
 691:./src/stm32f7xx_hal_flash_ex.c ****   {
 692:./src/stm32f7xx_hal_flash_ex.c ****     tmp_psize = FLASH_PSIZE_DOUBLE_WORD;
 693:./src/stm32f7xx_hal_flash_ex.c ****   }
 694:./src/stm32f7xx_hal_flash_ex.c **** 
 695:./src/stm32f7xx_hal_flash_ex.c ****   /* If the previous operation is completed, proceed to erase the sector */
 696:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR &= CR_PSIZE_MASK;
 697:./src/stm32f7xx_hal_flash_ex.c ****   FLASH->CR |= tmp_psize;

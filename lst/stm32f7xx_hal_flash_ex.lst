 749:./inc/cmsis_gcc.h ****     (!defined (__ARM_FEATURE_CMSE) || (__ARM_FEATURE_CMSE < 3)))
 750:./inc/cmsis_gcc.h ****   // without main extensions, the non-secure MSPLIM is RAZ/WI

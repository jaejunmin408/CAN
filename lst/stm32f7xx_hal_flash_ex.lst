 278:./src/stm32f7xx_hal_flash_ex.c **** /**
 279:./src/stm32f7xx_hal_flash_ex.c ****   * @brief  Program option bytes
 280:./src/stm32f7xx_hal_flash_ex.c ****   * @param  pOBInit pointer to an FLASH_OBInitStruct structure that
 281:./src/stm32f7xx_hal_flash_ex.c ****   *         contains the configuration information for the programming.
 282:./src/stm32f7xx_hal_flash_ex.c ****   * 
 283:./src/stm32f7xx_hal_flash_ex.c ****   * @retval HAL Status
 284:./src/stm32f7xx_hal_flash_ex.c ****   */
 285:./src/stm32f7xx_hal_flash_ex.c **** HAL_StatusTypeDef HAL_FLASHEx_OBProgram(FLASH_OBProgramInitTypeDef *pOBInit)
 286:./src/stm32f7xx_hal_flash_ex.c **** {
 287:./src/stm32f7xx_hal_flash_ex.c ****   HAL_StatusTypeDef status = HAL_ERROR;
 288:./src/stm32f7xx_hal_flash_ex.c ****   
 289:./src/stm32f7xx_hal_flash_ex.c ****   /* Process Locked */
 290:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_LOCK(&pFlash);
 291:./src/stm32f7xx_hal_flash_ex.c **** 
 292:./src/stm32f7xx_hal_flash_ex.c ****   /* Check the parameters */
 293:./src/stm32f7xx_hal_flash_ex.c ****   assert_param(IS_OPTIONBYTE(pOBInit->OptionType));
 294:./src/stm32f7xx_hal_flash_ex.c **** 
 295:./src/stm32f7xx_hal_flash_ex.c ****   /* Write protection configuration */
 296:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_WRP) == OPTIONBYTE_WRP)
 297:./src/stm32f7xx_hal_flash_ex.c ****   {
 298:./src/stm32f7xx_hal_flash_ex.c ****     assert_param(IS_WRPSTATE(pOBInit->WRPState));
 299:./src/stm32f7xx_hal_flash_ex.c ****     if(pOBInit->WRPState == OB_WRPSTATE_ENABLE)
 300:./src/stm32f7xx_hal_flash_ex.c ****     {
 301:./src/stm32f7xx_hal_flash_ex.c ****       /*Enable of Write protection on the selected Sector*/
 302:./src/stm32f7xx_hal_flash_ex.c ****       status = FLASH_OB_EnableWRP(pOBInit->WRPSector);
 303:./src/stm32f7xx_hal_flash_ex.c ****     }
 304:./src/stm32f7xx_hal_flash_ex.c ****     else
 305:./src/stm32f7xx_hal_flash_ex.c ****     {
 306:./src/stm32f7xx_hal_flash_ex.c ****       /*Disable of Write protection on the selected Sector*/
 307:./src/stm32f7xx_hal_flash_ex.c ****       status = FLASH_OB_DisableWRP(pOBInit->WRPSector);
 308:./src/stm32f7xx_hal_flash_ex.c ****     }
 309:./src/stm32f7xx_hal_flash_ex.c ****   }
 310:./src/stm32f7xx_hal_flash_ex.c **** 
 311:./src/stm32f7xx_hal_flash_ex.c ****   /* Read protection configuration */
 312:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_RDP) == OPTIONBYTE_RDP)
 313:./src/stm32f7xx_hal_flash_ex.c ****   {
 314:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_RDP_LevelConfig(pOBInit->RDPLevel);
 315:./src/stm32f7xx_hal_flash_ex.c ****   }
 316:./src/stm32f7xx_hal_flash_ex.c **** 
 317:./src/stm32f7xx_hal_flash_ex.c ****   /* USER  configuration */
 318:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_USER) == OPTIONBYTE_USER)
 319:./src/stm32f7xx_hal_flash_ex.c ****   {
 320:./src/stm32f7xx_hal_flash_ex.c **** #if defined (FLASH_OPTCR_nDBANK)
 321:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_UserConfig(pOBInit->USERConfig & OB_WWDG_SW, 
 322:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_IWDG_SW,
 323:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_STOP_NO_RST,
 324:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_STDBY_NO_RST, 
 325:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_IWDG_STOP_ACTIVE,
 326:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_IWDG_STDBY_ACTIVE,
 327:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_NDBANK_SINGLE_BANK,
 328:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_DUAL_BOOT_DISABLE);
 329:./src/stm32f7xx_hal_flash_ex.c **** #else
 330:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_UserConfig(pOBInit->USERConfig & OB_WWDG_SW, 
 331:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_IWDG_SW,
 332:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_STOP_NO_RST,
 333:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_STDBY_NO_RST, 
 334:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_IWDG_STOP_ACTIVE,
 335:./src/stm32f7xx_hal_flash_ex.c ****                                  pOBInit->USERConfig & OB_IWDG_STDBY_ACTIVE);    
 336:./src/stm32f7xx_hal_flash_ex.c **** #endif /* FLASH_OPTCR_nDBANK */
 337:./src/stm32f7xx_hal_flash_ex.c ****   }
 338:./src/stm32f7xx_hal_flash_ex.c ****   
 339:./src/stm32f7xx_hal_flash_ex.c ****   /* BOR Level  configuration */
 340:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_BOR) == OPTIONBYTE_BOR)
 341:./src/stm32f7xx_hal_flash_ex.c ****   {
 342:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_BOR_LevelConfig(pOBInit->BORLevel);
 343:./src/stm32f7xx_hal_flash_ex.c ****   }
 344:./src/stm32f7xx_hal_flash_ex.c ****   
 345:./src/stm32f7xx_hal_flash_ex.c ****   /* Boot 0 Address configuration */
 346:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_BOOTADDR_0) == OPTIONBYTE_BOOTADDR_0)
 347:./src/stm32f7xx_hal_flash_ex.c ****   {
 348:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_BootAddressConfig(OPTIONBYTE_BOOTADDR_0, pOBInit->BootAddr0);
 349:./src/stm32f7xx_hal_flash_ex.c ****   }
 350:./src/stm32f7xx_hal_flash_ex.c ****   
 351:./src/stm32f7xx_hal_flash_ex.c ****   /* Boot 1 Address configuration */
 352:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_BOOTADDR_1) == OPTIONBYTE_BOOTADDR_1)
 353:./src/stm32f7xx_hal_flash_ex.c ****   {
 354:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_BootAddressConfig(OPTIONBYTE_BOOTADDR_1, pOBInit->BootAddr1);
 355:./src/stm32f7xx_hal_flash_ex.c ****   }
 356:./src/stm32f7xx_hal_flash_ex.c ****   
 357:./src/stm32f7xx_hal_flash_ex.c **** #if defined (FLASH_OPTCR2_PCROP)
 358:./src/stm32f7xx_hal_flash_ex.c ****   /* PCROP configuration */
 359:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_PCROP) == OPTIONBYTE_PCROP)
 360:./src/stm32f7xx_hal_flash_ex.c ****   {
 361:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_PCROP_Config(pOBInit->PCROPSector);
 362:./src/stm32f7xx_hal_flash_ex.c ****   }
 363:./src/stm32f7xx_hal_flash_ex.c ****   
 364:./src/stm32f7xx_hal_flash_ex.c ****   /* PCROP_RDP configuration */
 365:./src/stm32f7xx_hal_flash_ex.c ****   if((pOBInit->OptionType & OPTIONBYTE_PCROP_RDP) == OPTIONBYTE_PCROP_RDP)
 366:./src/stm32f7xx_hal_flash_ex.c ****   {
 367:./src/stm32f7xx_hal_flash_ex.c ****     status = FLASH_OB_PCROP_RDP_Config(pOBInit->PCROPRdp);
 368:./src/stm32f7xx_hal_flash_ex.c ****   }
 369:./src/stm32f7xx_hal_flash_ex.c **** #endif /* FLASH_OPTCR2_PCROP */
 370:./src/stm32f7xx_hal_flash_ex.c **** 
 371:./src/stm32f7xx_hal_flash_ex.c ****   /* Process Unlocked */
 372:./src/stm32f7xx_hal_flash_ex.c ****   __HAL_UNLOCK(&pFlash);
 373:./src/stm32f7xx_hal_flash_ex.c **** 
 374:./src/stm32f7xx_hal_flash_ex.c ****   return status;
 375:./src/stm32f7xx_hal_flash_ex.c **** }

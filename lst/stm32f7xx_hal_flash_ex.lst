 754:./inc/cmsis_gcc.h ****   __ASM volatile ("MRS %0, msplim" : "=r" (result) );
 755:./inc/cmsis_gcc.h ****   return result;
 756:./inc/cmsis_gcc.h **** #endif
 757:./inc/cmsis_gcc.h **** }

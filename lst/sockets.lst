 453:./lwip-2.1.2/src/api/sockets.c **** /**
 454:./lwip-2.1.2/src/api/sockets.c ****  * Same as get_socket but doesn't set errno
 455:./lwip-2.1.2/src/api/sockets.c ****  *
 456:./lwip-2.1.2/src/api/sockets.c ****  * @param fd externally used socket index
 457:./lwip-2.1.2/src/api/sockets.c ****  * @return struct lwip_sock for the socket or NULL if not found
 458:./lwip-2.1.2/src/api/sockets.c ****  */
 459:./lwip-2.1.2/src/api/sockets.c **** static struct lwip_sock *
 460:./lwip-2.1.2/src/api/sockets.c **** tryget_socket(int fd)
 461:./lwip-2.1.2/src/api/sockets.c **** {
 462:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_sock *sock = tryget_socket_unconn(fd);
 463:./lwip-2.1.2/src/api/sockets.c ****   if (sock != NULL) {
 464:./lwip-2.1.2/src/api/sockets.c ****     if (sock->conn) {
 465:./lwip-2.1.2/src/api/sockets.c ****       return sock;
 466:./lwip-2.1.2/src/api/sockets.c ****     }
 467:./lwip-2.1.2/src/api/sockets.c ****     done_socket(sock);
 468:./lwip-2.1.2/src/api/sockets.c ****   }
 469:./lwip-2.1.2/src/api/sockets.c ****   return NULL;
 470:./lwip-2.1.2/src/api/sockets.c **** }
 471:./lwip-2.1.2/src/api/sockets.c **** 
 472:./lwip-2.1.2/src/api/sockets.c **** /**
 473:./lwip-2.1.2/src/api/sockets.c ****  * Map a externally used socket index to the internal socket representation.
 474:./lwip-2.1.2/src/api/sockets.c ****  *
 475:./lwip-2.1.2/src/api/sockets.c ****  * @param fd externally used socket index
 476:./lwip-2.1.2/src/api/sockets.c ****  * @return struct lwip_sock for the socket or NULL if not found
 477:./lwip-2.1.2/src/api/sockets.c ****  */
 478:./lwip-2.1.2/src/api/sockets.c **** static struct lwip_sock *
 479:./lwip-2.1.2/src/api/sockets.c **** get_socket(int fd)
 480:./lwip-2.1.2/src/api/sockets.c **** {
 481:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_sock *sock = tryget_socket(fd);
 482:./lwip-2.1.2/src/api/sockets.c ****   if (!sock) {
 483:./lwip-2.1.2/src/api/sockets.c ****     if ((fd < LWIP_SOCKET_OFFSET) || (fd >= (LWIP_SOCKET_OFFSET + NUM_SOCKETS))) {
 484:./lwip-2.1.2/src/api/sockets.c ****       LWIP_DEBUGF(SOCKETS_DEBUG, ("get_socket(%d): invalid\n", fd));
 485:./lwip-2.1.2/src/api/sockets.c ****     }
 486:./lwip-2.1.2/src/api/sockets.c ****     set_errno(EBADF);
 487:./lwip-2.1.2/src/api/sockets.c ****     return NULL;
 488:./lwip-2.1.2/src/api/sockets.c ****   }
 489:./lwip-2.1.2/src/api/sockets.c ****   return sock;
 490:./lwip-2.1.2/src/api/sockets.c **** }

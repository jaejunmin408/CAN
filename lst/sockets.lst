1000:./lwip-2.1.2/src/api/sockets.c ****         LWIP_DEBUGF(SOCKETS_DEBUG, ("lwip_recv_tcp: lastdata now pbuf=%p\n", (void *)sock->lastdata
1001:./lwip-2.1.2/src/api/sockets.c ****       } else {
1002:./lwip-2.1.2/src/api/sockets.c ****         sock->lastdata.pbuf = NULL;
1003:./lwip-2.1.2/src/api/sockets.c ****         LWIP_DEBUGF(SOCKETS_DEBUG, ("lwip_recv_tcp: deleting pbuf=%p\n", (void *)p));

2310:./lwip-2.1.2/src/api/sockets.c ****     }
2311:./lwip-2.1.2/src/api/sockets.c ****   }
2312:./lwip-2.1.2/src/api/sockets.c **** }
2313:./lwip-2.1.2/src/api/sockets.c **** #else /* LWIP_NETCONN_FULLDUPLEX */

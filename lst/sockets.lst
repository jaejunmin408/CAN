2433:./lwip-2.1.2/src/api/sockets.c **** /**
2434:./lwip-2.1.2/src/api/sockets.c ****  * Check whether event_callback should wake up a thread waiting in
2435:./lwip-2.1.2/src/api/sockets.c ****  * lwip_poll.
2436:./lwip-2.1.2/src/api/sockets.c ****  */
2437:./lwip-2.1.2/src/api/sockets.c **** static int
2438:./lwip-2.1.2/src/api/sockets.c **** lwip_poll_should_wake(const struct lwip_select_cb *scb, int fd, int has_recvevent, int has_sendeven
2439:./lwip-2.1.2/src/api/sockets.c **** {
2440:./lwip-2.1.2/src/api/sockets.c ****   nfds_t fdi;
2441:./lwip-2.1.2/src/api/sockets.c ****   for (fdi = 0; fdi < scb->poll_nfds; fdi++) {
2442:./lwip-2.1.2/src/api/sockets.c ****     const struct pollfd *pollfd = &scb->poll_fds[fdi];
2443:./lwip-2.1.2/src/api/sockets.c ****     if (pollfd->fd == fd) {
2444:./lwip-2.1.2/src/api/sockets.c ****       /* Do not update pollfd->revents right here;
2445:./lwip-2.1.2/src/api/sockets.c ****          that would be a data race because lwip_pollscan
2446:./lwip-2.1.2/src/api/sockets.c ****          accesses revents without protecting. */
2447:./lwip-2.1.2/src/api/sockets.c ****       if (has_recvevent && (pollfd->events & POLLIN) != 0) {
2448:./lwip-2.1.2/src/api/sockets.c ****         return 1;
2449:./lwip-2.1.2/src/api/sockets.c ****       }
2450:./lwip-2.1.2/src/api/sockets.c ****       if (has_sendevent && (pollfd->events & POLLOUT) != 0) {
2451:./lwip-2.1.2/src/api/sockets.c ****         return 1;
2452:./lwip-2.1.2/src/api/sockets.c ****       }
2453:./lwip-2.1.2/src/api/sockets.c ****       if (has_errevent) {
2454:./lwip-2.1.2/src/api/sockets.c ****         /* POLLERR is output only. */
2455:./lwip-2.1.2/src/api/sockets.c ****         return 1;
2456:./lwip-2.1.2/src/api/sockets.c ****       }
2457:./lwip-2.1.2/src/api/sockets.c ****     }
2458:./lwip-2.1.2/src/api/sockets.c ****   }
2459:./lwip-2.1.2/src/api/sockets.c ****   return 0;
2460:./lwip-2.1.2/src/api/sockets.c **** }
2461:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_POLL */
2462:./lwip-2.1.2/src/api/sockets.c **** 
2463:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_SELECT || LWIP_SOCKET_POLL
2464:./lwip-2.1.2/src/api/sockets.c **** /**
2465:./lwip-2.1.2/src/api/sockets.c ****  * Callback registered in the netconn layer for each socket-netconn.
2466:./lwip-2.1.2/src/api/sockets.c ****  * Processes recvevent (data available) and wakes up tasks waiting for select.
2467:./lwip-2.1.2/src/api/sockets.c ****  *
2468:./lwip-2.1.2/src/api/sockets.c ****  * @note for LWIP_TCPIP_CORE_LOCKING any caller of this function
2469:./lwip-2.1.2/src/api/sockets.c ****  * must have the core lock held when signaling the following events
2470:./lwip-2.1.2/src/api/sockets.c ****  * as they might cause select_list_cb to be checked:
2471:./lwip-2.1.2/src/api/sockets.c ****  *   NETCONN_EVT_RCVPLUS
2472:./lwip-2.1.2/src/api/sockets.c ****  *   NETCONN_EVT_SENDPLUS
2473:./lwip-2.1.2/src/api/sockets.c ****  *   NETCONN_EVT_ERROR
2474:./lwip-2.1.2/src/api/sockets.c ****  * This requirement will be asserted in select_check_waiters()
2475:./lwip-2.1.2/src/api/sockets.c ****  */
2476:./lwip-2.1.2/src/api/sockets.c **** static void
2477:./lwip-2.1.2/src/api/sockets.c **** event_callback(struct netconn *conn, enum netconn_evt evt, u16_t len)
2478:./lwip-2.1.2/src/api/sockets.c **** {
2479:./lwip-2.1.2/src/api/sockets.c ****   int s, check_waiters;
2480:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_sock *sock;
2481:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
2482:./lwip-2.1.2/src/api/sockets.c **** 
2483:./lwip-2.1.2/src/api/sockets.c ****   LWIP_UNUSED_ARG(len);
2484:./lwip-2.1.2/src/api/sockets.c **** 
2485:./lwip-2.1.2/src/api/sockets.c ****   /* Get socket */
2486:./lwip-2.1.2/src/api/sockets.c ****   if (conn) {
2487:./lwip-2.1.2/src/api/sockets.c ****     s = conn->socket;
2488:./lwip-2.1.2/src/api/sockets.c ****     if (s < 0) {
2489:./lwip-2.1.2/src/api/sockets.c ****       /* Data comes in right away after an accept, even though
2490:./lwip-2.1.2/src/api/sockets.c ****        * the server task might not have created a new socket yet.
2491:./lwip-2.1.2/src/api/sockets.c ****        * Just count down (or up) if that's the case and we
2492:./lwip-2.1.2/src/api/sockets.c ****        * will use the data later. Note that only receive events
2493:./lwip-2.1.2/src/api/sockets.c ****        * can happen before the new socket is set up. */
2494:./lwip-2.1.2/src/api/sockets.c ****       SYS_ARCH_PROTECT(lev);
2495:./lwip-2.1.2/src/api/sockets.c ****       if (conn->socket < 0) {
2496:./lwip-2.1.2/src/api/sockets.c ****         if (evt == NETCONN_EVT_RCVPLUS) {
2497:./lwip-2.1.2/src/api/sockets.c ****           /* conn->socket is -1 on initialization
2498:./lwip-2.1.2/src/api/sockets.c ****              lwip_accept adjusts sock->recvevent if conn->socket < -1 */
2499:./lwip-2.1.2/src/api/sockets.c ****           conn->socket--;
2500:./lwip-2.1.2/src/api/sockets.c ****         }
2501:./lwip-2.1.2/src/api/sockets.c ****         SYS_ARCH_UNPROTECT(lev);
2502:./lwip-2.1.2/src/api/sockets.c ****         return;
2503:./lwip-2.1.2/src/api/sockets.c ****       }
2504:./lwip-2.1.2/src/api/sockets.c ****       s = conn->socket;
2505:./lwip-2.1.2/src/api/sockets.c ****       SYS_ARCH_UNPROTECT(lev);
2506:./lwip-2.1.2/src/api/sockets.c ****     }
2507:./lwip-2.1.2/src/api/sockets.c **** 
2508:./lwip-2.1.2/src/api/sockets.c ****     sock = get_socket(s);
2509:./lwip-2.1.2/src/api/sockets.c ****     if (!sock) {
2510:./lwip-2.1.2/src/api/sockets.c ****       return;
2511:./lwip-2.1.2/src/api/sockets.c ****     }
2512:./lwip-2.1.2/src/api/sockets.c ****   } else {
2513:./lwip-2.1.2/src/api/sockets.c ****     return;
2514:./lwip-2.1.2/src/api/sockets.c ****   }
2515:./lwip-2.1.2/src/api/sockets.c **** 
2516:./lwip-2.1.2/src/api/sockets.c ****   check_waiters = 1;
2517:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_PROTECT(lev);
2518:./lwip-2.1.2/src/api/sockets.c ****   /* Set event as required */
2519:./lwip-2.1.2/src/api/sockets.c ****   switch (evt) {
2520:./lwip-2.1.2/src/api/sockets.c ****     case NETCONN_EVT_RCVPLUS:
2521:./lwip-2.1.2/src/api/sockets.c ****       sock->rcvevent++;
2522:./lwip-2.1.2/src/api/sockets.c ****       if (sock->rcvevent > 1) {
2523:./lwip-2.1.2/src/api/sockets.c ****         check_waiters = 0;
2524:./lwip-2.1.2/src/api/sockets.c ****       }
2525:./lwip-2.1.2/src/api/sockets.c ****       break;
2526:./lwip-2.1.2/src/api/sockets.c ****     case NETCONN_EVT_RCVMINUS:
2527:./lwip-2.1.2/src/api/sockets.c ****       sock->rcvevent--;
2528:./lwip-2.1.2/src/api/sockets.c ****       check_waiters = 0;
2529:./lwip-2.1.2/src/api/sockets.c ****       break;
2530:./lwip-2.1.2/src/api/sockets.c ****     case NETCONN_EVT_SENDPLUS:
2531:./lwip-2.1.2/src/api/sockets.c ****       if (sock->sendevent) {
2532:./lwip-2.1.2/src/api/sockets.c ****         check_waiters = 0;
2533:./lwip-2.1.2/src/api/sockets.c ****       }
2534:./lwip-2.1.2/src/api/sockets.c ****       sock->sendevent = 1;
2535:./lwip-2.1.2/src/api/sockets.c ****       break;
2536:./lwip-2.1.2/src/api/sockets.c ****     case NETCONN_EVT_SENDMINUS:
2537:./lwip-2.1.2/src/api/sockets.c ****       sock->sendevent = 0;
2538:./lwip-2.1.2/src/api/sockets.c ****       check_waiters = 0;
2539:./lwip-2.1.2/src/api/sockets.c ****       break;
2540:./lwip-2.1.2/src/api/sockets.c ****     case NETCONN_EVT_ERROR:
2541:./lwip-2.1.2/src/api/sockets.c ****       sock->errevent = 1;
2542:./lwip-2.1.2/src/api/sockets.c ****       break;
2543:./lwip-2.1.2/src/api/sockets.c ****     default:
2544:./lwip-2.1.2/src/api/sockets.c ****       LWIP_ASSERT("unknown event", 0);
2545:./lwip-2.1.2/src/api/sockets.c ****       break;
2546:./lwip-2.1.2/src/api/sockets.c ****   }
2547:./lwip-2.1.2/src/api/sockets.c **** 
2548:./lwip-2.1.2/src/api/sockets.c ****   if (sock->select_waiting && check_waiters) {
2549:./lwip-2.1.2/src/api/sockets.c ****     /* Save which events are active */
2550:./lwip-2.1.2/src/api/sockets.c ****     int has_recvevent, has_sendevent, has_errevent;
2551:./lwip-2.1.2/src/api/sockets.c ****     has_recvevent = sock->rcvevent > 0;
2552:./lwip-2.1.2/src/api/sockets.c ****     has_sendevent = sock->sendevent != 0;
2553:./lwip-2.1.2/src/api/sockets.c ****     has_errevent = sock->errevent != 0;
2554:./lwip-2.1.2/src/api/sockets.c ****     SYS_ARCH_UNPROTECT(lev);
2555:./lwip-2.1.2/src/api/sockets.c ****     /* Check any select calls waiting on this socket */
2556:./lwip-2.1.2/src/api/sockets.c ****     select_check_waiters(s, has_recvevent, has_sendevent, has_errevent);
2557:./lwip-2.1.2/src/api/sockets.c ****   } else {
2558:./lwip-2.1.2/src/api/sockets.c ****     SYS_ARCH_UNPROTECT(lev);
2559:./lwip-2.1.2/src/api/sockets.c ****   }
2560:./lwip-2.1.2/src/api/sockets.c ****   done_socket(sock);
2561:./lwip-2.1.2/src/api/sockets.c **** }
2562:./lwip-2.1.2/src/api/sockets.c **** 
2563:./lwip-2.1.2/src/api/sockets.c **** /**
2564:./lwip-2.1.2/src/api/sockets.c ****  * Check if any select waiters are waiting on this socket and its events
2565:./lwip-2.1.2/src/api/sockets.c ****  *
2566:./lwip-2.1.2/src/api/sockets.c ****  * @note on synchronization of select_cb_list:
2567:./lwip-2.1.2/src/api/sockets.c ****  * LWIP_TCPIP_CORE_LOCKING: the select_cb_list must only be accessed while holding
2568:./lwip-2.1.2/src/api/sockets.c ****  * the core lock. We do a single pass through the list and signal any waiters.
2569:./lwip-2.1.2/src/api/sockets.c ****  * Core lock should already be held when calling here!!!!
2570:./lwip-2.1.2/src/api/sockets.c **** 
2571:./lwip-2.1.2/src/api/sockets.c ****  * !LWIP_TCPIP_CORE_LOCKING: we use SYS_ARCH_PROTECT but unlock on each iteration
2572:./lwip-2.1.2/src/api/sockets.c ****  * of the loop, thus creating a possibility where a thread could modify the
2573:./lwip-2.1.2/src/api/sockets.c ****  * select_cb_list during our UNPROTECT/PROTECT. We use a generational counter to
2574:./lwip-2.1.2/src/api/sockets.c ****  * detect this change and restart the list walk. The list is expected to be small
2575:./lwip-2.1.2/src/api/sockets.c ****  */
2576:./lwip-2.1.2/src/api/sockets.c **** static void select_check_waiters(int s, int has_recvevent, int has_sendevent, int has_errevent)
2577:./lwip-2.1.2/src/api/sockets.c **** {
2578:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_select_cb *scb;
2579:./lwip-2.1.2/src/api/sockets.c **** #if !LWIP_TCPIP_CORE_LOCKING
2580:./lwip-2.1.2/src/api/sockets.c ****   int last_select_cb_ctr;
2581:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
2582:./lwip-2.1.2/src/api/sockets.c **** #endif /* !LWIP_TCPIP_CORE_LOCKING */
2583:./lwip-2.1.2/src/api/sockets.c **** 
2584:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT_CORE_LOCKED();
2585:./lwip-2.1.2/src/api/sockets.c **** 
2586:./lwip-2.1.2/src/api/sockets.c **** #if !LWIP_TCPIP_CORE_LOCKING
2587:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_PROTECT(lev);
2588:./lwip-2.1.2/src/api/sockets.c **** again:
2589:./lwip-2.1.2/src/api/sockets.c ****   /* remember the state of select_cb_list to detect changes */
2590:./lwip-2.1.2/src/api/sockets.c ****   last_select_cb_ctr = select_cb_ctr;
2591:./lwip-2.1.2/src/api/sockets.c **** #endif /* !LWIP_TCPIP_CORE_LOCKING */
2592:./lwip-2.1.2/src/api/sockets.c ****   for (scb = select_cb_list; scb != NULL; scb = scb->next) {
2593:./lwip-2.1.2/src/api/sockets.c ****     if (scb->sem_signalled == 0) {
2594:./lwip-2.1.2/src/api/sockets.c ****       /* semaphore not signalled yet */
2595:./lwip-2.1.2/src/api/sockets.c ****       int do_signal = 0;
2596:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_POLL
2597:./lwip-2.1.2/src/api/sockets.c ****       if (scb->poll_fds != NULL) {
2598:./lwip-2.1.2/src/api/sockets.c ****         do_signal = lwip_poll_should_wake(scb, s, has_recvevent, has_sendevent, has_errevent);
2599:./lwip-2.1.2/src/api/sockets.c ****       }
2600:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_POLL */
2601:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_SELECT && LWIP_SOCKET_POLL
2602:./lwip-2.1.2/src/api/sockets.c ****       else
2603:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_SELECT && LWIP_SOCKET_POLL */
2604:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_SELECT
2605:./lwip-2.1.2/src/api/sockets.c ****       {
2606:./lwip-2.1.2/src/api/sockets.c ****         /* Test this select call for our socket */
2607:./lwip-2.1.2/src/api/sockets.c ****         if (has_recvevent) {
2608:./lwip-2.1.2/src/api/sockets.c ****           if (scb->readset && FD_ISSET(s, scb->readset)) {
2609:./lwip-2.1.2/src/api/sockets.c ****             do_signal = 1;
2610:./lwip-2.1.2/src/api/sockets.c ****           }
2611:./lwip-2.1.2/src/api/sockets.c ****         }
2612:./lwip-2.1.2/src/api/sockets.c ****         if (has_sendevent) {
2613:./lwip-2.1.2/src/api/sockets.c ****           if (!do_signal && scb->writeset && FD_ISSET(s, scb->writeset)) {
2614:./lwip-2.1.2/src/api/sockets.c ****             do_signal = 1;
2615:./lwip-2.1.2/src/api/sockets.c ****           }
2616:./lwip-2.1.2/src/api/sockets.c ****         }
2617:./lwip-2.1.2/src/api/sockets.c ****         if (has_errevent) {
2618:./lwip-2.1.2/src/api/sockets.c ****           if (!do_signal && scb->exceptset && FD_ISSET(s, scb->exceptset)) {
2619:./lwip-2.1.2/src/api/sockets.c ****             do_signal = 1;
2620:./lwip-2.1.2/src/api/sockets.c ****           }
2621:./lwip-2.1.2/src/api/sockets.c ****         }
2622:./lwip-2.1.2/src/api/sockets.c ****       }
2623:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_SELECT */
2624:./lwip-2.1.2/src/api/sockets.c ****       if (do_signal) {
2625:./lwip-2.1.2/src/api/sockets.c ****         scb->sem_signalled = 1;
2626:./lwip-2.1.2/src/api/sockets.c ****         /* For !LWIP_TCPIP_CORE_LOCKING, we don't call SYS_ARCH_UNPROTECT() before signaling
2627:./lwip-2.1.2/src/api/sockets.c ****            the semaphore, as this might lead to the select thread taking itself off the list,
2628:./lwip-2.1.2/src/api/sockets.c ****            invalidating the semaphore. */
2629:./lwip-2.1.2/src/api/sockets.c ****         sys_sem_signal(SELECT_SEM_PTR(scb->sem));
2630:./lwip-2.1.2/src/api/sockets.c ****       }
2631:./lwip-2.1.2/src/api/sockets.c ****     }
2632:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_TCPIP_CORE_LOCKING
2633:./lwip-2.1.2/src/api/sockets.c ****   }
2634:./lwip-2.1.2/src/api/sockets.c **** #else
2635:./lwip-2.1.2/src/api/sockets.c ****     /* unlock interrupts with each step */
2636:./lwip-2.1.2/src/api/sockets.c ****     SYS_ARCH_UNPROTECT(lev);
2637:./lwip-2.1.2/src/api/sockets.c ****     /* this makes sure interrupt protection time is short */
2638:./lwip-2.1.2/src/api/sockets.c ****     SYS_ARCH_PROTECT(lev);
2639:./lwip-2.1.2/src/api/sockets.c ****     if (last_select_cb_ctr != select_cb_ctr) {
2640:./lwip-2.1.2/src/api/sockets.c ****       /* someone has changed select_cb_list, restart at the beginning */
2641:./lwip-2.1.2/src/api/sockets.c ****       goto again;
2642:./lwip-2.1.2/src/api/sockets.c ****     }
2643:./lwip-2.1.2/src/api/sockets.c ****     /* remember the state of select_cb_list to detect changes */
2644:./lwip-2.1.2/src/api/sockets.c ****     last_select_cb_ctr = select_cb_ctr;
2645:./lwip-2.1.2/src/api/sockets.c ****   }
2646:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_UNPROTECT(lev);
2647:./lwip-2.1.2/src/api/sockets.c **** #endif
2648:./lwip-2.1.2/src/api/sockets.c **** }
2649:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_SELECT || LWIP_SOCKET_POLL */
2650:./lwip-2.1.2/src/api/sockets.c **** 
2651:./lwip-2.1.2/src/api/sockets.c **** /**
2652:./lwip-2.1.2/src/api/sockets.c ****  * Close one end of a full-duplex connection.
2653:./lwip-2.1.2/src/api/sockets.c ****  */
2654:./lwip-2.1.2/src/api/sockets.c **** int
2655:./lwip-2.1.2/src/api/sockets.c **** lwip_shutdown(int s, int how)
2656:./lwip-2.1.2/src/api/sockets.c **** {
2657:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_sock *sock;
2658:./lwip-2.1.2/src/api/sockets.c ****   err_t err;

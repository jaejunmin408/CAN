  88:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_IPV4
  89:./lwip-2.1.2/src/api/sockets.c **** #define IP4ADDR_PORT_TO_SOCKADDR(sin, ipaddr, port) do { \
  90:./lwip-2.1.2/src/api/sockets.c ****       (sin)->sin_len = sizeof(struct sockaddr_in); \
  91:./lwip-2.1.2/src/api/sockets.c ****       (sin)->sin_family = AF_INET; \
  92:./lwip-2.1.2/src/api/sockets.c ****       (sin)->sin_port = lwip_htons((port)); \
  93:./lwip-2.1.2/src/api/sockets.c ****       inet_addr_from_ip4addr(&(sin)->sin_addr, ipaddr); \
  94:./lwip-2.1.2/src/api/sockets.c ****       memset((sin)->sin_zero, 0, SIN_ZERO_LEN); }while(0)
  95:./lwip-2.1.2/src/api/sockets.c **** #define SOCKADDR4_TO_IP4ADDR_PORT(sin, ipaddr, port) do { \
  96:./lwip-2.1.2/src/api/sockets.c ****     inet_addr_to_ip4addr(ip_2_ip4(ipaddr), &((sin)->sin_addr)); \
  97:./lwip-2.1.2/src/api/sockets.c ****     (port) = lwip_ntohs((sin)->sin_port); }while(0)
  98:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_IPV4 */

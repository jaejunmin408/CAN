 939:./lwip-2.1.2/src/api/sockets.c ****     /* Check if there is data left from the last recv operation. */
 940:./lwip-2.1.2/src/api/sockets.c ****     if (sock->lastdata.pbuf) {
 941:./lwip-2.1.2/src/api/sockets.c ****       p = sock->lastdata.pbuf;
 942:./lwip-2.1.2/src/api/sockets.c ****     } else {
 943:./lwip-2.1.2/src/api/sockets.c ****       /* No data was left from the previous operation, so we try to get
 944:./lwip-2.1.2/src/api/sockets.c ****          some from the network. */

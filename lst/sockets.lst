 980:./lwip-2.1.2/src/api/sockets.c ****     }
 981:./lwip-2.1.2/src/api/sockets.c **** 
 982:./lwip-2.1.2/src/api/sockets.c ****     /* copy the contents of the received buffer into
 983:./lwip-2.1.2/src/api/sockets.c ****     the supplied memory pointer mem */

1901:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_NETCONN_FULLDUPLEX
1902:./lwip-2.1.2/src/api/sockets.c **** /* Mark all of the set sockets in one of the three fdsets passed to select as used.
1903:./lwip-2.1.2/src/api/sockets.c ****  * All sockets are marked (and later unmarked), whether they are open or not.
1904:./lwip-2.1.2/src/api/sockets.c ****  * This is OK as lwip_selscan aborts select when non-open sockets are found.
1905:./lwip-2.1.2/src/api/sockets.c ****  */
1906:./lwip-2.1.2/src/api/sockets.c **** static void
1907:./lwip-2.1.2/src/api/sockets.c **** lwip_select_inc_sockets_used_set(int maxfdp, fd_set *fdset, fd_set *used_sockets)
1908:./lwip-2.1.2/src/api/sockets.c **** {
1909:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
1910:./lwip-2.1.2/src/api/sockets.c ****   if (fdset) {
1911:./lwip-2.1.2/src/api/sockets.c ****     int i;
1912:./lwip-2.1.2/src/api/sockets.c ****     for (i = LWIP_SOCKET_OFFSET; i < maxfdp; i++) {
1913:./lwip-2.1.2/src/api/sockets.c ****       /* if this FD is in the set, lock it (unless already done) */
1914:./lwip-2.1.2/src/api/sockets.c ****       if (FD_ISSET(i, fdset) && !FD_ISSET(i, used_sockets)) {
1915:./lwip-2.1.2/src/api/sockets.c ****         struct lwip_sock *sock;
1916:./lwip-2.1.2/src/api/sockets.c ****         SYS_ARCH_PROTECT(lev);
1917:./lwip-2.1.2/src/api/sockets.c ****         sock = tryget_socket_unconn_locked(i);
1918:./lwip-2.1.2/src/api/sockets.c ****         if (sock != NULL) {
1919:./lwip-2.1.2/src/api/sockets.c ****           /* leave the socket used until released by lwip_select_dec_sockets_used */
1920:./lwip-2.1.2/src/api/sockets.c ****           FD_SET(i, used_sockets);
1921:./lwip-2.1.2/src/api/sockets.c ****         }
1922:./lwip-2.1.2/src/api/sockets.c ****         SYS_ARCH_UNPROTECT(lev);
1923:./lwip-2.1.2/src/api/sockets.c ****       }
1924:./lwip-2.1.2/src/api/sockets.c ****     }
1925:./lwip-2.1.2/src/api/sockets.c ****   }
1926:./lwip-2.1.2/src/api/sockets.c **** }
1927:./lwip-2.1.2/src/api/sockets.c **** 
1928:./lwip-2.1.2/src/api/sockets.c **** /* Mark all sockets passed to select as used to prevent them from being freed
1929:./lwip-2.1.2/src/api/sockets.c ****  * from other threads while select is running.
1930:./lwip-2.1.2/src/api/sockets.c ****  * Marked sockets are added to 'used_sockets' to mark them only once an be able
1931:./lwip-2.1.2/src/api/sockets.c ****  * to unmark them correctly.
1932:./lwip-2.1.2/src/api/sockets.c ****  */
1933:./lwip-2.1.2/src/api/sockets.c **** static void
1934:./lwip-2.1.2/src/api/sockets.c **** lwip_select_inc_sockets_used(int maxfdp, fd_set *fdset1, fd_set *fdset2, fd_set *fdset3, fd_set *us
1935:./lwip-2.1.2/src/api/sockets.c **** {
1936:./lwip-2.1.2/src/api/sockets.c ****   FD_ZERO(used_sockets);
1937:./lwip-2.1.2/src/api/sockets.c ****   lwip_select_inc_sockets_used_set(maxfdp, fdset1, used_sockets);
1938:./lwip-2.1.2/src/api/sockets.c ****   lwip_select_inc_sockets_used_set(maxfdp, fdset2, used_sockets);
1939:./lwip-2.1.2/src/api/sockets.c ****   lwip_select_inc_sockets_used_set(maxfdp, fdset3, used_sockets);
1940:./lwip-2.1.2/src/api/sockets.c **** }
1941:./lwip-2.1.2/src/api/sockets.c **** 
1942:./lwip-2.1.2/src/api/sockets.c **** /* Let go all sockets that were marked as used when starting select */
1943:./lwip-2.1.2/src/api/sockets.c **** static void
1944:./lwip-2.1.2/src/api/sockets.c **** lwip_select_dec_sockets_used(int maxfdp, fd_set *used_sockets)
1945:./lwip-2.1.2/src/api/sockets.c **** {
1946:./lwip-2.1.2/src/api/sockets.c ****   int i;
1947:./lwip-2.1.2/src/api/sockets.c ****   for (i = LWIP_SOCKET_OFFSET; i < maxfdp; i++) {
1948:./lwip-2.1.2/src/api/sockets.c ****     /* if this FD is not in the set, continue */
1949:./lwip-2.1.2/src/api/sockets.c ****     if (FD_ISSET(i, used_sockets)) {
1950:./lwip-2.1.2/src/api/sockets.c ****       struct lwip_sock *sock = tryget_socket_unconn_nouse(i);
1951:./lwip-2.1.2/src/api/sockets.c ****       LWIP_ASSERT("socket gone at the end of select", sock != NULL);
1952:./lwip-2.1.2/src/api/sockets.c ****       if (sock != NULL) {
1953:./lwip-2.1.2/src/api/sockets.c ****         done_socket(sock);
1954:./lwip-2.1.2/src/api/sockets.c ****       }
1955:./lwip-2.1.2/src/api/sockets.c ****     }
1956:./lwip-2.1.2/src/api/sockets.c ****   }
1957:./lwip-2.1.2/src/api/sockets.c **** }
1958:./lwip-2.1.2/src/api/sockets.c **** #else /* LWIP_NETCONN_FULLDUPLEX */
1959:./lwip-2.1.2/src/api/sockets.c **** #define lwip_select_inc_sockets_used(maxfdp1, readset, writeset, exceptset, used_sockets)
1960:./lwip-2.1.2/src/api/sockets.c **** #define lwip_select_dec_sockets_used(maxfdp1, used_sockets)
1961:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */

 155:./lwip-2.1.2/src/api/sockets.c **** #define IS_SOCK_ADDR_TYPE_VALID_OR_UNSPEC(name)    (((name)->sa_family == AF_UNSPEC) || \
 156:./lwip-2.1.2/src/api/sockets.c ****                                                     IS_SOCK_ADDR_TYPE_VALID(name))
 157:./lwip-2.1.2/src/api/sockets.c **** #define SOCK_ADDR_TYPE_MATCH_OR_UNSPEC(name, sock) (((name)->sa_family == AF_UNSPEC) || \

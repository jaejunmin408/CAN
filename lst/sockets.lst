 152:./lwip-2.1.2/src/api/sockets.c **** #define DOMAIN_TO_NETCONN_TYPE(domain, netconn_type) (netconn_type)
 153:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_IPV6 */

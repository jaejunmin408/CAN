 540:./lwip-2.1.2/src/api/sockets.c **** /** Free a socket (under lock)
 541:./lwip-2.1.2/src/api/sockets.c ****  *
 542:./lwip-2.1.2/src/api/sockets.c ****  * @param sock the socket to free
 543:./lwip-2.1.2/src/api/sockets.c ****  * @param is_tcp != 0 for TCP sockets, used to free lastdata
 544:./lwip-2.1.2/src/api/sockets.c ****  * @param conn the socekt's netconn is stored here, must be freed externally
 545:./lwip-2.1.2/src/api/sockets.c ****  * @param lastdata lastdata is stored here, must be freed externally
 546:./lwip-2.1.2/src/api/sockets.c ****  */
 547:./lwip-2.1.2/src/api/sockets.c **** static int
 548:./lwip-2.1.2/src/api/sockets.c **** free_socket_locked(struct lwip_sock *sock, int is_tcp, struct netconn **conn,
 549:./lwip-2.1.2/src/api/sockets.c ****                    union lwip_sock_lastdata *lastdata)
 550:./lwip-2.1.2/src/api/sockets.c **** {
 551:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_NETCONN_FULLDUPLEX
 552:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("sock->fd_used > 0", sock->fd_used > 0);
 553:./lwip-2.1.2/src/api/sockets.c ****   sock->fd_used--;
 554:./lwip-2.1.2/src/api/sockets.c ****   if (sock->fd_used > 0) {
 555:./lwip-2.1.2/src/api/sockets.c ****     sock->fd_free_pending = LWIP_SOCK_FD_FREE_FREE | (is_tcp ? LWIP_SOCK_FD_FREE_TCP : 0);
 556:./lwip-2.1.2/src/api/sockets.c ****     return 0;
 557:./lwip-2.1.2/src/api/sockets.c ****   }
 558:./lwip-2.1.2/src/api/sockets.c **** #else /* LWIP_NETCONN_FULLDUPLEX */
 559:./lwip-2.1.2/src/api/sockets.c ****   LWIP_UNUSED_ARG(is_tcp);
 560:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 561:./lwip-2.1.2/src/api/sockets.c **** 
 562:./lwip-2.1.2/src/api/sockets.c ****   *lastdata = sock->lastdata;
 563:./lwip-2.1.2/src/api/sockets.c ****   sock->lastdata.pbuf = NULL;
 564:./lwip-2.1.2/src/api/sockets.c ****   *conn = sock->conn;
 565:./lwip-2.1.2/src/api/sockets.c ****   sock->conn = NULL;
 566:./lwip-2.1.2/src/api/sockets.c ****   return 1;
 567:./lwip-2.1.2/src/api/sockets.c **** }
 568:./lwip-2.1.2/src/api/sockets.c **** 
 569:./lwip-2.1.2/src/api/sockets.c **** /** Free a socket's leftover members.
 570:./lwip-2.1.2/src/api/sockets.c ****  */
 571:./lwip-2.1.2/src/api/sockets.c **** static void
 572:./lwip-2.1.2/src/api/sockets.c **** free_socket_free_elements(int is_tcp, struct netconn *conn, union lwip_sock_lastdata *lastdata)
 573:./lwip-2.1.2/src/api/sockets.c **** {
 574:./lwip-2.1.2/src/api/sockets.c ****   if (lastdata->pbuf != NULL) {
 575:./lwip-2.1.2/src/api/sockets.c ****     if (is_tcp) {
 576:./lwip-2.1.2/src/api/sockets.c ****       pbuf_free(lastdata->pbuf);
 577:./lwip-2.1.2/src/api/sockets.c ****     } else {
 578:./lwip-2.1.2/src/api/sockets.c ****       netbuf_delete(lastdata->netbuf);
 579:./lwip-2.1.2/src/api/sockets.c ****     }
 580:./lwip-2.1.2/src/api/sockets.c ****   }
 581:./lwip-2.1.2/src/api/sockets.c ****   if (conn != NULL) {
 582:./lwip-2.1.2/src/api/sockets.c ****     /* netconn_prepare_delete() has already been called, here we only free the conn */
 583:./lwip-2.1.2/src/api/sockets.c ****     netconn_delete(conn);
 584:./lwip-2.1.2/src/api/sockets.c ****   }
 585:./lwip-2.1.2/src/api/sockets.c **** }
 586:./lwip-2.1.2/src/api/sockets.c **** 
 587:./lwip-2.1.2/src/api/sockets.c **** /** Free a socket. The socket's netconn must have been
 588:./lwip-2.1.2/src/api/sockets.c ****  * delete before!
 589:./lwip-2.1.2/src/api/sockets.c ****  *
 590:./lwip-2.1.2/src/api/sockets.c ****  * @param sock the socket to free
 591:./lwip-2.1.2/src/api/sockets.c ****  * @param is_tcp != 0 for TCP sockets, used to free lastdata
 592:./lwip-2.1.2/src/api/sockets.c ****  */
 593:./lwip-2.1.2/src/api/sockets.c **** static void
 594:./lwip-2.1.2/src/api/sockets.c **** free_socket(struct lwip_sock *sock, int is_tcp)
 595:./lwip-2.1.2/src/api/sockets.c **** {
 596:./lwip-2.1.2/src/api/sockets.c ****   int freed;
 597:./lwip-2.1.2/src/api/sockets.c ****   struct netconn *conn;
 598:./lwip-2.1.2/src/api/sockets.c ****   union lwip_sock_lastdata lastdata;
 599:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
 600:./lwip-2.1.2/src/api/sockets.c **** 
 601:./lwip-2.1.2/src/api/sockets.c ****   /* Protect socket array */
 602:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_PROTECT(lev);
 603:./lwip-2.1.2/src/api/sockets.c **** 
 604:./lwip-2.1.2/src/api/sockets.c ****   freed = free_socket_locked(sock, is_tcp, &conn, &lastdata);

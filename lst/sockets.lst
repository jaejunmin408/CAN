2563:./lwip-2.1.2/src/api/sockets.c **** /**
2564:./lwip-2.1.2/src/api/sockets.c ****  * Check if any select waiters are waiting on this socket and its events
2565:./lwip-2.1.2/src/api/sockets.c ****  *
2566:./lwip-2.1.2/src/api/sockets.c ****  * @note on synchronization of select_cb_list:
2567:./lwip-2.1.2/src/api/sockets.c ****  * LWIP_TCPIP_CORE_LOCKING: the select_cb_list must only be accessed while holding
2568:./lwip-2.1.2/src/api/sockets.c ****  * the core lock. We do a single pass through the list and signal any waiters.
2569:./lwip-2.1.2/src/api/sockets.c ****  * Core lock should already be held when calling here!!!!
2570:./lwip-2.1.2/src/api/sockets.c **** 
2571:./lwip-2.1.2/src/api/sockets.c ****  * !LWIP_TCPIP_CORE_LOCKING: we use SYS_ARCH_PROTECT but unlock on each iteration
2572:./lwip-2.1.2/src/api/sockets.c ****  * of the loop, thus creating a possibility where a thread could modify the
2573:./lwip-2.1.2/src/api/sockets.c ****  * select_cb_list during our UNPROTECT/PROTECT. We use a generational counter to
2574:./lwip-2.1.2/src/api/sockets.c ****  * detect this change and restart the list walk. The list is expected to be small
2575:./lwip-2.1.2/src/api/sockets.c ****  */
2576:./lwip-2.1.2/src/api/sockets.c **** static void select_check_waiters(int s, int has_recvevent, int has_sendevent, int has_errevent)
2577:./lwip-2.1.2/src/api/sockets.c **** {
2578:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_select_cb *scb;
2579:./lwip-2.1.2/src/api/sockets.c **** #if !LWIP_TCPIP_CORE_LOCKING
2580:./lwip-2.1.2/src/api/sockets.c ****   int last_select_cb_ctr;
2581:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
2582:./lwip-2.1.2/src/api/sockets.c **** #endif /* !LWIP_TCPIP_CORE_LOCKING */
2583:./lwip-2.1.2/src/api/sockets.c **** 
2584:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT_CORE_LOCKED();
2585:./lwip-2.1.2/src/api/sockets.c **** 
2586:./lwip-2.1.2/src/api/sockets.c **** #if !LWIP_TCPIP_CORE_LOCKING
2587:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_PROTECT(lev);
2588:./lwip-2.1.2/src/api/sockets.c **** again:
2589:./lwip-2.1.2/src/api/sockets.c ****   /* remember the state of select_cb_list to detect changes */
2590:./lwip-2.1.2/src/api/sockets.c ****   last_select_cb_ctr = select_cb_ctr;
2591:./lwip-2.1.2/src/api/sockets.c **** #endif /* !LWIP_TCPIP_CORE_LOCKING */
2592:./lwip-2.1.2/src/api/sockets.c ****   for (scb = select_cb_list; scb != NULL; scb = scb->next) {
2593:./lwip-2.1.2/src/api/sockets.c ****     if (scb->sem_signalled == 0) {
2594:./lwip-2.1.2/src/api/sockets.c ****       /* semaphore not signalled yet */
2595:./lwip-2.1.2/src/api/sockets.c ****       int do_signal = 0;
2596:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_POLL
2597:./lwip-2.1.2/src/api/sockets.c ****       if (scb->poll_fds != NULL) {
2598:./lwip-2.1.2/src/api/sockets.c ****         do_signal = lwip_poll_should_wake(scb, s, has_recvevent, has_sendevent, has_errevent);
2599:./lwip-2.1.2/src/api/sockets.c ****       }
2600:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_POLL */
2601:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_SELECT && LWIP_SOCKET_POLL
2602:./lwip-2.1.2/src/api/sockets.c ****       else
2603:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_SELECT && LWIP_SOCKET_POLL */
2604:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_SOCKET_SELECT
2605:./lwip-2.1.2/src/api/sockets.c ****       {
2606:./lwip-2.1.2/src/api/sockets.c ****         /* Test this select call for our socket */
2607:./lwip-2.1.2/src/api/sockets.c ****         if (has_recvevent) {
2608:./lwip-2.1.2/src/api/sockets.c ****           if (scb->readset && FD_ISSET(s, scb->readset)) {
2609:./lwip-2.1.2/src/api/sockets.c ****             do_signal = 1;
2610:./lwip-2.1.2/src/api/sockets.c ****           }
2611:./lwip-2.1.2/src/api/sockets.c ****         }
2612:./lwip-2.1.2/src/api/sockets.c ****         if (has_sendevent) {
2613:./lwip-2.1.2/src/api/sockets.c ****           if (!do_signal && scb->writeset && FD_ISSET(s, scb->writeset)) {
2614:./lwip-2.1.2/src/api/sockets.c ****             do_signal = 1;
2615:./lwip-2.1.2/src/api/sockets.c ****           }
2616:./lwip-2.1.2/src/api/sockets.c ****         }
2617:./lwip-2.1.2/src/api/sockets.c ****         if (has_errevent) {
2618:./lwip-2.1.2/src/api/sockets.c ****           if (!do_signal && scb->exceptset && FD_ISSET(s, scb->exceptset)) {
2619:./lwip-2.1.2/src/api/sockets.c ****             do_signal = 1;
2620:./lwip-2.1.2/src/api/sockets.c ****           }
2621:./lwip-2.1.2/src/api/sockets.c ****         }
2622:./lwip-2.1.2/src/api/sockets.c ****       }
2623:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_SELECT */
2624:./lwip-2.1.2/src/api/sockets.c ****       if (do_signal) {
2625:./lwip-2.1.2/src/api/sockets.c ****         scb->sem_signalled = 1;
2626:./lwip-2.1.2/src/api/sockets.c ****         /* For !LWIP_TCPIP_CORE_LOCKING, we don't call SYS_ARCH_UNPROTECT() before signaling
2627:./lwip-2.1.2/src/api/sockets.c ****            the semaphore, as this might lead to the select thread taking itself off the list,
2628:./lwip-2.1.2/src/api/sockets.c ****            invalidating the semaphore. */
2629:./lwip-2.1.2/src/api/sockets.c ****         sys_sem_signal(SELECT_SEM_PTR(scb->sem));
2630:./lwip-2.1.2/src/api/sockets.c ****       }
2631:./lwip-2.1.2/src/api/sockets.c ****     }
2632:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_TCPIP_CORE_LOCKING
2633:./lwip-2.1.2/src/api/sockets.c ****   }
2634:./lwip-2.1.2/src/api/sockets.c **** #else
2635:./lwip-2.1.2/src/api/sockets.c ****     /* unlock interrupts with each step */
2636:./lwip-2.1.2/src/api/sockets.c ****     SYS_ARCH_UNPROTECT(lev);
2637:./lwip-2.1.2/src/api/sockets.c ****     /* this makes sure interrupt protection time is short */
2638:./lwip-2.1.2/src/api/sockets.c ****     SYS_ARCH_PROTECT(lev);
2639:./lwip-2.1.2/src/api/sockets.c ****     if (last_select_cb_ctr != select_cb_ctr) {
2640:./lwip-2.1.2/src/api/sockets.c ****       /* someone has changed select_cb_list, restart at the beginning */
2641:./lwip-2.1.2/src/api/sockets.c ****       goto again;
2642:./lwip-2.1.2/src/api/sockets.c ****     }
2643:./lwip-2.1.2/src/api/sockets.c ****     /* remember the state of select_cb_list to detect changes */
2644:./lwip-2.1.2/src/api/sockets.c ****     last_select_cb_ctr = select_cb_ctr;
2645:./lwip-2.1.2/src/api/sockets.c ****   }
2646:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_UNPROTECT(lev);
2647:./lwip-2.1.2/src/api/sockets.c **** #endif
2648:./lwip-2.1.2/src/api/sockets.c **** }
2649:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_SELECT || LWIP_SOCKET_POLL */

 921:./lwip-2.1.2/src/api/sockets.c **** {
 922:./lwip-2.1.2/src/api/sockets.c ****   u8_t apiflags = NETCONN_NOAUTORCVD;
 923:./lwip-2.1.2/src/api/sockets.c ****   ssize_t recvd = 0;
 924:./lwip-2.1.2/src/api/sockets.c ****   ssize_t recv_left = (len <= SSIZE_MAX) ? (ssize_t)len : SSIZE_MAX;
 925:./lwip-2.1.2/src/api/sockets.c **** 
 926:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("no socket given", sock != NULL);
 927:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("this should be checked internally", NETCONNTYPE_GROUP(netconn_type(sock->conn)) == N
 928:./lwip-2.1.2/src/api/sockets.c **** 
 929:./lwip-2.1.2/src/api/sockets.c ****   if (flags & MSG_DONTWAIT) {

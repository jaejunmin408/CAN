 902:./inc/cmsis_gcc.h ****  */
 903:./inc/cmsis_gcc.h **** #define __NOP()                             __ASM volatile ("nop")
 904:./inc/cmsis_gcc.h **** 
 905:./inc/cmsis_gcc.h **** /**

2433:./lwip-2.1.2/src/api/sockets.c **** /**
2434:./lwip-2.1.2/src/api/sockets.c ****  * Check whether event_callback should wake up a thread waiting in
2435:./lwip-2.1.2/src/api/sockets.c ****  * lwip_poll.
2436:./lwip-2.1.2/src/api/sockets.c ****  */
2437:./lwip-2.1.2/src/api/sockets.c **** static int
2438:./lwip-2.1.2/src/api/sockets.c **** lwip_poll_should_wake(const struct lwip_select_cb *scb, int fd, int has_recvevent, int has_sendeven
2439:./lwip-2.1.2/src/api/sockets.c **** {
2440:./lwip-2.1.2/src/api/sockets.c ****   nfds_t fdi;
2441:./lwip-2.1.2/src/api/sockets.c ****   for (fdi = 0; fdi < scb->poll_nfds; fdi++) {
2442:./lwip-2.1.2/src/api/sockets.c ****     const struct pollfd *pollfd = &scb->poll_fds[fdi];
2443:./lwip-2.1.2/src/api/sockets.c ****     if (pollfd->fd == fd) {
2444:./lwip-2.1.2/src/api/sockets.c ****       /* Do not update pollfd->revents right here;
2445:./lwip-2.1.2/src/api/sockets.c ****          that would be a data race because lwip_pollscan
2446:./lwip-2.1.2/src/api/sockets.c ****          accesses revents without protecting. */
2447:./lwip-2.1.2/src/api/sockets.c ****       if (has_recvevent && (pollfd->events & POLLIN) != 0) {
2448:./lwip-2.1.2/src/api/sockets.c ****         return 1;
2449:./lwip-2.1.2/src/api/sockets.c ****       }
2450:./lwip-2.1.2/src/api/sockets.c ****       if (has_sendevent && (pollfd->events & POLLOUT) != 0) {
2451:./lwip-2.1.2/src/api/sockets.c ****         return 1;
2452:./lwip-2.1.2/src/api/sockets.c ****       }
2453:./lwip-2.1.2/src/api/sockets.c ****       if (has_errevent) {
2454:./lwip-2.1.2/src/api/sockets.c ****         /* POLLERR is output only. */
2455:./lwip-2.1.2/src/api/sockets.c ****         return 1;
2456:./lwip-2.1.2/src/api/sockets.c ****       }
2457:./lwip-2.1.2/src/api/sockets.c ****     }
2458:./lwip-2.1.2/src/api/sockets.c ****   }
2459:./lwip-2.1.2/src/api/sockets.c ****   return 0;
2460:./lwip-2.1.2/src/api/sockets.c **** }
2461:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_SOCKET_POLL */

2651:./lwip-2.1.2/src/api/sockets.c **** /**
2652:./lwip-2.1.2/src/api/sockets.c ****  * Close one end of a full-duplex connection.
2653:./lwip-2.1.2/src/api/sockets.c ****  */
2654:./lwip-2.1.2/src/api/sockets.c **** int
2655:./lwip-2.1.2/src/api/sockets.c **** lwip_shutdown(int s, int how)
2656:./lwip-2.1.2/src/api/sockets.c **** {
2657:./lwip-2.1.2/src/api/sockets.c ****   struct lwip_sock *sock;
2658:./lwip-2.1.2/src/api/sockets.c ****   err_t err;
2659:./lwip-2.1.2/src/api/sockets.c ****   u8_t shut_rx = 0, shut_tx = 0;
2660:./lwip-2.1.2/src/api/sockets.c **** 
2661:./lwip-2.1.2/src/api/sockets.c ****   LWIP_DEBUGF(SOCKETS_DEBUG, ("lwip_shutdown(%d, how=%d)\n", s, how));
2662:./lwip-2.1.2/src/api/sockets.c **** 
2663:./lwip-2.1.2/src/api/sockets.c ****   sock = get_socket(s);
2664:./lwip-2.1.2/src/api/sockets.c ****   if (!sock) {
2665:./lwip-2.1.2/src/api/sockets.c ****     return -1;
2666:./lwip-2.1.2/src/api/sockets.c ****   }
2667:./lwip-2.1.2/src/api/sockets.c **** 
2668:./lwip-2.1.2/src/api/sockets.c ****   if (sock->conn != NULL) {
2669:./lwip-2.1.2/src/api/sockets.c ****     if (NETCONNTYPE_GROUP(netconn_type(sock->conn)) != NETCONN_TCP) {
2670:./lwip-2.1.2/src/api/sockets.c ****       sock_set_errno(sock, EOPNOTSUPP);
2671:./lwip-2.1.2/src/api/sockets.c ****       done_socket(sock);
2672:./lwip-2.1.2/src/api/sockets.c ****       return -1;
2673:./lwip-2.1.2/src/api/sockets.c ****     }
2674:./lwip-2.1.2/src/api/sockets.c ****   } else {
2675:./lwip-2.1.2/src/api/sockets.c ****     sock_set_errno(sock, ENOTCONN);
2676:./lwip-2.1.2/src/api/sockets.c ****     done_socket(sock);
2677:./lwip-2.1.2/src/api/sockets.c ****     return -1;
2678:./lwip-2.1.2/src/api/sockets.c ****   }
2679:./lwip-2.1.2/src/api/sockets.c **** 
2680:./lwip-2.1.2/src/api/sockets.c ****   if (how == SHUT_RD) {
2681:./lwip-2.1.2/src/api/sockets.c ****     shut_rx = 1;
2682:./lwip-2.1.2/src/api/sockets.c ****   } else if (how == SHUT_WR) {
2683:./lwip-2.1.2/src/api/sockets.c ****     shut_tx = 1;
2684:./lwip-2.1.2/src/api/sockets.c ****   } else if (how == SHUT_RDWR) {
2685:./lwip-2.1.2/src/api/sockets.c ****     shut_rx = 1;
2686:./lwip-2.1.2/src/api/sockets.c ****     shut_tx = 1;
2687:./lwip-2.1.2/src/api/sockets.c ****   } else {
2688:./lwip-2.1.2/src/api/sockets.c ****     sock_set_errno(sock, EINVAL);
2689:./lwip-2.1.2/src/api/sockets.c ****     done_socket(sock);
2690:./lwip-2.1.2/src/api/sockets.c ****     return -1;
2691:./lwip-2.1.2/src/api/sockets.c ****   }
2692:./lwip-2.1.2/src/api/sockets.c ****   err = netconn_shutdown(sock->conn, shut_rx, shut_tx);
2693:./lwip-2.1.2/src/api/sockets.c **** 
2694:./lwip-2.1.2/src/api/sockets.c ****   sock_set_errno(sock, err_to_errno(err));
2695:./lwip-2.1.2/src/api/sockets.c ****   done_socket(sock);
2696:./lwip-2.1.2/src/api/sockets.c ****   return (err == ERR_OK ? 0 : -1);
2697:./lwip-2.1.2/src/api/sockets.c **** }

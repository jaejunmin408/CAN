 331:./lwip-2.1.2/src/api/sockets.c **** 
 332:./lwip-2.1.2/src/api/sockets.c **** #if LWIP_NETCONN_FULLDUPLEX
 333:./lwip-2.1.2/src/api/sockets.c **** /* Thread-safe increment of sock->fd_used, with overflow check */
 334:./lwip-2.1.2/src/api/sockets.c **** static int
 335:./lwip-2.1.2/src/api/sockets.c **** sock_inc_used(struct lwip_sock *sock)
 336:./lwip-2.1.2/src/api/sockets.c **** {
 337:./lwip-2.1.2/src/api/sockets.c ****   int ret;
 338:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
 339:./lwip-2.1.2/src/api/sockets.c **** 
 340:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("sock != NULL", sock != NULL);
 341:./lwip-2.1.2/src/api/sockets.c **** 
 342:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_PROTECT(lev);
 343:./lwip-2.1.2/src/api/sockets.c ****   if (sock->fd_free_pending) {
 344:./lwip-2.1.2/src/api/sockets.c ****     /* prevent new usage of this socket if free is pending */
 345:./lwip-2.1.2/src/api/sockets.c ****     ret = 0;
 346:./lwip-2.1.2/src/api/sockets.c ****   } else {
 347:./lwip-2.1.2/src/api/sockets.c ****     ++sock->fd_used;
 348:./lwip-2.1.2/src/api/sockets.c ****     ret = 1;
 349:./lwip-2.1.2/src/api/sockets.c ****     LWIP_ASSERT("sock->fd_used != 0", sock->fd_used != 0);
 350:./lwip-2.1.2/src/api/sockets.c ****   }
 351:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_UNPROTECT(lev);
 352:./lwip-2.1.2/src/api/sockets.c ****   return ret;
 353:./lwip-2.1.2/src/api/sockets.c **** }
 354:./lwip-2.1.2/src/api/sockets.c **** 
 355:./lwip-2.1.2/src/api/sockets.c **** /* Like sock_inc_used(), but called under SYS_ARCH_PROTECT lock. */
 356:./lwip-2.1.2/src/api/sockets.c **** static int
 357:./lwip-2.1.2/src/api/sockets.c **** sock_inc_used_locked(struct lwip_sock *sock)
 358:./lwip-2.1.2/src/api/sockets.c **** {
 359:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("sock != NULL", sock != NULL);
 360:./lwip-2.1.2/src/api/sockets.c **** 
 361:./lwip-2.1.2/src/api/sockets.c ****   if (sock->fd_free_pending) {
 362:./lwip-2.1.2/src/api/sockets.c ****     LWIP_ASSERT("sock->fd_used != 0", sock->fd_used != 0);
 363:./lwip-2.1.2/src/api/sockets.c ****     return 0;
 364:./lwip-2.1.2/src/api/sockets.c ****   }
 365:./lwip-2.1.2/src/api/sockets.c **** 
 366:./lwip-2.1.2/src/api/sockets.c ****   ++sock->fd_used;
 367:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("sock->fd_used != 0", sock->fd_used != 0);
 368:./lwip-2.1.2/src/api/sockets.c ****   return 1;
 369:./lwip-2.1.2/src/api/sockets.c **** }
 370:./lwip-2.1.2/src/api/sockets.c **** 
 371:./lwip-2.1.2/src/api/sockets.c **** /* In full-duplex mode,sock->fd_used != 0 prevents a socket descriptor from being
 372:./lwip-2.1.2/src/api/sockets.c ****  * released (and possibly reused) when used from more than one thread
 373:./lwip-2.1.2/src/api/sockets.c ****  * (e.g. read-while-write or close-while-write, etc)
 374:./lwip-2.1.2/src/api/sockets.c ****  * This function is called at the end of functions using (try)get_socket*().
 375:./lwip-2.1.2/src/api/sockets.c ****  */
 376:./lwip-2.1.2/src/api/sockets.c **** static void
 377:./lwip-2.1.2/src/api/sockets.c **** done_socket(struct lwip_sock *sock)
 378:./lwip-2.1.2/src/api/sockets.c **** {
 379:./lwip-2.1.2/src/api/sockets.c ****   int freed = 0;
 380:./lwip-2.1.2/src/api/sockets.c ****   int is_tcp = 0;
 381:./lwip-2.1.2/src/api/sockets.c ****   struct netconn *conn = NULL;
 382:./lwip-2.1.2/src/api/sockets.c ****   union lwip_sock_lastdata lastdata;
 383:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_DECL_PROTECT(lev);
 384:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("sock != NULL", sock != NULL);
 385:./lwip-2.1.2/src/api/sockets.c **** 
 386:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_PROTECT(lev);
 387:./lwip-2.1.2/src/api/sockets.c ****   LWIP_ASSERT("sock->fd_used > 0", sock->fd_used > 0);
 388:./lwip-2.1.2/src/api/sockets.c ****   if (--sock->fd_used == 0) {
 389:./lwip-2.1.2/src/api/sockets.c ****     if (sock->fd_free_pending) {
 390:./lwip-2.1.2/src/api/sockets.c ****       /* free the socket */
 391:./lwip-2.1.2/src/api/sockets.c ****       sock->fd_used = 1;
 392:./lwip-2.1.2/src/api/sockets.c ****       is_tcp = sock->fd_free_pending & LWIP_SOCK_FD_FREE_TCP;
 393:./lwip-2.1.2/src/api/sockets.c ****       freed = free_socket_locked(sock, is_tcp, &conn, &lastdata);
 394:./lwip-2.1.2/src/api/sockets.c ****     }
 395:./lwip-2.1.2/src/api/sockets.c ****   }
 396:./lwip-2.1.2/src/api/sockets.c ****   SYS_ARCH_UNPROTECT(lev);
 397:./lwip-2.1.2/src/api/sockets.c **** 
 398:./lwip-2.1.2/src/api/sockets.c ****   if (freed) {
 399:./lwip-2.1.2/src/api/sockets.c ****     free_socket_free_elements(is_tcp, conn, &lastdata);
 400:./lwip-2.1.2/src/api/sockets.c ****   }
 401:./lwip-2.1.2/src/api/sockets.c **** }
 402:./lwip-2.1.2/src/api/sockets.c **** 
 403:./lwip-2.1.2/src/api/sockets.c **** #else /* LWIP_NETCONN_FULLDUPLEX */
 404:./lwip-2.1.2/src/api/sockets.c **** #define sock_inc_used(sock)         1
 405:./lwip-2.1.2/src/api/sockets.c **** #define sock_inc_used_locked(sock)  1
 406:./lwip-2.1.2/src/api/sockets.c **** #define done_socket(sock)
 407:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 408:./lwip-2.1.2/src/api/sockets.c **** 
 409:./lwip-2.1.2/src/api/sockets.c **** /* Translate a socket 'int' into a pointer (only fails if the index is invalid) */
 410:./lwip-2.1.2/src/api/sockets.c **** static struct lwip_sock *
 411:./lwip-2.1.2/src/api/sockets.c **** tryget_socket_unconn_nouse(int fd)
 412:./lwip-2.1.2/src/api/sockets.c **** {
 413:./lwip-2.1.2/src/api/sockets.c ****   int s = fd - LWIP_SOCKET_OFFSET;
 414:./lwip-2.1.2/src/api/sockets.c ****   if ((s < 0) || (s >= NUM_SOCKETS)) {
 415:./lwip-2.1.2/src/api/sockets.c ****     LWIP_DEBUGF(SOCKETS_DEBUG, ("tryget_socket_unconn(%d): invalid\n", fd));
 416:./lwip-2.1.2/src/api/sockets.c ****     return NULL;
 417:./lwip-2.1.2/src/api/sockets.c ****   }
 418:./lwip-2.1.2/src/api/sockets.c ****   return &sockets[s];
 419:./lwip-2.1.2/src/api/sockets.c **** }
 420:./lwip-2.1.2/src/api/sockets.c **** 

1793:./lwip-2.1.2/src/api/sockets.c **** /* Remove select_cb from select_cb_list. */
1794:./lwip-2.1.2/src/api/sockets.c **** static void
1795:./lwip-2.1.2/src/api/sockets.c **** lwip_unlink_select_cb(struct lwip_select_cb *select_cb)
1796:./lwip-2.1.2/src/api/sockets.c **** {

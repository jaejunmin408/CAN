 101:./lwip-2.1.2/src/api/sockets.c **** #define IP6ADDR_PORT_TO_SOCKADDR(sin6, ipaddr, port) do { \
 102:./lwip-2.1.2/src/api/sockets.c ****       (sin6)->sin6_len = sizeof(struct sockaddr_in6); \
 103:./lwip-2.1.2/src/api/sockets.c ****       (sin6)->sin6_family = AF_INET6; \
 104:./lwip-2.1.2/src/api/sockets.c ****       (sin6)->sin6_port = lwip_htons((port)); \
 105:./lwip-2.1.2/src/api/sockets.c ****       (sin6)->sin6_flowinfo = 0; \
 106:./lwip-2.1.2/src/api/sockets.c ****       inet6_addr_from_ip6addr(&(sin6)->sin6_addr, ipaddr); \
 107:./lwip-2.1.2/src/api/sockets.c ****       (sin6)->sin6_scope_id = ip6_addr_zone(ipaddr); }while(0)
 108:./lwip-2.1.2/src/api/sockets.c **** #define SOCKADDR6_TO_IP6ADDR_PORT(sin6, ipaddr, port) do { \
 109:./lwip-2.1.2/src/api/sockets.c ****     inet6_addr_to_ip6addr(ip_2_ip6(ipaddr), &((sin6)->sin6_addr)); \
 110:./lwip-2.1.2/src/api/sockets.c ****     if (ip6_addr_has_scope(ip_2_ip6(ipaddr), IP6_UNKNOWN)) { \
 111:./lwip-2.1.2/src/api/sockets.c ****       ip6_addr_set_zone(ip_2_ip6(ipaddr), (u8_t)((sin6)->sin6_scope_id)); \
 112:./lwip-2.1.2/src/api/sockets.c ****     } \
 113:./lwip-2.1.2/src/api/sockets.c ****     (port) = lwip_ntohs((sin6)->sin6_port); }while(0)
 114:./lwip-2.1.2/src/api/sockets.c **** #endif /* LWIP_IPV6 */

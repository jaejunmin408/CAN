 988:./lwip-2.1.2/src/api/sockets.c ****     /* TCP combines multiple pbufs for one recv */
 989:./lwip-2.1.2/src/api/sockets.c ****     LWIP_ASSERT("invalid copylen, len would underflow", recv_left >= copylen);
 990:./lwip-2.1.2/src/api/sockets.c ****     recv_left -= copylen;
 991:./lwip-2.1.2/src/api/sockets.c **** 
 992:./lwip-2.1.2/src/api/sockets.c ****     /* Unless we peek the incoming message... */
 993:./lwip-2.1.2/src/api/sockets.c ****     if ((flags & MSG_PEEK) == 0) {

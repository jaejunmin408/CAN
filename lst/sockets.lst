 137:./lwip-2.1.2/src/api/sockets.c **** #define IS_SOCK_ADDR_TYPE_VALID(name)    ((name)->sa_family == AF_INET6)
 138:./lwip-2.1.2/src/api/sockets.c **** #define SOCK_ADDR_TYPE_MATCH(name, sock) 1
 139:./lwip-2.1.2/src/api/sockets.c **** #define IPADDR_PORT_TO_SOCKADDR(sockaddr, ipaddr, port) \
 140:./lwip-2.1.2/src/api/sockets.c ****         IP6ADDR_PORT_TO_SOCKADDR((struct sockaddr_in6*)(void*)(sockaddr), ip_2_ip6(ipaddr), port)
 141:./lwip-2.1.2/src/api/sockets.c **** #define SOCKADDR_TO_IPADDR_PORT(sockaddr, ipaddr, port) \

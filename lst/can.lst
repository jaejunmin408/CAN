 243:./inc/cmsis_gcc.h **** /**
 244:./inc/cmsis_gcc.h ****   \brief   Set Control Register
 245:./inc/cmsis_gcc.h ****   \details Writes the given value to the Control Register.
 246:./inc/cmsis_gcc.h ****   \param [in]    control  Control Register value to set
 247:./inc/cmsis_gcc.h ****  */
 248:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __set_CONTROL(uint32_t control)
 249:./inc/cmsis_gcc.h **** {
 250:./inc/cmsis_gcc.h ****   __ASM volatile ("MSR control, %0" : : "r" (control) : "memory");
 251:./inc/cmsis_gcc.h **** }
 252:./inc/cmsis_gcc.h **** 
 253:./inc/cmsis_gcc.h **** 
 254:./inc/cmsis_gcc.h **** #if (defined (__ARM_FEATURE_CMSE ) && (__ARM_FEATURE_CMSE == 3))
 255:./inc/cmsis_gcc.h **** /**
 256:./inc/cmsis_gcc.h ****   \brief   Set Control Register (non-secure)
 257:./inc/cmsis_gcc.h ****   \details Writes the given value to the non-secure Control Register when in secure state.
 258:./inc/cmsis_gcc.h ****   \param [in]    control  Control Register value to set
 259:./inc/cmsis_gcc.h ****  */

 228:./inc/cmsis_gcc.h **** /**
 229:./inc/cmsis_gcc.h ****   \brief   Get Control Register (non-secure)
 230:./inc/cmsis_gcc.h ****   \details Returns the content of the non-secure Control Register when in secure mode.
 231:./inc/cmsis_gcc.h ****   \return               non-secure Control Register value
 232:./inc/cmsis_gcc.h ****  */
 233:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __TZ_get_CONTROL_NS(void)
 234:./inc/cmsis_gcc.h **** {
 235:./inc/cmsis_gcc.h ****   uint32_t result;

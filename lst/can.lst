 883:./inc/cmsis_gcc.h ****   @{
 884:./inc/cmsis_gcc.h **** */
 885:./inc/cmsis_gcc.h **** 
 886:./inc/cmsis_gcc.h **** /* Define macros for porting to both thumb1 and thumb2.
 887:./inc/cmsis_gcc.h ****  * For thumb1, use low register (r0-r7), specified by constraint "l"
 888:./inc/cmsis_gcc.h ****  * Otherwise, use general registers, specified by constraint "r" */
 889:./inc/cmsis_gcc.h **** #if defined (__thumb__) && !defined (__thumb2__)
 890:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=l" (r)
 891:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+l" (r)
 892:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "l" (r)
 893:./inc/cmsis_gcc.h **** #else
 894:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=r" (r)
 895:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+r" (r)
 896:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "r" (r)
 897:./inc/cmsis_gcc.h **** #endif
 898:./inc/cmsis_gcc.h **** 
 899:./inc/cmsis_gcc.h **** /**
 900:./inc/cmsis_gcc.h ****   \brief   No Operation
 901:./inc/cmsis_gcc.h ****   \details No Operation does nothing. This instruction can be used for code alignment purposes.
 902:./inc/cmsis_gcc.h ****  */
 903:./inc/cmsis_gcc.h **** #define __NOP()                             __ASM volatile ("nop")
 904:./inc/cmsis_gcc.h **** 
 905:./inc/cmsis_gcc.h **** /**
 906:./inc/cmsis_gcc.h ****   \brief   Wait For Interrupt
 907:./inc/cmsis_gcc.h ****   \details Wait For Interrupt is a hint instruction that suspends execution until one of a number o
 908:./inc/cmsis_gcc.h ****  */
 909:./inc/cmsis_gcc.h **** #define __WFI()                             __ASM volatile ("wfi")
 910:./inc/cmsis_gcc.h **** 
 911:./inc/cmsis_gcc.h **** 
 912:./inc/cmsis_gcc.h **** /**
 913:./inc/cmsis_gcc.h ****   \brief   Wait For Event
 914:./inc/cmsis_gcc.h ****   \details Wait For Event is a hint instruction that permits the processor to enter
 915:./inc/cmsis_gcc.h ****            a low-power state until one of a number of events occurs.
 916:./inc/cmsis_gcc.h ****  */
 917:./inc/cmsis_gcc.h **** #define __WFE()                             __ASM volatile ("wfe")
 918:./inc/cmsis_gcc.h **** 
 919:./inc/cmsis_gcc.h **** 
 920:./inc/cmsis_gcc.h **** /**
 921:./inc/cmsis_gcc.h ****   \brief   Send Event
 922:./inc/cmsis_gcc.h ****   \details Send Event is a hint instruction. It causes an event to be signaled to the CPU.
 923:./inc/cmsis_gcc.h ****  */
 924:./inc/cmsis_gcc.h **** #define __SEV()                             __ASM volatile ("sev")
 925:./inc/cmsis_gcc.h **** 
 926:./inc/cmsis_gcc.h **** 
 927:./inc/cmsis_gcc.h **** /**
 928:./inc/cmsis_gcc.h ****   \brief   Instruction Synchronization Barrier
 929:./inc/cmsis_gcc.h ****   \details Instruction Synchronization Barrier flushes the pipeline in the processor,
 930:./inc/cmsis_gcc.h ****            so that all instructions following the ISB are fetched from cache or memory,
 931:./inc/cmsis_gcc.h ****            after the instruction has been completed.
 932:./inc/cmsis_gcc.h ****  */
 933:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __ISB(void)
 934:./inc/cmsis_gcc.h **** {
 935:./inc/cmsis_gcc.h ****   __ASM volatile ("isb 0xF":::"memory");
 936:./inc/cmsis_gcc.h **** }
 937:./inc/cmsis_gcc.h **** 
 938:./inc/cmsis_gcc.h **** 
 939:./inc/cmsis_gcc.h **** /**
 940:./inc/cmsis_gcc.h ****   \brief   Data Synchronization Barrier
 941:./inc/cmsis_gcc.h ****   \details Acts as a special kind of Data Memory Barrier.
 942:./inc/cmsis_gcc.h ****            It completes when all explicit memory accesses before this instruction complete.
 943:./inc/cmsis_gcc.h ****  */
 944:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __DSB(void)

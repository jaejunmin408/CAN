 857:./inc/cmsis_gcc.h ****   \param [in]    fpscr  Floating Point Status/Control value to set
 858:./inc/cmsis_gcc.h ****  */
 859:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __set_FPSCR(uint32_t fpscr)
 860:./inc/cmsis_gcc.h **** {
 861:./inc/cmsis_gcc.h **** #if ((defined (__FPU_PRESENT) && (__FPU_PRESENT == 1U)) && \
 862:./inc/cmsis_gcc.h ****      (defined (__FPU_USED   ) && (__FPU_USED    == 1U))     )
 863:./inc/cmsis_gcc.h **** #if __has_builtin(__builtin_arm_set_fpscr)
 864:./inc/cmsis_gcc.h **** // Re-enable using built-in when GCC has been fixed
 865:./inc/cmsis_gcc.h **** // || (__GNUC__ > 7) || (__GNUC__ == 7 && __GNUC_MINOR__ >= 2)
 866:./inc/cmsis_gcc.h ****   /* see https://gcc.gnu.org/ml/gcc-patches/2017-04/msg00443.html */
 867:./inc/cmsis_gcc.h ****   __builtin_arm_set_fpscr(fpscr);
 868:./inc/cmsis_gcc.h **** #else
 869:./inc/cmsis_gcc.h ****   __ASM volatile ("VMSR fpscr, %0" : : "r" (fpscr) : "vfpcc", "memory");
 870:./inc/cmsis_gcc.h **** #endif
 871:./inc/cmsis_gcc.h **** #else
 872:./inc/cmsis_gcc.h ****   (void)fpscr;
 873:./inc/cmsis_gcc.h **** #endif
 874:./inc/cmsis_gcc.h **** }

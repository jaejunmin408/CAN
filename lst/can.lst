 652:./inc/cmsis_gcc.h ****   Devices without ARMv8-M Main Extensions (i.e. Cortex-M23) lack the non-secure
 653:./inc/cmsis_gcc.h ****   Stack Pointer Limit register hence zero is returned always in non-secure
 654:./inc/cmsis_gcc.h ****   mode.
 655:./inc/cmsis_gcc.h ****   
 656:./inc/cmsis_gcc.h ****   \details Returns the current value of the Process Stack Pointer Limit (PSPLIM).
 657:./inc/cmsis_gcc.h ****   \return               PSPLIM Register value
 658:./inc/cmsis_gcc.h ****  */
 659:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __get_PSPLIM(void)
 660:./inc/cmsis_gcc.h **** {
 661:./inc/cmsis_gcc.h **** #if (!(defined (__ARM_ARCH_8M_MAIN__ ) && (__ARM_ARCH_8M_MAIN__ == 1)) && \
 662:./inc/cmsis_gcc.h ****     (!defined (__ARM_FEATURE_CMSE) || (__ARM_FEATURE_CMSE < 3)))
 663:./inc/cmsis_gcc.h ****     // without main extensions, the non-secure PSPLIM is RAZ/WI
 664:./inc/cmsis_gcc.h ****   return 0U;
 665:./inc/cmsis_gcc.h **** #else
 666:./inc/cmsis_gcc.h ****   uint32_t result;
 667:./inc/cmsis_gcc.h ****   __ASM volatile ("MRS %0, psplim"  : "=r" (result) );
 668:./inc/cmsis_gcc.h ****   return result;
 669:./inc/cmsis_gcc.h **** #endif
 670:./inc/cmsis_gcc.h **** }

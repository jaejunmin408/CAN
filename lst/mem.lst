 786:./inc/cmsis_gcc.h ****   Stack Pointer Limit register hence the write is silently ignored in non-secure
 787:./inc/cmsis_gcc.h ****   mode.
 788:./inc/cmsis_gcc.h **** 
 789:./inc/cmsis_gcc.h ****   \details Assigns the given value to the Main Stack Pointer Limit (MSPLIM).
 790:./inc/cmsis_gcc.h ****   \param [in]    MainStackPtrLimit  Main Stack Pointer Limit value to set
 791:./inc/cmsis_gcc.h ****  */
 792:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __set_MSPLIM(uint32_t MainStackPtrLimit)
 793:./inc/cmsis_gcc.h **** {
 794:./inc/cmsis_gcc.h **** #if (!(defined (__ARM_ARCH_8M_MAIN__ ) && (__ARM_ARCH_8M_MAIN__ == 1)) && \
 795:./inc/cmsis_gcc.h ****     (!defined (__ARM_FEATURE_CMSE) || (__ARM_FEATURE_CMSE < 3)))
 796:./inc/cmsis_gcc.h ****   // without main extensions, the non-secure MSPLIM is RAZ/WI
 797:./inc/cmsis_gcc.h ****   (void)MainStackPtrLimit;
 798:./inc/cmsis_gcc.h **** #else
 799:./inc/cmsis_gcc.h ****   __ASM volatile ("MSR msplim, %0" : : "r" (MainStackPtrLimit));
 800:./inc/cmsis_gcc.h **** #endif
 801:./inc/cmsis_gcc.h **** }
 802:./inc/cmsis_gcc.h **** 
 803:./inc/cmsis_gcc.h **** 
 804:./inc/cmsis_gcc.h **** #if (defined (__ARM_FEATURE_CMSE  ) && (__ARM_FEATURE_CMSE   == 3))
 805:./inc/cmsis_gcc.h **** /**
 806:./inc/cmsis_gcc.h ****   \brief   Set Main Stack Pointer Limit (non-secure)
 807:./inc/cmsis_gcc.h ****   Devices without ARMv8-M Main Extensions (i.e. Cortex-M23) lack the non-secure
 808:./inc/cmsis_gcc.h ****   Stack Pointer Limit register hence the write is silently ignored.
 809:./inc/cmsis_gcc.h **** 
 810:./inc/cmsis_gcc.h ****   \details Assigns the given value to the non-secure Main Stack Pointer Limit (MSPLIM) when in secu
 811:./inc/cmsis_gcc.h ****   \param [in]    MainStackPtrLimit  Main Stack Pointer value to set
 812:./inc/cmsis_gcc.h ****  */
 813:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __TZ_set_MSPLIM_NS(uint32_t MainStackPtrLimit)
 814:./inc/cmsis_gcc.h **** {
 815:./inc/cmsis_gcc.h **** #if (!(defined (__ARM_ARCH_8M_MAIN__ ) && (__ARM_ARCH_8M_MAIN__ == 1)))
 816:./inc/cmsis_gcc.h ****   // without main extensions, the non-secure MSPLIM is RAZ/WI
 817:./inc/cmsis_gcc.h ****   (void)MainStackPtrLimit;
 818:./inc/cmsis_gcc.h **** #else
 819:./inc/cmsis_gcc.h ****   __ASM volatile ("MSR msplim_ns, %0" : : "r" (MainStackPtrLimit));
 820:./inc/cmsis_gcc.h **** #endif
 821:./inc/cmsis_gcc.h **** }
 822:./inc/cmsis_gcc.h **** #endif
 823:./inc/cmsis_gcc.h **** 
 824:./inc/cmsis_gcc.h **** #endif /* ((defined (__ARM_ARCH_8M_MAIN__ ) && (__ARM_ARCH_8M_MAIN__ == 1)) || \
 825:./inc/cmsis_gcc.h ****            (defined (__ARM_ARCH_8M_BASE__ ) && (__ARM_ARCH_8M_BASE__ == 1))    ) */
 826:./inc/cmsis_gcc.h **** 

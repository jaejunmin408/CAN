  56:./lwip-2.1.2/src/core/mem.c **** #include "lwip/opt.h"
  57:./lwip-2.1.2/src/core/mem.c **** #include "lwip/mem.h"
  58:./lwip-2.1.2/src/core/mem.c **** #include "lwip/def.h"
  59:./lwip-2.1.2/src/core/mem.c **** #include "lwip/sys.h"
  60:./lwip-2.1.2/src/core/mem.c **** #include "lwip/stats.h"
  61:./lwip-2.1.2/src/core/mem.c **** #include "lwip/err.h"
  62:./lwip-2.1.2/src/core/mem.c **** 
  63:./lwip-2.1.2/src/core/mem.c **** #include <string.h>
  64:./lwip-2.1.2/src/core/mem.c **** 
  65:./lwip-2.1.2/src/core/mem.c **** #if MEM_LIBC_MALLOC
  66:./lwip-2.1.2/src/core/mem.c **** #include <stdlib.h> /* for malloc()/free() */
  67:./lwip-2.1.2/src/core/mem.c **** #endif
  68:./lwip-2.1.2/src/core/mem.c **** 
  69:./lwip-2.1.2/src/core/mem.c **** /* This is overridable for tests only... */
  70:./lwip-2.1.2/src/core/mem.c **** #ifndef LWIP_MEM_ILLEGAL_FREE
  71:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ILLEGAL_FREE(msg)         LWIP_ASSERT(msg, 0)
  72:./lwip-2.1.2/src/core/mem.c **** #endif
  73:./lwip-2.1.2/src/core/mem.c **** 
  74:./lwip-2.1.2/src/core/mem.c **** #define MEM_STATS_INC_LOCKED(x)         SYS_ARCH_LOCKED(MEM_STATS_INC(x))
  75:./lwip-2.1.2/src/core/mem.c **** #define MEM_STATS_INC_USED_LOCKED(x, y) SYS_ARCH_LOCKED(MEM_STATS_INC_USED(x, y))
  76:./lwip-2.1.2/src/core/mem.c **** #define MEM_STATS_DEC_USED_LOCKED(x, y) SYS_ARCH_LOCKED(MEM_STATS_DEC_USED(x, y))
  77:./lwip-2.1.2/src/core/mem.c **** 
  78:./lwip-2.1.2/src/core/mem.c **** #if MEM_OVERFLOW_CHECK
  79:./lwip-2.1.2/src/core/mem.c **** #define MEM_SANITY_OFFSET   MEM_SANITY_REGION_BEFORE_ALIGNED
  80:./lwip-2.1.2/src/core/mem.c **** #define MEM_SANITY_OVERHEAD (MEM_SANITY_REGION_BEFORE_ALIGNED + MEM_SANITY_REGION_AFTER_ALIGNED)
  81:./lwip-2.1.2/src/core/mem.c **** #else
  82:./lwip-2.1.2/src/core/mem.c **** #define MEM_SANITY_OFFSET   0
  83:./lwip-2.1.2/src/core/mem.c **** #define MEM_SANITY_OVERHEAD 0
  84:./lwip-2.1.2/src/core/mem.c **** #endif
  85:./lwip-2.1.2/src/core/mem.c **** 
  86:./lwip-2.1.2/src/core/mem.c **** #if MEM_OVERFLOW_CHECK || MEMP_OVERFLOW_CHECK
  87:./lwip-2.1.2/src/core/mem.c **** /**
  88:./lwip-2.1.2/src/core/mem.c ****  * Check if a mep element was victim of an overflow or underflow
  89:./lwip-2.1.2/src/core/mem.c ****  * (e.g. the restricted area after/before it has been altered)
  90:./lwip-2.1.2/src/core/mem.c ****  *
  91:./lwip-2.1.2/src/core/mem.c ****  * @param p the mem element to check
  92:./lwip-2.1.2/src/core/mem.c ****  * @param size allocated size of the element
  93:./lwip-2.1.2/src/core/mem.c ****  * @param descr1 description of the element source shown on error
  94:./lwip-2.1.2/src/core/mem.c ****  * @param descr2 description of the element source shown on error
  95:./lwip-2.1.2/src/core/mem.c ****  */
  96:./lwip-2.1.2/src/core/mem.c **** void
  97:./lwip-2.1.2/src/core/mem.c **** mem_overflow_check_raw(void *p, size_t size, const char *descr1, const char *descr2)
  98:./lwip-2.1.2/src/core/mem.c **** {
  99:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_REGION_AFTER_ALIGNED || MEM_SANITY_REGION_BEFORE_ALIGNED
 100:./lwip-2.1.2/src/core/mem.c ****   u16_t k;
 101:./lwip-2.1.2/src/core/mem.c ****   u8_t *m;
 102:./lwip-2.1.2/src/core/mem.c **** 
 103:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_REGION_AFTER_ALIGNED > 0
 104:./lwip-2.1.2/src/core/mem.c ****   m = (u8_t *)p + size;
 105:./lwip-2.1.2/src/core/mem.c ****   for (k = 0; k < MEM_SANITY_REGION_AFTER_ALIGNED; k++) {
 106:./lwip-2.1.2/src/core/mem.c ****     if (m[k] != 0xcd) {
 107:./lwip-2.1.2/src/core/mem.c ****       char errstr[128];
 108:./lwip-2.1.2/src/core/mem.c ****       snprintf(errstr, sizeof(errstr), "detected mem overflow in %s%s", descr1, descr2);
 109:./lwip-2.1.2/src/core/mem.c ****       LWIP_ASSERT(errstr, 0);
 110:./lwip-2.1.2/src/core/mem.c ****     }
 111:./lwip-2.1.2/src/core/mem.c ****   }
 112:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_SANITY_REGION_AFTER_ALIGNED > 0 */
 113:./lwip-2.1.2/src/core/mem.c **** 
 114:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_REGION_BEFORE_ALIGNED > 0
 115:./lwip-2.1.2/src/core/mem.c ****   m = (u8_t *)p - MEM_SANITY_REGION_BEFORE_ALIGNED;
 116:./lwip-2.1.2/src/core/mem.c ****   for (k = 0; k < MEM_SANITY_REGION_BEFORE_ALIGNED; k++) {
 117:./lwip-2.1.2/src/core/mem.c ****     if (m[k] != 0xcd) {
 118:./lwip-2.1.2/src/core/mem.c ****       char errstr[128];
 119:./lwip-2.1.2/src/core/mem.c ****       snprintf(errstr, sizeof(errstr), "detected mem underflow in %s%s", descr1, descr2);
 120:./lwip-2.1.2/src/core/mem.c ****       LWIP_ASSERT(errstr, 0);
 121:./lwip-2.1.2/src/core/mem.c ****     }
 122:./lwip-2.1.2/src/core/mem.c ****   }
 123:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_SANITY_REGION_BEFORE_ALIGNED > 0 */
 124:./lwip-2.1.2/src/core/mem.c **** #else
 125:./lwip-2.1.2/src/core/mem.c ****   LWIP_UNUSED_ARG(p);
 126:./lwip-2.1.2/src/core/mem.c ****   LWIP_UNUSED_ARG(desc);
 127:./lwip-2.1.2/src/core/mem.c ****   LWIP_UNUSED_ARG(descr);
 128:./lwip-2.1.2/src/core/mem.c **** #endif
 129:./lwip-2.1.2/src/core/mem.c **** }
 130:./lwip-2.1.2/src/core/mem.c **** 
 131:./lwip-2.1.2/src/core/mem.c **** /**
 132:./lwip-2.1.2/src/core/mem.c ****  * Initialize the restricted area of a mem element.
 133:./lwip-2.1.2/src/core/mem.c ****  */
 134:./lwip-2.1.2/src/core/mem.c **** void
 135:./lwip-2.1.2/src/core/mem.c **** mem_overflow_init_raw(void *p, size_t size)
 136:./lwip-2.1.2/src/core/mem.c **** {
 137:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_REGION_BEFORE_ALIGNED > 0 || MEM_SANITY_REGION_AFTER_ALIGNED > 0
 138:./lwip-2.1.2/src/core/mem.c ****   u8_t *m;
 139:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_REGION_BEFORE_ALIGNED > 0
 140:./lwip-2.1.2/src/core/mem.c ****   m = (u8_t *)p - MEM_SANITY_REGION_BEFORE_ALIGNED;
 141:./lwip-2.1.2/src/core/mem.c ****   memset(m, 0xcd, MEM_SANITY_REGION_BEFORE_ALIGNED);
 142:./lwip-2.1.2/src/core/mem.c **** #endif
 143:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_REGION_AFTER_ALIGNED > 0
 144:./lwip-2.1.2/src/core/mem.c ****   m = (u8_t *)p + size;
 145:./lwip-2.1.2/src/core/mem.c ****   memset(m, 0xcd, MEM_SANITY_REGION_AFTER_ALIGNED);
 146:./lwip-2.1.2/src/core/mem.c **** #endif
 147:./lwip-2.1.2/src/core/mem.c **** #else /* MEM_SANITY_REGION_BEFORE_ALIGNED > 0 || MEM_SANITY_REGION_AFTER_ALIGNED > 0 */
 148:./lwip-2.1.2/src/core/mem.c ****   LWIP_UNUSED_ARG(p);
 149:./lwip-2.1.2/src/core/mem.c ****   LWIP_UNUSED_ARG(desc);
 150:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_SANITY_REGION_BEFORE_ALIGNED > 0 || MEM_SANITY_REGION_AFTER_ALIGNED > 0 */
 151:./lwip-2.1.2/src/core/mem.c **** }
 152:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_OVERFLOW_CHECK || MEMP_OVERFLOW_CHECK */
 153:./lwip-2.1.2/src/core/mem.c **** 
 154:./lwip-2.1.2/src/core/mem.c **** #if MEM_LIBC_MALLOC || MEM_USE_POOLS
 155:./lwip-2.1.2/src/core/mem.c **** 
 156:./lwip-2.1.2/src/core/mem.c **** /** mem_init is not used when using pools instead of a heap or using
 157:./lwip-2.1.2/src/core/mem.c ****  * C library malloc().
 158:./lwip-2.1.2/src/core/mem.c ****  */
 159:./lwip-2.1.2/src/core/mem.c **** void
 160:./lwip-2.1.2/src/core/mem.c **** mem_init(void)
 161:./lwip-2.1.2/src/core/mem.c **** {
 162:./lwip-2.1.2/src/core/mem.c **** }
 163:./lwip-2.1.2/src/core/mem.c **** 
 164:./lwip-2.1.2/src/core/mem.c **** /** mem_trim is not used when using pools instead of a heap or using
 165:./lwip-2.1.2/src/core/mem.c ****  * C library malloc(): we can't free part of a pool element and the stack
 166:./lwip-2.1.2/src/core/mem.c ****  * support mem_trim() to return a different pointer
 167:./lwip-2.1.2/src/core/mem.c ****  */
 168:./lwip-2.1.2/src/core/mem.c **** void *
 169:./lwip-2.1.2/src/core/mem.c **** mem_trim(void *mem, mem_size_t size)
 170:./lwip-2.1.2/src/core/mem.c **** {
 171:./lwip-2.1.2/src/core/mem.c ****   LWIP_UNUSED_ARG(size);
 172:./lwip-2.1.2/src/core/mem.c ****   return mem;
 173:./lwip-2.1.2/src/core/mem.c **** }
 174:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_LIBC_MALLOC || MEM_USE_POOLS */
 175:./lwip-2.1.2/src/core/mem.c **** 
 176:./lwip-2.1.2/src/core/mem.c **** #if MEM_LIBC_MALLOC
 177:./lwip-2.1.2/src/core/mem.c **** /* lwIP heap implemented using C library malloc() */
 178:./lwip-2.1.2/src/core/mem.c **** 
 179:./lwip-2.1.2/src/core/mem.c **** /* in case C library malloc() needs extra protection,
 180:./lwip-2.1.2/src/core/mem.c ****  * allow these defines to be overridden.
 181:./lwip-2.1.2/src/core/mem.c ****  */
 182:./lwip-2.1.2/src/core/mem.c **** #ifndef mem_clib_free
 183:./lwip-2.1.2/src/core/mem.c **** #define mem_clib_free free
 184:./lwip-2.1.2/src/core/mem.c **** #endif
 185:./lwip-2.1.2/src/core/mem.c **** #ifndef mem_clib_malloc
 186:./lwip-2.1.2/src/core/mem.c **** #define mem_clib_malloc malloc
 187:./lwip-2.1.2/src/core/mem.c **** #endif
 188:./lwip-2.1.2/src/core/mem.c **** #ifndef mem_clib_calloc
 189:./lwip-2.1.2/src/core/mem.c **** #define mem_clib_calloc calloc
 190:./lwip-2.1.2/src/core/mem.c **** #endif
 191:./lwip-2.1.2/src/core/mem.c **** 
 192:./lwip-2.1.2/src/core/mem.c **** #if LWIP_STATS && MEM_STATS
 193:./lwip-2.1.2/src/core/mem.c **** #define MEM_LIBC_STATSHELPER_SIZE LWIP_MEM_ALIGN_SIZE(sizeof(mem_size_t))
 194:./lwip-2.1.2/src/core/mem.c **** #else
 195:./lwip-2.1.2/src/core/mem.c **** #define MEM_LIBC_STATSHELPER_SIZE 0
 196:./lwip-2.1.2/src/core/mem.c **** #endif
 197:./lwip-2.1.2/src/core/mem.c **** 
 198:./lwip-2.1.2/src/core/mem.c **** /**
 199:./lwip-2.1.2/src/core/mem.c ****  * Allocate a block of memory with a minimum of 'size' bytes.
 200:./lwip-2.1.2/src/core/mem.c ****  *
 201:./lwip-2.1.2/src/core/mem.c ****  * @param size is the minimum size of the requested block in bytes.
 202:./lwip-2.1.2/src/core/mem.c ****  * @return pointer to allocated memory or NULL if no free memory was found.
 203:./lwip-2.1.2/src/core/mem.c ****  *
 204:./lwip-2.1.2/src/core/mem.c ****  * Note that the returned value must always be aligned (as defined by MEM_ALIGNMENT).
 205:./lwip-2.1.2/src/core/mem.c ****  */
 206:./lwip-2.1.2/src/core/mem.c **** void *
 207:./lwip-2.1.2/src/core/mem.c **** mem_malloc(mem_size_t size)
 208:./lwip-2.1.2/src/core/mem.c **** {
 209:./lwip-2.1.2/src/core/mem.c ****   void *ret = mem_clib_malloc(size + MEM_LIBC_STATSHELPER_SIZE);
 210:./lwip-2.1.2/src/core/mem.c ****   if (ret == NULL) {
 211:./lwip-2.1.2/src/core/mem.c ****     MEM_STATS_INC_LOCKED(err);
 212:./lwip-2.1.2/src/core/mem.c ****   } else {
 213:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("malloc() must return aligned memory", LWIP_MEM_ALIGN(ret) == ret);
 214:./lwip-2.1.2/src/core/mem.c **** #if LWIP_STATS && MEM_STATS
 215:./lwip-2.1.2/src/core/mem.c ****     *(mem_size_t *)ret = size;
 216:./lwip-2.1.2/src/core/mem.c ****     ret = (u8_t *)ret + MEM_LIBC_STATSHELPER_SIZE;
 217:./lwip-2.1.2/src/core/mem.c ****     MEM_STATS_INC_USED_LOCKED(used, size);
 218:./lwip-2.1.2/src/core/mem.c **** #endif
 219:./lwip-2.1.2/src/core/mem.c ****   }
 220:./lwip-2.1.2/src/core/mem.c ****   return ret;
 221:./lwip-2.1.2/src/core/mem.c **** }
 222:./lwip-2.1.2/src/core/mem.c **** 
 223:./lwip-2.1.2/src/core/mem.c **** /** Put memory back on the heap
 224:./lwip-2.1.2/src/core/mem.c ****  *
 225:./lwip-2.1.2/src/core/mem.c ****  * @param rmem is the pointer as returned by a previous call to mem_malloc()
 226:./lwip-2.1.2/src/core/mem.c ****  */
 227:./lwip-2.1.2/src/core/mem.c **** void
 228:./lwip-2.1.2/src/core/mem.c **** mem_free(void *rmem)
 229:./lwip-2.1.2/src/core/mem.c **** {
 230:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("rmem != NULL", (rmem != NULL));
 231:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("rmem == MEM_ALIGN(rmem)", (rmem == LWIP_MEM_ALIGN(rmem)));
 232:./lwip-2.1.2/src/core/mem.c **** #if LWIP_STATS && MEM_STATS
 233:./lwip-2.1.2/src/core/mem.c ****   rmem = (u8_t *)rmem - MEM_LIBC_STATSHELPER_SIZE;
 234:./lwip-2.1.2/src/core/mem.c ****   MEM_STATS_DEC_USED_LOCKED(used, *(mem_size_t *)rmem);
 235:./lwip-2.1.2/src/core/mem.c **** #endif
 236:./lwip-2.1.2/src/core/mem.c ****   mem_clib_free(rmem);
 237:./lwip-2.1.2/src/core/mem.c **** }
 238:./lwip-2.1.2/src/core/mem.c **** 
 239:./lwip-2.1.2/src/core/mem.c **** #elif MEM_USE_POOLS
 240:./lwip-2.1.2/src/core/mem.c **** 
 241:./lwip-2.1.2/src/core/mem.c **** /* lwIP heap implemented with different sized pools */
 242:./lwip-2.1.2/src/core/mem.c **** 
 243:./lwip-2.1.2/src/core/mem.c **** /**
 244:./lwip-2.1.2/src/core/mem.c ****  * Allocate memory: determine the smallest pool that is big enough
 245:./lwip-2.1.2/src/core/mem.c ****  * to contain an element of 'size' and get an element from that pool.
 246:./lwip-2.1.2/src/core/mem.c ****  *
 247:./lwip-2.1.2/src/core/mem.c ****  * @param size the size in bytes of the memory needed
 248:./lwip-2.1.2/src/core/mem.c ****  * @return a pointer to the allocated memory or NULL if the pool is empty
 249:./lwip-2.1.2/src/core/mem.c ****  */
 250:./lwip-2.1.2/src/core/mem.c **** void *
 251:./lwip-2.1.2/src/core/mem.c **** mem_malloc(mem_size_t size)
 252:./lwip-2.1.2/src/core/mem.c **** {
 253:./lwip-2.1.2/src/core/mem.c ****   void *ret;
 254:./lwip-2.1.2/src/core/mem.c ****   struct memp_malloc_helper *element = NULL;
 255:./lwip-2.1.2/src/core/mem.c ****   memp_t poolnr;
 256:./lwip-2.1.2/src/core/mem.c ****   mem_size_t required_size = size + LWIP_MEM_ALIGN_SIZE(sizeof(struct memp_malloc_helper));
 257:./lwip-2.1.2/src/core/mem.c **** 
 258:./lwip-2.1.2/src/core/mem.c ****   for (poolnr = MEMP_POOL_FIRST; poolnr <= MEMP_POOL_LAST; poolnr = (memp_t)(poolnr + 1)) {
 259:./lwip-2.1.2/src/core/mem.c ****     /* is this pool big enough to hold an element of the required size
 260:./lwip-2.1.2/src/core/mem.c ****        plus a struct memp_malloc_helper that saves the pool this element came from? */
 261:./lwip-2.1.2/src/core/mem.c ****     if (required_size <= memp_pools[poolnr]->size) {
 262:./lwip-2.1.2/src/core/mem.c ****       element = (struct memp_malloc_helper *)memp_malloc(poolnr);
 263:./lwip-2.1.2/src/core/mem.c ****       if (element == NULL) {
 264:./lwip-2.1.2/src/core/mem.c ****         /* No need to DEBUGF or ASSERT: This error is already taken care of in memp.c */
 265:./lwip-2.1.2/src/core/mem.c **** #if MEM_USE_POOLS_TRY_BIGGER_POOL
 266:./lwip-2.1.2/src/core/mem.c ****         /** Try a bigger pool if this one is empty! */
 267:./lwip-2.1.2/src/core/mem.c ****         if (poolnr < MEMP_POOL_LAST) {
 268:./lwip-2.1.2/src/core/mem.c ****           continue;
 269:./lwip-2.1.2/src/core/mem.c ****         }
 270:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_USE_POOLS_TRY_BIGGER_POOL */
 271:./lwip-2.1.2/src/core/mem.c ****         MEM_STATS_INC_LOCKED(err);
 272:./lwip-2.1.2/src/core/mem.c ****         return NULL;
 273:./lwip-2.1.2/src/core/mem.c ****       }
 274:./lwip-2.1.2/src/core/mem.c ****       break;
 275:./lwip-2.1.2/src/core/mem.c ****     }
 276:./lwip-2.1.2/src/core/mem.c ****   }
 277:./lwip-2.1.2/src/core/mem.c ****   if (poolnr > MEMP_POOL_LAST) {
 278:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("mem_malloc(): no pool is that big!", 0);
 279:./lwip-2.1.2/src/core/mem.c ****     MEM_STATS_INC_LOCKED(err);
 280:./lwip-2.1.2/src/core/mem.c ****     return NULL;
 281:./lwip-2.1.2/src/core/mem.c ****   }
 282:./lwip-2.1.2/src/core/mem.c **** 
 283:./lwip-2.1.2/src/core/mem.c ****   /* save the pool number this element came from */
 284:./lwip-2.1.2/src/core/mem.c ****   element->poolnr = poolnr;
 285:./lwip-2.1.2/src/core/mem.c ****   /* and return a pointer to the memory directly after the struct memp_malloc_helper */
 286:./lwip-2.1.2/src/core/mem.c ****   ret = (u8_t *)element + LWIP_MEM_ALIGN_SIZE(sizeof(struct memp_malloc_helper));
 287:./lwip-2.1.2/src/core/mem.c **** 
 288:./lwip-2.1.2/src/core/mem.c **** #if MEMP_OVERFLOW_CHECK || (LWIP_STATS && MEM_STATS)
 289:./lwip-2.1.2/src/core/mem.c ****   /* truncating to u16_t is safe because struct memp_desc::size is u16_t */
 290:./lwip-2.1.2/src/core/mem.c ****   element->size = (u16_t)size;
 291:./lwip-2.1.2/src/core/mem.c ****   MEM_STATS_INC_USED_LOCKED(used, element->size);
 292:./lwip-2.1.2/src/core/mem.c **** #endif /* MEMP_OVERFLOW_CHECK || (LWIP_STATS && MEM_STATS) */
 293:./lwip-2.1.2/src/core/mem.c **** #if MEMP_OVERFLOW_CHECK
 294:./lwip-2.1.2/src/core/mem.c ****   /* initialize unused memory (diff between requested size and selected pool's size) */
 295:./lwip-2.1.2/src/core/mem.c ****   memset((u8_t *)ret + size, 0xcd, memp_pools[poolnr]->size - size);
 296:./lwip-2.1.2/src/core/mem.c **** #endif /* MEMP_OVERFLOW_CHECK */
 297:./lwip-2.1.2/src/core/mem.c ****   return ret;
 298:./lwip-2.1.2/src/core/mem.c **** }
 299:./lwip-2.1.2/src/core/mem.c **** 
 300:./lwip-2.1.2/src/core/mem.c **** /**
 301:./lwip-2.1.2/src/core/mem.c ****  * Free memory previously allocated by mem_malloc. Loads the pool number
 302:./lwip-2.1.2/src/core/mem.c ****  * and calls memp_free with that pool number to put the element back into
 303:./lwip-2.1.2/src/core/mem.c ****  * its pool
 304:./lwip-2.1.2/src/core/mem.c ****  *
 305:./lwip-2.1.2/src/core/mem.c ****  * @param rmem the memory element to free
 306:./lwip-2.1.2/src/core/mem.c ****  */
 307:./lwip-2.1.2/src/core/mem.c **** void
 308:./lwip-2.1.2/src/core/mem.c **** mem_free(void *rmem)
 309:./lwip-2.1.2/src/core/mem.c **** {
 310:./lwip-2.1.2/src/core/mem.c ****   struct memp_malloc_helper *hmem;
 311:./lwip-2.1.2/src/core/mem.c **** 
 312:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("rmem != NULL", (rmem != NULL));
 313:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("rmem == MEM_ALIGN(rmem)", (rmem == LWIP_MEM_ALIGN(rmem)));
 314:./lwip-2.1.2/src/core/mem.c **** 
 315:./lwip-2.1.2/src/core/mem.c ****   /* get the original struct memp_malloc_helper */
 316:./lwip-2.1.2/src/core/mem.c ****   /* cast through void* to get rid of alignment warnings */
 317:./lwip-2.1.2/src/core/mem.c ****   hmem = (struct memp_malloc_helper *)(void *)((u8_t *)rmem - LWIP_MEM_ALIGN_SIZE(sizeof(struct mem
 318:./lwip-2.1.2/src/core/mem.c **** 
 319:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("hmem != NULL", (hmem != NULL));
 320:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("hmem == MEM_ALIGN(hmem)", (hmem == LWIP_MEM_ALIGN(hmem)));
 321:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("hmem->poolnr < MEMP_MAX", (hmem->poolnr < MEMP_MAX));
 322:./lwip-2.1.2/src/core/mem.c **** 
 323:./lwip-2.1.2/src/core/mem.c ****   MEM_STATS_DEC_USED_LOCKED(used, hmem->size);
 324:./lwip-2.1.2/src/core/mem.c **** #if MEMP_OVERFLOW_CHECK
 325:./lwip-2.1.2/src/core/mem.c ****   {
 326:./lwip-2.1.2/src/core/mem.c ****     u16_t i;
 327:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("MEM_USE_POOLS: invalid chunk size",
 328:./lwip-2.1.2/src/core/mem.c ****                 hmem->size <= memp_pools[hmem->poolnr]->size);
 329:./lwip-2.1.2/src/core/mem.c ****     /* check that unused memory remained untouched (diff between requested size and selected pool's
 330:./lwip-2.1.2/src/core/mem.c ****     for (i = hmem->size; i < memp_pools[hmem->poolnr]->size; i++) {
 331:./lwip-2.1.2/src/core/mem.c ****       u8_t data = *((u8_t *)rmem + i);
 332:./lwip-2.1.2/src/core/mem.c ****       LWIP_ASSERT("MEM_USE_POOLS: mem overflow detected", data == 0xcd);
 333:./lwip-2.1.2/src/core/mem.c ****     }
 334:./lwip-2.1.2/src/core/mem.c ****   }
 335:./lwip-2.1.2/src/core/mem.c **** #endif /* MEMP_OVERFLOW_CHECK */
 336:./lwip-2.1.2/src/core/mem.c **** 
 337:./lwip-2.1.2/src/core/mem.c ****   /* and put it in the pool we saved earlier */
 338:./lwip-2.1.2/src/core/mem.c ****   memp_free(hmem->poolnr, hmem);
 339:./lwip-2.1.2/src/core/mem.c **** }
 340:./lwip-2.1.2/src/core/mem.c **** 
 341:./lwip-2.1.2/src/core/mem.c **** #else /* MEM_USE_POOLS */
 342:./lwip-2.1.2/src/core/mem.c **** /* lwIP replacement for your libc malloc() */
 343:./lwip-2.1.2/src/core/mem.c **** 
 344:./lwip-2.1.2/src/core/mem.c **** /**
 345:./lwip-2.1.2/src/core/mem.c ****  * The heap is made up as a list of structs of this type.
 346:./lwip-2.1.2/src/core/mem.c ****  * This does not have to be aligned since for getting its size,
 347:./lwip-2.1.2/src/core/mem.c ****  * we only use the macro SIZEOF_STRUCT_MEM, which automatically aligns.
 348:./lwip-2.1.2/src/core/mem.c ****  */
 349:./lwip-2.1.2/src/core/mem.c **** struct mem {
 350:./lwip-2.1.2/src/core/mem.c ****   /** index (-> ram[next]) of the next struct */
 351:./lwip-2.1.2/src/core/mem.c ****   mem_size_t next;
 352:./lwip-2.1.2/src/core/mem.c ****   /** index (-> ram[prev]) of the previous struct */
 353:./lwip-2.1.2/src/core/mem.c ****   mem_size_t prev;
 354:./lwip-2.1.2/src/core/mem.c ****   /** 1: this area is used; 0: this area is unused */
 355:./lwip-2.1.2/src/core/mem.c ****   u8_t used;
 356:./lwip-2.1.2/src/core/mem.c **** #if MEM_OVERFLOW_CHECK
 357:./lwip-2.1.2/src/core/mem.c ****   /** this keeps track of the user allocation size for guard checks */
 358:./lwip-2.1.2/src/core/mem.c ****   mem_size_t user_size;
 359:./lwip-2.1.2/src/core/mem.c **** #endif
 360:./lwip-2.1.2/src/core/mem.c **** };
 361:./lwip-2.1.2/src/core/mem.c **** 
 362:./lwip-2.1.2/src/core/mem.c **** /** All allocated blocks will be MIN_SIZE bytes big, at least!
 363:./lwip-2.1.2/src/core/mem.c ****  * MIN_SIZE can be overridden to suit your needs. Smaller values save space,
 364:./lwip-2.1.2/src/core/mem.c ****  * larger values could prevent too small blocks to fragment the RAM too much. */
 365:./lwip-2.1.2/src/core/mem.c **** #ifndef MIN_SIZE
 366:./lwip-2.1.2/src/core/mem.c **** #define MIN_SIZE             12
 367:./lwip-2.1.2/src/core/mem.c **** #endif /* MIN_SIZE */
 368:./lwip-2.1.2/src/core/mem.c **** /* some alignment macros: we define them here for better source code layout */
 369:./lwip-2.1.2/src/core/mem.c **** #define MIN_SIZE_ALIGNED     LWIP_MEM_ALIGN_SIZE(MIN_SIZE)
 370:./lwip-2.1.2/src/core/mem.c **** #define SIZEOF_STRUCT_MEM    LWIP_MEM_ALIGN_SIZE(sizeof(struct mem))
 371:./lwip-2.1.2/src/core/mem.c **** #define MEM_SIZE_ALIGNED     LWIP_MEM_ALIGN_SIZE(MEM_SIZE)
 372:./lwip-2.1.2/src/core/mem.c **** 
 373:./lwip-2.1.2/src/core/mem.c **** /** If you want to relocate the heap to external memory, simply define
 374:./lwip-2.1.2/src/core/mem.c ****  * LWIP_RAM_HEAP_POINTER as a void-pointer to that location.
 375:./lwip-2.1.2/src/core/mem.c ****  * If so, make sure the memory at that location is big enough (see below on
 376:./lwip-2.1.2/src/core/mem.c ****  * how that space is calculated). */
 377:./lwip-2.1.2/src/core/mem.c **** #ifndef LWIP_RAM_HEAP_POINTER
 378:./lwip-2.1.2/src/core/mem.c **** /** the heap. we need one struct mem at the end and some room for alignment */
 379:./lwip-2.1.2/src/core/mem.c **** LWIP_DECLARE_MEMORY_ALIGNED(ram_heap, MEM_SIZE_ALIGNED + (2U * SIZEOF_STRUCT_MEM));
 380:./lwip-2.1.2/src/core/mem.c **** #define LWIP_RAM_HEAP_POINTER ram_heap
 381:./lwip-2.1.2/src/core/mem.c **** #endif /* LWIP_RAM_HEAP_POINTER */
 382:./lwip-2.1.2/src/core/mem.c **** 
 383:./lwip-2.1.2/src/core/mem.c **** /** pointer to the heap (ram_heap): for alignment, ram is now a pointer instead of an array */
 384:./lwip-2.1.2/src/core/mem.c **** static u8_t *ram;
 385:./lwip-2.1.2/src/core/mem.c **** /** the last entry, always unused! */
 386:./lwip-2.1.2/src/core/mem.c **** static struct mem *ram_end;
 387:./lwip-2.1.2/src/core/mem.c **** 
 388:./lwip-2.1.2/src/core/mem.c **** /** concurrent access protection */
 389:./lwip-2.1.2/src/core/mem.c **** #if !NO_SYS
 390:./lwip-2.1.2/src/core/mem.c **** static sys_mutex_t mem_mutex;
 391:./lwip-2.1.2/src/core/mem.c **** #endif
 392:./lwip-2.1.2/src/core/mem.c **** 
 393:./lwip-2.1.2/src/core/mem.c **** #if LWIP_ALLOW_MEM_FREE_FROM_OTHER_CONTEXT
 394:./lwip-2.1.2/src/core/mem.c **** 
 395:./lwip-2.1.2/src/core/mem.c **** static volatile u8_t mem_free_count;
 396:./lwip-2.1.2/src/core/mem.c **** 
 397:./lwip-2.1.2/src/core/mem.c **** /* Allow mem_free from other (e.g. interrupt) context */
 398:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_FREE_DECL_PROTECT()  SYS_ARCH_DECL_PROTECT(lev_free)
 399:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_FREE_PROTECT()       SYS_ARCH_PROTECT(lev_free)
 400:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_FREE_UNPROTECT()     SYS_ARCH_UNPROTECT(lev_free)
 401:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ALLOC_DECL_PROTECT() SYS_ARCH_DECL_PROTECT(lev_alloc)
 402:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ALLOC_PROTECT()      SYS_ARCH_PROTECT(lev_alloc)
 403:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ALLOC_UNPROTECT()    SYS_ARCH_UNPROTECT(lev_alloc)
 404:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_LFREE_VOLATILE       volatile
 405:./lwip-2.1.2/src/core/mem.c **** 
 406:./lwip-2.1.2/src/core/mem.c **** #else /* LWIP_ALLOW_MEM_FREE_FROM_OTHER_CONTEXT */
 407:./lwip-2.1.2/src/core/mem.c **** 
 408:./lwip-2.1.2/src/core/mem.c **** /* Protect the heap only by using a mutex */
 409:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_FREE_DECL_PROTECT()
 410:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_FREE_PROTECT()    sys_mutex_lock(&mem_mutex)
 411:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_FREE_UNPROTECT()  sys_mutex_unlock(&mem_mutex)
 412:./lwip-2.1.2/src/core/mem.c **** /* mem_malloc is protected using mutex AND LWIP_MEM_ALLOC_PROTECT */
 413:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ALLOC_DECL_PROTECT()
 414:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ALLOC_PROTECT()
 415:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_ALLOC_UNPROTECT()
 416:./lwip-2.1.2/src/core/mem.c **** #define LWIP_MEM_LFREE_VOLATILE
 417:./lwip-2.1.2/src/core/mem.c **** 
 418:./lwip-2.1.2/src/core/mem.c **** #endif /* LWIP_ALLOW_MEM_FREE_FROM_OTHER_CONTEXT */
 419:./lwip-2.1.2/src/core/mem.c **** 
 420:./lwip-2.1.2/src/core/mem.c **** /** pointer to the lowest free block, this is used for faster search */
 421:./lwip-2.1.2/src/core/mem.c **** static struct mem * LWIP_MEM_LFREE_VOLATILE lfree;
 422:./lwip-2.1.2/src/core/mem.c **** 
 423:./lwip-2.1.2/src/core/mem.c **** #if MEM_SANITY_CHECK
 424:./lwip-2.1.2/src/core/mem.c **** static void mem_sanity(void);
 425:./lwip-2.1.2/src/core/mem.c **** #define MEM_SANITY() mem_sanity()
 426:./lwip-2.1.2/src/core/mem.c **** #else
 427:./lwip-2.1.2/src/core/mem.c **** #define MEM_SANITY()
 428:./lwip-2.1.2/src/core/mem.c **** #endif
 429:./lwip-2.1.2/src/core/mem.c **** 
 430:./lwip-2.1.2/src/core/mem.c **** #if MEM_OVERFLOW_CHECK
 431:./lwip-2.1.2/src/core/mem.c **** static void
 432:./lwip-2.1.2/src/core/mem.c **** mem_overflow_init_element(struct mem *mem, mem_size_t user_size)
 433:./lwip-2.1.2/src/core/mem.c **** {
 434:./lwip-2.1.2/src/core/mem.c ****   void *p = (u8_t *)mem + SIZEOF_STRUCT_MEM + MEM_SANITY_OFFSET;
 435:./lwip-2.1.2/src/core/mem.c ****   mem->user_size = user_size;
 436:./lwip-2.1.2/src/core/mem.c ****   mem_overflow_init_raw(p, user_size);
 437:./lwip-2.1.2/src/core/mem.c **** }
 438:./lwip-2.1.2/src/core/mem.c **** 
 439:./lwip-2.1.2/src/core/mem.c **** static void
 440:./lwip-2.1.2/src/core/mem.c **** mem_overflow_check_element(struct mem *mem)
 441:./lwip-2.1.2/src/core/mem.c **** {
 442:./lwip-2.1.2/src/core/mem.c ****   void *p = (u8_t *)mem + SIZEOF_STRUCT_MEM + MEM_SANITY_OFFSET;
 443:./lwip-2.1.2/src/core/mem.c ****   mem_overflow_check_raw(p, mem->user_size, "heap", "");
 444:./lwip-2.1.2/src/core/mem.c **** }
 445:./lwip-2.1.2/src/core/mem.c **** #else /* MEM_OVERFLOW_CHECK */
 446:./lwip-2.1.2/src/core/mem.c **** #define mem_overflow_init_element(mem, size)
 447:./lwip-2.1.2/src/core/mem.c **** #define mem_overflow_check_element(mem)
 448:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_OVERFLOW_CHECK */
 449:./lwip-2.1.2/src/core/mem.c **** 
 450:./lwip-2.1.2/src/core/mem.c **** static struct mem *
 451:./lwip-2.1.2/src/core/mem.c **** ptr_to_mem(mem_size_t ptr)
 452:./lwip-2.1.2/src/core/mem.c **** {
 453:./lwip-2.1.2/src/core/mem.c ****   return (struct mem *)(void *)&ram[ptr];
 454:./lwip-2.1.2/src/core/mem.c **** }
 455:./lwip-2.1.2/src/core/mem.c **** 
 456:./lwip-2.1.2/src/core/mem.c **** static mem_size_t
 457:./lwip-2.1.2/src/core/mem.c **** mem_to_ptr(void *mem)
 458:./lwip-2.1.2/src/core/mem.c **** {
 459:./lwip-2.1.2/src/core/mem.c ****   return (mem_size_t)((u8_t *)mem - ram);
 460:./lwip-2.1.2/src/core/mem.c **** }
 461:./lwip-2.1.2/src/core/mem.c **** 
 462:./lwip-2.1.2/src/core/mem.c **** /**
 463:./lwip-2.1.2/src/core/mem.c ****  * "Plug holes" by combining adjacent empty struct mems.
 464:./lwip-2.1.2/src/core/mem.c ****  * After this function is through, there should not exist
 465:./lwip-2.1.2/src/core/mem.c ****  * one empty struct mem pointing to another empty struct mem.
 466:./lwip-2.1.2/src/core/mem.c ****  *
 467:./lwip-2.1.2/src/core/mem.c ****  * @param mem this points to a struct mem which just has been freed

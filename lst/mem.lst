 569:./lwip-2.1.2/src/core/mem.c **** {
 570:./lwip-2.1.2/src/core/mem.c ****   struct mem *mem;
 571:./lwip-2.1.2/src/core/mem.c ****   u8_t last_used;
 572:./lwip-2.1.2/src/core/mem.c **** 
 573:./lwip-2.1.2/src/core/mem.c ****   /* begin with first element here */
 574:./lwip-2.1.2/src/core/mem.c ****   mem = (struct mem *)ram;
 575:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("heap element used valid", (mem->used == 0) || (mem->used == 1));

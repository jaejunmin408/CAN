 580:./lwip-2.1.2/src/core/mem.c **** 
 581:./lwip-2.1.2/src/core/mem.c ****   /* check all elements before the end of the heap */
 582:./lwip-2.1.2/src/core/mem.c ****   for (mem = ptr_to_mem(mem->next);
 583:./lwip-2.1.2/src/core/mem.c ****        ((u8_t *)mem > ram) && (mem < ram_end);
 584:./lwip-2.1.2/src/core/mem.c ****        mem = ptr_to_mem(mem->next)) {
 585:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("heap element aligned", LWIP_MEM_ALIGN(mem) == mem);
 586:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("heap element prev ptr valid", mem->prev <= MEM_SIZE_ALIGNED);
 587:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("heap element next ptr valid", mem->next <= MEM_SIZE_ALIGNED);
 588:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("heap element prev ptr aligned", LWIP_MEM_ALIGN(ptr_to_mem(mem->prev) == ptr_to_mem
 589:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("heap element next ptr aligned", LWIP_MEM_ALIGN(ptr_to_mem(mem->next) == ptr_to_mem
 590:./lwip-2.1.2/src/core/mem.c **** 
 591:./lwip-2.1.2/src/core/mem.c ****     if (last_used == 0) {
 592:./lwip-2.1.2/src/core/mem.c ****       /* 2 unused elements in a row? */
 593:./lwip-2.1.2/src/core/mem.c ****       LWIP_ASSERT("heap element unused?", mem->used == 1);
 594:./lwip-2.1.2/src/core/mem.c ****     } else {
 595:./lwip-2.1.2/src/core/mem.c ****       LWIP_ASSERT("heap element unused member", (mem->used == 0) || (mem->used == 1));
 596:./lwip-2.1.2/src/core/mem.c ****     }
 597:./lwip-2.1.2/src/core/mem.c **** 
 598:./lwip-2.1.2/src/core/mem.c ****     LWIP_ASSERT("heap element link valid", mem_link_valid(mem));
 599:./lwip-2.1.2/src/core/mem.c **** 
 600:./lwip-2.1.2/src/core/mem.c ****     /* used/unused altering */
 601:./lwip-2.1.2/src/core/mem.c ****     last_used = mem->used;
 602:./lwip-2.1.2/src/core/mem.c ****   }
 603:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("heap end ptr sanity", mem == ptr_to_mem(MEM_SIZE_ALIGNED));
 604:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("heap element used valid", mem->used == 1);
 605:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("heap element prev ptr valid", mem->prev == MEM_SIZE_ALIGNED);
 606:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("heap element next ptr valid", mem->next == MEM_SIZE_ALIGNED);
 607:./lwip-2.1.2/src/core/mem.c **** }
 608:./lwip-2.1.2/src/core/mem.c **** #endif /* MEM_SANITY_CHECK */

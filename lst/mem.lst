 550:./lwip-2.1.2/src/core/mem.c **** static int
 551:./lwip-2.1.2/src/core/mem.c **** mem_link_valid(struct mem *mem)
 552:./lwip-2.1.2/src/core/mem.c **** {
 553:./lwip-2.1.2/src/core/mem.c ****   struct mem *nmem, *pmem;
 554:./lwip-2.1.2/src/core/mem.c ****   mem_size_t rmem_idx;
 555:./lwip-2.1.2/src/core/mem.c ****   rmem_idx = mem_to_ptr(mem);
 556:./lwip-2.1.2/src/core/mem.c ****   nmem = ptr_to_mem(mem->next);
 557:./lwip-2.1.2/src/core/mem.c ****   pmem = ptr_to_mem(mem->prev);
 558:./lwip-2.1.2/src/core/mem.c ****   if ((mem->next > MEM_SIZE_ALIGNED) || (mem->prev > MEM_SIZE_ALIGNED) ||
 559:./lwip-2.1.2/src/core/mem.c ****       ((mem->prev != rmem_idx) && (pmem->next != rmem_idx)) ||
 560:./lwip-2.1.2/src/core/mem.c ****       ((nmem != ram_end) && (nmem->prev != rmem_idx))) {
 561:./lwip-2.1.2/src/core/mem.c ****     return 0;
 562:./lwip-2.1.2/src/core/mem.c ****   }
 563:./lwip-2.1.2/src/core/mem.c ****   return 1;
 564:./lwip-2.1.2/src/core/mem.c **** }

   1:./lwip-2.1.2/src/core/mem.c **** /**
   2:./lwip-2.1.2/src/core/mem.c ****  * @file
   3:./lwip-2.1.2/src/core/mem.c ****  * Dynamic memory manager
   4:./lwip-2.1.2/src/core/mem.c ****  *
   5:./lwip-2.1.2/src/core/mem.c ****  * This is a lightweight replacement for the standard C library malloc().
   6:./lwip-2.1.2/src/core/mem.c ****  *
   7:./lwip-2.1.2/src/core/mem.c ****  * If you want to use the standard C library malloc() instead, define
   8:./lwip-2.1.2/src/core/mem.c ****  * MEM_LIBC_MALLOC to 1 in your lwipopts.h
   9:./lwip-2.1.2/src/core/mem.c ****  *
  10:./lwip-2.1.2/src/core/mem.c ****  * To let mem_malloc() use pools (prevents fragmentation and is much faster than
  11:./lwip-2.1.2/src/core/mem.c ****  * a heap but might waste some memory), define MEM_USE_POOLS to 1, define
  12:./lwip-2.1.2/src/core/mem.c ****  * MEMP_USE_CUSTOM_POOLS to 1 and create a file "lwippools.h" that includes a list
  13:./lwip-2.1.2/src/core/mem.c ****  * of pools like this (more pools can be added between _START and _END):
  14:./lwip-2.1.2/src/core/mem.c ****  *
  15:./lwip-2.1.2/src/core/mem.c ****  * Define three pools with sizes 256, 512, and 1512 bytes
  16:./lwip-2.1.2/src/core/mem.c ****  * LWIP_MALLOC_MEMPOOL_START
  17:./lwip-2.1.2/src/core/mem.c ****  * LWIP_MALLOC_MEMPOOL(20, 256)
  18:./lwip-2.1.2/src/core/mem.c ****  * LWIP_MALLOC_MEMPOOL(10, 512)
  19:./lwip-2.1.2/src/core/mem.c ****  * LWIP_MALLOC_MEMPOOL(5, 1512)
  20:./lwip-2.1.2/src/core/mem.c ****  * LWIP_MALLOC_MEMPOOL_END
  21:./lwip-2.1.2/src/core/mem.c ****  */
  22:./lwip-2.1.2/src/core/mem.c **** 

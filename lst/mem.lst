 471:./lwip-2.1.2/src/core/mem.c ****  * already.
 472:./lwip-2.1.2/src/core/mem.c ****  */
 473:./lwip-2.1.2/src/core/mem.c **** static void
 474:./lwip-2.1.2/src/core/mem.c **** plug_holes(struct mem *mem)
 475:./lwip-2.1.2/src/core/mem.c **** {
 476:./lwip-2.1.2/src/core/mem.c ****   struct mem *nmem;

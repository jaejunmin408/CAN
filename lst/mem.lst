 481:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("plug_holes: mem->used == 0", mem->used == 0);
 482:./lwip-2.1.2/src/core/mem.c **** 
 483:./lwip-2.1.2/src/core/mem.c ****   /* plug hole forward */
 484:./lwip-2.1.2/src/core/mem.c ****   LWIP_ASSERT("plug_holes: mem->next <= MEM_SIZE_ALIGNED", mem->next <= MEM_SIZE_ALIGNED);
 485:./lwip-2.1.2/src/core/mem.c **** 
 486:./lwip-2.1.2/src/core/mem.c ****   nmem = ptr_to_mem(mem->next);
 487:./lwip-2.1.2/src/core/mem.c ****   if (mem != nmem && nmem->used == 0 && (u8_t *)nmem != (u8_t *)ram_end) {
 488:./lwip-2.1.2/src/core/mem.c ****     /* if mem->next is unused and not end of ram, combine mem and mem->next */
 489:./lwip-2.1.2/src/core/mem.c ****     if (lfree == nmem) {
 490:./lwip-2.1.2/src/core/mem.c ****       lfree = mem;
 491:./lwip-2.1.2/src/core/mem.c ****     }
 492:./lwip-2.1.2/src/core/mem.c ****     mem->next = nmem->next;
 493:./lwip-2.1.2/src/core/mem.c ****     if (nmem->next != MEM_SIZE_ALIGNED) {
 494:./lwip-2.1.2/src/core/mem.c ****       ptr_to_mem(nmem->next)->prev = mem_to_ptr(mem);
 495:./lwip-2.1.2/src/core/mem.c ****     }
 496:./lwip-2.1.2/src/core/mem.c ****   }
 497:./lwip-2.1.2/src/core/mem.c **** 
 498:./lwip-2.1.2/src/core/mem.c ****   /* plug hole backward */
 499:./lwip-2.1.2/src/core/mem.c ****   pmem = ptr_to_mem(mem->prev);
 500:./lwip-2.1.2/src/core/mem.c ****   if (pmem != mem && pmem->used == 0) {
 501:./lwip-2.1.2/src/core/mem.c ****     /* if mem->prev is unused, combine mem and mem->prev */
 502:./lwip-2.1.2/src/core/mem.c ****     if (lfree == mem) {
 503:./lwip-2.1.2/src/core/mem.c ****       lfree = pmem;
 504:./lwip-2.1.2/src/core/mem.c ****     }
 505:./lwip-2.1.2/src/core/mem.c ****     pmem->next = mem->next;
 506:./lwip-2.1.2/src/core/mem.c ****     if (mem->next != MEM_SIZE_ALIGNED) {
 507:./lwip-2.1.2/src/core/mem.c ****       ptr_to_mem(mem->next)->prev = mem_to_ptr(pmem);
 508:./lwip-2.1.2/src/core/mem.c ****     }
 509:./lwip-2.1.2/src/core/mem.c ****   }
 510:./lwip-2.1.2/src/core/mem.c **** }

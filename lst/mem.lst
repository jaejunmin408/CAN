 908:./inc/cmsis_gcc.h ****  */
 909:./inc/cmsis_gcc.h **** #define __WFI()                             __ASM volatile ("wfi")
 910:./inc/cmsis_gcc.h **** 
 911:./inc/cmsis_gcc.h **** 
 912:./inc/cmsis_gcc.h **** /**
 913:./inc/cmsis_gcc.h ****   \brief   Wait For Event
 914:./inc/cmsis_gcc.h ****   \details Wait For Event is a hint instruction that permits the processor to enter
 915:./inc/cmsis_gcc.h ****            a low-power state until one of a number of events occurs.
 916:./inc/cmsis_gcc.h ****  */
 917:./inc/cmsis_gcc.h **** #define __WFE()                             __ASM volatile ("wfe")
 918:./inc/cmsis_gcc.h **** 
 919:./inc/cmsis_gcc.h **** 
 920:./inc/cmsis_gcc.h **** /**
 921:./inc/cmsis_gcc.h ****   \brief   Send Event
 922:./inc/cmsis_gcc.h ****   \details Send Event is a hint instruction. It causes an event to be signaled to the CPU.
 923:./inc/cmsis_gcc.h ****  */
 924:./inc/cmsis_gcc.h **** #define __SEV()                             __ASM volatile ("sev")
 925:./inc/cmsis_gcc.h **** 
 926:./inc/cmsis_gcc.h **** 
 927:./inc/cmsis_gcc.h **** /**
 928:./inc/cmsis_gcc.h ****   \brief   Instruction Synchronization Barrier
 929:./inc/cmsis_gcc.h ****   \details Instruction Synchronization Barrier flushes the pipeline in the processor,
 930:./inc/cmsis_gcc.h ****            so that all instructions following the ISB are fetched from cache or memory,
 931:./inc/cmsis_gcc.h ****            after the instruction has been completed.

 254:./inc/core_cm7.h ****   - Core SysTick Register
 255:./inc/core_cm7.h ****   - Core Debug Register
 256:./inc/core_cm7.h ****   - Core MPU Register
 257:./inc/core_cm7.h ****   - Core FPU Register
 258:./inc/core_cm7.h ****  ******************************************************************************/
 259:./inc/core_cm7.h **** /**
 260:./inc/core_cm7.h ****   \defgroup CMSIS_core_register Defines and Type Definitions
 261:./inc/core_cm7.h ****   \brief Type definitions and defines for Cortex-M processor based devices.
 262:./inc/core_cm7.h **** */
 263:./inc/core_cm7.h **** 
 264:./inc/core_cm7.h **** /**
 265:./inc/core_cm7.h ****   \ingroup    CMSIS_core_register
 266:./inc/core_cm7.h ****   \defgroup   CMSIS_CORE  Status and Control Registers
 267:./inc/core_cm7.h ****   \brief      Core Register type definitions.
 268:./inc/core_cm7.h ****   @{
 269:./inc/core_cm7.h ****  */
 270:./inc/core_cm7.h **** 
 271:./inc/core_cm7.h **** /**
 272:./inc/core_cm7.h ****   \brief  Union type to access the Application Program Status Register (APSR).
 273:./inc/core_cm7.h ****  */
 274:./inc/core_cm7.h **** typedef union
 275:./inc/core_cm7.h **** {
 276:./inc/core_cm7.h ****   struct
 277:./inc/core_cm7.h ****   {
 278:./inc/core_cm7.h ****     uint32_t _reserved0:16;              /*!< bit:  0..15  Reserved */
 279:./inc/core_cm7.h ****     uint32_t GE:4;                       /*!< bit: 16..19  Greater than or Equal flags */
 280:./inc/core_cm7.h ****     uint32_t _reserved1:7;               /*!< bit: 20..26  Reserved */
 281:./inc/core_cm7.h ****     uint32_t Q:1;                        /*!< bit:     27  Saturation condition flag */
 282:./inc/core_cm7.h ****     uint32_t V:1;                        /*!< bit:     28  Overflow condition code flag */
 283:./inc/core_cm7.h ****     uint32_t C:1;                        /*!< bit:     29  Carry condition code flag */
 284:./inc/core_cm7.h ****     uint32_t Z:1;                        /*!< bit:     30  Zero condition code flag */
 285:./inc/core_cm7.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 286:./inc/core_cm7.h ****   } b;                                   /*!< Structure used for bit  access */
 287:./inc/core_cm7.h ****   uint32_t w;                            /*!< Type      used for word access */
 288:./inc/core_cm7.h **** } APSR_Type;
 289:./inc/core_cm7.h **** 
 290:./inc/core_cm7.h **** /* APSR Register Definitions */
 291:./inc/core_cm7.h **** #define APSR_N_Pos                         31U                                            /*!< APSR
 292:./inc/core_cm7.h **** #define APSR_N_Msk                         (1UL << APSR_N_Pos)                            /*!< APSR
 293:./inc/core_cm7.h **** 
 294:./inc/core_cm7.h **** #define APSR_Z_Pos                         30U                                            /*!< APSR
 295:./inc/core_cm7.h **** #define APSR_Z_Msk                         (1UL << APSR_Z_Pos)                            /*!< APSR
 296:./inc/core_cm7.h **** 
 297:./inc/core_cm7.h **** #define APSR_C_Pos                         29U                                            /*!< APSR
 298:./inc/core_cm7.h **** #define APSR_C_Msk                         (1UL << APSR_C_Pos)                            /*!< APSR
 299:./inc/core_cm7.h **** 
 300:./inc/core_cm7.h **** #define APSR_V_Pos                         28U                                            /*!< APSR
 301:./inc/core_cm7.h **** #define APSR_V_Msk                         (1UL << APSR_V_Pos)                            /*!< APSR
 302:./inc/core_cm7.h **** 
 303:./inc/core_cm7.h **** #define APSR_Q_Pos                         27U                                            /*!< APSR
 304:./inc/core_cm7.h **** #define APSR_Q_Msk                         (1UL << APSR_Q_Pos)                            /*!< APSR
 305:./inc/core_cm7.h **** 
 306:./inc/core_cm7.h **** #define APSR_GE_Pos                        16U                                            /*!< APSR
 307:./inc/core_cm7.h **** #define APSR_GE_Msk                        (0xFUL << APSR_GE_Pos)                         /*!< APSR
 308:./inc/core_cm7.h **** 
 309:./inc/core_cm7.h **** 
 310:./inc/core_cm7.h **** /**
 311:./inc/core_cm7.h ****   \brief  Union type to access the Interrupt Program Status Register (IPSR).
 312:./inc/core_cm7.h ****  */
 313:./inc/core_cm7.h **** typedef union
 314:./inc/core_cm7.h **** {
 315:./inc/core_cm7.h ****   struct
 316:./inc/core_cm7.h ****   {
 317:./inc/core_cm7.h ****     uint32_t ISR:9;                      /*!< bit:  0.. 8  Exception number */
 318:./inc/core_cm7.h ****     uint32_t _reserved0:23;              /*!< bit:  9..31  Reserved */
 319:./inc/core_cm7.h ****   } b;                                   /*!< Structure used for bit  access */
 320:./inc/core_cm7.h ****   uint32_t w;                            /*!< Type      used for word access */
 321:./inc/core_cm7.h **** } IPSR_Type;
 322:./inc/core_cm7.h **** 
 323:./inc/core_cm7.h **** /* IPSR Register Definitions */
 324:./inc/core_cm7.h **** #define IPSR_ISR_Pos                        0U                                            /*!< IPSR
 325:./inc/core_cm7.h **** #define IPSR_ISR_Msk                       (0x1FFUL /*<< IPSR_ISR_Pos*/)                  /*!< IPSR
 326:./inc/core_cm7.h **** 
 327:./inc/core_cm7.h **** 
 328:./inc/core_cm7.h **** /**
 329:./inc/core_cm7.h ****   \brief  Union type to access the Special-Purpose Program Status Registers (xPSR).

2030:./inc/core_cm7.h ****   \note    The priority cannot be set for every processor exception.
2031:./inc/core_cm7.h ****  */
2032:./inc/core_cm7.h **** __STATIC_INLINE void __NVIC_SetPriority(IRQn_Type IRQn, uint32_t priority)
2033:./inc/core_cm7.h **** {
2034:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
2035:./inc/core_cm7.h ****   {
2036:./inc/core_cm7.h ****     NVIC->IP[((uint32_t)IRQn)]                = (uint8_t)((priority << (8U - __NVIC_PRIO_BITS)) & (
2037:./inc/core_cm7.h ****   }
2038:./inc/core_cm7.h ****   else
2039:./inc/core_cm7.h ****   {
2040:./inc/core_cm7.h ****     SCB->SHPR[(((uint32_t)IRQn) & 0xFUL)-4UL] = (uint8_t)((priority << (8U - __NVIC_PRIO_BITS)) & (
2041:./inc/core_cm7.h ****   }
2042:./inc/core_cm7.h **** }

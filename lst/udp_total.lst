2068:./inc/core_cm7.h **** /**
2069:./inc/core_cm7.h ****   \brief   Encode Priority
2070:./inc/core_cm7.h ****   \details Encodes the priority for an interrupt with the given priority group,
2071:./inc/core_cm7.h ****            preemptive priority value, and subpriority value.
2072:./inc/core_cm7.h ****            In case of a conflict between priority grouping and available
2073:./inc/core_cm7.h ****            priority bits (__NVIC_PRIO_BITS), the smallest possible priority group is set.
2074:./inc/core_cm7.h ****   \param [in]     PriorityGroup  Used priority group.
2075:./inc/core_cm7.h ****   \param [in]   PreemptPriority  Preemptive priority value (starting from 0).
2076:./inc/core_cm7.h ****   \param [in]       SubPriority  Subpriority value (starting from 0).
2077:./inc/core_cm7.h ****   \return                        Encoded priority. Value can be used in the function \ref NVIC_SetP
2078:./inc/core_cm7.h ****  */
2079:./inc/core_cm7.h **** __STATIC_INLINE uint32_t NVIC_EncodePriority (uint32_t PriorityGroup, uint32_t PreemptPriority, uin
2080:./inc/core_cm7.h **** {
2081:./inc/core_cm7.h ****   uint32_t PriorityGroupTmp = (PriorityGroup & (uint32_t)0x07UL);   /* only values 0..7 are used   
2082:./inc/core_cm7.h ****   uint32_t PreemptPriorityBits;
2083:./inc/core_cm7.h ****   uint32_t SubPriorityBits;
2084:./inc/core_cm7.h **** 
2085:./inc/core_cm7.h ****   PreemptPriorityBits = ((7UL - PriorityGroupTmp) > (uint32_t)(__NVIC_PRIO_BITS)) ? (uint32_t)(__NV
2086:./inc/core_cm7.h ****   SubPriorityBits     = ((PriorityGroupTmp + (uint32_t)(__NVIC_PRIO_BITS)) < (uint32_t)7UL) ? (uint
2087:./inc/core_cm7.h **** 
2088:./inc/core_cm7.h ****   return (
2089:./inc/core_cm7.h ****            ((PreemptPriority & (uint32_t)((1UL << (PreemptPriorityBits)) - 1UL)) << SubPriorityBits
2090:./inc/core_cm7.h ****            ((SubPriority     & (uint32_t)((1UL << (SubPriorityBits    )) - 1UL)))
2091:./inc/core_cm7.h ****          );

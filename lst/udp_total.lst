1896:./inc/core_cm7.h **** /**
1897:./inc/core_cm7.h ****   \brief   Enable Interrupt
1898:./inc/core_cm7.h ****   \details Enables a device specific interrupt in the NVIC interrupt controller.
1899:./inc/core_cm7.h ****   \param [in]      IRQn  Device specific interrupt number.
1900:./inc/core_cm7.h ****   \note    IRQn must not be negative.
1901:./inc/core_cm7.h ****  */
1902:./inc/core_cm7.h **** __STATIC_INLINE void __NVIC_EnableIRQ(IRQn_Type IRQn)  
1903:./inc/core_cm7.h **** {
1904:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
1905:./inc/core_cm7.h ****   {
1906:./inc/core_cm7.h ****     __COMPILER_BARRIER();
1907:./inc/core_cm7.h ****     NVIC->ISER[(((uint32_t)IRQn) >> 5UL)] = (uint32_t)(1UL << (((uint32_t)IRQn) & 0x1FUL));
1908:./inc/core_cm7.h ****     __COMPILER_BARRIER();
1909:./inc/core_cm7.h ****   }
1910:./inc/core_cm7.h **** }
1911:./inc/core_cm7.h **** 
1912:./inc/core_cm7.h **** 
1913:./inc/core_cm7.h **** /**
1914:./inc/core_cm7.h ****   \brief   Get Interrupt Enable status
1915:./inc/core_cm7.h ****   \details Returns a device specific interrupt enable status from the NVIC interrupt controller.
1916:./inc/core_cm7.h ****   \param [in]      IRQn  Device specific interrupt number.
1917:./inc/core_cm7.h ****   \return             0  Interrupt is not enabled.
1918:./inc/core_cm7.h ****   \return             1  Interrupt is enabled.
1919:./inc/core_cm7.h ****   \note    IRQn must not be negative.
1920:./inc/core_cm7.h ****  */
1921:./inc/core_cm7.h **** __STATIC_INLINE uint32_t __NVIC_GetEnableIRQ(IRQn_Type IRQn)
1922:./inc/core_cm7.h **** {
1923:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
1924:./inc/core_cm7.h ****   {
1925:./inc/core_cm7.h ****     return((uint32_t)(((NVIC->ISER[(((uint32_t)IRQn) >> 5UL)] & (1UL << (((uint32_t)IRQn) & 0x1FUL)
1926:./inc/core_cm7.h ****   }
1927:./inc/core_cm7.h ****   else
1928:./inc/core_cm7.h ****   {
1929:./inc/core_cm7.h ****     return(0U);
1930:./inc/core_cm7.h ****   }
1931:./inc/core_cm7.h **** }
1932:./inc/core_cm7.h **** 

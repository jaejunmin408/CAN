 223:./inc/core_cm7.h **** /* IO definitions (access restrictions to peripheral registers) */
 224:./inc/core_cm7.h **** /**
 225:./inc/core_cm7.h ****     \defgroup CMSIS_glob_defs CMSIS Global Defines
 226:./inc/core_cm7.h **** 
 227:./inc/core_cm7.h ****     <strong>IO Type Qualifiers</strong> are used
 228:./inc/core_cm7.h ****     \li to specify the access to peripheral variables.
 229:./inc/core_cm7.h ****     \li for automatic generation of peripheral register debug information.
 230:./inc/core_cm7.h **** */
 231:./inc/core_cm7.h **** #ifdef __cplusplus
 232:./inc/core_cm7.h ****   #define   __I     volatile             /*!< Defines 'read only' permissions */
 233:./inc/core_cm7.h **** #else
 234:./inc/core_cm7.h ****   #define   __I     volatile const       /*!< Defines 'read only' permissions */
 235:./inc/core_cm7.h **** #endif
 236:./inc/core_cm7.h **** #define     __O     volatile             /*!< Defines 'write only' permissions */
 237:./inc/core_cm7.h **** #define     __IO    volatile             /*!< Defines 'read / write' permissions */
 238:./inc/core_cm7.h **** 
 239:./inc/core_cm7.h **** /* following defines should be used for structure members */
 240:./inc/core_cm7.h **** #define     __IM     volatile const      /*! Defines 'read only' structure member permissions */
 241:./inc/core_cm7.h **** #define     __OM     volatile            /*! Defines 'write only' structure member permissions */
 242:./inc/core_cm7.h **** #define     __IOM    volatile            /*! Defines 'read / write' structure member permissions */

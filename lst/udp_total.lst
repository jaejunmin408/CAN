1941:./inc/core_cm7.h **** {
1942:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
1943:./inc/core_cm7.h ****   {
1944:./inc/core_cm7.h ****     NVIC->ICER[(((uint32_t)IRQn) >> 5UL)] = (uint32_t)(1UL << (((uint32_t)IRQn) & 0x1FUL));
1945:./inc/core_cm7.h ****     __DSB();
1946:./inc/core_cm7.h ****     __ISB();
1947:./inc/core_cm7.h ****   }
1948:./inc/core_cm7.h **** }

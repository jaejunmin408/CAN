2120:./inc/core_cm7.h **** /**
2121:./inc/core_cm7.h ****   \brief   Set Interrupt Vector
2122:./inc/core_cm7.h ****   \details Sets an interrupt vector in SRAM based interrupt vector table.
2123:./inc/core_cm7.h ****            The interrupt number can be positive to specify a device specific interrupt,
2124:./inc/core_cm7.h ****            or negative to specify a processor exception.
2125:./inc/core_cm7.h ****            VTOR must been relocated to SRAM before.
2126:./inc/core_cm7.h ****   \param [in]   IRQn      Interrupt number
2127:./inc/core_cm7.h ****   \param [in]   vector    Address of interrupt handler function
2128:./inc/core_cm7.h ****  */
2129:./inc/core_cm7.h **** __STATIC_INLINE void __NVIC_SetVector(IRQn_Type IRQn, uint32_t vector)
2130:./inc/core_cm7.h **** {
2131:./inc/core_cm7.h ****   uint32_t vectors = (uint32_t )SCB->VTOR;
2132:./inc/core_cm7.h ****   (* (int *) (vectors + ((int32_t)IRQn + NVIC_USER_IRQ_OFFSET) * 4)) = vector;
2133:./inc/core_cm7.h ****   __DSB();
2134:./inc/core_cm7.h **** }
2135:./inc/core_cm7.h **** 
2136:./inc/core_cm7.h **** 
2137:./inc/core_cm7.h **** /**
2138:./inc/core_cm7.h ****   \brief   Get Interrupt Vector

2140:./inc/core_cm7.h ****            The interrupt number can be positive to specify a device specific interrupt,
2141:./inc/core_cm7.h ****            or negative to specify a processor exception.
2142:./inc/core_cm7.h ****   \param [in]   IRQn      Interrupt number.
2143:./inc/core_cm7.h ****   \return                 Address of interrupt handler function
2144:./inc/core_cm7.h ****  */
2145:./inc/core_cm7.h **** __STATIC_INLINE uint32_t __NVIC_GetVector(IRQn_Type IRQn)
2146:./inc/core_cm7.h **** {
2147:./inc/core_cm7.h ****   uint32_t vectors = (uint32_t )SCB->VTOR;
2148:./inc/core_cm7.h ****   return (uint32_t)(* (int *) (vectors + ((int32_t)IRQn + NVIC_USER_IRQ_OFFSET) * 4));
2149:./inc/core_cm7.h **** }

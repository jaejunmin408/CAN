  93:./inc/core_cm7.h ****       #warning "Compiler generates FPU instructions for a device without an FPU (check __FPU_PRESEN
  94:./inc/core_cm7.h ****       #define __FPU_USED       0U
  95:./inc/core_cm7.h ****     #endif
  96:./inc/core_cm7.h ****   #else
  97:./inc/core_cm7.h ****     #define __FPU_USED         0U
  98:./inc/core_cm7.h ****   #endif
  99:./inc/core_cm7.h **** 
 100:./inc/core_cm7.h **** #elif defined ( __GNUC__ )

1862:./inc/core_cm7.h **** /**
1863:./inc/core_cm7.h ****   \brief   Set Priority Grouping
1864:./inc/core_cm7.h ****   \details Sets the priority grouping field using the required unlock sequence.
1865:./inc/core_cm7.h ****            The parameter PriorityGroup is assigned to the field SCB->AIRCR [10:8] PRIGROUP field.
1866:./inc/core_cm7.h ****            Only values from 0..7 are used.
1867:./inc/core_cm7.h ****            In case of a conflict between priority grouping and available
1868:./inc/core_cm7.h ****            priority bits (__NVIC_PRIO_BITS), the smallest possible priority group is set.
1869:./inc/core_cm7.h ****   \param [in]      PriorityGroup  Priority grouping field.
1870:./inc/core_cm7.h ****  */
1871:./inc/core_cm7.h **** __STATIC_INLINE void __NVIC_SetPriorityGrouping(uint32_t PriorityGroup)
1872:./inc/core_cm7.h **** {
1873:./inc/core_cm7.h ****   uint32_t reg_value;
1874:./inc/core_cm7.h ****   uint32_t PriorityGroupTmp = (PriorityGroup & (uint32_t)0x07UL);             /* only values 0..7 a
1875:./inc/core_cm7.h **** 
1876:./inc/core_cm7.h ****   reg_value  =  SCB->AIRCR;                                                   /* read old register 
1877:./inc/core_cm7.h ****   reg_value &= ~((uint32_t)(SCB_AIRCR_VECTKEY_Msk | SCB_AIRCR_PRIGROUP_Msk)); /* clear bits to chan
1878:./inc/core_cm7.h ****   reg_value  =  (reg_value                                   |
1879:./inc/core_cm7.h ****                 ((uint32_t)0x5FAUL << SCB_AIRCR_VECTKEY_Pos) |
1880:./inc/core_cm7.h ****                 (PriorityGroupTmp << SCB_AIRCR_PRIGROUP_Pos)  );              /* Insert write key a
1881:./inc/core_cm7.h ****   SCB->AIRCR =  reg_value;
1882:./inc/core_cm7.h **** }
1883:./inc/core_cm7.h **** 
1884:./inc/core_cm7.h **** 
1885:./inc/core_cm7.h **** /**
1886:./inc/core_cm7.h ****   \brief   Get Priority Grouping
1887:./inc/core_cm7.h ****   \details Reads the priority grouping field from the NVIC Interrupt Controller.
1888:./inc/core_cm7.h ****   \return                Priority grouping field (SCB->AIRCR [10:8] PRIGROUP field).
1889:./inc/core_cm7.h ****  */
1890:./inc/core_cm7.h **** __STATIC_INLINE uint32_t __NVIC_GetPriorityGrouping(void)
1891:./inc/core_cm7.h **** {
1892:./inc/core_cm7.h ****   return ((uint32_t)((SCB->AIRCR & SCB_AIRCR_PRIGROUP_Msk) >> SCB_AIRCR_PRIGROUP_Pos));
1893:./inc/core_cm7.h **** }
1894:./inc/core_cm7.h **** 
1895:./inc/core_cm7.h **** 
1896:./inc/core_cm7.h **** /**
1897:./inc/core_cm7.h ****   \brief   Enable Interrupt
1898:./inc/core_cm7.h ****   \details Enables a device specific interrupt in the NVIC interrupt controller.
1899:./inc/core_cm7.h ****   \param [in]      IRQn  Device specific interrupt number.
1900:./inc/core_cm7.h ****   \note    IRQn must not be negative.
1901:./inc/core_cm7.h ****  */
1902:./inc/core_cm7.h **** __STATIC_INLINE void __NVIC_EnableIRQ(IRQn_Type IRQn)  
1903:./inc/core_cm7.h **** {
1904:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
1905:./inc/core_cm7.h ****   {
1906:./inc/core_cm7.h ****     __COMPILER_BARRIER();
1907:./inc/core_cm7.h ****     NVIC->ISER[(((uint32_t)IRQn) >> 5UL)] = (uint32_t)(1UL << (((uint32_t)IRQn) & 0x1FUL));
1908:./inc/core_cm7.h ****     __COMPILER_BARRIER();
1909:./inc/core_cm7.h ****   }
1910:./inc/core_cm7.h **** }
1911:./inc/core_cm7.h **** 
1912:./inc/core_cm7.h **** 
1913:./inc/core_cm7.h **** /**
1914:./inc/core_cm7.h ****   \brief   Get Interrupt Enable status
1915:./inc/core_cm7.h ****   \details Returns a device specific interrupt enable status from the NVIC interrupt controller.
1916:./inc/core_cm7.h ****   \param [in]      IRQn  Device specific interrupt number.
1917:./inc/core_cm7.h ****   \return             0  Interrupt is not enabled.
1918:./inc/core_cm7.h ****   \return             1  Interrupt is enabled.
1919:./inc/core_cm7.h ****   \note    IRQn must not be negative.
1920:./inc/core_cm7.h ****  */
1921:./inc/core_cm7.h **** __STATIC_INLINE uint32_t __NVIC_GetEnableIRQ(IRQn_Type IRQn)
1922:./inc/core_cm7.h **** {
1923:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
1924:./inc/core_cm7.h ****   {
1925:./inc/core_cm7.h ****     return((uint32_t)(((NVIC->ISER[(((uint32_t)IRQn) >> 5UL)] & (1UL << (((uint32_t)IRQn) & 0x1FUL)
1926:./inc/core_cm7.h ****   }
1927:./inc/core_cm7.h ****   else
1928:./inc/core_cm7.h ****   {
1929:./inc/core_cm7.h ****     return(0U);
1930:./inc/core_cm7.h ****   }
1931:./inc/core_cm7.h **** }
1932:./inc/core_cm7.h **** 
1933:./inc/core_cm7.h **** 
1934:./inc/core_cm7.h **** /**
1935:./inc/core_cm7.h ****   \brief   Disable Interrupt
1936:./inc/core_cm7.h ****   \details Disables a device specific interrupt in the NVIC interrupt controller.
1937:./inc/core_cm7.h ****   \param [in]      IRQn  Device specific interrupt number.

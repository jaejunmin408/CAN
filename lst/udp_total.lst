2048:./inc/core_cm7.h ****            The interrupt number can be positive to specify a device specific interrupt,
2049:./inc/core_cm7.h ****            or negative to specify a processor exception.
2050:./inc/core_cm7.h ****   \param [in]   IRQn  Interrupt number.
2051:./inc/core_cm7.h ****   \return             Interrupt Priority.
2052:./inc/core_cm7.h ****                       Value is aligned automatically to the implemented priority bits of the microc
2053:./inc/core_cm7.h ****  */
2054:./inc/core_cm7.h **** __STATIC_INLINE uint32_t __NVIC_GetPriority(IRQn_Type IRQn)
2055:./inc/core_cm7.h **** {
2056:./inc/core_cm7.h **** 
2057:./inc/core_cm7.h ****   if ((int32_t)(IRQn) >= 0)
2058:./inc/core_cm7.h ****   {
2059:./inc/core_cm7.h ****     return(((uint32_t)NVIC->IP[((uint32_t)IRQn)]                >> (8U - __NVIC_PRIO_BITS)));
2060:./inc/core_cm7.h ****   }
2061:./inc/core_cm7.h ****   else
2062:./inc/core_cm7.h ****   {
2063:./inc/core_cm7.h ****     return(((uint32_t)SCB->SHPR[(((uint32_t)IRQn) & 0xFUL)-4UL] >> (8U - __NVIC_PRIO_BITS)));
2064:./inc/core_cm7.h ****   }
2065:./inc/core_cm7.h **** }

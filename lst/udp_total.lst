  73:./inc/core_cm7.h **** /** __FPU_USED indicates whether an FPU is used or not.
  74:./inc/core_cm7.h ****     For this, __FPU_PRESENT has to be checked prior to making use of FPU specific registers and fun
  75:./inc/core_cm7.h **** */
  76:./inc/core_cm7.h **** #if defined ( __CC_ARM )
  77:./inc/core_cm7.h ****   #if defined __TARGET_FPU_VFP
  78:./inc/core_cm7.h ****     #if defined (__FPU_PRESENT) && (__FPU_PRESENT == 1U)
  79:./inc/core_cm7.h ****       #define __FPU_USED       1U
  80:./inc/core_cm7.h ****     #else
  81:./inc/core_cm7.h ****       #error "Compiler generates FPU instructions for a device without an FPU (check __FPU_PRESENT)
  82:./inc/core_cm7.h ****       #define __FPU_USED       0U
  83:./inc/core_cm7.h ****     #endif
  84:./inc/core_cm7.h ****   #else
  85:./inc/core_cm7.h ****     #define __FPU_USED         0U
  86:./inc/core_cm7.h ****   #endif
  87:./inc/core_cm7.h **** 
  88:./inc/core_cm7.h **** #elif defined (__ARMCC_VERSION) && (__ARMCC_VERSION >= 6010050)

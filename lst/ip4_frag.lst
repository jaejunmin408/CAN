  47:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #include "lwip/inet_chksum.h"
  48:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #include "lwip/netif.h"
  49:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #include "lwip/stats.h"
  50:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #include "lwip/icmp.h"
  51:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  52:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #include <string.h>
  53:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  54:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASSEMBLY
  55:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
  56:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * The IP reassembly code currently has the following limitations:
  57:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * - IP header options are not supported
  58:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * - fragments must not overlap (e.g. due to different routes),
  59:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *   currently, overlapping or duplicate fragments are thrown away
  60:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *   if IP_REASS_CHECK_OVERLAP=1 (the default)!
  61:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *
  62:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @todo: work with IP header options
  63:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
  64:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  65:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /** Setting this to 0, you can turn off checking the fragments for overlapping
  66:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * regions. The code gets a little smaller. Only use this if you know that
  67:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * overlapping won't occur on your network! */
  68:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #ifndef IP_REASS_CHECK_OVERLAP
  69:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_REASS_CHECK_OVERLAP 1
  70:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_CHECK_OVERLAP */
  71:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  72:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /** Set to 0 to prevent freeing the oldest datagram when the reassembly buffer is
  73:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * full (IP_REASS_MAX_PBUFS pbufs are enqueued). The code gets a little smaller.
  74:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Datagrams will be freed by timeout only. Especially useful when MEMP_NUM_REASSDATA
  75:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * is set to 1, so one datagram can be reassembled at a time, only. */
  76:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #ifndef IP_REASS_FREE_OLDEST
  77:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_REASS_FREE_OLDEST 1
  78:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_FREE_OLDEST */
  79:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  80:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_REASS_FLAG_LASTFRAG 0x01
  81:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  82:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_REASS_VALIDATE_TELEGRAM_FINISHED  1
  83:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_REASS_VALIDATE_PBUF_QUEUED        0
  84:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_REASS_VALIDATE_PBUF_DROPPED       -1
  85:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
  86:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /** This is a helper struct which holds the starting
  87:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * offset and the ending offset of this fragment to
  88:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * easily chain the fragments.
  89:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * It has the same packing requirements as the IP header, since it replaces
  90:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * the IP header in memory in incoming fragments (after copying it) to keep
  91:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * track of the various fragments. (-> If the IP header doesn't need packing,
  92:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * this struct doesn't need packing, too.)
  93:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
  94:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #ifdef PACK_STRUCT_USE_INCLUDES
  95:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #  include "arch/bpstruct.h"
  96:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif
  97:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** PACK_STRUCT_BEGIN
  98:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** struct ip_reass_helper {
  99:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   PACK_STRUCT_FIELD(struct pbuf *next_pbuf);
 100:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   PACK_STRUCT_FIELD(u16_t start);
 101:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   PACK_STRUCT_FIELD(u16_t end);
 102:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** } PACK_STRUCT_STRUCT;
 103:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** PACK_STRUCT_END
 104:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #ifdef PACK_STRUCT_USE_INCLUDES
 105:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #  include "arch/epstruct.h"
 106:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif
 107:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 108:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #define IP_ADDRESSES_AND_ID_MATCH(iphdrA, iphdrB)  \
 109:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   (ip4_addr_cmp(&(iphdrA)->src, &(iphdrB)->src) && \
 110:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    ip4_addr_cmp(&(iphdrA)->dest, &(iphdrB)->dest) && \
 111:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    IPH_ID(iphdrA) == IPH_ID(iphdrB)) ? 1 : 0
 112:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 113:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /* global variables */
 114:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static struct ip_reassdata *reassdatagrams;
 115:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static u16_t ip_reass_pbufcount;
 116:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 117:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /* function prototypes */
 118:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static void ip_reass_dequeue_datagram(struct ip_reassdata *ipr, struct ip_reassdata *prev);
 119:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static int ip_reass_free_complete_datagram(struct ip_reassdata *ipr, struct ip_reassdata *prev);
 120:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 121:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 122:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Reassembly timer base function
 123:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * for both NO_SYS == 0 and 1 (!).
 124:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *
 125:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Should be called every 1000 msec (defined by IP_TMR_INTERVAL).
 126:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 127:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** void
 128:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip_reass_tmr(void)
 129:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 130:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reassdata *r, *prev = NULL;
 131:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 132:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   r = reassdatagrams;
 133:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   while (r != NULL) {
 134:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* Decrement the timer. Once it reaches 0,
 135:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****      * clean up the incomplete fragment assembly */
 136:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (r->timer > 0) {
 137:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       r->timer--;
 138:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_DEBUGF(IP_REASS_DEBUG, ("ip_reass_tmr: timer dec %"U16_F"\n", (u16_t)r->timer));
 139:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       prev = r;
 140:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       r = r->next;
 141:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     } else {
 142:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* reassembly timed out */
 143:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       struct ip_reassdata *tmp;
 144:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_DEBUGF(IP_REASS_DEBUG, ("ip_reass_tmr: timer timed out\n"));
 145:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       tmp = r;
 146:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* get the next pointer before freeing */
 147:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       r = r->next;
 148:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* free the helper struct and all enqueued pbufs */
 149:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       ip_reass_free_complete_datagram(tmp, prev);
 150:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 151:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 152:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** }
 153:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 154:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 155:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Free a datagram (struct ip_reassdata) and all its pbufs.
 156:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Updates the total count of enqueued pbufs (ip_reass_pbufcount),
 157:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * SNMP counters and sends an ICMP time exceeded packet.
 158:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *
 159:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param ipr datagram to free
 160:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param prev the previous datagram in the linked list
 161:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @return the number of pbufs freed
 162:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 163:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static int
 164:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip_reass_free_complete_datagram(struct ip_reassdata *ipr, struct ip_reassdata *prev)
 165:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 166:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   u16_t pbufs_freed = 0;
 167:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   u16_t clen;
 168:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct pbuf *p;
 169:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reass_helper *iprh;
 170:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 171:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   LWIP_ASSERT("prev != ipr", prev != ipr);
 172:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (prev != NULL) {
 173:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     LWIP_ASSERT("prev->next == ipr", prev->next == ipr);
 174:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 175:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 176:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   MIB2_STATS_INC(mib2.ipreasmfails);
 177:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if LWIP_ICMP
 178:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   iprh = (struct ip_reass_helper *)ipr->p->payload;
 179:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (iprh->start == 0) {
 180:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* The first fragment was received, send ICMP time exceeded. */
 181:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* First, de-queue the first pbuf from r->p. */
 182:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     p = ipr->p;
 183:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     ipr->p = iprh->next_pbuf;
 184:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* Then, copy the original header into it. */
 185:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     SMEMCPY(p->payload, &ipr->iphdr, IP_HLEN);
 186:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     icmp_time_exceeded(p, ICMP_TE_FRAG);
 187:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     clen = pbuf_clen(p);
 188:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     LWIP_ASSERT("pbufs_freed + clen <= 0xffff", pbufs_freed + clen <= 0xffff);
 189:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     pbufs_freed = (u16_t)(pbufs_freed + clen);
 190:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     pbuf_free(p);
 191:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 192:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* LWIP_ICMP */
 193:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 194:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* First, free all received pbufs.  The individual pbufs need to be released
 195:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****      separately as they have not yet been chained */
 196:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   p = ipr->p;
 197:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   while (p != NULL) {
 198:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     struct pbuf *pcur;
 199:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     iprh = (struct ip_reass_helper *)p->payload;
 200:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     pcur = p;
 201:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* get the next pointer before freeing */
 202:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     p = iprh->next_pbuf;
 203:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     clen = pbuf_clen(pcur);
 204:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     LWIP_ASSERT("pbufs_freed + clen <= 0xffff", pbufs_freed + clen <= 0xffff);
 205:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     pbufs_freed = (u16_t)(pbufs_freed + clen);
 206:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     pbuf_free(pcur);
 207:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 208:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* Then, unchain the struct ip_reassdata from the list and free it. */
 209:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   ip_reass_dequeue_datagram(ipr, prev);
 210:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   LWIP_ASSERT("ip_reass_pbufcount >= pbufs_freed", ip_reass_pbufcount >= pbufs_freed);
 211:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   ip_reass_pbufcount = (u16_t)(ip_reass_pbufcount - pbufs_freed);
 212:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 213:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   return pbufs_freed;
 214:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** }
 215:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 216:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_FREE_OLDEST
 217:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 218:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Free the oldest datagram to make room for enqueueing new fragments.
 219:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * The datagram 'fraghdr' belongs to is not freed!
 220:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *
 221:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param fraghdr IP header of the current fragment
 222:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param pbufs_needed number of pbufs needed to enqueue
 223:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *        (used for freeing other datagrams if not enough space)
 224:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @return the number of pbufs freed
 225:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 226:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static int
 227:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip_reass_remove_oldest_datagram(struct ip_hdr *fraghdr, int pbufs_needed)
 228:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 229:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* @todo Can't we simply remove the last datagram in the
 230:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    *       linked list behind reassdatagrams?
 231:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    */
 232:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reassdata *r, *oldest, *prev, *oldest_prev;
 233:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   int pbufs_freed = 0, pbufs_freed_current;
 234:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   int other_datagrams;
 235:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 236:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* Free datagrams until being allowed to enqueue 'pbufs_needed' pbufs,
 237:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    * but don't free the datagram that 'fraghdr' belongs to! */
 238:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   do {
 239:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     oldest = NULL;
 240:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     prev = NULL;
 241:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     oldest_prev = NULL;
 242:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     other_datagrams = 0;
 243:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     r = reassdatagrams;
 244:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     while (r != NULL) {
 245:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       if (!IP_ADDRESSES_AND_ID_MATCH(&r->iphdr, fraghdr)) {
 246:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         /* Not the same datagram as fraghdr */
 247:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         other_datagrams++;
 248:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         if (oldest == NULL) {
 249:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           oldest = r;
 250:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           oldest_prev = prev;
 251:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         } else if (r->timer <= oldest->timer) {
 252:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           /* older than the previous oldest */
 253:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           oldest = r;
 254:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           oldest_prev = prev;
 255:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 256:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       }
 257:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       if (r->next != NULL) {
 258:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         prev = r;
 259:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       }
 260:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       r = r->next;
 261:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 262:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (oldest != NULL) {
 263:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       pbufs_freed_current = ip_reass_free_complete_datagram(oldest, oldest_prev);
 264:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       pbufs_freed += pbufs_freed_current;
 265:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 266:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   } while ((pbufs_freed < pbufs_needed) && (other_datagrams > 1));
 267:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   return pbufs_freed;
 268:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** }
 269:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_FREE_OLDEST */
 270:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 271:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 272:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Enqueues a new fragment into the fragment queue
 273:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param fraghdr points to the new fragments IP hdr
 274:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param clen number of pbufs needed to enqueue (used for freeing other datagrams if not enough sp
 275:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @return A pointer to the queue location into which the fragment was enqueued
 276:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 277:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static struct ip_reassdata *
 278:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip_reass_enqueue_new_datagram(struct ip_hdr *fraghdr, int clen)
 279:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 280:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reassdata *ipr;
 281:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if ! IP_REASS_FREE_OLDEST
 282:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   LWIP_UNUSED_ARG(clen);
 283:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif
 284:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 285:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* No matching previous fragment found, allocate a new reassdata struct */
 286:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   ipr = (struct ip_reassdata *)memp_malloc(MEMP_REASSDATA);
 287:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (ipr == NULL) {
 288:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_FREE_OLDEST
 289:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (ip_reass_remove_oldest_datagram(fraghdr, clen) >= clen) {
 290:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       ipr = (struct ip_reassdata *)memp_malloc(MEMP_REASSDATA);
 291:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 292:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (ipr == NULL)
 293:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_FREE_OLDEST */
 294:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     {
 295:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       IPFRAG_STATS_INC(ip_frag.memerr);
 296:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_DEBUGF(IP_REASS_DEBUG, ("Failed to alloc reassdata struct\n"));
 297:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       return NULL;
 298:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 299:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 300:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   memset(ipr, 0, sizeof(struct ip_reassdata));
 301:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   ipr->timer = IP_REASS_MAXAGE;
 302:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 303:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* enqueue the new structure to the front of the list */
 304:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   ipr->next = reassdatagrams;
 305:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   reassdatagrams = ipr;
 306:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* copy the ip header for later tests and input */
 307:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* @todo: no ip options supported? */
 308:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   SMEMCPY(&(ipr->iphdr), fraghdr, IP_HLEN);
 309:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   return ipr;
 310:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** }
 311:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 312:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 313:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Dequeues a datagram from the datagram queue. Doesn't deallocate the pbufs.
 314:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param ipr points to the queue entry to dequeue
 315:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 316:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static void
 317:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip_reass_dequeue_datagram(struct ip_reassdata *ipr, struct ip_reassdata *prev)
 318:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 319:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* dequeue the reass struct  */
 320:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (reassdatagrams == ipr) {
 321:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* it was the first in the list */
 322:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     reassdatagrams = ipr->next;
 323:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   } else {
 324:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* it wasn't the first, so it must have a valid 'prev' */
 325:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     LWIP_ASSERT("sanity check linked list", prev != NULL);
 326:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     prev->next = ipr->next;
 327:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 328:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 329:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* now we can free the ip_reassdata struct */
 330:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   memp_free(MEMP_REASSDATA, ipr);
 331:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** }
 332:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 333:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 334:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Chain a new pbuf into the pbuf list that composes the datagram.  The pbuf list
 335:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * will grow over time as  new pbufs are rx.
 336:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Also checks that the datagram passes basic continuity checks (if the last
 337:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * fragment was received at least once).
 338:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param ipr points to the reassembly state
 339:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param new_p points to the pbuf for the current fragment
 340:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param is_last is 1 if this pbuf has MF==0 (ipr->flags not updated yet)
 341:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @return see IP_REASS_VALIDATE_* defines
 342:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 343:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** static int
 344:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip_reass_chain_frag_into_datagram_and_validate(struct ip_reassdata *ipr, struct pbuf *new_p, int is
 345:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 346:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reass_helper *iprh, *iprh_tmp, *iprh_prev = NULL;
 347:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct pbuf *q;
 348:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   u16_t offset, len;
 349:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   u8_t hlen;
 350:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_hdr *fraghdr;
 351:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   int valid = 1;
 352:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 353:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* Extract length and fragment offset from current fragment */
 354:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   fraghdr = (struct ip_hdr *)new_p->payload;
 355:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   len = lwip_ntohs(IPH_LEN(fraghdr));
 356:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   hlen = IPH_HL_BYTES(fraghdr);
 357:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (hlen > len) {
 358:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* invalid datagram */
 359:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     return IP_REASS_VALIDATE_PBUF_DROPPED;
 360:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 361:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   len = (u16_t)(len - hlen);
 362:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   offset = IPH_OFFSET_BYTES(fraghdr);
 363:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 364:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* overwrite the fragment's ip header from the pbuf with our helper struct,
 365:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    * and setup the embedded helper structure. */
 366:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* make sure the struct ip_reass_helper fits into the IP header */
 367:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   LWIP_ASSERT("sizeof(struct ip_reass_helper) <= IP_HLEN",
 368:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****               sizeof(struct ip_reass_helper) <= IP_HLEN);
 369:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   iprh = (struct ip_reass_helper *)new_p->payload;
 370:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   iprh->next_pbuf = NULL;
 371:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   iprh->start = offset;
 372:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   iprh->end = (u16_t)(offset + len);
 373:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (iprh->end < offset) {
 374:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* u16_t overflow, cannot handle this */
 375:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     return IP_REASS_VALIDATE_PBUF_DROPPED;
 376:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 377:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 378:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* Iterate through until we either get to the end of the list (append),
 379:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    * or we find one with a larger offset (insert). */
 380:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   for (q = ipr->p; q != NULL;) {
 381:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     iprh_tmp = (struct ip_reass_helper *)q->payload;
 382:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (iprh->start < iprh_tmp->start) {
 383:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* the new pbuf should be inserted before this */
 384:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       iprh->next_pbuf = q;
 385:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       if (iprh_prev != NULL) {
 386:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         /* not the fragment with the lowest offset */
 387:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_CHECK_OVERLAP
 388:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         if ((iprh->start < iprh_prev->end) || (iprh->end > iprh_tmp->start)) {
 389:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           /* fragment overlaps with previous or following, throw away */
 390:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           return IP_REASS_VALIDATE_PBUF_DROPPED;
 391:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 392:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_CHECK_OVERLAP */
 393:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         iprh_prev->next_pbuf = new_p;
 394:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         if (iprh_prev->end != iprh->start) {
 395:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           /* There is a fragment missing between the current
 396:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****            * and the previous fragment */
 397:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           valid = 0;
 398:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 399:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       } else {
 400:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_CHECK_OVERLAP
 401:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         if (iprh->end > iprh_tmp->start) {
 402:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           /* fragment overlaps with following, throw away */
 403:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           return IP_REASS_VALIDATE_PBUF_DROPPED;
 404:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 405:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_CHECK_OVERLAP */
 406:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         /* fragment with the lowest offset */
 407:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         ipr->p = new_p;
 408:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       }
 409:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       break;
 410:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     } else if (iprh->start == iprh_tmp->start) {
 411:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* received the same datagram twice: no need to keep the datagram */
 412:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       return IP_REASS_VALIDATE_PBUF_DROPPED;
 413:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_CHECK_OVERLAP
 414:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     } else if (iprh->start < iprh_tmp->end) {
 415:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* overlap: no need to keep the new datagram */
 416:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       return IP_REASS_VALIDATE_PBUF_DROPPED;
 417:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_CHECK_OVERLAP */
 418:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     } else {
 419:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* Check if the fragments received so far have no holes. */
 420:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       if (iprh_prev != NULL) {
 421:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         if (iprh_prev->end != iprh_tmp->start) {
 422:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           /* There is a fragment missing between the current
 423:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****            * and the previous fragment */
 424:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           valid = 0;
 425:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 426:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       }
 427:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 428:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     q = iprh_tmp->next_pbuf;
 429:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     iprh_prev = iprh_tmp;
 430:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 431:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 432:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* If q is NULL, then we made it to the end of the list. Determine what to do now */
 433:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (q == NULL) {
 434:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (iprh_prev != NULL) {
 435:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* this is (for now), the fragment with the highest offset:
 436:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****        * chain it to the last fragment */
 437:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_CHECK_OVERLAP
 438:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_ASSERT("check fragments don't overlap", iprh_prev->end <= iprh->start);
 439:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_CHECK_OVERLAP */
 440:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       iprh_prev->next_pbuf = new_p;
 441:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       if (iprh_prev->end != iprh->start) {
 442:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         valid = 0;
 443:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       }
 444:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     } else {
 445:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_CHECK_OVERLAP
 446:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_ASSERT("no previous fragment, this must be the first fragment!",
 447:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****                   ipr->p == NULL);
 448:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_CHECK_OVERLAP */
 449:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* this is the first fragment we ever received for this ip datagram */
 450:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       ipr->p = new_p;
 451:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 452:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 453:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 454:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* At this point, the validation part begins: */
 455:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* If we already received the last fragment */
 456:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (is_last || ((ipr->flags & IP_REASS_FLAG_LASTFRAG) != 0)) {
 457:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* and had no holes so far */
 458:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (valid) {
 459:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* then check if the rest of the fragments is here */
 460:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* Check if the queue starts with the first datagram */
 461:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       if ((ipr->p == NULL) || (((struct ip_reass_helper *)ipr->p->payload)->start != 0)) {
 462:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         valid = 0;
 463:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       } else {
 464:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         /* and check that there are no holes after this datagram */
 465:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         iprh_prev = iprh;
 466:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         q = iprh->next_pbuf;
 467:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         while (q != NULL) {
 468:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           iprh = (struct ip_reass_helper *)q->payload;
 469:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           if (iprh_prev->end != iprh->start) {
 470:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****             valid = 0;
 471:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****             break;
 472:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           }
 473:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           iprh_prev = iprh;
 474:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           q = iprh->next_pbuf;
 475:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 476:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         /* if still valid, all fragments are received
 477:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****          * (because to the MF==0 already arrived */
 478:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         if (valid) {
 479:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           LWIP_ASSERT("sanity check", ipr->p != NULL);
 480:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           LWIP_ASSERT("sanity check",
 481:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****                       ((struct ip_reass_helper *)ipr->p->payload) != iprh);
 482:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****           LWIP_ASSERT("validate_datagram:next_pbuf!=NULL",
 483:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****                       iprh->next_pbuf == NULL);
 484:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         }
 485:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       }
 486:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 487:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* If valid is 0 here, there are some fragments missing in the middle
 488:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****      * (since MF == 0 has already arrived). Such datagrams simply time out if
 489:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****      * no more fragments are received... */
 490:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     return valid ? IP_REASS_VALIDATE_TELEGRAM_FINISHED : IP_REASS_VALIDATE_PBUF_QUEUED;
 491:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 492:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* If we come here, not all fragments were received, yet! */
 493:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   return IP_REASS_VALIDATE_PBUF_QUEUED; /* not yet valid! */
 494:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** }
 495:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 496:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** /**
 497:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * Reassembles incoming IP fragments into an IP datagram.
 498:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  *
 499:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @param p points to a pbuf chain of the fragment
 500:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  * @return NULL if reassembly is incomplete, ? otherwise
 501:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****  */
 502:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** struct pbuf *
 503:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** ip4_reass(struct pbuf *p)
 504:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** {
 505:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct pbuf *r;
 506:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_hdr *fraghdr;
 507:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reassdata *ipr;
 508:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   struct ip_reass_helper *iprh;
 509:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   u16_t offset, len, clen;
 510:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   u8_t hlen;
 511:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   int valid;
 512:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   int is_last;
 513:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 514:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   IPFRAG_STATS_INC(ip_frag.recv);
 515:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   MIB2_STATS_INC(mib2.ipreasmreqds);
 516:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 517:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   fraghdr = (struct ip_hdr *)p->payload;
 518:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 519:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (IPH_HL_BYTES(fraghdr) != IP_HLEN) {
 520:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     LWIP_DEBUGF(IP_REASS_DEBUG, ("ip4_reass: IP options currently not supported!\n"));
 521:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     IPFRAG_STATS_INC(ip_frag.err);
 522:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     goto nullreturn;
 523:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 524:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 525:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   offset = IPH_OFFSET_BYTES(fraghdr);
 526:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   len = lwip_ntohs(IPH_LEN(fraghdr));
 527:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   hlen = IPH_HL_BYTES(fraghdr);
 528:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (hlen > len) {
 529:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* invalid datagram */
 530:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     goto nullreturn;
 531:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 532:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   len = (u16_t)(len - hlen);
 533:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 534:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* Check if we are allowed to enqueue more datagrams. */
 535:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   clen = pbuf_clen(p);
 536:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if ((ip_reass_pbufcount + clen) > IP_REASS_MAX_PBUFS) {
 537:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #if IP_REASS_FREE_OLDEST
 538:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (!ip_reass_remove_oldest_datagram(fraghdr, clen) ||
 539:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         ((ip_reass_pbufcount + clen) > IP_REASS_MAX_PBUFS))
 540:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** #endif /* IP_REASS_FREE_OLDEST */
 541:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     {
 542:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* No datagram could be freed and still too many pbufs enqueued */
 543:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_DEBUGF(IP_REASS_DEBUG, ("ip4_reass: Overflow condition: pbufct=%d, clen=%d, MAX=%d\n",
 544:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****                                    ip_reass_pbufcount, clen, IP_REASS_MAX_PBUFS));
 545:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       IPFRAG_STATS_INC(ip_frag.memerr);
 546:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* @todo: send ICMP time exceeded here? */
 547:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* drop this pbuf */
 548:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       goto nullreturn;
 549:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 550:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 551:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 552:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   /* Look for the datagram the fragment belongs to in the current datagram queue,
 553:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****    * remembering the previous in the queue for later dequeueing. */
 554:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   for (ipr = reassdatagrams; ipr != NULL; ipr = ipr->next) {
 555:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* Check if the incoming fragment matches the one currently present
 556:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****        in the reassembly buffer. If so, we proceed with copying the
 557:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****        fragment into the buffer. */
 558:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (IP_ADDRESSES_AND_ID_MATCH(&ipr->iphdr, fraghdr)) {
 559:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       LWIP_DEBUGF(IP_REASS_DEBUG, ("ip4_reass: matching previous fragment ID=%"X16_F"\n",
 560:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****                                    lwip_ntohs(IPH_ID(fraghdr))));
 561:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       IPFRAG_STATS_INC(ip_frag.cachehit);
 562:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       break;
 563:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 564:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   }
 565:./lwip-2.1.2/src/core/ipv4/ip4_frag.c **** 
 566:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   if (ipr == NULL) {
 567:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* Enqueue a new datagram into the datagram queue */
 568:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     ipr = ip_reass_enqueue_new_datagram(fraghdr, clen);
 569:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     /* Bail if unable to enqueue */
 570:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (ipr == NULL) {
 571:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       goto nullreturn;
 572:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     }
 573:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****   } else {
 574:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****     if (((lwip_ntohs(IPH_OFFSET(fraghdr)) & IP_OFFMASK) == 0) &&
 575:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****         ((lwip_ntohs(IPH_OFFSET(&ipr->iphdr)) & IP_OFFMASK) != 0)) {
 576:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****       /* ipr->iphdr is not the header from the first fragment, but fraghdr is
 577:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****        * -> copy fraghdr into ipr->iphdr since we want to have the header
 578:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****        * of the first fragment (for ICMP time exceeded and later, for copying
 579:./lwip-2.1.2/src/core/ipv4/ip4_frag.c ****        * all options, if supported)*/

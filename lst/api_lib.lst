 461:./lwip-2.1.2/src/api/api_lib.c **** /**
 462:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_tcp
 463:./lwip-2.1.2/src/api/api_lib.c ****  * Accept a new connection on a TCP listening netconn.
 464:./lwip-2.1.2/src/api/api_lib.c ****  *
 465:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the TCP listen netconn
 466:./lwip-2.1.2/src/api/api_lib.c ****  * @param new_conn pointer where the new connection is stored
 467:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if a new connection has been received or an error
 468:./lwip-2.1.2/src/api/api_lib.c ****  *                code otherwise
 469:./lwip-2.1.2/src/api/api_lib.c ****  */
 470:./lwip-2.1.2/src/api/api_lib.c **** err_t
 471:./lwip-2.1.2/src/api/api_lib.c **** netconn_accept(struct netconn *conn, struct netconn **new_conn)
 472:./lwip-2.1.2/src/api/api_lib.c **** {
 473:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_TCP
 474:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 475:./lwip-2.1.2/src/api/api_lib.c ****   void *accept_ptr;
 476:./lwip-2.1.2/src/api/api_lib.c ****   struct netconn *newconn;
 477:./lwip-2.1.2/src/api/api_lib.c **** #if TCP_LISTEN_BACKLOG
 478:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
 479:./lwip-2.1.2/src/api/api_lib.c **** #endif /* TCP_LISTEN_BACKLOG */
 480:./lwip-2.1.2/src/api/api_lib.c **** 
 481:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_accept: invalid pointer",    (new_conn != NULL),                  return ERR_
 482:./lwip-2.1.2/src/api/api_lib.c ****   *new_conn = NULL;
 483:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_accept: invalid conn",       (conn != NULL),                      return ERR_
 484:./lwip-2.1.2/src/api/api_lib.c **** 
 485:./lwip-2.1.2/src/api/api_lib.c ****   /* NOTE: Although the opengroup spec says a pending error shall be returned to
 486:./lwip-2.1.2/src/api/api_lib.c ****            send/recv/getsockopt(SO_ERROR) only, we return it for listening
 487:./lwip-2.1.2/src/api/api_lib.c ****            connections also, to handle embedded-system errors */
 488:./lwip-2.1.2/src/api/api_lib.c ****   err = netconn_err(conn);
 489:./lwip-2.1.2/src/api/api_lib.c ****   if (err != ERR_OK) {
 490:./lwip-2.1.2/src/api/api_lib.c ****     /* return pending error */
 491:./lwip-2.1.2/src/api/api_lib.c ****     return err;
 492:./lwip-2.1.2/src/api/api_lib.c ****   }
 493:./lwip-2.1.2/src/api/api_lib.c ****   if (!NETCONN_ACCEPTMBOX_WAITABLE(conn)) {
 494:./lwip-2.1.2/src/api/api_lib.c ****     /* don't accept if closed: this might block the application task
 495:./lwip-2.1.2/src/api/api_lib.c ****        waiting on acceptmbox forever! */
 496:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_CLSD;
 497:./lwip-2.1.2/src/api/api_lib.c ****   }
 498:./lwip-2.1.2/src/api/api_lib.c **** 
 499:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_ALLOC_ACCEPT(msg);
 500:./lwip-2.1.2/src/api/api_lib.c **** 
 501:./lwip-2.1.2/src/api/api_lib.c ****   NETCONN_MBOX_WAITING_INC(conn);
 502:./lwip-2.1.2/src/api/api_lib.c ****   if (netconn_is_nonblocking(conn)) {
 503:./lwip-2.1.2/src/api/api_lib.c ****     if (sys_arch_mbox_tryfetch(&conn->acceptmbox, &accept_ptr) == SYS_ARCH_TIMEOUT) {
 504:./lwip-2.1.2/src/api/api_lib.c ****       API_MSG_VAR_FREE_ACCEPT(msg);
 505:./lwip-2.1.2/src/api/api_lib.c ****       NETCONN_MBOX_WAITING_DEC(conn);
 506:./lwip-2.1.2/src/api/api_lib.c ****       return ERR_WOULDBLOCK;
 507:./lwip-2.1.2/src/api/api_lib.c ****     }
 508:./lwip-2.1.2/src/api/api_lib.c ****   } else {
 509:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_SO_RCVTIMEO
 510:./lwip-2.1.2/src/api/api_lib.c ****     if (sys_arch_mbox_fetch(&conn->acceptmbox, &accept_ptr, conn->recv_timeout) == SYS_ARCH_TIMEOUT
 511:./lwip-2.1.2/src/api/api_lib.c ****       API_MSG_VAR_FREE_ACCEPT(msg);
 512:./lwip-2.1.2/src/api/api_lib.c ****       NETCONN_MBOX_WAITING_DEC(conn);
 513:./lwip-2.1.2/src/api/api_lib.c ****       return ERR_TIMEOUT;
 514:./lwip-2.1.2/src/api/api_lib.c ****     }
 515:./lwip-2.1.2/src/api/api_lib.c **** #else
 516:./lwip-2.1.2/src/api/api_lib.c ****     sys_arch_mbox_fetch(&conn->acceptmbox, &accept_ptr, 0);
 517:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_SO_RCVTIMEO*/
 518:./lwip-2.1.2/src/api/api_lib.c ****   }
 519:./lwip-2.1.2/src/api/api_lib.c ****   NETCONN_MBOX_WAITING_DEC(conn);
 520:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_NETCONN_FULLDUPLEX
 521:./lwip-2.1.2/src/api/api_lib.c ****   if (conn->flags & NETCONN_FLAG_MBOXINVALID) {
 522:./lwip-2.1.2/src/api/api_lib.c ****     if (lwip_netconn_is_deallocated_msg(accept_ptr)) {
 523:./lwip-2.1.2/src/api/api_lib.c ****       /* the netconn has been closed from another thread */
 524:./lwip-2.1.2/src/api/api_lib.c ****       API_MSG_VAR_FREE_ACCEPT(msg);
 525:./lwip-2.1.2/src/api/api_lib.c ****       return ERR_CONN;
 526:./lwip-2.1.2/src/api/api_lib.c ****     }
 527:./lwip-2.1.2/src/api/api_lib.c ****   }
 528:./lwip-2.1.2/src/api/api_lib.c **** #endif
 529:./lwip-2.1.2/src/api/api_lib.c **** 
 530:./lwip-2.1.2/src/api/api_lib.c ****   /* Register event with callback */
 531:./lwip-2.1.2/src/api/api_lib.c ****   API_EVENT(conn, NETCONN_EVT_RCVMINUS, 0);
 532:./lwip-2.1.2/src/api/api_lib.c **** 
 533:./lwip-2.1.2/src/api/api_lib.c ****   if (lwip_netconn_is_err_msg(accept_ptr, &err)) {
 534:./lwip-2.1.2/src/api/api_lib.c ****     /* a connection has been aborted: e.g. out of pcbs or out of netconns during accept */
 535:./lwip-2.1.2/src/api/api_lib.c ****     API_MSG_VAR_FREE_ACCEPT(msg);
 536:./lwip-2.1.2/src/api/api_lib.c ****     return err;
 537:./lwip-2.1.2/src/api/api_lib.c ****   }
 538:./lwip-2.1.2/src/api/api_lib.c ****   if (accept_ptr == NULL) {
 539:./lwip-2.1.2/src/api/api_lib.c ****     /* connection has been aborted */
 540:./lwip-2.1.2/src/api/api_lib.c ****     API_MSG_VAR_FREE_ACCEPT(msg);
 541:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_CLSD;
 542:./lwip-2.1.2/src/api/api_lib.c ****   }
 543:./lwip-2.1.2/src/api/api_lib.c ****   newconn = (struct netconn *)accept_ptr;
 544:./lwip-2.1.2/src/api/api_lib.c **** #if TCP_LISTEN_BACKLOG
 545:./lwip-2.1.2/src/api/api_lib.c ****   /* Let the stack know that we have accepted the connection. */
 546:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).conn = newconn;
 547:./lwip-2.1.2/src/api/api_lib.c ****   /* don't care for the return value of lwip_netconn_do_recv */
 548:./lwip-2.1.2/src/api/api_lib.c ****   netconn_apimsg(lwip_netconn_do_accepted, &API_MSG_VAR_REF(msg));
 549:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_FREE(msg);
 550:./lwip-2.1.2/src/api/api_lib.c **** #endif /* TCP_LISTEN_BACKLOG */
 551:./lwip-2.1.2/src/api/api_lib.c **** 
 552:./lwip-2.1.2/src/api/api_lib.c ****   *new_conn = newconn;
 553:./lwip-2.1.2/src/api/api_lib.c ****   /* don't set conn->last_err: it's only ERR_OK, anyway */
 554:./lwip-2.1.2/src/api/api_lib.c ****   return ERR_OK;
 555:./lwip-2.1.2/src/api/api_lib.c **** #else /* LWIP_TCP */
 556:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_UNUSED_ARG(conn);
 557:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_UNUSED_ARG(new_conn);
 558:./lwip-2.1.2/src/api/api_lib.c ****   return ERR_ARG;
 559:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_TCP */
 560:./lwip-2.1.2/src/api/api_lib.c **** }

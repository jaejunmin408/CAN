 108:./lwip-2.1.2/src/api/api_lib.c **** /**
 109:./lwip-2.1.2/src/api/api_lib.c ****  * Call the lower part of a netconn_* function
 110:./lwip-2.1.2/src/api/api_lib.c ****  * This function is then running in the thread context
 111:./lwip-2.1.2/src/api/api_lib.c ****  * of tcpip_thread and has exclusive access to lwIP core code.
 112:./lwip-2.1.2/src/api/api_lib.c ****  *
 113:./lwip-2.1.2/src/api/api_lib.c ****  * @param fn function to call
 114:./lwip-2.1.2/src/api/api_lib.c ****  * @param apimsg a struct containing the function to call and its parameters
 115:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if the function was called, another err_t if not
 116:./lwip-2.1.2/src/api/api_lib.c ****  */
 117:./lwip-2.1.2/src/api/api_lib.c **** static err_t
 118:./lwip-2.1.2/src/api/api_lib.c **** netconn_apimsg(tcpip_callback_fn fn, struct api_msg *apimsg)
 119:./lwip-2.1.2/src/api/api_lib.c **** {
 120:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 121:./lwip-2.1.2/src/api/api_lib.c **** 
 122:./lwip-2.1.2/src/api/api_lib.c **** #ifdef LWIP_DEBUG
 123:./lwip-2.1.2/src/api/api_lib.c ****   /* catch functions that don't set err */
 124:./lwip-2.1.2/src/api/api_lib.c ****   apimsg->err = ERR_VAL;
 125:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_DEBUG */
 126:./lwip-2.1.2/src/api/api_lib.c **** 
 127:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_NETCONN_SEM_PER_THREAD
 128:./lwip-2.1.2/src/api/api_lib.c ****   apimsg->op_completed_sem = LWIP_NETCONN_THREAD_SEM_GET();
 129:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_NETCONN_SEM_PER_THREAD */
 130:./lwip-2.1.2/src/api/api_lib.c **** 
 131:./lwip-2.1.2/src/api/api_lib.c ****   err = tcpip_send_msg_wait_sem(fn, apimsg, LWIP_API_MSG_SEM(apimsg));
 132:./lwip-2.1.2/src/api/api_lib.c ****   if (err == ERR_OK) {
 133:./lwip-2.1.2/src/api/api_lib.c ****     return apimsg->err;
 134:./lwip-2.1.2/src/api/api_lib.c ****   }
 135:./lwip-2.1.2/src/api/api_lib.c ****   return err;
 136:./lwip-2.1.2/src/api/api_lib.c **** }
 137:./lwip-2.1.2/src/api/api_lib.c **** 
 138:./lwip-2.1.2/src/api/api_lib.c **** /**
 139:./lwip-2.1.2/src/api/api_lib.c ****  * Create a new netconn (of a specific type) that has a callback function.
 140:./lwip-2.1.2/src/api/api_lib.c ****  * The corresponding pcb is also created.
 141:./lwip-2.1.2/src/api/api_lib.c ****  *
 142:./lwip-2.1.2/src/api/api_lib.c ****  * @param t the type of 'connection' to create (@see enum netconn_type)
 143:./lwip-2.1.2/src/api/api_lib.c ****  * @param proto the IP protocol for RAW IP pcbs
 144:./lwip-2.1.2/src/api/api_lib.c ****  * @param callback a function to call on status changes (RX available, TX'ed)
 145:./lwip-2.1.2/src/api/api_lib.c ****  * @return a newly allocated struct netconn or
 146:./lwip-2.1.2/src/api/api_lib.c ****  *         NULL on memory error
 147:./lwip-2.1.2/src/api/api_lib.c ****  */
 148:./lwip-2.1.2/src/api/api_lib.c **** struct netconn *
 149:./lwip-2.1.2/src/api/api_lib.c **** netconn_new_with_proto_and_callback(enum netconn_type t, u8_t proto, netconn_callback callback)
 150:./lwip-2.1.2/src/api/api_lib.c **** {
 151:./lwip-2.1.2/src/api/api_lib.c ****   struct netconn *conn;
 152:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
 153:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_ALLOC_RETURN_NULL(msg);
 154:./lwip-2.1.2/src/api/api_lib.c **** 
 155:./lwip-2.1.2/src/api/api_lib.c ****   conn = netconn_alloc(t, callback);
 156:./lwip-2.1.2/src/api/api_lib.c ****   if (conn != NULL) {
 157:./lwip-2.1.2/src/api/api_lib.c ****     err_t err;
 158:./lwip-2.1.2/src/api/api_lib.c **** 
 159:./lwip-2.1.2/src/api/api_lib.c ****     API_MSG_VAR_REF(msg).msg.n.proto = proto;
 160:./lwip-2.1.2/src/api/api_lib.c ****     API_MSG_VAR_REF(msg).conn = conn;
 161:./lwip-2.1.2/src/api/api_lib.c ****     err = netconn_apimsg(lwip_netconn_do_newconn, &API_MSG_VAR_REF(msg));
 162:./lwip-2.1.2/src/api/api_lib.c ****     if (err != ERR_OK) {
 163:./lwip-2.1.2/src/api/api_lib.c ****       LWIP_ASSERT("freeing conn without freeing pcb", conn->pcb.tcp == NULL);
 164:./lwip-2.1.2/src/api/api_lib.c ****       LWIP_ASSERT("conn has no recvmbox", sys_mbox_valid(&conn->recvmbox));
 165:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_TCP
 166:./lwip-2.1.2/src/api/api_lib.c ****       LWIP_ASSERT("conn->acceptmbox shouldn't exist", !sys_mbox_valid(&conn->acceptmbox));
 167:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_TCP */
 168:./lwip-2.1.2/src/api/api_lib.c **** #if !LWIP_NETCONN_SEM_PER_THREAD
 169:./lwip-2.1.2/src/api/api_lib.c ****       LWIP_ASSERT("conn has no op_completed", sys_sem_valid(&conn->op_completed));
 170:./lwip-2.1.2/src/api/api_lib.c ****       sys_sem_free(&conn->op_completed);
 171:./lwip-2.1.2/src/api/api_lib.c **** #endif /* !LWIP_NETCONN_SEM_PER_THREAD */
 172:./lwip-2.1.2/src/api/api_lib.c ****       sys_mbox_free(&conn->recvmbox);
 173:./lwip-2.1.2/src/api/api_lib.c ****       memp_free(MEMP_NETCONN, conn);
 174:./lwip-2.1.2/src/api/api_lib.c ****       API_MSG_VAR_FREE(msg);
 175:./lwip-2.1.2/src/api/api_lib.c ****       return NULL;
 176:./lwip-2.1.2/src/api/api_lib.c ****     }
 177:./lwip-2.1.2/src/api/api_lib.c ****   }
 178:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_FREE(msg);
 179:./lwip-2.1.2/src/api/api_lib.c ****   return conn;
 180:./lwip-2.1.2/src/api/api_lib.c **** }
 181:./lwip-2.1.2/src/api/api_lib.c **** 
 182:./lwip-2.1.2/src/api/api_lib.c **** /**
 183:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_common
 184:./lwip-2.1.2/src/api/api_lib.c ****  * Close a netconn 'connection' and free all its resources but not the netconn itself.
 185:./lwip-2.1.2/src/api/api_lib.c ****  * UDP and RAW connection are completely closed, TCP pcbs might still be in a waitstate
 186:./lwip-2.1.2/src/api/api_lib.c ****  * after this returns.
 187:./lwip-2.1.2/src/api/api_lib.c ****  *
 188:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the netconn to delete
 189:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if the connection was deleted
 190:./lwip-2.1.2/src/api/api_lib.c ****  */
 191:./lwip-2.1.2/src/api/api_lib.c **** err_t
 192:./lwip-2.1.2/src/api/api_lib.c **** netconn_prepare_delete(struct netconn *conn)
 193:./lwip-2.1.2/src/api/api_lib.c **** {
 194:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 195:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
 196:./lwip-2.1.2/src/api/api_lib.c **** 
 197:./lwip-2.1.2/src/api/api_lib.c ****   /* No ASSERT here because possible to get a (conn == NULL) if we got an accept error */
 198:./lwip-2.1.2/src/api/api_lib.c ****   if (conn == NULL) {
 199:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_OK;
 200:./lwip-2.1.2/src/api/api_lib.c ****   }
 201:./lwip-2.1.2/src/api/api_lib.c **** 
 202:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_ALLOC(msg);
 203:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).conn = conn;
 204:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_SO_SNDTIMEO || LWIP_SO_LINGER
 205:./lwip-2.1.2/src/api/api_lib.c ****   /* get the time we started, which is later compared to
 206:./lwip-2.1.2/src/api/api_lib.c ****      sys_now() + conn->send_timeout */
 207:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).msg.sd.time_started = sys_now();
 208:./lwip-2.1.2/src/api/api_lib.c **** #else /* LWIP_SO_SNDTIMEO || LWIP_SO_LINGER */
 209:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_TCP
 210:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).msg.sd.polls_left =
 211:./lwip-2.1.2/src/api/api_lib.c ****     ((LWIP_TCP_CLOSE_TIMEOUT_MS_DEFAULT + TCP_SLOW_INTERVAL - 1) / TCP_SLOW_INTERVAL) + 1;
 212:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_TCP */
 213:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_SO_SNDTIMEO || LWIP_SO_LINGER */
 214:./lwip-2.1.2/src/api/api_lib.c ****   err = netconn_apimsg(lwip_netconn_do_delconn, &API_MSG_VAR_REF(msg));
 215:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_FREE(msg);
 216:./lwip-2.1.2/src/api/api_lib.c **** 
 217:./lwip-2.1.2/src/api/api_lib.c ****   if (err != ERR_OK) {
 218:./lwip-2.1.2/src/api/api_lib.c ****     return err;
 219:./lwip-2.1.2/src/api/api_lib.c ****   }
 220:./lwip-2.1.2/src/api/api_lib.c ****   return ERR_OK;
 221:./lwip-2.1.2/src/api/api_lib.c **** }
 222:./lwip-2.1.2/src/api/api_lib.c **** 
 223:./lwip-2.1.2/src/api/api_lib.c **** /**
 224:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_common
 225:./lwip-2.1.2/src/api/api_lib.c ****  * Close a netconn 'connection' and free its resources.
 226:./lwip-2.1.2/src/api/api_lib.c ****  * UDP and RAW connection are completely closed, TCP pcbs might still be in a waitstate
 227:./lwip-2.1.2/src/api/api_lib.c ****  * after this returns.
 228:./lwip-2.1.2/src/api/api_lib.c ****  *
 229:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the netconn to delete
 230:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if the connection was deleted
 231:./lwip-2.1.2/src/api/api_lib.c ****  */
 232:./lwip-2.1.2/src/api/api_lib.c **** err_t
 233:./lwip-2.1.2/src/api/api_lib.c **** netconn_delete(struct netconn *conn)
 234:./lwip-2.1.2/src/api/api_lib.c **** {
 235:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 236:./lwip-2.1.2/src/api/api_lib.c **** 
 237:./lwip-2.1.2/src/api/api_lib.c ****   /* No ASSERT here because possible to get a (conn == NULL) if we got an accept error */
 238:./lwip-2.1.2/src/api/api_lib.c ****   if (conn == NULL) {
 239:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_OK;
 240:./lwip-2.1.2/src/api/api_lib.c ****   }
 241:./lwip-2.1.2/src/api/api_lib.c **** 
 242:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_NETCONN_FULLDUPLEX
 243:./lwip-2.1.2/src/api/api_lib.c ****   if (conn->flags & NETCONN_FLAG_MBOXINVALID) {
 244:./lwip-2.1.2/src/api/api_lib.c ****     /* Already called netconn_prepare_delete() before */
 245:./lwip-2.1.2/src/api/api_lib.c ****     err = ERR_OK;
 246:./lwip-2.1.2/src/api/api_lib.c ****   } else
 247:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 248:./lwip-2.1.2/src/api/api_lib.c ****   {
 249:./lwip-2.1.2/src/api/api_lib.c ****     err = netconn_prepare_delete(conn);
 250:./lwip-2.1.2/src/api/api_lib.c ****   }
 251:./lwip-2.1.2/src/api/api_lib.c ****   if (err == ERR_OK) {
 252:./lwip-2.1.2/src/api/api_lib.c ****     netconn_free(conn);
 253:./lwip-2.1.2/src/api/api_lib.c ****   }
 254:./lwip-2.1.2/src/api/api_lib.c ****   return err;
 255:./lwip-2.1.2/src/api/api_lib.c **** }
 256:./lwip-2.1.2/src/api/api_lib.c **** 
 257:./lwip-2.1.2/src/api/api_lib.c **** /**
 258:./lwip-2.1.2/src/api/api_lib.c ****  * Get the local or remote IP address and port of a netconn.
 259:./lwip-2.1.2/src/api/api_lib.c ****  * For RAW netconns, this returns the protocol instead of a port!
 260:./lwip-2.1.2/src/api/api_lib.c ****  *
 261:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the netconn to query
 262:./lwip-2.1.2/src/api/api_lib.c ****  * @param addr a pointer to which to save the IP address
 263:./lwip-2.1.2/src/api/api_lib.c ****  * @param port a pointer to which to save the port (or protocol for RAW)
 264:./lwip-2.1.2/src/api/api_lib.c ****  * @param local 1 to get the local IP address, 0 to get the remote one
 265:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_CONN for invalid connections
 266:./lwip-2.1.2/src/api/api_lib.c ****  *         ERR_OK if the information was retrieved
 267:./lwip-2.1.2/src/api/api_lib.c ****  */
 268:./lwip-2.1.2/src/api/api_lib.c **** err_t
 269:./lwip-2.1.2/src/api/api_lib.c **** netconn_getaddr(struct netconn *conn, ip_addr_t *addr, u16_t *port, u8_t local)
 270:./lwip-2.1.2/src/api/api_lib.c **** {
 271:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
 272:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 273:./lwip-2.1.2/src/api/api_lib.c **** 
 274:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_getaddr: invalid conn", (conn != NULL), return ERR_ARG;);
 275:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_getaddr: invalid addr", (addr != NULL), return ERR_ARG;);
 276:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_getaddr: invalid port", (port != NULL), return ERR_ARG;);
 277:./lwip-2.1.2/src/api/api_lib.c **** 
 278:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_ALLOC(msg);
 279:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).conn = conn;
 280:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).msg.ad.local = local;
 281:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_MPU_COMPATIBLE
 282:./lwip-2.1.2/src/api/api_lib.c ****   err = netconn_apimsg(lwip_netconn_do_getaddr, &API_MSG_VAR_REF(msg));
 283:./lwip-2.1.2/src/api/api_lib.c ****   *addr = msg->msg.ad.ipaddr;
 284:./lwip-2.1.2/src/api/api_lib.c ****   *port = msg->msg.ad.port;
 285:./lwip-2.1.2/src/api/api_lib.c **** #else /* LWIP_MPU_COMPATIBLE */
 286:./lwip-2.1.2/src/api/api_lib.c ****   msg.msg.ad.ipaddr = addr;
 287:./lwip-2.1.2/src/api/api_lib.c ****   msg.msg.ad.port = port;
 288:./lwip-2.1.2/src/api/api_lib.c ****   err = netconn_apimsg(lwip_netconn_do_getaddr, &msg);
 289:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_MPU_COMPATIBLE */
 290:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_FREE(msg);
 291:./lwip-2.1.2/src/api/api_lib.c **** 
 292:./lwip-2.1.2/src/api/api_lib.c ****   return err;
 293:./lwip-2.1.2/src/api/api_lib.c **** }
 294:./lwip-2.1.2/src/api/api_lib.c **** 
 295:./lwip-2.1.2/src/api/api_lib.c **** /**
 296:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_common
 297:./lwip-2.1.2/src/api/api_lib.c ****  * Bind a netconn to a specific local IP address and port.
 298:./lwip-2.1.2/src/api/api_lib.c ****  * Binding one netconn twice might not always be checked correctly!
 299:./lwip-2.1.2/src/api/api_lib.c ****  *
 300:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the netconn to bind
 301:./lwip-2.1.2/src/api/api_lib.c ****  * @param addr the local IP address to bind the netconn to
 302:./lwip-2.1.2/src/api/api_lib.c ****  *             (use IP4_ADDR_ANY/IP6_ADDR_ANY to bind to all addresses)
 303:./lwip-2.1.2/src/api/api_lib.c ****  * @param port the local port to bind the netconn to (not used for RAW)
 304:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if bound, any other err_t on failure
 305:./lwip-2.1.2/src/api/api_lib.c ****  */
 306:./lwip-2.1.2/src/api/api_lib.c **** err_t
 307:./lwip-2.1.2/src/api/api_lib.c **** netconn_bind(struct netconn *conn, const ip_addr_t *addr, u16_t port)
 308:./lwip-2.1.2/src/api/api_lib.c **** {
 309:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
 310:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 311:./lwip-2.1.2/src/api/api_lib.c **** 
 312:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_bind: invalid conn", (conn != NULL), return ERR_ARG;);
 313:./lwip-2.1.2/src/api/api_lib.c **** 
 314:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_IPV4
 315:./lwip-2.1.2/src/api/api_lib.c ****   /* Don't propagate NULL pointer (IP_ADDR_ANY alias) to subsequent functions */
 316:./lwip-2.1.2/src/api/api_lib.c ****   if (addr == NULL) {
 317:./lwip-2.1.2/src/api/api_lib.c ****     addr = IP4_ADDR_ANY;
 318:./lwip-2.1.2/src/api/api_lib.c ****   }
 319:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_IPV4 */
 320:./lwip-2.1.2/src/api/api_lib.c **** 
 321:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_IPV4 && LWIP_IPV6
 322:./lwip-2.1.2/src/api/api_lib.c ****   /* "Socket API like" dual-stack support: If IP to bind to is IP6_ADDR_ANY,
 323:./lwip-2.1.2/src/api/api_lib.c ****    * and NETCONN_FLAG_IPV6_V6ONLY is 0, use IP_ANY_TYPE to bind
 324:./lwip-2.1.2/src/api/api_lib.c ****    */
 325:./lwip-2.1.2/src/api/api_lib.c ****   if ((netconn_get_ipv6only(conn) == 0) &&
 326:./lwip-2.1.2/src/api/api_lib.c ****       ip_addr_cmp(addr, IP6_ADDR_ANY)) {
 327:./lwip-2.1.2/src/api/api_lib.c ****     addr = IP_ANY_TYPE;
 328:./lwip-2.1.2/src/api/api_lib.c ****   }
 329:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_IPV4 && LWIP_IPV6 */
 330:./lwip-2.1.2/src/api/api_lib.c **** 
 331:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_ALLOC(msg);
 332:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).conn = conn;
 333:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).msg.bc.ipaddr = API_MSG_VAR_REF(addr);
 334:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).msg.bc.port = port;
 335:./lwip-2.1.2/src/api/api_lib.c ****   err = netconn_apimsg(lwip_netconn_do_bind, &API_MSG_VAR_REF(msg));
 336:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_FREE(msg);
 337:./lwip-2.1.2/src/api/api_lib.c **** 
 338:./lwip-2.1.2/src/api/api_lib.c ****   return err;
 339:./lwip-2.1.2/src/api/api_lib.c **** }
 340:./lwip-2.1.2/src/api/api_lib.c **** 
 341:./lwip-2.1.2/src/api/api_lib.c **** /**
 342:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_common
 343:./lwip-2.1.2/src/api/api_lib.c ****  * Bind a netconn to a specific interface and port.
 344:./lwip-2.1.2/src/api/api_lib.c ****  * Binding one netconn twice might not always be checked correctly!

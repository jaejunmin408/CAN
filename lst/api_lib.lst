 825:./lwip-2.1.2/src/api/api_lib.c ****              NETCONNTYPE_GROUP(netconn_type(conn)) != NETCONN_TCP, return ERR_ARG;);
 826:./lwip-2.1.2/src/api/api_lib.c **** 

 843:./lwip-2.1.2/src/api/api_lib.c **** {
 844:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_recv_udp_raw_netbuf: invalid conn", (conn != NULL) &&
 845:./lwip-2.1.2/src/api/api_lib.c ****              NETCONNTYPE_GROUP(netconn_type(conn)) != NETCONN_TCP, return ERR_ARG;);
 846:./lwip-2.1.2/src/api/api_lib.c **** 
 847:./lwip-2.1.2/src/api/api_lib.c ****   return netconn_recv_data(conn, (void **)new_buf, apiflags);
 848:./lwip-2.1.2/src/api/api_lib.c **** }
 849:./lwip-2.1.2/src/api/api_lib.c **** 
 850:./lwip-2.1.2/src/api/api_lib.c **** /**
 851:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_common
 852:./lwip-2.1.2/src/api/api_lib.c ****  * Receive data (in form of a netbuf containing a packet buffer) from a netconn
 853:./lwip-2.1.2/src/api/api_lib.c ****  *
 854:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the netconn from which to receive data
 855:./lwip-2.1.2/src/api/api_lib.c ****  * @param new_buf pointer where a new netbuf is stored when received data
 856:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if data has been received, an error code otherwise (timeout,
 857:./lwip-2.1.2/src/api/api_lib.c ****  *                memory error or another error)
 858:./lwip-2.1.2/src/api/api_lib.c ****  */
 859:./lwip-2.1.2/src/api/api_lib.c **** err_t
 860:./lwip-2.1.2/src/api/api_lib.c **** netconn_recv(struct netconn *conn, struct netbuf **new_buf)
 861:./lwip-2.1.2/src/api/api_lib.c **** {
 862:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_TCP
 863:./lwip-2.1.2/src/api/api_lib.c ****   struct netbuf *buf = NULL;
 864:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 865:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_TCP */
 866:./lwip-2.1.2/src/api/api_lib.c **** 
 867:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_recv: invalid pointer", (new_buf != NULL), return ERR_ARG;);
 868:./lwip-2.1.2/src/api/api_lib.c ****   *new_buf = NULL;
 869:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_recv: invalid conn",    (conn != NULL),    return ERR_ARG;);
 870:./lwip-2.1.2/src/api/api_lib.c **** 
 871:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_TCP
 872:./lwip-2.1.2/src/api/api_lib.c **** #if (LWIP_UDP || LWIP_RAW)
 873:./lwip-2.1.2/src/api/api_lib.c ****   if (NETCONNTYPE_GROUP(conn->type) == NETCONN_TCP)
 874:./lwip-2.1.2/src/api/api_lib.c **** #endif /* (LWIP_UDP || LWIP_RAW) */
 875:./lwip-2.1.2/src/api/api_lib.c ****   {
 876:./lwip-2.1.2/src/api/api_lib.c ****     struct pbuf *p = NULL;
 877:./lwip-2.1.2/src/api/api_lib.c ****     /* This is not a listening netconn, since recvmbox is set */
 878:./lwip-2.1.2/src/api/api_lib.c **** 
 879:./lwip-2.1.2/src/api/api_lib.c ****     buf = (struct netbuf *)memp_malloc(MEMP_NETBUF);
 880:./lwip-2.1.2/src/api/api_lib.c ****     if (buf == NULL) {
 881:./lwip-2.1.2/src/api/api_lib.c ****       return ERR_MEM;
 882:./lwip-2.1.2/src/api/api_lib.c ****     }
 883:./lwip-2.1.2/src/api/api_lib.c **** 
 884:./lwip-2.1.2/src/api/api_lib.c ****     err = netconn_recv_data_tcp(conn, &p, 0);
 885:./lwip-2.1.2/src/api/api_lib.c ****     if (err != ERR_OK) {
 886:./lwip-2.1.2/src/api/api_lib.c ****       memp_free(MEMP_NETBUF, buf);
 887:./lwip-2.1.2/src/api/api_lib.c ****       return err;
 888:./lwip-2.1.2/src/api/api_lib.c ****     }
 889:./lwip-2.1.2/src/api/api_lib.c ****     LWIP_ASSERT("p != NULL", p != NULL);
 890:./lwip-2.1.2/src/api/api_lib.c **** 
 891:./lwip-2.1.2/src/api/api_lib.c ****     buf->p = p;
 892:./lwip-2.1.2/src/api/api_lib.c ****     buf->ptr = p;
 893:./lwip-2.1.2/src/api/api_lib.c ****     buf->port = 0;
 894:./lwip-2.1.2/src/api/api_lib.c ****     ip_addr_set_zero(&buf->addr);
 895:./lwip-2.1.2/src/api/api_lib.c ****     *new_buf = buf;
 896:./lwip-2.1.2/src/api/api_lib.c ****     /* don't set conn->last_err: it's only ERR_OK, anyway */
 897:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_OK;
 898:./lwip-2.1.2/src/api/api_lib.c ****   }
 899:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_TCP */
 900:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_TCP && (LWIP_UDP || LWIP_RAW)
 901:./lwip-2.1.2/src/api/api_lib.c ****   else
 902:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_TCP && (LWIP_UDP || LWIP_RAW) */
 903:./lwip-2.1.2/src/api/api_lib.c ****   {
 904:./lwip-2.1.2/src/api/api_lib.c **** #if (LWIP_UDP || LWIP_RAW)
 905:./lwip-2.1.2/src/api/api_lib.c ****     return netconn_recv_data(conn, (void **)new_buf, 0);
 906:./lwip-2.1.2/src/api/api_lib.c **** #endif /* (LWIP_UDP || LWIP_RAW) */
 907:./lwip-2.1.2/src/api/api_lib.c ****   }
 908:./lwip-2.1.2/src/api/api_lib.c **** }
 909:./lwip-2.1.2/src/api/api_lib.c **** 
 910:./lwip-2.1.2/src/api/api_lib.c **** /**
 911:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_udp
 912:./lwip-2.1.2/src/api/api_lib.c ****  * Send data (in form of a netbuf) to a specific remote IP address and port.
 913:./lwip-2.1.2/src/api/api_lib.c ****  * Only to be used for UDP and RAW netconns (not TCP).
 914:./lwip-2.1.2/src/api/api_lib.c ****  *
 915:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the netconn over which to send data
 916:./lwip-2.1.2/src/api/api_lib.c ****  * @param buf a netbuf containing the data to send
 917:./lwip-2.1.2/src/api/api_lib.c ****  * @param addr the remote IP address to which to send the data
 918:./lwip-2.1.2/src/api/api_lib.c ****  * @param port the remote port to which to send the data
 919:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if data was sent, any other err_t on error
 920:./lwip-2.1.2/src/api/api_lib.c ****  */
 921:./lwip-2.1.2/src/api/api_lib.c **** err_t
 922:./lwip-2.1.2/src/api/api_lib.c **** netconn_sendto(struct netconn *conn, struct netbuf *buf, const ip_addr_t *addr, u16_t port)
 923:./lwip-2.1.2/src/api/api_lib.c **** {
 924:./lwip-2.1.2/src/api/api_lib.c ****   if (buf != NULL) {
 925:./lwip-2.1.2/src/api/api_lib.c ****     ip_addr_set(&buf->addr, addr);
 926:./lwip-2.1.2/src/api/api_lib.c ****     buf->port = port;
 927:./lwip-2.1.2/src/api/api_lib.c ****     return netconn_send(conn, buf);
 928:./lwip-2.1.2/src/api/api_lib.c ****   }
 929:./lwip-2.1.2/src/api/api_lib.c ****   return ERR_VAL;
 930:./lwip-2.1.2/src/api/api_lib.c **** }
 931:./lwip-2.1.2/src/api/api_lib.c **** 
 932:./lwip-2.1.2/src/api/api_lib.c **** /**
 933:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_udp
 934:./lwip-2.1.2/src/api/api_lib.c ****  * Send data over a UDP or RAW netconn (that is already connected).
 935:./lwip-2.1.2/src/api/api_lib.c ****  *
 936:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the UDP or RAW netconn over which to send data
 937:./lwip-2.1.2/src/api/api_lib.c ****  * @param buf a netbuf containing the data to send
 938:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if data was sent, any other err_t on error
 939:./lwip-2.1.2/src/api/api_lib.c ****  */
 940:./lwip-2.1.2/src/api/api_lib.c **** err_t
 941:./lwip-2.1.2/src/api/api_lib.c **** netconn_send(struct netconn *conn, struct netbuf *buf)
 942:./lwip-2.1.2/src/api/api_lib.c **** {
 943:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
 944:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
 945:./lwip-2.1.2/src/api/api_lib.c **** 
 946:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_send: invalid conn",  (conn != NULL), return ERR_ARG;);
 947:./lwip-2.1.2/src/api/api_lib.c **** 
 948:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_DEBUGF(API_LIB_DEBUG, ("netconn_send: sending %"U16_F" bytes\n", buf->p->tot_len));
 949:./lwip-2.1.2/src/api/api_lib.c **** 
 950:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_ALLOC(msg);
 951:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).conn = conn;
 952:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_REF(msg).msg.b = buf;
 953:./lwip-2.1.2/src/api/api_lib.c ****   err = netconn_apimsg(lwip_netconn_do_send, &API_MSG_VAR_REF(msg));
 954:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_FREE(msg);
 955:./lwip-2.1.2/src/api/api_lib.c **** 
 956:./lwip-2.1.2/src/api/api_lib.c ****   return err;
 957:./lwip-2.1.2/src/api/api_lib.c **** }
 958:./lwip-2.1.2/src/api/api_lib.c **** 
 959:./lwip-2.1.2/src/api/api_lib.c **** /**
 960:./lwip-2.1.2/src/api/api_lib.c ****  * @ingroup netconn_tcp
 961:./lwip-2.1.2/src/api/api_lib.c ****  * Send data over a TCP netconn.
 962:./lwip-2.1.2/src/api/api_lib.c ****  *
 963:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the TCP netconn over which to send data
 964:./lwip-2.1.2/src/api/api_lib.c ****  * @param dataptr pointer to the application buffer that contains the data to send
 965:./lwip-2.1.2/src/api/api_lib.c ****  * @param size size of the application data to send
 966:./lwip-2.1.2/src/api/api_lib.c ****  * @param apiflags combination of following flags :
 967:./lwip-2.1.2/src/api/api_lib.c ****  * - NETCONN_COPY: data will be copied into memory belonging to the stack
 968:./lwip-2.1.2/src/api/api_lib.c ****  * - NETCONN_MORE: for TCP connection, PSH flag will be set on last segment sent
 969:./lwip-2.1.2/src/api/api_lib.c ****  * - NETCONN_DONTBLOCK: only write the data if all data can be written at once
 970:./lwip-2.1.2/src/api/api_lib.c ****  * @param bytes_written pointer to a location that receives the number of written bytes
 971:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if data was sent, any other err_t on error
 972:./lwip-2.1.2/src/api/api_lib.c ****  */
 973:./lwip-2.1.2/src/api/api_lib.c **** err_t
 974:./lwip-2.1.2/src/api/api_lib.c **** netconn_write_partly(struct netconn *conn, const void *dataptr, size_t size,
 975:./lwip-2.1.2/src/api/api_lib.c ****                      u8_t apiflags, size_t *bytes_written)
 976:./lwip-2.1.2/src/api/api_lib.c **** {
 977:./lwip-2.1.2/src/api/api_lib.c ****   struct netvector vector;
 978:./lwip-2.1.2/src/api/api_lib.c ****   vector.ptr = dataptr;
 979:./lwip-2.1.2/src/api/api_lib.c ****   vector.len = size;
 980:./lwip-2.1.2/src/api/api_lib.c ****   return netconn_write_vectors_partly(conn, &vector, 1, apiflags, bytes_written);
 981:./lwip-2.1.2/src/api/api_lib.c **** }
 982:./lwip-2.1.2/src/api/api_lib.c **** 
 983:./lwip-2.1.2/src/api/api_lib.c **** /**
 984:./lwip-2.1.2/src/api/api_lib.c ****  * Send vectorized data atomically over a TCP netconn.
 985:./lwip-2.1.2/src/api/api_lib.c ****  *
 986:./lwip-2.1.2/src/api/api_lib.c ****  * @param conn the TCP netconn over which to send data
 987:./lwip-2.1.2/src/api/api_lib.c ****  * @param vectors array of vectors containing data to send
 988:./lwip-2.1.2/src/api/api_lib.c ****  * @param vectorcnt number of vectors in the array
 989:./lwip-2.1.2/src/api/api_lib.c ****  * @param apiflags combination of following flags :
 990:./lwip-2.1.2/src/api/api_lib.c ****  * - NETCONN_COPY: data will be copied into memory belonging to the stack
 991:./lwip-2.1.2/src/api/api_lib.c ****  * - NETCONN_MORE: for TCP connection, PSH flag will be set on last segment sent
 992:./lwip-2.1.2/src/api/api_lib.c ****  * - NETCONN_DONTBLOCK: only write the data if all data can be written at once
 993:./lwip-2.1.2/src/api/api_lib.c ****  * @param bytes_written pointer to a location that receives the number of written bytes
 994:./lwip-2.1.2/src/api/api_lib.c ****  * @return ERR_OK if data was sent, any other err_t on error
 995:./lwip-2.1.2/src/api/api_lib.c ****  */
 996:./lwip-2.1.2/src/api/api_lib.c **** err_t
 997:./lwip-2.1.2/src/api/api_lib.c **** netconn_write_vectors_partly(struct netconn *conn, struct netvector *vectors, u16_t vectorcnt,
 998:./lwip-2.1.2/src/api/api_lib.c ****                              u8_t apiflags, size_t *bytes_written)
 999:./lwip-2.1.2/src/api/api_lib.c **** {
1000:./lwip-2.1.2/src/api/api_lib.c ****   API_MSG_VAR_DECLARE(msg);
1001:./lwip-2.1.2/src/api/api_lib.c ****   err_t err;
1002:./lwip-2.1.2/src/api/api_lib.c ****   u8_t dontblock;
1003:./lwip-2.1.2/src/api/api_lib.c ****   size_t size;
1004:./lwip-2.1.2/src/api/api_lib.c ****   int i;
1005:./lwip-2.1.2/src/api/api_lib.c **** 
1006:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_write: invalid conn",  (conn != NULL), return ERR_ARG;);
1007:./lwip-2.1.2/src/api/api_lib.c ****   LWIP_ERROR("netconn_write: invalid conn->type",  (NETCONNTYPE_GROUP(conn->type) == NETCONN_TCP), 
1008:./lwip-2.1.2/src/api/api_lib.c ****   dontblock = netconn_is_nonblocking(conn) || (apiflags & NETCONN_DONTBLOCK);
1009:./lwip-2.1.2/src/api/api_lib.c **** #if LWIP_SO_SNDTIMEO
1010:./lwip-2.1.2/src/api/api_lib.c ****   if (conn->send_timeout != 0) {
1011:./lwip-2.1.2/src/api/api_lib.c ****     dontblock = 1;
1012:./lwip-2.1.2/src/api/api_lib.c ****   }
1013:./lwip-2.1.2/src/api/api_lib.c **** #endif /* LWIP_SO_SNDTIMEO */
1014:./lwip-2.1.2/src/api/api_lib.c ****   if (dontblock && !bytes_written) {
1015:./lwip-2.1.2/src/api/api_lib.c ****     /* This implies netconn_write() cannot be used for non-blocking send, since
1016:./lwip-2.1.2/src/api/api_lib.c ****        it has no way to return the number of bytes written. */
1017:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_VAL;
1018:./lwip-2.1.2/src/api/api_lib.c ****   }
1019:./lwip-2.1.2/src/api/api_lib.c **** 
1020:./lwip-2.1.2/src/api/api_lib.c ****   /* sum up the total size */
1021:./lwip-2.1.2/src/api/api_lib.c ****   size = 0;
1022:./lwip-2.1.2/src/api/api_lib.c ****   for (i = 0; i < vectorcnt; i++) {
1023:./lwip-2.1.2/src/api/api_lib.c ****     size += vectors[i].len;
1024:./lwip-2.1.2/src/api/api_lib.c ****     if (size < vectors[i].len) {
1025:./lwip-2.1.2/src/api/api_lib.c ****       /* overflow */
1026:./lwip-2.1.2/src/api/api_lib.c ****       return ERR_VAL;
1027:./lwip-2.1.2/src/api/api_lib.c ****     }
1028:./lwip-2.1.2/src/api/api_lib.c ****   }
1029:./lwip-2.1.2/src/api/api_lib.c ****   if (size == 0) {
1030:./lwip-2.1.2/src/api/api_lib.c ****     return ERR_OK;
1031:./lwip-2.1.2/src/api/api_lib.c ****   } else if (size > SSIZE_MAX) {
1032:./lwip-2.1.2/src/api/api_lib.c ****     ssize_t limited;
1033:./lwip-2.1.2/src/api/api_lib.c ****     /* this is required by the socket layer (cannot send full size_t range) */
1034:./lwip-2.1.2/src/api/api_lib.c ****     if (!bytes_written) {
1035:./lwip-2.1.2/src/api/api_lib.c ****       return ERR_VAL;
1036:./lwip-2.1.2/src/api/api_lib.c ****     }
1037:./lwip-2.1.2/src/api/api_lib.c ****     /* limit the amount of data to send */
1038:./lwip-2.1.2/src/api/api_lib.c ****     limited = SSIZE_MAX;
1039:./lwip-2.1.2/src/api/api_lib.c ****     size = (size_t)limited;
1040:./lwip-2.1.2/src/api/api_lib.c ****   }

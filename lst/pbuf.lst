 116:./lwip-2.1.2/src/core/pbuf.c **** /**
 117:./lwip-2.1.2/src/core/pbuf.c ****  * Attempt to reclaim some memory from queued out-of-sequence TCP segments
 118:./lwip-2.1.2/src/core/pbuf.c ****  * if we run out of pool pbufs. It's better to give priority to new packets
 119:./lwip-2.1.2/src/core/pbuf.c ****  * if we're running out.
 120:./lwip-2.1.2/src/core/pbuf.c ****  *
 121:./lwip-2.1.2/src/core/pbuf.c ****  * This must be done in the correct thread context therefore this function
 122:./lwip-2.1.2/src/core/pbuf.c ****  * can only be used with NO_SYS=0 and through tcpip_callback.
 123:./lwip-2.1.2/src/core/pbuf.c ****  */
 124:./lwip-2.1.2/src/core/pbuf.c **** #if !NO_SYS
 125:./lwip-2.1.2/src/core/pbuf.c **** static
 126:./lwip-2.1.2/src/core/pbuf.c **** #endif /* !NO_SYS */
 127:./lwip-2.1.2/src/core/pbuf.c **** void
 128:./lwip-2.1.2/src/core/pbuf.c **** pbuf_free_ooseq(void)
 129:./lwip-2.1.2/src/core/pbuf.c **** {
 130:./lwip-2.1.2/src/core/pbuf.c ****   struct tcp_pcb *pcb;
 131:./lwip-2.1.2/src/core/pbuf.c ****   SYS_ARCH_SET(pbuf_free_ooseq_pending, 0);
 132:./lwip-2.1.2/src/core/pbuf.c **** 
 133:./lwip-2.1.2/src/core/pbuf.c ****   for (pcb = tcp_active_pcbs; NULL != pcb; pcb = pcb->next) {
 134:./lwip-2.1.2/src/core/pbuf.c ****     if (pcb->ooseq != NULL) {
 135:./lwip-2.1.2/src/core/pbuf.c ****       /** Free the ooseq pbufs of one PCB only */
 136:./lwip-2.1.2/src/core/pbuf.c ****       LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_free_ooseq: freeing out-of-sequence pbufs\n")
 137:./lwip-2.1.2/src/core/pbuf.c ****       tcp_free_ooseq(pcb);
 138:./lwip-2.1.2/src/core/pbuf.c ****       return;
 139:./lwip-2.1.2/src/core/pbuf.c ****     }
 140:./lwip-2.1.2/src/core/pbuf.c ****   }
 141:./lwip-2.1.2/src/core/pbuf.c **** }
 142:./lwip-2.1.2/src/core/pbuf.c **** 
 143:./lwip-2.1.2/src/core/pbuf.c **** #if !NO_SYS
 144:./lwip-2.1.2/src/core/pbuf.c **** /**
 145:./lwip-2.1.2/src/core/pbuf.c ****  * Just a callback function for tcpip_callback() that calls pbuf_free_ooseq().
 146:./lwip-2.1.2/src/core/pbuf.c ****  */
 147:./lwip-2.1.2/src/core/pbuf.c **** static void
 148:./lwip-2.1.2/src/core/pbuf.c **** pbuf_free_ooseq_callback(void *arg)

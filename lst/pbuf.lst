 191:./lwip-2.1.2/src/core/pbuf.c **** /**
 192:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 193:./lwip-2.1.2/src/core/pbuf.c ****  * Allocates a pbuf of the given type (possibly a chain for PBUF_POOL type).
 194:./lwip-2.1.2/src/core/pbuf.c ****  *
 195:./lwip-2.1.2/src/core/pbuf.c ****  * The actual memory allocated for the pbuf is determined by the
 196:./lwip-2.1.2/src/core/pbuf.c ****  * layer at which the pbuf is allocated and the requested size
 197:./lwip-2.1.2/src/core/pbuf.c ****  * (from the size parameter).
 198:./lwip-2.1.2/src/core/pbuf.c ****  *
 199:./lwip-2.1.2/src/core/pbuf.c ****  * @param layer header size
 200:./lwip-2.1.2/src/core/pbuf.c ****  * @param length size of the pbuf's payload
 201:./lwip-2.1.2/src/core/pbuf.c ****  * @param type this parameter decides how and where the pbuf
 202:./lwip-2.1.2/src/core/pbuf.c ****  * should be allocated as follows:
 203:./lwip-2.1.2/src/core/pbuf.c ****  *
 204:./lwip-2.1.2/src/core/pbuf.c ****  * - PBUF_RAM: buffer memory for pbuf is allocated as one large
 205:./lwip-2.1.2/src/core/pbuf.c ****  *             chunk. This includes protocol headers as well.
 206:./lwip-2.1.2/src/core/pbuf.c ****  * - PBUF_ROM: no buffer memory is allocated for the pbuf, even for
 207:./lwip-2.1.2/src/core/pbuf.c ****  *             protocol headers. Additional headers must be prepended
 208:./lwip-2.1.2/src/core/pbuf.c ****  *             by allocating another pbuf and chain in to the front of
 209:./lwip-2.1.2/src/core/pbuf.c ****  *             the ROM pbuf. It is assumed that the memory used is really
 210:./lwip-2.1.2/src/core/pbuf.c ****  *             similar to ROM in that it is immutable and will not be
 211:./lwip-2.1.2/src/core/pbuf.c ****  *             changed. Memory which is dynamic should generally not
 212:./lwip-2.1.2/src/core/pbuf.c ****  *             be attached to PBUF_ROM pbufs. Use PBUF_REF instead.
 213:./lwip-2.1.2/src/core/pbuf.c ****  * - PBUF_REF: no buffer memory is allocated for the pbuf, even for
 214:./lwip-2.1.2/src/core/pbuf.c ****  *             protocol headers. It is assumed that the pbuf is only
 215:./lwip-2.1.2/src/core/pbuf.c ****  *             being used in a single thread. If the pbuf gets queued,
 216:./lwip-2.1.2/src/core/pbuf.c ****  *             then pbuf_take should be called to copy the buffer.
 217:./lwip-2.1.2/src/core/pbuf.c ****  * - PBUF_POOL: the pbuf is allocated as a pbuf chain, with pbufs from
 218:./lwip-2.1.2/src/core/pbuf.c ****  *              the pbuf pool that is allocated during pbuf_init().
 219:./lwip-2.1.2/src/core/pbuf.c ****  *
 220:./lwip-2.1.2/src/core/pbuf.c ****  * @return the allocated pbuf. If multiple pbufs where allocated, this
 221:./lwip-2.1.2/src/core/pbuf.c ****  * is the first pbuf of a pbuf chain.
 222:./lwip-2.1.2/src/core/pbuf.c ****  */
 223:./lwip-2.1.2/src/core/pbuf.c **** struct pbuf *
 224:./lwip-2.1.2/src/core/pbuf.c **** pbuf_alloc(pbuf_layer layer, u16_t length, pbuf_type type)
 225:./lwip-2.1.2/src/core/pbuf.c **** {
 226:./lwip-2.1.2/src/core/pbuf.c ****   struct pbuf *p;
 227:./lwip-2.1.2/src/core/pbuf.c ****   u16_t offset = (u16_t)layer;
 228:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_alloc(length=%"U16_F")\n", length));
 229:./lwip-2.1.2/src/core/pbuf.c **** 
 230:./lwip-2.1.2/src/core/pbuf.c ****   switch (type) {
 231:./lwip-2.1.2/src/core/pbuf.c ****     case PBUF_REF: /* fall through */
 232:./lwip-2.1.2/src/core/pbuf.c ****     case PBUF_ROM:
 233:./lwip-2.1.2/src/core/pbuf.c ****       p = pbuf_alloc_reference(NULL, length, type);
 234:./lwip-2.1.2/src/core/pbuf.c ****       break;
 235:./lwip-2.1.2/src/core/pbuf.c ****     case PBUF_POOL: {
 236:./lwip-2.1.2/src/core/pbuf.c ****       struct pbuf *q, *last;
 237:./lwip-2.1.2/src/core/pbuf.c ****       u16_t rem_len; /* remaining length */
 238:./lwip-2.1.2/src/core/pbuf.c ****       p = NULL;
 239:./lwip-2.1.2/src/core/pbuf.c ****       last = NULL;
 240:./lwip-2.1.2/src/core/pbuf.c ****       rem_len = length;
 241:./lwip-2.1.2/src/core/pbuf.c ****       do {
 242:./lwip-2.1.2/src/core/pbuf.c ****         u16_t qlen;
 243:./lwip-2.1.2/src/core/pbuf.c ****         q = (struct pbuf *)memp_malloc(MEMP_PBUF_POOL);
 244:./lwip-2.1.2/src/core/pbuf.c ****         if (q == NULL) {
 245:./lwip-2.1.2/src/core/pbuf.c ****           PBUF_POOL_IS_EMPTY();
 246:./lwip-2.1.2/src/core/pbuf.c ****           /* free chain so far allocated */
 247:./lwip-2.1.2/src/core/pbuf.c ****           if (p) {
 248:./lwip-2.1.2/src/core/pbuf.c ****             pbuf_free(p);
 249:./lwip-2.1.2/src/core/pbuf.c ****           }
 250:./lwip-2.1.2/src/core/pbuf.c ****           /* bail out unsuccessfully */
 251:./lwip-2.1.2/src/core/pbuf.c ****           return NULL;
 252:./lwip-2.1.2/src/core/pbuf.c ****         }
 253:./lwip-2.1.2/src/core/pbuf.c ****         qlen = LWIP_MIN(rem_len, (u16_t)(PBUF_POOL_BUFSIZE_ALIGNED - LWIP_MEM_ALIGN_SIZE(offset)));
 254:./lwip-2.1.2/src/core/pbuf.c ****         pbuf_init_alloced_pbuf(q, LWIP_MEM_ALIGN((void *)((u8_t *)q + SIZEOF_STRUCT_PBUF + offset))
 255:./lwip-2.1.2/src/core/pbuf.c ****                                rem_len, qlen, type, 0);
 256:./lwip-2.1.2/src/core/pbuf.c ****         LWIP_ASSERT("pbuf_alloc: pbuf q->payload properly aligned",
 257:./lwip-2.1.2/src/core/pbuf.c ****                     ((mem_ptr_t)q->payload % MEM_ALIGNMENT) == 0);
 258:./lwip-2.1.2/src/core/pbuf.c ****         LWIP_ASSERT("PBUF_POOL_BUFSIZE must be bigger than MEM_ALIGNMENT",
 259:./lwip-2.1.2/src/core/pbuf.c ****                     (PBUF_POOL_BUFSIZE_ALIGNED - LWIP_MEM_ALIGN_SIZE(offset)) > 0 );
 260:./lwip-2.1.2/src/core/pbuf.c ****         if (p == NULL) {
 261:./lwip-2.1.2/src/core/pbuf.c ****           /* allocated head of pbuf chain (into p) */
 262:./lwip-2.1.2/src/core/pbuf.c ****           p = q;
 263:./lwip-2.1.2/src/core/pbuf.c ****         } else {
 264:./lwip-2.1.2/src/core/pbuf.c ****           /* make previous pbuf point to this pbuf */
 265:./lwip-2.1.2/src/core/pbuf.c ****           last->next = q;
 266:./lwip-2.1.2/src/core/pbuf.c ****         }
 267:./lwip-2.1.2/src/core/pbuf.c ****         last = q;
 268:./lwip-2.1.2/src/core/pbuf.c ****         rem_len = (u16_t)(rem_len - qlen);
 269:./lwip-2.1.2/src/core/pbuf.c ****         offset = 0;
 270:./lwip-2.1.2/src/core/pbuf.c ****       } while (rem_len > 0);
 271:./lwip-2.1.2/src/core/pbuf.c ****       break;
 272:./lwip-2.1.2/src/core/pbuf.c ****     }
 273:./lwip-2.1.2/src/core/pbuf.c ****     case PBUF_RAM: {
 274:./lwip-2.1.2/src/core/pbuf.c ****       u16_t payload_len = (u16_t)(LWIP_MEM_ALIGN_SIZE(offset) + LWIP_MEM_ALIGN_SIZE(length));
 275:./lwip-2.1.2/src/core/pbuf.c ****       mem_size_t alloc_len = (mem_size_t)(LWIP_MEM_ALIGN_SIZE(SIZEOF_STRUCT_PBUF) + payload_len);
 276:./lwip-2.1.2/src/core/pbuf.c **** 
 277:./lwip-2.1.2/src/core/pbuf.c ****       /* bug #50040: Check for integer overflow when calculating alloc_len */
 278:./lwip-2.1.2/src/core/pbuf.c ****       if ((payload_len < LWIP_MEM_ALIGN_SIZE(length)) ||
 279:./lwip-2.1.2/src/core/pbuf.c ****           (alloc_len < LWIP_MEM_ALIGN_SIZE(length))) {
 280:./lwip-2.1.2/src/core/pbuf.c ****         return NULL;
 281:./lwip-2.1.2/src/core/pbuf.c ****       }
 282:./lwip-2.1.2/src/core/pbuf.c **** 
 283:./lwip-2.1.2/src/core/pbuf.c ****       /* If pbuf is to be allocated in RAM, allocate memory for it. */
 284:./lwip-2.1.2/src/core/pbuf.c ****       p = (struct pbuf *)mem_malloc(alloc_len);
 285:./lwip-2.1.2/src/core/pbuf.c ****       if (p == NULL) {
 286:./lwip-2.1.2/src/core/pbuf.c ****         return NULL;
 287:./lwip-2.1.2/src/core/pbuf.c ****       }
 288:./lwip-2.1.2/src/core/pbuf.c ****       pbuf_init_alloced_pbuf(p, LWIP_MEM_ALIGN((void *)((u8_t *)p + SIZEOF_STRUCT_PBUF + offset)),
 289:./lwip-2.1.2/src/core/pbuf.c ****                              length, length, type, 0);
 290:./lwip-2.1.2/src/core/pbuf.c ****       LWIP_ASSERT("pbuf_alloc: pbuf->payload properly aligned",
 291:./lwip-2.1.2/src/core/pbuf.c ****                   ((mem_ptr_t)p->payload % MEM_ALIGNMENT) == 0);
 292:./lwip-2.1.2/src/core/pbuf.c ****       break;
 293:./lwip-2.1.2/src/core/pbuf.c ****     }
 294:./lwip-2.1.2/src/core/pbuf.c ****     default:
 295:./lwip-2.1.2/src/core/pbuf.c ****       LWIP_ASSERT("pbuf_alloc: erroneous type", 0);
 296:./lwip-2.1.2/src/core/pbuf.c ****       return NULL;
 297:./lwip-2.1.2/src/core/pbuf.c ****   }
 298:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_alloc(length=%"U16_F") == %p\n", length, (void *)
 299:./lwip-2.1.2/src/core/pbuf.c ****   return p;
 300:./lwip-2.1.2/src/core/pbuf.c **** }
 301:./lwip-2.1.2/src/core/pbuf.c **** 
 302:./lwip-2.1.2/src/core/pbuf.c **** /**
 303:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 304:./lwip-2.1.2/src/core/pbuf.c ****  * Allocates a pbuf for referenced data.
 305:./lwip-2.1.2/src/core/pbuf.c ****  * Referenced data can be volatile (PBUF_REF) or long-lived (PBUF_ROM).
 306:./lwip-2.1.2/src/core/pbuf.c ****  *
 307:./lwip-2.1.2/src/core/pbuf.c ****  * The actual memory allocated for the pbuf is determined by the
 308:./lwip-2.1.2/src/core/pbuf.c ****  * layer at which the pbuf is allocated and the requested size
 309:./lwip-2.1.2/src/core/pbuf.c ****  * (from the size parameter).
 310:./lwip-2.1.2/src/core/pbuf.c ****  *
 311:./lwip-2.1.2/src/core/pbuf.c ****  * @param payload referenced payload
 312:./lwip-2.1.2/src/core/pbuf.c ****  * @param length size of the pbuf's payload
 313:./lwip-2.1.2/src/core/pbuf.c ****  * @param type this parameter decides how and where the pbuf
 314:./lwip-2.1.2/src/core/pbuf.c ****  * should be allocated as follows:
 315:./lwip-2.1.2/src/core/pbuf.c ****  *
 316:./lwip-2.1.2/src/core/pbuf.c ****  * - PBUF_ROM: It is assumed that the memory used is really
 317:./lwip-2.1.2/src/core/pbuf.c ****  *             similar to ROM in that it is immutable and will not be
 318:./lwip-2.1.2/src/core/pbuf.c ****  *             changed. Memory which is dynamic should generally not
 319:./lwip-2.1.2/src/core/pbuf.c ****  *             be attached to PBUF_ROM pbufs. Use PBUF_REF instead.
 320:./lwip-2.1.2/src/core/pbuf.c ****  * - PBUF_REF: It is assumed that the pbuf is only
 321:./lwip-2.1.2/src/core/pbuf.c ****  *             being used in a single thread. If the pbuf gets queued,
 322:./lwip-2.1.2/src/core/pbuf.c ****  *             then pbuf_take should be called to copy the buffer.
 323:./lwip-2.1.2/src/core/pbuf.c ****  *
 324:./lwip-2.1.2/src/core/pbuf.c ****  * @return the allocated pbuf.
 325:./lwip-2.1.2/src/core/pbuf.c ****  */
 326:./lwip-2.1.2/src/core/pbuf.c **** struct pbuf *
 327:./lwip-2.1.2/src/core/pbuf.c **** pbuf_alloc_reference(void *payload, u16_t length, pbuf_type type)
 328:./lwip-2.1.2/src/core/pbuf.c **** {
 329:./lwip-2.1.2/src/core/pbuf.c ****   struct pbuf *p;
 330:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("invalid pbuf_type", (type == PBUF_REF) || (type == PBUF_ROM));
 331:./lwip-2.1.2/src/core/pbuf.c ****   /* only allocate memory for the pbuf structure */
 332:./lwip-2.1.2/src/core/pbuf.c ****   p = (struct pbuf *)memp_malloc(MEMP_PBUF);
 333:./lwip-2.1.2/src/core/pbuf.c ****   if (p == NULL) {
 334:./lwip-2.1.2/src/core/pbuf.c ****     LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_LEVEL_SERIOUS,
 335:./lwip-2.1.2/src/core/pbuf.c ****                 ("pbuf_alloc_reference: Could not allocate MEMP_PBUF for PBUF_%s.\n",
 336:./lwip-2.1.2/src/core/pbuf.c ****                  (type == PBUF_ROM) ? "ROM" : "REF"));
 337:./lwip-2.1.2/src/core/pbuf.c ****     return NULL;
 338:./lwip-2.1.2/src/core/pbuf.c ****   }
 339:./lwip-2.1.2/src/core/pbuf.c ****   pbuf_init_alloced_pbuf(p, payload, length, length, type, 0);
 340:./lwip-2.1.2/src/core/pbuf.c ****   return p;
 341:./lwip-2.1.2/src/core/pbuf.c **** }
 342:./lwip-2.1.2/src/core/pbuf.c **** 
 343:./lwip-2.1.2/src/core/pbuf.c **** 
 344:./lwip-2.1.2/src/core/pbuf.c **** #if LWIP_SUPPORT_CUSTOM_PBUF
 345:./lwip-2.1.2/src/core/pbuf.c **** /**
 346:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 347:./lwip-2.1.2/src/core/pbuf.c ****  * Initialize a custom pbuf (already allocated).
 348:./lwip-2.1.2/src/core/pbuf.c ****  * Example of custom pbuf usage: @ref zerocopyrx
 349:./lwip-2.1.2/src/core/pbuf.c ****  *
 350:./lwip-2.1.2/src/core/pbuf.c ****  * @param l header size
 351:./lwip-2.1.2/src/core/pbuf.c ****  * @param length size of the pbuf's payload
 352:./lwip-2.1.2/src/core/pbuf.c ****  * @param type type of the pbuf (only used to treat the pbuf accordingly, as
 353:./lwip-2.1.2/src/core/pbuf.c ****  *        this function allocates no memory)
 354:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pointer to the custom pbuf to initialize (already allocated)
 355:./lwip-2.1.2/src/core/pbuf.c ****  * @param payload_mem pointer to the buffer that is used for payload and headers,
 356:./lwip-2.1.2/src/core/pbuf.c ****  *        must be at least big enough to hold 'length' plus the header size,
 357:./lwip-2.1.2/src/core/pbuf.c ****  *        may be NULL if set later.
 358:./lwip-2.1.2/src/core/pbuf.c ****  *        ATTENTION: The caller is responsible for correct alignment of this buffer!!
 359:./lwip-2.1.2/src/core/pbuf.c ****  * @param payload_mem_len the size of the 'payload_mem' buffer, must be at least
 360:./lwip-2.1.2/src/core/pbuf.c ****  *        big enough to hold 'length' plus the header size
 361:./lwip-2.1.2/src/core/pbuf.c ****  */
 362:./lwip-2.1.2/src/core/pbuf.c **** struct pbuf *
 363:./lwip-2.1.2/src/core/pbuf.c **** pbuf_alloced_custom(pbuf_layer l, u16_t length, pbuf_type type, struct pbuf_custom *p,
 364:./lwip-2.1.2/src/core/pbuf.c ****                     void *payload_mem, u16_t payload_mem_len)
 365:./lwip-2.1.2/src/core/pbuf.c **** {
 366:./lwip-2.1.2/src/core/pbuf.c ****   u16_t offset = (u16_t)l;
 367:./lwip-2.1.2/src/core/pbuf.c ****   void *payload;
 368:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_alloced_custom(length=%"U16_F")\n", length));
 369:./lwip-2.1.2/src/core/pbuf.c **** 
 370:./lwip-2.1.2/src/core/pbuf.c ****   if (LWIP_MEM_ALIGN_SIZE(offset) + length > payload_mem_len) {
 371:./lwip-2.1.2/src/core/pbuf.c ****     LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_LEVEL_WARNING, ("pbuf_alloced_custom(length=%"U16_F") buffer 
 372:./lwip-2.1.2/src/core/pbuf.c ****     return NULL;
 373:./lwip-2.1.2/src/core/pbuf.c ****   }
 374:./lwip-2.1.2/src/core/pbuf.c **** 
 375:./lwip-2.1.2/src/core/pbuf.c ****   if (payload_mem != NULL) {
 376:./lwip-2.1.2/src/core/pbuf.c ****     payload = (u8_t *)payload_mem + LWIP_MEM_ALIGN_SIZE(offset);
 377:./lwip-2.1.2/src/core/pbuf.c ****   } else {
 378:./lwip-2.1.2/src/core/pbuf.c ****     payload = NULL;
 379:./lwip-2.1.2/src/core/pbuf.c ****   }
 380:./lwip-2.1.2/src/core/pbuf.c ****   pbuf_init_alloced_pbuf(&p->pbuf, payload, length, length, type, PBUF_FLAG_IS_CUSTOM);
 381:./lwip-2.1.2/src/core/pbuf.c ****   return &p->pbuf;
 382:./lwip-2.1.2/src/core/pbuf.c **** }
 383:./lwip-2.1.2/src/core/pbuf.c **** #endif /* LWIP_SUPPORT_CUSTOM_PBUF */
 384:./lwip-2.1.2/src/core/pbuf.c **** 
 385:./lwip-2.1.2/src/core/pbuf.c **** /**
 386:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 387:./lwip-2.1.2/src/core/pbuf.c ****  * Shrink a pbuf chain to a desired length.
 388:./lwip-2.1.2/src/core/pbuf.c ****  *
 389:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to shrink.
 390:./lwip-2.1.2/src/core/pbuf.c ****  * @param new_len desired new length of pbuf chain
 391:./lwip-2.1.2/src/core/pbuf.c ****  *
 392:./lwip-2.1.2/src/core/pbuf.c ****  * Depending on the desired length, the first few pbufs in a chain might
 393:./lwip-2.1.2/src/core/pbuf.c ****  * be skipped and left unchanged. The new last pbuf in the chain will be
 394:./lwip-2.1.2/src/core/pbuf.c ****  * resized, and any remaining pbufs will be freed.
 395:./lwip-2.1.2/src/core/pbuf.c ****  *
 396:./lwip-2.1.2/src/core/pbuf.c ****  * @note If the pbuf is ROM/REF, only the ->tot_len and ->len fields are adjusted.
 397:./lwip-2.1.2/src/core/pbuf.c ****  * @note May not be called on a packet queue.
 398:./lwip-2.1.2/src/core/pbuf.c ****  *
 399:./lwip-2.1.2/src/core/pbuf.c ****  * @note Despite its name, pbuf_realloc cannot grow the size of a pbuf (chain).
 400:./lwip-2.1.2/src/core/pbuf.c ****  */
 401:./lwip-2.1.2/src/core/pbuf.c **** void
 402:./lwip-2.1.2/src/core/pbuf.c **** pbuf_realloc(struct pbuf *p, u16_t new_len)
 403:./lwip-2.1.2/src/core/pbuf.c **** {
 404:./lwip-2.1.2/src/core/pbuf.c ****   struct pbuf *q;
 405:./lwip-2.1.2/src/core/pbuf.c ****   u16_t rem_len; /* remaining length */
 406:./lwip-2.1.2/src/core/pbuf.c ****   u16_t shrink;
 407:./lwip-2.1.2/src/core/pbuf.c **** 
 408:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("pbuf_realloc: p != NULL", p != NULL);
 409:./lwip-2.1.2/src/core/pbuf.c **** 
 410:./lwip-2.1.2/src/core/pbuf.c ****   /* desired length larger than current length? */
 411:./lwip-2.1.2/src/core/pbuf.c ****   if (new_len >= p->tot_len) {
 412:./lwip-2.1.2/src/core/pbuf.c ****     /* enlarging not yet supported */
 413:./lwip-2.1.2/src/core/pbuf.c ****     return;
 414:./lwip-2.1.2/src/core/pbuf.c ****   }
 415:./lwip-2.1.2/src/core/pbuf.c **** 
 416:./lwip-2.1.2/src/core/pbuf.c ****   /* the pbuf chain grows by (new_len - p->tot_len) bytes
 417:./lwip-2.1.2/src/core/pbuf.c ****    * (which may be negative in case of shrinking) */
 418:./lwip-2.1.2/src/core/pbuf.c ****   shrink = (u16_t)(p->tot_len - new_len);
 419:./lwip-2.1.2/src/core/pbuf.c **** 
 420:./lwip-2.1.2/src/core/pbuf.c ****   /* first, step over any pbufs that should remain in the chain */
 421:./lwip-2.1.2/src/core/pbuf.c ****   rem_len = new_len;
 422:./lwip-2.1.2/src/core/pbuf.c ****   q = p;
 423:./lwip-2.1.2/src/core/pbuf.c ****   /* should this pbuf be kept? */
 424:./lwip-2.1.2/src/core/pbuf.c ****   while (rem_len > q->len) {
 425:./lwip-2.1.2/src/core/pbuf.c ****     /* decrease remaining length by pbuf length */
 426:./lwip-2.1.2/src/core/pbuf.c ****     rem_len = (u16_t)(rem_len - q->len);
 427:./lwip-2.1.2/src/core/pbuf.c ****     /* decrease total length indicator */
 428:./lwip-2.1.2/src/core/pbuf.c ****     q->tot_len = (u16_t)(q->tot_len - shrink);
 429:./lwip-2.1.2/src/core/pbuf.c ****     /* proceed to next pbuf in chain */
 430:./lwip-2.1.2/src/core/pbuf.c ****     q = q->next;
 431:./lwip-2.1.2/src/core/pbuf.c ****     LWIP_ASSERT("pbuf_realloc: q != NULL", q != NULL);
 432:./lwip-2.1.2/src/core/pbuf.c ****   }
 433:./lwip-2.1.2/src/core/pbuf.c ****   /* we have now reached the new last pbuf (in q) */
 434:./lwip-2.1.2/src/core/pbuf.c ****   /* rem_len == desired length for pbuf q */
 435:./lwip-2.1.2/src/core/pbuf.c **** 
 436:./lwip-2.1.2/src/core/pbuf.c ****   /* shrink allocated memory for PBUF_RAM */
 437:./lwip-2.1.2/src/core/pbuf.c ****   /* (other types merely adjust their length fields */
 438:./lwip-2.1.2/src/core/pbuf.c ****   if (pbuf_match_allocsrc(q, PBUF_TYPE_ALLOC_SRC_MASK_STD_HEAP) && (rem_len != q->len)
 439:./lwip-2.1.2/src/core/pbuf.c **** #if LWIP_SUPPORT_CUSTOM_PBUF
 440:./lwip-2.1.2/src/core/pbuf.c ****       && ((q->flags & PBUF_FLAG_IS_CUSTOM) == 0)
 441:./lwip-2.1.2/src/core/pbuf.c **** #endif /* LWIP_SUPPORT_CUSTOM_PBUF */
 442:./lwip-2.1.2/src/core/pbuf.c ****      ) {
 443:./lwip-2.1.2/src/core/pbuf.c ****     /* reallocate and adjust the length of the pbuf that will be split */
 444:./lwip-2.1.2/src/core/pbuf.c ****     q = (struct pbuf *)mem_trim(q, (mem_size_t)(((u8_t *)q->payload - (u8_t *)q) + rem_len));
 445:./lwip-2.1.2/src/core/pbuf.c ****     LWIP_ASSERT("mem_trim returned q == NULL", q != NULL);
 446:./lwip-2.1.2/src/core/pbuf.c ****   }
 447:./lwip-2.1.2/src/core/pbuf.c ****   /* adjust length fields for new last pbuf */
 448:./lwip-2.1.2/src/core/pbuf.c ****   q->len = rem_len;
 449:./lwip-2.1.2/src/core/pbuf.c ****   q->tot_len = q->len;
 450:./lwip-2.1.2/src/core/pbuf.c **** 
 451:./lwip-2.1.2/src/core/pbuf.c ****   /* any remaining pbufs in chain? */
 452:./lwip-2.1.2/src/core/pbuf.c ****   if (q->next != NULL) {
 453:./lwip-2.1.2/src/core/pbuf.c ****     /* free remaining pbufs in chain */
 454:./lwip-2.1.2/src/core/pbuf.c ****     pbuf_free(q->next);
 455:./lwip-2.1.2/src/core/pbuf.c ****   }
 456:./lwip-2.1.2/src/core/pbuf.c ****   /* q is last packet in chain */
 457:./lwip-2.1.2/src/core/pbuf.c ****   q->next = NULL;
 458:./lwip-2.1.2/src/core/pbuf.c **** 
 459:./lwip-2.1.2/src/core/pbuf.c **** }
 460:./lwip-2.1.2/src/core/pbuf.c **** 
 461:./lwip-2.1.2/src/core/pbuf.c **** /**
 462:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the payload pointer to reveal headers in the payload.
 463:./lwip-2.1.2/src/core/pbuf.c ****  * @see pbuf_add_header.
 464:./lwip-2.1.2/src/core/pbuf.c ****  *
 465:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to change the header size.
 466:./lwip-2.1.2/src/core/pbuf.c ****  * @param header_size_increment Number of bytes to increment header size.
 467:./lwip-2.1.2/src/core/pbuf.c ****  * @param force Allow 'header_size_increment > 0' for PBUF_REF/PBUF_ROM types
 468:./lwip-2.1.2/src/core/pbuf.c ****  *
 469:./lwip-2.1.2/src/core/pbuf.c ****  * @return non-zero on failure, zero on success.
 470:./lwip-2.1.2/src/core/pbuf.c ****  *
 471:./lwip-2.1.2/src/core/pbuf.c ****  */
 472:./lwip-2.1.2/src/core/pbuf.c **** static u8_t
 473:./lwip-2.1.2/src/core/pbuf.c **** pbuf_add_header_impl(struct pbuf *p, size_t header_size_increment, u8_t force)
 474:./lwip-2.1.2/src/core/pbuf.c **** {
 475:./lwip-2.1.2/src/core/pbuf.c ****   u16_t type_internal;
 476:./lwip-2.1.2/src/core/pbuf.c ****   void *payload;
 477:./lwip-2.1.2/src/core/pbuf.c ****   u16_t increment_magnitude;
 478:./lwip-2.1.2/src/core/pbuf.c **** 
 479:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("p != NULL", p != NULL);
 480:./lwip-2.1.2/src/core/pbuf.c ****   if ((p == NULL) || (header_size_increment > 0xFFFF)) {
 481:./lwip-2.1.2/src/core/pbuf.c ****     return 1;
 482:./lwip-2.1.2/src/core/pbuf.c ****   }
 483:./lwip-2.1.2/src/core/pbuf.c ****   if (header_size_increment == 0) {
 484:./lwip-2.1.2/src/core/pbuf.c ****     return 0;
 485:./lwip-2.1.2/src/core/pbuf.c ****   }
 486:./lwip-2.1.2/src/core/pbuf.c **** 
 487:./lwip-2.1.2/src/core/pbuf.c ****   increment_magnitude = (u16_t)header_size_increment;
 488:./lwip-2.1.2/src/core/pbuf.c ****   /* Do not allow tot_len to wrap as a result. */
 489:./lwip-2.1.2/src/core/pbuf.c ****   if ((u16_t)(increment_magnitude + p->tot_len) < increment_magnitude) {
 490:./lwip-2.1.2/src/core/pbuf.c ****     return 1;
 491:./lwip-2.1.2/src/core/pbuf.c ****   }
 492:./lwip-2.1.2/src/core/pbuf.c **** 
 493:./lwip-2.1.2/src/core/pbuf.c ****   type_internal = p->type_internal;
 494:./lwip-2.1.2/src/core/pbuf.c **** 
 495:./lwip-2.1.2/src/core/pbuf.c ****   /* pbuf types containing payloads? */
 496:./lwip-2.1.2/src/core/pbuf.c ****   if (type_internal & PBUF_TYPE_FLAG_STRUCT_DATA_CONTIGUOUS) {
 497:./lwip-2.1.2/src/core/pbuf.c ****     /* set new payload pointer */
 498:./lwip-2.1.2/src/core/pbuf.c ****     payload = (u8_t *)p->payload - header_size_increment;
 499:./lwip-2.1.2/src/core/pbuf.c ****     /* boundary check fails? */
 500:./lwip-2.1.2/src/core/pbuf.c ****     if ((u8_t *)payload < (u8_t *)p + SIZEOF_STRUCT_PBUF) {
 501:./lwip-2.1.2/src/core/pbuf.c ****       LWIP_DEBUGF( PBUF_DEBUG | LWIP_DBG_TRACE,
 502:./lwip-2.1.2/src/core/pbuf.c ****                    ("pbuf_add_header: failed as %p < %p (not enough space for new header size)\n",
 503:./lwip-2.1.2/src/core/pbuf.c ****                     (void *)payload, (void *)((u8_t *)p + SIZEOF_STRUCT_PBUF)));
 504:./lwip-2.1.2/src/core/pbuf.c ****       /* bail out unsuccessfully */
 505:./lwip-2.1.2/src/core/pbuf.c ****       return 1;
 506:./lwip-2.1.2/src/core/pbuf.c ****     }
 507:./lwip-2.1.2/src/core/pbuf.c ****     /* pbuf types referring to external payloads? */
 508:./lwip-2.1.2/src/core/pbuf.c ****   } else {
 509:./lwip-2.1.2/src/core/pbuf.c ****     /* hide a header in the payload? */
 510:./lwip-2.1.2/src/core/pbuf.c ****     if (force) {
 511:./lwip-2.1.2/src/core/pbuf.c ****       payload = (u8_t *)p->payload - header_size_increment;
 512:./lwip-2.1.2/src/core/pbuf.c ****     } else {
 513:./lwip-2.1.2/src/core/pbuf.c ****       /* cannot expand payload to front (yet!)
 514:./lwip-2.1.2/src/core/pbuf.c ****        * bail out unsuccessfully */
 515:./lwip-2.1.2/src/core/pbuf.c ****       return 1;
 516:./lwip-2.1.2/src/core/pbuf.c ****     }
 517:./lwip-2.1.2/src/core/pbuf.c ****   }
 518:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_add_header: old %p new %p (%"U16_F")\n",
 519:./lwip-2.1.2/src/core/pbuf.c ****               (void *)p->payload, (void *)payload, increment_magnitude));
 520:./lwip-2.1.2/src/core/pbuf.c **** 
 521:./lwip-2.1.2/src/core/pbuf.c ****   /* modify pbuf fields */
 522:./lwip-2.1.2/src/core/pbuf.c ****   p->payload = payload;
 523:./lwip-2.1.2/src/core/pbuf.c ****   p->len = (u16_t)(p->len + increment_magnitude);
 524:./lwip-2.1.2/src/core/pbuf.c ****   p->tot_len = (u16_t)(p->tot_len + increment_magnitude);
 525:./lwip-2.1.2/src/core/pbuf.c **** 
 526:./lwip-2.1.2/src/core/pbuf.c **** 
 527:./lwip-2.1.2/src/core/pbuf.c ****   return 0;
 528:./lwip-2.1.2/src/core/pbuf.c **** }
 529:./lwip-2.1.2/src/core/pbuf.c **** 
 530:./lwip-2.1.2/src/core/pbuf.c **** /**
 531:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the payload pointer to reveal headers in the payload.
 532:./lwip-2.1.2/src/core/pbuf.c ****  *
 533:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the ->payload pointer so that space for a header
 534:./lwip-2.1.2/src/core/pbuf.c ****  * appears in the pbuf payload.
 535:./lwip-2.1.2/src/core/pbuf.c ****  *
 536:./lwip-2.1.2/src/core/pbuf.c ****  * The ->payload, ->tot_len and ->len fields are adjusted.
 537:./lwip-2.1.2/src/core/pbuf.c ****  *
 538:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to change the header size.
 539:./lwip-2.1.2/src/core/pbuf.c ****  * @param header_size_increment Number of bytes to increment header size which
 540:./lwip-2.1.2/src/core/pbuf.c ****  *          increases the size of the pbuf. New space is on the front.
 541:./lwip-2.1.2/src/core/pbuf.c ****  *          If header_size_increment is 0, this function does nothing and returns successful.
 542:./lwip-2.1.2/src/core/pbuf.c ****  *
 543:./lwip-2.1.2/src/core/pbuf.c ****  * PBUF_ROM and PBUF_REF type buffers cannot have their sizes increased, so
 544:./lwip-2.1.2/src/core/pbuf.c ****  * the call will fail. A check is made that the increase in header size does
 545:./lwip-2.1.2/src/core/pbuf.c ****  * not move the payload pointer in front of the start of the buffer.
 546:./lwip-2.1.2/src/core/pbuf.c ****  *
 547:./lwip-2.1.2/src/core/pbuf.c ****  * @return non-zero on failure, zero on success.
 548:./lwip-2.1.2/src/core/pbuf.c ****  *
 549:./lwip-2.1.2/src/core/pbuf.c ****  */
 550:./lwip-2.1.2/src/core/pbuf.c **** u8_t
 551:./lwip-2.1.2/src/core/pbuf.c **** pbuf_add_header(struct pbuf *p, size_t header_size_increment)
 552:./lwip-2.1.2/src/core/pbuf.c **** {
 553:./lwip-2.1.2/src/core/pbuf.c ****   return pbuf_add_header_impl(p, header_size_increment, 0);
 554:./lwip-2.1.2/src/core/pbuf.c **** }
 555:./lwip-2.1.2/src/core/pbuf.c **** 
 556:./lwip-2.1.2/src/core/pbuf.c **** /**
 557:./lwip-2.1.2/src/core/pbuf.c ****  * Same as @ref pbuf_add_header but does not check if 'header_size > 0' is allowed.
 558:./lwip-2.1.2/src/core/pbuf.c ****  * This is used internally only, to allow PBUF_REF for RX.
 559:./lwip-2.1.2/src/core/pbuf.c ****  */
 560:./lwip-2.1.2/src/core/pbuf.c **** u8_t
 561:./lwip-2.1.2/src/core/pbuf.c **** pbuf_add_header_force(struct pbuf *p, size_t header_size_increment)
 562:./lwip-2.1.2/src/core/pbuf.c **** {
 563:./lwip-2.1.2/src/core/pbuf.c ****   return pbuf_add_header_impl(p, header_size_increment, 1);
 564:./lwip-2.1.2/src/core/pbuf.c **** }
 565:./lwip-2.1.2/src/core/pbuf.c **** 
 566:./lwip-2.1.2/src/core/pbuf.c **** /**
 567:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the payload pointer to hide headers in the payload.
 568:./lwip-2.1.2/src/core/pbuf.c ****  *
 569:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the ->payload pointer so that space for a header
 570:./lwip-2.1.2/src/core/pbuf.c ****  * disappears in the pbuf payload.
 571:./lwip-2.1.2/src/core/pbuf.c ****  *
 572:./lwip-2.1.2/src/core/pbuf.c ****  * The ->payload, ->tot_len and ->len fields are adjusted.
 573:./lwip-2.1.2/src/core/pbuf.c ****  *
 574:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to change the header size.
 575:./lwip-2.1.2/src/core/pbuf.c ****  * @param header_size_decrement Number of bytes to decrement header size which
 576:./lwip-2.1.2/src/core/pbuf.c ****  *          decreases the size of the pbuf.
 577:./lwip-2.1.2/src/core/pbuf.c ****  *          If header_size_decrement is 0, this function does nothing and returns successful.
 578:./lwip-2.1.2/src/core/pbuf.c ****  * @return non-zero on failure, zero on success.
 579:./lwip-2.1.2/src/core/pbuf.c ****  *
 580:./lwip-2.1.2/src/core/pbuf.c ****  */
 581:./lwip-2.1.2/src/core/pbuf.c **** u8_t
 582:./lwip-2.1.2/src/core/pbuf.c **** pbuf_remove_header(struct pbuf *p, size_t header_size_decrement)
 583:./lwip-2.1.2/src/core/pbuf.c **** {
 584:./lwip-2.1.2/src/core/pbuf.c ****   void *payload;
 585:./lwip-2.1.2/src/core/pbuf.c ****   u16_t increment_magnitude;
 586:./lwip-2.1.2/src/core/pbuf.c **** 
 587:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("p != NULL", p != NULL);
 588:./lwip-2.1.2/src/core/pbuf.c ****   if ((p == NULL) || (header_size_decrement > 0xFFFF)) {
 589:./lwip-2.1.2/src/core/pbuf.c ****     return 1;
 590:./lwip-2.1.2/src/core/pbuf.c ****   }
 591:./lwip-2.1.2/src/core/pbuf.c ****   if (header_size_decrement == 0) {
 592:./lwip-2.1.2/src/core/pbuf.c ****     return 0;
 593:./lwip-2.1.2/src/core/pbuf.c ****   }
 594:./lwip-2.1.2/src/core/pbuf.c **** 
 595:./lwip-2.1.2/src/core/pbuf.c ****   increment_magnitude = (u16_t)header_size_decrement;
 596:./lwip-2.1.2/src/core/pbuf.c ****   /* Check that we aren't going to move off the end of the pbuf */
 597:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ERROR("increment_magnitude <= p->len", (increment_magnitude <= p->len), return 1;);
 598:./lwip-2.1.2/src/core/pbuf.c **** 
 599:./lwip-2.1.2/src/core/pbuf.c ****   /* remember current payload pointer */
 600:./lwip-2.1.2/src/core/pbuf.c ****   payload = p->payload;
 601:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_UNUSED_ARG(payload); /* only used in LWIP_DEBUGF below */
 602:./lwip-2.1.2/src/core/pbuf.c **** 
 603:./lwip-2.1.2/src/core/pbuf.c ****   /* increase payload pointer (guarded by length check above) */
 604:./lwip-2.1.2/src/core/pbuf.c ****   p->payload = (u8_t *)p->payload + header_size_decrement;
 605:./lwip-2.1.2/src/core/pbuf.c ****   /* modify pbuf length fields */
 606:./lwip-2.1.2/src/core/pbuf.c ****   p->len = (u16_t)(p->len - increment_magnitude);
 607:./lwip-2.1.2/src/core/pbuf.c ****   p->tot_len = (u16_t)(p->tot_len - increment_magnitude);
 608:./lwip-2.1.2/src/core/pbuf.c **** 
 609:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_remove_header: old %p new %p (%"U16_F")\n",
 610:./lwip-2.1.2/src/core/pbuf.c ****               (void *)payload, (void *)p->payload, increment_magnitude));
 611:./lwip-2.1.2/src/core/pbuf.c **** 
 612:./lwip-2.1.2/src/core/pbuf.c ****   return 0;
 613:./lwip-2.1.2/src/core/pbuf.c **** }
 614:./lwip-2.1.2/src/core/pbuf.c **** 
 615:./lwip-2.1.2/src/core/pbuf.c **** static u8_t
 616:./lwip-2.1.2/src/core/pbuf.c **** pbuf_header_impl(struct pbuf *p, s16_t header_size_increment, u8_t force)
 617:./lwip-2.1.2/src/core/pbuf.c **** {
 618:./lwip-2.1.2/src/core/pbuf.c ****   if (header_size_increment < 0) {
 619:./lwip-2.1.2/src/core/pbuf.c ****     return pbuf_remove_header(p, (size_t) - header_size_increment);
 620:./lwip-2.1.2/src/core/pbuf.c ****   } else {
 621:./lwip-2.1.2/src/core/pbuf.c ****     return pbuf_add_header_impl(p, (size_t)header_size_increment, force);
 622:./lwip-2.1.2/src/core/pbuf.c ****   }
 623:./lwip-2.1.2/src/core/pbuf.c **** }
 624:./lwip-2.1.2/src/core/pbuf.c **** 
 625:./lwip-2.1.2/src/core/pbuf.c **** /**
 626:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the payload pointer to hide or reveal headers in the payload.
 627:./lwip-2.1.2/src/core/pbuf.c ****  *
 628:./lwip-2.1.2/src/core/pbuf.c ****  * Adjusts the ->payload pointer so that space for a header
 629:./lwip-2.1.2/src/core/pbuf.c ****  * (dis)appears in the pbuf payload.
 630:./lwip-2.1.2/src/core/pbuf.c ****  *
 631:./lwip-2.1.2/src/core/pbuf.c ****  * The ->payload, ->tot_len and ->len fields are adjusted.
 632:./lwip-2.1.2/src/core/pbuf.c ****  *
 633:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to change the header size.
 634:./lwip-2.1.2/src/core/pbuf.c ****  * @param header_size_increment Number of bytes to increment header size which
 635:./lwip-2.1.2/src/core/pbuf.c ****  * increases the size of the pbuf. New space is on the front.
 636:./lwip-2.1.2/src/core/pbuf.c ****  * (Using a negative value decreases the header size.)
 637:./lwip-2.1.2/src/core/pbuf.c ****  * If header_size_increment is 0, this function does nothing and returns successful.
 638:./lwip-2.1.2/src/core/pbuf.c ****  *
 639:./lwip-2.1.2/src/core/pbuf.c ****  * PBUF_ROM and PBUF_REF type buffers cannot have their sizes increased, so
 640:./lwip-2.1.2/src/core/pbuf.c ****  * the call will fail. A check is made that the increase in header size does
 641:./lwip-2.1.2/src/core/pbuf.c ****  * not move the payload pointer in front of the start of the buffer.
 642:./lwip-2.1.2/src/core/pbuf.c ****  * @return non-zero on failure, zero on success.
 643:./lwip-2.1.2/src/core/pbuf.c ****  *
 644:./lwip-2.1.2/src/core/pbuf.c ****  */
 645:./lwip-2.1.2/src/core/pbuf.c **** u8_t
 646:./lwip-2.1.2/src/core/pbuf.c **** pbuf_header(struct pbuf *p, s16_t header_size_increment)
 647:./lwip-2.1.2/src/core/pbuf.c **** {
 648:./lwip-2.1.2/src/core/pbuf.c ****   return pbuf_header_impl(p, header_size_increment, 0);
 649:./lwip-2.1.2/src/core/pbuf.c **** }
 650:./lwip-2.1.2/src/core/pbuf.c **** 
 651:./lwip-2.1.2/src/core/pbuf.c **** /**
 652:./lwip-2.1.2/src/core/pbuf.c ****  * Same as pbuf_header but does not check if 'header_size > 0' is allowed.
 653:./lwip-2.1.2/src/core/pbuf.c ****  * This is used internally only, to allow PBUF_REF for RX.
 654:./lwip-2.1.2/src/core/pbuf.c ****  */
 655:./lwip-2.1.2/src/core/pbuf.c **** u8_t
 656:./lwip-2.1.2/src/core/pbuf.c **** pbuf_header_force(struct pbuf *p, s16_t header_size_increment)
 657:./lwip-2.1.2/src/core/pbuf.c **** {

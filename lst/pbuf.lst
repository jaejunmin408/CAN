1100:./lwip-2.1.2/src/core/pbuf.c **** #if LWIP_TCP && TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
1101:./lwip-2.1.2/src/core/pbuf.c **** /**
1102:./lwip-2.1.2/src/core/pbuf.c ****  * This method modifies a 'pbuf chain', so that its total length is
1103:./lwip-2.1.2/src/core/pbuf.c ****  * smaller than 64K. The remainder of the original pbuf chain is stored
1104:./lwip-2.1.2/src/core/pbuf.c ****  * in *rest.
1105:./lwip-2.1.2/src/core/pbuf.c ****  * This function never creates new pbufs, but splits an existing chain
1106:./lwip-2.1.2/src/core/pbuf.c ****  * in two parts. The tot_len of the modified packet queue will likely be
1107:./lwip-2.1.2/src/core/pbuf.c ****  * smaller than 64K.
1108:./lwip-2.1.2/src/core/pbuf.c ****  * 'packet queues' are not supported by this function.
1109:./lwip-2.1.2/src/core/pbuf.c ****  *
1110:./lwip-2.1.2/src/core/pbuf.c ****  * @param p the pbuf queue to be split
1111:./lwip-2.1.2/src/core/pbuf.c ****  * @param rest pointer to store the remainder (after the first 64K)
1112:./lwip-2.1.2/src/core/pbuf.c ****  */
1113:./lwip-2.1.2/src/core/pbuf.c **** void pbuf_split_64k(struct pbuf *p, struct pbuf **rest)
1114:./lwip-2.1.2/src/core/pbuf.c **** {
1115:./lwip-2.1.2/src/core/pbuf.c ****   *rest = NULL;
1116:./lwip-2.1.2/src/core/pbuf.c ****   if ((p != NULL) && (p->next != NULL)) {
1117:./lwip-2.1.2/src/core/pbuf.c ****     u16_t tot_len_front = p->len;
1118:./lwip-2.1.2/src/core/pbuf.c ****     struct pbuf *i = p;
1119:./lwip-2.1.2/src/core/pbuf.c ****     struct pbuf *r = p->next;
1120:./lwip-2.1.2/src/core/pbuf.c **** 
1121:./lwip-2.1.2/src/core/pbuf.c ****     /* continue until the total length (summed up as u16_t) overflows */
1122:./lwip-2.1.2/src/core/pbuf.c ****     while ((r != NULL) && ((u16_t)(tot_len_front + r->len) >= tot_len_front)) {
1123:./lwip-2.1.2/src/core/pbuf.c ****       tot_len_front = (u16_t)(tot_len_front + r->len);
1124:./lwip-2.1.2/src/core/pbuf.c ****       i = r;
1125:./lwip-2.1.2/src/core/pbuf.c ****       r = r->next;
1126:./lwip-2.1.2/src/core/pbuf.c ****     }
1127:./lwip-2.1.2/src/core/pbuf.c ****     /* i now points to last packet of the first segment. Set next
1128:./lwip-2.1.2/src/core/pbuf.c ****        pointer to NULL */
1129:./lwip-2.1.2/src/core/pbuf.c ****     i->next = NULL;
1130:./lwip-2.1.2/src/core/pbuf.c **** 
1131:./lwip-2.1.2/src/core/pbuf.c ****     if (r != NULL) {
1132:./lwip-2.1.2/src/core/pbuf.c ****       /* Update the tot_len field in the first part */
1133:./lwip-2.1.2/src/core/pbuf.c ****       for (i = p; i != NULL; i = i->next) {
1134:./lwip-2.1.2/src/core/pbuf.c ****         i->tot_len = (u16_t)(i->tot_len - r->tot_len);
1135:./lwip-2.1.2/src/core/pbuf.c ****         LWIP_ASSERT("tot_len/len mismatch in last pbuf",
1136:./lwip-2.1.2/src/core/pbuf.c ****                     (i->next != NULL) || (i->tot_len == i->len));
1137:./lwip-2.1.2/src/core/pbuf.c ****       }
1138:./lwip-2.1.2/src/core/pbuf.c ****       if (p->flags & PBUF_FLAG_TCP_FIN) {
1139:./lwip-2.1.2/src/core/pbuf.c ****         r->flags |= PBUF_FLAG_TCP_FIN;
1140:./lwip-2.1.2/src/core/pbuf.c ****       }
1141:./lwip-2.1.2/src/core/pbuf.c **** 
1142:./lwip-2.1.2/src/core/pbuf.c ****       /* tot_len field in rest does not need modifications */
1143:./lwip-2.1.2/src/core/pbuf.c ****       /* reference counters do not need modifications */
1144:./lwip-2.1.2/src/core/pbuf.c ****       *rest = r;
1145:./lwip-2.1.2/src/core/pbuf.c ****     }
1146:./lwip-2.1.2/src/core/pbuf.c ****   }
1147:./lwip-2.1.2/src/core/pbuf.c **** }
1148:./lwip-2.1.2/src/core/pbuf.c **** #endif /* LWIP_TCP && TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */

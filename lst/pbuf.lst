 690:./lwip-2.1.2/src/core/pbuf.c **** /**
 691:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 692:./lwip-2.1.2/src/core/pbuf.c ****  * Dereference a pbuf chain or queue and deallocate any no-longer-used
 693:./lwip-2.1.2/src/core/pbuf.c ****  * pbufs at the head of this chain or queue.
 694:./lwip-2.1.2/src/core/pbuf.c ****  *
 695:./lwip-2.1.2/src/core/pbuf.c ****  * Decrements the pbuf reference count. If it reaches zero, the pbuf is
 696:./lwip-2.1.2/src/core/pbuf.c ****  * deallocated.
 697:./lwip-2.1.2/src/core/pbuf.c ****  *
 698:./lwip-2.1.2/src/core/pbuf.c ****  * For a pbuf chain, this is repeated for each pbuf in the chain,
 699:./lwip-2.1.2/src/core/pbuf.c ****  * up to the first pbuf which has a non-zero reference count after
 700:./lwip-2.1.2/src/core/pbuf.c ****  * decrementing. So, when all reference counts are one, the whole
 701:./lwip-2.1.2/src/core/pbuf.c ****  * chain is free'd.
 702:./lwip-2.1.2/src/core/pbuf.c ****  *
 703:./lwip-2.1.2/src/core/pbuf.c ****  * @param p The pbuf (chain) to be dereferenced.
 704:./lwip-2.1.2/src/core/pbuf.c ****  *
 705:./lwip-2.1.2/src/core/pbuf.c ****  * @return the number of pbufs that were de-allocated
 706:./lwip-2.1.2/src/core/pbuf.c ****  * from the head of the chain.
 707:./lwip-2.1.2/src/core/pbuf.c ****  *
 708:./lwip-2.1.2/src/core/pbuf.c ****  * @note MUST NOT be called on a packet queue (Not verified to work yet).
 709:./lwip-2.1.2/src/core/pbuf.c ****  * @note the reference counter of a pbuf equals the number of pointers
 710:./lwip-2.1.2/src/core/pbuf.c ****  * that refer to the pbuf (or into the pbuf).
 711:./lwip-2.1.2/src/core/pbuf.c ****  *
 712:./lwip-2.1.2/src/core/pbuf.c ****  * @internal examples:
 713:./lwip-2.1.2/src/core/pbuf.c ****  *
 714:./lwip-2.1.2/src/core/pbuf.c ****  * Assuming existing chains a->b->c with the following reference
 715:./lwip-2.1.2/src/core/pbuf.c ****  * counts, calling pbuf_free(a) results in:
 716:./lwip-2.1.2/src/core/pbuf.c ****  *
 717:./lwip-2.1.2/src/core/pbuf.c ****  * 1->2->3 becomes ...1->3
 718:./lwip-2.1.2/src/core/pbuf.c ****  * 3->3->3 becomes 2->3->3
 719:./lwip-2.1.2/src/core/pbuf.c ****  * 1->1->2 becomes ......1
 720:./lwip-2.1.2/src/core/pbuf.c ****  * 2->1->1 becomes 1->1->1
 721:./lwip-2.1.2/src/core/pbuf.c ****  * 1->1->1 becomes .......
 722:./lwip-2.1.2/src/core/pbuf.c ****  *
 723:./lwip-2.1.2/src/core/pbuf.c ****  */
 724:./lwip-2.1.2/src/core/pbuf.c **** u8_t

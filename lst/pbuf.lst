 838:./lwip-2.1.2/src/core/pbuf.c **** /**
 839:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 840:./lwip-2.1.2/src/core/pbuf.c ****  * Concatenate two pbufs (each may be a pbuf chain) and take over
 841:./lwip-2.1.2/src/core/pbuf.c ****  * the caller's reference of the tail pbuf.
 842:./lwip-2.1.2/src/core/pbuf.c ****  *
 843:./lwip-2.1.2/src/core/pbuf.c ****  * @note The caller MAY NOT reference the tail pbuf afterwards.
 844:./lwip-2.1.2/src/core/pbuf.c ****  * Use pbuf_chain() for that purpose.
 845:./lwip-2.1.2/src/core/pbuf.c ****  *
 846:./lwip-2.1.2/src/core/pbuf.c ****  * This function explicitly does not check for tot_len overflow to prevent
 847:./lwip-2.1.2/src/core/pbuf.c ****  * failing to queue too long pbufs. This can produce invalid pbufs, so
 848:./lwip-2.1.2/src/core/pbuf.c ****  * handle with care!
 849:./lwip-2.1.2/src/core/pbuf.c ****  *
 850:./lwip-2.1.2/src/core/pbuf.c ****  * @see pbuf_chain()
 851:./lwip-2.1.2/src/core/pbuf.c ****  */
 852:./lwip-2.1.2/src/core/pbuf.c **** void
 853:./lwip-2.1.2/src/core/pbuf.c **** pbuf_cat(struct pbuf *h, struct pbuf *t)
 854:./lwip-2.1.2/src/core/pbuf.c **** {
 855:./lwip-2.1.2/src/core/pbuf.c ****   struct pbuf *p;
 856:./lwip-2.1.2/src/core/pbuf.c **** 
 857:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ERROR("(h != NULL) && (t != NULL) (programmer violates API)",
 858:./lwip-2.1.2/src/core/pbuf.c ****              ((h != NULL) && (t != NULL)), return;);
 859:./lwip-2.1.2/src/core/pbuf.c **** 
 860:./lwip-2.1.2/src/core/pbuf.c ****   /* proceed to last pbuf of chain */
 861:./lwip-2.1.2/src/core/pbuf.c ****   for (p = h; p->next != NULL; p = p->next) {
 862:./lwip-2.1.2/src/core/pbuf.c ****     /* add total length of second chain to all totals of first chain */
 863:./lwip-2.1.2/src/core/pbuf.c ****     p->tot_len = (u16_t)(p->tot_len + t->tot_len);
 864:./lwip-2.1.2/src/core/pbuf.c ****   }
 865:./lwip-2.1.2/src/core/pbuf.c ****   /* { p is last pbuf of first h chain, p->next == NULL } */
 866:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("p->tot_len == p->len (of last pbuf in chain)", p->tot_len == p->len);
 867:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("p->next == NULL", p->next == NULL);
 868:./lwip-2.1.2/src/core/pbuf.c ****   /* add total length of second chain to last pbuf total of first chain */
 869:./lwip-2.1.2/src/core/pbuf.c ****   p->tot_len = (u16_t)(p->tot_len + t->tot_len);
 870:./lwip-2.1.2/src/core/pbuf.c ****   /* chain last pbuf of head (p) with first of tail (t) */
 871:./lwip-2.1.2/src/core/pbuf.c ****   p->next = t;
 872:./lwip-2.1.2/src/core/pbuf.c ****   /* p->next now references t, but the caller will drop its reference to t,
 873:./lwip-2.1.2/src/core/pbuf.c ****    * so netto there is no change to the reference count of t.
 874:./lwip-2.1.2/src/core/pbuf.c ****    */
 875:./lwip-2.1.2/src/core/pbuf.c **** }

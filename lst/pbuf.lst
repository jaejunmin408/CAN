 877:./lwip-2.1.2/src/core/pbuf.c **** /**
 878:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
 879:./lwip-2.1.2/src/core/pbuf.c ****  * Chain two pbufs (or pbuf chains) together.
 880:./lwip-2.1.2/src/core/pbuf.c ****  *
 881:./lwip-2.1.2/src/core/pbuf.c ****  * The caller MUST call pbuf_free(t) once it has stopped
 882:./lwip-2.1.2/src/core/pbuf.c ****  * using it. Use pbuf_cat() instead if you no longer use t.
 883:./lwip-2.1.2/src/core/pbuf.c ****  *
 884:./lwip-2.1.2/src/core/pbuf.c ****  * @param h head pbuf (chain)
 885:./lwip-2.1.2/src/core/pbuf.c ****  * @param t tail pbuf (chain)
 886:./lwip-2.1.2/src/core/pbuf.c ****  * @note The pbufs MUST belong to the same packet.
 887:./lwip-2.1.2/src/core/pbuf.c ****  * @note MAY NOT be called on a packet queue.
 888:./lwip-2.1.2/src/core/pbuf.c ****  *
 889:./lwip-2.1.2/src/core/pbuf.c ****  * The ->tot_len fields of all pbufs of the head chain are adjusted.
 890:./lwip-2.1.2/src/core/pbuf.c ****  * The ->next field of the last pbuf of the head chain is adjusted.
 891:./lwip-2.1.2/src/core/pbuf.c ****  * The ->ref field of the first pbuf of the tail chain is adjusted.
 892:./lwip-2.1.2/src/core/pbuf.c ****  *
 893:./lwip-2.1.2/src/core/pbuf.c ****  */
 894:./lwip-2.1.2/src/core/pbuf.c **** void
 895:./lwip-2.1.2/src/core/pbuf.c **** pbuf_chain(struct pbuf *h, struct pbuf *t)
 896:./lwip-2.1.2/src/core/pbuf.c **** {
 897:./lwip-2.1.2/src/core/pbuf.c ****   pbuf_cat(h, t);
 898:./lwip-2.1.2/src/core/pbuf.c ****   /* t is now referenced by h */
 899:./lwip-2.1.2/src/core/pbuf.c ****   pbuf_ref(t);
 900:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_chain: %p references %p\n", (void *)h, (void *)t)
 901:./lwip-2.1.2/src/core/pbuf.c **** }

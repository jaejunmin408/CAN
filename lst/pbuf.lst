 828:./inc/cmsis_gcc.h **** /**
 829:./inc/cmsis_gcc.h ****   \brief   Get FPSCR
 830:./inc/cmsis_gcc.h ****   \details Returns the current value of the Floating Point Status/Control register.
 831:./inc/cmsis_gcc.h ****   \return               Floating Point Status/Control register value
 832:./inc/cmsis_gcc.h ****  */
 833:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __get_FPSCR(void)
 834:./inc/cmsis_gcc.h **** {
 835:./inc/cmsis_gcc.h **** #if ((defined (__FPU_PRESENT) && (__FPU_PRESENT == 1U)) && \
 836:./inc/cmsis_gcc.h ****      (defined (__FPU_USED   ) && (__FPU_USED    == 1U))     )
 837:./inc/cmsis_gcc.h **** #if __has_builtin(__builtin_arm_get_fpscr) 
 838:./inc/cmsis_gcc.h **** // Re-enable using built-in when GCC has been fixed
 839:./inc/cmsis_gcc.h **** // || (__GNUC__ > 7) || (__GNUC__ == 7 && __GNUC_MINOR__ >= 2)
 840:./inc/cmsis_gcc.h ****   /* see https://gcc.gnu.org/ml/gcc-patches/2017-04/msg00443.html */
 841:./inc/cmsis_gcc.h ****   return __builtin_arm_get_fpscr();
 842:./inc/cmsis_gcc.h **** #else
 843:./inc/cmsis_gcc.h ****   uint32_t result;
 844:./inc/cmsis_gcc.h **** 
 845:./inc/cmsis_gcc.h ****   __ASM volatile ("VMRS %0, fpscr" : "=r" (result) );
 846:./inc/cmsis_gcc.h ****   return(result);
 847:./inc/cmsis_gcc.h **** #endif
 848:./inc/cmsis_gcc.h **** #else
 849:./inc/cmsis_gcc.h ****   return(0U);
 850:./inc/cmsis_gcc.h **** #endif
 851:./inc/cmsis_gcc.h **** }
 852:./inc/cmsis_gcc.h **** 
 853:./inc/cmsis_gcc.h **** 
 854:./inc/cmsis_gcc.h **** /**
 855:./inc/cmsis_gcc.h ****   \brief   Set FPSCR
 856:./inc/cmsis_gcc.h ****   \details Assigns the given value to the Floating Point Status/Control register.
 857:./inc/cmsis_gcc.h ****   \param [in]    fpscr  Floating Point Status/Control value to set
 858:./inc/cmsis_gcc.h ****  */
 859:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __set_FPSCR(uint32_t fpscr)
 860:./inc/cmsis_gcc.h **** {
 861:./inc/cmsis_gcc.h **** #if ((defined (__FPU_PRESENT) && (__FPU_PRESENT == 1U)) && \
 862:./inc/cmsis_gcc.h ****      (defined (__FPU_USED   ) && (__FPU_USED    == 1U))     )
 863:./inc/cmsis_gcc.h **** #if __has_builtin(__builtin_arm_set_fpscr)
 864:./inc/cmsis_gcc.h **** // Re-enable using built-in when GCC has been fixed
 865:./inc/cmsis_gcc.h **** // || (__GNUC__ > 7) || (__GNUC__ == 7 && __GNUC_MINOR__ >= 2)
 866:./inc/cmsis_gcc.h ****   /* see https://gcc.gnu.org/ml/gcc-patches/2017-04/msg00443.html */
 867:./inc/cmsis_gcc.h ****   __builtin_arm_set_fpscr(fpscr);
 868:./inc/cmsis_gcc.h **** #else
 869:./inc/cmsis_gcc.h ****   __ASM volatile ("VMSR fpscr, %0" : : "r" (fpscr) : "vfpcc", "memory");
 870:./inc/cmsis_gcc.h **** #endif
 871:./inc/cmsis_gcc.h **** #else
 872:./inc/cmsis_gcc.h ****   (void)fpscr;
 873:./inc/cmsis_gcc.h **** #endif
 874:./inc/cmsis_gcc.h **** }

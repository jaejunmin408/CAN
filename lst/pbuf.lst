1328:./lwip-2.1.2/src/core/pbuf.c ****  * @param len length of data to copy into the pbuf
1329:./lwip-2.1.2/src/core/pbuf.c ****  * @param chksum pointer to the checksum which is updated
1330:./lwip-2.1.2/src/core/pbuf.c ****  * @return ERR_OK if successful, another error if the data does not fit
1331:./lwip-2.1.2/src/core/pbuf.c ****  *         within the (first) pbuf (no pbuf queues!)
1332:./lwip-2.1.2/src/core/pbuf.c ****  */

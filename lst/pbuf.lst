 903:./lwip-2.1.2/src/core/pbuf.c **** /**
 904:./lwip-2.1.2/src/core/pbuf.c ****  * Dechains the first pbuf from its succeeding pbufs in the chain.
 905:./lwip-2.1.2/src/core/pbuf.c ****  *
 906:./lwip-2.1.2/src/core/pbuf.c ****  * Makes p->tot_len field equal to p->len.
 907:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to dechain
 908:./lwip-2.1.2/src/core/pbuf.c ****  * @return remainder of the pbuf chain, or NULL if it was de-allocated.
 909:./lwip-2.1.2/src/core/pbuf.c ****  * @note May not be called on a packet queue.
 910:./lwip-2.1.2/src/core/pbuf.c ****  */
 911:./lwip-2.1.2/src/core/pbuf.c **** struct pbuf *
 912:./lwip-2.1.2/src/core/pbuf.c **** pbuf_dechain(struct pbuf *p)
 913:./lwip-2.1.2/src/core/pbuf.c **** {
 914:./lwip-2.1.2/src/core/pbuf.c ****   struct pbuf *q;
 915:./lwip-2.1.2/src/core/pbuf.c ****   u8_t tail_gone = 1;
 916:./lwip-2.1.2/src/core/pbuf.c ****   /* tail */
 917:./lwip-2.1.2/src/core/pbuf.c ****   q = p->next;
 918:./lwip-2.1.2/src/core/pbuf.c ****   /* pbuf has successor in chain? */
 919:./lwip-2.1.2/src/core/pbuf.c ****   if (q != NULL) {
 920:./lwip-2.1.2/src/core/pbuf.c ****     /* assert tot_len invariant: (p->tot_len == p->len + (p->next? p->next->tot_len: 0) */
 921:./lwip-2.1.2/src/core/pbuf.c ****     LWIP_ASSERT("p->tot_len == p->len + q->tot_len", q->tot_len == p->tot_len - p->len);
 922:./lwip-2.1.2/src/core/pbuf.c ****     /* enforce invariant if assertion is disabled */
 923:./lwip-2.1.2/src/core/pbuf.c ****     q->tot_len = (u16_t)(p->tot_len - p->len);
 924:./lwip-2.1.2/src/core/pbuf.c ****     /* decouple pbuf from remainder */
 925:./lwip-2.1.2/src/core/pbuf.c ****     p->next = NULL;
 926:./lwip-2.1.2/src/core/pbuf.c ****     /* total length of pbuf p is its own length only */
 927:./lwip-2.1.2/src/core/pbuf.c ****     p->tot_len = p->len;
 928:./lwip-2.1.2/src/core/pbuf.c ****     /* q is no longer referenced by p, free it */
 929:./lwip-2.1.2/src/core/pbuf.c ****     LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE, ("pbuf_dechain: unreferencing %p\n", (void *)q));
 930:./lwip-2.1.2/src/core/pbuf.c ****     tail_gone = pbuf_free(q);
 931:./lwip-2.1.2/src/core/pbuf.c ****     if (tail_gone > 0) {
 932:./lwip-2.1.2/src/core/pbuf.c ****       LWIP_DEBUGF(PBUF_DEBUG | LWIP_DBG_TRACE,
 933:./lwip-2.1.2/src/core/pbuf.c ****                   ("pbuf_dechain: deallocated %p (as it is no longer referenced)\n", (void *)q));
 934:./lwip-2.1.2/src/core/pbuf.c ****     }
 935:./lwip-2.1.2/src/core/pbuf.c ****     /* return remaining tail or NULL if deallocated */
 936:./lwip-2.1.2/src/core/pbuf.c ****   }
 937:./lwip-2.1.2/src/core/pbuf.c ****   /* assert tot_len invariant: (p->tot_len == p->len + (p->next? p->next->tot_len: 0) */
 938:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("p->tot_len == p->len", p->tot_len == p->len);
 939:./lwip-2.1.2/src/core/pbuf.c ****   return ((tail_gone > 0) ? NULL : q);
 940:./lwip-2.1.2/src/core/pbuf.c **** }

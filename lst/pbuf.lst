1422:./lwip-2.1.2/src/core/pbuf.c **** /**
1423:./lwip-2.1.2/src/core/pbuf.c ****  * @ingroup pbuf
1424:./lwip-2.1.2/src/core/pbuf.c ****  * Compare pbuf contents at specified offset with memory s2, both of length n
1425:./lwip-2.1.2/src/core/pbuf.c ****  *
1426:./lwip-2.1.2/src/core/pbuf.c ****  * @param p pbuf to compare
1427:./lwip-2.1.2/src/core/pbuf.c ****  * @param offset offset into p at which to start comparing
1428:./lwip-2.1.2/src/core/pbuf.c ****  * @param s2 buffer to compare
1429:./lwip-2.1.2/src/core/pbuf.c ****  * @param n length of buffer to compare
1430:./lwip-2.1.2/src/core/pbuf.c ****  * @return zero if equal, nonzero otherwise

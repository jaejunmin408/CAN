1320:./lwip-2.1.2/src/core/pbuf.c **** #if LWIP_CHECKSUM_ON_COPY
1321:./lwip-2.1.2/src/core/pbuf.c **** /**
1322:./lwip-2.1.2/src/core/pbuf.c ****  * Copies data into a single pbuf (*not* into a pbuf queue!) and updates
1323:./lwip-2.1.2/src/core/pbuf.c ****  * the checksum while copying
1324:./lwip-2.1.2/src/core/pbuf.c ****  *
1325:./lwip-2.1.2/src/core/pbuf.c ****  * @param p the pbuf to copy data into
1326:./lwip-2.1.2/src/core/pbuf.c ****  * @param start_offset offset of p->payload where to copy the data to
1327:./lwip-2.1.2/src/core/pbuf.c ****  * @param dataptr data to copy into the pbuf
1328:./lwip-2.1.2/src/core/pbuf.c ****  * @param len length of data to copy into the pbuf
1329:./lwip-2.1.2/src/core/pbuf.c ****  * @param chksum pointer to the checksum which is updated
1330:./lwip-2.1.2/src/core/pbuf.c ****  * @return ERR_OK if successful, another error if the data does not fit
1331:./lwip-2.1.2/src/core/pbuf.c ****  *         within the (first) pbuf (no pbuf queues!)
1332:./lwip-2.1.2/src/core/pbuf.c ****  */
1333:./lwip-2.1.2/src/core/pbuf.c **** err_t
1334:./lwip-2.1.2/src/core/pbuf.c **** pbuf_fill_chksum(struct pbuf *p, u16_t start_offset, const void *dataptr,
1335:./lwip-2.1.2/src/core/pbuf.c ****                  u16_t len, u16_t *chksum)
1336:./lwip-2.1.2/src/core/pbuf.c **** {
1337:./lwip-2.1.2/src/core/pbuf.c ****   u32_t acc;
1338:./lwip-2.1.2/src/core/pbuf.c ****   u16_t copy_chksum;
1339:./lwip-2.1.2/src/core/pbuf.c ****   char *dst_ptr;
1340:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("p != NULL", p != NULL);
1341:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("dataptr != NULL", dataptr != NULL);
1342:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("chksum != NULL", chksum != NULL);
1343:./lwip-2.1.2/src/core/pbuf.c ****   LWIP_ASSERT("len != 0", len != 0);
1344:./lwip-2.1.2/src/core/pbuf.c **** 
1345:./lwip-2.1.2/src/core/pbuf.c ****   if ((start_offset >= p->len) || (start_offset + len > p->len)) {
1346:./lwip-2.1.2/src/core/pbuf.c ****     return ERR_ARG;
1347:./lwip-2.1.2/src/core/pbuf.c ****   }
1348:./lwip-2.1.2/src/core/pbuf.c **** 
1349:./lwip-2.1.2/src/core/pbuf.c ****   dst_ptr = ((char *)p->payload) + start_offset;
1350:./lwip-2.1.2/src/core/pbuf.c ****   copy_chksum = LWIP_CHKSUM_COPY(dst_ptr, dataptr, len);
1351:./lwip-2.1.2/src/core/pbuf.c ****   if ((start_offset & 1) != 0) {
1352:./lwip-2.1.2/src/core/pbuf.c ****     copy_chksum = SWAP_BYTES_IN_WORD(copy_chksum);
1353:./lwip-2.1.2/src/core/pbuf.c ****   }
1354:./lwip-2.1.2/src/core/pbuf.c ****   acc = *chksum;
1355:./lwip-2.1.2/src/core/pbuf.c ****   acc += copy_chksum;
1356:./lwip-2.1.2/src/core/pbuf.c ****   *chksum = FOLD_U32T(acc);
1357:./lwip-2.1.2/src/core/pbuf.c ****   return ERR_OK;
1358:./lwip-2.1.2/src/core/pbuf.c **** }
1359:./lwip-2.1.2/src/core/pbuf.c **** #endif /* LWIP_CHECKSUM_ON_COPY */
1360:./lwip-2.1.2/src/core/pbuf.c **** 

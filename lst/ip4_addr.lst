 261:./lwip-2.1.2/src/core/ipv4/ip4_addr.c ****  *
 262:./lwip-2.1.2/src/core/ipv4/ip4_addr.c ****  * @param addr ip address in network order to convert
 263:./lwip-2.1.2/src/core/ipv4/ip4_addr.c ****  * @return pointer to a global static (!) buffer that holds the ASCII
 264:./lwip-2.1.2/src/core/ipv4/ip4_addr.c ****  *         representation of addr
 265:./lwip-2.1.2/src/core/ipv4/ip4_addr.c ****  */

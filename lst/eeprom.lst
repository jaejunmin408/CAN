 271:./src/eeprom.c **** 	__DSB();
 272:./src/eeprom.c **** 	I2C1->CR2 = 1 << 14;
 273:./src/eeprom.c **** 
 274:./src/eeprom.c **** 
 275:./src/eeprom.c **** 	// wait for STOP

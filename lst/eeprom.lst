  10:./src/eeprom.c **** // v1  first version
  11:./src/eeprom.c **** // v2  support added for eeprom at ethernet PHY board. Eeprom is selected
  12:./src/eeprom.c **** //     by address bit A18 ( M24M02 from st micro).
  13:./src/eeprom.c **** //     0x00000 - 0x3FFFF  ( 2MBit main eeprom at PCAN-Router Pro FD)
  14:./src/eeprom.c **** //     0x40000 - 0x7FFFF  ( 2MBit second eeprom at ethernet PHY board)
  15:./src/eeprom.c **** // v3  small mods due to changed CPU settings from bootloader 2.0.9 .
  16:./src/eeprom.c **** //     Typical changes are memory barriers to ensure memory access order.
  17:./src/eeprom.c **** //     Barriers are set preventive, maybe more are needed ...
  18:./src/eeprom.c **** 
  19:./src/eeprom.c **** #define	EEPROM_DEV_ADDR		0xA0
  20:./src/eeprom.c **** 
  21:./src/eeprom.c **** // do not use 256 !!
  22:./src/eeprom.c **** #define	EEPROM_CACHE_SIZE		128
  23:./src/eeprom.c **** 
  24:./src/eeprom.c **** // total size is 2 MBit (256 KByte) per i2c device
  25:./src/eeprom.c **** #define	EEPROM_MEM_SIZE		( 256 * 1024 * 2)
  26:./src/eeprom.c **** 
  27:./src/eeprom.c **** #define	PAGE_MASK				( EEPROM_CACHE_SIZE - 1)
  28:./src/eeprom.c **** 
  29:./src/eeprom.c **** #define SAMEPAGE( addr1, addr2)	((addr1 | PAGE_MASK) == (addr2 | PAGE_MASK))
  30:./src/eeprom.c **** 

 870:./inc/cmsis_gcc.h **** #endif
 871:./inc/cmsis_gcc.h **** #else
 872:./inc/cmsis_gcc.h ****   (void)fpscr;
 873:./inc/cmsis_gcc.h **** #endif
 874:./inc/cmsis_gcc.h **** }

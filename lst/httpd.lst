 121:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_11_KEEPALIVE
 122:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP11_CONNECTIONKEEPALIVE  "Connection: keep-alive"
 123:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP11_CONNECTIONKEEPALIVE2 "Connection: Keep-Alive"
 124:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 125:./lwip-2.1.2/src/apps/http/httpd.c **** 
 126:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_DYNAMIC_FILE_READ
 127:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_DYNAMIC_FILE(hs) ((hs)->buf != NULL)
 128:./lwip-2.1.2/src/apps/http/httpd.c **** #else
 129:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_DYNAMIC_FILE(hs) 0
 130:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 131:./lwip-2.1.2/src/apps/http/httpd.c **** 
 132:./lwip-2.1.2/src/apps/http/httpd.c **** /* This defines checks whether tcp_write has to copy data or not */
 133:./lwip-2.1.2/src/apps/http/httpd.c **** 
 134:./lwip-2.1.2/src/apps/http/httpd.c **** #ifndef HTTP_IS_DATA_VOLATILE
 135:./lwip-2.1.2/src/apps/http/httpd.c **** /** tcp_write does not have to copy data when sent from rom-file-system directly */
 136:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_DATA_VOLATILE(hs)       (HTTP_IS_DYNAMIC_FILE(hs) ? TCP_WRITE_FLAG_COPY : 0)
 137:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 138:./lwip-2.1.2/src/apps/http/httpd.c **** /** Default: dynamic headers are sent from ROM (non-dynamic headers are handled like file data) */
 139:./lwip-2.1.2/src/apps/http/httpd.c **** #ifndef HTTP_IS_HDR_VOLATILE
 140:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_HDR_VOLATILE(hs, ptr)   0
 141:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 142:./lwip-2.1.2/src/apps/http/httpd.c **** 
 143:./lwip-2.1.2/src/apps/http/httpd.c **** /* Return values for http_send_*() */
 144:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_DATA_TO_SEND_FREED    3
 145:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_DATA_TO_SEND_BREAK    2
 146:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_DATA_TO_SEND_CONTINUE 1
 147:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_NO_DATA_TO_SEND       0
 148:./lwip-2.1.2/src/apps/http/httpd.c **** 
 149:./lwip-2.1.2/src/apps/http/httpd.c **** typedef struct {
 150:./lwip-2.1.2/src/apps/http/httpd.c ****   const char *name;

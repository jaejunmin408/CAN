 499:./lwip-2.1.2/src/apps/http/httpd.c ****     hs->ssi = NULL;
 500:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 501:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SSI */
 502:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_REQUESTLIST
 503:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs->req) {
 504:./lwip-2.1.2/src/apps/http/httpd.c ****     pbuf_free(hs->req);
 505:./lwip-2.1.2/src/apps/http/httpd.c ****     hs->req = NULL;
 506:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 507:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SUPPORT_REQUESTLIST */
 508:./lwip-2.1.2/src/apps/http/httpd.c **** }
 509:./lwip-2.1.2/src/apps/http/httpd.c **** 
 510:./lwip-2.1.2/src/apps/http/httpd.c **** /** Free a struct http_state.
 511:./lwip-2.1.2/src/apps/http/httpd.c ****  * Also frees the file data if dynamic.
 512:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 513:./lwip-2.1.2/src/apps/http/httpd.c **** static void
 514:./lwip-2.1.2/src/apps/http/httpd.c **** http_state_free(struct http_state *hs)
 515:./lwip-2.1.2/src/apps/http/httpd.c **** {
 516:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs != NULL) {

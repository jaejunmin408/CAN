2046:./lwip-2.1.2/src/apps/http/httpd.c ****         /* HTTP 0.9: respond with correct protocol version */
2047:./lwip-2.1.2/src/apps/http/httpd.c ****         sp2 = lwip_strnstr(sp1 + 1, CRLF, left_len);
2048:./lwip-2.1.2/src/apps/http/httpd.c ****         is_09 = 1;

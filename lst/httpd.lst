 175:./lwip-2.1.2/src/apps/http/httpd.c **** #define LWIP_HTTPD_URI_BUF_LEN LWIP_HTTPD_MAX_REQUEST_URI_LEN
 176:./lwip-2.1.2/src/apps/http/httpd.c **** #endif

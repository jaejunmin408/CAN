 522:./lwip-2.1.2/src/apps/http/httpd.c **** 
 523:./lwip-2.1.2/src/apps/http/httpd.c **** /** Call tcp_write() in a loop trying smaller and smaller length
 524:./lwip-2.1.2/src/apps/http/httpd.c ****  *
 525:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param pcb altcp_pcb to send
 526:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param ptr Data to send
 527:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param length Length of data to send (in/out: on return, contains the
 528:./lwip-2.1.2/src/apps/http/httpd.c ****  *        amount of data sent)
 529:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param apiflags directly passed to tcp_write
 530:./lwip-2.1.2/src/apps/http/httpd.c ****  * @return the return value of tcp_write
 531:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 532:./lwip-2.1.2/src/apps/http/httpd.c **** static err_t
 533:./lwip-2.1.2/src/apps/http/httpd.c **** http_write(struct altcp_pcb *pcb, const void *ptr, u16_t *length, u8_t apiflags)
 534:./lwip-2.1.2/src/apps/http/httpd.c **** {
 535:./lwip-2.1.2/src/apps/http/httpd.c ****   u16_t len, max_len;
 536:./lwip-2.1.2/src/apps/http/httpd.c ****   err_t err;
 537:./lwip-2.1.2/src/apps/http/httpd.c ****   LWIP_ASSERT("length != NULL", length != NULL);
 538:./lwip-2.1.2/src/apps/http/httpd.c ****   len = *length;
 539:./lwip-2.1.2/src/apps/http/httpd.c ****   if (len == 0) {
 540:./lwip-2.1.2/src/apps/http/httpd.c ****     return ERR_OK;
 541:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 542:./lwip-2.1.2/src/apps/http/httpd.c ****   /* We cannot send more data than space available in the send buffer. */
 543:./lwip-2.1.2/src/apps/http/httpd.c ****   max_len = altcp_sndbuf(pcb);
 544:./lwip-2.1.2/src/apps/http/httpd.c ****   if (max_len < len) {
 545:./lwip-2.1.2/src/apps/http/httpd.c ****     len = max_len;
 546:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 547:./lwip-2.1.2/src/apps/http/httpd.c **** #ifdef HTTPD_MAX_WRITE_LEN
 548:./lwip-2.1.2/src/apps/http/httpd.c ****   /* Additional limitation: e.g. don't enqueue more than 2*mss at once */
 549:./lwip-2.1.2/src/apps/http/httpd.c ****   max_len = HTTPD_MAX_WRITE_LEN(pcb);
 550:./lwip-2.1.2/src/apps/http/httpd.c ****   if (len > max_len) {
 551:./lwip-2.1.2/src/apps/http/httpd.c ****     len = max_len;
 552:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 553:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* HTTPD_MAX_WRITE_LEN */
 554:./lwip-2.1.2/src/apps/http/httpd.c ****   do {
 555:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_DEBUGF(HTTPD_DEBUG | LWIP_DBG_TRACE, ("Trying to send %d bytes\n", len));
 556:./lwip-2.1.2/src/apps/http/httpd.c ****     err = altcp_write(pcb, ptr, len, apiflags);
 557:./lwip-2.1.2/src/apps/http/httpd.c ****     if (err == ERR_MEM) {
 558:./lwip-2.1.2/src/apps/http/httpd.c ****       if ((altcp_sndbuf(pcb) == 0) ||
 559:./lwip-2.1.2/src/apps/http/httpd.c ****           (altcp_sndqueuelen(pcb) >= TCP_SND_QUEUELEN)) {
 560:./lwip-2.1.2/src/apps/http/httpd.c ****         /* no need to try smaller sizes */
 561:./lwip-2.1.2/src/apps/http/httpd.c ****         len = 1;
 562:./lwip-2.1.2/src/apps/http/httpd.c ****       } else {
 563:./lwip-2.1.2/src/apps/http/httpd.c ****         len /= 2;
 564:./lwip-2.1.2/src/apps/http/httpd.c ****       }
 565:./lwip-2.1.2/src/apps/http/httpd.c ****       LWIP_DEBUGF(HTTPD_DEBUG | LWIP_DBG_TRACE,
 566:./lwip-2.1.2/src/apps/http/httpd.c ****                   ("Send failed, trying less (%d bytes)\n", len));
 567:./lwip-2.1.2/src/apps/http/httpd.c ****     }
 568:./lwip-2.1.2/src/apps/http/httpd.c ****   } while ((err == ERR_MEM) && (len > 1));
 569:./lwip-2.1.2/src/apps/http/httpd.c **** 
 570:./lwip-2.1.2/src/apps/http/httpd.c ****   if (err == ERR_OK) {
 571:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_DEBUGF(HTTPD_DEBUG | LWIP_DBG_TRACE, ("Sent %d bytes\n", len));
 572:./lwip-2.1.2/src/apps/http/httpd.c ****     *length = len;
 573:./lwip-2.1.2/src/apps/http/httpd.c ****   } else {
 574:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_DEBUGF(HTTPD_DEBUG | LWIP_DBG_TRACE, ("Send failed with err %d (\"%s\")\n", err, lwip_stre
 575:./lwip-2.1.2/src/apps/http/httpd.c ****     *length = 0;
 576:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 577:./lwip-2.1.2/src/apps/http/httpd.c **** 
 578:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_11_KEEPALIVE
 579:./lwip-2.1.2/src/apps/http/httpd.c ****   /* ensure nagle is normally enabled (only disabled for persistent connections
 580:./lwip-2.1.2/src/apps/http/httpd.c ****      when all data has been enqueued but the connection stays open for the next
 581:./lwip-2.1.2/src/apps/http/httpd.c ****      request */
 582:./lwip-2.1.2/src/apps/http/httpd.c ****   altcp_nagle_enable(pcb);
 583:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 584:./lwip-2.1.2/src/apps/http/httpd.c **** 
 585:./lwip-2.1.2/src/apps/http/httpd.c ****   return err;
 586:./lwip-2.1.2/src/apps/http/httpd.c **** }
 587:./lwip-2.1.2/src/apps/http/httpd.c **** 
 588:./lwip-2.1.2/src/apps/http/httpd.c **** /**
 589:./lwip-2.1.2/src/apps/http/httpd.c ****  * The connection shall be actively closed (using RST to close from fault states).
 590:./lwip-2.1.2/src/apps/http/httpd.c ****  * Reset the sent- and recv-callbacks.
 591:./lwip-2.1.2/src/apps/http/httpd.c ****  *
 592:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param pcb the tcp pcb to reset callbacks
 593:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param hs connection state to free
 594:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 595:./lwip-2.1.2/src/apps/http/httpd.c **** static err_t
 596:./lwip-2.1.2/src/apps/http/httpd.c **** http_close_or_abort_conn(struct altcp_pcb *pcb, struct http_state *hs, u8_t abort_conn)
 597:./lwip-2.1.2/src/apps/http/httpd.c **** {
 598:./lwip-2.1.2/src/apps/http/httpd.c ****   err_t err;
 599:./lwip-2.1.2/src/apps/http/httpd.c ****   LWIP_DEBUGF(HTTPD_DEBUG, ("Closing connection %p\n", (void *)pcb));
 600:./lwip-2.1.2/src/apps/http/httpd.c **** 
 601:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_POST
 602:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs != NULL) {
 603:./lwip-2.1.2/src/apps/http/httpd.c ****     if ((hs->post_content_len_left != 0)
 604:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_POST_MANUAL_WND
 605:./lwip-2.1.2/src/apps/http/httpd.c ****         || ((hs->no_auto_wnd != 0) && (hs->unrecved_bytes != 0))
 606:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_POST_MANUAL_WND */
 607:./lwip-2.1.2/src/apps/http/httpd.c ****        ) {
 608:./lwip-2.1.2/src/apps/http/httpd.c ****       /* make sure the post code knows that the connection is closed */
 609:./lwip-2.1.2/src/apps/http/httpd.c ****       http_uri_buf[0] = 0;
 610:./lwip-2.1.2/src/apps/http/httpd.c ****       httpd_post_finished(hs, http_uri_buf, LWIP_HTTPD_URI_BUF_LEN);
 611:./lwip-2.1.2/src/apps/http/httpd.c ****     }
 612:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 613:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SUPPORT_POST*/
 614:./lwip-2.1.2/src/apps/http/httpd.c **** 
 615:./lwip-2.1.2/src/apps/http/httpd.c **** 
 616:./lwip-2.1.2/src/apps/http/httpd.c ****   altcp_arg(pcb, NULL);
 617:./lwip-2.1.2/src/apps/http/httpd.c ****   altcp_recv(pcb, NULL);
 618:./lwip-2.1.2/src/apps/http/httpd.c ****   altcp_err(pcb, NULL);
 619:./lwip-2.1.2/src/apps/http/httpd.c ****   altcp_poll(pcb, NULL, 0);
 620:./lwip-2.1.2/src/apps/http/httpd.c ****   altcp_sent(pcb, NULL);
 621:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs != NULL) {
 622:./lwip-2.1.2/src/apps/http/httpd.c ****     http_state_free(hs);
 623:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 624:./lwip-2.1.2/src/apps/http/httpd.c **** 
 625:./lwip-2.1.2/src/apps/http/httpd.c ****   if (abort_conn) {
 626:./lwip-2.1.2/src/apps/http/httpd.c ****     altcp_abort(pcb);
 627:./lwip-2.1.2/src/apps/http/httpd.c ****     return ERR_OK;
 628:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 629:./lwip-2.1.2/src/apps/http/httpd.c ****   err = altcp_close(pcb);
 630:./lwip-2.1.2/src/apps/http/httpd.c ****   if (err != ERR_OK) {
 631:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_DEBUGF(HTTPD_DEBUG, ("Error %d closing %p\n", err, (void *)pcb));
 632:./lwip-2.1.2/src/apps/http/httpd.c ****     /* error closing, try again later in poll */
 633:./lwip-2.1.2/src/apps/http/httpd.c ****     altcp_poll(pcb, http_poll, HTTPD_POLL_INTERVAL);
 634:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 635:./lwip-2.1.2/src/apps/http/httpd.c ****   return err;
 636:./lwip-2.1.2/src/apps/http/httpd.c **** }
 637:./lwip-2.1.2/src/apps/http/httpd.c **** 
 638:./lwip-2.1.2/src/apps/http/httpd.c **** /**
 639:./lwip-2.1.2/src/apps/http/httpd.c ****  * The connection shall be actively closed.
 640:./lwip-2.1.2/src/apps/http/httpd.c ****  * Reset the sent- and recv-callbacks.
 641:./lwip-2.1.2/src/apps/http/httpd.c ****  *
 642:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param pcb the tcp pcb to reset callbacks
 643:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param hs connection state to free
 644:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 645:./lwip-2.1.2/src/apps/http/httpd.c **** static err_t
 646:./lwip-2.1.2/src/apps/http/httpd.c **** http_close_conn(struct altcp_pcb *pcb, struct http_state *hs)
 647:./lwip-2.1.2/src/apps/http/httpd.c **** {
 648:./lwip-2.1.2/src/apps/http/httpd.c ****   return http_close_or_abort_conn(pcb, hs, 0);
 649:./lwip-2.1.2/src/apps/http/httpd.c **** }
 650:./lwip-2.1.2/src/apps/http/httpd.c **** 
 651:./lwip-2.1.2/src/apps/http/httpd.c **** /** End of file: either close the connection (Connection: close) or
 652:./lwip-2.1.2/src/apps/http/httpd.c ****  * close the file (Connection: keep-alive)
 653:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 654:./lwip-2.1.2/src/apps/http/httpd.c **** static void
 655:./lwip-2.1.2/src/apps/http/httpd.c **** http_eof(struct altcp_pcb *pcb, struct http_state *hs)
 656:./lwip-2.1.2/src/apps/http/httpd.c **** {
 657:./lwip-2.1.2/src/apps/http/httpd.c ****   /* HTTP/1.1 persistent connection? (Not supported for SSI) */
 658:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_11_KEEPALIVE
 659:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs->keepalive) {
 660:./lwip-2.1.2/src/apps/http/httpd.c ****     http_remove_connection(hs);
 661:./lwip-2.1.2/src/apps/http/httpd.c **** 
 662:./lwip-2.1.2/src/apps/http/httpd.c ****     http_state_eof(hs);
 663:./lwip-2.1.2/src/apps/http/httpd.c ****     http_state_init(hs);
 664:./lwip-2.1.2/src/apps/http/httpd.c ****     /* restore state: */
 665:./lwip-2.1.2/src/apps/http/httpd.c ****     hs->pcb = pcb;
 666:./lwip-2.1.2/src/apps/http/httpd.c ****     hs->keepalive = 1;
 667:./lwip-2.1.2/src/apps/http/httpd.c ****     http_add_connection(hs);
 668:./lwip-2.1.2/src/apps/http/httpd.c ****     /* ensure nagle doesn't interfere with sending all data as fast as possible: */
 669:./lwip-2.1.2/src/apps/http/httpd.c ****     altcp_nagle_disable(pcb);
 670:./lwip-2.1.2/src/apps/http/httpd.c ****   } else
 671:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SUPPORT_11_KEEPALIVE */
 672:./lwip-2.1.2/src/apps/http/httpd.c ****   {
 673:./lwip-2.1.2/src/apps/http/httpd.c ****     http_close_conn(pcb, hs);
 674:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 675:./lwip-2.1.2/src/apps/http/httpd.c **** }
 676:./lwip-2.1.2/src/apps/http/httpd.c **** 
 677:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_CGI || LWIP_HTTPD_CGI_SSI
 678:./lwip-2.1.2/src/apps/http/httpd.c **** /**
 679:./lwip-2.1.2/src/apps/http/httpd.c ****  * Extract URI parameters from the parameter-part of an URI in the form
 680:./lwip-2.1.2/src/apps/http/httpd.c ****  * "test.cgi?x=y" @todo: better explanation!
 681:./lwip-2.1.2/src/apps/http/httpd.c ****  * Pointers to the parameters are stored in hs->param_vals.
 682:./lwip-2.1.2/src/apps/http/httpd.c ****  *
 683:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param hs http connection state
 684:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param params pointer to the NULL-terminated parameter string from the URI
 685:./lwip-2.1.2/src/apps/http/httpd.c ****  * @return number of parameters extracted
 686:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 687:./lwip-2.1.2/src/apps/http/httpd.c **** static int
 688:./lwip-2.1.2/src/apps/http/httpd.c **** extract_uri_parameters(struct http_state *hs, char *params)
 689:./lwip-2.1.2/src/apps/http/httpd.c **** {
 690:./lwip-2.1.2/src/apps/http/httpd.c ****   char *pair;
 691:./lwip-2.1.2/src/apps/http/httpd.c ****   char *equals;
 692:./lwip-2.1.2/src/apps/http/httpd.c ****   int loop;
 693:./lwip-2.1.2/src/apps/http/httpd.c **** 
 694:./lwip-2.1.2/src/apps/http/httpd.c ****   LWIP_UNUSED_ARG(hs);
 695:./lwip-2.1.2/src/apps/http/httpd.c **** 
 696:./lwip-2.1.2/src/apps/http/httpd.c ****   /* If we have no parameters at all, return immediately. */
 697:./lwip-2.1.2/src/apps/http/httpd.c ****   if (!params || (params[0] == '\0')) {
 698:./lwip-2.1.2/src/apps/http/httpd.c ****     return (0);
 699:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 700:./lwip-2.1.2/src/apps/http/httpd.c **** 
 701:./lwip-2.1.2/src/apps/http/httpd.c ****   /* Get a pointer to our first parameter */
 702:./lwip-2.1.2/src/apps/http/httpd.c ****   pair = params;
 703:./lwip-2.1.2/src/apps/http/httpd.c **** 
 704:./lwip-2.1.2/src/apps/http/httpd.c ****   /* Parse up to LWIP_HTTPD_MAX_CGI_PARAMETERS from the passed string and ignore the
 705:./lwip-2.1.2/src/apps/http/httpd.c ****    * remainder (if any) */
 706:./lwip-2.1.2/src/apps/http/httpd.c ****   for (loop = 0; (loop < LWIP_HTTPD_MAX_CGI_PARAMETERS) && pair; loop++) {
 707:./lwip-2.1.2/src/apps/http/httpd.c **** 
 708:./lwip-2.1.2/src/apps/http/httpd.c ****     /* Save the name of the parameter */
 709:./lwip-2.1.2/src/apps/http/httpd.c ****     http_cgi_params[loop] = pair;
 710:./lwip-2.1.2/src/apps/http/httpd.c **** 
 711:./lwip-2.1.2/src/apps/http/httpd.c ****     /* Remember the start of this name=value pair */
 712:./lwip-2.1.2/src/apps/http/httpd.c ****     equals = pair;
 713:./lwip-2.1.2/src/apps/http/httpd.c **** 
 714:./lwip-2.1.2/src/apps/http/httpd.c ****     /* Find the start of the next name=value pair and replace the delimiter
 715:./lwip-2.1.2/src/apps/http/httpd.c ****      * with a 0 to terminate the previous pair string. */
 716:./lwip-2.1.2/src/apps/http/httpd.c ****     pair = strchr(pair, '&');
 717:./lwip-2.1.2/src/apps/http/httpd.c ****     if (pair) {
 718:./lwip-2.1.2/src/apps/http/httpd.c ****       *pair = '\0';
 719:./lwip-2.1.2/src/apps/http/httpd.c ****       pair++;
 720:./lwip-2.1.2/src/apps/http/httpd.c ****     } else {
 721:./lwip-2.1.2/src/apps/http/httpd.c ****       /* We didn't find a new parameter so find the end of the URI and
 722:./lwip-2.1.2/src/apps/http/httpd.c ****        * replace the space with a '\0' */
 723:./lwip-2.1.2/src/apps/http/httpd.c ****       pair = strchr(equals, ' ');
 724:./lwip-2.1.2/src/apps/http/httpd.c ****       if (pair) {
 725:./lwip-2.1.2/src/apps/http/httpd.c ****         *pair = '\0';
 726:./lwip-2.1.2/src/apps/http/httpd.c ****       }
 727:./lwip-2.1.2/src/apps/http/httpd.c **** 
 728:./lwip-2.1.2/src/apps/http/httpd.c ****       /* Revert to NULL so that we exit the loop as expected. */
 729:./lwip-2.1.2/src/apps/http/httpd.c ****       pair = NULL;
 730:./lwip-2.1.2/src/apps/http/httpd.c ****     }
 731:./lwip-2.1.2/src/apps/http/httpd.c **** 
 732:./lwip-2.1.2/src/apps/http/httpd.c ****     /* Now find the '=' in the previous pair, replace it with '\0' and save
 733:./lwip-2.1.2/src/apps/http/httpd.c ****      * the parameter value string. */
 734:./lwip-2.1.2/src/apps/http/httpd.c ****     equals = strchr(equals, '=');
 735:./lwip-2.1.2/src/apps/http/httpd.c ****     if (equals) {
 736:./lwip-2.1.2/src/apps/http/httpd.c ****       *equals = '\0';
 737:./lwip-2.1.2/src/apps/http/httpd.c ****       http_cgi_param_vals[loop] = equals + 1;
 738:./lwip-2.1.2/src/apps/http/httpd.c ****     } else {
 739:./lwip-2.1.2/src/apps/http/httpd.c ****       http_cgi_param_vals[loop] = NULL;
 740:./lwip-2.1.2/src/apps/http/httpd.c ****     }
 741:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 742:./lwip-2.1.2/src/apps/http/httpd.c **** 
 743:./lwip-2.1.2/src/apps/http/httpd.c ****   return loop;
 744:./lwip-2.1.2/src/apps/http/httpd.c **** }

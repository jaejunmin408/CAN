1021:./lwip-2.1.2/src/apps/http/httpd.c ****     /* How much of this can we send? */
1022:./lwip-2.1.2/src/apps/http/httpd.c ****     sendlen = (len < (hdrlen - hs->hdr_pos)) ? len : (hdrlen - hs->hdr_pos);

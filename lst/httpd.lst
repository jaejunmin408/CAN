 469:./lwip-2.1.2/src/apps/http/httpd.c ****     http_add_connection(ret);
 470:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 471:./lwip-2.1.2/src/apps/http/httpd.c ****   return ret;
 472:./lwip-2.1.2/src/apps/http/httpd.c **** }
 473:./lwip-2.1.2/src/apps/http/httpd.c **** 
 474:./lwip-2.1.2/src/apps/http/httpd.c **** /** Free a struct http_state.
 475:./lwip-2.1.2/src/apps/http/httpd.c ****  * Also frees the file data if dynamic.
 476:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 477:./lwip-2.1.2/src/apps/http/httpd.c **** static void
 478:./lwip-2.1.2/src/apps/http/httpd.c **** http_state_eof(struct http_state *hs)
 479:./lwip-2.1.2/src/apps/http/httpd.c **** {
 480:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs->handle) {
 481:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_TIMING
 482:./lwip-2.1.2/src/apps/http/httpd.c ****     u32_t ms_needed = sys_now() - hs->time_started;
 483:./lwip-2.1.2/src/apps/http/httpd.c ****     u32_t needed = LWIP_MAX(1, (ms_needed / 100));
 484:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_DEBUGF(HTTPD_DEBUG_TIMING, ("httpd: needed %"U32_F" ms to send file of %d bytes -> %"U32_F
 485:./lwip-2.1.2/src/apps/http/httpd.c ****                                      ms_needed, hs->handle->len, ((((u32_t)hs->handle->len) * 10) /
 486:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_TIMING */
 487:./lwip-2.1.2/src/apps/http/httpd.c ****     fs_close(hs->handle);
 488:./lwip-2.1.2/src/apps/http/httpd.c ****     hs->handle = NULL;
 489:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 490:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_DYNAMIC_FILE_READ
 491:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs->buf != NULL) {
 492:./lwip-2.1.2/src/apps/http/httpd.c ****     mem_free(hs->buf);
 493:./lwip-2.1.2/src/apps/http/httpd.c ****     hs->buf = NULL;
 494:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 495:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_DYNAMIC_FILE_READ */
 496:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SSI
 497:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs->ssi) {

 117:./lwip-2.1.2/src/apps/http/httpd.c **** /** Minimum length for a valid HTTP/0.9 request: "GET /\r\n" -> 7 bytes */
 118:./lwip-2.1.2/src/apps/http/httpd.c **** #define MIN_REQ_LEN   7
 119:./lwip-2.1.2/src/apps/http/httpd.c **** 
 120:./lwip-2.1.2/src/apps/http/httpd.c **** #define CRLF "\r\n"
 121:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_11_KEEPALIVE
 122:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP11_CONNECTIONKEEPALIVE  "Connection: keep-alive"
 123:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP11_CONNECTIONKEEPALIVE2 "Connection: Keep-Alive"
 124:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 125:./lwip-2.1.2/src/apps/http/httpd.c **** 
 126:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_DYNAMIC_FILE_READ
 127:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_DYNAMIC_FILE(hs) ((hs)->buf != NULL)
 128:./lwip-2.1.2/src/apps/http/httpd.c **** #else
 129:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_DYNAMIC_FILE(hs) 0
 130:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 131:./lwip-2.1.2/src/apps/http/httpd.c **** 
 132:./lwip-2.1.2/src/apps/http/httpd.c **** /* This defines checks whether tcp_write has to copy data or not */
 133:./lwip-2.1.2/src/apps/http/httpd.c **** 
 134:./lwip-2.1.2/src/apps/http/httpd.c **** #ifndef HTTP_IS_DATA_VOLATILE
 135:./lwip-2.1.2/src/apps/http/httpd.c **** /** tcp_write does not have to copy data when sent from rom-file-system directly */
 136:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_DATA_VOLATILE(hs)       (HTTP_IS_DYNAMIC_FILE(hs) ? TCP_WRITE_FLAG_COPY : 0)
 137:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 138:./lwip-2.1.2/src/apps/http/httpd.c **** /** Default: dynamic headers are sent from ROM (non-dynamic headers are handled like file data) */
 139:./lwip-2.1.2/src/apps/http/httpd.c **** #ifndef HTTP_IS_HDR_VOLATILE
 140:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_IS_HDR_VOLATILE(hs, ptr)   0
 141:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 142:./lwip-2.1.2/src/apps/http/httpd.c **** 
 143:./lwip-2.1.2/src/apps/http/httpd.c **** /* Return values for http_send_*() */
 144:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_DATA_TO_SEND_FREED    3
 145:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_DATA_TO_SEND_BREAK    2
 146:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_DATA_TO_SEND_CONTINUE 1
 147:./lwip-2.1.2/src/apps/http/httpd.c **** #define HTTP_NO_DATA_TO_SEND       0
 148:./lwip-2.1.2/src/apps/http/httpd.c **** 
 149:./lwip-2.1.2/src/apps/http/httpd.c **** typedef struct {
 150:./lwip-2.1.2/src/apps/http/httpd.c ****   const char *name;
 151:./lwip-2.1.2/src/apps/http/httpd.c ****   u8_t shtml;
 152:./lwip-2.1.2/src/apps/http/httpd.c **** } default_filename;
 153:./lwip-2.1.2/src/apps/http/httpd.c **** 
 154:./lwip-2.1.2/src/apps/http/httpd.c **** static const default_filename httpd_default_filenames[] = {
 155:./lwip-2.1.2/src/apps/http/httpd.c ****   {"/index.shtml", 1 },
 156:./lwip-2.1.2/src/apps/http/httpd.c ****   {"/index.ssi",   1 },
 157:./lwip-2.1.2/src/apps/http/httpd.c ****   {"/index.shtm",  1 },
 158:./lwip-2.1.2/src/apps/http/httpd.c ****   {"/index.html",  0 },
 159:./lwip-2.1.2/src/apps/http/httpd.c ****   {"/index.htm",   0 }
 160:./lwip-2.1.2/src/apps/http/httpd.c **** };
 161:./lwip-2.1.2/src/apps/http/httpd.c **** 
 162:./lwip-2.1.2/src/apps/http/httpd.c **** #define NUM_DEFAULT_FILENAMES LWIP_ARRAYSIZE(httpd_default_filenames)
 163:./lwip-2.1.2/src/apps/http/httpd.c **** 
 164:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_REQUESTLIST
 165:./lwip-2.1.2/src/apps/http/httpd.c **** /** HTTP request is copied here from pbufs for simple parsing */
 166:./lwip-2.1.2/src/apps/http/httpd.c **** static char httpd_req_buf[LWIP_HTTPD_MAX_REQ_LENGTH + 1];
 167:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SUPPORT_REQUESTLIST */
 168:./lwip-2.1.2/src/apps/http/httpd.c **** 
 169:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_POST
 170:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_POST_MAX_RESPONSE_URI_LEN > LWIP_HTTPD_MAX_REQUEST_URI_LEN
 171:./lwip-2.1.2/src/apps/http/httpd.c **** #define LWIP_HTTPD_URI_BUF_LEN LWIP_HTTPD_POST_MAX_RESPONSE_URI_LEN
 172:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 173:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 174:./lwip-2.1.2/src/apps/http/httpd.c **** #ifndef LWIP_HTTPD_URI_BUF_LEN
 175:./lwip-2.1.2/src/apps/http/httpd.c **** #define LWIP_HTTPD_URI_BUF_LEN LWIP_HTTPD_MAX_REQUEST_URI_LEN
 176:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 177:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_URI_BUF_LEN
 178:./lwip-2.1.2/src/apps/http/httpd.c **** /* Filename for response file to send when POST is finished or
 179:./lwip-2.1.2/src/apps/http/httpd.c ****  * search for default files when a directory is requested. */
 180:./lwip-2.1.2/src/apps/http/httpd.c **** static char http_uri_buf[LWIP_HTTPD_URI_BUF_LEN + 1];
 181:./lwip-2.1.2/src/apps/http/httpd.c **** #endif
 182:./lwip-2.1.2/src/apps/http/httpd.c **** 
 183:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_DYNAMIC_HEADERS
 184:./lwip-2.1.2/src/apps/http/httpd.c **** /* The number of individual strings that comprise the headers sent before each
 185:./lwip-2.1.2/src/apps/http/httpd.c ****  * requested file.
 186:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 187:./lwip-2.1.2/src/apps/http/httpd.c **** #define NUM_FILE_HDR_STRINGS 5

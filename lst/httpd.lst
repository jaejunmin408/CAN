 184:./lwip-2.1.2/src/apps/http/httpd.c **** /* The number of individual strings that comprise the headers sent before each
 185:./lwip-2.1.2/src/apps/http/httpd.c ****  * requested file.
 186:./lwip-2.1.2/src/apps/http/httpd.c ****  */
 187:./lwip-2.1.2/src/apps/http/httpd.c **** #define NUM_FILE_HDR_STRINGS 5
 188:./lwip-2.1.2/src/apps/http/httpd.c **** #define HDR_STRINGS_IDX_HTTP_STATUS           0 /* e.g. "HTTP/1.0 200 OK\r\n" */
 189:./lwip-2.1.2/src/apps/http/httpd.c **** #define HDR_STRINGS_IDX_SERVER_NAME           1 /* e.g. "Server: "HTTPD_SERVER_AGENT"\r\n" */
 190:./lwip-2.1.2/src/apps/http/httpd.c **** #define HDR_STRINGS_IDX_CONTENT_LEN_KEEPALIVE 2 /* e.g. "Content-Length: xy\r\n" and/or "Connection
 191:./lwip-2.1.2/src/apps/http/httpd.c **** #define HDR_STRINGS_IDX_CONTENT_LEN_NR        3 /* the byte count, when content-length is used */
 192:./lwip-2.1.2/src/apps/http/httpd.c **** #define HDR_STRINGS_IDX_CONTENT_TYPE          4 /* the content type (or default answer content type
 193:./lwip-2.1.2/src/apps/http/httpd.c **** 
 194:./lwip-2.1.2/src/apps/http/httpd.c **** /* The dynamically generated Content-Length buffer needs space for CRLF + NULL */
 195:./lwip-2.1.2/src/apps/http/httpd.c **** #define LWIP_HTTPD_MAX_CONTENT_LEN_OFFSET 3
 196:./lwip-2.1.2/src/apps/http/httpd.c **** #ifndef LWIP_HTTPD_MAX_CONTENT_LEN_SIZE
 197:./lwip-2.1.2/src/apps/http/httpd.c **** /* The dynamically generated Content-Length buffer shall be able to work with
 198:./lwip-2.1.2/src/apps/http/httpd.c ****    ~953 MB (9 digits) */

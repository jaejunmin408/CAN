 349:./lwip-2.1.2/src/apps/http/httpd.c **** /** global list of active HTTP connections, use to kill the oldest when
 350:./lwip-2.1.2/src/apps/http/httpd.c ****     running out of memory */
 351:./lwip-2.1.2/src/apps/http/httpd.c **** static struct http_state *http_connections;
 352:./lwip-2.1.2/src/apps/http/httpd.c **** 
 353:./lwip-2.1.2/src/apps/http/httpd.c **** static void
 354:./lwip-2.1.2/src/apps/http/httpd.c **** http_add_connection(struct http_state *hs)
 355:./lwip-2.1.2/src/apps/http/httpd.c **** {
 356:./lwip-2.1.2/src/apps/http/httpd.c ****   /* add the connection to the list */
 357:./lwip-2.1.2/src/apps/http/httpd.c ****   hs->next = http_connections;
 358:./lwip-2.1.2/src/apps/http/httpd.c ****   http_connections = hs;
 359:./lwip-2.1.2/src/apps/http/httpd.c **** }
 360:./lwip-2.1.2/src/apps/http/httpd.c **** 
 361:./lwip-2.1.2/src/apps/http/httpd.c **** static void
 362:./lwip-2.1.2/src/apps/http/httpd.c **** http_remove_connection(struct http_state *hs)
 363:./lwip-2.1.2/src/apps/http/httpd.c **** {
 364:./lwip-2.1.2/src/apps/http/httpd.c ****   /* take the connection off the list */
 365:./lwip-2.1.2/src/apps/http/httpd.c ****   if (http_connections) {
 366:./lwip-2.1.2/src/apps/http/httpd.c ****     if (http_connections == hs) {
 367:./lwip-2.1.2/src/apps/http/httpd.c ****       http_connections = hs->next;
 368:./lwip-2.1.2/src/apps/http/httpd.c ****     } else {
 369:./lwip-2.1.2/src/apps/http/httpd.c ****       struct http_state *last;
 370:./lwip-2.1.2/src/apps/http/httpd.c ****       for (last = http_connections; last->next != NULL; last = last->next) {
 371:./lwip-2.1.2/src/apps/http/httpd.c ****         if (last->next == hs) {
 372:./lwip-2.1.2/src/apps/http/httpd.c ****           last->next = hs->next;
 373:./lwip-2.1.2/src/apps/http/httpd.c ****           break;
 374:./lwip-2.1.2/src/apps/http/httpd.c ****         }
 375:./lwip-2.1.2/src/apps/http/httpd.c ****       }
 376:./lwip-2.1.2/src/apps/http/httpd.c ****     }
 377:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 378:./lwip-2.1.2/src/apps/http/httpd.c **** }
 379:./lwip-2.1.2/src/apps/http/httpd.c **** 
 380:./lwip-2.1.2/src/apps/http/httpd.c **** static void
 381:./lwip-2.1.2/src/apps/http/httpd.c **** http_kill_oldest_connection(u8_t ssi_required)
 382:./lwip-2.1.2/src/apps/http/httpd.c **** {
 383:./lwip-2.1.2/src/apps/http/httpd.c ****   struct http_state *hs = http_connections;
 384:./lwip-2.1.2/src/apps/http/httpd.c ****   struct http_state *hs_free_next = NULL;
 385:./lwip-2.1.2/src/apps/http/httpd.c ****   while (hs && hs->next) {
 386:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SSI
 387:./lwip-2.1.2/src/apps/http/httpd.c ****     if (ssi_required) {
 388:./lwip-2.1.2/src/apps/http/httpd.c ****       if (hs->next->ssi != NULL) {
 389:./lwip-2.1.2/src/apps/http/httpd.c ****         hs_free_next = hs;
 390:./lwip-2.1.2/src/apps/http/httpd.c ****       }
 391:./lwip-2.1.2/src/apps/http/httpd.c ****     } else
 392:./lwip-2.1.2/src/apps/http/httpd.c **** #else /* LWIP_HTTPD_SSI */
 393:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_UNUSED_ARG(ssi_required);
 394:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SSI */
 395:./lwip-2.1.2/src/apps/http/httpd.c ****     {
 396:./lwip-2.1.2/src/apps/http/httpd.c ****       hs_free_next = hs;
 397:./lwip-2.1.2/src/apps/http/httpd.c ****     }
 398:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_ASSERT("broken list", hs != hs->next);
 399:./lwip-2.1.2/src/apps/http/httpd.c ****     hs = hs->next;
 400:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 401:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs_free_next != NULL) {
 402:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_ASSERT("hs_free_next->next != NULL", hs_free_next->next != NULL);
 403:./lwip-2.1.2/src/apps/http/httpd.c ****     LWIP_ASSERT("hs_free_next->next->pcb != NULL", hs_free_next->next->pcb != NULL);
 404:./lwip-2.1.2/src/apps/http/httpd.c ****     /* send RST when killing a connection because of memory shortage */
 405:./lwip-2.1.2/src/apps/http/httpd.c ****     http_close_or_abort_conn(hs_free_next->next->pcb, hs_free_next->next, 1); /* this also unlinks 
 406:./lwip-2.1.2/src/apps/http/httpd.c ****   }
 407:./lwip-2.1.2/src/apps/http/httpd.c **** }
 408:./lwip-2.1.2/src/apps/http/httpd.c **** #else /* LWIP_HTTPD_KILL_OLD_ON_CONNECTIONS_EXCEEDED */

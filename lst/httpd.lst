1879:./lwip-2.1.2/src/apps/http/httpd.c **** /**
1880:./lwip-2.1.2/src/apps/http/httpd.c ****  * @ingroup httpd
1881:./lwip-2.1.2/src/apps/http/httpd.c ****  * A POST implementation can call this function to update the TCP window.
1882:./lwip-2.1.2/src/apps/http/httpd.c ****  * This can be used to throttle data reception (e.g. when received data is
1883:./lwip-2.1.2/src/apps/http/httpd.c ****  * programmed to flash and data is received faster than programmed).
1884:./lwip-2.1.2/src/apps/http/httpd.c ****  *
1885:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param connection A connection handle passed to httpd_post_begin for which
1886:./lwip-2.1.2/src/apps/http/httpd.c ****  *        httpd_post_finished has *NOT* been called yet!
1887:./lwip-2.1.2/src/apps/http/httpd.c ****  * @param recved_len Length of data received (for window update)
1888:./lwip-2.1.2/src/apps/http/httpd.c ****  */
1889:./lwip-2.1.2/src/apps/http/httpd.c **** void httpd_post_data_recved(void *connection, u16_t recved_len)
1890:./lwip-2.1.2/src/apps/http/httpd.c **** {
1891:./lwip-2.1.2/src/apps/http/httpd.c ****   struct http_state *hs = (struct http_state *)connection;
1892:./lwip-2.1.2/src/apps/http/httpd.c ****   if (hs != NULL) {
1893:./lwip-2.1.2/src/apps/http/httpd.c ****     if (hs->no_auto_wnd) {
1894:./lwip-2.1.2/src/apps/http/httpd.c ****       u16_t len = recved_len;
1895:./lwip-2.1.2/src/apps/http/httpd.c ****       if (hs->unrecved_bytes >= recved_len) {
1896:./lwip-2.1.2/src/apps/http/httpd.c ****         hs->unrecved_bytes -= recved_len;
1897:./lwip-2.1.2/src/apps/http/httpd.c ****       } else {
1898:./lwip-2.1.2/src/apps/http/httpd.c ****         LWIP_DEBUGF(HTTPD_DEBUG | LWIP_DBG_LEVEL_WARNING, ("httpd_post_data_recved: recved_len too 
1899:./lwip-2.1.2/src/apps/http/httpd.c ****         len = (u16_t)hs->unrecved_bytes;
1900:./lwip-2.1.2/src/apps/http/httpd.c ****         hs->unrecved_bytes = 0;
1901:./lwip-2.1.2/src/apps/http/httpd.c ****       }
1902:./lwip-2.1.2/src/apps/http/httpd.c ****       if (hs->pcb != NULL) {

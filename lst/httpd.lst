2005:./lwip-2.1.2/src/apps/http/httpd.c ****     }
2006:./lwip-2.1.2/src/apps/http/httpd.c ****   }
2007:./lwip-2.1.2/src/apps/http/httpd.c **** 
2008:./lwip-2.1.2/src/apps/http/httpd.c ****   /* received enough data for minimal request? */
2009:./lwip-2.1.2/src/apps/http/httpd.c ****   if (data_len >= MIN_REQ_LEN) {
2010:./lwip-2.1.2/src/apps/http/httpd.c ****     /* wait for CRLF before parsing anything */
2011:./lwip-2.1.2/src/apps/http/httpd.c ****     crlf = lwip_strnstr(data, CRLF, data_len);
2012:./lwip-2.1.2/src/apps/http/httpd.c ****     if (crlf != NULL) {
2013:./lwip-2.1.2/src/apps/http/httpd.c **** #if LWIP_HTTPD_SUPPORT_POST
2014:./lwip-2.1.2/src/apps/http/httpd.c ****       int is_post = 0;
2015:./lwip-2.1.2/src/apps/http/httpd.c **** #endif /* LWIP_HTTPD_SUPPORT_POST */
2016:./lwip-2.1.2/src/apps/http/httpd.c ****       int is_09 = 0;
2017:./lwip-2.1.2/src/apps/http/httpd.c ****       char *sp1, *sp2;
2018:./lwip-2.1.2/src/apps/http/httpd.c ****       u16_t left_len, uri_len;
2019:./lwip-2.1.2/src/apps/http/httpd.c ****       LWIP_DEBUGF(HTTPD_DEBUG | LWIP_DBG_TRACE, ("CRLF received, parsing request\n"));
2020:./lwip-2.1.2/src/apps/http/httpd.c ****       /* parse method */
2021:./lwip-2.1.2/src/apps/http/httpd.c ****       if (!strncmp(data, "GET ", 4)) {
2022:./lwip-2.1.2/src/apps/http/httpd.c ****         sp1 = data + 3;

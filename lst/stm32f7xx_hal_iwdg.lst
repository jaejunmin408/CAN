 114:./src/stm32f7xx_hal_iwdg.c **** 
 115:./src/stm32f7xx_hal_iwdg.c **** /* Private typedef -----------------------------------------------------------*/
 116:./src/stm32f7xx_hal_iwdg.c **** /* Private define ------------------------------------------------------------*/
 117:./src/stm32f7xx_hal_iwdg.c **** /** @defgroup IWDG_Private_Defines IWDG Private Defines
 118:./src/stm32f7xx_hal_iwdg.c ****   * @{
 119:./src/stm32f7xx_hal_iwdg.c ****   */
 120:./src/stm32f7xx_hal_iwdg.c **** /* Status register needs up to 5 LSI clock periods divided by the clock
 121:./src/stm32f7xx_hal_iwdg.c ****    prescaler to be updated. The number of LSI clock periods is upper-rounded to
 122:./src/stm32f7xx_hal_iwdg.c ****    6 for the timeout value calculation.
 123:./src/stm32f7xx_hal_iwdg.c ****    The timeout value is calculated using the highest prescaler (256) and
 124:./src/stm32f7xx_hal_iwdg.c ****    the LSI_VALUE constant. The value of this constant can be changed by the user
 125:./src/stm32f7xx_hal_iwdg.c ****    to take into account possible LSI clock period variations.
 126:./src/stm32f7xx_hal_iwdg.c ****    The timeout value is multiplied by 1000 to be converted in milliseconds.
 127:./src/stm32f7xx_hal_iwdg.c ****    LSI startup time is also considered here by adding LSI_STARTUP_TIME
 128:./src/stm32f7xx_hal_iwdg.c ****    converted in milliseconds. */
 129:./src/stm32f7xx_hal_iwdg.c **** #define LSI_STARTUP_TIME 40U /*!< LSI Maximum startup time in us */
 130:./src/stm32f7xx_hal_iwdg.c **** 
 131:./src/stm32f7xx_hal_iwdg.c **** #define HAL_IWDG_DEFAULT_TIMEOUT        (((6UL * 256UL * 1000UL) / (LSI_VALUE / 128U)) + \
 132:./src/stm32f7xx_hal_iwdg.c ****                                          ((LSI_STARTUP_TIME / 1000UL) + 1UL))
 133:./src/stm32f7xx_hal_iwdg.c **** #define IWDG_KERNEL_UPDATE_FLAGS        (IWDG_SR_WVU | IWDG_SR_RVU | IWDG_SR_PVU)
 134:./src/stm32f7xx_hal_iwdg.c **** /**
 135:./src/stm32f7xx_hal_iwdg.c ****   * @}
 136:./src/stm32f7xx_hal_iwdg.c ****   */
 137:./src/stm32f7xx_hal_iwdg.c **** 

  88:./src/stm32f7xx_hal.c **** /** @defgroup HAL_Exported_Functions_Group1 Initialization and de-initialization Functions 
  89:./src/stm32f7xx_hal.c ****  *  @brief    Initialization and de-initialization functions
  90:./src/stm32f7xx_hal.c ****  *
  91:./src/stm32f7xx_hal.c **** @verbatim    
  92:./src/stm32f7xx_hal.c ****  ===============================================================================
  93:./src/stm32f7xx_hal.c ****               ##### Initialization and Configuration functions #####
  94:./src/stm32f7xx_hal.c ****  ===============================================================================
  95:./src/stm32f7xx_hal.c ****     [..]  This section provides functions allowing to:
  96:./src/stm32f7xx_hal.c ****       (+) Initializes the Flash interface the NVIC allocation and initial clock 
  97:./src/stm32f7xx_hal.c ****           configuration. It initializes the systick also when timeout is needed 
  98:./src/stm32f7xx_hal.c ****           and the backup domain when enabled.
  99:./src/stm32f7xx_hal.c ****       (+) De-Initializes common part of the HAL.
 100:./src/stm32f7xx_hal.c ****       (+) Configure the time base source to have 1ms time base with a dedicated 
 101:./src/stm32f7xx_hal.c ****           Tick interrupt priority. 
 102:./src/stm32f7xx_hal.c ****         (++) SysTick timer is used by default as source of time base, but user
 103:./src/stm32f7xx_hal.c ****              can eventually implement his proper time base source (a general purpose 
 104:./src/stm32f7xx_hal.c ****              timer for example or other time source), keeping in mind that Time base 
 105:./src/stm32f7xx_hal.c ****              duration should be kept 1ms since PPP_TIMEOUT_VALUEs are defined and 
 106:./src/stm32f7xx_hal.c ****              handled in milliseconds basis.
 107:./src/stm32f7xx_hal.c ****         (++) Time base configuration function (HAL_InitTick ()) is called automatically 
 108:./src/stm32f7xx_hal.c ****              at the beginning of the program after reset by HAL_Init() or at any time 
 109:./src/stm32f7xx_hal.c ****              when clock is configured, by HAL_RCC_ClockConfig(). 
 110:./src/stm32f7xx_hal.c ****         (++) Source of time base is configured  to generate interrupts at regular 
 111:./src/stm32f7xx_hal.c ****              time intervals. Care must be taken if HAL_Delay() is called from a 
 112:./src/stm32f7xx_hal.c ****              peripheral ISR process, the Tick interrupt line must have higher priority 
 113:./src/stm32f7xx_hal.c ****             (numerically lower) than the peripheral interrupt. Otherwise the caller 
 114:./src/stm32f7xx_hal.c ****             ISR process will be blocked. 
 115:./src/stm32f7xx_hal.c ****        (++) functions affecting time base configurations are declared as __weak  
 116:./src/stm32f7xx_hal.c ****              to make  override possible  in case of other  implementations in user file.
 117:./src/stm32f7xx_hal.c **** @endverbatim
 118:./src/stm32f7xx_hal.c ****   * @{
 119:./src/stm32f7xx_hal.c ****   */
 120:./src/stm32f7xx_hal.c **** 
 121:./src/stm32f7xx_hal.c **** /**
 122:./src/stm32f7xx_hal.c ****   * @brief  This function is used to initialize the HAL Library; it must be the first 
 123:./src/stm32f7xx_hal.c ****   *         instruction to be executed in the main program (before to call any other
 124:./src/stm32f7xx_hal.c ****   *         HAL function), it performs the following:
 125:./src/stm32f7xx_hal.c ****   *           Configure the Flash prefetch, and instruction cache through ART accelerator.
 126:./src/stm32f7xx_hal.c ****   *           Configures the SysTick to generate an interrupt each 1 millisecond,
 127:./src/stm32f7xx_hal.c ****   *           which is clocked by the HSI (at this stage, the clock is not yet
 128:./src/stm32f7xx_hal.c ****   *           configured and thus the system is running from the internal HSI at 16 MHz).
 129:./src/stm32f7xx_hal.c ****   *           Set NVIC Group Priority to 4.
 130:./src/stm32f7xx_hal.c ****   *           Calls the HAL_MspInit() callback function defined in user file 
 131:./src/stm32f7xx_hal.c ****   *           "stm32f7xx_hal_msp.c" to do the global low level hardware initialization 
 132:./src/stm32f7xx_hal.c ****   *            
 133:./src/stm32f7xx_hal.c ****   * @note   SysTick is used as time base for the HAL_Delay() function, the application
 134:./src/stm32f7xx_hal.c ****   *         need to ensure that the SysTick time base is always set to 1 millisecond
 135:./src/stm32f7xx_hal.c ****   *         to have correct HAL operation.
 136:./src/stm32f7xx_hal.c ****   * @retval HAL status
 137:./src/stm32f7xx_hal.c ****   */
 138:./src/stm32f7xx_hal.c **** HAL_StatusTypeDef HAL_Init(void)
 139:./src/stm32f7xx_hal.c **** {
 140:./src/stm32f7xx_hal.c ****   /* Configure Instruction cache through ART accelerator */ 
 141:./src/stm32f7xx_hal.c **** #if (ART_ACCLERATOR_ENABLE != 0)
 142:./src/stm32f7xx_hal.c ****    __HAL_FLASH_ART_ENABLE();
 143:./src/stm32f7xx_hal.c **** #endif /* ART_ACCLERATOR_ENABLE */
 144:./src/stm32f7xx_hal.c **** 
 145:./src/stm32f7xx_hal.c ****   /* Configure Flash prefetch */
 146:./src/stm32f7xx_hal.c **** #if (PREFETCH_ENABLE != 0U)
 147:./src/stm32f7xx_hal.c ****   __HAL_FLASH_PREFETCH_BUFFER_ENABLE();
 148:./src/stm32f7xx_hal.c **** #endif /* PREFETCH_ENABLE */
 149:./src/stm32f7xx_hal.c **** 
 150:./src/stm32f7xx_hal.c ****   /* Set Interrupt Group Priority */
 151:./src/stm32f7xx_hal.c ****   HAL_NVIC_SetPriorityGrouping(NVIC_PRIORITYGROUP_4);
 152:./src/stm32f7xx_hal.c **** 
 153:./src/stm32f7xx_hal.c ****   /* Use systick as time base source and configure 1ms tick (default clock after Reset is HSI) */
 154:./src/stm32f7xx_hal.c ****   HAL_InitTick(TICK_INT_PRIORITY);
 155:./src/stm32f7xx_hal.c ****   
 156:./src/stm32f7xx_hal.c ****   /* Init the low level hardware */
 157:./src/stm32f7xx_hal.c ****   HAL_MspInit();
 158:./src/stm32f7xx_hal.c ****   
 159:./src/stm32f7xx_hal.c ****   /* Return function status */
 160:./src/stm32f7xx_hal.c ****   return HAL_OK;
 161:./src/stm32f7xx_hal.c **** }
 162:./src/stm32f7xx_hal.c **** 

 208:./lwip-2.1.2/src/core/tcp.c **** /** Free a tcp pcb */
 209:./lwip-2.1.2/src/core/tcp.c **** void
 210:./lwip-2.1.2/src/core/tcp.c **** tcp_free(struct tcp_pcb *pcb)
 211:./lwip-2.1.2/src/core/tcp.c **** {
 212:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_free: LISTEN", pcb->state != LISTEN);
 213:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_TCP_PCB_NUM_EXT_ARGS
 214:./lwip-2.1.2/src/core/tcp.c ****   tcp_ext_arg_invoke_callbacks_destroyed(pcb->ext_args);
 215:./lwip-2.1.2/src/core/tcp.c **** #endif
 216:./lwip-2.1.2/src/core/tcp.c ****   memp_free(MEMP_TCP_PCB, pcb);
 217:./lwip-2.1.2/src/core/tcp.c **** }
 218:./lwip-2.1.2/src/core/tcp.c **** 
 219:./lwip-2.1.2/src/core/tcp.c **** /** Free a tcp listen pcb */
 220:./lwip-2.1.2/src/core/tcp.c **** static void
 221:./lwip-2.1.2/src/core/tcp.c **** tcp_free_listen(struct tcp_pcb *pcb)
 222:./lwip-2.1.2/src/core/tcp.c **** {
 223:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_free_listen: !LISTEN", pcb->state != LISTEN);
 224:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_TCP_PCB_NUM_EXT_ARGS
 225:./lwip-2.1.2/src/core/tcp.c ****   tcp_ext_arg_invoke_callbacks_destroyed(pcb->ext_args);
 226:./lwip-2.1.2/src/core/tcp.c **** #endif
 227:./lwip-2.1.2/src/core/tcp.c ****   memp_free(MEMP_TCP_PCB_LISTEN, pcb);
 228:./lwip-2.1.2/src/core/tcp.c **** }
 229:./lwip-2.1.2/src/core/tcp.c **** 
 230:./lwip-2.1.2/src/core/tcp.c **** /**
 231:./lwip-2.1.2/src/core/tcp.c ****  * Called periodically to dispatch TCP timers.
 232:./lwip-2.1.2/src/core/tcp.c ****  */
 233:./lwip-2.1.2/src/core/tcp.c **** void
 234:./lwip-2.1.2/src/core/tcp.c **** tcp_tmr(void)
 235:./lwip-2.1.2/src/core/tcp.c **** {
 236:./lwip-2.1.2/src/core/tcp.c ****   /* Call tcp_fasttmr() every 250 ms */
 237:./lwip-2.1.2/src/core/tcp.c ****   tcp_fasttmr();
 238:./lwip-2.1.2/src/core/tcp.c **** 
 239:./lwip-2.1.2/src/core/tcp.c ****   if (++tcp_timer & 1) {
 240:./lwip-2.1.2/src/core/tcp.c ****     /* Call tcp_slowtmr() every 500 ms, i.e., every other timer
 241:./lwip-2.1.2/src/core/tcp.c ****        tcp_tmr() is called. */
 242:./lwip-2.1.2/src/core/tcp.c ****     tcp_slowtmr();
 243:./lwip-2.1.2/src/core/tcp.c ****   }
 244:./lwip-2.1.2/src/core/tcp.c **** }
 245:./lwip-2.1.2/src/core/tcp.c **** 
 246:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API || TCP_LISTEN_BACKLOG
 247:./lwip-2.1.2/src/core/tcp.c **** /** Called when a listen pcb is closed. Iterates one pcb list and removes the
 248:./lwip-2.1.2/src/core/tcp.c ****  * closed listener pcb from pcb->listener if matching.
 249:./lwip-2.1.2/src/core/tcp.c ****  */
 250:./lwip-2.1.2/src/core/tcp.c **** static void
 251:./lwip-2.1.2/src/core/tcp.c **** tcp_remove_listener(struct tcp_pcb *list, struct tcp_pcb_listen *lpcb)
 252:./lwip-2.1.2/src/core/tcp.c **** {
 253:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb;
 254:./lwip-2.1.2/src/core/tcp.c **** 
 255:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_remove_listener: invalid listener", lpcb != NULL);
 256:./lwip-2.1.2/src/core/tcp.c **** 
 257:./lwip-2.1.2/src/core/tcp.c ****   for (pcb = list; pcb != NULL; pcb = pcb->next) {
 258:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->listener == lpcb) {
 259:./lwip-2.1.2/src/core/tcp.c ****       pcb->listener = NULL;
 260:./lwip-2.1.2/src/core/tcp.c ****     }
 261:./lwip-2.1.2/src/core/tcp.c ****   }
 262:./lwip-2.1.2/src/core/tcp.c **** }
 263:./lwip-2.1.2/src/core/tcp.c **** #endif
 264:./lwip-2.1.2/src/core/tcp.c **** 
 265:./lwip-2.1.2/src/core/tcp.c **** /** Called when a listen pcb is closed. Iterates all pcb lists and removes the
 266:./lwip-2.1.2/src/core/tcp.c ****  * closed listener pcb from pcb->listener if matching.
 267:./lwip-2.1.2/src/core/tcp.c ****  */
 268:./lwip-2.1.2/src/core/tcp.c **** static void
 269:./lwip-2.1.2/src/core/tcp.c **** tcp_listen_closed(struct tcp_pcb *pcb)
 270:./lwip-2.1.2/src/core/tcp.c **** {
 271:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API || TCP_LISTEN_BACKLOG
 272:./lwip-2.1.2/src/core/tcp.c ****   size_t i;
 273:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("pcb != NULL", pcb != NULL);
 274:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("pcb->state == LISTEN", pcb->state == LISTEN);
 275:./lwip-2.1.2/src/core/tcp.c ****   for (i = 1; i < LWIP_ARRAYSIZE(tcp_pcb_lists); i++) {
 276:./lwip-2.1.2/src/core/tcp.c ****     tcp_remove_listener(*tcp_pcb_lists[i], (struct tcp_pcb_listen *)pcb);
 277:./lwip-2.1.2/src/core/tcp.c ****   }
 278:./lwip-2.1.2/src/core/tcp.c **** #endif
 279:./lwip-2.1.2/src/core/tcp.c ****   LWIP_UNUSED_ARG(pcb);
 280:./lwip-2.1.2/src/core/tcp.c **** }
 281:./lwip-2.1.2/src/core/tcp.c **** 
 282:./lwip-2.1.2/src/core/tcp.c **** #if TCP_LISTEN_BACKLOG
 283:./lwip-2.1.2/src/core/tcp.c **** /** @ingroup tcp_raw
 284:./lwip-2.1.2/src/core/tcp.c ****  * Delay accepting a connection in respect to the listen backlog:
 285:./lwip-2.1.2/src/core/tcp.c ****  * the number of outstanding connections is increased until
 286:./lwip-2.1.2/src/core/tcp.c ****  * tcp_backlog_accepted() is called.
 287:./lwip-2.1.2/src/core/tcp.c ****  *
 288:./lwip-2.1.2/src/core/tcp.c ****  * ATTENTION: the caller is responsible for calling tcp_backlog_accepted()
 289:./lwip-2.1.2/src/core/tcp.c ****  * or else the backlog feature will get out of sync!
 290:./lwip-2.1.2/src/core/tcp.c ****  *
 291:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the connection pcb which is not fully accepted yet
 292:./lwip-2.1.2/src/core/tcp.c ****  */
 293:./lwip-2.1.2/src/core/tcp.c **** void
 294:./lwip-2.1.2/src/core/tcp.c **** tcp_backlog_delayed(struct tcp_pcb *pcb)
 295:./lwip-2.1.2/src/core/tcp.c **** {
 296:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("pcb != NULL", pcb != NULL);
 297:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 298:./lwip-2.1.2/src/core/tcp.c ****   if ((pcb->flags & TF_BACKLOGPEND) == 0) {
 299:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->listener != NULL) {
 300:./lwip-2.1.2/src/core/tcp.c ****       pcb->listener->accepts_pending++;
 301:./lwip-2.1.2/src/core/tcp.c ****       LWIP_ASSERT("accepts_pending != 0", pcb->listener->accepts_pending != 0);
 302:./lwip-2.1.2/src/core/tcp.c ****       tcp_set_flags(pcb, TF_BACKLOGPEND);
 303:./lwip-2.1.2/src/core/tcp.c ****     }
 304:./lwip-2.1.2/src/core/tcp.c ****   }
 305:./lwip-2.1.2/src/core/tcp.c **** }
 306:./lwip-2.1.2/src/core/tcp.c **** 
 307:./lwip-2.1.2/src/core/tcp.c **** /** @ingroup tcp_raw
 308:./lwip-2.1.2/src/core/tcp.c ****  * A delayed-accept a connection is accepted (or closed/aborted): decreases
 309:./lwip-2.1.2/src/core/tcp.c ****  * the number of outstanding connections after calling tcp_backlog_delayed().
 310:./lwip-2.1.2/src/core/tcp.c ****  *
 311:./lwip-2.1.2/src/core/tcp.c ****  * ATTENTION: the caller is responsible for calling tcp_backlog_accepted()
 312:./lwip-2.1.2/src/core/tcp.c ****  * or else the backlog feature will get out of sync!
 313:./lwip-2.1.2/src/core/tcp.c ****  *
 314:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the connection pcb which is now fully accepted (or closed/aborted)
 315:./lwip-2.1.2/src/core/tcp.c ****  */
 316:./lwip-2.1.2/src/core/tcp.c **** void
 317:./lwip-2.1.2/src/core/tcp.c **** tcp_backlog_accepted(struct tcp_pcb *pcb)
 318:./lwip-2.1.2/src/core/tcp.c **** {
 319:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("pcb != NULL", pcb != NULL);
 320:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 321:./lwip-2.1.2/src/core/tcp.c ****   if ((pcb->flags & TF_BACKLOGPEND) != 0) {
 322:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->listener != NULL) {
 323:./lwip-2.1.2/src/core/tcp.c ****       LWIP_ASSERT("accepts_pending != 0", pcb->listener->accepts_pending != 0);
 324:./lwip-2.1.2/src/core/tcp.c ****       pcb->listener->accepts_pending--;
 325:./lwip-2.1.2/src/core/tcp.c ****       tcp_clear_flags(pcb, TF_BACKLOGPEND);
 326:./lwip-2.1.2/src/core/tcp.c ****     }
 327:./lwip-2.1.2/src/core/tcp.c ****   }
 328:./lwip-2.1.2/src/core/tcp.c **** }
 329:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_LISTEN_BACKLOG */
 330:./lwip-2.1.2/src/core/tcp.c **** 
 331:./lwip-2.1.2/src/core/tcp.c **** /**
 332:./lwip-2.1.2/src/core/tcp.c ****  * Closes the TX side of a connection held by the PCB.
 333:./lwip-2.1.2/src/core/tcp.c ****  * For tcp_close(), a RST is sent if the application didn't receive all data
 334:./lwip-2.1.2/src/core/tcp.c ****  * (tcp_recved() not called for all data passed to recv callback).
 335:./lwip-2.1.2/src/core/tcp.c ****  *
 336:./lwip-2.1.2/src/core/tcp.c ****  * Listening pcbs are freed and may not be referenced any more.
 337:./lwip-2.1.2/src/core/tcp.c ****  * Connection pcbs are freed if not yet connected and may not be referenced
 338:./lwip-2.1.2/src/core/tcp.c ****  * any more. If a connection is established (at least SYN received or in
 339:./lwip-2.1.2/src/core/tcp.c ****  * a closing state), the connection is closed, and put in a closing state.
 340:./lwip-2.1.2/src/core/tcp.c ****  * The pcb is then automatically freed in tcp_slowtmr(). It is therefore
 341:./lwip-2.1.2/src/core/tcp.c ****  * unsafe to reference it.
 342:./lwip-2.1.2/src/core/tcp.c ****  *
 343:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the tcp_pcb to close
 344:./lwip-2.1.2/src/core/tcp.c ****  * @return ERR_OK if connection has been closed
 345:./lwip-2.1.2/src/core/tcp.c ****  *         another err_t if closing failed and pcb is not freed
 346:./lwip-2.1.2/src/core/tcp.c ****  */
 347:./lwip-2.1.2/src/core/tcp.c **** static err_t
 348:./lwip-2.1.2/src/core/tcp.c **** tcp_close_shutdown(struct tcp_pcb *pcb, u8_t rst_on_unacked_data)
 349:./lwip-2.1.2/src/core/tcp.c **** {
 350:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_close_shutdown: invalid pcb", pcb != NULL);
 351:./lwip-2.1.2/src/core/tcp.c **** 
 352:./lwip-2.1.2/src/core/tcp.c ****   if (rst_on_unacked_data && ((pcb->state == ESTABLISHED) || (pcb->state == CLOSE_WAIT))) {
 353:./lwip-2.1.2/src/core/tcp.c ****     if ((pcb->refused_data != NULL) || (pcb->rcv_wnd != TCP_WND_MAX(pcb))) {
 354:./lwip-2.1.2/src/core/tcp.c ****       /* Not all data received by application, send RST to tell the remote
 355:./lwip-2.1.2/src/core/tcp.c ****          side about this. */
 356:./lwip-2.1.2/src/core/tcp.c ****       LWIP_ASSERT("pcb->flags & TF_RXCLOSED", pcb->flags & TF_RXCLOSED);
 357:./lwip-2.1.2/src/core/tcp.c **** 
 358:./lwip-2.1.2/src/core/tcp.c ****       /* don't call tcp_abort here: we must not deallocate the pcb since
 359:./lwip-2.1.2/src/core/tcp.c ****          that might not be expected when calling tcp_close */
 360:./lwip-2.1.2/src/core/tcp.c ****       tcp_rst(pcb, pcb->snd_nxt, pcb->rcv_nxt, &pcb->local_ip, &pcb->remote_ip,
 361:./lwip-2.1.2/src/core/tcp.c ****               pcb->local_port, pcb->remote_port);
 362:./lwip-2.1.2/src/core/tcp.c **** 
 363:./lwip-2.1.2/src/core/tcp.c ****       tcp_pcb_purge(pcb);
 364:./lwip-2.1.2/src/core/tcp.c ****       TCP_RMV_ACTIVE(pcb);
 365:./lwip-2.1.2/src/core/tcp.c ****       /* Deallocate the pcb since we already sent a RST for it */
 366:./lwip-2.1.2/src/core/tcp.c ****       if (tcp_input_pcb == pcb) {
 367:./lwip-2.1.2/src/core/tcp.c ****         /* prevent using a deallocated pcb: free it from tcp_input later */
 368:./lwip-2.1.2/src/core/tcp.c ****         tcp_trigger_input_pcb_close();
 369:./lwip-2.1.2/src/core/tcp.c ****       } else {
 370:./lwip-2.1.2/src/core/tcp.c ****         tcp_free(pcb);
 371:./lwip-2.1.2/src/core/tcp.c ****       }
 372:./lwip-2.1.2/src/core/tcp.c ****       return ERR_OK;
 373:./lwip-2.1.2/src/core/tcp.c ****     }
 374:./lwip-2.1.2/src/core/tcp.c ****   }
 375:./lwip-2.1.2/src/core/tcp.c **** 
 376:./lwip-2.1.2/src/core/tcp.c ****   /* - states which free the pcb are handled here,
 377:./lwip-2.1.2/src/core/tcp.c ****      - states which send FIN and change state are handled in tcp_close_shutdown_fin() */
 378:./lwip-2.1.2/src/core/tcp.c ****   switch (pcb->state) {
 379:./lwip-2.1.2/src/core/tcp.c ****     case CLOSED:
 380:./lwip-2.1.2/src/core/tcp.c ****       /* Closing a pcb in the CLOSED state might seem erroneous,
 381:./lwip-2.1.2/src/core/tcp.c ****        * however, it is in this state once allocated and as yet unused
 382:./lwip-2.1.2/src/core/tcp.c ****        * and the user needs some way to free it should the need arise.
 383:./lwip-2.1.2/src/core/tcp.c ****        * Calling tcp_close() with a pcb that has already been closed, (i.e. twice)
 384:./lwip-2.1.2/src/core/tcp.c ****        * or for a pcb that has been used and then entered the CLOSED state
 385:./lwip-2.1.2/src/core/tcp.c ****        * is erroneous, but this should never happen as the pcb has in those cases
 386:./lwip-2.1.2/src/core/tcp.c ****        * been freed, and so any remaining handles are bogus. */
 387:./lwip-2.1.2/src/core/tcp.c ****       if (pcb->local_port != 0) {
 388:./lwip-2.1.2/src/core/tcp.c ****         TCP_RMV(&tcp_bound_pcbs, pcb);
 389:./lwip-2.1.2/src/core/tcp.c ****       }
 390:./lwip-2.1.2/src/core/tcp.c ****       tcp_free(pcb);
 391:./lwip-2.1.2/src/core/tcp.c ****       break;
 392:./lwip-2.1.2/src/core/tcp.c ****     case LISTEN:
 393:./lwip-2.1.2/src/core/tcp.c ****       tcp_listen_closed(pcb);
 394:./lwip-2.1.2/src/core/tcp.c ****       tcp_pcb_remove(&tcp_listen_pcbs.pcbs, pcb);
 395:./lwip-2.1.2/src/core/tcp.c ****       tcp_free_listen(pcb);
 396:./lwip-2.1.2/src/core/tcp.c ****       break;
 397:./lwip-2.1.2/src/core/tcp.c ****     case SYN_SENT:
 398:./lwip-2.1.2/src/core/tcp.c ****       TCP_PCB_REMOVE_ACTIVE(pcb);
 399:./lwip-2.1.2/src/core/tcp.c ****       tcp_free(pcb);
 400:./lwip-2.1.2/src/core/tcp.c ****       MIB2_STATS_INC(mib2.tcpattemptfails);
 401:./lwip-2.1.2/src/core/tcp.c ****       break;
 402:./lwip-2.1.2/src/core/tcp.c ****     default:
 403:./lwip-2.1.2/src/core/tcp.c ****       return tcp_close_shutdown_fin(pcb);
 404:./lwip-2.1.2/src/core/tcp.c ****   }
 405:./lwip-2.1.2/src/core/tcp.c ****   return ERR_OK;
 406:./lwip-2.1.2/src/core/tcp.c **** }
 407:./lwip-2.1.2/src/core/tcp.c **** 
 408:./lwip-2.1.2/src/core/tcp.c **** static err_t
 409:./lwip-2.1.2/src/core/tcp.c **** tcp_close_shutdown_fin(struct tcp_pcb *pcb)
 410:./lwip-2.1.2/src/core/tcp.c **** {
 411:./lwip-2.1.2/src/core/tcp.c ****   err_t err;
 412:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("pcb != NULL", pcb != NULL);
 413:./lwip-2.1.2/src/core/tcp.c **** 
 414:./lwip-2.1.2/src/core/tcp.c ****   switch (pcb->state) {
 415:./lwip-2.1.2/src/core/tcp.c ****     case SYN_RCVD:
 416:./lwip-2.1.2/src/core/tcp.c ****       err = tcp_send_fin(pcb);
 417:./lwip-2.1.2/src/core/tcp.c ****       if (err == ERR_OK) {
 418:./lwip-2.1.2/src/core/tcp.c ****         tcp_backlog_accepted(pcb);
 419:./lwip-2.1.2/src/core/tcp.c ****         MIB2_STATS_INC(mib2.tcpattemptfails);
 420:./lwip-2.1.2/src/core/tcp.c ****         pcb->state = FIN_WAIT_1;
 421:./lwip-2.1.2/src/core/tcp.c ****       }
 422:./lwip-2.1.2/src/core/tcp.c ****       break;
 423:./lwip-2.1.2/src/core/tcp.c ****     case ESTABLISHED:
 424:./lwip-2.1.2/src/core/tcp.c ****       err = tcp_send_fin(pcb);
 425:./lwip-2.1.2/src/core/tcp.c ****       if (err == ERR_OK) {
 426:./lwip-2.1.2/src/core/tcp.c ****         MIB2_STATS_INC(mib2.tcpestabresets);
 427:./lwip-2.1.2/src/core/tcp.c ****         pcb->state = FIN_WAIT_1;
 428:./lwip-2.1.2/src/core/tcp.c ****       }
 429:./lwip-2.1.2/src/core/tcp.c ****       break;
 430:./lwip-2.1.2/src/core/tcp.c ****     case CLOSE_WAIT:
 431:./lwip-2.1.2/src/core/tcp.c ****       err = tcp_send_fin(pcb);
 432:./lwip-2.1.2/src/core/tcp.c ****       if (err == ERR_OK) {
 433:./lwip-2.1.2/src/core/tcp.c ****         MIB2_STATS_INC(mib2.tcpestabresets);
 434:./lwip-2.1.2/src/core/tcp.c ****         pcb->state = LAST_ACK;
 435:./lwip-2.1.2/src/core/tcp.c ****       }
 436:./lwip-2.1.2/src/core/tcp.c ****       break;
 437:./lwip-2.1.2/src/core/tcp.c ****     default:
 438:./lwip-2.1.2/src/core/tcp.c ****       /* Has already been closed, do nothing. */
 439:./lwip-2.1.2/src/core/tcp.c ****       return ERR_OK;
 440:./lwip-2.1.2/src/core/tcp.c ****   }
 441:./lwip-2.1.2/src/core/tcp.c **** 
 442:./lwip-2.1.2/src/core/tcp.c ****   if (err == ERR_OK) {
 443:./lwip-2.1.2/src/core/tcp.c ****     /* To ensure all data has been sent when tcp_close returns, we have
 444:./lwip-2.1.2/src/core/tcp.c ****        to make sure tcp_output doesn't fail.
 445:./lwip-2.1.2/src/core/tcp.c ****        Since we don't really have to ensure all data has been sent when tcp_close
 446:./lwip-2.1.2/src/core/tcp.c ****        returns (unsent data is sent from tcp timer functions, also), we don't care
 447:./lwip-2.1.2/src/core/tcp.c ****        for the return value of tcp_output for now. */
 448:./lwip-2.1.2/src/core/tcp.c ****     tcp_output(pcb);
 449:./lwip-2.1.2/src/core/tcp.c ****   } else if (err == ERR_MEM) {
 450:./lwip-2.1.2/src/core/tcp.c ****     /* Mark this pcb for closing. Closing is retried from tcp_tmr. */
 451:./lwip-2.1.2/src/core/tcp.c ****     tcp_set_flags(pcb, TF_CLOSEPEND);
 452:./lwip-2.1.2/src/core/tcp.c ****     /* We have to return ERR_OK from here to indicate to the callers that this
 453:./lwip-2.1.2/src/core/tcp.c ****        pcb should not be used any more as it will be freed soon via tcp_tmr.
 454:./lwip-2.1.2/src/core/tcp.c ****        This is OK here since sending FIN does not guarantee a time frime for
 455:./lwip-2.1.2/src/core/tcp.c ****        actually freeing the pcb, either (it is left in closure states for
 456:./lwip-2.1.2/src/core/tcp.c ****        remote ACK or timeout) */
 457:./lwip-2.1.2/src/core/tcp.c ****     return ERR_OK;
 458:./lwip-2.1.2/src/core/tcp.c ****   }
 459:./lwip-2.1.2/src/core/tcp.c ****   return err;
 460:./lwip-2.1.2/src/core/tcp.c **** }
 461:./lwip-2.1.2/src/core/tcp.c **** 
 462:./lwip-2.1.2/src/core/tcp.c **** /**
 463:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
 464:./lwip-2.1.2/src/core/tcp.c ****  * Closes the connection held by the PCB.
 465:./lwip-2.1.2/src/core/tcp.c ****  *
 466:./lwip-2.1.2/src/core/tcp.c ****  * Listening pcbs are freed and may not be referenced any more.
 467:./lwip-2.1.2/src/core/tcp.c ****  * Connection pcbs are freed if not yet connected and may not be referenced
 468:./lwip-2.1.2/src/core/tcp.c ****  * any more. If a connection is established (at least SYN received or in
 469:./lwip-2.1.2/src/core/tcp.c ****  * a closing state), the connection is closed, and put in a closing state.
 470:./lwip-2.1.2/src/core/tcp.c ****  * The pcb is then automatically freed in tcp_slowtmr(). It is therefore
 471:./lwip-2.1.2/src/core/tcp.c ****  * unsafe to reference it (unless an error is returned).
 472:./lwip-2.1.2/src/core/tcp.c ****  * 
 473:./lwip-2.1.2/src/core/tcp.c ****  * The function may return ERR_MEM if no memory
 474:./lwip-2.1.2/src/core/tcp.c ****  * was available for closing the connection. If so, the application
 475:./lwip-2.1.2/src/core/tcp.c ****  * should wait and try again either by using the acknowledgment
 476:./lwip-2.1.2/src/core/tcp.c ****  * callback or the polling functionality. If the close succeeds, the
 477:./lwip-2.1.2/src/core/tcp.c ****  * function returns ERR_OK.
 478:./lwip-2.1.2/src/core/tcp.c ****  *
 479:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the tcp_pcb to close
 480:./lwip-2.1.2/src/core/tcp.c ****  * @return ERR_OK if connection has been closed
 481:./lwip-2.1.2/src/core/tcp.c ****  *         another err_t if closing failed and pcb is not freed
 482:./lwip-2.1.2/src/core/tcp.c ****  */
 483:./lwip-2.1.2/src/core/tcp.c **** err_t
 484:./lwip-2.1.2/src/core/tcp.c **** tcp_close(struct tcp_pcb *pcb)
 485:./lwip-2.1.2/src/core/tcp.c **** {
 486:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 487:./lwip-2.1.2/src/core/tcp.c **** 
 488:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_close: invalid pcb", pcb != NULL, return ERR_ARG);
 489:./lwip-2.1.2/src/core/tcp.c ****   LWIP_DEBUGF(TCP_DEBUG, ("tcp_close: closing in "));
 490:./lwip-2.1.2/src/core/tcp.c **** 
 491:./lwip-2.1.2/src/core/tcp.c ****   tcp_debug_print_state(pcb->state);
 492:./lwip-2.1.2/src/core/tcp.c **** 
 493:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->state != LISTEN) {
 494:./lwip-2.1.2/src/core/tcp.c ****     /* Set a flag not to receive any more data... */
 495:./lwip-2.1.2/src/core/tcp.c ****     tcp_set_flags(pcb, TF_RXCLOSED);
 496:./lwip-2.1.2/src/core/tcp.c ****   }
 497:./lwip-2.1.2/src/core/tcp.c ****   /* ... and close */
 498:./lwip-2.1.2/src/core/tcp.c ****   return tcp_close_shutdown(pcb, 1);
 499:./lwip-2.1.2/src/core/tcp.c **** }
 500:./lwip-2.1.2/src/core/tcp.c **** 
 501:./lwip-2.1.2/src/core/tcp.c **** /**
 502:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
 503:./lwip-2.1.2/src/core/tcp.c ****  * Causes all or part of a full-duplex connection of this PCB to be shut down.
 504:./lwip-2.1.2/src/core/tcp.c ****  * This doesn't deallocate the PCB unless shutting down both sides!
 505:./lwip-2.1.2/src/core/tcp.c ****  * Shutting down both sides is the same as calling tcp_close, so if it succeds
 506:./lwip-2.1.2/src/core/tcp.c ****  * (i.e. returns ER_OK), the PCB must not be referenced any more!
 507:./lwip-2.1.2/src/core/tcp.c ****  *
 508:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb PCB to shutdown
 509:./lwip-2.1.2/src/core/tcp.c ****  * @param shut_rx shut down receive side if this is != 0
 510:./lwip-2.1.2/src/core/tcp.c ****  * @param shut_tx shut down send side if this is != 0
 511:./lwip-2.1.2/src/core/tcp.c ****  * @return ERR_OK if shutdown succeeded (or the PCB has already been shut down)
 512:./lwip-2.1.2/src/core/tcp.c ****  *         another err_t on error.
 513:./lwip-2.1.2/src/core/tcp.c ****  */
 514:./lwip-2.1.2/src/core/tcp.c **** err_t
 515:./lwip-2.1.2/src/core/tcp.c **** tcp_shutdown(struct tcp_pcb *pcb, int shut_rx, int shut_tx)
 516:./lwip-2.1.2/src/core/tcp.c **** {
 517:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 518:./lwip-2.1.2/src/core/tcp.c **** 
 519:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_shutdown: invalid pcb", pcb != NULL, return ERR_ARG);
 520:./lwip-2.1.2/src/core/tcp.c **** 
 521:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->state == LISTEN) {
 522:./lwip-2.1.2/src/core/tcp.c ****     return ERR_CONN;
 523:./lwip-2.1.2/src/core/tcp.c ****   }
 524:./lwip-2.1.2/src/core/tcp.c ****   if (shut_rx) {
 525:./lwip-2.1.2/src/core/tcp.c ****     /* shut down the receive side: set a flag not to receive any more data... */
 526:./lwip-2.1.2/src/core/tcp.c ****     tcp_set_flags(pcb, TF_RXCLOSED);
 527:./lwip-2.1.2/src/core/tcp.c ****     if (shut_tx) {
 528:./lwip-2.1.2/src/core/tcp.c ****       /* shutting down the tx AND rx side is the same as closing for the raw API */
 529:./lwip-2.1.2/src/core/tcp.c ****       return tcp_close_shutdown(pcb, 1);
 530:./lwip-2.1.2/src/core/tcp.c ****     }
 531:./lwip-2.1.2/src/core/tcp.c ****     /* ... and free buffered data */
 532:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->refused_data != NULL) {
 533:./lwip-2.1.2/src/core/tcp.c ****       pbuf_free(pcb->refused_data);
 534:./lwip-2.1.2/src/core/tcp.c ****       pcb->refused_data = NULL;
 535:./lwip-2.1.2/src/core/tcp.c ****     }
 536:./lwip-2.1.2/src/core/tcp.c ****   }
 537:./lwip-2.1.2/src/core/tcp.c ****   if (shut_tx) {
 538:./lwip-2.1.2/src/core/tcp.c ****     /* This can't happen twice since if it succeeds, the pcb's state is changed.
 539:./lwip-2.1.2/src/core/tcp.c ****        Only close in these states as the others directly deallocate the PCB */
 540:./lwip-2.1.2/src/core/tcp.c ****     switch (pcb->state) {
 541:./lwip-2.1.2/src/core/tcp.c ****       case SYN_RCVD:
 542:./lwip-2.1.2/src/core/tcp.c ****       case ESTABLISHED:
 543:./lwip-2.1.2/src/core/tcp.c ****       case CLOSE_WAIT:
 544:./lwip-2.1.2/src/core/tcp.c ****         return tcp_close_shutdown(pcb, (u8_t)shut_rx);
 545:./lwip-2.1.2/src/core/tcp.c ****       default:
 546:./lwip-2.1.2/src/core/tcp.c ****         /* Not (yet?) connected, cannot shutdown the TX side as that would bring us
 547:./lwip-2.1.2/src/core/tcp.c ****           into CLOSED state, where the PCB is deallocated. */
 548:./lwip-2.1.2/src/core/tcp.c ****         return ERR_CONN;
 549:./lwip-2.1.2/src/core/tcp.c ****     }
 550:./lwip-2.1.2/src/core/tcp.c ****   }
 551:./lwip-2.1.2/src/core/tcp.c ****   return ERR_OK;
 552:./lwip-2.1.2/src/core/tcp.c **** }
 553:./lwip-2.1.2/src/core/tcp.c **** 
 554:./lwip-2.1.2/src/core/tcp.c **** /**
 555:./lwip-2.1.2/src/core/tcp.c ****  * Abandons a connection and optionally sends a RST to the remote
 556:./lwip-2.1.2/src/core/tcp.c ****  * host.  Deletes the local protocol control block. This is done when
 557:./lwip-2.1.2/src/core/tcp.c ****  * a connection is killed because of shortage of memory.
 558:./lwip-2.1.2/src/core/tcp.c ****  *
 559:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the tcp_pcb to abort
 560:./lwip-2.1.2/src/core/tcp.c ****  * @param reset boolean to indicate whether a reset should be sent
 561:./lwip-2.1.2/src/core/tcp.c ****  */
 562:./lwip-2.1.2/src/core/tcp.c **** void
 563:./lwip-2.1.2/src/core/tcp.c **** tcp_abandon(struct tcp_pcb *pcb, int reset)
 564:./lwip-2.1.2/src/core/tcp.c **** {
 565:./lwip-2.1.2/src/core/tcp.c ****   u32_t seqno, ackno;
 566:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API
 567:./lwip-2.1.2/src/core/tcp.c ****   tcp_err_fn errf;
 568:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_CALLBACK_API */
 569:./lwip-2.1.2/src/core/tcp.c ****   void *errf_arg;
 570:./lwip-2.1.2/src/core/tcp.c **** 
 571:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 572:./lwip-2.1.2/src/core/tcp.c **** 
 573:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_abandon: invalid pcb", pcb != NULL, return);
 574:./lwip-2.1.2/src/core/tcp.c **** 
 575:./lwip-2.1.2/src/core/tcp.c ****   /* pcb->state LISTEN not allowed here */
 576:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("don't call tcp_abort/tcp_abandon for listen-pcbs",
 577:./lwip-2.1.2/src/core/tcp.c ****               pcb->state != LISTEN);
 578:./lwip-2.1.2/src/core/tcp.c ****   /* Figure out on which TCP PCB list we are, and remove us. If we
 579:./lwip-2.1.2/src/core/tcp.c ****      are in an active state, call the receive function associated with
 580:./lwip-2.1.2/src/core/tcp.c ****      the PCB with a NULL argument, and send an RST to the remote end. */
 581:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->state == TIME_WAIT) {
 582:./lwip-2.1.2/src/core/tcp.c ****     tcp_pcb_remove(&tcp_tw_pcbs, pcb);
 583:./lwip-2.1.2/src/core/tcp.c ****     tcp_free(pcb);
 584:./lwip-2.1.2/src/core/tcp.c ****   } else {
 585:./lwip-2.1.2/src/core/tcp.c ****     int send_rst = 0;
 586:./lwip-2.1.2/src/core/tcp.c ****     u16_t local_port = 0;
 587:./lwip-2.1.2/src/core/tcp.c ****     enum tcp_state last_state;
 588:./lwip-2.1.2/src/core/tcp.c ****     seqno = pcb->snd_nxt;
 589:./lwip-2.1.2/src/core/tcp.c ****     ackno = pcb->rcv_nxt;
 590:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API
 591:./lwip-2.1.2/src/core/tcp.c ****     errf = pcb->errf;
 592:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_CALLBACK_API */
 593:./lwip-2.1.2/src/core/tcp.c ****     errf_arg = pcb->callback_arg;
 594:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->state == CLOSED) {
 595:./lwip-2.1.2/src/core/tcp.c ****       if (pcb->local_port != 0) {
 596:./lwip-2.1.2/src/core/tcp.c ****         /* bound, not yet opened */
 597:./lwip-2.1.2/src/core/tcp.c ****         TCP_RMV(&tcp_bound_pcbs, pcb);
 598:./lwip-2.1.2/src/core/tcp.c ****       }
 599:./lwip-2.1.2/src/core/tcp.c ****     } else {
 600:./lwip-2.1.2/src/core/tcp.c ****       send_rst = reset;
 601:./lwip-2.1.2/src/core/tcp.c ****       local_port = pcb->local_port;
 602:./lwip-2.1.2/src/core/tcp.c ****       TCP_PCB_REMOVE_ACTIVE(pcb);
 603:./lwip-2.1.2/src/core/tcp.c ****     }
 604:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->unacked != NULL) {
 605:./lwip-2.1.2/src/core/tcp.c ****       tcp_segs_free(pcb->unacked);
 606:./lwip-2.1.2/src/core/tcp.c ****     }
 607:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->unsent != NULL) {
 608:./lwip-2.1.2/src/core/tcp.c ****       tcp_segs_free(pcb->unsent);
 609:./lwip-2.1.2/src/core/tcp.c ****     }
 610:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ
 611:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->ooseq != NULL) {
 612:./lwip-2.1.2/src/core/tcp.c ****       tcp_segs_free(pcb->ooseq);
 613:./lwip-2.1.2/src/core/tcp.c ****     }
 614:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ */
 615:./lwip-2.1.2/src/core/tcp.c ****     tcp_backlog_accepted(pcb);
 616:./lwip-2.1.2/src/core/tcp.c ****     if (send_rst) {
 617:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_RST_DEBUG, ("tcp_abandon: sending RST\n"));
 618:./lwip-2.1.2/src/core/tcp.c ****       tcp_rst(pcb, seqno, ackno, &pcb->local_ip, &pcb->remote_ip, local_port, pcb->remote_port);
 619:./lwip-2.1.2/src/core/tcp.c ****     }
 620:./lwip-2.1.2/src/core/tcp.c ****     last_state = pcb->state;
 621:./lwip-2.1.2/src/core/tcp.c ****     tcp_free(pcb);
 622:./lwip-2.1.2/src/core/tcp.c ****     TCP_EVENT_ERR(last_state, errf, errf_arg, ERR_ABRT);
 623:./lwip-2.1.2/src/core/tcp.c ****   }
 624:./lwip-2.1.2/src/core/tcp.c **** }
 625:./lwip-2.1.2/src/core/tcp.c **** 
 626:./lwip-2.1.2/src/core/tcp.c **** /**
 627:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
 628:./lwip-2.1.2/src/core/tcp.c ****  * Aborts the connection by sending a RST (reset) segment to the remote
 629:./lwip-2.1.2/src/core/tcp.c ****  * host. The pcb is deallocated. This function never fails.
 630:./lwip-2.1.2/src/core/tcp.c ****  *
 631:./lwip-2.1.2/src/core/tcp.c ****  * ATTENTION: When calling this from one of the TCP callbacks, make
 632:./lwip-2.1.2/src/core/tcp.c ****  * sure you always return ERR_ABRT (and never return ERR_ABRT otherwise
 633:./lwip-2.1.2/src/core/tcp.c ****  * or you will risk accessing deallocated memory or memory leaks!
 634:./lwip-2.1.2/src/core/tcp.c ****  *
 635:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the tcp pcb to abort
 636:./lwip-2.1.2/src/core/tcp.c ****  */
 637:./lwip-2.1.2/src/core/tcp.c **** void
 638:./lwip-2.1.2/src/core/tcp.c **** tcp_abort(struct tcp_pcb *pcb)
 639:./lwip-2.1.2/src/core/tcp.c **** {
 640:./lwip-2.1.2/src/core/tcp.c ****   tcp_abandon(pcb, 1);
 641:./lwip-2.1.2/src/core/tcp.c **** }
 642:./lwip-2.1.2/src/core/tcp.c **** 
 643:./lwip-2.1.2/src/core/tcp.c **** /**
 644:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
 645:./lwip-2.1.2/src/core/tcp.c ****  * Binds the connection to a local port number and IP address. If the
 646:./lwip-2.1.2/src/core/tcp.c ****  * IP address is not given (i.e., ipaddr == IP_ANY_TYPE), the connection is
 647:./lwip-2.1.2/src/core/tcp.c ****  * bound to all local IP addresses.
 648:./lwip-2.1.2/src/core/tcp.c ****  * If another connection is bound to the same port, the function will
 649:./lwip-2.1.2/src/core/tcp.c ****  * return ERR_USE, otherwise ERR_OK is returned.
 650:./lwip-2.1.2/src/core/tcp.c ****  *
 651:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the tcp_pcb to bind (no check is done whether this pcb is
 652:./lwip-2.1.2/src/core/tcp.c ****  *        already bound!)
 653:./lwip-2.1.2/src/core/tcp.c ****  * @param ipaddr the local ip address to bind to (use IPx_ADDR_ANY to bind
 654:./lwip-2.1.2/src/core/tcp.c ****  *        to any local address
 655:./lwip-2.1.2/src/core/tcp.c ****  * @param port the local port to bind to
 656:./lwip-2.1.2/src/core/tcp.c ****  * @return ERR_USE if the port is already in use
 657:./lwip-2.1.2/src/core/tcp.c ****  *         ERR_VAL if bind failed because the PCB is not in a valid state
 658:./lwip-2.1.2/src/core/tcp.c ****  *         ERR_OK if bound
 659:./lwip-2.1.2/src/core/tcp.c ****  */
 660:./lwip-2.1.2/src/core/tcp.c **** err_t
 661:./lwip-2.1.2/src/core/tcp.c **** tcp_bind(struct tcp_pcb *pcb, const ip_addr_t *ipaddr, u16_t port)
 662:./lwip-2.1.2/src/core/tcp.c **** {
 663:./lwip-2.1.2/src/core/tcp.c ****   int i;
 664:./lwip-2.1.2/src/core/tcp.c ****   int max_pcb_list = NUM_TCP_PCB_LISTS;
 665:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *cpcb;
 666:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_IPV6 && LWIP_IPV6_SCOPES
 667:./lwip-2.1.2/src/core/tcp.c ****   ip_addr_t zoned_ipaddr;
 668:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_IPV6 && LWIP_IPV6_SCOPES */
 669:./lwip-2.1.2/src/core/tcp.c **** 
 670:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 671:./lwip-2.1.2/src/core/tcp.c **** 
 672:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_IPV4
 673:./lwip-2.1.2/src/core/tcp.c ****   /* Don't propagate NULL pointer (IPv4 ANY) to subsequent functions */
 674:./lwip-2.1.2/src/core/tcp.c ****   if (ipaddr == NULL) {
 675:./lwip-2.1.2/src/core/tcp.c ****     ipaddr = IP4_ADDR_ANY;
 676:./lwip-2.1.2/src/core/tcp.c ****   }
 677:./lwip-2.1.2/src/core/tcp.c **** #else /* LWIP_IPV4 */
 678:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_bind: invalid ipaddr", ipaddr != NULL, return ERR_ARG);
 679:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_IPV4 */
 680:./lwip-2.1.2/src/core/tcp.c **** 
 681:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_bind: invalid pcb", pcb != NULL, return ERR_ARG);
 682:./lwip-2.1.2/src/core/tcp.c **** 
 683:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_bind: can only bind in state CLOSED", pcb->state == CLOSED, return ERR_VAL);
 684:./lwip-2.1.2/src/core/tcp.c **** 
 685:./lwip-2.1.2/src/core/tcp.c **** #if SO_REUSE
 686:./lwip-2.1.2/src/core/tcp.c ****   /* Unless the REUSEADDR flag is set,
 687:./lwip-2.1.2/src/core/tcp.c ****      we have to check the pcbs in TIME-WAIT state, also.
 688:./lwip-2.1.2/src/core/tcp.c ****      We do not dump TIME_WAIT pcb's; they can still be matched by incoming
 689:./lwip-2.1.2/src/core/tcp.c ****      packets using both local and remote IP addresses and ports to distinguish.
 690:./lwip-2.1.2/src/core/tcp.c ****    */
 691:./lwip-2.1.2/src/core/tcp.c ****   if (ip_get_option(pcb, SOF_REUSEADDR)) {
 692:./lwip-2.1.2/src/core/tcp.c ****     max_pcb_list = NUM_TCP_PCB_LISTS_NO_TIME_WAIT;
 693:./lwip-2.1.2/src/core/tcp.c ****   }
 694:./lwip-2.1.2/src/core/tcp.c **** #endif /* SO_REUSE */
 695:./lwip-2.1.2/src/core/tcp.c **** 
 696:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_IPV6 && LWIP_IPV6_SCOPES
 697:./lwip-2.1.2/src/core/tcp.c ****   /* If the given IP address should have a zone but doesn't, assign one now.
 698:./lwip-2.1.2/src/core/tcp.c ****    * This is legacy support: scope-aware callers should always provide properly
 699:./lwip-2.1.2/src/core/tcp.c ****    * zoned source addresses. Do the zone selection before the address-in-use
 700:./lwip-2.1.2/src/core/tcp.c ****    * check below; as such we have to make a temporary copy of the address. */
 701:./lwip-2.1.2/src/core/tcp.c ****   if (IP_IS_V6(ipaddr) && ip6_addr_lacks_zone(ip_2_ip6(ipaddr), IP6_UNICAST)) {
 702:./lwip-2.1.2/src/core/tcp.c ****     ip_addr_copy(zoned_ipaddr, *ipaddr);
 703:./lwip-2.1.2/src/core/tcp.c ****     ip6_addr_select_zone(ip_2_ip6(&zoned_ipaddr), ip_2_ip6(&zoned_ipaddr));
 704:./lwip-2.1.2/src/core/tcp.c ****     ipaddr = &zoned_ipaddr;
 705:./lwip-2.1.2/src/core/tcp.c ****   }
 706:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_IPV6 && LWIP_IPV6_SCOPES */
 707:./lwip-2.1.2/src/core/tcp.c **** 
 708:./lwip-2.1.2/src/core/tcp.c ****   if (port == 0) {
 709:./lwip-2.1.2/src/core/tcp.c ****     port = tcp_new_port();
 710:./lwip-2.1.2/src/core/tcp.c ****     if (port == 0) {
 711:./lwip-2.1.2/src/core/tcp.c ****       return ERR_BUF;
 712:./lwip-2.1.2/src/core/tcp.c ****     }
 713:./lwip-2.1.2/src/core/tcp.c ****   } else {
 714:./lwip-2.1.2/src/core/tcp.c ****     /* Check if the address already is in use (on all lists) */
 715:./lwip-2.1.2/src/core/tcp.c ****     for (i = 0; i < max_pcb_list; i++) {
 716:./lwip-2.1.2/src/core/tcp.c ****       for (cpcb = *tcp_pcb_lists[i]; cpcb != NULL; cpcb = cpcb->next) {

 791:./lwip-2.1.2/src/core/tcp.c **** /**
 792:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
 793:./lwip-2.1.2/src/core/tcp.c ****  * Set the state of the connection to be LISTEN, which means that it
 794:./lwip-2.1.2/src/core/tcp.c ****  * is able to accept incoming connections. The protocol control block
 795:./lwip-2.1.2/src/core/tcp.c ****  * is reallocated in order to consume less memory. Setting the
 796:./lwip-2.1.2/src/core/tcp.c ****  * connection to LISTEN is an irreversible process.
 797:./lwip-2.1.2/src/core/tcp.c ****  * When an incoming connection is accepted, the function specified with
 798:./lwip-2.1.2/src/core/tcp.c ****  * the tcp_accept() function will be called. The pcb has to be bound
 799:./lwip-2.1.2/src/core/tcp.c ****  * to a local port with the tcp_bind() function.
 800:./lwip-2.1.2/src/core/tcp.c ****  * 
 801:./lwip-2.1.2/src/core/tcp.c ****  * The tcp_listen() function returns a new connection identifier, and
 802:./lwip-2.1.2/src/core/tcp.c ****  * the one passed as an argument to the function will be
 803:./lwip-2.1.2/src/core/tcp.c ****  * deallocated. The reason for this behavior is that less memory is
 804:./lwip-2.1.2/src/core/tcp.c ****  * needed for a connection that is listening, so tcp_listen() will
 805:./lwip-2.1.2/src/core/tcp.c ****  * reclaim the memory needed for the original connection and allocate a
 806:./lwip-2.1.2/src/core/tcp.c ****  * new smaller memory block for the listening connection.
 807:./lwip-2.1.2/src/core/tcp.c ****  *
 808:./lwip-2.1.2/src/core/tcp.c ****  * tcp_listen() may return NULL if no memory was available for the
 809:./lwip-2.1.2/src/core/tcp.c ****  * listening connection. If so, the memory associated with the pcb
 810:./lwip-2.1.2/src/core/tcp.c ****  * passed as an argument to tcp_listen() will not be deallocated.
 811:./lwip-2.1.2/src/core/tcp.c ****  *
 812:./lwip-2.1.2/src/core/tcp.c ****  * The backlog limits the number of outstanding connections
 813:./lwip-2.1.2/src/core/tcp.c ****  * in the listen queue to the value specified by the backlog argument.
 814:./lwip-2.1.2/src/core/tcp.c ****  * To use it, your need to set TCP_LISTEN_BACKLOG=1 in your lwipopts.h.
 815:./lwip-2.1.2/src/core/tcp.c ****  * 
 816:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the original tcp_pcb
 817:./lwip-2.1.2/src/core/tcp.c ****  * @param backlog the incoming connections queue limit
 818:./lwip-2.1.2/src/core/tcp.c ****  * @return tcp_pcb used for listening, consumes less memory.
 819:./lwip-2.1.2/src/core/tcp.c ****  *
 820:./lwip-2.1.2/src/core/tcp.c ****  * @note The original tcp_pcb is freed. This function therefore has to be
 821:./lwip-2.1.2/src/core/tcp.c ****  *       called like this:
 822:./lwip-2.1.2/src/core/tcp.c ****  *             tpcb = tcp_listen_with_backlog(tpcb, backlog);
 823:./lwip-2.1.2/src/core/tcp.c ****  */
 824:./lwip-2.1.2/src/core/tcp.c **** struct tcp_pcb *
 825:./lwip-2.1.2/src/core/tcp.c **** tcp_listen_with_backlog(struct tcp_pcb *pcb, u8_t backlog)
 826:./lwip-2.1.2/src/core/tcp.c **** {
 827:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 828:./lwip-2.1.2/src/core/tcp.c ****   return tcp_listen_with_backlog_and_err(pcb, backlog, NULL);
 829:./lwip-2.1.2/src/core/tcp.c **** }
 830:./lwip-2.1.2/src/core/tcp.c **** 
 831:./lwip-2.1.2/src/core/tcp.c **** /**
 832:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
 833:./lwip-2.1.2/src/core/tcp.c ****  * Set the state of the connection to be LISTEN, which means that it
 834:./lwip-2.1.2/src/core/tcp.c ****  * is able to accept incoming connections. The protocol control block
 835:./lwip-2.1.2/src/core/tcp.c ****  * is reallocated in order to consume less memory. Setting the
 836:./lwip-2.1.2/src/core/tcp.c ****  * connection to LISTEN is an irreversible process.
 837:./lwip-2.1.2/src/core/tcp.c ****  *
 838:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the original tcp_pcb
 839:./lwip-2.1.2/src/core/tcp.c ****  * @param backlog the incoming connections queue limit
 840:./lwip-2.1.2/src/core/tcp.c ****  * @param err when NULL is returned, this contains the error reason
 841:./lwip-2.1.2/src/core/tcp.c ****  * @return tcp_pcb used for listening, consumes less memory.
 842:./lwip-2.1.2/src/core/tcp.c ****  *
 843:./lwip-2.1.2/src/core/tcp.c ****  * @note The original tcp_pcb is freed. This function therefore has to be
 844:./lwip-2.1.2/src/core/tcp.c ****  *       called like this:
 845:./lwip-2.1.2/src/core/tcp.c ****  *             tpcb = tcp_listen_with_backlog_and_err(tpcb, backlog, &err);
 846:./lwip-2.1.2/src/core/tcp.c ****  */
 847:./lwip-2.1.2/src/core/tcp.c **** struct tcp_pcb *
 848:./lwip-2.1.2/src/core/tcp.c **** tcp_listen_with_backlog_and_err(struct tcp_pcb *pcb, u8_t backlog, err_t *err)
 849:./lwip-2.1.2/src/core/tcp.c **** {
 850:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb_listen *lpcb = NULL;
 851:./lwip-2.1.2/src/core/tcp.c ****   err_t res;
 852:./lwip-2.1.2/src/core/tcp.c **** 
 853:./lwip-2.1.2/src/core/tcp.c ****   LWIP_UNUSED_ARG(backlog);
 854:./lwip-2.1.2/src/core/tcp.c **** 
 855:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
 856:./lwip-2.1.2/src/core/tcp.c **** 
 857:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_listen_with_backlog_and_err: invalid pcb", pcb != NULL, res = ERR_ARG; goto done)
 858:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_listen_with_backlog_and_err: pcb already connected", pcb->state == CLOSED, res = 
 859:./lwip-2.1.2/src/core/tcp.c **** 
 860:./lwip-2.1.2/src/core/tcp.c ****   /* already listening? */
 861:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->state == LISTEN) {
 862:./lwip-2.1.2/src/core/tcp.c ****     lpcb = (struct tcp_pcb_listen *)pcb;
 863:./lwip-2.1.2/src/core/tcp.c ****     res = ERR_ALREADY;
 864:./lwip-2.1.2/src/core/tcp.c ****     goto done;
 865:./lwip-2.1.2/src/core/tcp.c ****   }
 866:./lwip-2.1.2/src/core/tcp.c **** #if SO_REUSE
 867:./lwip-2.1.2/src/core/tcp.c ****   if (ip_get_option(pcb, SOF_REUSEADDR)) {
 868:./lwip-2.1.2/src/core/tcp.c ****     /* Since SOF_REUSEADDR allows reusing a local address before the pcb's usage
 869:./lwip-2.1.2/src/core/tcp.c ****        is declared (listen-/connection-pcb), we have to make sure now that
 870:./lwip-2.1.2/src/core/tcp.c ****        this port is only used once for every local IP. */
 871:./lwip-2.1.2/src/core/tcp.c ****     for (lpcb = tcp_listen_pcbs.listen_pcbs; lpcb != NULL; lpcb = lpcb->next) {
 872:./lwip-2.1.2/src/core/tcp.c ****       if ((lpcb->local_port == pcb->local_port) &&
 873:./lwip-2.1.2/src/core/tcp.c ****           ip_addr_cmp(&lpcb->local_ip, &pcb->local_ip)) {
 874:./lwip-2.1.2/src/core/tcp.c ****         /* this address/port is already used */
 875:./lwip-2.1.2/src/core/tcp.c ****         lpcb = NULL;
 876:./lwip-2.1.2/src/core/tcp.c ****         res = ERR_USE;
 877:./lwip-2.1.2/src/core/tcp.c ****         goto done;
 878:./lwip-2.1.2/src/core/tcp.c ****       }
 879:./lwip-2.1.2/src/core/tcp.c ****     }
 880:./lwip-2.1.2/src/core/tcp.c ****   }
 881:./lwip-2.1.2/src/core/tcp.c **** #endif /* SO_REUSE */
 882:./lwip-2.1.2/src/core/tcp.c ****   lpcb = (struct tcp_pcb_listen *)memp_malloc(MEMP_TCP_PCB_LISTEN);
 883:./lwip-2.1.2/src/core/tcp.c ****   if (lpcb == NULL) {
 884:./lwip-2.1.2/src/core/tcp.c ****     res = ERR_MEM;
 885:./lwip-2.1.2/src/core/tcp.c ****     goto done;
 886:./lwip-2.1.2/src/core/tcp.c ****   }
 887:./lwip-2.1.2/src/core/tcp.c ****   lpcb->callback_arg = pcb->callback_arg;
 888:./lwip-2.1.2/src/core/tcp.c ****   lpcb->local_port = pcb->local_port;
 889:./lwip-2.1.2/src/core/tcp.c ****   lpcb->state = LISTEN;
 890:./lwip-2.1.2/src/core/tcp.c ****   lpcb->prio = pcb->prio;
 891:./lwip-2.1.2/src/core/tcp.c ****   lpcb->so_options = pcb->so_options;
 892:./lwip-2.1.2/src/core/tcp.c ****   lpcb->netif_idx = NETIF_NO_INDEX;
 893:./lwip-2.1.2/src/core/tcp.c ****   lpcb->ttl = pcb->ttl;
 894:./lwip-2.1.2/src/core/tcp.c ****   lpcb->tos = pcb->tos;
 895:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_IPV4 && LWIP_IPV6
 896:./lwip-2.1.2/src/core/tcp.c ****   IP_SET_TYPE_VAL(lpcb->remote_ip, pcb->local_ip.type);
 897:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_IPV4 && LWIP_IPV6 */
 898:./lwip-2.1.2/src/core/tcp.c ****   ip_addr_copy(lpcb->local_ip, pcb->local_ip);
 899:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->local_port != 0) {
 900:./lwip-2.1.2/src/core/tcp.c ****     TCP_RMV(&tcp_bound_pcbs, pcb);
 901:./lwip-2.1.2/src/core/tcp.c ****   }
 902:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_TCP_PCB_NUM_EXT_ARGS
 903:./lwip-2.1.2/src/core/tcp.c ****   /* copy over ext_args to listening pcb  */
 904:./lwip-2.1.2/src/core/tcp.c ****   memcpy(&lpcb->ext_args, &pcb->ext_args, sizeof(pcb->ext_args));
 905:./lwip-2.1.2/src/core/tcp.c **** #endif
 906:./lwip-2.1.2/src/core/tcp.c ****   tcp_free(pcb);
 907:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API
 908:./lwip-2.1.2/src/core/tcp.c ****   lpcb->accept = tcp_accept_null;
 909:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_CALLBACK_API */
 910:./lwip-2.1.2/src/core/tcp.c **** #if TCP_LISTEN_BACKLOG
 911:./lwip-2.1.2/src/core/tcp.c ****   lpcb->accepts_pending = 0;
 912:./lwip-2.1.2/src/core/tcp.c ****   tcp_backlog_set(lpcb, backlog);
 913:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_LISTEN_BACKLOG */
 914:./lwip-2.1.2/src/core/tcp.c ****   TCP_REG(&tcp_listen_pcbs.pcbs, (struct tcp_pcb *)lpcb);
 915:./lwip-2.1.2/src/core/tcp.c ****   res = ERR_OK;
 916:./lwip-2.1.2/src/core/tcp.c **** done:

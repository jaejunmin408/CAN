 732:./lwip-2.1.2/src/core/tcp.c ****             }
 733:./lwip-2.1.2/src/core/tcp.c ****           }
 734:./lwip-2.1.2/src/core/tcp.c ****         }
 735:./lwip-2.1.2/src/core/tcp.c ****       }
 736:./lwip-2.1.2/src/core/tcp.c ****     }
 737:./lwip-2.1.2/src/core/tcp.c ****   }
 738:./lwip-2.1.2/src/core/tcp.c **** 
 739:./lwip-2.1.2/src/core/tcp.c ****   if (!ip_addr_isany(ipaddr)
 740:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_IPV4 && LWIP_IPV6
 741:./lwip-2.1.2/src/core/tcp.c ****       || (IP_GET_TYPE(ipaddr) != IP_GET_TYPE(&pcb->local_ip))
 742:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_IPV4 && LWIP_IPV6 */
 743:./lwip-2.1.2/src/core/tcp.c ****      ) {

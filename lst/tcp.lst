1700:./lwip-2.1.2/src/core/tcp.c **** /**
1701:./lwip-2.1.2/src/core/tcp.c ****  * Kills the oldest active connection that has a lower priority than 'prio'.
1702:./lwip-2.1.2/src/core/tcp.c ****  *
1703:./lwip-2.1.2/src/core/tcp.c ****  * @param prio minimum priority
1704:./lwip-2.1.2/src/core/tcp.c ****  */
1705:./lwip-2.1.2/src/core/tcp.c **** static void
1706:./lwip-2.1.2/src/core/tcp.c **** tcp_kill_prio(u8_t prio)
1707:./lwip-2.1.2/src/core/tcp.c **** {
1708:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb, *inactive;
1709:./lwip-2.1.2/src/core/tcp.c ****   u32_t inactivity;
1710:./lwip-2.1.2/src/core/tcp.c ****   u8_t mprio;
1711:./lwip-2.1.2/src/core/tcp.c **** 
1712:./lwip-2.1.2/src/core/tcp.c ****   mprio = LWIP_MIN(TCP_PRIO_MAX, prio);
1713:./lwip-2.1.2/src/core/tcp.c **** 
1714:./lwip-2.1.2/src/core/tcp.c ****   /* We want to kill connections with a lower prio, so bail out if 
1715:./lwip-2.1.2/src/core/tcp.c ****    * supplied prio is 0 - there can never be a lower prio
1716:./lwip-2.1.2/src/core/tcp.c ****    */
1717:./lwip-2.1.2/src/core/tcp.c ****   if (mprio == 0) {
1718:./lwip-2.1.2/src/core/tcp.c ****     return;
1719:./lwip-2.1.2/src/core/tcp.c ****   }
1720:./lwip-2.1.2/src/core/tcp.c **** 
1721:./lwip-2.1.2/src/core/tcp.c ****   /* We only want kill connections with a lower prio, so decrement prio by one 
1722:./lwip-2.1.2/src/core/tcp.c ****    * and start searching for oldest connection with same or lower priority than mprio.
1723:./lwip-2.1.2/src/core/tcp.c ****    * We want to find the connections with the lowest possible prio, and among
1724:./lwip-2.1.2/src/core/tcp.c ****    * these the one with the longest inactivity time.
1725:./lwip-2.1.2/src/core/tcp.c ****    */
1726:./lwip-2.1.2/src/core/tcp.c ****   mprio--;
1727:./lwip-2.1.2/src/core/tcp.c **** 
1728:./lwip-2.1.2/src/core/tcp.c ****   inactivity = 0;
1729:./lwip-2.1.2/src/core/tcp.c ****   inactive = NULL;
1730:./lwip-2.1.2/src/core/tcp.c ****   for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
1731:./lwip-2.1.2/src/core/tcp.c ****         /* lower prio is always a kill candidate */
1732:./lwip-2.1.2/src/core/tcp.c ****     if ((pcb->prio < mprio) ||
1733:./lwip-2.1.2/src/core/tcp.c ****         /* longer inactivity is also a kill candidate */
1734:./lwip-2.1.2/src/core/tcp.c ****         ((pcb->prio == mprio) && ((u32_t)(tcp_ticks - pcb->tmr) >= inactivity))) {
1735:./lwip-2.1.2/src/core/tcp.c ****       inactivity = tcp_ticks - pcb->tmr;
1736:./lwip-2.1.2/src/core/tcp.c ****       inactive   = pcb;
1737:./lwip-2.1.2/src/core/tcp.c ****       mprio      = pcb->prio;
1738:./lwip-2.1.2/src/core/tcp.c ****     }
1739:./lwip-2.1.2/src/core/tcp.c ****   }
1740:./lwip-2.1.2/src/core/tcp.c ****   if (inactive != NULL) {
1741:./lwip-2.1.2/src/core/tcp.c ****     LWIP_DEBUGF(TCP_DEBUG, ("tcp_kill_prio: killing oldest PCB %p (%"S32_F")\n",
1742:./lwip-2.1.2/src/core/tcp.c ****                             (void *)inactive, inactivity));
1743:./lwip-2.1.2/src/core/tcp.c ****     tcp_abort(inactive);
1744:./lwip-2.1.2/src/core/tcp.c ****   }
1745:./lwip-2.1.2/src/core/tcp.c **** }
1746:./lwip-2.1.2/src/core/tcp.c **** 
1747:./lwip-2.1.2/src/core/tcp.c **** /**
1748:./lwip-2.1.2/src/core/tcp.c ****  * Kills the oldest connection that is in specific state.
1749:./lwip-2.1.2/src/core/tcp.c ****  * Called from tcp_alloc() for LAST_ACK and CLOSING if no more connections are available.
1750:./lwip-2.1.2/src/core/tcp.c ****  */
1751:./lwip-2.1.2/src/core/tcp.c **** static void
1752:./lwip-2.1.2/src/core/tcp.c **** tcp_kill_state(enum tcp_state state)
1753:./lwip-2.1.2/src/core/tcp.c **** {
1754:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb, *inactive;
1755:./lwip-2.1.2/src/core/tcp.c ****   u32_t inactivity;
1756:./lwip-2.1.2/src/core/tcp.c **** 
1757:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("invalid state", (state == CLOSING) || (state == LAST_ACK));
1758:./lwip-2.1.2/src/core/tcp.c **** 
1759:./lwip-2.1.2/src/core/tcp.c ****   inactivity = 0;
1760:./lwip-2.1.2/src/core/tcp.c ****   inactive = NULL;
1761:./lwip-2.1.2/src/core/tcp.c ****   /* Go through the list of active pcbs and get the oldest pcb that is in state
1762:./lwip-2.1.2/src/core/tcp.c ****      CLOSING/LAST_ACK. */
1763:./lwip-2.1.2/src/core/tcp.c ****   for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
1764:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->state == state) {
1765:./lwip-2.1.2/src/core/tcp.c ****       if ((u32_t)(tcp_ticks - pcb->tmr) >= inactivity) {
1766:./lwip-2.1.2/src/core/tcp.c ****         inactivity = tcp_ticks - pcb->tmr;
1767:./lwip-2.1.2/src/core/tcp.c ****         inactive = pcb;
1768:./lwip-2.1.2/src/core/tcp.c ****       }
1769:./lwip-2.1.2/src/core/tcp.c ****     }
1770:./lwip-2.1.2/src/core/tcp.c ****   }
1771:./lwip-2.1.2/src/core/tcp.c ****   if (inactive != NULL) {
1772:./lwip-2.1.2/src/core/tcp.c ****     LWIP_DEBUGF(TCP_DEBUG, ("tcp_kill_closing: killing oldest %s PCB %p (%"S32_F")\n",
1773:./lwip-2.1.2/src/core/tcp.c ****                             tcp_state_str[state], (void *)inactive, inactivity));
1774:./lwip-2.1.2/src/core/tcp.c ****     /* Don't send a RST, since no data is lost. */
1775:./lwip-2.1.2/src/core/tcp.c ****     tcp_abandon(inactive, 0);
1776:./lwip-2.1.2/src/core/tcp.c ****   }
1777:./lwip-2.1.2/src/core/tcp.c **** }
1778:./lwip-2.1.2/src/core/tcp.c **** 
1779:./lwip-2.1.2/src/core/tcp.c **** /**
1780:./lwip-2.1.2/src/core/tcp.c ****  * Kills the oldest connection that is in TIME_WAIT state.
1781:./lwip-2.1.2/src/core/tcp.c ****  * Called from tcp_alloc() if no more connections are available.
1782:./lwip-2.1.2/src/core/tcp.c ****  */
1783:./lwip-2.1.2/src/core/tcp.c **** static void
1784:./lwip-2.1.2/src/core/tcp.c **** tcp_kill_timewait(void)
1785:./lwip-2.1.2/src/core/tcp.c **** {
1786:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb, *inactive;
1787:./lwip-2.1.2/src/core/tcp.c ****   u32_t inactivity;
1788:./lwip-2.1.2/src/core/tcp.c **** 
1789:./lwip-2.1.2/src/core/tcp.c ****   inactivity = 0;
1790:./lwip-2.1.2/src/core/tcp.c ****   inactive = NULL;
1791:./lwip-2.1.2/src/core/tcp.c ****   /* Go through the list of TIME_WAIT pcbs and get the oldest pcb. */
1792:./lwip-2.1.2/src/core/tcp.c ****   for (pcb = tcp_tw_pcbs; pcb != NULL; pcb = pcb->next) {
1793:./lwip-2.1.2/src/core/tcp.c ****     if ((u32_t)(tcp_ticks - pcb->tmr) >= inactivity) {
1794:./lwip-2.1.2/src/core/tcp.c ****       inactivity = tcp_ticks - pcb->tmr;
1795:./lwip-2.1.2/src/core/tcp.c ****       inactive = pcb;
1796:./lwip-2.1.2/src/core/tcp.c ****     }
1797:./lwip-2.1.2/src/core/tcp.c ****   }
1798:./lwip-2.1.2/src/core/tcp.c ****   if (inactive != NULL) {
1799:./lwip-2.1.2/src/core/tcp.c ****     LWIP_DEBUGF(TCP_DEBUG, ("tcp_kill_timewait: killing oldest TIME-WAIT PCB %p (%"S32_F")\n",
1800:./lwip-2.1.2/src/core/tcp.c ****                             (void *)inactive, inactivity));
1801:./lwip-2.1.2/src/core/tcp.c ****     tcp_abort(inactive);
1802:./lwip-2.1.2/src/core/tcp.c ****   }
1803:./lwip-2.1.2/src/core/tcp.c **** }
1804:./lwip-2.1.2/src/core/tcp.c **** 
1805:./lwip-2.1.2/src/core/tcp.c **** /* Called when allocating a pcb fails.
1806:./lwip-2.1.2/src/core/tcp.c ****  * In this case, we want to handle all pcbs that want to close first: if we can
1807:./lwip-2.1.2/src/core/tcp.c ****  * now send the FIN (which failed before), the pcb might be in a state that is
1808:./lwip-2.1.2/src/core/tcp.c ****  * OK for us to now free it.
1809:./lwip-2.1.2/src/core/tcp.c ****  */
1810:./lwip-2.1.2/src/core/tcp.c **** static void
1811:./lwip-2.1.2/src/core/tcp.c **** tcp_handle_closepend(void)
1812:./lwip-2.1.2/src/core/tcp.c **** {
1813:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb = tcp_active_pcbs;
1814:./lwip-2.1.2/src/core/tcp.c **** 
1815:./lwip-2.1.2/src/core/tcp.c ****   while (pcb != NULL) {
1816:./lwip-2.1.2/src/core/tcp.c ****     struct tcp_pcb *next = pcb->next;
1817:./lwip-2.1.2/src/core/tcp.c ****     /* send pending FIN */
1818:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->flags & TF_CLOSEPEND) {
1819:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_handle_closepend: pending FIN\n"));
1820:./lwip-2.1.2/src/core/tcp.c ****       tcp_clear_flags(pcb, TF_CLOSEPEND);
1821:./lwip-2.1.2/src/core/tcp.c ****       tcp_close_shutdown_fin(pcb);
1822:./lwip-2.1.2/src/core/tcp.c ****     }
1823:./lwip-2.1.2/src/core/tcp.c ****     pcb = next;
1824:./lwip-2.1.2/src/core/tcp.c ****   }
1825:./lwip-2.1.2/src/core/tcp.c **** }
1826:./lwip-2.1.2/src/core/tcp.c **** 
1827:./lwip-2.1.2/src/core/tcp.c **** /**
1828:./lwip-2.1.2/src/core/tcp.c ****  * Allocate a new tcp_pcb structure.
1829:./lwip-2.1.2/src/core/tcp.c ****  *
1830:./lwip-2.1.2/src/core/tcp.c ****  * @param prio priority for the new pcb
1831:./lwip-2.1.2/src/core/tcp.c ****  * @return a new tcp_pcb that initially is in state CLOSED
1832:./lwip-2.1.2/src/core/tcp.c ****  */
1833:./lwip-2.1.2/src/core/tcp.c **** struct tcp_pcb *
1834:./lwip-2.1.2/src/core/tcp.c **** tcp_alloc(u8_t prio)
1835:./lwip-2.1.2/src/core/tcp.c **** {
1836:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb;
1837:./lwip-2.1.2/src/core/tcp.c **** 
1838:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
1839:./lwip-2.1.2/src/core/tcp.c **** 
1840:./lwip-2.1.2/src/core/tcp.c ****   pcb = (struct tcp_pcb *)memp_malloc(MEMP_TCP_PCB);
1841:./lwip-2.1.2/src/core/tcp.c ****   if (pcb == NULL) {
1842:./lwip-2.1.2/src/core/tcp.c ****     /* Try to send FIN for all pcbs stuck in TF_CLOSEPEND first */
1843:./lwip-2.1.2/src/core/tcp.c ****     tcp_handle_closepend();
1844:./lwip-2.1.2/src/core/tcp.c **** 
1845:./lwip-2.1.2/src/core/tcp.c ****     /* Try killing oldest connection in TIME-WAIT. */
1846:./lwip-2.1.2/src/core/tcp.c ****     LWIP_DEBUGF(TCP_DEBUG, ("tcp_alloc: killing off oldest TIME-WAIT connection\n"));
1847:./lwip-2.1.2/src/core/tcp.c ****     tcp_kill_timewait();
1848:./lwip-2.1.2/src/core/tcp.c ****     /* Try to allocate a tcp_pcb again. */
1849:./lwip-2.1.2/src/core/tcp.c ****     pcb = (struct tcp_pcb *)memp_malloc(MEMP_TCP_PCB);
1850:./lwip-2.1.2/src/core/tcp.c ****     if (pcb == NULL) {
1851:./lwip-2.1.2/src/core/tcp.c ****       /* Try killing oldest connection in LAST-ACK (these wouldn't go to TIME-WAIT). */
1852:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_alloc: killing off oldest LAST-ACK connection\n"));
1853:./lwip-2.1.2/src/core/tcp.c ****       tcp_kill_state(LAST_ACK);
1854:./lwip-2.1.2/src/core/tcp.c ****       /* Try to allocate a tcp_pcb again. */
1855:./lwip-2.1.2/src/core/tcp.c ****       pcb = (struct tcp_pcb *)memp_malloc(MEMP_TCP_PCB);
1856:./lwip-2.1.2/src/core/tcp.c ****       if (pcb == NULL) {
1857:./lwip-2.1.2/src/core/tcp.c ****         /* Try killing oldest connection in CLOSING. */
1858:./lwip-2.1.2/src/core/tcp.c ****         LWIP_DEBUGF(TCP_DEBUG, ("tcp_alloc: killing off oldest CLOSING connection\n"));
1859:./lwip-2.1.2/src/core/tcp.c ****         tcp_kill_state(CLOSING);
1860:./lwip-2.1.2/src/core/tcp.c ****         /* Try to allocate a tcp_pcb again. */
1861:./lwip-2.1.2/src/core/tcp.c ****         pcb = (struct tcp_pcb *)memp_malloc(MEMP_TCP_PCB);
1862:./lwip-2.1.2/src/core/tcp.c ****         if (pcb == NULL) {
1863:./lwip-2.1.2/src/core/tcp.c ****           /* Try killing oldest active connection with lower priority than the new one. */
1864:./lwip-2.1.2/src/core/tcp.c ****           LWIP_DEBUGF(TCP_DEBUG, ("tcp_alloc: killing oldest connection with prio lower than %d\n",
1865:./lwip-2.1.2/src/core/tcp.c ****           tcp_kill_prio(prio);
1866:./lwip-2.1.2/src/core/tcp.c ****           /* Try to allocate a tcp_pcb again. */
1867:./lwip-2.1.2/src/core/tcp.c ****           pcb = (struct tcp_pcb *)memp_malloc(MEMP_TCP_PCB);
1868:./lwip-2.1.2/src/core/tcp.c ****           if (pcb != NULL) {
1869:./lwip-2.1.2/src/core/tcp.c ****             /* adjust err stats: memp_malloc failed multiple times before */
1870:./lwip-2.1.2/src/core/tcp.c ****             MEMP_STATS_DEC(err, MEMP_TCP_PCB);
1871:./lwip-2.1.2/src/core/tcp.c ****           }
1872:./lwip-2.1.2/src/core/tcp.c ****         }
1873:./lwip-2.1.2/src/core/tcp.c ****         if (pcb != NULL) {
1874:./lwip-2.1.2/src/core/tcp.c ****           /* adjust err stats: memp_malloc failed multiple times before */
1875:./lwip-2.1.2/src/core/tcp.c ****           MEMP_STATS_DEC(err, MEMP_TCP_PCB);
1876:./lwip-2.1.2/src/core/tcp.c ****         }
1877:./lwip-2.1.2/src/core/tcp.c ****       }
1878:./lwip-2.1.2/src/core/tcp.c ****       if (pcb != NULL) {
1879:./lwip-2.1.2/src/core/tcp.c ****         /* adjust err stats: memp_malloc failed multiple times before */
1880:./lwip-2.1.2/src/core/tcp.c ****         MEMP_STATS_DEC(err, MEMP_TCP_PCB);
1881:./lwip-2.1.2/src/core/tcp.c ****       }
1882:./lwip-2.1.2/src/core/tcp.c ****     }
1883:./lwip-2.1.2/src/core/tcp.c ****     if (pcb != NULL) {
1884:./lwip-2.1.2/src/core/tcp.c ****       /* adjust err stats: memp_malloc failed above */
1885:./lwip-2.1.2/src/core/tcp.c ****       MEMP_STATS_DEC(err, MEMP_TCP_PCB);
1886:./lwip-2.1.2/src/core/tcp.c ****     }
1887:./lwip-2.1.2/src/core/tcp.c ****   }
1888:./lwip-2.1.2/src/core/tcp.c ****   if (pcb != NULL) {
1889:./lwip-2.1.2/src/core/tcp.c ****     /* zero out the whole pcb, so there is no need to initialize members to zero */
1890:./lwip-2.1.2/src/core/tcp.c ****     memset(pcb, 0, sizeof(struct tcp_pcb));
1891:./lwip-2.1.2/src/core/tcp.c ****     pcb->prio = prio;
1892:./lwip-2.1.2/src/core/tcp.c ****     pcb->snd_buf = TCP_SND_BUF;
1893:./lwip-2.1.2/src/core/tcp.c ****     /* Start with a window that does not need scaling. When window scaling is
1894:./lwip-2.1.2/src/core/tcp.c ****        enabled and used, the window is enlarged when both sides agree on scaling. */
1895:./lwip-2.1.2/src/core/tcp.c ****     pcb->rcv_wnd = pcb->rcv_ann_wnd = TCPWND_MIN16(TCP_WND);
1896:./lwip-2.1.2/src/core/tcp.c ****     pcb->ttl = TCP_TTL;
1897:./lwip-2.1.2/src/core/tcp.c ****     /* As initial send MSS, we use TCP_MSS but limit it to 536.
1898:./lwip-2.1.2/src/core/tcp.c ****        The send MSS is updated when an MSS option is received. */
1899:./lwip-2.1.2/src/core/tcp.c ****     pcb->mss = INITIAL_MSS;
1900:./lwip-2.1.2/src/core/tcp.c ****     pcb->rto = 3000 / TCP_SLOW_INTERVAL;
1901:./lwip-2.1.2/src/core/tcp.c ****     pcb->sv = 3000 / TCP_SLOW_INTERVAL;
1902:./lwip-2.1.2/src/core/tcp.c ****     pcb->rtime = -1;
1903:./lwip-2.1.2/src/core/tcp.c ****     pcb->cwnd = 1;
1904:./lwip-2.1.2/src/core/tcp.c ****     pcb->tmr = tcp_ticks;
1905:./lwip-2.1.2/src/core/tcp.c ****     pcb->last_timer = tcp_timer_ctr;
1906:./lwip-2.1.2/src/core/tcp.c **** 
1907:./lwip-2.1.2/src/core/tcp.c ****     /* RFC 5681 recommends setting ssthresh abritrarily high and gives an example
1908:./lwip-2.1.2/src/core/tcp.c ****     of using the largest advertised receive window.  We've seen complications with
1909:./lwip-2.1.2/src/core/tcp.c ****     receiving TCPs that use window scaling and/or window auto-tuning where the
1910:./lwip-2.1.2/src/core/tcp.c ****     initial advertised window is very small and then grows rapidly once the
1911:./lwip-2.1.2/src/core/tcp.c ****     connection is established. To avoid these complications, we set ssthresh to the
1912:./lwip-2.1.2/src/core/tcp.c ****     largest effective cwnd (amount of in-flight data) that the sender can have. */
1913:./lwip-2.1.2/src/core/tcp.c ****     pcb->ssthresh = TCP_SND_BUF;
1914:./lwip-2.1.2/src/core/tcp.c **** 
1915:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API
1916:./lwip-2.1.2/src/core/tcp.c ****     pcb->recv = tcp_recv_null;
1917:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_CALLBACK_API */
1918:./lwip-2.1.2/src/core/tcp.c **** 
1919:./lwip-2.1.2/src/core/tcp.c ****     /* Init KEEPALIVE timer */
1920:./lwip-2.1.2/src/core/tcp.c ****     pcb->keep_idle  = TCP_KEEPIDLE_DEFAULT;
1921:./lwip-2.1.2/src/core/tcp.c **** 
1922:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_TCP_KEEPALIVE
1923:./lwip-2.1.2/src/core/tcp.c ****     pcb->keep_intvl = TCP_KEEPINTVL_DEFAULT;
1924:./lwip-2.1.2/src/core/tcp.c ****     pcb->keep_cnt   = TCP_KEEPCNT_DEFAULT;
1925:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_TCP_KEEPALIVE */
1926:./lwip-2.1.2/src/core/tcp.c ****   }
1927:./lwip-2.1.2/src/core/tcp.c ****   return pcb;
1928:./lwip-2.1.2/src/core/tcp.c **** }
1929:./lwip-2.1.2/src/core/tcp.c **** 
1930:./lwip-2.1.2/src/core/tcp.c **** /**
1931:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
1932:./lwip-2.1.2/src/core/tcp.c ****  * Creates a new TCP protocol control block but doesn't place it on
1933:./lwip-2.1.2/src/core/tcp.c ****  * any of the TCP PCB lists.
1934:./lwip-2.1.2/src/core/tcp.c ****  * The pcb is not put on any list until binding using tcp_bind().
1935:./lwip-2.1.2/src/core/tcp.c ****  * If memory is not available for creating the new pcb, NULL is returned.
1936:./lwip-2.1.2/src/core/tcp.c ****  *
1937:./lwip-2.1.2/src/core/tcp.c ****  * @internal: Maybe there should be a idle TCP PCB list where these
1938:./lwip-2.1.2/src/core/tcp.c ****  * PCBs are put on. Port reservation using tcp_bind() is implemented but
1939:./lwip-2.1.2/src/core/tcp.c ****  * allocated pcbs that are not bound can't be killed automatically if wanting
1940:./lwip-2.1.2/src/core/tcp.c ****  * to allocate a pcb with higher prio (@see tcp_kill_prio())
1941:./lwip-2.1.2/src/core/tcp.c ****  *
1942:./lwip-2.1.2/src/core/tcp.c ****  * @return a new tcp_pcb that initially is in state CLOSED
1943:./lwip-2.1.2/src/core/tcp.c ****  */
1944:./lwip-2.1.2/src/core/tcp.c **** struct tcp_pcb *
1945:./lwip-2.1.2/src/core/tcp.c **** tcp_new(void)
1946:./lwip-2.1.2/src/core/tcp.c **** {
1947:./lwip-2.1.2/src/core/tcp.c ****   return tcp_alloc(TCP_PRIO_NORMAL);
1948:./lwip-2.1.2/src/core/tcp.c **** }
1949:./lwip-2.1.2/src/core/tcp.c **** 
1950:./lwip-2.1.2/src/core/tcp.c **** /**
1951:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
1952:./lwip-2.1.2/src/core/tcp.c ****  * Creates a new TCP protocol control block but doesn't
1953:./lwip-2.1.2/src/core/tcp.c ****  * place it on any of the TCP PCB lists.
1954:./lwip-2.1.2/src/core/tcp.c ****  * The pcb is not put on any list until binding using tcp_bind().
1955:./lwip-2.1.2/src/core/tcp.c ****  *
1956:./lwip-2.1.2/src/core/tcp.c ****  * @param type IP address type, see @ref lwip_ip_addr_type definitions.
1957:./lwip-2.1.2/src/core/tcp.c ****  * If you want to listen to IPv4 and IPv6 (dual-stack) connections,
1958:./lwip-2.1.2/src/core/tcp.c ****  * supply @ref IPADDR_TYPE_ANY as argument and bind to @ref IP_ANY_TYPE.
1959:./lwip-2.1.2/src/core/tcp.c ****  * @return a new tcp_pcb that initially is in state CLOSED
1960:./lwip-2.1.2/src/core/tcp.c ****  */
1961:./lwip-2.1.2/src/core/tcp.c **** struct tcp_pcb *
1962:./lwip-2.1.2/src/core/tcp.c **** tcp_new_ip_type(u8_t type)
1963:./lwip-2.1.2/src/core/tcp.c **** {
1964:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb;
1965:./lwip-2.1.2/src/core/tcp.c ****   pcb = tcp_alloc(TCP_PRIO_NORMAL);
1966:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_IPV4 && LWIP_IPV6
1967:./lwip-2.1.2/src/core/tcp.c ****   if (pcb != NULL) {
1968:./lwip-2.1.2/src/core/tcp.c ****     IP_SET_TYPE_VAL(pcb->local_ip, type);
1969:./lwip-2.1.2/src/core/tcp.c ****     IP_SET_TYPE_VAL(pcb->remote_ip, type);
1970:./lwip-2.1.2/src/core/tcp.c ****   }
1971:./lwip-2.1.2/src/core/tcp.c **** #else
1972:./lwip-2.1.2/src/core/tcp.c ****   LWIP_UNUSED_ARG(type);
1973:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_IPV4 && LWIP_IPV6 */
1974:./lwip-2.1.2/src/core/tcp.c ****   return pcb;
1975:./lwip-2.1.2/src/core/tcp.c **** }
1976:./lwip-2.1.2/src/core/tcp.c **** 
1977:./lwip-2.1.2/src/core/tcp.c **** /**
1978:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
1979:./lwip-2.1.2/src/core/tcp.c ****  * Specifies the program specific state that should be passed to all
1980:./lwip-2.1.2/src/core/tcp.c ****  * other callback functions. The "pcb" argument is the current TCP
1981:./lwip-2.1.2/src/core/tcp.c ****  * connection control block, and the "arg" argument is the argument
1982:./lwip-2.1.2/src/core/tcp.c ****  * that will be passed to the callbacks.
1983:./lwip-2.1.2/src/core/tcp.c ****  *
1984:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to set the callback argument
1985:./lwip-2.1.2/src/core/tcp.c ****  * @param arg void pointer argument to pass to callback functions
1986:./lwip-2.1.2/src/core/tcp.c ****  */
1987:./lwip-2.1.2/src/core/tcp.c **** void
1988:./lwip-2.1.2/src/core/tcp.c **** tcp_arg(struct tcp_pcb *pcb, void *arg)
1989:./lwip-2.1.2/src/core/tcp.c **** {
1990:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
1991:./lwip-2.1.2/src/core/tcp.c ****   /* This function is allowed to be called for both listen pcbs and
1992:./lwip-2.1.2/src/core/tcp.c ****      connection pcbs. */
1993:./lwip-2.1.2/src/core/tcp.c ****   if (pcb != NULL) {
1994:./lwip-2.1.2/src/core/tcp.c ****     pcb->callback_arg = arg;
1995:./lwip-2.1.2/src/core/tcp.c ****   }
1996:./lwip-2.1.2/src/core/tcp.c **** }
1997:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API
1998:./lwip-2.1.2/src/core/tcp.c **** 
1999:./lwip-2.1.2/src/core/tcp.c **** /**
2000:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
2001:./lwip-2.1.2/src/core/tcp.c ****  * Sets the callback function that will be called when new data
2002:./lwip-2.1.2/src/core/tcp.c ****  * arrives. The callback function will be passed a NULL pbuf to
2003:./lwip-2.1.2/src/core/tcp.c ****  * indicate that the remote host has closed the connection. If the
2004:./lwip-2.1.2/src/core/tcp.c ****  * callback function returns ERR_OK or ERR_ABRT it must have
2005:./lwip-2.1.2/src/core/tcp.c ****  * freed the pbuf, otherwise it must not have freed it.
2006:./lwip-2.1.2/src/core/tcp.c ****  *
2007:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to set the recv callback
2008:./lwip-2.1.2/src/core/tcp.c ****  * @param recv callback function to call for this pcb when data is received
2009:./lwip-2.1.2/src/core/tcp.c ****  */
2010:./lwip-2.1.2/src/core/tcp.c **** void
2011:./lwip-2.1.2/src/core/tcp.c **** tcp_recv(struct tcp_pcb *pcb, tcp_recv_fn recv)
2012:./lwip-2.1.2/src/core/tcp.c **** {
2013:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
2014:./lwip-2.1.2/src/core/tcp.c ****   if (pcb != NULL) {
2015:./lwip-2.1.2/src/core/tcp.c ****     LWIP_ASSERT("invalid socket state for recv callback", pcb->state != LISTEN);
2016:./lwip-2.1.2/src/core/tcp.c ****     pcb->recv = recv;
2017:./lwip-2.1.2/src/core/tcp.c ****   }
2018:./lwip-2.1.2/src/core/tcp.c **** }
2019:./lwip-2.1.2/src/core/tcp.c **** 
2020:./lwip-2.1.2/src/core/tcp.c **** /**
2021:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
2022:./lwip-2.1.2/src/core/tcp.c ****  * Specifies the callback function that should be called when data has
2023:./lwip-2.1.2/src/core/tcp.c ****  * successfully been received (i.e., acknowledged) by the remote
2024:./lwip-2.1.2/src/core/tcp.c ****  * host. The len argument passed to the callback function gives the
2025:./lwip-2.1.2/src/core/tcp.c ****  * amount bytes that was acknowledged by the last acknowledgment.
2026:./lwip-2.1.2/src/core/tcp.c ****  *
2027:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to set the sent callback
2028:./lwip-2.1.2/src/core/tcp.c ****  * @param sent callback function to call for this pcb when data is successfully sent
2029:./lwip-2.1.2/src/core/tcp.c ****  */
2030:./lwip-2.1.2/src/core/tcp.c **** void
2031:./lwip-2.1.2/src/core/tcp.c **** tcp_sent(struct tcp_pcb *pcb, tcp_sent_fn sent)
2032:./lwip-2.1.2/src/core/tcp.c **** {
2033:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
2034:./lwip-2.1.2/src/core/tcp.c ****   if (pcb != NULL) {
2035:./lwip-2.1.2/src/core/tcp.c ****     LWIP_ASSERT("invalid socket state for sent callback", pcb->state != LISTEN);
2036:./lwip-2.1.2/src/core/tcp.c ****     pcb->sent = sent;
2037:./lwip-2.1.2/src/core/tcp.c ****   }
2038:./lwip-2.1.2/src/core/tcp.c **** }
2039:./lwip-2.1.2/src/core/tcp.c **** 
2040:./lwip-2.1.2/src/core/tcp.c **** /**
2041:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
2042:./lwip-2.1.2/src/core/tcp.c ****  * Used to specify the function that should be called when a fatal error
2043:./lwip-2.1.2/src/core/tcp.c ****  * has occurred on the connection.
2044:./lwip-2.1.2/src/core/tcp.c ****  * 
2045:./lwip-2.1.2/src/core/tcp.c ****  * If a connection is aborted because of an error, the application is
2046:./lwip-2.1.2/src/core/tcp.c ****  * alerted of this event by the err callback. Errors that might abort a
2047:./lwip-2.1.2/src/core/tcp.c ****  * connection are when there is a shortage of memory. The callback
2048:./lwip-2.1.2/src/core/tcp.c ****  * function to be called is set using the tcp_err() function.
2049:./lwip-2.1.2/src/core/tcp.c ****  *
2050:./lwip-2.1.2/src/core/tcp.c ****  * @note The corresponding pcb is already freed when this callback is called!
2051:./lwip-2.1.2/src/core/tcp.c ****  *
2052:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to set the err callback
2053:./lwip-2.1.2/src/core/tcp.c ****  * @param err callback function to call for this pcb when a fatal error
2054:./lwip-2.1.2/src/core/tcp.c ****  *        has occurred on the connection
2055:./lwip-2.1.2/src/core/tcp.c ****  */
2056:./lwip-2.1.2/src/core/tcp.c **** void
2057:./lwip-2.1.2/src/core/tcp.c **** tcp_err(struct tcp_pcb *pcb, tcp_err_fn err)
2058:./lwip-2.1.2/src/core/tcp.c **** {
2059:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
2060:./lwip-2.1.2/src/core/tcp.c ****   if (pcb != NULL) {
2061:./lwip-2.1.2/src/core/tcp.c ****     LWIP_ASSERT("invalid socket state for err callback", pcb->state != LISTEN);
2062:./lwip-2.1.2/src/core/tcp.c ****     pcb->errf = err;
2063:./lwip-2.1.2/src/core/tcp.c ****   }
2064:./lwip-2.1.2/src/core/tcp.c **** }
2065:./lwip-2.1.2/src/core/tcp.c **** 
2066:./lwip-2.1.2/src/core/tcp.c **** /**
2067:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
2068:./lwip-2.1.2/src/core/tcp.c ****  * Used for specifying the function that should be called when a
2069:./lwip-2.1.2/src/core/tcp.c ****  * LISTENing connection has been connected to another host.
2070:./lwip-2.1.2/src/core/tcp.c ****  *
2071:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to set the accept callback
2072:./lwip-2.1.2/src/core/tcp.c ****  * @param accept callback function to call for this pcb when LISTENing
2073:./lwip-2.1.2/src/core/tcp.c ****  *        connection has been connected to another host
2074:./lwip-2.1.2/src/core/tcp.c ****  */
2075:./lwip-2.1.2/src/core/tcp.c **** void
2076:./lwip-2.1.2/src/core/tcp.c **** tcp_accept(struct tcp_pcb *pcb, tcp_accept_fn accept)
2077:./lwip-2.1.2/src/core/tcp.c **** {
2078:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
2079:./lwip-2.1.2/src/core/tcp.c ****   if ((pcb != NULL) && (pcb->state == LISTEN)) {
2080:./lwip-2.1.2/src/core/tcp.c ****     struct tcp_pcb_listen *lpcb = (struct tcp_pcb_listen *)pcb;
2081:./lwip-2.1.2/src/core/tcp.c ****     lpcb->accept = accept;
2082:./lwip-2.1.2/src/core/tcp.c ****   }
2083:./lwip-2.1.2/src/core/tcp.c **** }
2084:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_CALLBACK_API */
2085:./lwip-2.1.2/src/core/tcp.c **** 
2086:./lwip-2.1.2/src/core/tcp.c **** 
2087:./lwip-2.1.2/src/core/tcp.c **** /**
2088:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp_raw
2089:./lwip-2.1.2/src/core/tcp.c ****  * Specifies the polling interval and the callback function that should
2090:./lwip-2.1.2/src/core/tcp.c ****  * be called to poll the application. The interval is specified in
2091:./lwip-2.1.2/src/core/tcp.c ****  * number of TCP coarse grained timer shots, which typically occurs
2092:./lwip-2.1.2/src/core/tcp.c ****  * twice a second. An interval of 10 means that the application would
2093:./lwip-2.1.2/src/core/tcp.c ****  * be polled every 5 seconds.
2094:./lwip-2.1.2/src/core/tcp.c ****  * 
2095:./lwip-2.1.2/src/core/tcp.c ****  * When a connection is idle (i.e., no data is either transmitted or
2096:./lwip-2.1.2/src/core/tcp.c ****  * received), lwIP will repeatedly poll the application by calling a
2097:./lwip-2.1.2/src/core/tcp.c ****  * specified callback function. This can be used either as a watchdog
2098:./lwip-2.1.2/src/core/tcp.c ****  * timer for killing connections that have stayed idle for too long, or
2099:./lwip-2.1.2/src/core/tcp.c ****  * as a method of waiting for memory to become available. For instance,
2100:./lwip-2.1.2/src/core/tcp.c ****  * if a call to tcp_write() has failed because memory wasn't available,
2101:./lwip-2.1.2/src/core/tcp.c ****  * the application may use the polling functionality to call tcp_write()
2102:./lwip-2.1.2/src/core/tcp.c ****  * again when the connection has been idle for a while.
2103:./lwip-2.1.2/src/core/tcp.c ****  */
2104:./lwip-2.1.2/src/core/tcp.c **** void
2105:./lwip-2.1.2/src/core/tcp.c **** tcp_poll(struct tcp_pcb *pcb, tcp_poll_fn poll, u8_t interval)
2106:./lwip-2.1.2/src/core/tcp.c **** {
2107:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
2108:./lwip-2.1.2/src/core/tcp.c **** 
2109:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_poll: invalid pcb", pcb != NULL, return);
2110:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("invalid socket state for poll", pcb->state != LISTEN);
2111:./lwip-2.1.2/src/core/tcp.c **** 
2112:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_CALLBACK_API
2113:./lwip-2.1.2/src/core/tcp.c ****   pcb->poll = poll;
2114:./lwip-2.1.2/src/core/tcp.c **** #else /* LWIP_CALLBACK_API */
2115:./lwip-2.1.2/src/core/tcp.c ****   LWIP_UNUSED_ARG(poll);
2116:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_CALLBACK_API */
2117:./lwip-2.1.2/src/core/tcp.c ****   pcb->pollinterval = interval;
2118:./lwip-2.1.2/src/core/tcp.c **** }
2119:./lwip-2.1.2/src/core/tcp.c **** 
2120:./lwip-2.1.2/src/core/tcp.c **** /**
2121:./lwip-2.1.2/src/core/tcp.c ****  * Purges a TCP PCB. Removes any buffered data and frees the buffer memory
2122:./lwip-2.1.2/src/core/tcp.c ****  * (pcb->ooseq, pcb->unsent and pcb->unacked are freed).
2123:./lwip-2.1.2/src/core/tcp.c ****  *
2124:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to purge. The pcb itself is not deallocated!
2125:./lwip-2.1.2/src/core/tcp.c ****  */
2126:./lwip-2.1.2/src/core/tcp.c **** void
2127:./lwip-2.1.2/src/core/tcp.c **** tcp_pcb_purge(struct tcp_pcb *pcb)
2128:./lwip-2.1.2/src/core/tcp.c **** {
2129:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_pcb_purge: invalid pcb", pcb != NULL, return);
2130:./lwip-2.1.2/src/core/tcp.c **** 
2131:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->state != CLOSED &&
2132:./lwip-2.1.2/src/core/tcp.c ****       pcb->state != TIME_WAIT &&
2133:./lwip-2.1.2/src/core/tcp.c ****       pcb->state != LISTEN) {
2134:./lwip-2.1.2/src/core/tcp.c **** 
2135:./lwip-2.1.2/src/core/tcp.c ****     LWIP_DEBUGF(TCP_DEBUG, ("tcp_pcb_purge\n"));
2136:./lwip-2.1.2/src/core/tcp.c **** 
2137:./lwip-2.1.2/src/core/tcp.c ****     tcp_backlog_accepted(pcb);
2138:./lwip-2.1.2/src/core/tcp.c **** 
2139:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->refused_data != NULL) {
2140:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_pcb_purge: data left on ->refused_data\n"));
2141:./lwip-2.1.2/src/core/tcp.c ****       pbuf_free(pcb->refused_data);
2142:./lwip-2.1.2/src/core/tcp.c ****       pcb->refused_data = NULL;
2143:./lwip-2.1.2/src/core/tcp.c ****     }
2144:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->unsent != NULL) {
2145:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_pcb_purge: not all data sent\n"));
2146:./lwip-2.1.2/src/core/tcp.c ****     }
2147:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->unacked != NULL) {
2148:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_pcb_purge: data left on ->unacked\n"));
2149:./lwip-2.1.2/src/core/tcp.c ****     }
2150:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ
2151:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->ooseq != NULL) {
2152:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_pcb_purge: data left on ->ooseq\n"));
2153:./lwip-2.1.2/src/core/tcp.c ****       tcp_free_ooseq(pcb);
2154:./lwip-2.1.2/src/core/tcp.c ****     }
2155:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ */
2156:./lwip-2.1.2/src/core/tcp.c **** 
2157:./lwip-2.1.2/src/core/tcp.c ****     /* Stop the retransmission timer as it will expect data on unacked
2158:./lwip-2.1.2/src/core/tcp.c ****        queue if it fires */
2159:./lwip-2.1.2/src/core/tcp.c ****     pcb->rtime = -1;
2160:./lwip-2.1.2/src/core/tcp.c **** 
2161:./lwip-2.1.2/src/core/tcp.c ****     tcp_segs_free(pcb->unsent);
2162:./lwip-2.1.2/src/core/tcp.c ****     tcp_segs_free(pcb->unacked);
2163:./lwip-2.1.2/src/core/tcp.c ****     pcb->unacked = pcb->unsent = NULL;
2164:./lwip-2.1.2/src/core/tcp.c **** #if TCP_OVERSIZE
2165:./lwip-2.1.2/src/core/tcp.c ****     pcb->unsent_oversize = 0;
2166:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_OVERSIZE */
2167:./lwip-2.1.2/src/core/tcp.c ****   }
2168:./lwip-2.1.2/src/core/tcp.c **** }
2169:./lwip-2.1.2/src/core/tcp.c **** 
2170:./lwip-2.1.2/src/core/tcp.c **** /**
2171:./lwip-2.1.2/src/core/tcp.c ****  * Purges the PCB and removes it from a PCB list. Any delayed ACKs are sent first.
2172:./lwip-2.1.2/src/core/tcp.c ****  *
2173:./lwip-2.1.2/src/core/tcp.c ****  * @param pcblist PCB list to purge.
2174:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb tcp_pcb to purge. The pcb itself is NOT deallocated!
2175:./lwip-2.1.2/src/core/tcp.c ****  */
2176:./lwip-2.1.2/src/core/tcp.c **** void
2177:./lwip-2.1.2/src/core/tcp.c **** tcp_pcb_remove(struct tcp_pcb **pcblist, struct tcp_pcb *pcb)
2178:./lwip-2.1.2/src/core/tcp.c **** {
2179:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_pcb_remove: invalid pcb", pcb != NULL);
2180:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_pcb_remove: invalid pcblist", pcblist != NULL);
2181:./lwip-2.1.2/src/core/tcp.c **** 
2182:./lwip-2.1.2/src/core/tcp.c ****   TCP_RMV(pcblist, pcb);
2183:./lwip-2.1.2/src/core/tcp.c **** 
2184:./lwip-2.1.2/src/core/tcp.c ****   tcp_pcb_purge(pcb);
2185:./lwip-2.1.2/src/core/tcp.c **** 
2186:./lwip-2.1.2/src/core/tcp.c ****   /* if there is an outstanding delayed ACKs, send it */
2187:./lwip-2.1.2/src/core/tcp.c ****   if ((pcb->state != TIME_WAIT) &&
2188:./lwip-2.1.2/src/core/tcp.c ****       (pcb->state != LISTEN) &&
2189:./lwip-2.1.2/src/core/tcp.c ****       (pcb->flags & TF_ACK_DELAY)) {
2190:./lwip-2.1.2/src/core/tcp.c ****     tcp_ack_now(pcb);
2191:./lwip-2.1.2/src/core/tcp.c ****     tcp_output(pcb);
2192:./lwip-2.1.2/src/core/tcp.c ****   }
2193:./lwip-2.1.2/src/core/tcp.c **** 
2194:./lwip-2.1.2/src/core/tcp.c ****   if (pcb->state != LISTEN) {
2195:./lwip-2.1.2/src/core/tcp.c ****     LWIP_ASSERT("unsent segments leaking", pcb->unsent == NULL);

1472:./lwip-2.1.2/src/core/tcp.c **** /**
1473:./lwip-2.1.2/src/core/tcp.c ****  * Is called every TCP_FAST_INTERVAL (250 ms) and process data previously
1474:./lwip-2.1.2/src/core/tcp.c ****  * "refused" by upper layer (application) and sends delayed ACKs or pending FINs.
1475:./lwip-2.1.2/src/core/tcp.c ****  *
1476:./lwip-2.1.2/src/core/tcp.c ****  * Automatically called from tcp_tmr().
1477:./lwip-2.1.2/src/core/tcp.c ****  */
1478:./lwip-2.1.2/src/core/tcp.c **** void
1479:./lwip-2.1.2/src/core/tcp.c **** tcp_fasttmr(void)
1480:./lwip-2.1.2/src/core/tcp.c **** {
1481:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb;
1482:./lwip-2.1.2/src/core/tcp.c **** 
1483:./lwip-2.1.2/src/core/tcp.c ****   ++tcp_timer_ctr;
1484:./lwip-2.1.2/src/core/tcp.c **** 
1485:./lwip-2.1.2/src/core/tcp.c **** tcp_fasttmr_start:
1486:./lwip-2.1.2/src/core/tcp.c ****   pcb = tcp_active_pcbs;
1487:./lwip-2.1.2/src/core/tcp.c **** 
1488:./lwip-2.1.2/src/core/tcp.c ****   while (pcb != NULL) {
1489:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->last_timer != tcp_timer_ctr) {
1490:./lwip-2.1.2/src/core/tcp.c ****       struct tcp_pcb *next;
1491:./lwip-2.1.2/src/core/tcp.c ****       pcb->last_timer = tcp_timer_ctr;
1492:./lwip-2.1.2/src/core/tcp.c ****       /* send delayed ACKs */
1493:./lwip-2.1.2/src/core/tcp.c ****       if (pcb->flags & TF_ACK_DELAY) {
1494:./lwip-2.1.2/src/core/tcp.c ****         LWIP_DEBUGF(TCP_DEBUG, ("tcp_fasttmr: delayed ACK\n"));
1495:./lwip-2.1.2/src/core/tcp.c ****         tcp_ack_now(pcb);
1496:./lwip-2.1.2/src/core/tcp.c ****         tcp_output(pcb);
1497:./lwip-2.1.2/src/core/tcp.c ****         tcp_clear_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
1498:./lwip-2.1.2/src/core/tcp.c ****       }
1499:./lwip-2.1.2/src/core/tcp.c ****       /* send pending FIN */
1500:./lwip-2.1.2/src/core/tcp.c ****       if (pcb->flags & TF_CLOSEPEND) {
1501:./lwip-2.1.2/src/core/tcp.c ****         LWIP_DEBUGF(TCP_DEBUG, ("tcp_fasttmr: pending FIN\n"));
1502:./lwip-2.1.2/src/core/tcp.c ****         tcp_clear_flags(pcb, TF_CLOSEPEND);
1503:./lwip-2.1.2/src/core/tcp.c ****         tcp_close_shutdown_fin(pcb);
1504:./lwip-2.1.2/src/core/tcp.c ****       }
1505:./lwip-2.1.2/src/core/tcp.c **** 
1506:./lwip-2.1.2/src/core/tcp.c ****       next = pcb->next;
1507:./lwip-2.1.2/src/core/tcp.c **** 
1508:./lwip-2.1.2/src/core/tcp.c ****       /* If there is data which was previously "refused" by upper layer */
1509:./lwip-2.1.2/src/core/tcp.c ****       if (pcb->refused_data != NULL) {
1510:./lwip-2.1.2/src/core/tcp.c ****         tcp_active_pcbs_changed = 0;
1511:./lwip-2.1.2/src/core/tcp.c ****         tcp_process_refused_data(pcb);
1512:./lwip-2.1.2/src/core/tcp.c ****         if (tcp_active_pcbs_changed) {
1513:./lwip-2.1.2/src/core/tcp.c ****           /* application callback has changed the pcb list: restart the loop */
1514:./lwip-2.1.2/src/core/tcp.c ****           goto tcp_fasttmr_start;
1515:./lwip-2.1.2/src/core/tcp.c ****         }
1516:./lwip-2.1.2/src/core/tcp.c ****       }
1517:./lwip-2.1.2/src/core/tcp.c ****       pcb = next;
1518:./lwip-2.1.2/src/core/tcp.c ****     } else {
1519:./lwip-2.1.2/src/core/tcp.c ****       pcb = pcb->next;
1520:./lwip-2.1.2/src/core/tcp.c ****     }
1521:./lwip-2.1.2/src/core/tcp.c ****   }
1522:./lwip-2.1.2/src/core/tcp.c **** }
1523:./lwip-2.1.2/src/core/tcp.c **** 
1524:./lwip-2.1.2/src/core/tcp.c **** /** Call tcp_output for all active pcbs that have TF_NAGLEMEMERR set */
1525:./lwip-2.1.2/src/core/tcp.c **** void
1526:./lwip-2.1.2/src/core/tcp.c **** tcp_txnow(void)
1527:./lwip-2.1.2/src/core/tcp.c **** {
1528:./lwip-2.1.2/src/core/tcp.c ****   struct tcp_pcb *pcb;
1529:./lwip-2.1.2/src/core/tcp.c **** 
1530:./lwip-2.1.2/src/core/tcp.c ****   for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
1531:./lwip-2.1.2/src/core/tcp.c ****     if (pcb->flags & TF_NAGLEMEMERR) {
1532:./lwip-2.1.2/src/core/tcp.c ****       tcp_output(pcb);
1533:./lwip-2.1.2/src/core/tcp.c ****     }
1534:./lwip-2.1.2/src/core/tcp.c ****   }
1535:./lwip-2.1.2/src/core/tcp.c **** }
1536:./lwip-2.1.2/src/core/tcp.c **** 
1537:./lwip-2.1.2/src/core/tcp.c **** /** Pass pcb->refused_data to the recv callback */
1538:./lwip-2.1.2/src/core/tcp.c **** err_t
1539:./lwip-2.1.2/src/core/tcp.c **** tcp_process_refused_data(struct tcp_pcb *pcb)
1540:./lwip-2.1.2/src/core/tcp.c **** {
1541:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
1542:./lwip-2.1.2/src/core/tcp.c ****   struct pbuf *rest;
1543:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */
1544:./lwip-2.1.2/src/core/tcp.c **** 
1545:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_process_refused_data: invalid pcb", pcb != NULL, return ERR_ARG);
1546:./lwip-2.1.2/src/core/tcp.c **** 
1547:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
1548:./lwip-2.1.2/src/core/tcp.c ****   while (pcb->refused_data != NULL)
1549:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */
1550:./lwip-2.1.2/src/core/tcp.c ****   {
1551:./lwip-2.1.2/src/core/tcp.c ****     err_t err;
1552:./lwip-2.1.2/src/core/tcp.c ****     u8_t refused_flags = pcb->refused_data->flags;
1553:./lwip-2.1.2/src/core/tcp.c ****     /* set pcb->refused_data to NULL in case the callback frees it and then
1554:./lwip-2.1.2/src/core/tcp.c ****        closes the pcb */
1555:./lwip-2.1.2/src/core/tcp.c ****     struct pbuf *refused_data = pcb->refused_data;
1556:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
1557:./lwip-2.1.2/src/core/tcp.c ****     pbuf_split_64k(refused_data, &rest);
1558:./lwip-2.1.2/src/core/tcp.c ****     pcb->refused_data = rest;
1559:./lwip-2.1.2/src/core/tcp.c **** #else /* TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */
1560:./lwip-2.1.2/src/core/tcp.c ****     pcb->refused_data = NULL;
1561:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */
1562:./lwip-2.1.2/src/core/tcp.c ****     /* Notify again application with data previously received. */
1563:./lwip-2.1.2/src/core/tcp.c ****     LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: notify kept packet\n"));
1564:./lwip-2.1.2/src/core/tcp.c ****     TCP_EVENT_RECV(pcb, refused_data, ERR_OK, err);
1565:./lwip-2.1.2/src/core/tcp.c ****     if (err == ERR_OK) {
1566:./lwip-2.1.2/src/core/tcp.c ****       /* did refused_data include a FIN? */
1567:./lwip-2.1.2/src/core/tcp.c ****       if ((refused_flags & PBUF_FLAG_TCP_FIN)
1568:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
1569:./lwip-2.1.2/src/core/tcp.c ****           && (rest == NULL)
1570:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */
1571:./lwip-2.1.2/src/core/tcp.c ****          ) {
1572:./lwip-2.1.2/src/core/tcp.c ****         /* correct rcv_wnd as the application won't call tcp_recved()
1573:./lwip-2.1.2/src/core/tcp.c ****            for the FIN's seqno */
1574:./lwip-2.1.2/src/core/tcp.c ****         if (pcb->rcv_wnd != TCP_WND_MAX(pcb)) {
1575:./lwip-2.1.2/src/core/tcp.c ****           pcb->rcv_wnd++;
1576:./lwip-2.1.2/src/core/tcp.c ****         }
1577:./lwip-2.1.2/src/core/tcp.c ****         TCP_EVENT_CLOSED(pcb, err);
1578:./lwip-2.1.2/src/core/tcp.c ****         if (err == ERR_ABRT) {
1579:./lwip-2.1.2/src/core/tcp.c ****           return ERR_ABRT;
1580:./lwip-2.1.2/src/core/tcp.c ****         }
1581:./lwip-2.1.2/src/core/tcp.c ****       }
1582:./lwip-2.1.2/src/core/tcp.c ****     } else if (err == ERR_ABRT) {
1583:./lwip-2.1.2/src/core/tcp.c ****       /* if err == ERR_ABRT, 'pcb' is already deallocated */
1584:./lwip-2.1.2/src/core/tcp.c ****       /* Drop incoming packets because pcb is "full" (only if the incoming
1585:./lwip-2.1.2/src/core/tcp.c ****          segment contains data). */
1586:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: drop incoming packets, because pcb is \"full\"\n"))
1587:./lwip-2.1.2/src/core/tcp.c ****       return ERR_ABRT;
1588:./lwip-2.1.2/src/core/tcp.c ****     } else {
1589:./lwip-2.1.2/src/core/tcp.c ****       /* data is still refused, pbuf is still valid (go on for ACK-only packets) */
1590:./lwip-2.1.2/src/core/tcp.c **** #if TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
1591:./lwip-2.1.2/src/core/tcp.c ****       if (rest != NULL) {
1592:./lwip-2.1.2/src/core/tcp.c ****         pbuf_cat(refused_data, rest);
1593:./lwip-2.1.2/src/core/tcp.c ****       }
1594:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_QUEUE_OOSEQ && LWIP_WND_SCALE */
1595:./lwip-2.1.2/src/core/tcp.c ****       pcb->refused_data = refused_data;
1596:./lwip-2.1.2/src/core/tcp.c ****       return ERR_INPROGRESS;
1597:./lwip-2.1.2/src/core/tcp.c ****     }
1598:./lwip-2.1.2/src/core/tcp.c ****   }
1599:./lwip-2.1.2/src/core/tcp.c ****   return ERR_OK;
1600:./lwip-2.1.2/src/core/tcp.c **** }

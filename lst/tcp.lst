 164:./lwip-2.1.2/src/core/tcp.c **** { 1, 2, 3, 4, 5, 6, 7, 7, 7, 7, 7, 7, 7};
 165:./lwip-2.1.2/src/core/tcp.c **** /* Times per slowtmr hits */
 166:./lwip-2.1.2/src/core/tcp.c **** static const u8_t tcp_persist_backoff[7] = { 3, 6, 12, 24, 48, 96, 120 };

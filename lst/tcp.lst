 923:./lwip-2.1.2/src/core/tcp.c **** /**
 924:./lwip-2.1.2/src/core/tcp.c ****  * Update the state that tracks the available window space to advertise.
 925:./lwip-2.1.2/src/core/tcp.c ****  *
 926:./lwip-2.1.2/src/core/tcp.c ****  * Returns how much extra window would be advertised if we sent an
 927:./lwip-2.1.2/src/core/tcp.c ****  * update now.
 928:./lwip-2.1.2/src/core/tcp.c ****  */
 929:./lwip-2.1.2/src/core/tcp.c **** u32_t
 930:./lwip-2.1.2/src/core/tcp.c **** tcp_update_rcv_ann_wnd(struct tcp_pcb *pcb)
 931:./lwip-2.1.2/src/core/tcp.c **** {
 932:./lwip-2.1.2/src/core/tcp.c ****   u32_t new_right_edge;
 933:./lwip-2.1.2/src/core/tcp.c **** 
 934:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT("tcp_update_rcv_ann_wnd: invalid pcb", pcb != NULL);
 935:./lwip-2.1.2/src/core/tcp.c ****   new_right_edge = pcb->rcv_nxt + pcb->rcv_wnd;
 936:./lwip-2.1.2/src/core/tcp.c **** 
 937:./lwip-2.1.2/src/core/tcp.c ****   if (TCP_SEQ_GEQ(new_right_edge, pcb->rcv_ann_right_edge + LWIP_MIN((TCP_WND / 2), pcb->mss))) {
 938:./lwip-2.1.2/src/core/tcp.c ****     /* we can advertise more window */
 939:./lwip-2.1.2/src/core/tcp.c ****     pcb->rcv_ann_wnd = pcb->rcv_wnd;
 940:./lwip-2.1.2/src/core/tcp.c ****     return new_right_edge - pcb->rcv_ann_right_edge;
 941:./lwip-2.1.2/src/core/tcp.c ****   } else {
 942:./lwip-2.1.2/src/core/tcp.c ****     if (TCP_SEQ_GT(pcb->rcv_nxt, pcb->rcv_ann_right_edge)) {
 943:./lwip-2.1.2/src/core/tcp.c ****       /* Can happen due to other end sending out of advertised window,
 944:./lwip-2.1.2/src/core/tcp.c ****        * but within actual available (but not yet advertised) window */
 945:./lwip-2.1.2/src/core/tcp.c ****       pcb->rcv_ann_wnd = 0;

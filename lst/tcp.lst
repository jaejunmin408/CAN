1630:./lwip-2.1.2/src/core/tcp.c **** #endif /* TCP_DEBUG */
1631:./lwip-2.1.2/src/core/tcp.c ****     }
1632:./lwip-2.1.2/src/core/tcp.c ****     memp_free(MEMP_TCP_SEG, seg);
1633:./lwip-2.1.2/src/core/tcp.c ****   }
1634:./lwip-2.1.2/src/core/tcp.c **** }
1635:./lwip-2.1.2/src/core/tcp.c **** 
1636:./lwip-2.1.2/src/core/tcp.c **** /**
1637:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp
1638:./lwip-2.1.2/src/core/tcp.c ****  * Sets the priority of a connection.
1639:./lwip-2.1.2/src/core/tcp.c ****  *
1640:./lwip-2.1.2/src/core/tcp.c ****  * @param pcb the tcp_pcb to manipulate
1641:./lwip-2.1.2/src/core/tcp.c ****  * @param prio new priority
1642:./lwip-2.1.2/src/core/tcp.c ****  */
1643:./lwip-2.1.2/src/core/tcp.c **** void
1644:./lwip-2.1.2/src/core/tcp.c **** tcp_setprio(struct tcp_pcb *pcb, u8_t prio)
1645:./lwip-2.1.2/src/core/tcp.c **** {
1646:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ASSERT_CORE_LOCKED();
1647:./lwip-2.1.2/src/core/tcp.c **** 
1648:./lwip-2.1.2/src/core/tcp.c ****   LWIP_ERROR("tcp_setprio: invalid pcb", pcb != NULL, return);
1649:./lwip-2.1.2/src/core/tcp.c **** 

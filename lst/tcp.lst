 121:./lwip-2.1.2/src/core/tcp.c **** #ifndef TCP_LOCAL_PORT_RANGE_START
 122:./lwip-2.1.2/src/core/tcp.c **** /* From http://www.iana.org/assignments/port-numbers:
 123:./lwip-2.1.2/src/core/tcp.c ****    "The Dynamic and/or Private Ports are those from 49152 through 65535" */
 124:./lwip-2.1.2/src/core/tcp.c **** #define TCP_LOCAL_PORT_RANGE_START        0xc000
 125:./lwip-2.1.2/src/core/tcp.c **** #define TCP_LOCAL_PORT_RANGE_END          0xffff
 126:./lwip-2.1.2/src/core/tcp.c **** #define TCP_ENSURE_LOCAL_PORT_RANGE(port) ((u16_t)(((port) & (u16_t)~TCP_LOCAL_PORT_RANGE_START) + 
 127:./lwip-2.1.2/src/core/tcp.c **** #endif
 128:./lwip-2.1.2/src/core/tcp.c **** 
 129:./lwip-2.1.2/src/core/tcp.c **** #if LWIP_TCP_KEEPALIVE
 130:./lwip-2.1.2/src/core/tcp.c **** #define TCP_KEEP_DUR(pcb)   ((pcb)->keep_cnt * (pcb)->keep_intvl)
 131:./lwip-2.1.2/src/core/tcp.c **** #define TCP_KEEP_INTVL(pcb) ((pcb)->keep_intvl)
 132:./lwip-2.1.2/src/core/tcp.c **** #else /* LWIP_TCP_KEEPALIVE */
 133:./lwip-2.1.2/src/core/tcp.c **** #define TCP_KEEP_DUR(pcb)   TCP_MAXIDLE
 134:./lwip-2.1.2/src/core/tcp.c **** #define TCP_KEEP_INTVL(pcb) TCP_KEEPINTVL_DEFAULT
 135:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_TCP_KEEPALIVE */
 136:./lwip-2.1.2/src/core/tcp.c **** 
 137:./lwip-2.1.2/src/core/tcp.c **** /* As initial send MSS, we use TCP_MSS but limit it to 536. */
 138:./lwip-2.1.2/src/core/tcp.c **** #if TCP_MSS > 536
 139:./lwip-2.1.2/src/core/tcp.c **** #define INITIAL_MSS 536
 140:./lwip-2.1.2/src/core/tcp.c **** #else
 141:./lwip-2.1.2/src/core/tcp.c **** #define INITIAL_MSS TCP_MSS

1296:./lwip-2.1.2/src/core/tcp.c ****             eff_wnd = LWIP_MIN(pcb->cwnd, pcb->snd_wnd);
1297:./lwip-2.1.2/src/core/tcp.c ****             pcb->ssthresh = eff_wnd >> 1;
1298:./lwip-2.1.2/src/core/tcp.c ****             if (pcb->ssthresh < (tcpwnd_size_t)(pcb->mss << 1)) {
1299:./lwip-2.1.2/src/core/tcp.c ****               pcb->ssthresh = (tcpwnd_size_t)(pcb->mss << 1);
1300:./lwip-2.1.2/src/core/tcp.c ****             }
1301:./lwip-2.1.2/src/core/tcp.c ****             pcb->cwnd = pcb->mss;

1634:./lwip-2.1.2/src/core/tcp.c **** }
1635:./lwip-2.1.2/src/core/tcp.c **** 
1636:./lwip-2.1.2/src/core/tcp.c **** /**
1637:./lwip-2.1.2/src/core/tcp.c ****  * @ingroup tcp
1638:./lwip-2.1.2/src/core/tcp.c ****  * Sets the priority of a connection.

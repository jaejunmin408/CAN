2311:./lwip-2.1.2/src/core/tcp.c ****         && (!IP_IS_V4_VAL(pcb->local_ip) || !ip4_addr_islinklocal(ip_2_ip4(&pcb->local_ip)))
2312:./lwip-2.1.2/src/core/tcp.c **** #endif /* LWIP_AUTOIP */
2313:./lwip-2.1.2/src/core/tcp.c ****        ) {
2314:./lwip-2.1.2/src/core/tcp.c ****       /* this connection must be aborted */
2315:./lwip-2.1.2/src/core/tcp.c ****       struct tcp_pcb *next = pcb->next;
2316:./lwip-2.1.2/src/core/tcp.c ****       LWIP_DEBUGF(NETIF_DEBUG | LWIP_DBG_STATE, ("netif_set_ipaddr: aborting TCP pcb %p\n", (void *

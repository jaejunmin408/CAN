 737:./inc/cmsis_gcc.h **** /**
 738:./inc/cmsis_gcc.h ****   \brief   Get Main Stack Pointer Limit
 739:./inc/cmsis_gcc.h ****   Devices without ARMv8-M Main Extensions (i.e. Cortex-M23) lack the non-secure
 740:./inc/cmsis_gcc.h ****   Stack Pointer Limit register hence zero is returned always in non-secure
 741:./inc/cmsis_gcc.h ****   mode.
 742:./inc/cmsis_gcc.h **** 
 743:./inc/cmsis_gcc.h ****   \details Returns the current value of the Main Stack Pointer Limit (MSPLIM).
 744:./inc/cmsis_gcc.h ****   \return               MSPLIM Register value
 745:./inc/cmsis_gcc.h ****  */
 746:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __get_MSPLIM(void)
 747:./inc/cmsis_gcc.h **** {
 748:./inc/cmsis_gcc.h **** #if (!(defined (__ARM_ARCH_8M_MAIN__ ) && (__ARM_ARCH_8M_MAIN__ == 1)) && \
 749:./inc/cmsis_gcc.h ****     (!defined (__ARM_FEATURE_CMSE) || (__ARM_FEATURE_CMSE < 3)))
 750:./inc/cmsis_gcc.h ****   // without main extensions, the non-secure MSPLIM is RAZ/WI
 751:./inc/cmsis_gcc.h ****   return 0U;

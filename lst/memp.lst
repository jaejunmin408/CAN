 724:./inc/cmsis_gcc.h ****  */
 725:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __TZ_set_PSPLIM_NS(uint32_t ProcStackPtrLimit)
 726:./inc/cmsis_gcc.h **** {

 695:./inc/cmsis_gcc.h **** /**
 696:./inc/cmsis_gcc.h ****   \brief   Set Process Stack Pointer Limit
 697:./inc/cmsis_gcc.h ****   Devices without ARMv8-M Main Extensions (i.e. Cortex-M23) lack the non-secure
 698:./inc/cmsis_gcc.h ****   Stack Pointer Limit register hence the write is silently ignored in non-secure
 699:./inc/cmsis_gcc.h ****   mode.
 700:./inc/cmsis_gcc.h ****   
 701:./inc/cmsis_gcc.h ****   \details Assigns the given value to the Process Stack Pointer Limit (PSPLIM).
 702:./inc/cmsis_gcc.h ****   \param [in]    ProcStackPtrLimit  Process Stack Pointer Limit value to set
 703:./inc/cmsis_gcc.h ****  */

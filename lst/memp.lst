  97:./lwip-2.1.2/src/core/memp.c **** /**
  98:./lwip-2.1.2/src/core/memp.c ****  * Check that memp-lists don't form a circle, using "Floyd's cycle-finding algorithm".
  99:./lwip-2.1.2/src/core/memp.c ****  */
 100:./lwip-2.1.2/src/core/memp.c **** static int
 101:./lwip-2.1.2/src/core/memp.c **** memp_sanity(const struct memp_desc *desc)
 102:./lwip-2.1.2/src/core/memp.c **** {
 103:./lwip-2.1.2/src/core/memp.c ****   struct memp *t, *h;
 104:./lwip-2.1.2/src/core/memp.c **** 
 105:./lwip-2.1.2/src/core/memp.c ****   t = *desc->tab;
 106:./lwip-2.1.2/src/core/memp.c ****   if (t != NULL) {
 107:./lwip-2.1.2/src/core/memp.c ****     for (h = t->next; (t != NULL) && (h != NULL); t = t->next,
 108:./lwip-2.1.2/src/core/memp.c ****          h = ((h->next != NULL) ? h->next->next : NULL)) {
 109:./lwip-2.1.2/src/core/memp.c ****       if (t == h) {
 110:./lwip-2.1.2/src/core/memp.c ****         return 0;
 111:./lwip-2.1.2/src/core/memp.c ****       }
 112:./lwip-2.1.2/src/core/memp.c ****     }
 113:./lwip-2.1.2/src/core/memp.c ****   }
 114:./lwip-2.1.2/src/core/memp.c **** 
 115:./lwip-2.1.2/src/core/memp.c ****   return 1;
 116:./lwip-2.1.2/src/core/memp.c **** }
 117:./lwip-2.1.2/src/core/memp.c **** #endif /* MEMP_SANITY_CHECK && !MEMP_MEM_MALLOC */

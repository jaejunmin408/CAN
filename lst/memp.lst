  97:./lwip-2.1.2/src/core/memp.c **** /**
  98:./lwip-2.1.2/src/core/memp.c ****  * Check that memp-lists don't form a circle, using "Floyd's cycle-finding algorithm".
  99:./lwip-2.1.2/src/core/memp.c ****  */
 100:./lwip-2.1.2/src/core/memp.c **** static int
 101:./lwip-2.1.2/src/core/memp.c **** memp_sanity(const struct memp_desc *desc)
 102:./lwip-2.1.2/src/core/memp.c **** {
 103:./lwip-2.1.2/src/core/memp.c ****   struct memp *t, *h;
 104:./lwip-2.1.2/src/core/memp.c **** 
 105:./lwip-2.1.2/src/core/memp.c ****   t = *desc->tab;
 106:./lwip-2.1.2/src/core/memp.c ****   if (t != NULL) {
 107:./lwip-2.1.2/src/core/memp.c ****     for (h = t->next; (t != NULL) && (h != NULL); t = t->next,
 108:./lwip-2.1.2/src/core/memp.c ****          h = ((h->next != NULL) ? h->next->next : NULL)) {
 109:./lwip-2.1.2/src/core/memp.c ****       if (t == h) {
 110:./lwip-2.1.2/src/core/memp.c ****         return 0;
 111:./lwip-2.1.2/src/core/memp.c ****       }
 112:./lwip-2.1.2/src/core/memp.c ****     }
 113:./lwip-2.1.2/src/core/memp.c ****   }
 114:./lwip-2.1.2/src/core/memp.c **** 
 115:./lwip-2.1.2/src/core/memp.c ****   return 1;
 116:./lwip-2.1.2/src/core/memp.c **** }
 117:./lwip-2.1.2/src/core/memp.c **** #endif /* MEMP_SANITY_CHECK && !MEMP_MEM_MALLOC */
 118:./lwip-2.1.2/src/core/memp.c **** 
 119:./lwip-2.1.2/src/core/memp.c **** #if MEMP_OVERFLOW_CHECK
 120:./lwip-2.1.2/src/core/memp.c **** /**
 121:./lwip-2.1.2/src/core/memp.c ****  * Check if a memp element was victim of an overflow or underflow
 122:./lwip-2.1.2/src/core/memp.c ****  * (e.g. the restricted area after/before it has been altered)
 123:./lwip-2.1.2/src/core/memp.c ****  *
 124:./lwip-2.1.2/src/core/memp.c ****  * @param p the memp element to check
 125:./lwip-2.1.2/src/core/memp.c ****  * @param desc the pool p comes from
 126:./lwip-2.1.2/src/core/memp.c ****  */
 127:./lwip-2.1.2/src/core/memp.c **** static void
 128:./lwip-2.1.2/src/core/memp.c **** memp_overflow_check_element(struct memp *p, const struct memp_desc *desc)
 129:./lwip-2.1.2/src/core/memp.c **** {
 130:./lwip-2.1.2/src/core/memp.c ****   mem_overflow_check_raw((u8_t *)p + MEMP_SIZE, desc->size, "pool ", desc->desc);
 131:./lwip-2.1.2/src/core/memp.c **** }
 132:./lwip-2.1.2/src/core/memp.c **** 
 133:./lwip-2.1.2/src/core/memp.c **** /**
 134:./lwip-2.1.2/src/core/memp.c ****  * Initialize the restricted area of on memp element.
 135:./lwip-2.1.2/src/core/memp.c ****  */
 136:./lwip-2.1.2/src/core/memp.c **** static void
 137:./lwip-2.1.2/src/core/memp.c **** memp_overflow_init_element(struct memp *p, const struct memp_desc *desc)
 138:./lwip-2.1.2/src/core/memp.c **** {
 139:./lwip-2.1.2/src/core/memp.c ****   mem_overflow_init_raw((u8_t *)p + MEMP_SIZE, desc->size);
 140:./lwip-2.1.2/src/core/memp.c **** }
 141:./lwip-2.1.2/src/core/memp.c **** 
 142:./lwip-2.1.2/src/core/memp.c **** #if MEMP_OVERFLOW_CHECK >= 2
 143:./lwip-2.1.2/src/core/memp.c **** /**
 144:./lwip-2.1.2/src/core/memp.c ****  * Do an overflow check for all elements in every pool.
 145:./lwip-2.1.2/src/core/memp.c ****  *
 146:./lwip-2.1.2/src/core/memp.c ****  * @see memp_overflow_check_element for a description of the check
 147:./lwip-2.1.2/src/core/memp.c ****  */
 148:./lwip-2.1.2/src/core/memp.c **** static void
 149:./lwip-2.1.2/src/core/memp.c **** memp_overflow_check_all(void)
 150:./lwip-2.1.2/src/core/memp.c **** {
 151:./lwip-2.1.2/src/core/memp.c ****   u16_t i, j;
 152:./lwip-2.1.2/src/core/memp.c ****   struct memp *p;
 153:./lwip-2.1.2/src/core/memp.c ****   SYS_ARCH_DECL_PROTECT(old_level);
 154:./lwip-2.1.2/src/core/memp.c ****   SYS_ARCH_PROTECT(old_level);
 155:./lwip-2.1.2/src/core/memp.c **** 
 156:./lwip-2.1.2/src/core/memp.c ****   for (i = 0; i < MEMP_MAX; ++i) {
 157:./lwip-2.1.2/src/core/memp.c ****     p = (struct memp *)LWIP_MEM_ALIGN(memp_pools[i]->base);
 158:./lwip-2.1.2/src/core/memp.c ****     for (j = 0; j < memp_pools[i]->num; ++j) {
 159:./lwip-2.1.2/src/core/memp.c ****       memp_overflow_check_element(p, memp_pools[i]);
 160:./lwip-2.1.2/src/core/memp.c ****       p = LWIP_ALIGNMENT_CAST(struct memp *, ((u8_t *)p + MEMP_SIZE + memp_pools[i]->size + MEM_SAN
 161:./lwip-2.1.2/src/core/memp.c ****     }
 162:./lwip-2.1.2/src/core/memp.c ****   }
 163:./lwip-2.1.2/src/core/memp.c ****   SYS_ARCH_UNPROTECT(old_level);
 164:./lwip-2.1.2/src/core/memp.c **** }
 165:./lwip-2.1.2/src/core/memp.c **** #endif /* MEMP_OVERFLOW_CHECK >= 2 */
 166:./lwip-2.1.2/src/core/memp.c **** #endif /* MEMP_OVERFLOW_CHECK */

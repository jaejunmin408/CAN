 191:./inc/cmsis_gcc.h **** /**
 192:./inc/cmsis_gcc.h ****   \brief   Enable IRQ Interrupts
 193:./inc/cmsis_gcc.h ****   \details Enables IRQ interrupts by clearing the I-bit in the CPSR.
 194:./inc/cmsis_gcc.h ****            Can only be executed in Privileged modes.
 195:./inc/cmsis_gcc.h ****  */
 196:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __enable_irq(void)
 197:./inc/cmsis_gcc.h **** {
 198:./inc/cmsis_gcc.h ****   __ASM volatile ("cpsie i" : : : "memory");
 199:./inc/cmsis_gcc.h **** }
 200:./inc/cmsis_gcc.h **** 
 201:./inc/cmsis_gcc.h **** 
 202:./inc/cmsis_gcc.h **** /**
 203:./inc/cmsis_gcc.h ****   \brief   Disable IRQ Interrupts
 204:./inc/cmsis_gcc.h ****   \details Disables IRQ interrupts by setting the I-bit in the CPSR.
 205:./inc/cmsis_gcc.h ****            Can only be executed in Privileged modes.
 206:./inc/cmsis_gcc.h ****  */
 207:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __disable_irq(void)
 208:./inc/cmsis_gcc.h **** {
 209:./inc/cmsis_gcc.h ****   __ASM volatile ("cpsid i" : : : "memory");
 210:./inc/cmsis_gcc.h **** }

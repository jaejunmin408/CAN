 678:./inc/cmsis_gcc.h ****   \details Returns the current value of the non-secure Process Stack Pointer Limit (PSPLIM) when in
 679:./inc/cmsis_gcc.h ****   \return               PSPLIM Register value
 680:./inc/cmsis_gcc.h ****  */
 681:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __TZ_get_PSPLIM_NS(void)
 682:./inc/cmsis_gcc.h **** {

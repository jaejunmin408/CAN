 684:./inc/cmsis_gcc.h ****   // without main extensions, the non-secure PSPLIM is RAZ/WI
 685:./inc/cmsis_gcc.h ****   return 0U;
 686:./inc/cmsis_gcc.h **** #else
 687:./inc/cmsis_gcc.h ****   uint32_t result;

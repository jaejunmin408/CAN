 248:./lwip-2.1.2/src/core/netif.c **** /**
 249:./lwip-2.1.2/src/core/netif.c ****  * @ingroup netif
 250:./lwip-2.1.2/src/core/netif.c ****  * Add a network interface to the list of lwIP netifs.
 251:./lwip-2.1.2/src/core/netif.c ****  *
 252:./lwip-2.1.2/src/core/netif.c ****  * @param netif a pre-allocated netif structure
 253:./lwip-2.1.2/src/core/netif.c ****  * @param ipaddr IP address for the new netif
 254:./lwip-2.1.2/src/core/netif.c ****  * @param netmask network mask for the new netif
 255:./lwip-2.1.2/src/core/netif.c ****  * @param gw default gateway IP address for the new netif
 256:./lwip-2.1.2/src/core/netif.c ****  * @param state opaque data passed to the new netif
 257:./lwip-2.1.2/src/core/netif.c ****  * @param init callback function that initializes the interface
 258:./lwip-2.1.2/src/core/netif.c ****  * @param input callback function that is called to pass
 259:./lwip-2.1.2/src/core/netif.c ****  * ingress packets up in the protocol layer stack.\n
 260:./lwip-2.1.2/src/core/netif.c ****  * It is recommended to use a function that passes the input directly
 261:./lwip-2.1.2/src/core/netif.c ****  * to the stack (netif_input(), NO_SYS=1 mode) or via sending a
 262:./lwip-2.1.2/src/core/netif.c ****  * message to TCPIP thread (tcpip_input(), NO_SYS=0 mode).\n
 263:./lwip-2.1.2/src/core/netif.c ****  * These functions use netif flags NETIF_FLAG_ETHARP and NETIF_FLAG_ETHERNET
 264:./lwip-2.1.2/src/core/netif.c ****  * to decide whether to forward to ethernet_input() or ip_input().
 265:./lwip-2.1.2/src/core/netif.c ****  * In other words, the functions only work when the netif
 266:./lwip-2.1.2/src/core/netif.c ****  * driver is implemented correctly!\n
 267:./lwip-2.1.2/src/core/netif.c ****  * Most members of struct netif should be be initialized by the
 268:./lwip-2.1.2/src/core/netif.c ****  * netif init function = netif driver (init parameter of this function).\n
 269:./lwip-2.1.2/src/core/netif.c ****  * IPv6: Don't forget to call netif_create_ip6_linklocal_address() after
 270:./lwip-2.1.2/src/core/netif.c ****  * setting the MAC address in struct netif.hwaddr
 271:./lwip-2.1.2/src/core/netif.c ****  * (IPv6 requires a link-local address).
 272:./lwip-2.1.2/src/core/netif.c ****  *
 273:./lwip-2.1.2/src/core/netif.c ****  * @return netif, or NULL if failed.
 274:./lwip-2.1.2/src/core/netif.c ****  */
 275:./lwip-2.1.2/src/core/netif.c **** struct netif *
 276:./lwip-2.1.2/src/core/netif.c **** netif_add(struct netif *netif,

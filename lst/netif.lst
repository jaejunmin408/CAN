 207:./lwip-2.1.2/src/core/netif.c **** /**
 208:./lwip-2.1.2/src/core/netif.c ****  * @ingroup lwip_nosys
 209:./lwip-2.1.2/src/core/netif.c ****  * Forwards a received packet for input processing with
 210:./lwip-2.1.2/src/core/netif.c ****  * ethernet_input() or ip_input() depending on netif flags.
 211:./lwip-2.1.2/src/core/netif.c ****  * Don't call directly, pass to netif_add() and call
 212:./lwip-2.1.2/src/core/netif.c ****  * netif->input().
 213:./lwip-2.1.2/src/core/netif.c ****  * Only works if the netif driver correctly sets
 214:./lwip-2.1.2/src/core/netif.c ****  * NETIF_FLAG_ETHARP and/or NETIF_FLAG_ETHERNET flag!
 215:./lwip-2.1.2/src/core/netif.c ****  */
 216:./lwip-2.1.2/src/core/netif.c **** err_t
 217:./lwip-2.1.2/src/core/netif.c **** netif_input(struct pbuf *p, struct netif *inp)
 218:./lwip-2.1.2/src/core/netif.c **** {
 219:./lwip-2.1.2/src/core/netif.c ****   LWIP_ASSERT_CORE_LOCKED();
 220:./lwip-2.1.2/src/core/netif.c **** 
 221:./lwip-2.1.2/src/core/netif.c ****   LWIP_ASSERT("netif_input: invalid pbuf", p != NULL);
 222:./lwip-2.1.2/src/core/netif.c ****   LWIP_ASSERT("netif_input: invalid netif", inp != NULL);
 223:./lwip-2.1.2/src/core/netif.c **** 
 224:./lwip-2.1.2/src/core/netif.c **** #if LWIP_ETHERNET

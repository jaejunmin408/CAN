 431:./lwip-2.1.2/src/core/netif.c ****   LWIP_DEBUGF(NETIF_DEBUG, (" gw "));
 432:./lwip-2.1.2/src/core/netif.c ****   ip4_addr_debug_print(NETIF_DEBUG, gw);
 433:./lwip-2.1.2/src/core/netif.c **** #endif /* LWIP_IPV4 */
 434:./lwip-2.1.2/src/core/netif.c ****   LWIP_DEBUGF(NETIF_DEBUG, ("\n"));
 435:./lwip-2.1.2/src/core/netif.c **** 

 421:./lwip-2.1.2/src/core/netif.c ****   }
 422:./lwip-2.1.2/src/core/netif.c **** #endif /* LWIP_IGMP */
 423:./lwip-2.1.2/src/core/netif.c **** 
 424:./lwip-2.1.2/src/core/netif.c ****   LWIP_DEBUGF(NETIF_DEBUG, ("netif: added interface %c%c IP",
 425:./lwip-2.1.2/src/core/netif.c ****                             netif->name[0], netif->name[1]));
 426:./lwip-2.1.2/src/core/netif.c **** #if LWIP_IPV4
 427:./lwip-2.1.2/src/core/netif.c ****   LWIP_DEBUGF(NETIF_DEBUG, (" addr "));
 428:./lwip-2.1.2/src/core/netif.c ****   ip4_addr_debug_print(NETIF_DEBUG, ipaddr);

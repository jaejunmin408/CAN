 143:./lwip-2.1.2/src/core/netif.c **** /**
 144:./lwip-2.1.2/src/core/netif.c ****  * Initialize a lwip network interface structure for a loopback interface
 145:./lwip-2.1.2/src/core/netif.c ****  *
 146:./lwip-2.1.2/src/core/netif.c ****  * @param netif the lwip network interface structure for this loopif
 147:./lwip-2.1.2/src/core/netif.c ****  * @return ERR_OK if the loopif is initialized
 148:./lwip-2.1.2/src/core/netif.c ****  *         ERR_MEM if private data couldn't be allocated
 149:./lwip-2.1.2/src/core/netif.c ****  */
 150:./lwip-2.1.2/src/core/netif.c **** static err_t
 151:./lwip-2.1.2/src/core/netif.c **** netif_loopif_init(struct netif *netif)
 152:./lwip-2.1.2/src/core/netif.c **** {
 153:./lwip-2.1.2/src/core/netif.c ****   LWIP_ASSERT("netif_loopif_init: invalid netif", netif != NULL);
 154:./lwip-2.1.2/src/core/netif.c **** 
 155:./lwip-2.1.2/src/core/netif.c ****   /* initialize the snmp variables and counters inside the struct netif
 156:./lwip-2.1.2/src/core/netif.c ****    * ifSpeed: no assumption can be made!
 157:./lwip-2.1.2/src/core/netif.c ****    */
 158:./lwip-2.1.2/src/core/netif.c ****   MIB2_INIT_NETIF(netif, snmp_ifType_softwareLoopback, 0);
 159:./lwip-2.1.2/src/core/netif.c **** 
 160:./lwip-2.1.2/src/core/netif.c ****   netif->name[0] = 'l';
 161:./lwip-2.1.2/src/core/netif.c ****   netif->name[1] = 'o';
 162:./lwip-2.1.2/src/core/netif.c **** #if LWIP_IPV4
 163:./lwip-2.1.2/src/core/netif.c ****   netif->output = netif_loop_output_ipv4;
 164:./lwip-2.1.2/src/core/netif.c **** #endif
 165:./lwip-2.1.2/src/core/netif.c **** #if LWIP_IPV6
 166:./lwip-2.1.2/src/core/netif.c ****   netif->output_ip6 = netif_loop_output_ipv6;
 167:./lwip-2.1.2/src/core/netif.c **** #endif
 168:./lwip-2.1.2/src/core/netif.c **** #if LWIP_LOOPIF_MULTICAST
 169:./lwip-2.1.2/src/core/netif.c ****   netif_set_flags(netif, NETIF_FLAG_IGMP);
 170:./lwip-2.1.2/src/core/netif.c **** #endif
 171:./lwip-2.1.2/src/core/netif.c ****   NETIF_SET_CHECKSUM_CTRL(netif, NETIF_CHECKSUM_DISABLE_ALL);
 172:./lwip-2.1.2/src/core/netif.c ****   return ERR_OK;
 173:./lwip-2.1.2/src/core/netif.c **** }
 174:./lwip-2.1.2/src/core/netif.c **** #endif /* LWIP_HAVE_LOOPIF */
 175:./lwip-2.1.2/src/core/netif.c **** 
 176:./lwip-2.1.2/src/core/netif.c **** void
 177:./lwip-2.1.2/src/core/netif.c **** netif_init(void)
 178:./lwip-2.1.2/src/core/netif.c **** {
 179:./lwip-2.1.2/src/core/netif.c **** #if LWIP_HAVE_LOOPIF
 180:./lwip-2.1.2/src/core/netif.c **** #if LWIP_IPV4
 181:./lwip-2.1.2/src/core/netif.c **** #define LOOPIF_ADDRINIT &loop_ipaddr, &loop_netmask, &loop_gw,
 182:./lwip-2.1.2/src/core/netif.c ****   ip4_addr_t loop_ipaddr, loop_netmask, loop_gw;
 183:./lwip-2.1.2/src/core/netif.c ****   IP4_ADDR(&loop_gw, 127, 0, 0, 1);
 184:./lwip-2.1.2/src/core/netif.c ****   IP4_ADDR(&loop_ipaddr, 127, 0, 0, 1);
 185:./lwip-2.1.2/src/core/netif.c ****   IP4_ADDR(&loop_netmask, 255, 0, 0, 0);
 186:./lwip-2.1.2/src/core/netif.c **** #else /* LWIP_IPV4 */
 187:./lwip-2.1.2/src/core/netif.c **** #define LOOPIF_ADDRINIT
 188:./lwip-2.1.2/src/core/netif.c **** #endif /* LWIP_IPV4 */
 189:./lwip-2.1.2/src/core/netif.c **** 
 190:./lwip-2.1.2/src/core/netif.c **** #if NO_SYS
 191:./lwip-2.1.2/src/core/netif.c ****   netif_add(&loop_netif, LOOPIF_ADDRINIT NULL, netif_loopif_init, ip_input);
 192:./lwip-2.1.2/src/core/netif.c **** #else  /* NO_SYS */
 193:./lwip-2.1.2/src/core/netif.c ****   netif_add(&loop_netif, LOOPIF_ADDRINIT NULL, netif_loopif_init, tcpip_input);
 194:./lwip-2.1.2/src/core/netif.c **** #endif /* NO_SYS */
 195:./lwip-2.1.2/src/core/netif.c **** 
 196:./lwip-2.1.2/src/core/netif.c **** #if LWIP_IPV6
 197:./lwip-2.1.2/src/core/netif.c ****   IP_ADDR6_HOST(loop_netif.ip6_addr, 0, 0, 0, 0x00000001UL);
 198:./lwip-2.1.2/src/core/netif.c ****   loop_netif.ip6_addr_state[0] = IP6_ADDR_VALID;
 199:./lwip-2.1.2/src/core/netif.c **** #endif /* LWIP_IPV6 */
 200:./lwip-2.1.2/src/core/netif.c **** 
 201:./lwip-2.1.2/src/core/netif.c ****   netif_set_link_up(&loop_netif);
 202:./lwip-2.1.2/src/core/netif.c ****   netif_set_up(&loop_netif);
 203:./lwip-2.1.2/src/core/netif.c **** 
 204:./lwip-2.1.2/src/core/netif.c **** #endif /* LWIP_HAVE_LOOPIF */
 205:./lwip-2.1.2/src/core/netif.c **** }

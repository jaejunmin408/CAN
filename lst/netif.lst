 380:./lwip-2.1.2/src/core/netif.c **** #if !LWIP_SINGLE_NETIF
 381:./lwip-2.1.2/src/core/netif.c ****   /* Assign a unique netif number in the range [0..254], so that (num+1) can
 382:./lwip-2.1.2/src/core/netif.c ****      serve as an interface index that fits in a u8_t.
 383:./lwip-2.1.2/src/core/netif.c ****      We assume that the new netif has not yet been added to the list here.
 384:./lwip-2.1.2/src/core/netif.c ****      This algorithm is O(n^2), but that should be OK for lwIP.
 385:./lwip-2.1.2/src/core/netif.c ****      */
 386:./lwip-2.1.2/src/core/netif.c ****   {
 387:./lwip-2.1.2/src/core/netif.c ****     struct netif *netif2;
 388:./lwip-2.1.2/src/core/netif.c ****     int num_netifs;
 389:./lwip-2.1.2/src/core/netif.c ****     do {
 390:./lwip-2.1.2/src/core/netif.c ****       if (netif->num == 255) {
 391:./lwip-2.1.2/src/core/netif.c ****         netif->num = 0;
 392:./lwip-2.1.2/src/core/netif.c ****       }
 393:./lwip-2.1.2/src/core/netif.c ****       num_netifs = 0;
 394:./lwip-2.1.2/src/core/netif.c ****       for (netif2 = netif_list; netif2 != NULL; netif2 = netif2->next) {
 395:./lwip-2.1.2/src/core/netif.c ****         LWIP_ASSERT("netif already added", netif2 != netif);
 396:./lwip-2.1.2/src/core/netif.c ****         num_netifs++;
 397:./lwip-2.1.2/src/core/netif.c ****         LWIP_ASSERT("too many netifs, max. supported number is 255", num_netifs <= 255);
 398:./lwip-2.1.2/src/core/netif.c ****         if (netif2->num == netif->num) {
 399:./lwip-2.1.2/src/core/netif.c ****           netif->num++;
 400:./lwip-2.1.2/src/core/netif.c ****           break;
 401:./lwip-2.1.2/src/core/netif.c ****         }
 402:./lwip-2.1.2/src/core/netif.c ****       }
 403:./lwip-2.1.2/src/core/netif.c ****     } while (netif2 != NULL);
 404:./lwip-2.1.2/src/core/netif.c ****   }
 405:./lwip-2.1.2/src/core/netif.c ****   if (netif->num == 254) {
 406:./lwip-2.1.2/src/core/netif.c ****     netif_num = 0;
 407:./lwip-2.1.2/src/core/netif.c ****   } else {
 408:./lwip-2.1.2/src/core/netif.c ****     netif_num = (u8_t)(netif->num + 1);
 409:./lwip-2.1.2/src/core/netif.c ****   }
 410:./lwip-2.1.2/src/core/netif.c **** 
 411:./lwip-2.1.2/src/core/netif.c ****   /* add this netif to the list */
 412:./lwip-2.1.2/src/core/netif.c ****   netif->next = netif_list;
 413:./lwip-2.1.2/src/core/netif.c ****   netif_list = netif;
 414:./lwip-2.1.2/src/core/netif.c **** #endif /* "LWIP_SINGLE_NETIF */
 415:./lwip-2.1.2/src/core/netif.c ****   mib2_netif_added(netif);

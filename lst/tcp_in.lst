 108:./lwip-2.1.2/src/core/tcp_in.c **** /**
 109:./lwip-2.1.2/src/core/tcp_in.c ****  * The initial input processing of TCP. It verifies the TCP header, demultiplexes
 110:./lwip-2.1.2/src/core/tcp_in.c ****  * the segment between the PCBs and passes it on to tcp_process(), which implements
 111:./lwip-2.1.2/src/core/tcp_in.c ****  * the TCP finite state machine. This function is called by the IP layer (in
 112:./lwip-2.1.2/src/core/tcp_in.c ****  * ip_input()).
 113:./lwip-2.1.2/src/core/tcp_in.c ****  *
 114:./lwip-2.1.2/src/core/tcp_in.c ****  * @param p received TCP segment to process (p->payload pointing to the TCP header)
 115:./lwip-2.1.2/src/core/tcp_in.c ****  * @param inp network interface on which this segment was received
 116:./lwip-2.1.2/src/core/tcp_in.c ****  */
 117:./lwip-2.1.2/src/core/tcp_in.c **** void
 118:./lwip-2.1.2/src/core/tcp_in.c **** tcp_input(struct pbuf *p, struct netif *inp)
 119:./lwip-2.1.2/src/core/tcp_in.c **** {
 120:./lwip-2.1.2/src/core/tcp_in.c ****   struct tcp_pcb *pcb, *prev;
 121:./lwip-2.1.2/src/core/tcp_in.c ****   struct tcp_pcb_listen *lpcb;
 122:./lwip-2.1.2/src/core/tcp_in.c **** #if SO_REUSE
 123:./lwip-2.1.2/src/core/tcp_in.c ****   struct tcp_pcb *lpcb_prev = NULL;
 124:./lwip-2.1.2/src/core/tcp_in.c ****   struct tcp_pcb_listen *lpcb_any = NULL;
 125:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* SO_REUSE */
 126:./lwip-2.1.2/src/core/tcp_in.c ****   u8_t hdrlen_bytes;
 127:./lwip-2.1.2/src/core/tcp_in.c ****   err_t err;
 128:./lwip-2.1.2/src/core/tcp_in.c **** 
 129:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_UNUSED_ARG(inp);
 130:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_ASSERT_CORE_LOCKED();
 131:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_ASSERT("tcp_input: invalid pbuf", p != NULL);
 132:./lwip-2.1.2/src/core/tcp_in.c **** 
 133:./lwip-2.1.2/src/core/tcp_in.c ****   PERF_START;
 134:./lwip-2.1.2/src/core/tcp_in.c **** 
 135:./lwip-2.1.2/src/core/tcp_in.c ****   TCP_STATS_INC(tcp.recv);
 136:./lwip-2.1.2/src/core/tcp_in.c ****   MIB2_STATS_INC(mib2.tcpinsegs);
 137:./lwip-2.1.2/src/core/tcp_in.c **** 
 138:./lwip-2.1.2/src/core/tcp_in.c ****   tcphdr = (struct tcp_hdr *)p->payload;
 139:./lwip-2.1.2/src/core/tcp_in.c **** 
 140:./lwip-2.1.2/src/core/tcp_in.c **** #if TCP_INPUT_DEBUG
 141:./lwip-2.1.2/src/core/tcp_in.c ****   tcp_debug_print(tcphdr);
 142:./lwip-2.1.2/src/core/tcp_in.c **** #endif
 143:./lwip-2.1.2/src/core/tcp_in.c **** 
 144:./lwip-2.1.2/src/core/tcp_in.c ****   /* Check that TCP header fits in payload */
 145:./lwip-2.1.2/src/core/tcp_in.c ****   if (p->len < TCP_HLEN) {
 146:./lwip-2.1.2/src/core/tcp_in.c ****     /* drop short packets */
 147:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: short packet (%"U16_F" bytes) discarded\n", p->tot_le
 148:./lwip-2.1.2/src/core/tcp_in.c ****     TCP_STATS_INC(tcp.lenerr);
 149:./lwip-2.1.2/src/core/tcp_in.c ****     goto dropped;
 150:./lwip-2.1.2/src/core/tcp_in.c ****   }
 151:./lwip-2.1.2/src/core/tcp_in.c **** 
 152:./lwip-2.1.2/src/core/tcp_in.c ****   /* Don't even process incoming broadcasts/multicasts. */
 153:./lwip-2.1.2/src/core/tcp_in.c ****   if (ip_addr_isbroadcast(ip_current_dest_addr(), ip_current_netif()) ||
 154:./lwip-2.1.2/src/core/tcp_in.c ****       ip_addr_ismulticast(ip_current_dest_addr())) {
 155:./lwip-2.1.2/src/core/tcp_in.c ****     TCP_STATS_INC(tcp.proterr);
 156:./lwip-2.1.2/src/core/tcp_in.c ****     goto dropped;
 157:./lwip-2.1.2/src/core/tcp_in.c ****   }
 158:./lwip-2.1.2/src/core/tcp_in.c **** 
 159:./lwip-2.1.2/src/core/tcp_in.c **** #if CHECKSUM_CHECK_TCP
 160:./lwip-2.1.2/src/core/tcp_in.c ****   IF__NETIF_CHECKSUM_ENABLED(inp, NETIF_CHECKSUM_CHECK_TCP) {
 161:./lwip-2.1.2/src/core/tcp_in.c ****     /* Verify TCP checksum. */
 162:./lwip-2.1.2/src/core/tcp_in.c ****     u16_t chksum = ip_chksum_pseudo(p, IP_PROTO_TCP, p->tot_len,
 163:./lwip-2.1.2/src/core/tcp_in.c ****                                     ip_current_src_addr(), ip_current_dest_addr());
 164:./lwip-2.1.2/src/core/tcp_in.c ****     if (chksum != 0) {
 165:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: packet discarded due to failing checksum 0x%04"X16_
 166:./lwip-2.1.2/src/core/tcp_in.c ****                                     chksum));
 167:./lwip-2.1.2/src/core/tcp_in.c ****       tcp_debug_print(tcphdr);
 168:./lwip-2.1.2/src/core/tcp_in.c ****       TCP_STATS_INC(tcp.chkerr);
 169:./lwip-2.1.2/src/core/tcp_in.c ****       goto dropped;
 170:./lwip-2.1.2/src/core/tcp_in.c ****     }
 171:./lwip-2.1.2/src/core/tcp_in.c ****   }
 172:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* CHECKSUM_CHECK_TCP */
 173:./lwip-2.1.2/src/core/tcp_in.c **** 
 174:./lwip-2.1.2/src/core/tcp_in.c ****   /* sanity-check header length */
 175:./lwip-2.1.2/src/core/tcp_in.c ****   hdrlen_bytes = TCPH_HDRLEN_BYTES(tcphdr);
 176:./lwip-2.1.2/src/core/tcp_in.c ****   if ((hdrlen_bytes < TCP_HLEN) || (hdrlen_bytes > p->tot_len)) {
 177:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: invalid header length (%"U16_F")\n", (u16_t)hdrlen_by
 178:./lwip-2.1.2/src/core/tcp_in.c ****     TCP_STATS_INC(tcp.lenerr);
 179:./lwip-2.1.2/src/core/tcp_in.c ****     goto dropped;
 180:./lwip-2.1.2/src/core/tcp_in.c ****   }
 181:./lwip-2.1.2/src/core/tcp_in.c **** 
 182:./lwip-2.1.2/src/core/tcp_in.c ****   /* Move the payload pointer in the pbuf so that it points to the
 183:./lwip-2.1.2/src/core/tcp_in.c ****      TCP data instead of the TCP header. */
 184:./lwip-2.1.2/src/core/tcp_in.c ****   tcphdr_optlen = (u16_t)(hdrlen_bytes - TCP_HLEN);
 185:./lwip-2.1.2/src/core/tcp_in.c ****   tcphdr_opt2 = NULL;
 186:./lwip-2.1.2/src/core/tcp_in.c ****   if (p->len >= hdrlen_bytes) {
 187:./lwip-2.1.2/src/core/tcp_in.c ****     /* all options are in the first pbuf */
 188:./lwip-2.1.2/src/core/tcp_in.c ****     tcphdr_opt1len = tcphdr_optlen;
 189:./lwip-2.1.2/src/core/tcp_in.c ****     pbuf_remove_header(p, hdrlen_bytes); /* cannot fail */
 190:./lwip-2.1.2/src/core/tcp_in.c ****   } else {
 191:./lwip-2.1.2/src/core/tcp_in.c ****     u16_t opt2len;
 192:./lwip-2.1.2/src/core/tcp_in.c ****     /* TCP header fits into first pbuf, options don't - data is in the next pbuf */
 193:./lwip-2.1.2/src/core/tcp_in.c ****     /* there must be a next pbuf, due to hdrlen_bytes sanity check above */
 194:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_ASSERT("p->next != NULL", p->next != NULL);
 195:./lwip-2.1.2/src/core/tcp_in.c **** 
 196:./lwip-2.1.2/src/core/tcp_in.c ****     /* advance over the TCP header (cannot fail) */
 197:./lwip-2.1.2/src/core/tcp_in.c ****     pbuf_remove_header(p, TCP_HLEN);
 198:./lwip-2.1.2/src/core/tcp_in.c **** 
 199:./lwip-2.1.2/src/core/tcp_in.c ****     /* determine how long the first and second parts of the options are */
 200:./lwip-2.1.2/src/core/tcp_in.c ****     tcphdr_opt1len = p->len;
 201:./lwip-2.1.2/src/core/tcp_in.c ****     opt2len = (u16_t)(tcphdr_optlen - tcphdr_opt1len);
 202:./lwip-2.1.2/src/core/tcp_in.c **** 
 203:./lwip-2.1.2/src/core/tcp_in.c ****     /* options continue in the next pbuf: set p to zero length and hide the
 204:./lwip-2.1.2/src/core/tcp_in.c ****         options in the next pbuf (adjusting p->tot_len) */
 205:./lwip-2.1.2/src/core/tcp_in.c ****     pbuf_remove_header(p, tcphdr_opt1len);
 206:./lwip-2.1.2/src/core/tcp_in.c **** 
 207:./lwip-2.1.2/src/core/tcp_in.c ****     /* check that the options fit in the second pbuf */
 208:./lwip-2.1.2/src/core/tcp_in.c ****     if (opt2len > p->next->len) {
 209:./lwip-2.1.2/src/core/tcp_in.c ****       /* drop short packets */
 210:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: options overflow second pbuf (%"U16_F" bytes)\n", p
 211:./lwip-2.1.2/src/core/tcp_in.c ****       TCP_STATS_INC(tcp.lenerr);
 212:./lwip-2.1.2/src/core/tcp_in.c ****       goto dropped;
 213:./lwip-2.1.2/src/core/tcp_in.c ****     }
 214:./lwip-2.1.2/src/core/tcp_in.c **** 
 215:./lwip-2.1.2/src/core/tcp_in.c ****     /* remember the pointer to the second part of the options */
 216:./lwip-2.1.2/src/core/tcp_in.c ****     tcphdr_opt2 = (u8_t *)p->next->payload;
 217:./lwip-2.1.2/src/core/tcp_in.c **** 
 218:./lwip-2.1.2/src/core/tcp_in.c ****     /* advance p->next to point after the options, and manually
 219:./lwip-2.1.2/src/core/tcp_in.c ****         adjust p->tot_len to keep it consistent with the changed p->next */
 220:./lwip-2.1.2/src/core/tcp_in.c ****     pbuf_remove_header(p->next, opt2len);
 221:./lwip-2.1.2/src/core/tcp_in.c ****     p->tot_len = (u16_t)(p->tot_len - opt2len);
 222:./lwip-2.1.2/src/core/tcp_in.c **** 
 223:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_ASSERT("p->len == 0", p->len == 0);
 224:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_ASSERT("p->tot_len == p->next->tot_len", p->tot_len == p->next->tot_len);
 225:./lwip-2.1.2/src/core/tcp_in.c ****   }
 226:./lwip-2.1.2/src/core/tcp_in.c **** 
 227:./lwip-2.1.2/src/core/tcp_in.c ****   /* Convert fields in TCP header to host byte order. */
 228:./lwip-2.1.2/src/core/tcp_in.c ****   tcphdr->src = lwip_ntohs(tcphdr->src);
 229:./lwip-2.1.2/src/core/tcp_in.c ****   tcphdr->dest = lwip_ntohs(tcphdr->dest);
 230:./lwip-2.1.2/src/core/tcp_in.c ****   seqno = tcphdr->seqno = lwip_ntohl(tcphdr->seqno);
 231:./lwip-2.1.2/src/core/tcp_in.c ****   ackno = tcphdr->ackno = lwip_ntohl(tcphdr->ackno);
 232:./lwip-2.1.2/src/core/tcp_in.c ****   tcphdr->wnd = lwip_ntohs(tcphdr->wnd);
 233:./lwip-2.1.2/src/core/tcp_in.c **** 
 234:./lwip-2.1.2/src/core/tcp_in.c ****   flags = TCPH_FLAGS(tcphdr);
 235:./lwip-2.1.2/src/core/tcp_in.c ****   tcplen = p->tot_len;
 236:./lwip-2.1.2/src/core/tcp_in.c ****   if (flags & (TCP_FIN | TCP_SYN)) {
 237:./lwip-2.1.2/src/core/tcp_in.c ****     tcplen++;
 238:./lwip-2.1.2/src/core/tcp_in.c ****     if (tcplen < p->tot_len) {
 239:./lwip-2.1.2/src/core/tcp_in.c ****       /* u16_t overflow, cannot handle this */
 240:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: length u16_t overflow, cannot handle this\n"));
 241:./lwip-2.1.2/src/core/tcp_in.c ****       TCP_STATS_INC(tcp.lenerr);
 242:./lwip-2.1.2/src/core/tcp_in.c ****       goto dropped;
 243:./lwip-2.1.2/src/core/tcp_in.c ****     }
 244:./lwip-2.1.2/src/core/tcp_in.c ****   }
 245:./lwip-2.1.2/src/core/tcp_in.c **** 
 246:./lwip-2.1.2/src/core/tcp_in.c ****   /* Demultiplex an incoming segment. First, we check if it is destined
 247:./lwip-2.1.2/src/core/tcp_in.c ****      for an active connection. */
 248:./lwip-2.1.2/src/core/tcp_in.c ****   prev = NULL;
 249:./lwip-2.1.2/src/core/tcp_in.c **** 
 250:./lwip-2.1.2/src/core/tcp_in.c ****   for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
 251:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_ASSERT("tcp_input: active pcb->state != CLOSED", pcb->state != CLOSED);
 252:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_ASSERT("tcp_input: active pcb->state != TIME-WAIT", pcb->state != TIME_WAIT);
 253:./lwip-2.1.2/src/core/tcp_in.c ****     LWIP_ASSERT("tcp_input: active pcb->state != LISTEN", pcb->state != LISTEN);
 254:./lwip-2.1.2/src/core/tcp_in.c **** 
 255:./lwip-2.1.2/src/core/tcp_in.c ****     /* check if PCB is bound to specific netif */
 256:./lwip-2.1.2/src/core/tcp_in.c ****     if ((pcb->netif_idx != NETIF_NO_INDEX) &&
 257:./lwip-2.1.2/src/core/tcp_in.c ****         (pcb->netif_idx != netif_get_index(ip_data.current_input_netif))) {
 258:./lwip-2.1.2/src/core/tcp_in.c ****       prev = pcb;
 259:./lwip-2.1.2/src/core/tcp_in.c ****       continue;
 260:./lwip-2.1.2/src/core/tcp_in.c ****     }
 261:./lwip-2.1.2/src/core/tcp_in.c **** 
 262:./lwip-2.1.2/src/core/tcp_in.c ****     if (pcb->remote_port == tcphdr->src &&
 263:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->local_port == tcphdr->dest &&
 264:./lwip-2.1.2/src/core/tcp_in.c ****         ip_addr_cmp(&pcb->remote_ip, ip_current_src_addr()) &&
 265:./lwip-2.1.2/src/core/tcp_in.c ****         ip_addr_cmp(&pcb->local_ip, ip_current_dest_addr())) {
 266:./lwip-2.1.2/src/core/tcp_in.c ****       /* Move this PCB to the front of the list so that subsequent
 267:./lwip-2.1.2/src/core/tcp_in.c ****          lookups will be faster (we exploit locality in TCP segment
 268:./lwip-2.1.2/src/core/tcp_in.c ****          arrivals). */
 269:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_ASSERT("tcp_input: pcb->next != pcb (before cache)", pcb->next != pcb);
 270:./lwip-2.1.2/src/core/tcp_in.c ****       if (prev != NULL) {
 271:./lwip-2.1.2/src/core/tcp_in.c ****         prev->next = pcb->next;
 272:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->next = tcp_active_pcbs;
 273:./lwip-2.1.2/src/core/tcp_in.c ****         tcp_active_pcbs = pcb;
 274:./lwip-2.1.2/src/core/tcp_in.c ****       } else {
 275:./lwip-2.1.2/src/core/tcp_in.c ****         TCP_STATS_INC(tcp.cachehit);
 276:./lwip-2.1.2/src/core/tcp_in.c ****       }
 277:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_ASSERT("tcp_input: pcb->next != pcb (after cache)", pcb->next != pcb);
 278:./lwip-2.1.2/src/core/tcp_in.c ****       break;
 279:./lwip-2.1.2/src/core/tcp_in.c ****     }
 280:./lwip-2.1.2/src/core/tcp_in.c ****     prev = pcb;
 281:./lwip-2.1.2/src/core/tcp_in.c ****   }
 282:./lwip-2.1.2/src/core/tcp_in.c **** 
 283:./lwip-2.1.2/src/core/tcp_in.c ****   if (pcb == NULL) {
 284:./lwip-2.1.2/src/core/tcp_in.c ****     /* If it did not go to an active connection, we check the connections
 285:./lwip-2.1.2/src/core/tcp_in.c ****        in the TIME-WAIT state. */
 286:./lwip-2.1.2/src/core/tcp_in.c ****     for (pcb = tcp_tw_pcbs; pcb != NULL; pcb = pcb->next) {
 287:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_ASSERT("tcp_input: TIME-WAIT pcb->state == TIME-WAIT", pcb->state == TIME_WAIT);
 288:./lwip-2.1.2/src/core/tcp_in.c **** 
 289:./lwip-2.1.2/src/core/tcp_in.c ****       /* check if PCB is bound to specific netif */
 290:./lwip-2.1.2/src/core/tcp_in.c ****       if ((pcb->netif_idx != NETIF_NO_INDEX) &&
 291:./lwip-2.1.2/src/core/tcp_in.c ****           (pcb->netif_idx != netif_get_index(ip_data.current_input_netif))) {
 292:./lwip-2.1.2/src/core/tcp_in.c ****         continue;
 293:./lwip-2.1.2/src/core/tcp_in.c ****       }
 294:./lwip-2.1.2/src/core/tcp_in.c **** 
 295:./lwip-2.1.2/src/core/tcp_in.c ****       if (pcb->remote_port == tcphdr->src &&
 296:./lwip-2.1.2/src/core/tcp_in.c ****           pcb->local_port == tcphdr->dest &&
 297:./lwip-2.1.2/src/core/tcp_in.c ****           ip_addr_cmp(&pcb->remote_ip, ip_current_src_addr()) &&
 298:./lwip-2.1.2/src/core/tcp_in.c ****           ip_addr_cmp(&pcb->local_ip, ip_current_dest_addr())) {
 299:./lwip-2.1.2/src/core/tcp_in.c ****         /* We don't really care enough to move this PCB to the front
 300:./lwip-2.1.2/src/core/tcp_in.c ****            of the list since we are not very likely to receive that
 301:./lwip-2.1.2/src/core/tcp_in.c ****            many segments for connections in TIME-WAIT. */
 302:./lwip-2.1.2/src/core/tcp_in.c ****         LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: packed for TIME_WAITing connection.\n"));
 303:./lwip-2.1.2/src/core/tcp_in.c **** #ifdef LWIP_HOOK_TCP_INPACKET_PCB
 304:./lwip-2.1.2/src/core/tcp_in.c ****         if (LWIP_HOOK_TCP_INPACKET_PCB(pcb, tcphdr, tcphdr_optlen, tcphdr_opt1len,
 305:./lwip-2.1.2/src/core/tcp_in.c ****                                        tcphdr_opt2, p) == ERR_OK)
 306:./lwip-2.1.2/src/core/tcp_in.c **** #endif
 307:./lwip-2.1.2/src/core/tcp_in.c ****         {
 308:./lwip-2.1.2/src/core/tcp_in.c ****           tcp_timewait_input(pcb);
 309:./lwip-2.1.2/src/core/tcp_in.c ****         }
 310:./lwip-2.1.2/src/core/tcp_in.c ****         pbuf_free(p);
 311:./lwip-2.1.2/src/core/tcp_in.c ****         return;
 312:./lwip-2.1.2/src/core/tcp_in.c ****       }
 313:./lwip-2.1.2/src/core/tcp_in.c ****     }
 314:./lwip-2.1.2/src/core/tcp_in.c **** 
 315:./lwip-2.1.2/src/core/tcp_in.c ****     /* Finally, if we still did not get a match, we check all PCBs that
 316:./lwip-2.1.2/src/core/tcp_in.c ****        are LISTENing for incoming connections. */
 317:./lwip-2.1.2/src/core/tcp_in.c ****     prev = NULL;
 318:./lwip-2.1.2/src/core/tcp_in.c ****     for (lpcb = tcp_listen_pcbs.listen_pcbs; lpcb != NULL; lpcb = lpcb->next) {
 319:./lwip-2.1.2/src/core/tcp_in.c ****       /* check if PCB is bound to specific netif */
 320:./lwip-2.1.2/src/core/tcp_in.c ****       if ((lpcb->netif_idx != NETIF_NO_INDEX) &&
 321:./lwip-2.1.2/src/core/tcp_in.c ****           (lpcb->netif_idx != netif_get_index(ip_data.current_input_netif))) {
 322:./lwip-2.1.2/src/core/tcp_in.c ****         prev = (struct tcp_pcb *)lpcb;
 323:./lwip-2.1.2/src/core/tcp_in.c ****         continue;
 324:./lwip-2.1.2/src/core/tcp_in.c ****       }
 325:./lwip-2.1.2/src/core/tcp_in.c **** 
 326:./lwip-2.1.2/src/core/tcp_in.c ****       if (lpcb->local_port == tcphdr->dest) {
 327:./lwip-2.1.2/src/core/tcp_in.c ****         if (IP_IS_ANY_TYPE_VAL(lpcb->local_ip)) {
 328:./lwip-2.1.2/src/core/tcp_in.c ****           /* found an ANY TYPE (IPv4/IPv6) match */
 329:./lwip-2.1.2/src/core/tcp_in.c **** #if SO_REUSE
 330:./lwip-2.1.2/src/core/tcp_in.c ****           lpcb_any = lpcb;
 331:./lwip-2.1.2/src/core/tcp_in.c ****           lpcb_prev = prev;
 332:./lwip-2.1.2/src/core/tcp_in.c **** #else /* SO_REUSE */
 333:./lwip-2.1.2/src/core/tcp_in.c ****           break;
 334:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* SO_REUSE */
 335:./lwip-2.1.2/src/core/tcp_in.c ****         } else if (IP_ADDR_PCB_VERSION_MATCH_EXACT(lpcb, ip_current_dest_addr())) {
 336:./lwip-2.1.2/src/core/tcp_in.c ****           if (ip_addr_cmp(&lpcb->local_ip, ip_current_dest_addr())) {
 337:./lwip-2.1.2/src/core/tcp_in.c ****             /* found an exact match */
 338:./lwip-2.1.2/src/core/tcp_in.c ****             break;
 339:./lwip-2.1.2/src/core/tcp_in.c ****           } else if (ip_addr_isany(&lpcb->local_ip)) {
 340:./lwip-2.1.2/src/core/tcp_in.c ****             /* found an ANY-match */
 341:./lwip-2.1.2/src/core/tcp_in.c **** #if SO_REUSE
 342:./lwip-2.1.2/src/core/tcp_in.c ****             lpcb_any = lpcb;
 343:./lwip-2.1.2/src/core/tcp_in.c ****             lpcb_prev = prev;
 344:./lwip-2.1.2/src/core/tcp_in.c **** #else /* SO_REUSE */
 345:./lwip-2.1.2/src/core/tcp_in.c ****             break;
 346:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* SO_REUSE */
 347:./lwip-2.1.2/src/core/tcp_in.c ****           }
 348:./lwip-2.1.2/src/core/tcp_in.c ****         }
 349:./lwip-2.1.2/src/core/tcp_in.c ****       }
 350:./lwip-2.1.2/src/core/tcp_in.c ****       prev = (struct tcp_pcb *)lpcb;
 351:./lwip-2.1.2/src/core/tcp_in.c ****     }
 352:./lwip-2.1.2/src/core/tcp_in.c **** #if SO_REUSE
 353:./lwip-2.1.2/src/core/tcp_in.c ****     /* first try specific local IP */
 354:./lwip-2.1.2/src/core/tcp_in.c ****     if (lpcb == NULL) {
 355:./lwip-2.1.2/src/core/tcp_in.c ****       /* only pass to ANY if no specific local IP has been found */
 356:./lwip-2.1.2/src/core/tcp_in.c ****       lpcb = lpcb_any;
 357:./lwip-2.1.2/src/core/tcp_in.c ****       prev = lpcb_prev;
 358:./lwip-2.1.2/src/core/tcp_in.c ****     }
 359:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* SO_REUSE */
 360:./lwip-2.1.2/src/core/tcp_in.c ****     if (lpcb != NULL) {
 361:./lwip-2.1.2/src/core/tcp_in.c ****       /* Move this PCB to the front of the list so that subsequent
 362:./lwip-2.1.2/src/core/tcp_in.c ****          lookups will be faster (we exploit locality in TCP segment
 363:./lwip-2.1.2/src/core/tcp_in.c ****          arrivals). */
 364:./lwip-2.1.2/src/core/tcp_in.c ****       if (prev != NULL) {
 365:./lwip-2.1.2/src/core/tcp_in.c ****         ((struct tcp_pcb_listen *)prev)->next = lpcb->next;
 366:./lwip-2.1.2/src/core/tcp_in.c ****         /* our successor is the remainder of the listening list */
 367:./lwip-2.1.2/src/core/tcp_in.c ****         lpcb->next = tcp_listen_pcbs.listen_pcbs;
 368:./lwip-2.1.2/src/core/tcp_in.c ****         /* put this listening pcb at the head of the listening list */
 369:./lwip-2.1.2/src/core/tcp_in.c ****         tcp_listen_pcbs.listen_pcbs = lpcb;
 370:./lwip-2.1.2/src/core/tcp_in.c ****       } else {
 371:./lwip-2.1.2/src/core/tcp_in.c ****         TCP_STATS_INC(tcp.cachehit);
 372:./lwip-2.1.2/src/core/tcp_in.c ****       }
 373:./lwip-2.1.2/src/core/tcp_in.c **** 
 374:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_input: packed for LISTENing connection.\n"));
 375:./lwip-2.1.2/src/core/tcp_in.c **** #ifdef LWIP_HOOK_TCP_INPACKET_PCB
 376:./lwip-2.1.2/src/core/tcp_in.c ****       if (LWIP_HOOK_TCP_INPACKET_PCB((struct tcp_pcb *)lpcb, tcphdr, tcphdr_optlen,
 377:./lwip-2.1.2/src/core/tcp_in.c ****                                      tcphdr_opt1len, tcphdr_opt2, p) == ERR_OK)
 378:./lwip-2.1.2/src/core/tcp_in.c **** #endif
 379:./lwip-2.1.2/src/core/tcp_in.c ****       {
 380:./lwip-2.1.2/src/core/tcp_in.c ****         tcp_listen_input(lpcb);
 381:./lwip-2.1.2/src/core/tcp_in.c ****       }
 382:./lwip-2.1.2/src/core/tcp_in.c ****       pbuf_free(p);
 383:./lwip-2.1.2/src/core/tcp_in.c ****       return;
 384:./lwip-2.1.2/src/core/tcp_in.c ****     }
 385:./lwip-2.1.2/src/core/tcp_in.c ****   }
 386:./lwip-2.1.2/src/core/tcp_in.c **** 
 387:./lwip-2.1.2/src/core/tcp_in.c **** #if TCP_INPUT_DEBUG
 388:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_DEBUGF(TCP_INPUT_DEBUG, ("+-+-+-+-+-+-+-+-+-+-+-+-+-+- tcp_input: flags "));
 389:./lwip-2.1.2/src/core/tcp_in.c ****   tcp_debug_print_flags(TCPH_FLAGS(tcphdr));
 390:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_DEBUGF(TCP_INPUT_DEBUG, ("-+-+-+-+-+-+-+-+-+-+-+-+-+-+\n"));
 391:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* TCP_INPUT_DEBUG */
 392:./lwip-2.1.2/src/core/tcp_in.c **** 
 393:./lwip-2.1.2/src/core/tcp_in.c **** 
 394:./lwip-2.1.2/src/core/tcp_in.c **** #ifdef LWIP_HOOK_TCP_INPACKET_PCB
 395:./lwip-2.1.2/src/core/tcp_in.c ****   if ((pcb != NULL) && LWIP_HOOK_TCP_INPACKET_PCB(pcb, tcphdr, tcphdr_optlen,
 396:./lwip-2.1.2/src/core/tcp_in.c ****       tcphdr_opt1len, tcphdr_opt2, p) != ERR_OK) {
 397:./lwip-2.1.2/src/core/tcp_in.c ****     pbuf_free(p);

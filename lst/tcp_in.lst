 661:./lwip-2.1.2/src/core/tcp_in.c ****        we don't do anything, but rely on the sender will retransmit the
 662:./lwip-2.1.2/src/core/tcp_in.c ****        SYN at a time when we have more memory available. */
 663:./lwip-2.1.2/src/core/tcp_in.c ****     if (npcb == NULL) {
 664:./lwip-2.1.2/src/core/tcp_in.c ****       err_t err;
 665:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_listen_input: could not allocate PCB\n"));
 666:./lwip-2.1.2/src/core/tcp_in.c ****       TCP_STATS_INC(tcp.memerr);
 667:./lwip-2.1.2/src/core/tcp_in.c ****       TCP_EVENT_ACCEPT(pcb, NULL, pcb->callback_arg, ERR_MEM, err);
 668:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_UNUSED_ARG(err); /* err not useful here */
 669:./lwip-2.1.2/src/core/tcp_in.c ****       return;
 670:./lwip-2.1.2/src/core/tcp_in.c ****     }
 671:./lwip-2.1.2/src/core/tcp_in.c **** #if TCP_LISTEN_BACKLOG
 672:./lwip-2.1.2/src/core/tcp_in.c ****     pcb->accepts_pending++;
 673:./lwip-2.1.2/src/core/tcp_in.c ****     tcp_set_flags(npcb, TF_BACKLOGPEND);
 674:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* TCP_LISTEN_BACKLOG */
 675:./lwip-2.1.2/src/core/tcp_in.c ****     /* Set up the new PCB. */
 676:./lwip-2.1.2/src/core/tcp_in.c ****     ip_addr_copy(npcb->local_ip, *ip_current_dest_addr());
 677:./lwip-2.1.2/src/core/tcp_in.c ****     ip_addr_copy(npcb->remote_ip, *ip_current_src_addr());
 678:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->local_port = pcb->local_port;
 679:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->remote_port = tcphdr->src;
 680:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->state = SYN_RCVD;
 681:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->rcv_nxt = seqno + 1;
 682:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->rcv_ann_right_edge = npcb->rcv_nxt;
 683:./lwip-2.1.2/src/core/tcp_in.c ****     iss = tcp_next_iss(npcb);
 684:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->snd_wl2 = iss;
 685:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->snd_nxt = iss;
 686:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->lastack = iss;
 687:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->snd_lbb = iss;
 688:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->snd_wl1 = seqno - 1;/* initialise to seqno-1 to force window update */
 689:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->callback_arg = pcb->callback_arg;
 690:./lwip-2.1.2/src/core/tcp_in.c **** #if LWIP_CALLBACK_API || TCP_LISTEN_BACKLOG
 691:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->listener = pcb;
 692:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* LWIP_CALLBACK_API || TCP_LISTEN_BACKLOG */
 693:./lwip-2.1.2/src/core/tcp_in.c ****     /* inherit socket options */
 694:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->so_options = pcb->so_options & SOF_INHERITED;
 695:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->netif_idx = pcb->netif_idx;
 696:./lwip-2.1.2/src/core/tcp_in.c ****     /* Register the new PCB so that we can begin receiving segments
 697:./lwip-2.1.2/src/core/tcp_in.c ****        for it. */
 698:./lwip-2.1.2/src/core/tcp_in.c ****     TCP_REG_ACTIVE(npcb);
 699:./lwip-2.1.2/src/core/tcp_in.c **** 
 700:./lwip-2.1.2/src/core/tcp_in.c ****     /* Parse any options in the SYN. */
 701:./lwip-2.1.2/src/core/tcp_in.c ****     tcp_parseopt(npcb);
 702:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->snd_wnd = tcphdr->wnd;
 703:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->snd_wnd_max = npcb->snd_wnd;
 704:./lwip-2.1.2/src/core/tcp_in.c **** 
 705:./lwip-2.1.2/src/core/tcp_in.c **** #if TCP_CALCULATE_EFF_SEND_MSS
 706:./lwip-2.1.2/src/core/tcp_in.c ****     npcb->mss = tcp_eff_send_mss(npcb->mss, &npcb->local_ip, &npcb->remote_ip);
 707:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* TCP_CALCULATE_EFF_SEND_MSS */
 708:./lwip-2.1.2/src/core/tcp_in.c **** 
 709:./lwip-2.1.2/src/core/tcp_in.c ****     MIB2_STATS_INC(mib2.tcppassiveopens);
 710:./lwip-2.1.2/src/core/tcp_in.c **** 
 711:./lwip-2.1.2/src/core/tcp_in.c **** #if LWIP_TCP_PCB_NUM_EXT_ARGS
 712:./lwip-2.1.2/src/core/tcp_in.c ****     if (tcp_ext_arg_invoke_callbacks_passive_open(pcb, npcb) != ERR_OK) {
 713:./lwip-2.1.2/src/core/tcp_in.c ****       tcp_abandon(npcb, 0);
 714:./lwip-2.1.2/src/core/tcp_in.c ****       return;
 715:./lwip-2.1.2/src/core/tcp_in.c ****     }
 716:./lwip-2.1.2/src/core/tcp_in.c **** #endif
 717:./lwip-2.1.2/src/core/tcp_in.c **** 
 718:./lwip-2.1.2/src/core/tcp_in.c ****     /* Send a SYN|ACK together with the MSS option. */
 719:./lwip-2.1.2/src/core/tcp_in.c ****     rc = tcp_enqueue_flags(npcb, TCP_SYN | TCP_ACK);
 720:./lwip-2.1.2/src/core/tcp_in.c ****     if (rc != ERR_OK) {
 721:./lwip-2.1.2/src/core/tcp_in.c ****       tcp_abandon(npcb, 0);
 722:./lwip-2.1.2/src/core/tcp_in.c ****       return;
 723:./lwip-2.1.2/src/core/tcp_in.c ****     }
 724:./lwip-2.1.2/src/core/tcp_in.c ****     tcp_output(npcb);
 725:./lwip-2.1.2/src/core/tcp_in.c ****   }
 726:./lwip-2.1.2/src/core/tcp_in.c ****   return;
 727:./lwip-2.1.2/src/core/tcp_in.c **** }
 728:./lwip-2.1.2/src/core/tcp_in.c **** 
 729:./lwip-2.1.2/src/core/tcp_in.c **** /**
 730:./lwip-2.1.2/src/core/tcp_in.c ****  * Called by tcp_input() when a segment arrives for a connection in
 731:./lwip-2.1.2/src/core/tcp_in.c ****  * TIME_WAIT.
 732:./lwip-2.1.2/src/core/tcp_in.c ****  *
 733:./lwip-2.1.2/src/core/tcp_in.c ****  * @param pcb the tcp_pcb for which a segment arrived
 734:./lwip-2.1.2/src/core/tcp_in.c ****  *
 735:./lwip-2.1.2/src/core/tcp_in.c ****  * @note the segment which arrived is saved in global variables, therefore only the pcb
 736:./lwip-2.1.2/src/core/tcp_in.c ****  *       involved is passed as a parameter to this function
 737:./lwip-2.1.2/src/core/tcp_in.c ****  */
 738:./lwip-2.1.2/src/core/tcp_in.c **** static void
 739:./lwip-2.1.2/src/core/tcp_in.c **** tcp_timewait_input(struct tcp_pcb *pcb)
 740:./lwip-2.1.2/src/core/tcp_in.c **** {
 741:./lwip-2.1.2/src/core/tcp_in.c ****   /* RFC 1337: in TIME_WAIT, ignore RST and ACK FINs + any 'acceptable' segments */
 742:./lwip-2.1.2/src/core/tcp_in.c ****   /* RFC 793 3.9 Event Processing - Segment Arrives:
 743:./lwip-2.1.2/src/core/tcp_in.c ****    * - first check sequence number - we skip that one in TIME_WAIT (always
 744:./lwip-2.1.2/src/core/tcp_in.c ****    *   acceptable since we only send ACKs)
 745:./lwip-2.1.2/src/core/tcp_in.c ****    * - second check the RST bit (... return) */
 746:./lwip-2.1.2/src/core/tcp_in.c ****   if (flags & TCP_RST) {
 747:./lwip-2.1.2/src/core/tcp_in.c ****     return;
 748:./lwip-2.1.2/src/core/tcp_in.c ****   }
 749:./lwip-2.1.2/src/core/tcp_in.c **** 
 750:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_ASSERT("tcp_timewait_input: invalid pcb", pcb != NULL);
 751:./lwip-2.1.2/src/core/tcp_in.c **** 
 752:./lwip-2.1.2/src/core/tcp_in.c ****   /* - fourth, check the SYN bit, */
 753:./lwip-2.1.2/src/core/tcp_in.c ****   if (flags & TCP_SYN) {
 754:./lwip-2.1.2/src/core/tcp_in.c ****     /* If an incoming segment is not acceptable, an acknowledgment
 755:./lwip-2.1.2/src/core/tcp_in.c ****        should be sent in reply */
 756:./lwip-2.1.2/src/core/tcp_in.c ****     if (TCP_SEQ_BETWEEN(seqno, pcb->rcv_nxt, pcb->rcv_nxt + pcb->rcv_wnd)) {
 757:./lwip-2.1.2/src/core/tcp_in.c ****       /* If the SYN is in the window it is an error, send a reset */
 758:./lwip-2.1.2/src/core/tcp_in.c ****       tcp_rst(pcb, ackno, seqno + tcplen, ip_current_dest_addr(),
 759:./lwip-2.1.2/src/core/tcp_in.c ****               ip_current_src_addr(), tcphdr->dest, tcphdr->src);
 760:./lwip-2.1.2/src/core/tcp_in.c ****       return;
 761:./lwip-2.1.2/src/core/tcp_in.c ****     }
 762:./lwip-2.1.2/src/core/tcp_in.c ****   } else if (flags & TCP_FIN) {
 763:./lwip-2.1.2/src/core/tcp_in.c ****     /* - eighth, check the FIN bit: Remain in the TIME-WAIT state.
 764:./lwip-2.1.2/src/core/tcp_in.c ****          Restart the 2 MSL time-wait timeout.*/
 765:./lwip-2.1.2/src/core/tcp_in.c ****     pcb->tmr = tcp_ticks;
 766:./lwip-2.1.2/src/core/tcp_in.c ****   }
 767:./lwip-2.1.2/src/core/tcp_in.c **** 
 768:./lwip-2.1.2/src/core/tcp_in.c ****   if ((tcplen > 0)) {
 769:./lwip-2.1.2/src/core/tcp_in.c ****     /* Acknowledge data, FIN or out-of-window SYN */
 770:./lwip-2.1.2/src/core/tcp_in.c ****     tcp_ack_now(pcb);
 771:./lwip-2.1.2/src/core/tcp_in.c ****     tcp_output(pcb);
 772:./lwip-2.1.2/src/core/tcp_in.c ****   }
 773:./lwip-2.1.2/src/core/tcp_in.c ****   return;
 774:./lwip-2.1.2/src/core/tcp_in.c **** }
 775:./lwip-2.1.2/src/core/tcp_in.c **** 
 776:./lwip-2.1.2/src/core/tcp_in.c **** /**
 777:./lwip-2.1.2/src/core/tcp_in.c ****  * Implements the TCP state machine. Called by tcp_input. In some
 778:./lwip-2.1.2/src/core/tcp_in.c ****  * states tcp_receive() is called to receive data. The tcp_seg
 779:./lwip-2.1.2/src/core/tcp_in.c ****  * argument will be freed by the caller (tcp_input()) unless the
 780:./lwip-2.1.2/src/core/tcp_in.c ****  * recv_data pointer in the pcb is set.
 781:./lwip-2.1.2/src/core/tcp_in.c ****  *
 782:./lwip-2.1.2/src/core/tcp_in.c ****  * @param pcb the tcp_pcb for which a segment arrived
 783:./lwip-2.1.2/src/core/tcp_in.c ****  *
 784:./lwip-2.1.2/src/core/tcp_in.c ****  * @note the segment which arrived is saved in global variables, therefore only the pcb
 785:./lwip-2.1.2/src/core/tcp_in.c ****  *       involved is passed as a parameter to this function
 786:./lwip-2.1.2/src/core/tcp_in.c ****  */
 787:./lwip-2.1.2/src/core/tcp_in.c **** static err_t
 788:./lwip-2.1.2/src/core/tcp_in.c **** tcp_process(struct tcp_pcb *pcb)
 789:./lwip-2.1.2/src/core/tcp_in.c **** {
 790:./lwip-2.1.2/src/core/tcp_in.c ****   struct tcp_seg *rseg;
 791:./lwip-2.1.2/src/core/tcp_in.c ****   u8_t acceptable = 0;
 792:./lwip-2.1.2/src/core/tcp_in.c ****   err_t err;
 793:./lwip-2.1.2/src/core/tcp_in.c **** 
 794:./lwip-2.1.2/src/core/tcp_in.c ****   err = ERR_OK;
 795:./lwip-2.1.2/src/core/tcp_in.c **** 
 796:./lwip-2.1.2/src/core/tcp_in.c ****   LWIP_ASSERT("tcp_process: invalid pcb", pcb != NULL);
 797:./lwip-2.1.2/src/core/tcp_in.c **** 
 798:./lwip-2.1.2/src/core/tcp_in.c ****   /* Process incoming RST segments. */
 799:./lwip-2.1.2/src/core/tcp_in.c ****   if (flags & TCP_RST) {
 800:./lwip-2.1.2/src/core/tcp_in.c ****     /* First, determine if the reset is acceptable. */
 801:./lwip-2.1.2/src/core/tcp_in.c ****     if (pcb->state == SYN_SENT) {
 802:./lwip-2.1.2/src/core/tcp_in.c ****       /* "In the SYN-SENT state (a RST received in response to an initial SYN),
 803:./lwip-2.1.2/src/core/tcp_in.c ****           the RST is acceptable if the ACK field acknowledges the SYN." */
 804:./lwip-2.1.2/src/core/tcp_in.c ****       if (ackno == pcb->snd_nxt) {
 805:./lwip-2.1.2/src/core/tcp_in.c ****         acceptable = 1;
 806:./lwip-2.1.2/src/core/tcp_in.c ****       }
 807:./lwip-2.1.2/src/core/tcp_in.c ****     } else {
 808:./lwip-2.1.2/src/core/tcp_in.c ****       /* "In all states except SYN-SENT, all reset (RST) segments are validated
 809:./lwip-2.1.2/src/core/tcp_in.c ****           by checking their SEQ-fields." */
 810:./lwip-2.1.2/src/core/tcp_in.c ****       if (seqno == pcb->rcv_nxt) {
 811:./lwip-2.1.2/src/core/tcp_in.c ****         acceptable = 1;
 812:./lwip-2.1.2/src/core/tcp_in.c ****       } else  if (TCP_SEQ_BETWEEN(seqno, pcb->rcv_nxt,
 813:./lwip-2.1.2/src/core/tcp_in.c ****                                   pcb->rcv_nxt + pcb->rcv_wnd)) {
 814:./lwip-2.1.2/src/core/tcp_in.c ****         /* If the sequence number is inside the window, we send a challenge ACK
 815:./lwip-2.1.2/src/core/tcp_in.c ****            and wait for a re-send with matching sequence number.
 816:./lwip-2.1.2/src/core/tcp_in.c ****            This follows RFC 5961 section 3.2 and addresses CVE-2004-0230
 817:./lwip-2.1.2/src/core/tcp_in.c ****            (RST spoofing attack), which is present in RFC 793 RST handling. */
 818:./lwip-2.1.2/src/core/tcp_in.c ****         tcp_ack_now(pcb);
 819:./lwip-2.1.2/src/core/tcp_in.c ****       }
 820:./lwip-2.1.2/src/core/tcp_in.c ****     }
 821:./lwip-2.1.2/src/core/tcp_in.c **** 
 822:./lwip-2.1.2/src/core/tcp_in.c ****     if (acceptable) {
 823:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_process: Connection RESET\n"));
 824:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_ASSERT("tcp_input: pcb->state != CLOSED", pcb->state != CLOSED);
 825:./lwip-2.1.2/src/core/tcp_in.c ****       recv_flags |= TF_RESET;
 826:./lwip-2.1.2/src/core/tcp_in.c ****       tcp_clear_flags(pcb, TF_ACK_DELAY);
 827:./lwip-2.1.2/src/core/tcp_in.c ****       return ERR_RST;
 828:./lwip-2.1.2/src/core/tcp_in.c ****     } else {
 829:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("tcp_process: unacceptable reset seqno %"U32_F" rcv_nxt %"U32_F
 830:./lwip-2.1.2/src/core/tcp_in.c ****                                     seqno, pcb->rcv_nxt));
 831:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_DEBUG, ("tcp_process: unacceptable reset seqno %"U32_F" rcv_nxt %"U32_F"\n",
 832:./lwip-2.1.2/src/core/tcp_in.c ****                               seqno, pcb->rcv_nxt));
 833:./lwip-2.1.2/src/core/tcp_in.c ****       return ERR_OK;
 834:./lwip-2.1.2/src/core/tcp_in.c ****     }
 835:./lwip-2.1.2/src/core/tcp_in.c ****   }
 836:./lwip-2.1.2/src/core/tcp_in.c **** 
 837:./lwip-2.1.2/src/core/tcp_in.c ****   if ((flags & TCP_SYN) && (pcb->state != SYN_SENT && pcb->state != SYN_RCVD)) {
 838:./lwip-2.1.2/src/core/tcp_in.c ****     /* Cope with new connection attempt after remote end crashed */
 839:./lwip-2.1.2/src/core/tcp_in.c ****     tcp_ack_now(pcb);
 840:./lwip-2.1.2/src/core/tcp_in.c ****     return ERR_OK;
 841:./lwip-2.1.2/src/core/tcp_in.c ****   }
 842:./lwip-2.1.2/src/core/tcp_in.c **** 
 843:./lwip-2.1.2/src/core/tcp_in.c ****   if ((pcb->flags & TF_RXCLOSED) == 0) {
 844:./lwip-2.1.2/src/core/tcp_in.c ****     /* Update the PCB (in)activity timer unless rx is closed (see tcp_shutdown) */
 845:./lwip-2.1.2/src/core/tcp_in.c ****     pcb->tmr = tcp_ticks;
 846:./lwip-2.1.2/src/core/tcp_in.c ****   }
 847:./lwip-2.1.2/src/core/tcp_in.c ****   pcb->keep_cnt_sent = 0;
 848:./lwip-2.1.2/src/core/tcp_in.c ****   pcb->persist_probe = 0;
 849:./lwip-2.1.2/src/core/tcp_in.c **** 
 850:./lwip-2.1.2/src/core/tcp_in.c ****   tcp_parseopt(pcb);
 851:./lwip-2.1.2/src/core/tcp_in.c **** 
 852:./lwip-2.1.2/src/core/tcp_in.c ****   /* Do different things depending on the TCP state. */
 853:./lwip-2.1.2/src/core/tcp_in.c ****   switch (pcb->state) {
 854:./lwip-2.1.2/src/core/tcp_in.c ****     case SYN_SENT:
 855:./lwip-2.1.2/src/core/tcp_in.c ****       LWIP_DEBUGF(TCP_INPUT_DEBUG, ("SYN-SENT: ackno %"U32_F" pcb->snd_nxt %"U32_F" unacked %"U32_F
 856:./lwip-2.1.2/src/core/tcp_in.c ****                                     pcb->snd_nxt, lwip_ntohl(pcb->unacked->tcphdr->seqno)));
 857:./lwip-2.1.2/src/core/tcp_in.c ****       /* received SYN ACK with expected sequence number? */
 858:./lwip-2.1.2/src/core/tcp_in.c ****       if ((flags & TCP_ACK) && (flags & TCP_SYN)
 859:./lwip-2.1.2/src/core/tcp_in.c ****           && (ackno == pcb->lastack + 1)) {
 860:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->rcv_nxt = seqno + 1;
 861:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->rcv_ann_right_edge = pcb->rcv_nxt;
 862:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->lastack = ackno;
 863:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->snd_wnd = tcphdr->wnd;
 864:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->snd_wnd_max = pcb->snd_wnd;
 865:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->snd_wl1 = seqno - 1; /* initialise to seqno - 1 to force window update */
 866:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->state = ESTABLISHED;
 867:./lwip-2.1.2/src/core/tcp_in.c **** 
 868:./lwip-2.1.2/src/core/tcp_in.c **** #if TCP_CALCULATE_EFF_SEND_MSS
 869:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->mss = tcp_eff_send_mss(pcb->mss, &pcb->local_ip, &pcb->remote_ip);
 870:./lwip-2.1.2/src/core/tcp_in.c **** #endif /* TCP_CALCULATE_EFF_SEND_MSS */

1177:./lwip-2.1.2/src/core/tcp_in.c ****     /* (From Stevens TCP/IP Illustrated Vol II, p970.) Its only a
1178:./lwip-2.1.2/src/core/tcp_in.c ****      * duplicate ack if:
1179:./lwip-2.1.2/src/core/tcp_in.c ****      * 1) It doesn't ACK new data
1180:./lwip-2.1.2/src/core/tcp_in.c ****      * 2) length of received packet is zero (i.e. no payload)
1181:./lwip-2.1.2/src/core/tcp_in.c ****      * 3) the advertised window hasn't changed
1182:./lwip-2.1.2/src/core/tcp_in.c ****      * 4) There is outstanding unacknowledged data (retransmission timer running)
1183:./lwip-2.1.2/src/core/tcp_in.c ****      * 5) The ACK is == biggest ACK sequence number so far seen (snd_una)
1184:./lwip-2.1.2/src/core/tcp_in.c ****      *
1185:./lwip-2.1.2/src/core/tcp_in.c ****      * If it passes all five, should process as a dupack:
1186:./lwip-2.1.2/src/core/tcp_in.c ****      * a) dupacks < 3: do nothing
1187:./lwip-2.1.2/src/core/tcp_in.c ****      * b) dupacks == 3: fast retransmit
1188:./lwip-2.1.2/src/core/tcp_in.c ****      * c) dupacks > 3: increase cwnd
1189:./lwip-2.1.2/src/core/tcp_in.c ****      *
1190:./lwip-2.1.2/src/core/tcp_in.c ****      * If it only passes 1-3, should reset dupack counter (and add to
1191:./lwip-2.1.2/src/core/tcp_in.c ****      * stats, which we don't do in lwIP)
1192:./lwip-2.1.2/src/core/tcp_in.c ****      *
1193:./lwip-2.1.2/src/core/tcp_in.c ****      * If it only passes 1, should reset dupack counter
1194:./lwip-2.1.2/src/core/tcp_in.c ****      *
1195:./lwip-2.1.2/src/core/tcp_in.c ****      */
1196:./lwip-2.1.2/src/core/tcp_in.c **** 
1197:./lwip-2.1.2/src/core/tcp_in.c ****     /* Clause 1 */
1198:./lwip-2.1.2/src/core/tcp_in.c ****     if (TCP_SEQ_LEQ(ackno, pcb->lastack)) {
1199:./lwip-2.1.2/src/core/tcp_in.c ****       /* Clause 2 */
1200:./lwip-2.1.2/src/core/tcp_in.c ****       if (tcplen == 0) {
1201:./lwip-2.1.2/src/core/tcp_in.c ****         /* Clause 3 */
1202:./lwip-2.1.2/src/core/tcp_in.c ****         if (pcb->snd_wl2 + pcb->snd_wnd == right_wnd_edge) {
1203:./lwip-2.1.2/src/core/tcp_in.c ****           /* Clause 4 */
1204:./lwip-2.1.2/src/core/tcp_in.c ****           if (pcb->rtime >= 0) {
1205:./lwip-2.1.2/src/core/tcp_in.c ****             /* Clause 5 */
1206:./lwip-2.1.2/src/core/tcp_in.c ****             if (pcb->lastack == ackno) {
1207:./lwip-2.1.2/src/core/tcp_in.c ****               found_dupack = 1;
1208:./lwip-2.1.2/src/core/tcp_in.c ****               if ((u8_t)(pcb->dupacks + 1) > pcb->dupacks) {
1209:./lwip-2.1.2/src/core/tcp_in.c ****                 ++pcb->dupacks;
1210:./lwip-2.1.2/src/core/tcp_in.c ****               }
1211:./lwip-2.1.2/src/core/tcp_in.c ****               if (pcb->dupacks > 3) {
1212:./lwip-2.1.2/src/core/tcp_in.c ****                 /* Inflate the congestion window */
1213:./lwip-2.1.2/src/core/tcp_in.c ****                 TCP_WND_INC(pcb->cwnd, pcb->mss);
1214:./lwip-2.1.2/src/core/tcp_in.c ****               }
1215:./lwip-2.1.2/src/core/tcp_in.c ****               if (pcb->dupacks >= 3) {
1216:./lwip-2.1.2/src/core/tcp_in.c ****                 /* Do fast retransmit (checked via TF_INFR, not via dupacks count) */
1217:./lwip-2.1.2/src/core/tcp_in.c ****                 tcp_rexmit_fast(pcb);
1218:./lwip-2.1.2/src/core/tcp_in.c ****               }
1219:./lwip-2.1.2/src/core/tcp_in.c ****             }
1220:./lwip-2.1.2/src/core/tcp_in.c ****           }
1221:./lwip-2.1.2/src/core/tcp_in.c ****         }
1222:./lwip-2.1.2/src/core/tcp_in.c ****       }
1223:./lwip-2.1.2/src/core/tcp_in.c ****       /* If Clause (1) or more is true, but not a duplicate ack, reset
1224:./lwip-2.1.2/src/core/tcp_in.c ****        * count of consecutive duplicate acks */
1225:./lwip-2.1.2/src/core/tcp_in.c ****       if (!found_dupack) {
1226:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->dupacks = 0;
1227:./lwip-2.1.2/src/core/tcp_in.c ****       }
1228:./lwip-2.1.2/src/core/tcp_in.c ****     } else if (TCP_SEQ_BETWEEN(ackno, pcb->lastack + 1, pcb->snd_nxt)) {
1229:./lwip-2.1.2/src/core/tcp_in.c ****       /* We come here when the ACK acknowledges new data. */
1230:./lwip-2.1.2/src/core/tcp_in.c ****       tcpwnd_size_t acked;
1231:./lwip-2.1.2/src/core/tcp_in.c **** 
1232:./lwip-2.1.2/src/core/tcp_in.c ****       /* Reset the "IN Fast Retransmit" flag, since we are no longer
1233:./lwip-2.1.2/src/core/tcp_in.c ****          in fast retransmit. Also reset the congestion window to the
1234:./lwip-2.1.2/src/core/tcp_in.c ****          slow start threshold. */
1235:./lwip-2.1.2/src/core/tcp_in.c ****       if (pcb->flags & TF_INFR) {
1236:./lwip-2.1.2/src/core/tcp_in.c ****         tcp_clear_flags(pcb, TF_INFR);
1237:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->cwnd = pcb->ssthresh;
1238:./lwip-2.1.2/src/core/tcp_in.c ****         pcb->bytes_acked = 0;
1239:./lwip-2.1.2/src/core/tcp_in.c ****       }
1240:./lwip-2.1.2/src/core/tcp_in.c **** 
1241:./lwip-2.1.2/src/core/tcp_in.c ****       /* Reset the number of retransmissions. */
1242:./lwip-2.1.2/src/core/tcp_in.c ****       pcb->nrtx = 0;
1243:./lwip-2.1.2/src/core/tcp_in.c **** 
1244:./lwip-2.1.2/src/core/tcp_in.c ****       /* Reset the retransmission time-out. */

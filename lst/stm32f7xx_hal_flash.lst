 432:./src/stm32f7xx_hal_flash.c ****   /* NOTE : This function Should not be modified, when the callback is needed,
 433:./src/stm32f7xx_hal_flash.c ****   the HAL_FLASH_EndOfOperationCallback could be implemented in the user file
 434:./src/stm32f7xx_hal_flash.c ****   */ 
 435:./src/stm32f7xx_hal_flash.c **** }
 436:./src/stm32f7xx_hal_flash.c **** 
 437:./src/stm32f7xx_hal_flash.c **** /**
 438:./src/stm32f7xx_hal_flash.c ****   * @brief  FLASH operation error interrupt callback
 439:./src/stm32f7xx_hal_flash.c ****   * @param  ReturnValue The value saved in this parameter depends on the ongoing procedure
 440:./src/stm32f7xx_hal_flash.c ****   *                 - Sectors Erase: Sector which has been erased (if 0xFFFFFFFF, it means that 
 441:./src/stm32f7xx_hal_flash.c ****   *                                  all the selected sectors have been erased)
 442:./src/stm32f7xx_hal_flash.c ****   *                 - Program      : Address which was selected for data program
 443:./src/stm32f7xx_hal_flash.c ****   *                 - Mass Erase   : No return value expected
 444:./src/stm32f7xx_hal_flash.c ****   * @retval None
 445:./src/stm32f7xx_hal_flash.c ****   */
 446:./src/stm32f7xx_hal_flash.c **** __weak void HAL_FLASH_OperationErrorCallback(uint32_t ReturnValue)
 447:./src/stm32f7xx_hal_flash.c **** {
 448:./src/stm32f7xx_hal_flash.c ****   /* Prevent unused argument(s) compilation warning */
 449:./src/stm32f7xx_hal_flash.c ****   UNUSED(ReturnValue);
 450:./src/stm32f7xx_hal_flash.c ****   /* NOTE : This function Should not be modified, when the callback is needed,
 451:./src/stm32f7xx_hal_flash.c ****   the HAL_FLASH_OperationErrorCallback could be implemented in the user file
 452:./src/stm32f7xx_hal_flash.c ****    */ 
 453:./src/stm32f7xx_hal_flash.c **** }
 454:./src/stm32f7xx_hal_flash.c **** 
 455:./src/stm32f7xx_hal_flash.c **** /**
 456:./src/stm32f7xx_hal_flash.c ****   * @}

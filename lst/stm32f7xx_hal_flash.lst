 591:./src/stm32f7xx_hal_flash.c **** /**
 592:./src/stm32f7xx_hal_flash.c ****   * @brief  Wait for a FLASH operation to complete.
 593:./src/stm32f7xx_hal_flash.c ****   * @param  Timeout maximum flash operationtimeout
 594:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status
 595:./src/stm32f7xx_hal_flash.c ****   */
 596:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef FLASH_WaitForLastOperation(uint32_t Timeout)
 597:./src/stm32f7xx_hal_flash.c **** { 
 598:./src/stm32f7xx_hal_flash.c ****   uint32_t tickstart = 0;
 599:./src/stm32f7xx_hal_flash.c ****   
 600:./src/stm32f7xx_hal_flash.c ****   /* Clear Error Code */
 601:./src/stm32f7xx_hal_flash.c ****   pFlash.ErrorCode = HAL_FLASH_ERROR_NONE;
 602:./src/stm32f7xx_hal_flash.c ****   
 603:./src/stm32f7xx_hal_flash.c ****   /* Wait for the FLASH operation to complete by polling on BUSY flag to be reset.
 604:./src/stm32f7xx_hal_flash.c ****      Even if the FLASH operation fails, the BUSY flag will be reset and an error
 605:./src/stm32f7xx_hal_flash.c ****      flag will be set */
 606:./src/stm32f7xx_hal_flash.c ****   /* Get tick */
 607:./src/stm32f7xx_hal_flash.c ****   tickstart = HAL_GetTick();
 608:./src/stm32f7xx_hal_flash.c **** 
 609:./src/stm32f7xx_hal_flash.c ****   while(__HAL_FLASH_GET_FLAG(FLASH_FLAG_BSY) != RESET) 
 610:./src/stm32f7xx_hal_flash.c ****   { 
 611:./src/stm32f7xx_hal_flash.c ****     if(Timeout != HAL_MAX_DELAY)
 612:./src/stm32f7xx_hal_flash.c ****     {
 613:./src/stm32f7xx_hal_flash.c ****       if((Timeout == 0)||((HAL_GetTick() - tickstart ) > Timeout))
 614:./src/stm32f7xx_hal_flash.c ****       {
 615:./src/stm32f7xx_hal_flash.c ****         return HAL_TIMEOUT;
 616:./src/stm32f7xx_hal_flash.c ****       }
 617:./src/stm32f7xx_hal_flash.c ****     } 
 618:./src/stm32f7xx_hal_flash.c ****   }
 619:./src/stm32f7xx_hal_flash.c ****   
 620:./src/stm32f7xx_hal_flash.c ****   if(__HAL_FLASH_GET_FLAG(FLASH_FLAG_ALL_ERRORS) != RESET)
 621:./src/stm32f7xx_hal_flash.c ****   {
 622:./src/stm32f7xx_hal_flash.c ****     /*Save the error code*/
 623:./src/stm32f7xx_hal_flash.c ****     FLASH_SetErrorCode();
 624:./src/stm32f7xx_hal_flash.c ****     return HAL_ERROR;
 625:./src/stm32f7xx_hal_flash.c ****   }
 626:./src/stm32f7xx_hal_flash.c ****   
 627:./src/stm32f7xx_hal_flash.c ****   /* Check FLASH End of Operation flag  */
 628:./src/stm32f7xx_hal_flash.c ****   if (__HAL_FLASH_GET_FLAG(FLASH_FLAG_EOP) != RESET)
 629:./src/stm32f7xx_hal_flash.c ****   {
 630:./src/stm32f7xx_hal_flash.c ****     /* Clear FLASH End of Operation pending bit */
 631:./src/stm32f7xx_hal_flash.c ****     __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP);
 632:./src/stm32f7xx_hal_flash.c ****   }
 633:./src/stm32f7xx_hal_flash.c **** 
 634:./src/stm32f7xx_hal_flash.c ****   /* If there is an error flag set */
 635:./src/stm32f7xx_hal_flash.c ****   return HAL_OK;
 636:./src/stm32f7xx_hal_flash.c ****   
 637:./src/stm32f7xx_hal_flash.c **** }  
 638:./src/stm32f7xx_hal_flash.c **** 
 639:./src/stm32f7xx_hal_flash.c **** /**
 640:./src/stm32f7xx_hal_flash.c ****   * @brief  Program a double word (64-bit) at a specified address.
 641:./src/stm32f7xx_hal_flash.c ****   * @note   This function must be used when the device voltage range is from
 642:./src/stm32f7xx_hal_flash.c ****   *         2.7V to 3.6V and an External Vpp is present.
 643:./src/stm32f7xx_hal_flash.c ****   *
 644:./src/stm32f7xx_hal_flash.c ****   * @note   If an erase and a program operations are requested simultaneously,    
 645:./src/stm32f7xx_hal_flash.c ****   *         the erase operation is performed before the program one.
 646:./src/stm32f7xx_hal_flash.c ****   *  
 647:./src/stm32f7xx_hal_flash.c ****   * @param  Address specifies the address to be programmed.
 648:./src/stm32f7xx_hal_flash.c ****   * @param  Data specifies the data to be programmed.
 649:./src/stm32f7xx_hal_flash.c ****   * @retval None
 650:./src/stm32f7xx_hal_flash.c ****   */
 651:./src/stm32f7xx_hal_flash.c **** static void FLASH_Program_DoubleWord(uint32_t Address, uint64_t Data)
 652:./src/stm32f7xx_hal_flash.c **** {
 653:./src/stm32f7xx_hal_flash.c ****   /* Check the parameters */
 654:./src/stm32f7xx_hal_flash.c ****   assert_param(IS_FLASH_ADDRESS(Address));
 655:./src/stm32f7xx_hal_flash.c ****   
 656:./src/stm32f7xx_hal_flash.c ****   /* If the previous operation is completed, proceed to program the new data */
 657:./src/stm32f7xx_hal_flash.c ****   FLASH->CR &= CR_PSIZE_MASK;
 658:./src/stm32f7xx_hal_flash.c ****   FLASH->CR |= FLASH_PSIZE_DOUBLE_WORD;
 659:./src/stm32f7xx_hal_flash.c ****   FLASH->CR |= FLASH_CR_PG;
 660:./src/stm32f7xx_hal_flash.c **** 
 661:./src/stm32f7xx_hal_flash.c ****   /* Program first word */
 662:./src/stm32f7xx_hal_flash.c ****   *(__IO uint32_t*)Address = (uint32_t)Data;
 663:./src/stm32f7xx_hal_flash.c ****   /* Barrier to ensure programming is performed in 2 steps, in right order
 664:./src/stm32f7xx_hal_flash.c ****     (independently of compiler optimization behavior) */
 665:./src/stm32f7xx_hal_flash.c ****   __ISB();
 666:./src/stm32f7xx_hal_flash.c **** 
 667:./src/stm32f7xx_hal_flash.c ****   /* Program second word */
 668:./src/stm32f7xx_hal_flash.c ****   *(__IO uint32_t*)(Address+4) = (uint32_t)(Data >> 32);
 669:./src/stm32f7xx_hal_flash.c **** 
 670:./src/stm32f7xx_hal_flash.c ****   /* Data synchronous Barrier (DSB) Just after the write operation
 671:./src/stm32f7xx_hal_flash.c ****      This will force the CPU to respect the sequence of instruction (no optimization).*/
 672:./src/stm32f7xx_hal_flash.c ****   __DSB();
 673:./src/stm32f7xx_hal_flash.c **** }
 674:./src/stm32f7xx_hal_flash.c **** 
 675:./src/stm32f7xx_hal_flash.c **** 

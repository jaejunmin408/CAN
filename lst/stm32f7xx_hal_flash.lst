 459:./src/stm32f7xx_hal_flash.c **** /** @defgroup FLASH_Exported_Functions_Group2 Peripheral Control functions 
 460:./src/stm32f7xx_hal_flash.c ****  *  @brief   management functions 
 461:./src/stm32f7xx_hal_flash.c ****  *
 462:./src/stm32f7xx_hal_flash.c **** @verbatim   
 463:./src/stm32f7xx_hal_flash.c ****  ===============================================================================
 464:./src/stm32f7xx_hal_flash.c ****                       ##### Peripheral Control functions #####
 465:./src/stm32f7xx_hal_flash.c ****  ===============================================================================  
 466:./src/stm32f7xx_hal_flash.c ****     [..]
 467:./src/stm32f7xx_hal_flash.c ****     This subsection provides a set of functions allowing to control the FLASH 
 468:./src/stm32f7xx_hal_flash.c ****     memory operations.
 469:./src/stm32f7xx_hal_flash.c **** 
 470:./src/stm32f7xx_hal_flash.c **** @endverbatim
 471:./src/stm32f7xx_hal_flash.c ****   * @{
 472:./src/stm32f7xx_hal_flash.c ****   */
 473:./src/stm32f7xx_hal_flash.c **** 
 474:./src/stm32f7xx_hal_flash.c **** /**
 475:./src/stm32f7xx_hal_flash.c ****   * @brief  Unlock the FLASH control register access
 476:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status
 477:./src/stm32f7xx_hal_flash.c ****   */
 478:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_Unlock(void)
 479:./src/stm32f7xx_hal_flash.c **** {
 480:./src/stm32f7xx_hal_flash.c ****   HAL_StatusTypeDef status = HAL_OK;
 481:./src/stm32f7xx_hal_flash.c **** 
 482:./src/stm32f7xx_hal_flash.c ****   if(READ_BIT(FLASH->CR, FLASH_CR_LOCK) != RESET)
 483:./src/stm32f7xx_hal_flash.c ****   {
 484:./src/stm32f7xx_hal_flash.c ****     /* Authorize the FLASH Registers access */
 485:./src/stm32f7xx_hal_flash.c ****     WRITE_REG(FLASH->KEYR, FLASH_KEY1);
 486:./src/stm32f7xx_hal_flash.c ****     WRITE_REG(FLASH->KEYR, FLASH_KEY2);
 487:./src/stm32f7xx_hal_flash.c **** 
 488:./src/stm32f7xx_hal_flash.c ****     /* Verify Flash is unlocked */
 489:./src/stm32f7xx_hal_flash.c ****     if(READ_BIT(FLASH->CR, FLASH_CR_LOCK) != RESET)
 490:./src/stm32f7xx_hal_flash.c ****     {
 491:./src/stm32f7xx_hal_flash.c ****       status = HAL_ERROR;
 492:./src/stm32f7xx_hal_flash.c ****     }
 493:./src/stm32f7xx_hal_flash.c ****   }
 494:./src/stm32f7xx_hal_flash.c **** 
 495:./src/stm32f7xx_hal_flash.c ****   return status;
 496:./src/stm32f7xx_hal_flash.c **** }
 497:./src/stm32f7xx_hal_flash.c **** 
 498:./src/stm32f7xx_hal_flash.c **** /**
 499:./src/stm32f7xx_hal_flash.c ****   * @brief  Locks the FLASH control register access
 500:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status
 501:./src/stm32f7xx_hal_flash.c ****   */
 502:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_Lock(void)
 503:./src/stm32f7xx_hal_flash.c **** {
 504:./src/stm32f7xx_hal_flash.c ****   /* Set the LOCK Bit to lock the FLASH Registers access */
 505:./src/stm32f7xx_hal_flash.c ****   FLASH->CR |= FLASH_CR_LOCK;
 506:./src/stm32f7xx_hal_flash.c ****   
 507:./src/stm32f7xx_hal_flash.c ****   return HAL_OK;  
 508:./src/stm32f7xx_hal_flash.c **** }
 509:./src/stm32f7xx_hal_flash.c **** 
 510:./src/stm32f7xx_hal_flash.c **** /**
 511:./src/stm32f7xx_hal_flash.c ****   * @brief  Unlock the FLASH Option Control Registers access.
 512:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status
 513:./src/stm32f7xx_hal_flash.c ****   */
 514:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_OB_Unlock(void)
 515:./src/stm32f7xx_hal_flash.c **** {
 516:./src/stm32f7xx_hal_flash.c ****   if((FLASH->OPTCR & FLASH_OPTCR_OPTLOCK) != RESET)
 517:./src/stm32f7xx_hal_flash.c ****   {
 518:./src/stm32f7xx_hal_flash.c ****     /* Authorizes the Option Byte register programming */
 519:./src/stm32f7xx_hal_flash.c ****     FLASH->OPTKEYR = FLASH_OPT_KEY1;
 520:./src/stm32f7xx_hal_flash.c ****     FLASH->OPTKEYR = FLASH_OPT_KEY2;
 521:./src/stm32f7xx_hal_flash.c ****   }
 522:./src/stm32f7xx_hal_flash.c ****   else
 523:./src/stm32f7xx_hal_flash.c ****   {
 524:./src/stm32f7xx_hal_flash.c ****     return HAL_ERROR;
 525:./src/stm32f7xx_hal_flash.c ****   }  
 526:./src/stm32f7xx_hal_flash.c ****   
 527:./src/stm32f7xx_hal_flash.c ****   return HAL_OK;  
 528:./src/stm32f7xx_hal_flash.c **** }
 529:./src/stm32f7xx_hal_flash.c **** 
 530:./src/stm32f7xx_hal_flash.c **** /**
 531:./src/stm32f7xx_hal_flash.c ****   * @brief  Lock the FLASH Option Control Registers access.
 532:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status 
 533:./src/stm32f7xx_hal_flash.c ****   */
 534:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_OB_Lock(void)
 535:./src/stm32f7xx_hal_flash.c **** {
 536:./src/stm32f7xx_hal_flash.c ****   /* Set the OPTLOCK Bit to lock the FLASH Option Byte Registers access */
 537:./src/stm32f7xx_hal_flash.c ****   FLASH->OPTCR |= FLASH_OPTCR_OPTLOCK;
 538:./src/stm32f7xx_hal_flash.c ****   
 539:./src/stm32f7xx_hal_flash.c ****   return HAL_OK;  
 540:./src/stm32f7xx_hal_flash.c **** }
 541:./src/stm32f7xx_hal_flash.c **** 
 542:./src/stm32f7xx_hal_flash.c **** /**
 543:./src/stm32f7xx_hal_flash.c ****   * @brief  Launch the option byte loading.
 544:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status
 545:./src/stm32f7xx_hal_flash.c ****   */
 546:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_OB_Launch(void)
 547:./src/stm32f7xx_hal_flash.c **** {
 548:./src/stm32f7xx_hal_flash.c ****   /* Set the OPTSTRT bit in OPTCR register */
 549:./src/stm32f7xx_hal_flash.c ****   FLASH->OPTCR |= FLASH_OPTCR_OPTSTRT;
 550:./src/stm32f7xx_hal_flash.c **** 
 551:./src/stm32f7xx_hal_flash.c ****   /* Wait for last operation to be completed */
 552:./src/stm32f7xx_hal_flash.c ****   return(FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE)); 
 553:./src/stm32f7xx_hal_flash.c **** }
 554:./src/stm32f7xx_hal_flash.c **** 
 555:./src/stm32f7xx_hal_flash.c **** /**
 556:./src/stm32f7xx_hal_flash.c ****   * @}
 557:./src/stm32f7xx_hal_flash.c ****   */

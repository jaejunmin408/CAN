 152:./src/stm32f7xx_hal_flash.c **** 
 153:./src/stm32f7xx_hal_flash.c **** /**
 154:./src/stm32f7xx_hal_flash.c ****   * @brief  Program byte, halfword, word or double word at a specified address
 155:./src/stm32f7xx_hal_flash.c ****   * @param  TypeProgram  Indicate the way to program at a specified address.
 156:./src/stm32f7xx_hal_flash.c ****   *                           This parameter can be a value of @ref FLASH_Type_Program
 157:./src/stm32f7xx_hal_flash.c ****   * @param  Address  specifies the address to be programmed.
 158:./src/stm32f7xx_hal_flash.c ****   * @param  Data specifies the data to be programmed
 159:./src/stm32f7xx_hal_flash.c ****   * 
 160:./src/stm32f7xx_hal_flash.c ****   * @retval HAL_StatusTypeDef HAL Status
 161:./src/stm32f7xx_hal_flash.c ****   */
 162:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_Program(uint32_t TypeProgram, uint32_t Address, uint64_t Data)
 163:./src/stm32f7xx_hal_flash.c **** {
 164:./src/stm32f7xx_hal_flash.c ****   HAL_StatusTypeDef status;
 165:./src/stm32f7xx_hal_flash.c ****   
 166:./src/stm32f7xx_hal_flash.c ****   /* Process Locked */
 167:./src/stm32f7xx_hal_flash.c ****   __HAL_LOCK(&pFlash);
 168:./src/stm32f7xx_hal_flash.c **** 
 169:./src/stm32f7xx_hal_flash.c ****   /* Check the parameters */
 170:./src/stm32f7xx_hal_flash.c ****   assert_param(IS_FLASH_TYPEPROGRAM(TypeProgram));
 171:./src/stm32f7xx_hal_flash.c **** 
 172:./src/stm32f7xx_hal_flash.c ****   /* Wait for last operation to be completed */
 173:./src/stm32f7xx_hal_flash.c ****   status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 174:./src/stm32f7xx_hal_flash.c ****   
 175:./src/stm32f7xx_hal_flash.c ****   if(status == HAL_OK)
 176:./src/stm32f7xx_hal_flash.c ****   {
 177:./src/stm32f7xx_hal_flash.c ****     switch(TypeProgram)
 178:./src/stm32f7xx_hal_flash.c ****     {
 179:./src/stm32f7xx_hal_flash.c ****       case FLASH_TYPEPROGRAM_BYTE :
 180:./src/stm32f7xx_hal_flash.c ****       {
 181:./src/stm32f7xx_hal_flash.c ****         /*Program byte (8-bit) at a specified address.*/
 182:./src/stm32f7xx_hal_flash.c ****         FLASH_Program_Byte(Address, (uint8_t) Data);
 183:./src/stm32f7xx_hal_flash.c ****         break;
 184:./src/stm32f7xx_hal_flash.c ****       }
 185:./src/stm32f7xx_hal_flash.c ****       
 186:./src/stm32f7xx_hal_flash.c ****       case FLASH_TYPEPROGRAM_HALFWORD :
 187:./src/stm32f7xx_hal_flash.c ****       {
 188:./src/stm32f7xx_hal_flash.c ****         /*Program halfword (16-bit) at a specified address.*/
 189:./src/stm32f7xx_hal_flash.c ****         FLASH_Program_HalfWord(Address, (uint16_t) Data);
 190:./src/stm32f7xx_hal_flash.c ****         break;
 191:./src/stm32f7xx_hal_flash.c ****       }
 192:./src/stm32f7xx_hal_flash.c ****       
 193:./src/stm32f7xx_hal_flash.c ****       case FLASH_TYPEPROGRAM_WORD :
 194:./src/stm32f7xx_hal_flash.c ****       {
 195:./src/stm32f7xx_hal_flash.c ****         /*Program word (32-bit) at a specified address.*/
 196:./src/stm32f7xx_hal_flash.c ****         FLASH_Program_Word(Address, (uint32_t) Data);
 197:./src/stm32f7xx_hal_flash.c ****         break;
 198:./src/stm32f7xx_hal_flash.c ****       }
 199:./src/stm32f7xx_hal_flash.c ****       
 200:./src/stm32f7xx_hal_flash.c ****       case FLASH_TYPEPROGRAM_DOUBLEWORD :
 201:./src/stm32f7xx_hal_flash.c ****       {
 202:./src/stm32f7xx_hal_flash.c ****         /*Program double word (64-bit) at a specified address.*/
 203:./src/stm32f7xx_hal_flash.c ****         FLASH_Program_DoubleWord(Address, Data);
 204:./src/stm32f7xx_hal_flash.c ****         break;
 205:./src/stm32f7xx_hal_flash.c ****       }
 206:./src/stm32f7xx_hal_flash.c ****       default :
 207:./src/stm32f7xx_hal_flash.c ****         break;
 208:./src/stm32f7xx_hal_flash.c ****     }
 209:./src/stm32f7xx_hal_flash.c ****     /* Wait for last operation to be completed */
 210:./src/stm32f7xx_hal_flash.c ****     status = FLASH_WaitForLastOperation((uint32_t)FLASH_TIMEOUT_VALUE);
 211:./src/stm32f7xx_hal_flash.c ****     
 212:./src/stm32f7xx_hal_flash.c ****     /* If the program operation is completed, disable the PG Bit */
 213:./src/stm32f7xx_hal_flash.c ****     FLASH->CR &= (~FLASH_CR_PG);
 214:./src/stm32f7xx_hal_flash.c ****   }
 215:./src/stm32f7xx_hal_flash.c **** 
 216:./src/stm32f7xx_hal_flash.c ****   /* Process Unlocked */
 217:./src/stm32f7xx_hal_flash.c ****   __HAL_UNLOCK(&pFlash);
 218:./src/stm32f7xx_hal_flash.c **** 
 219:./src/stm32f7xx_hal_flash.c ****   return status;
 220:./src/stm32f7xx_hal_flash.c **** }
 221:./src/stm32f7xx_hal_flash.c **** 
 222:./src/stm32f7xx_hal_flash.c **** /**
 223:./src/stm32f7xx_hal_flash.c ****   * @brief   Program byte, halfword, word or double word at a specified address  with interrupt ena
 224:./src/stm32f7xx_hal_flash.c ****   * @param  TypeProgram  Indicate the way to program at a specified address.
 225:./src/stm32f7xx_hal_flash.c ****   *                           This parameter can be a value of @ref FLASH_Type_Program
 226:./src/stm32f7xx_hal_flash.c ****   * @param  Address  specifies the address to be programmed.
 227:./src/stm32f7xx_hal_flash.c ****   * @param  Data specifies the data to be programmed
 228:./src/stm32f7xx_hal_flash.c ****   * 
 229:./src/stm32f7xx_hal_flash.c ****   * @retval HAL Status
 230:./src/stm32f7xx_hal_flash.c ****   */
 231:./src/stm32f7xx_hal_flash.c **** HAL_StatusTypeDef HAL_FLASH_Program_IT(uint32_t TypeProgram, uint32_t Address, uint64_t Data)
 232:./src/stm32f7xx_hal_flash.c **** {
 233:./src/stm32f7xx_hal_flash.c ****   HAL_StatusTypeDef status = HAL_OK;
 234:./src/stm32f7xx_hal_flash.c ****   
 235:./src/stm32f7xx_hal_flash.c ****   /* Process Locked */
 236:./src/stm32f7xx_hal_flash.c ****   __HAL_LOCK(&pFlash);
 237:./src/stm32f7xx_hal_flash.c **** 
 238:./src/stm32f7xx_hal_flash.c ****   /* Check the parameters */
 239:./src/stm32f7xx_hal_flash.c ****   assert_param(IS_FLASH_TYPEPROGRAM(TypeProgram));
 240:./src/stm32f7xx_hal_flash.c **** 
 241:./src/stm32f7xx_hal_flash.c ****   /* Enable End of FLASH Operation interrupt */
 242:./src/stm32f7xx_hal_flash.c ****   __HAL_FLASH_ENABLE_IT(FLASH_IT_EOP);
 243:./src/stm32f7xx_hal_flash.c ****   
 244:./src/stm32f7xx_hal_flash.c ****   /* Enable Error source interrupt */
 245:./src/stm32f7xx_hal_flash.c ****   __HAL_FLASH_ENABLE_IT(FLASH_IT_ERR);
 246:./src/stm32f7xx_hal_flash.c ****   
 247:./src/stm32f7xx_hal_flash.c ****   /* Clear pending flags (if any) */  
 248:./src/stm32f7xx_hal_flash.c ****   __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP    | FLASH_FLAG_OPERR | FLASH_FLAG_WRPERR |\
 249:./src/stm32f7xx_hal_flash.c ****                          FLASH_FLAG_PGAERR | FLASH_FLAG_PGPERR| FLASH_FLAG_ERSERR);  
 250:./src/stm32f7xx_hal_flash.c **** 
 251:./src/stm32f7xx_hal_flash.c ****   pFlash.ProcedureOnGoing = FLASH_PROC_PROGRAM;
 252:./src/stm32f7xx_hal_flash.c ****   pFlash.Address = Address;
 253:./src/stm32f7xx_hal_flash.c ****   
 254:./src/stm32f7xx_hal_flash.c ****   switch(TypeProgram)
 255:./src/stm32f7xx_hal_flash.c ****   {
 256:./src/stm32f7xx_hal_flash.c ****     case FLASH_TYPEPROGRAM_BYTE :
 257:./src/stm32f7xx_hal_flash.c ****     {
 258:./src/stm32f7xx_hal_flash.c ****       /*Program byte (8-bit) at a specified address.*/
 259:./src/stm32f7xx_hal_flash.c ****       FLASH_Program_Byte(Address, (uint8_t) Data);
 260:./src/stm32f7xx_hal_flash.c ****       break;
 261:./src/stm32f7xx_hal_flash.c ****     }
 262:./src/stm32f7xx_hal_flash.c ****     
 263:./src/stm32f7xx_hal_flash.c ****     case FLASH_TYPEPROGRAM_HALFWORD :
 264:./src/stm32f7xx_hal_flash.c ****     {
 265:./src/stm32f7xx_hal_flash.c ****       /*Program halfword (16-bit) at a specified address.*/
 266:./src/stm32f7xx_hal_flash.c ****       FLASH_Program_HalfWord(Address, (uint16_t) Data);
 267:./src/stm32f7xx_hal_flash.c ****       break;
 268:./src/stm32f7xx_hal_flash.c ****     }
 269:./src/stm32f7xx_hal_flash.c ****     
 270:./src/stm32f7xx_hal_flash.c ****     case FLASH_TYPEPROGRAM_WORD :
 271:./src/stm32f7xx_hal_flash.c ****     {
 272:./src/stm32f7xx_hal_flash.c ****       /*Program word (32-bit) at a specified address.*/
 273:./src/stm32f7xx_hal_flash.c ****       FLASH_Program_Word(Address, (uint32_t) Data);
 274:./src/stm32f7xx_hal_flash.c ****       break;
 275:./src/stm32f7xx_hal_flash.c ****     }
 276:./src/stm32f7xx_hal_flash.c ****     
 277:./src/stm32f7xx_hal_flash.c ****     case FLASH_TYPEPROGRAM_DOUBLEWORD :
 278:./src/stm32f7xx_hal_flash.c ****     {
 279:./src/stm32f7xx_hal_flash.c ****       /*Program double word (64-bit) at a specified address.*/
 280:./src/stm32f7xx_hal_flash.c ****       FLASH_Program_DoubleWord(Address, Data);
 281:./src/stm32f7xx_hal_flash.c ****       break;
 282:./src/stm32f7xx_hal_flash.c ****     }
 283:./src/stm32f7xx_hal_flash.c ****     default :
 284:./src/stm32f7xx_hal_flash.c ****       break;
 285:./src/stm32f7xx_hal_flash.c ****   }
 286:./src/stm32f7xx_hal_flash.c ****   return status;
 287:./src/stm32f7xx_hal_flash.c **** }
 288:./src/stm32f7xx_hal_flash.c **** 
 289:./src/stm32f7xx_hal_flash.c **** /**
 290:./src/stm32f7xx_hal_flash.c ****   * @brief This function handles FLASH interrupt request.
 291:./src/stm32f7xx_hal_flash.c ****   * @retval None
 292:./src/stm32f7xx_hal_flash.c ****   */
 293:./src/stm32f7xx_hal_flash.c **** void HAL_FLASH_IRQHandler(void)
 294:./src/stm32f7xx_hal_flash.c **** {
 295:./src/stm32f7xx_hal_flash.c ****   uint32_t temp = 0;
 296:./src/stm32f7xx_hal_flash.c ****   
 297:./src/stm32f7xx_hal_flash.c ****   /* If the program operation is completed, disable the PG Bit */
 298:./src/stm32f7xx_hal_flash.c ****   FLASH->CR &= (~FLASH_CR_PG);
 299:./src/stm32f7xx_hal_flash.c **** 
 300:./src/stm32f7xx_hal_flash.c ****   /* If the erase operation is completed, disable the SER Bit */
 301:./src/stm32f7xx_hal_flash.c ****   FLASH->CR &= (~FLASH_CR_SER);
 302:./src/stm32f7xx_hal_flash.c ****   FLASH->CR &= SECTOR_MASK; 
 303:./src/stm32f7xx_hal_flash.c **** 
 304:./src/stm32f7xx_hal_flash.c ****   /* if the erase operation is completed, disable the MER Bit */
 305:./src/stm32f7xx_hal_flash.c ****   FLASH->CR &= (~FLASH_MER_BIT);
 306:./src/stm32f7xx_hal_flash.c **** 
 307:./src/stm32f7xx_hal_flash.c ****   /* Check FLASH End of Operation flag  */
 308:./src/stm32f7xx_hal_flash.c ****   if(__HAL_FLASH_GET_FLAG(FLASH_FLAG_EOP) != RESET)
 309:./src/stm32f7xx_hal_flash.c ****   {
 310:./src/stm32f7xx_hal_flash.c ****     /* Clear FLASH End of Operation pending bit */
 311:./src/stm32f7xx_hal_flash.c ****     __HAL_FLASH_CLEAR_FLAG(FLASH_FLAG_EOP);
 312:./src/stm32f7xx_hal_flash.c ****     
 313:./src/stm32f7xx_hal_flash.c ****     switch (pFlash.ProcedureOnGoing)
 314:./src/stm32f7xx_hal_flash.c ****     {
 315:./src/stm32f7xx_hal_flash.c ****       case FLASH_PROC_SECTERASE :
 316:./src/stm32f7xx_hal_flash.c ****       {
 317:./src/stm32f7xx_hal_flash.c ****         /* Nb of sector to erased can be decreased */
 318:./src/stm32f7xx_hal_flash.c ****         pFlash.NbSectorsToErase--;
 319:./src/stm32f7xx_hal_flash.c **** 
 320:./src/stm32f7xx_hal_flash.c ****         /* Check if there are still sectors to erase */
 321:./src/stm32f7xx_hal_flash.c ****         if(pFlash.NbSectorsToErase != 0)
 322:./src/stm32f7xx_hal_flash.c ****         {
 323:./src/stm32f7xx_hal_flash.c ****           temp = pFlash.Sector;
 324:./src/stm32f7xx_hal_flash.c ****           /* Indicate user which sector has been erased */
 325:./src/stm32f7xx_hal_flash.c ****           HAL_FLASH_EndOfOperationCallback(temp);
 326:./src/stm32f7xx_hal_flash.c **** 
 327:./src/stm32f7xx_hal_flash.c ****           /* Increment sector number */
 328:./src/stm32f7xx_hal_flash.c ****           temp = ++pFlash.Sector;
 329:./src/stm32f7xx_hal_flash.c ****           FLASH_Erase_Sector(temp, pFlash.VoltageForErase);
 330:./src/stm32f7xx_hal_flash.c ****         }
 331:./src/stm32f7xx_hal_flash.c ****         else
 332:./src/stm32f7xx_hal_flash.c ****         {
 333:./src/stm32f7xx_hal_flash.c ****           /* No more sectors to Erase, user callback can be called.*/
 334:./src/stm32f7xx_hal_flash.c ****           /* Reset Sector and stop Erase sectors procedure */
 335:./src/stm32f7xx_hal_flash.c ****           pFlash.Sector = temp = 0xFFFFFFFFU;
 336:./src/stm32f7xx_hal_flash.c ****           /* FLASH EOP interrupt user callback */
 337:./src/stm32f7xx_hal_flash.c ****           HAL_FLASH_EndOfOperationCallback(temp);
 338:./src/stm32f7xx_hal_flash.c ****           /* Sector Erase procedure is completed */
 339:./src/stm32f7xx_hal_flash.c ****           pFlash.ProcedureOnGoing = FLASH_PROC_NONE;
 340:./src/stm32f7xx_hal_flash.c ****         }
 341:./src/stm32f7xx_hal_flash.c ****         break;
 342:./src/stm32f7xx_hal_flash.c ****       }
 343:./src/stm32f7xx_hal_flash.c ****     
 344:./src/stm32f7xx_hal_flash.c ****       case FLASH_PROC_MASSERASE :
 345:./src/stm32f7xx_hal_flash.c ****       {
 346:./src/stm32f7xx_hal_flash.c ****         /* MassErase ended. Return the selected bank : in this product we don't have Banks */
 347:./src/stm32f7xx_hal_flash.c ****         /* FLASH EOP interrupt user callback */
 348:./src/stm32f7xx_hal_flash.c ****         HAL_FLASH_EndOfOperationCallback(0);
 349:./src/stm32f7xx_hal_flash.c ****         /* MAss Erase procedure is completed */
 350:./src/stm32f7xx_hal_flash.c ****         pFlash.ProcedureOnGoing = FLASH_PROC_NONE;
 351:./src/stm32f7xx_hal_flash.c ****         break;
 352:./src/stm32f7xx_hal_flash.c ****       }
 353:./src/stm32f7xx_hal_flash.c **** 
 354:./src/stm32f7xx_hal_flash.c ****       case FLASH_PROC_PROGRAM :
 355:./src/stm32f7xx_hal_flash.c ****       {
 356:./src/stm32f7xx_hal_flash.c ****         /*Program ended. Return the selected address*/
 357:./src/stm32f7xx_hal_flash.c ****         /* FLASH EOP interrupt user callback */
 358:./src/stm32f7xx_hal_flash.c ****         HAL_FLASH_EndOfOperationCallback(pFlash.Address);
 359:./src/stm32f7xx_hal_flash.c ****         /* Programming procedure is completed */
 360:./src/stm32f7xx_hal_flash.c ****         pFlash.ProcedureOnGoing = FLASH_PROC_NONE;
 361:./src/stm32f7xx_hal_flash.c ****         break;
 362:./src/stm32f7xx_hal_flash.c ****       }
 363:./src/stm32f7xx_hal_flash.c ****       default :
 364:./src/stm32f7xx_hal_flash.c ****         break;
 365:./src/stm32f7xx_hal_flash.c ****     }
 366:./src/stm32f7xx_hal_flash.c ****   }
 367:./src/stm32f7xx_hal_flash.c ****   
 368:./src/stm32f7xx_hal_flash.c ****   /* Check FLASH operation error flags */
 369:./src/stm32f7xx_hal_flash.c ****   if(__HAL_FLASH_GET_FLAG(FLASH_FLAG_ALL_ERRORS) != RESET)
 370:./src/stm32f7xx_hal_flash.c ****   {
 371:./src/stm32f7xx_hal_flash.c ****     switch (pFlash.ProcedureOnGoing)
 372:./src/stm32f7xx_hal_flash.c ****     {
 373:./src/stm32f7xx_hal_flash.c ****       case FLASH_PROC_SECTERASE :
 374:./src/stm32f7xx_hal_flash.c ****       {
 375:./src/stm32f7xx_hal_flash.c ****         /* return the faulty sector */
 376:./src/stm32f7xx_hal_flash.c ****         temp = pFlash.Sector;
 377:./src/stm32f7xx_hal_flash.c ****         pFlash.Sector = 0xFFFFFFFFU;
 378:./src/stm32f7xx_hal_flash.c ****         break;
 379:./src/stm32f7xx_hal_flash.c ****       }
 380:./src/stm32f7xx_hal_flash.c ****       case FLASH_PROC_MASSERASE :
 381:./src/stm32f7xx_hal_flash.c ****       {
 382:./src/stm32f7xx_hal_flash.c ****         /* No return in case of Mass Erase */
 383:./src/stm32f7xx_hal_flash.c ****         temp = 0;
 384:./src/stm32f7xx_hal_flash.c ****         break;
 385:./src/stm32f7xx_hal_flash.c ****       }
 386:./src/stm32f7xx_hal_flash.c ****       case FLASH_PROC_PROGRAM :
 387:./src/stm32f7xx_hal_flash.c ****       {
 388:./src/stm32f7xx_hal_flash.c ****         /*return the faulty address*/
 389:./src/stm32f7xx_hal_flash.c ****         temp = pFlash.Address;
 390:./src/stm32f7xx_hal_flash.c ****         break;
 391:./src/stm32f7xx_hal_flash.c ****       }
 392:./src/stm32f7xx_hal_flash.c ****     default :
 393:./src/stm32f7xx_hal_flash.c ****       break;
 394:./src/stm32f7xx_hal_flash.c ****     }
 395:./src/stm32f7xx_hal_flash.c ****     /*Save the Error code*/
 396:./src/stm32f7xx_hal_flash.c ****     FLASH_SetErrorCode();
 397:./src/stm32f7xx_hal_flash.c **** 
 398:./src/stm32f7xx_hal_flash.c ****     /* FLASH error interrupt user callback */
 399:./src/stm32f7xx_hal_flash.c ****     HAL_FLASH_OperationErrorCallback(temp);
 400:./src/stm32f7xx_hal_flash.c **** 
 401:./src/stm32f7xx_hal_flash.c ****     /*Stop the procedure ongoing */
 402:./src/stm32f7xx_hal_flash.c ****     pFlash.ProcedureOnGoing = FLASH_PROC_NONE;
 403:./src/stm32f7xx_hal_flash.c ****   }
 404:./src/stm32f7xx_hal_flash.c ****   
 405:./src/stm32f7xx_hal_flash.c ****   if(pFlash.ProcedureOnGoing == FLASH_PROC_NONE)
 406:./src/stm32f7xx_hal_flash.c ****   {
 407:./src/stm32f7xx_hal_flash.c ****     /* Disable End of FLASH Operation interrupt */
 408:./src/stm32f7xx_hal_flash.c ****     __HAL_FLASH_DISABLE_IT(FLASH_IT_EOP);
 409:./src/stm32f7xx_hal_flash.c **** 
 410:./src/stm32f7xx_hal_flash.c ****     /* Disable Error source interrupt */
 411:./src/stm32f7xx_hal_flash.c ****     __HAL_FLASH_DISABLE_IT(FLASH_IT_ERR);
 412:./src/stm32f7xx_hal_flash.c **** 
 413:./src/stm32f7xx_hal_flash.c ****     /* Process Unlocked */
 414:./src/stm32f7xx_hal_flash.c ****     __HAL_UNLOCK(&pFlash);
 415:./src/stm32f7xx_hal_flash.c ****   }
 416:./src/stm32f7xx_hal_flash.c ****   
 417:./src/stm32f7xx_hal_flash.c **** }
 418:./src/stm32f7xx_hal_flash.c **** 
 419:./src/stm32f7xx_hal_flash.c **** /**
 420:./src/stm32f7xx_hal_flash.c ****   * @brief  FLASH end of operation interrupt callback
 421:./src/stm32f7xx_hal_flash.c ****   * @param  ReturnValue The value saved in this parameter depends on the ongoing procedure
 422:./src/stm32f7xx_hal_flash.c ****   *                 - Sectors Erase: Sector which has been erased (if 0xFFFFFFFF, it means that 
 423:./src/stm32f7xx_hal_flash.c ****   *                                  all the selected sectors have been erased)
 424:./src/stm32f7xx_hal_flash.c ****   *                 - Program      : Address which was selected for data program
 425:./src/stm32f7xx_hal_flash.c ****   *                 - Mass Erase   : No return value expected
 426:./src/stm32f7xx_hal_flash.c ****   * @retval None
 427:./src/stm32f7xx_hal_flash.c ****   */
 428:./src/stm32f7xx_hal_flash.c **** __weak void HAL_FLASH_EndOfOperationCallback(uint32_t ReturnValue)

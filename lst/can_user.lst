  47:./src/can_user.c **** 		{
  48:./src/can_user.c **** 			case CAN_BUFFER_STATUS:
  49:./src/can_user.c **** 				// the buffer is a status notification from the CAN controller.
  50:./src/can_user.c **** 				if ( rx_buff->status.bus_status)
  51:./src/can_user.c **** 				{

 274:./src/ethernetif.c ****   
 275:./src/ethernetif.c **** /* Init ETH */
 276:./src/ethernetif.c **** 
 277:./src/ethernetif.c ****    uint8_t MACAddr[6] ;
 278:./src/ethernetif.c ****   heth.Instance = ETH;
 279:./src/ethernetif.c **** 
 280:./src/ethernetif.c ****   #if _PHY_IS_T1_
 281:./src/ethernetif.c ****   heth.Init.AutoNegotiation = ETH_AUTONEGOTIATION_DISABLE;
 282:./src/ethernetif.c ****   #else

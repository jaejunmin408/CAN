 518:./src/ethernetif.c ****     bufferoffset = 0;
 519:./src/ethernetif.c ****     for(q = p; q != NULL; q = q->next)
 520:./src/ethernetif.c ****     {
 521:./src/ethernetif.c ****       byteslefttocopy = q->len;
 522:./src/ethernetif.c ****       payloadoffset = 0;
 523:./src/ethernetif.c ****       

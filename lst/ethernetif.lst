 530:./src/ethernetif.c ****         /* Point to next descriptor */
 531:./src/ethernetif.c ****         dmarxdesc = (ETH_DMADescTypeDef *)(dmarxdesc->Buffer2NextDescAddr);
 532:./src/ethernetif.c ****         buffer = (uint8_t *)(dmarxdesc->Buffer1Addr);
 533:./src/ethernetif.c ****         
 534:./src/ethernetif.c ****         byteslefttocopy = byteslefttocopy - (ETH_RX_BUF_SIZE - bufferoffset);
 535:./src/ethernetif.c ****         payloadoffset = payloadoffset + (ETH_RX_BUF_SIZE - bufferoffset);
 536:./src/ethernetif.c ****         bufferoffset = 0;
 537:./src/ethernetif.c ****       }
 538:./src/ethernetif.c ****       /* Copy remaining data in pbuf */
 539:./src/ethernetif.c ****       memcpy( (uint8_t*)((uint8_t*)q->payload + payloadoffset), (uint8_t*)((uint8_t*)buffer + buffe
 540:./src/ethernetif.c ****       bufferoffset = bufferoffset + byteslefttocopy;
 541:./src/ethernetif.c ****     }
 542:./src/ethernetif.c ****   }  
 543:./src/ethernetif.c ****   
 544:./src/ethernetif.c ****     /* Release descriptors to DMA */
 545:./src/ethernetif.c ****     /* Point to first descriptor */
 546:./src/ethernetif.c ****     dmarxdesc = heth.RxFrameInfos.FSRxDesc;
 547:./src/ethernetif.c ****     /* Set Own bit in Rx descriptors: gives the buffers back to DMA */
 548:./src/ethernetif.c ****     for (i=0; i< heth.RxFrameInfos.SegCount; i++)
 549:./src/ethernetif.c ****     {  
 550:./src/ethernetif.c ****       dmarxdesc->Status |= ETH_DMARXDESC_OWN;
 551:./src/ethernetif.c ****       dmarxdesc = (ETH_DMADescTypeDef *)(dmarxdesc->Buffer2NextDescAddr);
 552:./src/ethernetif.c ****     }
 553:./src/ethernetif.c ****     
 554:./src/ethernetif.c ****     /* Clear Segment_Count */
 555:./src/ethernetif.c ****     heth.RxFrameInfos.SegCount =0;  
 556:./src/ethernetif.c ****   
 557:./src/ethernetif.c ****   /* When Rx Buffer unavailable flag is set: clear it and resume reception */
 558:./src/ethernetif.c ****   if ((heth.Instance->DMASR & ETH_DMASR_RBUS) != (uint32_t)RESET)  
 559:./src/ethernetif.c ****   {
 560:./src/ethernetif.c ****     /* Clear RBUS ETHERNET DMA flag */
 561:./src/ethernetif.c ****     heth.Instance->DMASR = ETH_DMASR_RBUS;
 562:./src/ethernetif.c ****     /* Resume DMA reception */
 563:./src/ethernetif.c ****     heth.Instance->DMARPDR = 0;
 564:./src/ethernetif.c ****   }
 565:./src/ethernetif.c ****   return p;
 566:./src/ethernetif.c **** }

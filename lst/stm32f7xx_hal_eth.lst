 520:./src/stm32f7xx_hal_eth.c **** /**
 521:./src/stm32f7xx_hal_eth.c ****   * @brief  Initializes the DMA Tx descriptors in chain mode.
 522:./src/stm32f7xx_hal_eth.c ****   * @param  heth pointer to a ETH_HandleTypeDef structure that contains
 523:./src/stm32f7xx_hal_eth.c ****   *         the configuration information for ETHERNET module  
 524:./src/stm32f7xx_hal_eth.c ****   * @param  DMATxDescTab Pointer to the first Tx desc list 
 525:./src/stm32f7xx_hal_eth.c ****   * @param  TxBuff Pointer to the first TxBuffer list
 526:./src/stm32f7xx_hal_eth.c ****   * @param  TxBuffCount Number of the used Tx desc in the list
 527:./src/stm32f7xx_hal_eth.c ****   * @retval HAL status
 528:./src/stm32f7xx_hal_eth.c ****   */
 529:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_DMATxDescListInit(ETH_HandleTypeDef *heth, ETH_DMADescTypeDef *DMATxDescT
 530:./src/stm32f7xx_hal_eth.c **** {
 531:./src/stm32f7xx_hal_eth.c ****   uint32_t i = 0;
 532:./src/stm32f7xx_hal_eth.c ****   ETH_DMADescTypeDef *dmatxdesc;
 533:./src/stm32f7xx_hal_eth.c ****   
 534:./src/stm32f7xx_hal_eth.c ****   /* Process Locked */
 535:./src/stm32f7xx_hal_eth.c ****   __HAL_LOCK(heth);
 536:./src/stm32f7xx_hal_eth.c ****   
 537:./src/stm32f7xx_hal_eth.c ****   /* Set the ETH peripheral state to BUSY */
 538:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_BUSY;
 539:./src/stm32f7xx_hal_eth.c ****   
 540:./src/stm32f7xx_hal_eth.c ****   /* Set the DMATxDescToSet pointer with the first one of the DMATxDescTab list */
 541:./src/stm32f7xx_hal_eth.c ****   heth->TxDesc = DMATxDescTab;
 542:./src/stm32f7xx_hal_eth.c ****   
 543:./src/stm32f7xx_hal_eth.c ****   /* Fill each DMATxDesc descriptor with the right values */   
 544:./src/stm32f7xx_hal_eth.c ****   for(i=0; i < TxBuffCount; i++)
 545:./src/stm32f7xx_hal_eth.c ****   {
 546:./src/stm32f7xx_hal_eth.c ****     /* Get the pointer on the ith member of the Tx Desc list */
 547:./src/stm32f7xx_hal_eth.c ****     dmatxdesc = DMATxDescTab + i;
 548:./src/stm32f7xx_hal_eth.c ****     
 549:./src/stm32f7xx_hal_eth.c ****     /* Set Second Address Chained bit */
 550:./src/stm32f7xx_hal_eth.c ****     dmatxdesc->Status = ETH_DMATXDESC_TCH;  
 551:./src/stm32f7xx_hal_eth.c ****     
 552:./src/stm32f7xx_hal_eth.c ****     /* Set Buffer1 address pointer */
 553:./src/stm32f7xx_hal_eth.c ****     dmatxdesc->Buffer1Addr = (uint32_t)(&TxBuff[i*ETH_TX_BUF_SIZE]);
 554:./src/stm32f7xx_hal_eth.c ****     
 555:./src/stm32f7xx_hal_eth.c ****     if ((heth->Init).ChecksumMode == ETH_CHECKSUM_BY_HARDWARE)
 556:./src/stm32f7xx_hal_eth.c ****     {
 557:./src/stm32f7xx_hal_eth.c ****       /* Set the DMA Tx descriptors checksum insertion */
 558:./src/stm32f7xx_hal_eth.c ****       dmatxdesc->Status |= ETH_DMATXDESC_CHECKSUMTCPUDPICMPFULL;
 559:./src/stm32f7xx_hal_eth.c ****     }
 560:./src/stm32f7xx_hal_eth.c ****     
 561:./src/stm32f7xx_hal_eth.c ****     /* Initialize the next descriptor with the Next Descriptor Polling Enable */
 562:./src/stm32f7xx_hal_eth.c ****     if(i < (TxBuffCount-1))
 563:./src/stm32f7xx_hal_eth.c ****     {
 564:./src/stm32f7xx_hal_eth.c ****       /* Set next descriptor address register with next descriptor base address */
 565:./src/stm32f7xx_hal_eth.c ****       dmatxdesc->Buffer2NextDescAddr = (uint32_t)(DMATxDescTab+i+1);
 566:./src/stm32f7xx_hal_eth.c ****     }
 567:./src/stm32f7xx_hal_eth.c ****     else
 568:./src/stm32f7xx_hal_eth.c ****     {
 569:./src/stm32f7xx_hal_eth.c ****       /* For last descriptor, set next descriptor address register equal to the first descriptor ba
 570:./src/stm32f7xx_hal_eth.c ****       dmatxdesc->Buffer2NextDescAddr = (uint32_t) DMATxDescTab;  
 571:./src/stm32f7xx_hal_eth.c ****     }
 572:./src/stm32f7xx_hal_eth.c ****   }
 573:./src/stm32f7xx_hal_eth.c ****   
 574:./src/stm32f7xx_hal_eth.c ****   /* Set Transmit Descriptor List Address Register */
 575:./src/stm32f7xx_hal_eth.c ****   (heth->Instance)->DMATDLAR = (uint32_t) DMATxDescTab;
 576:./src/stm32f7xx_hal_eth.c ****   
 577:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to Ready */
 578:./src/stm32f7xx_hal_eth.c ****   heth->State= HAL_ETH_STATE_READY;
 579:./src/stm32f7xx_hal_eth.c ****   
 580:./src/stm32f7xx_hal_eth.c ****   /* Process Unlocked */
 581:./src/stm32f7xx_hal_eth.c ****   __HAL_UNLOCK(heth);
 582:./src/stm32f7xx_hal_eth.c ****   
 583:./src/stm32f7xx_hal_eth.c ****   /* Return function status */
 584:./src/stm32f7xx_hal_eth.c ****   return HAL_OK;

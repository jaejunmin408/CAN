1527:./src/stm32f7xx_hal_eth.c ****   
1528:./src/stm32f7xx_hal_eth.c ****   /* Return function status */
1529:./src/stm32f7xx_hal_eth.c ****   return HAL_OK;
1530:./src/stm32f7xx_hal_eth.c **** }

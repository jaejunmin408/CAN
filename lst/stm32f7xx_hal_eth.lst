 596:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_DMARxDescListInit(ETH_HandleTypeDef *heth, ETH_DMADescTypeDef *DMARxDescT
 597:./src/stm32f7xx_hal_eth.c **** {
 598:./src/stm32f7xx_hal_eth.c ****   uint32_t i = 0;
 599:./src/stm32f7xx_hal_eth.c ****   ETH_DMADescTypeDef *DMARxDesc;
 600:./src/stm32f7xx_hal_eth.c ****   

 186:./src/stm32f7xx_hal_eth.c **** /** @defgroup ETH_Exported_Functions_Group1 Initialization and de-initialization functions 
 187:./src/stm32f7xx_hal_eth.c ****   *  @brief   Initialization and Configuration functions 
 188:./src/stm32f7xx_hal_eth.c ****   *
 189:./src/stm32f7xx_hal_eth.c ****   @verbatim    
 190:./src/stm32f7xx_hal_eth.c ****   ===============================================================================
 191:./src/stm32f7xx_hal_eth.c ****             ##### Initialization and de-initialization functions #####
 192:./src/stm32f7xx_hal_eth.c ****   ===============================================================================
 193:./src/stm32f7xx_hal_eth.c ****   [..]  This section provides functions allowing to:
 194:./src/stm32f7xx_hal_eth.c ****       (+) Initialize and configure the Ethernet peripheral
 195:./src/stm32f7xx_hal_eth.c ****       (+) De-initialize the Ethernet peripheral
 196:./src/stm32f7xx_hal_eth.c **** 
 197:./src/stm32f7xx_hal_eth.c ****   @endverbatim
 198:./src/stm32f7xx_hal_eth.c ****   * @{
 199:./src/stm32f7xx_hal_eth.c ****   */
 200:./src/stm32f7xx_hal_eth.c **** 
 201:./src/stm32f7xx_hal_eth.c **** /**
 202:./src/stm32f7xx_hal_eth.c ****   * @brief  Initializes the Ethernet MAC and DMA according to default
 203:./src/stm32f7xx_hal_eth.c ****   *         parameters.
 204:./src/stm32f7xx_hal_eth.c ****   * @param  heth pointer to a ETH_HandleTypeDef structure that contains
 205:./src/stm32f7xx_hal_eth.c ****   *         the configuration information for ETHERNET module
 206:./src/stm32f7xx_hal_eth.c ****   * @retval HAL status
 207:./src/stm32f7xx_hal_eth.c ****   */
 208:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_Init(ETH_HandleTypeDef *heth)
 209:./src/stm32f7xx_hal_eth.c **** {
 210:./src/stm32f7xx_hal_eth.c ****   uint32_t tempreg = 0, phyreg = 0;
 211:./src/stm32f7xx_hal_eth.c ****   uint32_t hclk = 60000000;
 212:./src/stm32f7xx_hal_eth.c ****   uint32_t tickstart = 0;
 213:./src/stm32f7xx_hal_eth.c ****   uint32_t err = ETH_SUCCESS;
 214:./src/stm32f7xx_hal_eth.c ****   
 215:./src/stm32f7xx_hal_eth.c ****   /* Check the ETH peripheral state */
 216:./src/stm32f7xx_hal_eth.c ****   if(heth == NULL)
 217:./src/stm32f7xx_hal_eth.c ****   {
 218:./src/stm32f7xx_hal_eth.c ****     return HAL_ERROR;
 219:./src/stm32f7xx_hal_eth.c ****   }
 220:./src/stm32f7xx_hal_eth.c ****   
 221:./src/stm32f7xx_hal_eth.c ****   /* Check parameters */
 222:./src/stm32f7xx_hal_eth.c ****   assert_param(IS_ETH_AUTONEGOTIATION(heth->Init.AutoNegotiation));
 223:./src/stm32f7xx_hal_eth.c ****   assert_param(IS_ETH_RX_MODE(heth->Init.RxMode));
 224:./src/stm32f7xx_hal_eth.c ****   assert_param(IS_ETH_CHECKSUM_MODE(heth->Init.ChecksumMode));
 225:./src/stm32f7xx_hal_eth.c ****   assert_param(IS_ETH_MEDIA_INTERFACE(heth->Init.MediaInterface));  
 226:./src/stm32f7xx_hal_eth.c ****   
 227:./src/stm32f7xx_hal_eth.c ****   if(heth->State == HAL_ETH_STATE_RESET)
 228:./src/stm32f7xx_hal_eth.c ****   {
 229:./src/stm32f7xx_hal_eth.c ****     /* Allocate lock resource and initialize it */
 230:./src/stm32f7xx_hal_eth.c ****     heth->Lock = HAL_UNLOCKED;
 231:./src/stm32f7xx_hal_eth.c **** #if (USE_HAL_ETH_REGISTER_CALLBACKS == 1)
 232:./src/stm32f7xx_hal_eth.c ****     ETH_InitCallbacksToDefault(heth);
 233:./src/stm32f7xx_hal_eth.c **** 
 234:./src/stm32f7xx_hal_eth.c ****     if(heth->MspInitCallback == NULL)
 235:./src/stm32f7xx_hal_eth.c ****     {
 236:./src/stm32f7xx_hal_eth.c ****       /* Init the low level hardware : GPIO, CLOCK, NVIC. */
 237:./src/stm32f7xx_hal_eth.c ****       heth->MspInitCallback = HAL_ETH_MspInit;
 238:./src/stm32f7xx_hal_eth.c ****     }
 239:./src/stm32f7xx_hal_eth.c ****     heth->MspInitCallback(heth);
 240:./src/stm32f7xx_hal_eth.c **** 
 241:./src/stm32f7xx_hal_eth.c **** #else
 242:./src/stm32f7xx_hal_eth.c ****     /* Init the low level hardware : GPIO, CLOCK, NVIC. */
 243:./src/stm32f7xx_hal_eth.c ****     HAL_ETH_MspInit(heth);
 244:./src/stm32f7xx_hal_eth.c **** #endif /* USE_HAL_ETH_REGISTER_CALLBACKS */
 245:./src/stm32f7xx_hal_eth.c ****   }
 246:./src/stm32f7xx_hal_eth.c ****   
 247:./src/stm32f7xx_hal_eth.c ****   /* Enable SYSCFG Clock */
 248:./src/stm32f7xx_hal_eth.c ****   __HAL_RCC_SYSCFG_CLK_ENABLE();
 249:./src/stm32f7xx_hal_eth.c ****   
 250:./src/stm32f7xx_hal_eth.c ****   /* Select MII or RMII Mode*/
 251:./src/stm32f7xx_hal_eth.c ****   SYSCFG->PMC &= ~(SYSCFG_PMC_MII_RMII_SEL);
 252:./src/stm32f7xx_hal_eth.c ****   SYSCFG->PMC |= (uint32_t)heth->Init.MediaInterface;
 253:./src/stm32f7xx_hal_eth.c ****   
 254:./src/stm32f7xx_hal_eth.c ****   /* Ethernet Software reset */
 255:./src/stm32f7xx_hal_eth.c ****   /* Set the SWR bit: resets all MAC subsystem internal registers and logic */
 256:./src/stm32f7xx_hal_eth.c ****   /* After reset all the registers holds their respective reset values */
 257:./src/stm32f7xx_hal_eth.c ****   (heth->Instance)->DMABMR |= ETH_DMABMR_SR;
 258:./src/stm32f7xx_hal_eth.c ****   
 259:./src/stm32f7xx_hal_eth.c ****   /* Get tick */
 260:./src/stm32f7xx_hal_eth.c ****   tickstart = HAL_GetTick();
 261:./src/stm32f7xx_hal_eth.c ****   
 262:./src/stm32f7xx_hal_eth.c ****   /* Wait for software reset */
 263:./src/stm32f7xx_hal_eth.c ****   while (((heth->Instance)->DMABMR & ETH_DMABMR_SR) != (uint32_t)RESET)
 264:./src/stm32f7xx_hal_eth.c ****   {
 265:./src/stm32f7xx_hal_eth.c ****     /* Check for the Timeout */
 266:./src/stm32f7xx_hal_eth.c ****     if((HAL_GetTick() - tickstart ) > ETH_TIMEOUT_SWRESET)
 267:./src/stm32f7xx_hal_eth.c ****     {     
 268:./src/stm32f7xx_hal_eth.c ****       heth->State= HAL_ETH_STATE_TIMEOUT;
 269:./src/stm32f7xx_hal_eth.c ****   
 270:./src/stm32f7xx_hal_eth.c ****       /* Process Unlocked */
 271:./src/stm32f7xx_hal_eth.c ****       __HAL_UNLOCK(heth);
 272:./src/stm32f7xx_hal_eth.c ****     
 273:./src/stm32f7xx_hal_eth.c ****       /* Note: The SWR is not performed if the ETH_RX_CLK or the ETH_TX_CLK are  
 274:./src/stm32f7xx_hal_eth.c ****          not available, please check your external PHY or the IO configuration */
 275:./src/stm32f7xx_hal_eth.c ****                
 276:./src/stm32f7xx_hal_eth.c ****       return HAL_TIMEOUT;
 277:./src/stm32f7xx_hal_eth.c ****     }
 278:./src/stm32f7xx_hal_eth.c ****   }
 279:./src/stm32f7xx_hal_eth.c ****   
 280:./src/stm32f7xx_hal_eth.c ****   /*-------------------------------- MAC Initialization ----------------------*/
 281:./src/stm32f7xx_hal_eth.c ****   /* Get the ETHERNET MACMIIAR value */
 282:./src/stm32f7xx_hal_eth.c ****   tempreg = (heth->Instance)->MACMIIAR;
 283:./src/stm32f7xx_hal_eth.c ****   /* Clear CSR Clock Range CR[2:0] bits */
 284:./src/stm32f7xx_hal_eth.c ****   tempreg &= ETH_MACMIIAR_CR_MASK;
 285:./src/stm32f7xx_hal_eth.c ****   
 286:./src/stm32f7xx_hal_eth.c ****   /* Get hclk frequency value */
 287:./src/stm32f7xx_hal_eth.c ****   hclk = HAL_RCC_GetHCLKFreq();
 288:./src/stm32f7xx_hal_eth.c ****   
 289:./src/stm32f7xx_hal_eth.c ****   /* Set CR bits depending on hclk value */
 290:./src/stm32f7xx_hal_eth.c ****   if((hclk >= 20000000)&&(hclk < 35000000))
 291:./src/stm32f7xx_hal_eth.c ****   {
 292:./src/stm32f7xx_hal_eth.c ****     /* CSR Clock Range between 20-35 MHz */
 293:./src/stm32f7xx_hal_eth.c ****     tempreg |= (uint32_t)ETH_MACMIIAR_CR_Div16;
 294:./src/stm32f7xx_hal_eth.c ****   }
 295:./src/stm32f7xx_hal_eth.c ****   else if((hclk >= 35000000)&&(hclk < 60000000))
 296:./src/stm32f7xx_hal_eth.c ****   {
 297:./src/stm32f7xx_hal_eth.c ****     /* CSR Clock Range between 35-60 MHz */ 
 298:./src/stm32f7xx_hal_eth.c ****     tempreg |= (uint32_t)ETH_MACMIIAR_CR_Div26;
 299:./src/stm32f7xx_hal_eth.c ****   }  
 300:./src/stm32f7xx_hal_eth.c ****   else if((hclk >= 60000000)&&(hclk < 100000000))
 301:./src/stm32f7xx_hal_eth.c ****   {
 302:./src/stm32f7xx_hal_eth.c ****     /* CSR Clock Range between 60-100 MHz */ 
 303:./src/stm32f7xx_hal_eth.c ****     tempreg |= (uint32_t)ETH_MACMIIAR_CR_Div42;
 304:./src/stm32f7xx_hal_eth.c ****   }  
 305:./src/stm32f7xx_hal_eth.c ****   else if((hclk >= 100000000)&&(hclk < 150000000))
 306:./src/stm32f7xx_hal_eth.c ****   {
 307:./src/stm32f7xx_hal_eth.c ****     /* CSR Clock Range between 100-150 MHz */ 
 308:./src/stm32f7xx_hal_eth.c ****     tempreg |= (uint32_t)ETH_MACMIIAR_CR_Div62;
 309:./src/stm32f7xx_hal_eth.c ****   }
 310:./src/stm32f7xx_hal_eth.c ****   else /* ((hclk >= 150000000)&&(hclk <= 216000000)) */
 311:./src/stm32f7xx_hal_eth.c ****   {
 312:./src/stm32f7xx_hal_eth.c ****     /* CSR Clock Range between 150-216 MHz */ 
 313:./src/stm32f7xx_hal_eth.c ****     tempreg |= (uint32_t)ETH_MACMIIAR_CR_Div102;    
 314:./src/stm32f7xx_hal_eth.c ****   }
 315:./src/stm32f7xx_hal_eth.c ****   
 316:./src/stm32f7xx_hal_eth.c ****   /* Write to ETHERNET MAC MIIAR: Configure the ETHERNET CSR Clock Range */
 317:./src/stm32f7xx_hal_eth.c ****   (heth->Instance)->MACMIIAR = (uint32_t)tempreg;
 318:./src/stm32f7xx_hal_eth.c ****   
 319:./src/stm32f7xx_hal_eth.c ****   /*-------------------- PHY initialization and configuration ----------------*/
 320:./src/stm32f7xx_hal_eth.c ****   /* Put the PHY in reset mode */
 321:./src/stm32f7xx_hal_eth.c ****   if((HAL_ETH_WritePHYRegister(heth, PHY_BCR, PHY_RESET)) != HAL_OK)
 322:./src/stm32f7xx_hal_eth.c ****   {
 323:./src/stm32f7xx_hal_eth.c ****     /* In case of write timeout */
 324:./src/stm32f7xx_hal_eth.c ****     err = ETH_ERROR;
 325:./src/stm32f7xx_hal_eth.c ****     
 326:./src/stm32f7xx_hal_eth.c ****     /* Config MAC and DMA */
 327:./src/stm32f7xx_hal_eth.c ****     ETH_MACDMAConfig(heth, err);
 328:./src/stm32f7xx_hal_eth.c ****     
 329:./src/stm32f7xx_hal_eth.c ****     /* Set the ETH peripheral state to READY */
 330:./src/stm32f7xx_hal_eth.c ****     heth->State = HAL_ETH_STATE_READY;
 331:./src/stm32f7xx_hal_eth.c ****     
 332:./src/stm32f7xx_hal_eth.c ****     /* Return HAL_ERROR */
 333:./src/stm32f7xx_hal_eth.c ****     return HAL_ERROR;
 334:./src/stm32f7xx_hal_eth.c ****   }
 335:./src/stm32f7xx_hal_eth.c ****   
 336:./src/stm32f7xx_hal_eth.c ****   /* Delay to assure PHY reset */
 337:./src/stm32f7xx_hal_eth.c ****   HAL_Delay(PHY_RESET_DELAY);
 338:./src/stm32f7xx_hal_eth.c ****   
 339:./src/stm32f7xx_hal_eth.c ****   if((heth->Init).AutoNegotiation != ETH_AUTONEGOTIATION_DISABLE)
 340:./src/stm32f7xx_hal_eth.c ****   {
 341:./src/stm32f7xx_hal_eth.c ****     /* Get tick */
 342:./src/stm32f7xx_hal_eth.c ****     tickstart = HAL_GetTick();
 343:./src/stm32f7xx_hal_eth.c ****     
 344:./src/stm32f7xx_hal_eth.c ****     /* We wait for linked status */
 345:./src/stm32f7xx_hal_eth.c ****     do
 346:./src/stm32f7xx_hal_eth.c ****     {
 347:./src/stm32f7xx_hal_eth.c ****       HAL_ETH_ReadPHYRegister(heth, PHY_BSR, &phyreg);
 348:./src/stm32f7xx_hal_eth.c ****       
 349:./src/stm32f7xx_hal_eth.c ****       /* Check for the Timeout */
 350:./src/stm32f7xx_hal_eth.c ****       if((HAL_GetTick() - tickstart ) > ETH_TIMEOUT_LINKED_STATE)
 351:./src/stm32f7xx_hal_eth.c ****       {
 352:./src/stm32f7xx_hal_eth.c ****         /* In case of write timeout */
 353:./src/stm32f7xx_hal_eth.c ****         err = ETH_ERROR;
 354:./src/stm32f7xx_hal_eth.c ****       
 355:./src/stm32f7xx_hal_eth.c ****         /* Config MAC and DMA */
 356:./src/stm32f7xx_hal_eth.c ****         ETH_MACDMAConfig(heth, err);
 357:./src/stm32f7xx_hal_eth.c ****         
 358:./src/stm32f7xx_hal_eth.c ****         heth->State= HAL_ETH_STATE_READY;
 359:./src/stm32f7xx_hal_eth.c ****   
 360:./src/stm32f7xx_hal_eth.c ****         /* Process Unlocked */
 361:./src/stm32f7xx_hal_eth.c ****         __HAL_UNLOCK(heth);
 362:./src/stm32f7xx_hal_eth.c ****     
 363:./src/stm32f7xx_hal_eth.c ****         return HAL_TIMEOUT;
 364:./src/stm32f7xx_hal_eth.c ****       }
 365:./src/stm32f7xx_hal_eth.c ****     } while (((phyreg & PHY_LINKED_STATUS) != PHY_LINKED_STATUS));
 366:./src/stm32f7xx_hal_eth.c **** 
 367:./src/stm32f7xx_hal_eth.c ****     
 368:./src/stm32f7xx_hal_eth.c ****     /* Enable Auto-Negotiation */
 369:./src/stm32f7xx_hal_eth.c ****     if((HAL_ETH_WritePHYRegister(heth, PHY_BCR, PHY_AUTONEGOTIATION)) != HAL_OK)
 370:./src/stm32f7xx_hal_eth.c ****     {
 371:./src/stm32f7xx_hal_eth.c ****       /* In case of write timeout */
 372:./src/stm32f7xx_hal_eth.c ****       err = ETH_ERROR;
 373:./src/stm32f7xx_hal_eth.c ****       
 374:./src/stm32f7xx_hal_eth.c ****       /* Config MAC and DMA */
 375:./src/stm32f7xx_hal_eth.c ****       ETH_MACDMAConfig(heth, err);
 376:./src/stm32f7xx_hal_eth.c ****       
 377:./src/stm32f7xx_hal_eth.c ****       /* Set the ETH peripheral state to READY */
 378:./src/stm32f7xx_hal_eth.c ****       heth->State = HAL_ETH_STATE_READY;
 379:./src/stm32f7xx_hal_eth.c ****       
 380:./src/stm32f7xx_hal_eth.c ****       /* Return HAL_ERROR */
 381:./src/stm32f7xx_hal_eth.c ****       return HAL_ERROR;   
 382:./src/stm32f7xx_hal_eth.c ****     }
 383:./src/stm32f7xx_hal_eth.c ****     
 384:./src/stm32f7xx_hal_eth.c ****     /* Get tick */
 385:./src/stm32f7xx_hal_eth.c ****     tickstart = HAL_GetTick();
 386:./src/stm32f7xx_hal_eth.c ****     
 387:./src/stm32f7xx_hal_eth.c ****     /* Wait until the auto-negotiation will be completed */
 388:./src/stm32f7xx_hal_eth.c ****     do
 389:./src/stm32f7xx_hal_eth.c ****     {
 390:./src/stm32f7xx_hal_eth.c ****       HAL_ETH_ReadPHYRegister(heth, PHY_BSR, &phyreg);
 391:./src/stm32f7xx_hal_eth.c ****       
 392:./src/stm32f7xx_hal_eth.c ****       /* Check for the Timeout */
 393:./src/stm32f7xx_hal_eth.c ****       if((HAL_GetTick() - tickstart ) > ETH_TIMEOUT_AUTONEGO_COMPLETED)
 394:./src/stm32f7xx_hal_eth.c ****       {
 395:./src/stm32f7xx_hal_eth.c ****         /* In case of write timeout */
 396:./src/stm32f7xx_hal_eth.c ****         err = ETH_ERROR;
 397:./src/stm32f7xx_hal_eth.c ****       
 398:./src/stm32f7xx_hal_eth.c ****         /* Config MAC and DMA */
 399:./src/stm32f7xx_hal_eth.c ****         ETH_MACDMAConfig(heth, err);
 400:./src/stm32f7xx_hal_eth.c ****         
 401:./src/stm32f7xx_hal_eth.c ****         heth->State= HAL_ETH_STATE_READY;
 402:./src/stm32f7xx_hal_eth.c ****   
 403:./src/stm32f7xx_hal_eth.c ****         /* Process Unlocked */
 404:./src/stm32f7xx_hal_eth.c ****         __HAL_UNLOCK(heth);
 405:./src/stm32f7xx_hal_eth.c ****     
 406:./src/stm32f7xx_hal_eth.c ****         return HAL_TIMEOUT;
 407:./src/stm32f7xx_hal_eth.c ****       }
 408:./src/stm32f7xx_hal_eth.c ****       
 409:./src/stm32f7xx_hal_eth.c ****     } while (((phyreg & PHY_AUTONEGO_COMPLETE) != PHY_AUTONEGO_COMPLETE));
 410:./src/stm32f7xx_hal_eth.c ****     
 411:./src/stm32f7xx_hal_eth.c ****     /* Read the result of the auto-negotiation */
 412:./src/stm32f7xx_hal_eth.c ****     if((HAL_ETH_ReadPHYRegister(heth, PHY_SR, &phyreg)) != HAL_OK)
 413:./src/stm32f7xx_hal_eth.c ****     {
 414:./src/stm32f7xx_hal_eth.c ****       /* In case of write timeout */
 415:./src/stm32f7xx_hal_eth.c ****       err = ETH_ERROR;
 416:./src/stm32f7xx_hal_eth.c ****       
 417:./src/stm32f7xx_hal_eth.c ****       /* Config MAC and DMA */
 418:./src/stm32f7xx_hal_eth.c ****       ETH_MACDMAConfig(heth, err);
 419:./src/stm32f7xx_hal_eth.c ****       
 420:./src/stm32f7xx_hal_eth.c ****       /* Set the ETH peripheral state to READY */
 421:./src/stm32f7xx_hal_eth.c ****       heth->State = HAL_ETH_STATE_READY;
 422:./src/stm32f7xx_hal_eth.c ****       
 423:./src/stm32f7xx_hal_eth.c ****       /* Return HAL_ERROR */
 424:./src/stm32f7xx_hal_eth.c ****       return HAL_ERROR;   
 425:./src/stm32f7xx_hal_eth.c ****     }
 426:./src/stm32f7xx_hal_eth.c ****     
 427:./src/stm32f7xx_hal_eth.c ****     /* Configure the MAC with the Duplex Mode fixed by the auto-negotiation process */
 428:./src/stm32f7xx_hal_eth.c ****     if((phyreg & PHY_DUPLEX_STATUS) != (uint32_t)RESET)
 429:./src/stm32f7xx_hal_eth.c ****     {
 430:./src/stm32f7xx_hal_eth.c ****       /* Set Ethernet duplex mode to Full-duplex following the auto-negotiation */
 431:./src/stm32f7xx_hal_eth.c ****       (heth->Init).DuplexMode = ETH_MODE_FULLDUPLEX;  
 432:./src/stm32f7xx_hal_eth.c ****     }
 433:./src/stm32f7xx_hal_eth.c ****     else
 434:./src/stm32f7xx_hal_eth.c ****     {
 435:./src/stm32f7xx_hal_eth.c ****       /* Set Ethernet duplex mode to Half-duplex following the auto-negotiation */
 436:./src/stm32f7xx_hal_eth.c ****       (heth->Init).DuplexMode = ETH_MODE_HALFDUPLEX;           
 437:./src/stm32f7xx_hal_eth.c ****     }
 438:./src/stm32f7xx_hal_eth.c ****     /* Configure the MAC with the speed fixed by the auto-negotiation process */
 439:./src/stm32f7xx_hal_eth.c ****     if((phyreg & PHY_SPEED_STATUS) == PHY_SPEED_STATUS)
 440:./src/stm32f7xx_hal_eth.c ****     {  
 441:./src/stm32f7xx_hal_eth.c ****       /* Set Ethernet speed to 10M following the auto-negotiation */
 442:./src/stm32f7xx_hal_eth.c ****       (heth->Init).Speed = ETH_SPEED_10M; 
 443:./src/stm32f7xx_hal_eth.c ****     }
 444:./src/stm32f7xx_hal_eth.c ****     else
 445:./src/stm32f7xx_hal_eth.c ****     {   
 446:./src/stm32f7xx_hal_eth.c ****       /* Set Ethernet speed to 100M following the auto-negotiation */ 
 447:./src/stm32f7xx_hal_eth.c ****       (heth->Init).Speed = ETH_SPEED_100M;
 448:./src/stm32f7xx_hal_eth.c ****     }
 449:./src/stm32f7xx_hal_eth.c ****   }
 450:./src/stm32f7xx_hal_eth.c ****   else /* AutoNegotiation Disable */
 451:./src/stm32f7xx_hal_eth.c ****   {
 452:./src/stm32f7xx_hal_eth.c ****     /* Check parameters */
 453:./src/stm32f7xx_hal_eth.c ****     assert_param(IS_ETH_SPEED(heth->Init.Speed));

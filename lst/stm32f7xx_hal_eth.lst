1415:./src/stm32f7xx_hal_eth.c ****     
1416:./src/stm32f7xx_hal_eth.c ****       return HAL_TIMEOUT;
1417:./src/stm32f7xx_hal_eth.c ****     }
1418:./src/stm32f7xx_hal_eth.c ****     
1419:./src/stm32f7xx_hal_eth.c ****     tmpreg = heth->Instance->MACMIIAR;
1420:./src/stm32f7xx_hal_eth.c ****   }
1421:./src/stm32f7xx_hal_eth.c ****   
1422:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to READY */
1423:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_READY;
1424:./src/stm32f7xx_hal_eth.c ****   

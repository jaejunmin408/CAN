 461:./src/stm32f7xx_hal_eth.c ****       err = ETH_ERROR;
 462:./src/stm32f7xx_hal_eth.c ****       
 463:./src/stm32f7xx_hal_eth.c ****       /* Config MAC and DMA */
 464:./src/stm32f7xx_hal_eth.c ****       ETH_MACDMAConfig(heth, err);
 465:./src/stm32f7xx_hal_eth.c ****       
 466:./src/stm32f7xx_hal_eth.c ****       /* Set the ETH peripheral state to READY */
 467:./src/stm32f7xx_hal_eth.c ****       heth->State = HAL_ETH_STATE_READY;
 468:./src/stm32f7xx_hal_eth.c ****       
 469:./src/stm32f7xx_hal_eth.c ****       /* Return HAL_ERROR */
 470:./src/stm32f7xx_hal_eth.c ****       return HAL_ERROR;
 471:./src/stm32f7xx_hal_eth.c ****     }  
 472:./src/stm32f7xx_hal_eth.c ****     
 473:./src/stm32f7xx_hal_eth.c ****     /* Delay to assure PHY configuration */
 474:./src/stm32f7xx_hal_eth.c ****     HAL_Delay(PHY_CONFIG_DELAY);
 475:./src/stm32f7xx_hal_eth.c ****   }
 476:./src/stm32f7xx_hal_eth.c ****   
 477:./src/stm32f7xx_hal_eth.c ****   /* Config MAC and DMA */
 478:./src/stm32f7xx_hal_eth.c ****   ETH_MACDMAConfig(heth, err);

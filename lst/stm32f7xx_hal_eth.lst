1365:./src/stm32f7xx_hal_eth.c ****   * @param  RegValue the value to write
1366:./src/stm32f7xx_hal_eth.c ****   * @retval HAL status
1367:./src/stm32f7xx_hal_eth.c ****   */
1368:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_WritePHYRegister(ETH_HandleTypeDef *heth, uint16_t PHYReg, uint32_t RegVa

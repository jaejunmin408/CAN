 608:./src/stm32f7xx_hal_eth.c ****   heth->RxDesc = DMARxDescTab; 
 609:./src/stm32f7xx_hal_eth.c ****   
 610:./src/stm32f7xx_hal_eth.c ****   /* Fill each DMARxDesc descriptor with the right values */
 611:./src/stm32f7xx_hal_eth.c ****   for(i=0; i < RxBuffCount; i++)
 612:./src/stm32f7xx_hal_eth.c ****   {
 613:./src/stm32f7xx_hal_eth.c ****     /* Get the pointer on the ith member of the Rx Desc list */
 614:./src/stm32f7xx_hal_eth.c ****     DMARxDesc = DMARxDescTab+i;
 615:./src/stm32f7xx_hal_eth.c ****     
 616:./src/stm32f7xx_hal_eth.c ****     /* Set Own bit of the Rx descriptor Status */
 617:./src/stm32f7xx_hal_eth.c ****     DMARxDesc->Status = ETH_DMARXDESC_OWN;
 618:./src/stm32f7xx_hal_eth.c ****     
 619:./src/stm32f7xx_hal_eth.c ****     /* Set Buffer1 size and Second Address Chained bit */
 620:./src/stm32f7xx_hal_eth.c ****     DMARxDesc->ControlBufferSize = ETH_DMARXDESC_RCH | ETH_RX_BUF_SIZE;  
 621:./src/stm32f7xx_hal_eth.c ****     
 622:./src/stm32f7xx_hal_eth.c ****     /* Set Buffer1 address pointer */
 623:./src/stm32f7xx_hal_eth.c ****     DMARxDesc->Buffer1Addr = (uint32_t)(&RxBuff[i*ETH_RX_BUF_SIZE]);
 624:./src/stm32f7xx_hal_eth.c ****     
 625:./src/stm32f7xx_hal_eth.c ****     if((heth->Init).RxMode == ETH_RXINTERRUPT_MODE)
 626:./src/stm32f7xx_hal_eth.c ****     {
 627:./src/stm32f7xx_hal_eth.c ****       /* Enable Ethernet DMA Rx Descriptor interrupt */
 628:./src/stm32f7xx_hal_eth.c ****       DMARxDesc->ControlBufferSize &= ~ETH_DMARXDESC_DIC;
 629:./src/stm32f7xx_hal_eth.c ****     }

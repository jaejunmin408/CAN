1484:./src/stm32f7xx_hal_eth.c ****   heth->State= HAL_ETH_STATE_READY;
1485:./src/stm32f7xx_hal_eth.c ****   
1486:./src/stm32f7xx_hal_eth.c ****   /* Process Unlocked */
1487:./src/stm32f7xx_hal_eth.c ****   __HAL_UNLOCK(heth);
1488:./src/stm32f7xx_hal_eth.c ****   
1489:./src/stm32f7xx_hal_eth.c ****   /* Return function status */
1490:./src/stm32f7xx_hal_eth.c ****   return HAL_OK;
1491:./src/stm32f7xx_hal_eth.c **** }
1492:./src/stm32f7xx_hal_eth.c **** 
1493:./src/stm32f7xx_hal_eth.c **** /**
1494:./src/stm32f7xx_hal_eth.c ****   * @brief  Stop Ethernet MAC and DMA reception/transmission 
1495:./src/stm32f7xx_hal_eth.c ****   * @param  heth pointer to a ETH_HandleTypeDef structure that contains
1496:./src/stm32f7xx_hal_eth.c ****   *         the configuration information for ETHERNET module

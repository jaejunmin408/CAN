 883:./src/stm32f7xx_hal_eth.c **** /**
 884:./src/stm32f7xx_hal_eth.c ****   * @brief  Sends an Ethernet frame. 
 885:./src/stm32f7xx_hal_eth.c ****   * @param  heth pointer to a ETH_HandleTypeDef structure that contains
 886:./src/stm32f7xx_hal_eth.c ****   *         the configuration information for ETHERNET module
 887:./src/stm32f7xx_hal_eth.c ****   * @param  FrameLength Amount of data to be sent
 888:./src/stm32f7xx_hal_eth.c ****   * @retval HAL status
 889:./src/stm32f7xx_hal_eth.c ****   */
 890:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_TransmitFrame(ETH_HandleTypeDef *heth, uint32_t FrameLength)
 891:./src/stm32f7xx_hal_eth.c **** {
 892:./src/stm32f7xx_hal_eth.c ****   uint32_t bufcount = 0, size = 0, i = 0;
 893:./src/stm32f7xx_hal_eth.c ****   
 894:./src/stm32f7xx_hal_eth.c ****   /* Process Locked */
 895:./src/stm32f7xx_hal_eth.c ****   __HAL_LOCK(heth);
 896:./src/stm32f7xx_hal_eth.c ****   
 897:./src/stm32f7xx_hal_eth.c ****   /* Set the ETH peripheral state to BUSY */
 898:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_BUSY;
 899:./src/stm32f7xx_hal_eth.c ****   
 900:./src/stm32f7xx_hal_eth.c ****   if (FrameLength == 0) 
 901:./src/stm32f7xx_hal_eth.c ****   {
 902:./src/stm32f7xx_hal_eth.c ****     /* Set ETH HAL state to READY */
 903:./src/stm32f7xx_hal_eth.c ****     heth->State = HAL_ETH_STATE_READY;
 904:./src/stm32f7xx_hal_eth.c ****     
 905:./src/stm32f7xx_hal_eth.c ****     /* Process Unlocked */
 906:./src/stm32f7xx_hal_eth.c ****     __HAL_UNLOCK(heth);
 907:./src/stm32f7xx_hal_eth.c ****     
 908:./src/stm32f7xx_hal_eth.c ****     return  HAL_ERROR;                                    
 909:./src/stm32f7xx_hal_eth.c ****   }  
 910:./src/stm32f7xx_hal_eth.c ****   
 911:./src/stm32f7xx_hal_eth.c ****   /* Check if the descriptor is owned by the ETHERNET DMA (when set) or CPU (when reset) */
 912:./src/stm32f7xx_hal_eth.c ****   if(((heth->TxDesc)->Status & ETH_DMATXDESC_OWN) != (uint32_t)RESET)
 913:./src/stm32f7xx_hal_eth.c ****   {  
 914:./src/stm32f7xx_hal_eth.c ****     /* OWN bit set */
 915:./src/stm32f7xx_hal_eth.c ****     heth->State = HAL_ETH_STATE_BUSY_TX;
 916:./src/stm32f7xx_hal_eth.c ****     
 917:./src/stm32f7xx_hal_eth.c ****     /* Process Unlocked */
 918:./src/stm32f7xx_hal_eth.c ****     __HAL_UNLOCK(heth);
 919:./src/stm32f7xx_hal_eth.c ****     
 920:./src/stm32f7xx_hal_eth.c ****     return HAL_ERROR;
 921:./src/stm32f7xx_hal_eth.c ****   }
 922:./src/stm32f7xx_hal_eth.c ****   
 923:./src/stm32f7xx_hal_eth.c ****   /* Get the number of needed Tx buffers for the current frame */
 924:./src/stm32f7xx_hal_eth.c ****   if (FrameLength > ETH_TX_BUF_SIZE)
 925:./src/stm32f7xx_hal_eth.c ****   {
 926:./src/stm32f7xx_hal_eth.c ****     bufcount = FrameLength/ETH_TX_BUF_SIZE;
 927:./src/stm32f7xx_hal_eth.c ****     if (FrameLength % ETH_TX_BUF_SIZE) 
 928:./src/stm32f7xx_hal_eth.c ****     {
 929:./src/stm32f7xx_hal_eth.c ****       bufcount++;
 930:./src/stm32f7xx_hal_eth.c ****     }
 931:./src/stm32f7xx_hal_eth.c ****   }
 932:./src/stm32f7xx_hal_eth.c ****   else 
 933:./src/stm32f7xx_hal_eth.c ****   {  
 934:./src/stm32f7xx_hal_eth.c ****     bufcount = 1;
 935:./src/stm32f7xx_hal_eth.c ****   }
 936:./src/stm32f7xx_hal_eth.c ****   if (bufcount == 1)
 937:./src/stm32f7xx_hal_eth.c ****   {
 938:./src/stm32f7xx_hal_eth.c ****     /* Set LAST and FIRST segment */
 939:./src/stm32f7xx_hal_eth.c ****     heth->TxDesc->Status |=ETH_DMATXDESC_FS|ETH_DMATXDESC_LS;
 940:./src/stm32f7xx_hal_eth.c ****     /* Set frame size */
 941:./src/stm32f7xx_hal_eth.c ****     heth->TxDesc->ControlBufferSize = (FrameLength & ETH_DMATXDESC_TBS1);
 942:./src/stm32f7xx_hal_eth.c ****     /* Set Own bit of the Tx descriptor Status: gives the buffer back to ETHERNET DMA */
 943:./src/stm32f7xx_hal_eth.c ****     heth->TxDesc->Status |= ETH_DMATXDESC_OWN;
 944:./src/stm32f7xx_hal_eth.c ****     /* Point to next descriptor */
 945:./src/stm32f7xx_hal_eth.c ****     heth->TxDesc= (ETH_DMADescTypeDef *)(heth->TxDesc->Buffer2NextDescAddr);
 946:./src/stm32f7xx_hal_eth.c ****   }
 947:./src/stm32f7xx_hal_eth.c ****   else
 948:./src/stm32f7xx_hal_eth.c ****   {
 949:./src/stm32f7xx_hal_eth.c ****     for (i=0; i< bufcount; i++)
 950:./src/stm32f7xx_hal_eth.c ****     {
 951:./src/stm32f7xx_hal_eth.c ****       /* Clear FIRST and LAST segment bits */
 952:./src/stm32f7xx_hal_eth.c ****       heth->TxDesc->Status &= ~(ETH_DMATXDESC_FS | ETH_DMATXDESC_LS);
 953:./src/stm32f7xx_hal_eth.c ****       
 954:./src/stm32f7xx_hal_eth.c ****       if (i == 0) 
 955:./src/stm32f7xx_hal_eth.c ****       {
 956:./src/stm32f7xx_hal_eth.c ****         /* Setting the first segment bit */
 957:./src/stm32f7xx_hal_eth.c ****         heth->TxDesc->Status |= ETH_DMATXDESC_FS;  
 958:./src/stm32f7xx_hal_eth.c ****       }
 959:./src/stm32f7xx_hal_eth.c ****       
 960:./src/stm32f7xx_hal_eth.c ****       /* Program size */
 961:./src/stm32f7xx_hal_eth.c ****       heth->TxDesc->ControlBufferSize = (ETH_TX_BUF_SIZE & ETH_DMATXDESC_TBS1);
 962:./src/stm32f7xx_hal_eth.c ****       
 963:./src/stm32f7xx_hal_eth.c ****       if (i == (bufcount-1))
 964:./src/stm32f7xx_hal_eth.c ****       {
 965:./src/stm32f7xx_hal_eth.c ****         /* Setting the last segment bit */
 966:./src/stm32f7xx_hal_eth.c ****         heth->TxDesc->Status |= ETH_DMATXDESC_LS;
 967:./src/stm32f7xx_hal_eth.c ****         size = FrameLength - (bufcount-1)*ETH_TX_BUF_SIZE;
 968:./src/stm32f7xx_hal_eth.c ****         heth->TxDesc->ControlBufferSize = (size & ETH_DMATXDESC_TBS1);
 969:./src/stm32f7xx_hal_eth.c ****       }
 970:./src/stm32f7xx_hal_eth.c ****       
 971:./src/stm32f7xx_hal_eth.c ****       /* Set Own bit of the Tx descriptor Status: gives the buffer back to ETHERNET DMA */
 972:./src/stm32f7xx_hal_eth.c ****       heth->TxDesc->Status |= ETH_DMATXDESC_OWN;
 973:./src/stm32f7xx_hal_eth.c ****       /* point to next descriptor */
 974:./src/stm32f7xx_hal_eth.c ****       heth->TxDesc = (ETH_DMADescTypeDef *)(heth->TxDesc->Buffer2NextDescAddr);
 975:./src/stm32f7xx_hal_eth.c ****     }
 976:./src/stm32f7xx_hal_eth.c ****   }
 977:./src/stm32f7xx_hal_eth.c ****   
 978:./src/stm32f7xx_hal_eth.c ****   /* When Tx Buffer unavailable flag is set: clear it and resume transmission */
 979:./src/stm32f7xx_hal_eth.c ****   if (((heth->Instance)->DMASR & ETH_DMASR_TBUS) != (uint32_t)RESET)
 980:./src/stm32f7xx_hal_eth.c ****   {
 981:./src/stm32f7xx_hal_eth.c ****     /* Clear TBUS ETHERNET DMA flag */
 982:./src/stm32f7xx_hal_eth.c ****     (heth->Instance)->DMASR = ETH_DMASR_TBUS;
 983:./src/stm32f7xx_hal_eth.c ****     /* Resume DMA transmission*/
 984:./src/stm32f7xx_hal_eth.c ****     (heth->Instance)->DMATPDR = 0;
 985:./src/stm32f7xx_hal_eth.c ****   }
 986:./src/stm32f7xx_hal_eth.c ****   
 987:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to Ready */
 988:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_READY;
 989:./src/stm32f7xx_hal_eth.c ****   
 990:./src/stm32f7xx_hal_eth.c ****   /* Process Unlocked */
 991:./src/stm32f7xx_hal_eth.c ****   __HAL_UNLOCK(heth);
 992:./src/stm32f7xx_hal_eth.c ****   
 993:./src/stm32f7xx_hal_eth.c ****   /* Return function status */
 994:./src/stm32f7xx_hal_eth.c ****   return HAL_OK;
 995:./src/stm32f7xx_hal_eth.c **** }
 996:./src/stm32f7xx_hal_eth.c **** 
 997:./src/stm32f7xx_hal_eth.c **** /**
 998:./src/stm32f7xx_hal_eth.c ****   * @brief  Checks for received frames. 
 999:./src/stm32f7xx_hal_eth.c ****   * @param  heth pointer to a ETH_HandleTypeDef structure that contains
1000:./src/stm32f7xx_hal_eth.c ****   *         the configuration information for ETHERNET module
1001:./src/stm32f7xx_hal_eth.c ****   * @retval HAL status
1002:./src/stm32f7xx_hal_eth.c ****   */
1003:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_GetReceivedFrame(ETH_HandleTypeDef *heth)
1004:./src/stm32f7xx_hal_eth.c **** {
1005:./src/stm32f7xx_hal_eth.c ****   uint32_t framelength = 0;
1006:./src/stm32f7xx_hal_eth.c ****   
1007:./src/stm32f7xx_hal_eth.c ****   /* Process Locked */
1008:./src/stm32f7xx_hal_eth.c ****   __HAL_LOCK(heth);
1009:./src/stm32f7xx_hal_eth.c ****   
1010:./src/stm32f7xx_hal_eth.c ****   /* Check the ETH state to BUSY */
1011:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_BUSY;
1012:./src/stm32f7xx_hal_eth.c ****   
1013:./src/stm32f7xx_hal_eth.c ****   /* Check if segment is not owned by DMA */
1014:./src/stm32f7xx_hal_eth.c ****   /* (((heth->RxDesc->Status & ETH_DMARXDESC_OWN) == (uint32_t)RESET) && ((heth->RxDesc->Status & E
1015:./src/stm32f7xx_hal_eth.c ****   if(((heth->RxDesc->Status & ETH_DMARXDESC_OWN) == (uint32_t)RESET))
1016:./src/stm32f7xx_hal_eth.c ****   {
1017:./src/stm32f7xx_hal_eth.c ****     /* Check if last segment */
1018:./src/stm32f7xx_hal_eth.c ****     if(((heth->RxDesc->Status & ETH_DMARXDESC_LS) != (uint32_t)RESET)) 
1019:./src/stm32f7xx_hal_eth.c ****     {
1020:./src/stm32f7xx_hal_eth.c ****       /* increment segment count */
1021:./src/stm32f7xx_hal_eth.c ****       (heth->RxFrameInfos).SegCount++;
1022:./src/stm32f7xx_hal_eth.c ****       
1023:./src/stm32f7xx_hal_eth.c ****       /* Check if last segment is first segment: one segment contains the frame */
1024:./src/stm32f7xx_hal_eth.c ****       if ((heth->RxFrameInfos).SegCount == 1)
1025:./src/stm32f7xx_hal_eth.c ****       {
1026:./src/stm32f7xx_hal_eth.c ****         (heth->RxFrameInfos).FSRxDesc =heth->RxDesc;
1027:./src/stm32f7xx_hal_eth.c ****       }
1028:./src/stm32f7xx_hal_eth.c ****       
1029:./src/stm32f7xx_hal_eth.c ****       heth->RxFrameInfos.LSRxDesc = heth->RxDesc;
1030:./src/stm32f7xx_hal_eth.c ****       
1031:./src/stm32f7xx_hal_eth.c ****       /* Get the Frame Length of the received packet: substruct 4 bytes of the CRC */
1032:./src/stm32f7xx_hal_eth.c ****       framelength = (((heth->RxDesc)->Status & ETH_DMARXDESC_FL) >> ETH_DMARXDESC_FRAMELENGTHSHIFT)
1033:./src/stm32f7xx_hal_eth.c ****       heth->RxFrameInfos.length = framelength;
1034:./src/stm32f7xx_hal_eth.c ****       
1035:./src/stm32f7xx_hal_eth.c ****       /* Get the address of the buffer start address */
1036:./src/stm32f7xx_hal_eth.c ****       heth->RxFrameInfos.buffer = ((heth->RxFrameInfos).FSRxDesc)->Buffer1Addr;
1037:./src/stm32f7xx_hal_eth.c ****       /* point to next descriptor */
1038:./src/stm32f7xx_hal_eth.c ****       heth->RxDesc = (ETH_DMADescTypeDef*) ((heth->RxDesc)->Buffer2NextDescAddr);
1039:./src/stm32f7xx_hal_eth.c ****       
1040:./src/stm32f7xx_hal_eth.c ****       /* Set HAL State to Ready */
1041:./src/stm32f7xx_hal_eth.c ****       heth->State = HAL_ETH_STATE_READY;
1042:./src/stm32f7xx_hal_eth.c ****       
1043:./src/stm32f7xx_hal_eth.c ****       /* Process Unlocked */
1044:./src/stm32f7xx_hal_eth.c ****       __HAL_UNLOCK(heth);
1045:./src/stm32f7xx_hal_eth.c ****       
1046:./src/stm32f7xx_hal_eth.c ****       /* Return function status */
1047:./src/stm32f7xx_hal_eth.c ****       return HAL_OK;
1048:./src/stm32f7xx_hal_eth.c ****     }
1049:./src/stm32f7xx_hal_eth.c ****     /* Check if first segment */
1050:./src/stm32f7xx_hal_eth.c ****     else if((heth->RxDesc->Status & ETH_DMARXDESC_FS) != (uint32_t)RESET)
1051:./src/stm32f7xx_hal_eth.c ****     {
1052:./src/stm32f7xx_hal_eth.c ****       (heth->RxFrameInfos).FSRxDesc = heth->RxDesc;
1053:./src/stm32f7xx_hal_eth.c ****       (heth->RxFrameInfos).LSRxDesc = NULL;
1054:./src/stm32f7xx_hal_eth.c ****       (heth->RxFrameInfos).SegCount = 1;
1055:./src/stm32f7xx_hal_eth.c ****       /* Point to next descriptor */
1056:./src/stm32f7xx_hal_eth.c ****       heth->RxDesc = (ETH_DMADescTypeDef*) (heth->RxDesc->Buffer2NextDescAddr);
1057:./src/stm32f7xx_hal_eth.c ****     }
1058:./src/stm32f7xx_hal_eth.c ****     /* Check if intermediate segment */ 
1059:./src/stm32f7xx_hal_eth.c ****     else
1060:./src/stm32f7xx_hal_eth.c ****     {
1061:./src/stm32f7xx_hal_eth.c ****       (heth->RxFrameInfos).SegCount++;
1062:./src/stm32f7xx_hal_eth.c ****       /* Point to next descriptor */
1063:./src/stm32f7xx_hal_eth.c ****       heth->RxDesc = (ETH_DMADescTypeDef*) (heth->RxDesc->Buffer2NextDescAddr);
1064:./src/stm32f7xx_hal_eth.c ****     } 
1065:./src/stm32f7xx_hal_eth.c ****   }
1066:./src/stm32f7xx_hal_eth.c ****   
1067:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to Ready */
1068:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_READY;
1069:./src/stm32f7xx_hal_eth.c ****   
1070:./src/stm32f7xx_hal_eth.c ****   /* Process Unlocked */
1071:./src/stm32f7xx_hal_eth.c ****   __HAL_UNLOCK(heth);
1072:./src/stm32f7xx_hal_eth.c ****   
1073:./src/stm32f7xx_hal_eth.c ****   /* Return function status */
1074:./src/stm32f7xx_hal_eth.c ****   return HAL_ERROR;
1075:./src/stm32f7xx_hal_eth.c **** }

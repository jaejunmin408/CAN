1400:./src/stm32f7xx_hal_eth.c ****   heth->Instance->MACMIIAR = tmpreg;
1401:./src/stm32f7xx_hal_eth.c ****   
1402:./src/stm32f7xx_hal_eth.c ****   /* Get tick */

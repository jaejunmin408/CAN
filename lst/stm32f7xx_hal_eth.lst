   1:./src/stm32f7xx_hal_eth.c **** /**
   2:./src/stm32f7xx_hal_eth.c ****   ******************************************************************************
   3:./src/stm32f7xx_hal_eth.c ****   * @file    stm32f7xx_hal_eth.c
   4:./src/stm32f7xx_hal_eth.c ****   * @author  MCD Application Team
   5:./src/stm32f7xx_hal_eth.c ****   * @brief   ETH HAL module driver.
   6:./src/stm32f7xx_hal_eth.c ****   *          This file provides firmware functions to manage the following 
   7:./src/stm32f7xx_hal_eth.c ****   *          functionalities of the Ethernet (ETH) peripheral:
   8:./src/stm32f7xx_hal_eth.c ****   *           + Initialization and de-initialization functions
   9:./src/stm32f7xx_hal_eth.c ****   *           + IO operation functions
  10:./src/stm32f7xx_hal_eth.c ****   *           + Peripheral Control functions 
  11:./src/stm32f7xx_hal_eth.c ****   *           + Peripheral State and Errors functions
  12:./src/stm32f7xx_hal_eth.c ****   *
  13:./src/stm32f7xx_hal_eth.c ****   @verbatim
  14:./src/stm32f7xx_hal_eth.c ****   ==============================================================================
  15:./src/stm32f7xx_hal_eth.c ****                     ##### How to use this driver #####
  16:./src/stm32f7xx_hal_eth.c ****   ==============================================================================
  17:./src/stm32f7xx_hal_eth.c ****     [..]
  18:./src/stm32f7xx_hal_eth.c ****       (#)Declare a ETH_HandleTypeDef handle structure, for example:
  19:./src/stm32f7xx_hal_eth.c ****          ETH_HandleTypeDef  heth;
  20:./src/stm32f7xx_hal_eth.c ****         
  21:./src/stm32f7xx_hal_eth.c ****       (#)Fill parameters of Init structure in heth handle
  22:./src/stm32f7xx_hal_eth.c ****   
  23:./src/stm32f7xx_hal_eth.c ****       (#)Call HAL_ETH_Init() API to initialize the Ethernet peripheral (MAC, DMA, ...) 
  24:./src/stm32f7xx_hal_eth.c **** 
  25:./src/stm32f7xx_hal_eth.c ****       (#)Initialize the ETH low level resources through the HAL_ETH_MspInit() API:
  26:./src/stm32f7xx_hal_eth.c ****           (##) Enable the Ethernet interface clock using 
  27:./src/stm32f7xx_hal_eth.c ****                (+++) __HAL_RCC_ETHMAC_CLK_ENABLE();
  28:./src/stm32f7xx_hal_eth.c ****                (+++) __HAL_RCC_ETHMACTX_CLK_ENABLE();
  29:./src/stm32f7xx_hal_eth.c ****                (+++) __HAL_RCC_ETHMACRX_CLK_ENABLE();
  30:./src/stm32f7xx_hal_eth.c ****            
  31:./src/stm32f7xx_hal_eth.c ****           (##) Initialize the related GPIO clocks
  32:./src/stm32f7xx_hal_eth.c ****           (##) Configure Ethernet pin-out
  33:./src/stm32f7xx_hal_eth.c ****           (##) Configure Ethernet NVIC interrupt (IT mode)   
  34:./src/stm32f7xx_hal_eth.c ****     
  35:./src/stm32f7xx_hal_eth.c ****       (#)Initialize Ethernet DMA Descriptors in chain mode and point to allocated buffers:
  36:./src/stm32f7xx_hal_eth.c ****           (##) HAL_ETH_DMATxDescListInit(); for Transmission process
  37:./src/stm32f7xx_hal_eth.c ****           (##) HAL_ETH_DMARxDescListInit(); for Reception process
  38:./src/stm32f7xx_hal_eth.c **** 
  39:./src/stm32f7xx_hal_eth.c ****       (#)Enable MAC and DMA transmission and reception:
  40:./src/stm32f7xx_hal_eth.c ****           (##) HAL_ETH_Start();
  41:./src/stm32f7xx_hal_eth.c **** 
  42:./src/stm32f7xx_hal_eth.c ****       (#)Prepare ETH DMA TX Descriptors and give the hand to ETH DMA to transfer 
  43:./src/stm32f7xx_hal_eth.c ****          the frame to MAC TX FIFO:
  44:./src/stm32f7xx_hal_eth.c ****          (##) HAL_ETH_TransmitFrame();
  45:./src/stm32f7xx_hal_eth.c **** 
  46:./src/stm32f7xx_hal_eth.c ****       (#)Poll for a received frame in ETH RX DMA Descriptors and get received 
  47:./src/stm32f7xx_hal_eth.c ****          frame parameters
  48:./src/stm32f7xx_hal_eth.c ****          (##) HAL_ETH_GetReceivedFrame(); (should be called into an infinite loop)
  49:./src/stm32f7xx_hal_eth.c **** 
  50:./src/stm32f7xx_hal_eth.c ****       (#) Get a received frame when an ETH RX interrupt occurs:
  51:./src/stm32f7xx_hal_eth.c ****          (##) HAL_ETH_GetReceivedFrame_IT(); (called in IT mode only)
  52:./src/stm32f7xx_hal_eth.c **** 
  53:./src/stm32f7xx_hal_eth.c ****       (#) Communicate with external PHY device:
  54:./src/stm32f7xx_hal_eth.c ****          (##) Read a specific register from the PHY  
  55:./src/stm32f7xx_hal_eth.c ****               HAL_ETH_ReadPHYRegister();
  56:./src/stm32f7xx_hal_eth.c ****          (##) Write data to a specific RHY register:
  57:./src/stm32f7xx_hal_eth.c ****               HAL_ETH_WritePHYRegister();
  58:./src/stm32f7xx_hal_eth.c **** 
  59:./src/stm32f7xx_hal_eth.c ****       (#) Configure the Ethernet MAC after ETH peripheral initialization
  60:./src/stm32f7xx_hal_eth.c ****           HAL_ETH_ConfigMAC(); all MAC parameters should be filled.
  61:./src/stm32f7xx_hal_eth.c ****       
  62:./src/stm32f7xx_hal_eth.c ****       (#) Configure the Ethernet DMA after ETH peripheral initialization
  63:./src/stm32f7xx_hal_eth.c ****           HAL_ETH_ConfigDMA(); all DMA parameters should be filled.
  64:./src/stm32f7xx_hal_eth.c **** 
  65:./src/stm32f7xx_hal_eth.c **** *** Callback registration ***
  66:./src/stm32f7xx_hal_eth.c ****   =============================================
  67:./src/stm32f7xx_hal_eth.c **** 
  68:./src/stm32f7xx_hal_eth.c ****   The compilation define  USE_HAL_ETH_REGISTER_CALLBACKS when set to 1
  69:./src/stm32f7xx_hal_eth.c ****   allows the user to configure dynamically the driver callbacks.
  70:./src/stm32f7xx_hal_eth.c ****   Use Function @ref HAL_ETH_RegisterCallback() to register an interrupt callback.
  71:./src/stm32f7xx_hal_eth.c **** 
  72:./src/stm32f7xx_hal_eth.c ****   Function @ref HAL_ETH_RegisterCallback() allows to register following callbacks:
  73:./src/stm32f7xx_hal_eth.c ****     (+) TxCpltCallback   : Tx Complete Callback.
  74:./src/stm32f7xx_hal_eth.c ****     (+) RxCpltCallback   : Rx Complete Callback.
  75:./src/stm32f7xx_hal_eth.c ****     (+) DMAErrorCallback : DMA Error Callback.
  76:./src/stm32f7xx_hal_eth.c ****     (+) MspInitCallback  : MspInit Callback.
  77:./src/stm32f7xx_hal_eth.c ****     (+) MspDeInitCallback: MspDeInit Callback.
  78:./src/stm32f7xx_hal_eth.c **** 
  79:./src/stm32f7xx_hal_eth.c ****   This function takes as parameters the HAL peripheral handle, the Callback ID
  80:./src/stm32f7xx_hal_eth.c ****   and a pointer to the user callback function.
  81:./src/stm32f7xx_hal_eth.c **** 
  82:./src/stm32f7xx_hal_eth.c ****   Use function @ref HAL_ETH_UnRegisterCallback() to reset a callback to the default
  83:./src/stm32f7xx_hal_eth.c ****   weak function.
  84:./src/stm32f7xx_hal_eth.c ****   @ref HAL_ETH_UnRegisterCallback takes as parameters the HAL peripheral handle,
  85:./src/stm32f7xx_hal_eth.c ****   and the Callback ID.
  86:./src/stm32f7xx_hal_eth.c ****   This function allows to reset following callbacks:
  87:./src/stm32f7xx_hal_eth.c ****     (+) TxCpltCallback   : Tx Complete Callback.
  88:./src/stm32f7xx_hal_eth.c ****     (+) RxCpltCallback   : Rx Complete Callback.
  89:./src/stm32f7xx_hal_eth.c ****     (+) DMAErrorCallback : DMA Error Callback.
  90:./src/stm32f7xx_hal_eth.c ****     (+) MspInitCallback  : MspInit Callback.
  91:./src/stm32f7xx_hal_eth.c ****     (+) MspDeInitCallback: MspDeInit Callback.
  92:./src/stm32f7xx_hal_eth.c **** 
  93:./src/stm32f7xx_hal_eth.c ****   By default, after the HAL_ETH_Init and when the state is HAL_ETH_STATE_RESET
  94:./src/stm32f7xx_hal_eth.c ****   all callbacks are set to the corresponding weak functions:
  95:./src/stm32f7xx_hal_eth.c ****   examples @ref HAL_ETH_TxCpltCallback(), @ref HAL_ETH_RxCpltCallback().
  96:./src/stm32f7xx_hal_eth.c ****   Exception done for MspInit and MspDeInit functions that are
  97:./src/stm32f7xx_hal_eth.c ****   reset to the legacy weak function in the HAL_ETH_Init/ @ref HAL_ETH_DeInit only when
  98:./src/stm32f7xx_hal_eth.c ****   these callbacks are null (not registered beforehand).
  99:./src/stm32f7xx_hal_eth.c ****   if not, MspInit or MspDeInit are not null, the HAL_ETH_Init/ @ref HAL_ETH_DeInit
 100:./src/stm32f7xx_hal_eth.c ****   keep and use the user MspInit/MspDeInit callbacks (registered beforehand)
 101:./src/stm32f7xx_hal_eth.c **** 
 102:./src/stm32f7xx_hal_eth.c ****   Callbacks can be registered/unregistered in HAL_ETH_STATE_READY state only.
 103:./src/stm32f7xx_hal_eth.c ****   Exception done MspInit/MspDeInit that can be registered/unregistered
 104:./src/stm32f7xx_hal_eth.c ****   in HAL_ETH_STATE_READY or HAL_ETH_STATE_RESET state,
 105:./src/stm32f7xx_hal_eth.c ****   thus registered (user) MspInit/DeInit callbacks can be used during the Init/DeInit.
 106:./src/stm32f7xx_hal_eth.c ****   In that case first register the MspInit/MspDeInit user callbacks
 107:./src/stm32f7xx_hal_eth.c ****   using @ref HAL_ETH_RegisterCallback() before calling @ref HAL_ETH_DeInit
 108:./src/stm32f7xx_hal_eth.c ****   or HAL_ETH_Init function.
 109:./src/stm32f7xx_hal_eth.c **** 
 110:./src/stm32f7xx_hal_eth.c ****   When The compilation define USE_HAL_ETH_REGISTER_CALLBACKS is set to 0 or
 111:./src/stm32f7xx_hal_eth.c ****   not defined, the callback registration feature is not available and all callbacks
 112:./src/stm32f7xx_hal_eth.c ****   are set to the corresponding weak functions.
 113:./src/stm32f7xx_hal_eth.c **** 
 114:./src/stm32f7xx_hal_eth.c ****   @endverbatim

1370:./src/stm32f7xx_hal_eth.c ****   uint32_t tmpreg = 0;
1371:./src/stm32f7xx_hal_eth.c ****   uint32_t tickstart = 0;
1372:./src/stm32f7xx_hal_eth.c ****   
1373:./src/stm32f7xx_hal_eth.c ****   /* Check parameters */
1374:./src/stm32f7xx_hal_eth.c ****   assert_param(IS_ETH_PHY_ADDRESS(heth->Init.PhyAddress));
1375:./src/stm32f7xx_hal_eth.c ****   
1376:./src/stm32f7xx_hal_eth.c ****   /* Check the ETH peripheral state */
1377:./src/stm32f7xx_hal_eth.c ****   if(heth->State == HAL_ETH_STATE_BUSY_WR)
1378:./src/stm32f7xx_hal_eth.c ****   {
1379:./src/stm32f7xx_hal_eth.c ****     return HAL_BUSY;
1380:./src/stm32f7xx_hal_eth.c ****   }
1381:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to BUSY_WR */
1382:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_BUSY_WR;
1383:./src/stm32f7xx_hal_eth.c ****   
1384:./src/stm32f7xx_hal_eth.c ****   /* Get the ETHERNET MACMIIAR value */
1385:./src/stm32f7xx_hal_eth.c ****   tmpreg = heth->Instance->MACMIIAR;
1386:./src/stm32f7xx_hal_eth.c ****   
1387:./src/stm32f7xx_hal_eth.c ****   /* Keep only the CSR Clock Range CR[2:0] bits value */
1388:./src/stm32f7xx_hal_eth.c ****   tmpreg &= ~ETH_MACMIIAR_CR_MASK;
1389:./src/stm32f7xx_hal_eth.c ****   
1390:./src/stm32f7xx_hal_eth.c ****   /* Prepare the MII register address value */
1391:./src/stm32f7xx_hal_eth.c ****   tmpreg |=(((uint32_t)heth->Init.PhyAddress<<11) & ETH_MACMIIAR_PA); /* Set the PHY device address
1392:./src/stm32f7xx_hal_eth.c ****   tmpreg |=(((uint32_t)PHYReg<<6) & ETH_MACMIIAR_MR);                 /* Set the PHY register addre
1393:./src/stm32f7xx_hal_eth.c ****   tmpreg |= ETH_MACMIIAR_MW;                                          /* Set the write mode */
1394:./src/stm32f7xx_hal_eth.c ****   tmpreg |= ETH_MACMIIAR_MB;                                          /* Set the MII Busy bit */
1395:./src/stm32f7xx_hal_eth.c ****   

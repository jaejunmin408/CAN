 633:./src/stm32f7xx_hal_eth.c ****     {
 634:./src/stm32f7xx_hal_eth.c ****       /* Set next descriptor address register with next descriptor base address */
 635:./src/stm32f7xx_hal_eth.c ****       DMARxDesc->Buffer2NextDescAddr = (uint32_t)(DMARxDescTab+i+1); 
 636:./src/stm32f7xx_hal_eth.c ****     }
 637:./src/stm32f7xx_hal_eth.c ****     else
 638:./src/stm32f7xx_hal_eth.c ****     {
 639:./src/stm32f7xx_hal_eth.c ****       /* For last descriptor, set next descriptor address register equal to the first descriptor ba
 640:./src/stm32f7xx_hal_eth.c ****       DMARxDesc->Buffer2NextDescAddr = (uint32_t)(DMARxDescTab); 
 641:./src/stm32f7xx_hal_eth.c ****     }
 642:./src/stm32f7xx_hal_eth.c ****   }
 643:./src/stm32f7xx_hal_eth.c ****   
 644:./src/stm32f7xx_hal_eth.c ****   /* Set Receive Descriptor List Address Register */
 645:./src/stm32f7xx_hal_eth.c ****   (heth->Instance)->DMARDLAR = (uint32_t) DMARxDescTab;
 646:./src/stm32f7xx_hal_eth.c ****   
 647:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to Ready */
 648:./src/stm32f7xx_hal_eth.c ****   heth->State= HAL_ETH_STATE_READY;
 649:./src/stm32f7xx_hal_eth.c ****   
 650:./src/stm32f7xx_hal_eth.c ****   /* Process Unlocked */
 651:./src/stm32f7xx_hal_eth.c ****   __HAL_UNLOCK(heth);
 652:./src/stm32f7xx_hal_eth.c ****   
 653:./src/stm32f7xx_hal_eth.c ****   /* Return function status */

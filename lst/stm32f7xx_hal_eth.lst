 481:./src/stm32f7xx_hal_eth.c ****   heth->State= HAL_ETH_STATE_READY;
 482:./src/stm32f7xx_hal_eth.c ****   
 483:./src/stm32f7xx_hal_eth.c ****   /* Return function status */

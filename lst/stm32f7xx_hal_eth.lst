 455:./src/stm32f7xx_hal_eth.c ****     
 456:./src/stm32f7xx_hal_eth.c ****     /* Set MAC Speed and Duplex Mode */
 457:./src/stm32f7xx_hal_eth.c ****     if(HAL_ETH_WritePHYRegister(heth, PHY_BCR, ((uint16_t)((heth->Init).DuplexMode >> 3) |
 458:./src/stm32f7xx_hal_eth.c ****                                                 (uint16_t)((heth->Init).Speed >> 1))) != HAL_OK)
 459:./src/stm32f7xx_hal_eth.c ****     {

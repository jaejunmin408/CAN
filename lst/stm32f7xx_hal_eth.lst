1077:./src/stm32f7xx_hal_eth.c **** /**
1078:./src/stm32f7xx_hal_eth.c ****   * @brief  Gets the Received frame in interrupt mode. 
1079:./src/stm32f7xx_hal_eth.c ****   * @param  heth pointer to a ETH_HandleTypeDef structure that contains
1080:./src/stm32f7xx_hal_eth.c ****   *         the configuration information for ETHERNET module
1081:./src/stm32f7xx_hal_eth.c ****   * @retval HAL status
1082:./src/stm32f7xx_hal_eth.c ****   */
1083:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_GetReceivedFrame_IT(ETH_HandleTypeDef *heth)
1084:./src/stm32f7xx_hal_eth.c **** {
1085:./src/stm32f7xx_hal_eth.c ****   uint32_t descriptorscancounter = 0;
1086:./src/stm32f7xx_hal_eth.c ****   
1087:./src/stm32f7xx_hal_eth.c ****   /* Process Locked */
1088:./src/stm32f7xx_hal_eth.c ****   __HAL_LOCK(heth);
1089:./src/stm32f7xx_hal_eth.c ****   
1090:./src/stm32f7xx_hal_eth.c ****   /* Set ETH HAL State to BUSY */

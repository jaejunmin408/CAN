1460:./src/stm32f7xx_hal_eth.c **** HAL_StatusTypeDef HAL_ETH_Start(ETH_HandleTypeDef *heth)
1461:./src/stm32f7xx_hal_eth.c **** {  
1462:./src/stm32f7xx_hal_eth.c ****   /* Process Locked */
1463:./src/stm32f7xx_hal_eth.c ****   __HAL_LOCK(heth);
1464:./src/stm32f7xx_hal_eth.c ****   
1465:./src/stm32f7xx_hal_eth.c ****   /* Set the ETH peripheral state to BUSY */
1466:./src/stm32f7xx_hal_eth.c ****   heth->State = HAL_ETH_STATE_BUSY;
1467:./src/stm32f7xx_hal_eth.c ****   
1468:./src/stm32f7xx_hal_eth.c ****   /* Enable transmit state machine of the MAC for transmission on the MII */
1469:./src/stm32f7xx_hal_eth.c ****   ETH_MACTransmissionEnable(heth);
1470:./src/stm32f7xx_hal_eth.c ****   
1471:./src/stm32f7xx_hal_eth.c ****   /* Enable receive state machine of the MAC for reception from the MII */
1472:./src/stm32f7xx_hal_eth.c ****   ETH_MACReceptionEnable(heth);
1473:./src/stm32f7xx_hal_eth.c ****   
1474:./src/stm32f7xx_hal_eth.c ****   /* Flush Transmit FIFO */
1475:./src/stm32f7xx_hal_eth.c ****   ETH_FlushTransmitFIFO(heth);
1476:./src/stm32f7xx_hal_eth.c ****   
1477:./src/stm32f7xx_hal_eth.c ****   /* Start DMA transmission */
1478:./src/stm32f7xx_hal_eth.c ****   ETH_DMATransmissionEnable(heth);
1479:./src/stm32f7xx_hal_eth.c ****   
1480:./src/stm32f7xx_hal_eth.c ****   /* Start DMA reception */
1481:./src/stm32f7xx_hal_eth.c ****   ETH_DMAReceptionEnable(heth);
1482:./src/stm32f7xx_hal_eth.c ****   

 411:./inc/core_cm7.h **** /**
 412:./inc/core_cm7.h ****   \ingroup    CMSIS_core_register
 413:./inc/core_cm7.h ****   \defgroup   CMSIS_NVIC  Nested Vectored Interrupt Controller (NVIC)
 414:./inc/core_cm7.h ****   \brief      Type definitions for the NVIC Registers
 415:./inc/core_cm7.h ****   @{

 417:./inc/core_cm7.h **** 
 418:./inc/core_cm7.h **** /**
 419:./inc/core_cm7.h ****   \brief  Structure type to access the Nested Vectored Interrupt Controller (NVIC).
 420:./inc/core_cm7.h ****  */
 421:./inc/core_cm7.h **** typedef struct
 422:./inc/core_cm7.h **** {
 423:./inc/core_cm7.h ****   __IOM uint32_t ISER[8U];               /*!< Offset: 0x000 (R/W)  Interrupt Set Enable Register */
 424:./inc/core_cm7.h ****         uint32_t RESERVED0[24U];
 425:./inc/core_cm7.h ****   __IOM uint32_t ICER[8U];               /*!< Offset: 0x080 (R/W)  Interrupt Clear Enable Register 
 426:./inc/core_cm7.h ****         uint32_t RESERVED1[24U];
 427:./inc/core_cm7.h ****   __IOM uint32_t ISPR[8U];               /*!< Offset: 0x100 (R/W)  Interrupt Set Pending Register *
 428:./inc/core_cm7.h ****         uint32_t RESERVED2[24U];
 429:./inc/core_cm7.h ****   __IOM uint32_t ICPR[8U];               /*!< Offset: 0x180 (R/W)  Interrupt Clear Pending Register
 430:./inc/core_cm7.h ****         uint32_t RESERVED3[24U];
 431:./inc/core_cm7.h ****   __IOM uint32_t IABR[8U];               /*!< Offset: 0x200 (R/W)  Interrupt Active bit Register */
 432:./inc/core_cm7.h ****         uint32_t RESERVED4[56U];
 433:./inc/core_cm7.h ****   __IOM uint8_t  IP[240U];               /*!< Offset: 0x300 (R/W)  Interrupt Priority Register (8Bi
 434:./inc/core_cm7.h ****         uint32_t RESERVED5[644U];
 435:./inc/core_cm7.h ****   __OM  uint32_t STIR;                   /*!< Offset: 0xE00 ( /W)  Software Trigger Interrupt Regis
 436:./inc/core_cm7.h **** }  NVIC_Type;
 437:./inc/core_cm7.h **** 
 438:./inc/core_cm7.h **** /* Software Triggered Interrupt Register Definitions */
 439:./inc/core_cm7.h **** #define NVIC_STIR_INTID_Pos                 0U                                         /*!< STIR: I
 440:./inc/core_cm7.h **** #define NVIC_STIR_INTID_Msk                (0x1FFUL /*<< NVIC_STIR_INTID_Pos*/)        /*!< STIR: I
 441:./inc/core_cm7.h **** 
 442:./inc/core_cm7.h **** /*@} end of group CMSIS_NVIC */

 760:./lwip-2.1.2/src/core/ipv4/ip4.c **** 
 761:./lwip-2.1.2/src/core/ipv4/ip4.c **** /**
 762:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * Sends an IP packet on a network interface. This function constructs
 763:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * the IP header and calculates the IP header checksum. If the source
 764:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * IP address is NULL, the IP address of the outgoing network
 765:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * interface is filled in as source address.
 766:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * If the destination IP address is LWIP_IP_HDRINCL, p is assumed to already
 767:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * include an IP header and p->payload points to it instead of the data.
 768:./lwip-2.1.2/src/core/ipv4/ip4.c ****  *
 769:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param p the packet to send (p->payload points to the data, e.g. next
 770:./lwip-2.1.2/src/core/ipv4/ip4.c ****             protocol header; if dest == LWIP_IP_HDRINCL, p already includes an
 771:./lwip-2.1.2/src/core/ipv4/ip4.c ****             IP header and p->payload points to that IP header)
 772:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param src the source IP address to send from (if src == IP4_ADDR_ANY, the
 773:./lwip-2.1.2/src/core/ipv4/ip4.c ****  *         IP  address of the netif used to send is used as source address)
 774:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param dest the destination IP address to send the packet to
 775:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param ttl the TTL value to be set in the IP header
 776:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param tos the TOS value to be set in the IP header
 777:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param proto the PROTOCOL to be set in the IP header
 778:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @param netif the netif on which to send this packet
 779:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @return ERR_OK if the packet was sent OK
 780:./lwip-2.1.2/src/core/ipv4/ip4.c ****  *         ERR_BUF if p doesn't have enough space for IP/LINK headers
 781:./lwip-2.1.2/src/core/ipv4/ip4.c ****  *         returns errors returned by netif->output
 782:./lwip-2.1.2/src/core/ipv4/ip4.c ****  *
 783:./lwip-2.1.2/src/core/ipv4/ip4.c ****  * @note ip_id: RFC791 "some host may be able to simply use
 784:./lwip-2.1.2/src/core/ipv4/ip4.c ****  *  unique identifiers independent of destination"
 785:./lwip-2.1.2/src/core/ipv4/ip4.c ****  */
 786:./lwip-2.1.2/src/core/ipv4/ip4.c **** err_t
 787:./lwip-2.1.2/src/core/ipv4/ip4.c **** ip4_output_if(struct pbuf *p, const ip4_addr_t *src, const ip4_addr_t *dest,
 788:./lwip-2.1.2/src/core/ipv4/ip4.c ****               u8_t ttl, u8_t tos,
 789:./lwip-2.1.2/src/core/ipv4/ip4.c ****               u8_t proto, struct netif *netif)
 790:./lwip-2.1.2/src/core/ipv4/ip4.c **** {
 791:./lwip-2.1.2/src/core/ipv4/ip4.c **** #if IP_OPTIONS_SEND
 792:./lwip-2.1.2/src/core/ipv4/ip4.c ****   return ip4_output_if_opt(p, src, dest, ttl, tos, proto, netif, NULL, 0);
 793:./lwip-2.1.2/src/core/ipv4/ip4.c **** }
 794:./lwip-2.1.2/src/core/ipv4/ip4.c **** 
 795:./lwip-2.1.2/src/core/ipv4/ip4.c **** /**

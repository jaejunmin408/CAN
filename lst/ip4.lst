  98:./lwip-2.1.2/src/core/ipv4/ip4.c **** /* accept DHCP client port only */
  99:./lwip-2.1.2/src/core/ipv4/ip4.c **** #define IP_ACCEPT_LINK_LAYER_ADDRESSED_PORT(port) ((port) == PP_NTOHS(LWIP_IANA_PORT_DHCP_CLIENT))

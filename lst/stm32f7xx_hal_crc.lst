  97:./src/stm32f7xx_hal_crc.c **** /**
  98:./src/stm32f7xx_hal_crc.c ****   * @brief  Initialize the CRC according to the specified
  99:./src/stm32f7xx_hal_crc.c ****   *         parameters in the CRC_InitTypeDef and create the associated handle.
 100:./src/stm32f7xx_hal_crc.c ****   * @param  hcrc CRC handle
 101:./src/stm32f7xx_hal_crc.c ****   * @retval HAL status
 102:./src/stm32f7xx_hal_crc.c ****   */
 103:./src/stm32f7xx_hal_crc.c **** HAL_StatusTypeDef HAL_CRC_Init(CRC_HandleTypeDef *hcrc)
 104:./src/stm32f7xx_hal_crc.c **** {
 105:./src/stm32f7xx_hal_crc.c ****   /* Check the CRC handle allocation */
 106:./src/stm32f7xx_hal_crc.c ****   if (hcrc == NULL)
 107:./src/stm32f7xx_hal_crc.c ****   {
 108:./src/stm32f7xx_hal_crc.c ****     return HAL_ERROR;
 109:./src/stm32f7xx_hal_crc.c ****   }
 110:./src/stm32f7xx_hal_crc.c **** 
 111:./src/stm32f7xx_hal_crc.c ****   /* Check the parameters */
 112:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_CRC_ALL_INSTANCE(hcrc->Instance));
 113:./src/stm32f7xx_hal_crc.c **** 
 114:./src/stm32f7xx_hal_crc.c ****   if (hcrc->State == HAL_CRC_STATE_RESET)
 115:./src/stm32f7xx_hal_crc.c ****   {
 116:./src/stm32f7xx_hal_crc.c ****     /* Allocate lock resource and initialize it */
 117:./src/stm32f7xx_hal_crc.c ****     hcrc->Lock = HAL_UNLOCKED;
 118:./src/stm32f7xx_hal_crc.c ****     /* Init the low level hardware */
 119:./src/stm32f7xx_hal_crc.c ****     HAL_CRC_MspInit(hcrc);
 120:./src/stm32f7xx_hal_crc.c ****   }
 121:./src/stm32f7xx_hal_crc.c **** 
 122:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_BUSY;
 123:./src/stm32f7xx_hal_crc.c **** 
 124:./src/stm32f7xx_hal_crc.c ****   /* check whether or not non-default generating polynomial has been
 125:./src/stm32f7xx_hal_crc.c ****    * picked up by user */
 126:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_DEFAULT_POLYNOMIAL(hcrc->Init.DefaultPolynomialUse));
 127:./src/stm32f7xx_hal_crc.c ****   if (hcrc->Init.DefaultPolynomialUse == DEFAULT_POLYNOMIAL_ENABLE)
 128:./src/stm32f7xx_hal_crc.c ****   {
 129:./src/stm32f7xx_hal_crc.c ****     /* initialize peripheral with default generating polynomial */
 130:./src/stm32f7xx_hal_crc.c ****     WRITE_REG(hcrc->Instance->POL, DEFAULT_CRC32_POLY);
 131:./src/stm32f7xx_hal_crc.c ****     MODIFY_REG(hcrc->Instance->CR, CRC_CR_POLYSIZE, CRC_POLYLENGTH_32B);
 132:./src/stm32f7xx_hal_crc.c ****   }
 133:./src/stm32f7xx_hal_crc.c ****   else
 134:./src/stm32f7xx_hal_crc.c ****   {
 135:./src/stm32f7xx_hal_crc.c ****     /* initialize CRC peripheral with generating polynomial defined by user */
 136:./src/stm32f7xx_hal_crc.c ****     if (HAL_CRCEx_Polynomial_Set(hcrc, hcrc->Init.GeneratingPolynomial, hcrc->Init.CRCLength) != HA
 137:./src/stm32f7xx_hal_crc.c ****     {
 138:./src/stm32f7xx_hal_crc.c ****       return HAL_ERROR;
 139:./src/stm32f7xx_hal_crc.c ****     }
 140:./src/stm32f7xx_hal_crc.c ****   }
 141:./src/stm32f7xx_hal_crc.c **** 
 142:./src/stm32f7xx_hal_crc.c ****   /* check whether or not non-default CRC initial value has been
 143:./src/stm32f7xx_hal_crc.c ****    * picked up by user */
 144:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_DEFAULT_INIT_VALUE(hcrc->Init.DefaultInitValueUse));
 145:./src/stm32f7xx_hal_crc.c ****   if (hcrc->Init.DefaultInitValueUse == DEFAULT_INIT_VALUE_ENABLE)
 146:./src/stm32f7xx_hal_crc.c ****   {
 147:./src/stm32f7xx_hal_crc.c ****     WRITE_REG(hcrc->Instance->INIT, DEFAULT_CRC_INITVALUE);
 148:./src/stm32f7xx_hal_crc.c ****   }
 149:./src/stm32f7xx_hal_crc.c ****   else
 150:./src/stm32f7xx_hal_crc.c ****   {
 151:./src/stm32f7xx_hal_crc.c ****     WRITE_REG(hcrc->Instance->INIT, hcrc->Init.InitValue);
 152:./src/stm32f7xx_hal_crc.c ****   }
 153:./src/stm32f7xx_hal_crc.c **** 
 154:./src/stm32f7xx_hal_crc.c **** 
 155:./src/stm32f7xx_hal_crc.c ****   /* set input data inversion mode */
 156:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_CRC_INPUTDATA_INVERSION_MODE(hcrc->Init.InputDataInversionMode));
 157:./src/stm32f7xx_hal_crc.c ****   MODIFY_REG(hcrc->Instance->CR, CRC_CR_REV_IN, hcrc->Init.InputDataInversionMode);
 158:./src/stm32f7xx_hal_crc.c **** 
 159:./src/stm32f7xx_hal_crc.c ****   /* set output data inversion mode */
 160:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_CRC_OUTPUTDATA_INVERSION_MODE(hcrc->Init.OutputDataInversionMode));
 161:./src/stm32f7xx_hal_crc.c ****   MODIFY_REG(hcrc->Instance->CR, CRC_CR_REV_OUT, hcrc->Init.OutputDataInversionMode);
 162:./src/stm32f7xx_hal_crc.c **** 
 163:./src/stm32f7xx_hal_crc.c ****   /* makes sure the input data format (bytes, halfwords or words stream)
 164:./src/stm32f7xx_hal_crc.c ****    * is properly specified by user */
 165:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_CRC_INPUTDATA_FORMAT(hcrc->InputDataFormat));
 166:./src/stm32f7xx_hal_crc.c **** 
 167:./src/stm32f7xx_hal_crc.c ****   /* Change CRC peripheral state */
 168:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_READY;
 169:./src/stm32f7xx_hal_crc.c **** 
 170:./src/stm32f7xx_hal_crc.c ****   /* Return function status */
 171:./src/stm32f7xx_hal_crc.c ****   return HAL_OK;
 172:./src/stm32f7xx_hal_crc.c **** }

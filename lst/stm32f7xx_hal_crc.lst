 339:./src/stm32f7xx_hal_crc.c **** uint32_t HAL_CRC_Calculate(CRC_HandleTypeDef *hcrc, uint32_t pBuffer[], uint32_t BufferLength)
 340:./src/stm32f7xx_hal_crc.c **** {
 341:./src/stm32f7xx_hal_crc.c ****   uint32_t index;      /* CRC input data buffer index */
 342:./src/stm32f7xx_hal_crc.c ****   uint32_t temp = 0U;  /* CRC output (read from hcrc->Instance->DR register) */
 343:./src/stm32f7xx_hal_crc.c **** 

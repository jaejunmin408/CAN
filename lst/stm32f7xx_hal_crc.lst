  26:./src/stm32f7xx_hal_crc.c ****  ===============================================================================
  27:./src/stm32f7xx_hal_crc.c ****     [..]
  28:./src/stm32f7xx_hal_crc.c ****          (+) Enable CRC AHB clock using __HAL_RCC_CRC_CLK_ENABLE();
  29:./src/stm32f7xx_hal_crc.c ****          (+) Initialize CRC calculator
  30:./src/stm32f7xx_hal_crc.c ****              (++) specify generating polynomial (peripheral default or non-default one)
  31:./src/stm32f7xx_hal_crc.c ****              (++) specify initialization value (peripheral default or non-default one)
  32:./src/stm32f7xx_hal_crc.c ****              (++) specify input data format
  33:./src/stm32f7xx_hal_crc.c ****              (++) specify input or output data inversion mode if any
  34:./src/stm32f7xx_hal_crc.c ****          (+) Use HAL_CRC_Accumulate() function to compute the CRC value of the
  35:./src/stm32f7xx_hal_crc.c ****              input data buffer starting with the previously computed CRC as
  36:./src/stm32f7xx_hal_crc.c ****              initialization value
  37:./src/stm32f7xx_hal_crc.c ****          (+) Use HAL_CRC_Calculate() function to compute the CRC value of the
  38:./src/stm32f7xx_hal_crc.c ****              input data buffer starting with the defined initialization value
  39:./src/stm32f7xx_hal_crc.c ****              (default or non-default) to initiate CRC calculation
  40:./src/stm32f7xx_hal_crc.c **** 
  41:./src/stm32f7xx_hal_crc.c ****   @endverbatim
  42:./src/stm32f7xx_hal_crc.c ****   ******************************************************************************

 272:./src/stm32f7xx_hal_crc.c **** /**
 273:./src/stm32f7xx_hal_crc.c ****   * @brief  Compute the 7, 8, 16 or 32-bit CRC value of an 8, 16 or 32-bit data buffer
 274:./src/stm32f7xx_hal_crc.c ****   *         starting with the previously computed CRC as initialization value.
 275:./src/stm32f7xx_hal_crc.c ****   * @param  hcrc CRC handle
 276:./src/stm32f7xx_hal_crc.c ****   * @param  pBuffer pointer to the input data buffer, exact input data format is
 277:./src/stm32f7xx_hal_crc.c ****   *         provided by hcrc->InputDataFormat.
 278:./src/stm32f7xx_hal_crc.c ****   * @param  BufferLength input data buffer length (number of bytes if pBuffer
 279:./src/stm32f7xx_hal_crc.c ****   *         type is * uint8_t, number of half-words if pBuffer type is * uint16_t,
 280:./src/stm32f7xx_hal_crc.c ****   *         number of words if pBuffer type is * uint32_t).
 281:./src/stm32f7xx_hal_crc.c ****   * @note  By default, the API expects a uint32_t pointer as input buffer parameter.
 282:./src/stm32f7xx_hal_crc.c ****   *        Input buffer pointers with other types simply need to be cast in uint32_t
 283:./src/stm32f7xx_hal_crc.c ****   *        and the API will internally adjust its input data processing based on the
 284:./src/stm32f7xx_hal_crc.c ****   *        handle field hcrc->InputDataFormat.
 285:./src/stm32f7xx_hal_crc.c ****   * @retval uint32_t CRC (returned value LSBs for CRC shorter than 32 bits)
 286:./src/stm32f7xx_hal_crc.c ****   */
 287:./src/stm32f7xx_hal_crc.c **** uint32_t HAL_CRC_Accumulate(CRC_HandleTypeDef *hcrc, uint32_t pBuffer[], uint32_t BufferLength)
 288:./src/stm32f7xx_hal_crc.c **** {
 289:./src/stm32f7xx_hal_crc.c ****   uint32_t index;      /* CRC input data buffer index */
 290:./src/stm32f7xx_hal_crc.c ****   uint32_t temp = 0U;  /* CRC output (read from hcrc->Instance->DR register) */
 291:./src/stm32f7xx_hal_crc.c **** 
 292:./src/stm32f7xx_hal_crc.c ****   /* Change CRC peripheral state */
 293:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_BUSY;
 294:./src/stm32f7xx_hal_crc.c **** 
 295:./src/stm32f7xx_hal_crc.c ****   switch (hcrc->InputDataFormat)
 296:./src/stm32f7xx_hal_crc.c ****   {
 297:./src/stm32f7xx_hal_crc.c ****     case CRC_INPUTDATA_FORMAT_WORDS:
 298:./src/stm32f7xx_hal_crc.c ****       /* Enter Data to the CRC calculator */
 299:./src/stm32f7xx_hal_crc.c ****       for (index = 0U; index < BufferLength; index++)
 300:./src/stm32f7xx_hal_crc.c ****       {
 301:./src/stm32f7xx_hal_crc.c ****         hcrc->Instance->DR = pBuffer[index];
 302:./src/stm32f7xx_hal_crc.c ****       }
 303:./src/stm32f7xx_hal_crc.c ****       temp = hcrc->Instance->DR;
 304:./src/stm32f7xx_hal_crc.c ****       break;
 305:./src/stm32f7xx_hal_crc.c **** 
 306:./src/stm32f7xx_hal_crc.c ****     case CRC_INPUTDATA_FORMAT_BYTES:
 307:./src/stm32f7xx_hal_crc.c ****       temp = CRC_Handle_8(hcrc, (uint8_t *)pBuffer, BufferLength);
 308:./src/stm32f7xx_hal_crc.c ****       break;
 309:./src/stm32f7xx_hal_crc.c **** 
 310:./src/stm32f7xx_hal_crc.c ****     case CRC_INPUTDATA_FORMAT_HALFWORDS:
 311:./src/stm32f7xx_hal_crc.c ****       temp = CRC_Handle_16(hcrc, (uint16_t *)(void *)pBuffer, BufferLength);    /* Derogation Misra
 312:./src/stm32f7xx_hal_crc.c ****       break;
 313:./src/stm32f7xx_hal_crc.c ****     default:
 314:./src/stm32f7xx_hal_crc.c ****       break;
 315:./src/stm32f7xx_hal_crc.c ****   }
 316:./src/stm32f7xx_hal_crc.c **** 
 317:./src/stm32f7xx_hal_crc.c ****   /* Change CRC peripheral state */
 318:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_READY;
 319:./src/stm32f7xx_hal_crc.c **** 
 320:./src/stm32f7xx_hal_crc.c ****   /* Return the CRC computed value */
 321:./src/stm32f7xx_hal_crc.c ****   return temp;
 322:./src/stm32f7xx_hal_crc.c **** }
 323:./src/stm32f7xx_hal_crc.c **** 
 324:./src/stm32f7xx_hal_crc.c **** /**
 325:./src/stm32f7xx_hal_crc.c ****   * @brief  Compute the 7, 8, 16 or 32-bit CRC value of an 8, 16 or 32-bit data buffer
 326:./src/stm32f7xx_hal_crc.c ****   *         starting with hcrc->Instance->INIT as initialization value.

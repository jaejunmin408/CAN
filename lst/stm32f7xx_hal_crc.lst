 179:./src/stm32f7xx_hal_crc.c **** HAL_StatusTypeDef HAL_CRC_DeInit(CRC_HandleTypeDef *hcrc)
 180:./src/stm32f7xx_hal_crc.c **** {
 181:./src/stm32f7xx_hal_crc.c ****   /* Check the CRC handle allocation */
 182:./src/stm32f7xx_hal_crc.c ****   if (hcrc == NULL)
 183:./src/stm32f7xx_hal_crc.c ****   {
 184:./src/stm32f7xx_hal_crc.c ****     return HAL_ERROR;
 185:./src/stm32f7xx_hal_crc.c ****   }
 186:./src/stm32f7xx_hal_crc.c **** 
 187:./src/stm32f7xx_hal_crc.c ****   /* Check the parameters */
 188:./src/stm32f7xx_hal_crc.c ****   assert_param(IS_CRC_ALL_INSTANCE(hcrc->Instance));
 189:./src/stm32f7xx_hal_crc.c **** 
 190:./src/stm32f7xx_hal_crc.c ****   /* Check the CRC peripheral state */
 191:./src/stm32f7xx_hal_crc.c ****   if (hcrc->State == HAL_CRC_STATE_BUSY)
 192:./src/stm32f7xx_hal_crc.c ****   {
 193:./src/stm32f7xx_hal_crc.c ****     return HAL_BUSY;
 194:./src/stm32f7xx_hal_crc.c ****   }
 195:./src/stm32f7xx_hal_crc.c **** 
 196:./src/stm32f7xx_hal_crc.c ****   /* Change CRC peripheral state */
 197:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_BUSY;
 198:./src/stm32f7xx_hal_crc.c **** 
 199:./src/stm32f7xx_hal_crc.c ****   /* Reset CRC calculation unit */
 200:./src/stm32f7xx_hal_crc.c ****   __HAL_CRC_DR_RESET(hcrc);
 201:./src/stm32f7xx_hal_crc.c **** 
 202:./src/stm32f7xx_hal_crc.c ****   /* Reset IDR register content */
 203:./src/stm32f7xx_hal_crc.c ****   __HAL_CRC_SET_IDR(hcrc, 0);
 204:./src/stm32f7xx_hal_crc.c **** 
 205:./src/stm32f7xx_hal_crc.c ****   /* DeInit the low level hardware */
 206:./src/stm32f7xx_hal_crc.c ****   HAL_CRC_MspDeInit(hcrc);
 207:./src/stm32f7xx_hal_crc.c **** 
 208:./src/stm32f7xx_hal_crc.c ****   /* Change CRC peripheral state */
 209:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_RESET;
 210:./src/stm32f7xx_hal_crc.c **** 
 211:./src/stm32f7xx_hal_crc.c ****   /* Process unlocked */
 212:./src/stm32f7xx_hal_crc.c ****   __HAL_UNLOCK(hcrc);
 213:./src/stm32f7xx_hal_crc.c **** 
 214:./src/stm32f7xx_hal_crc.c ****   /* Return function status */
 215:./src/stm32f7xx_hal_crc.c ****   return HAL_OK;
 216:./src/stm32f7xx_hal_crc.c **** }

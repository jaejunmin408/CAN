 353:./src/stm32f7xx_hal_crc.c ****     case CRC_INPUTDATA_FORMAT_WORDS:
 354:./src/stm32f7xx_hal_crc.c ****       /* Enter 32-bit input data to the CRC calculator */
 355:./src/stm32f7xx_hal_crc.c ****       for (index = 0U; index < BufferLength; index++)
 356:./src/stm32f7xx_hal_crc.c ****       {
 357:./src/stm32f7xx_hal_crc.c ****         hcrc->Instance->DR = pBuffer[index];
 358:./src/stm32f7xx_hal_crc.c ****       }
 359:./src/stm32f7xx_hal_crc.c ****       temp = hcrc->Instance->DR;
 360:./src/stm32f7xx_hal_crc.c ****       break;
 361:./src/stm32f7xx_hal_crc.c **** 
 362:./src/stm32f7xx_hal_crc.c ****     case CRC_INPUTDATA_FORMAT_BYTES:
 363:./src/stm32f7xx_hal_crc.c ****       /* Specific 8-bit input data handling  */
 364:./src/stm32f7xx_hal_crc.c ****       temp = CRC_Handle_8(hcrc, (uint8_t *)pBuffer, BufferLength);
 365:./src/stm32f7xx_hal_crc.c ****       break;
 366:./src/stm32f7xx_hal_crc.c **** 
 367:./src/stm32f7xx_hal_crc.c ****     case CRC_INPUTDATA_FORMAT_HALFWORDS:
 368:./src/stm32f7xx_hal_crc.c ****       /* Specific 16-bit input data handling  */
 369:./src/stm32f7xx_hal_crc.c ****       temp = CRC_Handle_16(hcrc, (uint16_t *)(void *)pBuffer, BufferLength);    /* Derogation Misra
 370:./src/stm32f7xx_hal_crc.c ****       break;
 371:./src/stm32f7xx_hal_crc.c **** 
 372:./src/stm32f7xx_hal_crc.c ****     default:
 373:./src/stm32f7xx_hal_crc.c ****       break;
 374:./src/stm32f7xx_hal_crc.c ****   }
 375:./src/stm32f7xx_hal_crc.c **** 
 376:./src/stm32f7xx_hal_crc.c ****   /* Change CRC peripheral state */
 377:./src/stm32f7xx_hal_crc.c ****   hcrc->State = HAL_CRC_STATE_READY;
 378:./src/stm32f7xx_hal_crc.c **** 
 379:./src/stm32f7xx_hal_crc.c ****   /* Return the CRC computed value */
 380:./src/stm32f7xx_hal_crc.c ****   return temp;
 381:./src/stm32f7xx_hal_crc.c **** }

  74:./src/stm32f7xx_hal_crc_ex.c **** /**
  75:./src/stm32f7xx_hal_crc_ex.c ****   * @brief  Initialize the CRC polynomial if different from default one.
  76:./src/stm32f7xx_hal_crc_ex.c ****   * @param  hcrc CRC handle
  77:./src/stm32f7xx_hal_crc_ex.c ****   * @param  Pol CRC generating polynomial (7, 8, 16 or 32-bit long).
  78:./src/stm32f7xx_hal_crc_ex.c ****   *         This parameter is written in normal representation, e.g.
  79:./src/stm32f7xx_hal_crc_ex.c ****   *         @arg for a polynomial of degree 7, X^7 + X^6 + X^5 + X^2 + 1 is written 0x65
  80:./src/stm32f7xx_hal_crc_ex.c ****   *         @arg for a polynomial of degree 16, X^16 + X^12 + X^5 + 1 is written 0x1021
  81:./src/stm32f7xx_hal_crc_ex.c ****   * @param  PolyLength CRC polynomial length.
  82:./src/stm32f7xx_hal_crc_ex.c ****   *         This parameter can be one of the following values:
  83:./src/stm32f7xx_hal_crc_ex.c ****   *          @arg @ref CRC_POLYLENGTH_7B  7-bit long CRC (generating polynomial of degree 7)
  84:./src/stm32f7xx_hal_crc_ex.c ****   *          @arg @ref CRC_POLYLENGTH_8B  8-bit long CRC (generating polynomial of degree 8)
  85:./src/stm32f7xx_hal_crc_ex.c ****   *          @arg @ref CRC_POLYLENGTH_16B 16-bit long CRC (generating polynomial of degree 16)
  86:./src/stm32f7xx_hal_crc_ex.c ****   *          @arg @ref CRC_POLYLENGTH_32B 32-bit long CRC (generating polynomial of degree 32)
  87:./src/stm32f7xx_hal_crc_ex.c ****   * @retval HAL status
  88:./src/stm32f7xx_hal_crc_ex.c ****   */

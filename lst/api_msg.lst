1535:./lwip-2.1.2/src/api/api_msg.c **** 
1536:./lwip-2.1.2/src/api/api_msg.c ****   err_t err = netconn_err(msg->conn);
1537:./lwip-2.1.2/src/api/api_msg.c ****   if (err == ERR_OK) {
1538:./lwip-2.1.2/src/api/api_msg.c ****     if (msg->conn->pcb.tcp != NULL) {
1539:./lwip-2.1.2/src/api/api_msg.c ****       switch (NETCONNTYPE_GROUP(msg->conn->type)) {
1540:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_RAW
1541:./lwip-2.1.2/src/api/api_msg.c ****         case NETCONN_RAW:
1542:./lwip-2.1.2/src/api/api_msg.c ****           if (ip_addr_isany(&msg->msg.b->addr) || IP_IS_ANY_TYPE_VAL(msg->msg.b->addr)) {
1543:./lwip-2.1.2/src/api/api_msg.c ****             err = raw_send(msg->conn->pcb.raw, msg->msg.b->p);
1544:./lwip-2.1.2/src/api/api_msg.c ****           } else {
1545:./lwip-2.1.2/src/api/api_msg.c ****             err = raw_sendto(msg->conn->pcb.raw, msg->msg.b->p, &msg->msg.b->addr);
1546:./lwip-2.1.2/src/api/api_msg.c ****           }
1547:./lwip-2.1.2/src/api/api_msg.c ****           break;
1548:./lwip-2.1.2/src/api/api_msg.c **** #endif
1549:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_UDP
1550:./lwip-2.1.2/src/api/api_msg.c ****         case NETCONN_UDP:
1551:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_CHECKSUM_ON_COPY
1552:./lwip-2.1.2/src/api/api_msg.c ****           if (ip_addr_isany(&msg->msg.b->addr) || IP_IS_ANY_TYPE_VAL(msg->msg.b->addr)) {
1553:./lwip-2.1.2/src/api/api_msg.c ****             err = udp_send_chksum(msg->conn->pcb.udp, msg->msg.b->p,
1554:./lwip-2.1.2/src/api/api_msg.c ****                                   msg->msg.b->flags & NETBUF_FLAG_CHKSUM, msg->msg.b->toport_chksum
1555:./lwip-2.1.2/src/api/api_msg.c ****           } else {
1556:./lwip-2.1.2/src/api/api_msg.c ****             err = udp_sendto_chksum(msg->conn->pcb.udp, msg->msg.b->p,
1557:./lwip-2.1.2/src/api/api_msg.c ****                                     &msg->msg.b->addr, msg->msg.b->port,
1558:./lwip-2.1.2/src/api/api_msg.c ****                                     msg->msg.b->flags & NETBUF_FLAG_CHKSUM, msg->msg.b->toport_chks
1559:./lwip-2.1.2/src/api/api_msg.c ****           }

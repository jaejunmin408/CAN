 527:./lwip-2.1.2/src/api/api_msg.c ****  * Accept callback function for TCP netconns.
 528:./lwip-2.1.2/src/api/api_msg.c ****  * Allocates a new netconn and posts that to conn->acceptmbox.
 529:./lwip-2.1.2/src/api/api_msg.c ****  *
 530:./lwip-2.1.2/src/api/api_msg.c ****  * @see tcp.h (struct tcp_pcb_listen.accept) for parameters and return value
 531:./lwip-2.1.2/src/api/api_msg.c ****  */
 532:./lwip-2.1.2/src/api/api_msg.c **** static err_t
 533:./lwip-2.1.2/src/api/api_msg.c **** accept_function(void *arg, struct tcp_pcb *newpcb, err_t err)
 534:./lwip-2.1.2/src/api/api_msg.c **** {
 535:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *newconn;
 536:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *conn = (struct netconn *)arg;
 537:./lwip-2.1.2/src/api/api_msg.c **** 
 538:./lwip-2.1.2/src/api/api_msg.c ****   if (conn == NULL) {
 539:./lwip-2.1.2/src/api/api_msg.c ****     return ERR_VAL;
 540:./lwip-2.1.2/src/api/api_msg.c ****   }
 541:./lwip-2.1.2/src/api/api_msg.c ****   if (!NETCONN_MBOX_VALID(conn, &conn->acceptmbox)) {
 542:./lwip-2.1.2/src/api/api_msg.c ****     LWIP_DEBUGF(API_MSG_DEBUG, ("accept_function: acceptmbox already deleted\n"));
 543:./lwip-2.1.2/src/api/api_msg.c ****     return ERR_VAL;
 544:./lwip-2.1.2/src/api/api_msg.c ****   }
 545:./lwip-2.1.2/src/api/api_msg.c **** 
 546:./lwip-2.1.2/src/api/api_msg.c ****   if (newpcb == NULL) {
 547:./lwip-2.1.2/src/api/api_msg.c ****     /* out-of-pcbs during connect: pass on this error to the application */
 548:./lwip-2.1.2/src/api/api_msg.c ****     if (sys_mbox_trypost(&conn->acceptmbox, lwip_netconn_err_to_msg(ERR_ABRT)) == ERR_OK) {
 549:./lwip-2.1.2/src/api/api_msg.c ****       /* Register event with callback */
 550:./lwip-2.1.2/src/api/api_msg.c ****       API_EVENT(conn, NETCONN_EVT_RCVPLUS, 0);
 551:./lwip-2.1.2/src/api/api_msg.c ****     }
 552:./lwip-2.1.2/src/api/api_msg.c ****     return ERR_VAL;
 553:./lwip-2.1.2/src/api/api_msg.c ****   }
 554:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("expect newpcb == NULL or err == ERR_OK", err == ERR_OK);
 555:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_UNUSED_ARG(err); /* for LWIP_NOASSERT */
 556:./lwip-2.1.2/src/api/api_msg.c **** 
 557:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_DEBUGF(API_MSG_DEBUG, ("accept_function: newpcb->state: %s\n", tcp_debug_state_str(newpcb->s
 558:./lwip-2.1.2/src/api/api_msg.c **** 
 559:./lwip-2.1.2/src/api/api_msg.c ****   /* We have to set the callback here even though
 560:./lwip-2.1.2/src/api/api_msg.c ****    * the new socket is unknown. newconn->socket is marked as -1. */
 561:./lwip-2.1.2/src/api/api_msg.c ****   newconn = netconn_alloc(conn->type, conn->callback);
 562:./lwip-2.1.2/src/api/api_msg.c ****   if (newconn == NULL) {
 563:./lwip-2.1.2/src/api/api_msg.c ****     /* outof netconns: pass on this error to the application */
 564:./lwip-2.1.2/src/api/api_msg.c ****     if (sys_mbox_trypost(&conn->acceptmbox, lwip_netconn_err_to_msg(ERR_ABRT)) == ERR_OK) {
 565:./lwip-2.1.2/src/api/api_msg.c ****       /* Register event with callback */
 566:./lwip-2.1.2/src/api/api_msg.c ****       API_EVENT(conn, NETCONN_EVT_RCVPLUS, 0);
 567:./lwip-2.1.2/src/api/api_msg.c ****     }
 568:./lwip-2.1.2/src/api/api_msg.c ****     return ERR_MEM;
 569:./lwip-2.1.2/src/api/api_msg.c ****   }
 570:./lwip-2.1.2/src/api/api_msg.c ****   newconn->pcb.tcp = newpcb;
 571:./lwip-2.1.2/src/api/api_msg.c ****   setup_tcp(newconn);
 572:./lwip-2.1.2/src/api/api_msg.c **** 
 573:./lwip-2.1.2/src/api/api_msg.c ****   /* handle backlog counter */
 574:./lwip-2.1.2/src/api/api_msg.c ****   tcp_backlog_delayed(newpcb);
 575:./lwip-2.1.2/src/api/api_msg.c **** 
 576:./lwip-2.1.2/src/api/api_msg.c ****   if (sys_mbox_trypost(&conn->acceptmbox, newconn) != ERR_OK) {
 577:./lwip-2.1.2/src/api/api_msg.c ****     /* When returning != ERR_OK, the pcb is aborted in tcp_process(),
 578:./lwip-2.1.2/src/api/api_msg.c ****        so do nothing here! */
 579:./lwip-2.1.2/src/api/api_msg.c ****     /* remove all references to this netconn from the pcb */
 580:./lwip-2.1.2/src/api/api_msg.c ****     struct tcp_pcb *pcb = newconn->pcb.tcp;
 581:./lwip-2.1.2/src/api/api_msg.c ****     tcp_arg(pcb, NULL);

1588:./lwip-2.1.2/src/api/api_msg.c **** void
1589:./lwip-2.1.2/src/api/api_msg.c **** lwip_netconn_do_recv(void *m)
1590:./lwip-2.1.2/src/api/api_msg.c **** {
1591:./lwip-2.1.2/src/api/api_msg.c ****   struct api_msg *msg = (struct api_msg *)m;
1592:./lwip-2.1.2/src/api/api_msg.c **** 
1593:./lwip-2.1.2/src/api/api_msg.c ****   msg->err = ERR_OK;
1594:./lwip-2.1.2/src/api/api_msg.c ****   if (msg->conn->pcb.tcp != NULL) {
1595:./lwip-2.1.2/src/api/api_msg.c ****     if (NETCONNTYPE_GROUP(msg->conn->type) == NETCONN_TCP) {
1596:./lwip-2.1.2/src/api/api_msg.c ****       size_t remaining = msg->msg.r.len;
1597:./lwip-2.1.2/src/api/api_msg.c ****       do {
1598:./lwip-2.1.2/src/api/api_msg.c ****         u16_t recved = (u16_t)((remaining > 0xffff) ? 0xffff : remaining);
1599:./lwip-2.1.2/src/api/api_msg.c ****         tcp_recved(msg->conn->pcb.tcp, recved);
1600:./lwip-2.1.2/src/api/api_msg.c ****         remaining -= recved;
1601:./lwip-2.1.2/src/api/api_msg.c ****       } while (remaining != 0);
1602:./lwip-2.1.2/src/api/api_msg.c ****     }
1603:./lwip-2.1.2/src/api/api_msg.c ****   }
1604:./lwip-2.1.2/src/api/api_msg.c ****   TCPIP_APIMSG_ACK(msg);
1605:./lwip-2.1.2/src/api/api_msg.c **** }

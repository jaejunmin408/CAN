1442:./lwip-2.1.2/src/api/api_msg.c **** /**
1443:./lwip-2.1.2/src/api/api_msg.c ****  * Set a TCP pcb contained in a netconn into listen mode
1444:./lwip-2.1.2/src/api/api_msg.c ****  * Called from netconn_listen.
1445:./lwip-2.1.2/src/api/api_msg.c ****  *
1446:./lwip-2.1.2/src/api/api_msg.c ****  * @param m the api_msg pointing to the connection
1447:./lwip-2.1.2/src/api/api_msg.c ****  */
1448:./lwip-2.1.2/src/api/api_msg.c **** void
1449:./lwip-2.1.2/src/api/api_msg.c **** lwip_netconn_do_listen(void *m)
1450:./lwip-2.1.2/src/api/api_msg.c **** {
1451:./lwip-2.1.2/src/api/api_msg.c ****   struct api_msg *msg = (struct api_msg *)m;
1452:./lwip-2.1.2/src/api/api_msg.c ****   err_t err;
1453:./lwip-2.1.2/src/api/api_msg.c **** 
1454:./lwip-2.1.2/src/api/api_msg.c ****   if (msg->conn->pcb.tcp != NULL) {
1455:./lwip-2.1.2/src/api/api_msg.c ****     if (NETCONNTYPE_GROUP(msg->conn->type) == NETCONN_TCP) {
1456:./lwip-2.1.2/src/api/api_msg.c ****       if (msg->conn->state == NETCONN_NONE) {
1457:./lwip-2.1.2/src/api/api_msg.c ****         struct tcp_pcb *lpcb;
1458:./lwip-2.1.2/src/api/api_msg.c ****         if (msg->conn->pcb.tcp->state != CLOSED) {
1459:./lwip-2.1.2/src/api/api_msg.c ****           /* connection is not closed, cannot listen */
1460:./lwip-2.1.2/src/api/api_msg.c ****           err = ERR_VAL;
1461:./lwip-2.1.2/src/api/api_msg.c ****         } else {
1462:./lwip-2.1.2/src/api/api_msg.c ****           u8_t backlog;
1463:./lwip-2.1.2/src/api/api_msg.c **** #if TCP_LISTEN_BACKLOG
1464:./lwip-2.1.2/src/api/api_msg.c ****           backlog = msg->msg.lb.backlog;
1465:./lwip-2.1.2/src/api/api_msg.c **** #else  /* TCP_LISTEN_BACKLOG */
1466:./lwip-2.1.2/src/api/api_msg.c ****           backlog = TCP_DEFAULT_LISTEN_BACKLOG;
1467:./lwip-2.1.2/src/api/api_msg.c **** #endif /* TCP_LISTEN_BACKLOG */
1468:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_IPV4 && LWIP_IPV6
1469:./lwip-2.1.2/src/api/api_msg.c ****           /* "Socket API like" dual-stack support: If IP to listen to is IP6_ADDR_ANY,
1470:./lwip-2.1.2/src/api/api_msg.c ****             * and NETCONN_FLAG_IPV6_V6ONLY is NOT set, use IP_ANY_TYPE to listen
1471:./lwip-2.1.2/src/api/api_msg.c ****             */
1472:./lwip-2.1.2/src/api/api_msg.c ****           if (ip_addr_cmp(&msg->conn->pcb.ip->local_ip, IP6_ADDR_ANY) &&
1473:./lwip-2.1.2/src/api/api_msg.c ****               (netconn_get_ipv6only(msg->conn) == 0)) {
1474:./lwip-2.1.2/src/api/api_msg.c ****             /* change PCB type to IPADDR_TYPE_ANY */
1475:./lwip-2.1.2/src/api/api_msg.c ****             IP_SET_TYPE_VAL(msg->conn->pcb.tcp->local_ip,  IPADDR_TYPE_ANY);
1476:./lwip-2.1.2/src/api/api_msg.c ****             IP_SET_TYPE_VAL(msg->conn->pcb.tcp->remote_ip, IPADDR_TYPE_ANY);
1477:./lwip-2.1.2/src/api/api_msg.c ****           }
1478:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_IPV4 && LWIP_IPV6 */
1479:./lwip-2.1.2/src/api/api_msg.c **** 
1480:./lwip-2.1.2/src/api/api_msg.c ****           lpcb = tcp_listen_with_backlog_and_err(msg->conn->pcb.tcp, backlog, &err);
1481:./lwip-2.1.2/src/api/api_msg.c **** 
1482:./lwip-2.1.2/src/api/api_msg.c ****           if (lpcb == NULL) {
1483:./lwip-2.1.2/src/api/api_msg.c ****             /* in this case, the old pcb is still allocated */
1484:./lwip-2.1.2/src/api/api_msg.c ****           } else {
1485:./lwip-2.1.2/src/api/api_msg.c ****             /* delete the recvmbox and allocate the acceptmbox */
1486:./lwip-2.1.2/src/api/api_msg.c ****             if (sys_mbox_valid(&msg->conn->recvmbox)) {
1487:./lwip-2.1.2/src/api/api_msg.c ****               /** @todo: should we drain the recvmbox here? */
1488:./lwip-2.1.2/src/api/api_msg.c ****               sys_mbox_free(&msg->conn->recvmbox);
1489:./lwip-2.1.2/src/api/api_msg.c ****               sys_mbox_set_invalid(&msg->conn->recvmbox);
1490:./lwip-2.1.2/src/api/api_msg.c ****             }
1491:./lwip-2.1.2/src/api/api_msg.c ****             err = ERR_OK;
1492:./lwip-2.1.2/src/api/api_msg.c ****             if (!sys_mbox_valid(&msg->conn->acceptmbox)) {
1493:./lwip-2.1.2/src/api/api_msg.c ****               err = sys_mbox_new(&msg->conn->acceptmbox, DEFAULT_ACCEPTMBOX_SIZE);
1494:./lwip-2.1.2/src/api/api_msg.c ****             }
1495:./lwip-2.1.2/src/api/api_msg.c ****             if (err == ERR_OK) {
1496:./lwip-2.1.2/src/api/api_msg.c ****               msg->conn->state = NETCONN_LISTEN;
1497:./lwip-2.1.2/src/api/api_msg.c ****               msg->conn->pcb.tcp = lpcb;
1498:./lwip-2.1.2/src/api/api_msg.c ****               tcp_arg(msg->conn->pcb.tcp, msg->conn);
1499:./lwip-2.1.2/src/api/api_msg.c ****               tcp_accept(msg->conn->pcb.tcp, accept_function);
1500:./lwip-2.1.2/src/api/api_msg.c ****             } else {
1501:./lwip-2.1.2/src/api/api_msg.c ****               /* since the old pcb is already deallocated, free lpcb now */
1502:./lwip-2.1.2/src/api/api_msg.c ****               tcp_close(lpcb);
1503:./lwip-2.1.2/src/api/api_msg.c ****               msg->conn->pcb.tcp = NULL;
1504:./lwip-2.1.2/src/api/api_msg.c ****             }
1505:./lwip-2.1.2/src/api/api_msg.c ****           }
1506:./lwip-2.1.2/src/api/api_msg.c ****         }
1507:./lwip-2.1.2/src/api/api_msg.c ****       } else if (msg->conn->state == NETCONN_LISTEN) {
1508:./lwip-2.1.2/src/api/api_msg.c ****         /* already listening, allow updating of the backlog */
1509:./lwip-2.1.2/src/api/api_msg.c ****         err = ERR_OK;
1510:./lwip-2.1.2/src/api/api_msg.c ****         tcp_backlog_set(msg->conn->pcb.tcp, msg->msg.lb.backlog);
1511:./lwip-2.1.2/src/api/api_msg.c ****       } else {
1512:./lwip-2.1.2/src/api/api_msg.c ****         err = ERR_CONN;
1513:./lwip-2.1.2/src/api/api_msg.c ****       }
1514:./lwip-2.1.2/src/api/api_msg.c ****     } else {
1515:./lwip-2.1.2/src/api/api_msg.c ****       err = ERR_ARG;
1516:./lwip-2.1.2/src/api/api_msg.c ****     }
1517:./lwip-2.1.2/src/api/api_msg.c ****   } else {
1518:./lwip-2.1.2/src/api/api_msg.c ****     err = ERR_CONN;
1519:./lwip-2.1.2/src/api/api_msg.c ****   }
1520:./lwip-2.1.2/src/api/api_msg.c ****   msg->err = err;
1521:./lwip-2.1.2/src/api/api_msg.c ****   TCPIP_APIMSG_ACK(msg);
1522:./lwip-2.1.2/src/api/api_msg.c **** }
1523:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */

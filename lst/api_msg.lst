1124:./lwip-2.1.2/src/api/api_msg.c ****         ((state == NETCONN_CONNECT) && !IN_NONBLOCKING_CONNECT(msg->conn))) {
1125:./lwip-2.1.2/src/api/api_msg.c ****       /* close requested, abort running write/connect */

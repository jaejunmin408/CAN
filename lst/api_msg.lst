 107:./lwip-2.1.2/src/api/api_msg.c **** 
 108:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 109:./lwip-2.1.2/src/api/api_msg.c **** const u8_t netconn_aborted = 0;
 110:./lwip-2.1.2/src/api/api_msg.c **** const u8_t netconn_reset = 0;
 111:./lwip-2.1.2/src/api/api_msg.c **** const u8_t netconn_closed = 0;
 112:./lwip-2.1.2/src/api/api_msg.c **** 
 113:./lwip-2.1.2/src/api/api_msg.c **** /** Translate an error to a unique void* passed via an mbox */
 114:./lwip-2.1.2/src/api/api_msg.c **** static void *
 115:./lwip-2.1.2/src/api/api_msg.c **** lwip_netconn_err_to_msg(err_t err)
 116:./lwip-2.1.2/src/api/api_msg.c **** {
 117:./lwip-2.1.2/src/api/api_msg.c ****   switch (err) {
 118:./lwip-2.1.2/src/api/api_msg.c ****     case ERR_ABRT:
 119:./lwip-2.1.2/src/api/api_msg.c ****       return LWIP_CONST_CAST(void *, &netconn_aborted);
 120:./lwip-2.1.2/src/api/api_msg.c ****     case ERR_RST:
 121:./lwip-2.1.2/src/api/api_msg.c ****       return LWIP_CONST_CAST(void *, &netconn_reset);
 122:./lwip-2.1.2/src/api/api_msg.c ****     case ERR_CLSD:
 123:./lwip-2.1.2/src/api/api_msg.c ****       return LWIP_CONST_CAST(void *, &netconn_closed);
 124:./lwip-2.1.2/src/api/api_msg.c ****     default:
 125:./lwip-2.1.2/src/api/api_msg.c ****       LWIP_ASSERT("unhandled error", err == ERR_OK);
 126:./lwip-2.1.2/src/api/api_msg.c ****       return NULL;
 127:./lwip-2.1.2/src/api/api_msg.c ****   }
 128:./lwip-2.1.2/src/api/api_msg.c **** }
 129:./lwip-2.1.2/src/api/api_msg.c **** 
 130:./lwip-2.1.2/src/api/api_msg.c **** int
 131:./lwip-2.1.2/src/api/api_msg.c **** lwip_netconn_is_err_msg(void *msg, err_t *err)
 132:./lwip-2.1.2/src/api/api_msg.c **** {
 133:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("err != NULL", err != NULL);
 134:./lwip-2.1.2/src/api/api_msg.c **** 
 135:./lwip-2.1.2/src/api/api_msg.c ****   if (msg == &netconn_aborted) {
 136:./lwip-2.1.2/src/api/api_msg.c ****     *err = ERR_ABRT;
 137:./lwip-2.1.2/src/api/api_msg.c ****     return 1;
 138:./lwip-2.1.2/src/api/api_msg.c ****   } else if (msg == &netconn_reset) {
 139:./lwip-2.1.2/src/api/api_msg.c ****     *err = ERR_RST;
 140:./lwip-2.1.2/src/api/api_msg.c ****     return 1;
 141:./lwip-2.1.2/src/api/api_msg.c ****   } else if (msg == &netconn_closed) {
 142:./lwip-2.1.2/src/api/api_msg.c ****     *err = ERR_CLSD;
 143:./lwip-2.1.2/src/api/api_msg.c ****     return 1;
 144:./lwip-2.1.2/src/api/api_msg.c ****   }
 145:./lwip-2.1.2/src/api/api_msg.c ****   return 0;
 146:./lwip-2.1.2/src/api/api_msg.c **** }
 147:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 148:./lwip-2.1.2/src/api/api_msg.c **** 
 149:./lwip-2.1.2/src/api/api_msg.c **** 
 150:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_RAW
 151:./lwip-2.1.2/src/api/api_msg.c **** /**
 152:./lwip-2.1.2/src/api/api_msg.c ****  * Receive callback function for RAW netconns.
 153:./lwip-2.1.2/src/api/api_msg.c ****  * Doesn't 'eat' the packet, only copies it and sends it to
 154:./lwip-2.1.2/src/api/api_msg.c ****  * conn->recvmbox
 155:./lwip-2.1.2/src/api/api_msg.c ****  *
 156:./lwip-2.1.2/src/api/api_msg.c ****  * @see raw.h (struct raw_pcb.recv) for parameters and return value
 157:./lwip-2.1.2/src/api/api_msg.c ****  */
 158:./lwip-2.1.2/src/api/api_msg.c **** static u8_t
 159:./lwip-2.1.2/src/api/api_msg.c **** recv_raw(void *arg, struct raw_pcb *pcb, struct pbuf *p,
 160:./lwip-2.1.2/src/api/api_msg.c ****          const ip_addr_t *addr)
 161:./lwip-2.1.2/src/api/api_msg.c **** {
 162:./lwip-2.1.2/src/api/api_msg.c ****   struct pbuf *q;
 163:./lwip-2.1.2/src/api/api_msg.c ****   struct netbuf *buf;
 164:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *conn;
 165:./lwip-2.1.2/src/api/api_msg.c **** 
 166:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_UNUSED_ARG(addr);
 167:./lwip-2.1.2/src/api/api_msg.c ****   conn = (struct netconn *)arg;
 168:./lwip-2.1.2/src/api/api_msg.c **** 
 169:./lwip-2.1.2/src/api/api_msg.c ****   if ((conn != NULL) && NETCONN_MBOX_VALID(conn, &conn->recvmbox)) {
 170:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_RCVBUF
 171:./lwip-2.1.2/src/api/api_msg.c ****     int recv_avail;
 172:./lwip-2.1.2/src/api/api_msg.c ****     SYS_ARCH_GET(conn->recv_avail, recv_avail);
 173:./lwip-2.1.2/src/api/api_msg.c ****     if ((recv_avail + (int)(p->tot_len)) > conn->recv_bufsize) {
 174:./lwip-2.1.2/src/api/api_msg.c ****       return 0;
 175:./lwip-2.1.2/src/api/api_msg.c ****     }
 176:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_RCVBUF */
 177:./lwip-2.1.2/src/api/api_msg.c ****     /* copy the whole packet into new pbufs */
 178:./lwip-2.1.2/src/api/api_msg.c ****     q = pbuf_clone(PBUF_RAW, PBUF_RAM, p);
 179:./lwip-2.1.2/src/api/api_msg.c ****     if (q != NULL) {
 180:./lwip-2.1.2/src/api/api_msg.c ****       u16_t len;
 181:./lwip-2.1.2/src/api/api_msg.c ****       buf = (struct netbuf *)memp_malloc(MEMP_NETBUF);
 182:./lwip-2.1.2/src/api/api_msg.c ****       if (buf == NULL) {
 183:./lwip-2.1.2/src/api/api_msg.c ****         pbuf_free(q);
 184:./lwip-2.1.2/src/api/api_msg.c ****         return 0;
 185:./lwip-2.1.2/src/api/api_msg.c ****       }
 186:./lwip-2.1.2/src/api/api_msg.c **** 
 187:./lwip-2.1.2/src/api/api_msg.c ****       buf->p = q;
 188:./lwip-2.1.2/src/api/api_msg.c ****       buf->ptr = q;
 189:./lwip-2.1.2/src/api/api_msg.c ****       ip_addr_copy(buf->addr, *ip_current_src_addr());
 190:./lwip-2.1.2/src/api/api_msg.c ****       buf->port = pcb->protocol;
 191:./lwip-2.1.2/src/api/api_msg.c **** 
 192:./lwip-2.1.2/src/api/api_msg.c ****       len = q->tot_len;
 193:./lwip-2.1.2/src/api/api_msg.c ****       if (sys_mbox_trypost(&conn->recvmbox, buf) != ERR_OK) {
 194:./lwip-2.1.2/src/api/api_msg.c ****         netbuf_delete(buf);
 195:./lwip-2.1.2/src/api/api_msg.c ****         return 0;
 196:./lwip-2.1.2/src/api/api_msg.c ****       } else {
 197:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_RCVBUF
 198:./lwip-2.1.2/src/api/api_msg.c ****         SYS_ARCH_INC(conn->recv_avail, len);
 199:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_RCVBUF */
 200:./lwip-2.1.2/src/api/api_msg.c ****         /* Register event with callback */
 201:./lwip-2.1.2/src/api/api_msg.c ****         API_EVENT(conn, NETCONN_EVT_RCVPLUS, len);
 202:./lwip-2.1.2/src/api/api_msg.c ****       }
 203:./lwip-2.1.2/src/api/api_msg.c ****     }
 204:./lwip-2.1.2/src/api/api_msg.c ****   }
 205:./lwip-2.1.2/src/api/api_msg.c **** 
 206:./lwip-2.1.2/src/api/api_msg.c ****   return 0; /* do not eat the packet */
 207:./lwip-2.1.2/src/api/api_msg.c **** }
 208:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_RAW*/
 209:./lwip-2.1.2/src/api/api_msg.c **** 
 210:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_UDP
 211:./lwip-2.1.2/src/api/api_msg.c **** /**
 212:./lwip-2.1.2/src/api/api_msg.c ****  * Receive callback function for UDP netconns.
 213:./lwip-2.1.2/src/api/api_msg.c ****  * Posts the packet to conn->recvmbox or deletes it on memory error.
 214:./lwip-2.1.2/src/api/api_msg.c ****  *
 215:./lwip-2.1.2/src/api/api_msg.c ****  * @see udp.h (struct udp_pcb.recv) for parameters
 216:./lwip-2.1.2/src/api/api_msg.c ****  */
 217:./lwip-2.1.2/src/api/api_msg.c **** static void
 218:./lwip-2.1.2/src/api/api_msg.c **** recv_udp(void *arg, struct udp_pcb *pcb, struct pbuf *p,
 219:./lwip-2.1.2/src/api/api_msg.c ****          const ip_addr_t *addr, u16_t port)
 220:./lwip-2.1.2/src/api/api_msg.c **** {
  28              		.loc 1 220 1 view -0
  29              		.cfi_startproc
  30              		@ args = 4, pretend = 0, frame = 0

 773:./inc/cmsis_gcc.h ****   return 0U;
 774:./inc/cmsis_gcc.h **** #else
 775:./inc/cmsis_gcc.h ****   uint32_t result;
 776:./inc/cmsis_gcc.h ****   __ASM volatile ("MRS %0, msplim_ns" : "=r" (result) );
 777:./inc/cmsis_gcc.h ****   return result;
 778:./inc/cmsis_gcc.h **** #endif
 779:./inc/cmsis_gcc.h **** }
 780:./inc/cmsis_gcc.h **** #endif

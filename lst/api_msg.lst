 593:./lwip-2.1.2/src/api/api_msg.c ****   } else {
 594:./lwip-2.1.2/src/api/api_msg.c ****     /* Register event with callback */
 595:./lwip-2.1.2/src/api/api_msg.c ****     API_EVENT(conn, NETCONN_EVT_RCVPLUS, 0);
 596:./lwip-2.1.2/src/api/api_msg.c ****   }
 597:./lwip-2.1.2/src/api/api_msg.c **** 
 598:./lwip-2.1.2/src/api/api_msg.c ****   return ERR_OK;
 599:./lwip-2.1.2/src/api/api_msg.c **** }
 600:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 601:./lwip-2.1.2/src/api/api_msg.c **** 
 602:./lwip-2.1.2/src/api/api_msg.c **** /**
 603:./lwip-2.1.2/src/api/api_msg.c ****  * Create a new pcb of a specific type.
 604:./lwip-2.1.2/src/api/api_msg.c ****  * Called from lwip_netconn_do_newconn().
 605:./lwip-2.1.2/src/api/api_msg.c ****  *
 606:./lwip-2.1.2/src/api/api_msg.c ****  * @param msg the api_msg describing the connection type
 607:./lwip-2.1.2/src/api/api_msg.c ****  */
 608:./lwip-2.1.2/src/api/api_msg.c **** static void
 609:./lwip-2.1.2/src/api/api_msg.c **** pcb_new(struct api_msg *msg)
 610:./lwip-2.1.2/src/api/api_msg.c **** {
 611:./lwip-2.1.2/src/api/api_msg.c ****   enum lwip_ip_addr_type iptype = IPADDR_TYPE_V4;
 612:./lwip-2.1.2/src/api/api_msg.c **** 
 613:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("pcb_new: pcb already allocated", msg->conn->pcb.tcp == NULL);
 614:./lwip-2.1.2/src/api/api_msg.c **** 
 615:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_IPV6 && LWIP_IPV4
 616:./lwip-2.1.2/src/api/api_msg.c ****   /* IPv6: Dual-stack by default, unless netconn_set_ipv6only() is called */
 617:./lwip-2.1.2/src/api/api_msg.c ****   if (NETCONNTYPE_ISIPV6(netconn_type(msg->conn))) {
 618:./lwip-2.1.2/src/api/api_msg.c ****     iptype = IPADDR_TYPE_ANY;
 619:./lwip-2.1.2/src/api/api_msg.c ****   }
 620:./lwip-2.1.2/src/api/api_msg.c **** #endif
 621:./lwip-2.1.2/src/api/api_msg.c **** 
 622:./lwip-2.1.2/src/api/api_msg.c ****   /* Allocate a PCB for this connection */
 623:./lwip-2.1.2/src/api/api_msg.c ****   switch (NETCONNTYPE_GROUP(msg->conn->type)) {
 624:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_RAW
 625:./lwip-2.1.2/src/api/api_msg.c ****     case NETCONN_RAW:
 626:./lwip-2.1.2/src/api/api_msg.c ****       msg->conn->pcb.raw = raw_new_ip_type(iptype, msg->msg.n.proto);
 627:./lwip-2.1.2/src/api/api_msg.c ****       if (msg->conn->pcb.raw != NULL) {
 628:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_IPV6
 629:./lwip-2.1.2/src/api/api_msg.c ****         /* ICMPv6 packets should always have checksum calculated by the stack as per RFC 3542 chapt
 630:./lwip-2.1.2/src/api/api_msg.c ****         if (NETCONNTYPE_ISIPV6(msg->conn->type) && msg->conn->pcb.raw->protocol == IP6_NEXTH_ICMP6)
 631:./lwip-2.1.2/src/api/api_msg.c ****           msg->conn->pcb.raw->chksum_reqd = 1;
 632:./lwip-2.1.2/src/api/api_msg.c ****           msg->conn->pcb.raw->chksum_offset = 2;
 633:./lwip-2.1.2/src/api/api_msg.c ****         }
 634:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_IPV6 */
 635:./lwip-2.1.2/src/api/api_msg.c ****         raw_recv(msg->conn->pcb.raw, recv_raw, msg->conn);
 636:./lwip-2.1.2/src/api/api_msg.c ****       }
 637:./lwip-2.1.2/src/api/api_msg.c ****       break;
 638:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_RAW */
 639:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_UDP
 640:./lwip-2.1.2/src/api/api_msg.c ****     case NETCONN_UDP:
 641:./lwip-2.1.2/src/api/api_msg.c ****       msg->conn->pcb.udp = udp_new_ip_type(iptype);
 642:./lwip-2.1.2/src/api/api_msg.c ****       if (msg->conn->pcb.udp != NULL) {
 643:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_UDPLITE
 644:./lwip-2.1.2/src/api/api_msg.c ****         if (NETCONNTYPE_ISUDPLITE(msg->conn->type)) {
 645:./lwip-2.1.2/src/api/api_msg.c ****           udp_setflags(msg->conn->pcb.udp, UDP_FLAGS_UDPLITE);
 646:./lwip-2.1.2/src/api/api_msg.c ****         }
 647:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_UDPLITE */
 648:./lwip-2.1.2/src/api/api_msg.c ****         if (NETCONNTYPE_ISUDPNOCHKSUM(msg->conn->type)) {
 649:./lwip-2.1.2/src/api/api_msg.c ****           udp_setflags(msg->conn->pcb.udp, UDP_FLAGS_NOCHKSUM);
 650:./lwip-2.1.2/src/api/api_msg.c ****         }
 651:./lwip-2.1.2/src/api/api_msg.c ****         udp_recv(msg->conn->pcb.udp, recv_udp, msg->conn);
 652:./lwip-2.1.2/src/api/api_msg.c ****       }
 653:./lwip-2.1.2/src/api/api_msg.c ****       break;
 654:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_UDP */
 655:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 656:./lwip-2.1.2/src/api/api_msg.c ****     case NETCONN_TCP:
 657:./lwip-2.1.2/src/api/api_msg.c ****       msg->conn->pcb.tcp = tcp_new_ip_type(iptype);
 658:./lwip-2.1.2/src/api/api_msg.c ****       if (msg->conn->pcb.tcp != NULL) {
 659:./lwip-2.1.2/src/api/api_msg.c ****         setup_tcp(msg->conn);
 660:./lwip-2.1.2/src/api/api_msg.c ****       }
 661:./lwip-2.1.2/src/api/api_msg.c ****       break;
 662:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 663:./lwip-2.1.2/src/api/api_msg.c ****     default:
 664:./lwip-2.1.2/src/api/api_msg.c ****       /* Unsupported netconn type, e.g. protocol disabled */
 665:./lwip-2.1.2/src/api/api_msg.c ****       msg->err = ERR_VAL;
 666:./lwip-2.1.2/src/api/api_msg.c ****       return;
 667:./lwip-2.1.2/src/api/api_msg.c ****   }
 668:./lwip-2.1.2/src/api/api_msg.c ****   if (msg->conn->pcb.ip == NULL) {
 669:./lwip-2.1.2/src/api/api_msg.c ****     msg->err = ERR_MEM;
 670:./lwip-2.1.2/src/api/api_msg.c ****   }
 671:./lwip-2.1.2/src/api/api_msg.c **** }
 672:./lwip-2.1.2/src/api/api_msg.c **** 
 673:./lwip-2.1.2/src/api/api_msg.c **** /**
 674:./lwip-2.1.2/src/api/api_msg.c ****  * Create a new pcb of a specific type inside a netconn.
 675:./lwip-2.1.2/src/api/api_msg.c ****  * Called from netconn_new_with_proto_and_callback.
 676:./lwip-2.1.2/src/api/api_msg.c ****  *
 677:./lwip-2.1.2/src/api/api_msg.c ****  * @param m the api_msg describing the connection type
 678:./lwip-2.1.2/src/api/api_msg.c ****  */
 679:./lwip-2.1.2/src/api/api_msg.c **** void
 680:./lwip-2.1.2/src/api/api_msg.c **** lwip_netconn_do_newconn(void *m)
 681:./lwip-2.1.2/src/api/api_msg.c **** {
 682:./lwip-2.1.2/src/api/api_msg.c ****   struct api_msg *msg = (struct api_msg *)m;
 683:./lwip-2.1.2/src/api/api_msg.c **** 
 684:./lwip-2.1.2/src/api/api_msg.c ****   msg->err = ERR_OK;
 685:./lwip-2.1.2/src/api/api_msg.c ****   if (msg->conn->pcb.tcp == NULL) {
 686:./lwip-2.1.2/src/api/api_msg.c ****     pcb_new(msg);
 687:./lwip-2.1.2/src/api/api_msg.c ****   }
 688:./lwip-2.1.2/src/api/api_msg.c ****   /* Else? This "new" connection already has a PCB allocated. */
 689:./lwip-2.1.2/src/api/api_msg.c ****   /* Is this an error condition? Should it be deleted? */
 690:./lwip-2.1.2/src/api/api_msg.c ****   /* We currently just are happy and return. */
 691:./lwip-2.1.2/src/api/api_msg.c **** 
 692:./lwip-2.1.2/src/api/api_msg.c ****   TCPIP_APIMSG_ACK(msg);
 693:./lwip-2.1.2/src/api/api_msg.c **** }
 694:./lwip-2.1.2/src/api/api_msg.c **** 
 695:./lwip-2.1.2/src/api/api_msg.c **** /**
 696:./lwip-2.1.2/src/api/api_msg.c ****  * Create a new netconn (of a specific type) that has a callback function.
 697:./lwip-2.1.2/src/api/api_msg.c ****  * The corresponding pcb is NOT created!
 698:./lwip-2.1.2/src/api/api_msg.c ****  *
 699:./lwip-2.1.2/src/api/api_msg.c ****  * @param t the type of 'connection' to create (@see enum netconn_type)
 700:./lwip-2.1.2/src/api/api_msg.c ****  * @param callback a function to call on status changes (RX available, TX'ed)
 701:./lwip-2.1.2/src/api/api_msg.c ****  * @return a newly allocated struct netconn or
 702:./lwip-2.1.2/src/api/api_msg.c ****  *         NULL on memory error
 703:./lwip-2.1.2/src/api/api_msg.c ****  */
 704:./lwip-2.1.2/src/api/api_msg.c **** struct netconn *
 705:./lwip-2.1.2/src/api/api_msg.c **** netconn_alloc(enum netconn_type t, netconn_callback callback)
 706:./lwip-2.1.2/src/api/api_msg.c **** {
 707:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *conn;
 708:./lwip-2.1.2/src/api/api_msg.c ****   int size;
 709:./lwip-2.1.2/src/api/api_msg.c ****   u8_t init_flags = 0;
 710:./lwip-2.1.2/src/api/api_msg.c **** 
 711:./lwip-2.1.2/src/api/api_msg.c ****   conn = (struct netconn *)memp_malloc(MEMP_NETCONN);
 712:./lwip-2.1.2/src/api/api_msg.c ****   if (conn == NULL) {
 713:./lwip-2.1.2/src/api/api_msg.c ****     return NULL;
 714:./lwip-2.1.2/src/api/api_msg.c ****   }
 715:./lwip-2.1.2/src/api/api_msg.c **** 
 716:./lwip-2.1.2/src/api/api_msg.c ****   conn->pending_err = ERR_OK;
 717:./lwip-2.1.2/src/api/api_msg.c ****   conn->type = t;
 718:./lwip-2.1.2/src/api/api_msg.c ****   conn->pcb.tcp = NULL;
 719:./lwip-2.1.2/src/api/api_msg.c **** 
 720:./lwip-2.1.2/src/api/api_msg.c ****   /* If all sizes are the same, every compiler should optimize this switch to nothing */
 721:./lwip-2.1.2/src/api/api_msg.c ****   switch (NETCONNTYPE_GROUP(t)) {
 722:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_RAW
 723:./lwip-2.1.2/src/api/api_msg.c ****     case NETCONN_RAW:
 724:./lwip-2.1.2/src/api/api_msg.c ****       size = DEFAULT_RAW_RECVMBOX_SIZE;
 725:./lwip-2.1.2/src/api/api_msg.c ****       break;
 726:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_RAW */
 727:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_UDP
 728:./lwip-2.1.2/src/api/api_msg.c ****     case NETCONN_UDP:
 729:./lwip-2.1.2/src/api/api_msg.c ****       size = DEFAULT_UDP_RECVMBOX_SIZE;
 730:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_NETBUF_RECVINFO
 731:./lwip-2.1.2/src/api/api_msg.c ****       init_flags |= NETCONN_FLAG_PKTINFO;
 732:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_NETBUF_RECVINFO */
 733:./lwip-2.1.2/src/api/api_msg.c ****       break;
 734:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_UDP */
 735:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 736:./lwip-2.1.2/src/api/api_msg.c ****     case NETCONN_TCP:
 737:./lwip-2.1.2/src/api/api_msg.c ****       size = DEFAULT_TCP_RECVMBOX_SIZE;
 738:./lwip-2.1.2/src/api/api_msg.c ****       break;
 739:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 740:./lwip-2.1.2/src/api/api_msg.c ****     default:
 741:./lwip-2.1.2/src/api/api_msg.c ****       LWIP_ASSERT("netconn_alloc: undefined netconn_type", 0);
 742:./lwip-2.1.2/src/api/api_msg.c ****       goto free_and_return;
 743:./lwip-2.1.2/src/api/api_msg.c ****   }
 744:./lwip-2.1.2/src/api/api_msg.c **** 
 745:./lwip-2.1.2/src/api/api_msg.c ****   if (sys_mbox_new(&conn->recvmbox, size) != ERR_OK) {
 746:./lwip-2.1.2/src/api/api_msg.c ****     goto free_and_return;
 747:./lwip-2.1.2/src/api/api_msg.c ****   }
 748:./lwip-2.1.2/src/api/api_msg.c **** #if !LWIP_NETCONN_SEM_PER_THREAD
 749:./lwip-2.1.2/src/api/api_msg.c ****   if (sys_sem_new(&conn->op_completed, 0) != ERR_OK) {
 750:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_free(&conn->recvmbox);
 751:./lwip-2.1.2/src/api/api_msg.c ****     goto free_and_return;
 752:./lwip-2.1.2/src/api/api_msg.c ****   }
 753:./lwip-2.1.2/src/api/api_msg.c **** #endif
 754:./lwip-2.1.2/src/api/api_msg.c **** 
 755:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 756:./lwip-2.1.2/src/api/api_msg.c ****   sys_mbox_set_invalid(&conn->acceptmbox);
 757:./lwip-2.1.2/src/api/api_msg.c **** #endif
 758:./lwip-2.1.2/src/api/api_msg.c ****   conn->state        = NETCONN_NONE;
 759:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SOCKET
 760:./lwip-2.1.2/src/api/api_msg.c ****   /* initialize socket to -1 since 0 is a valid socket */
 761:./lwip-2.1.2/src/api/api_msg.c ****   conn->socket       = -1;
 762:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SOCKET */
 763:./lwip-2.1.2/src/api/api_msg.c ****   conn->callback     = callback;
 764:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 765:./lwip-2.1.2/src/api/api_msg.c ****   conn->current_msg  = NULL;
 766:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 767:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_SNDTIMEO
 768:./lwip-2.1.2/src/api/api_msg.c ****   conn->send_timeout = 0;
 769:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_SNDTIMEO */
 770:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_RCVTIMEO
 771:./lwip-2.1.2/src/api/api_msg.c ****   conn->recv_timeout = 0;
 772:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_RCVTIMEO */
 773:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_RCVBUF
 774:./lwip-2.1.2/src/api/api_msg.c ****   conn->recv_bufsize = RECV_BUFSIZE_DEFAULT;
 775:./lwip-2.1.2/src/api/api_msg.c ****   conn->recv_avail   = 0;
 776:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_RCVBUF */
 777:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_LINGER
 778:./lwip-2.1.2/src/api/api_msg.c ****   conn->linger = -1;
 779:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_LINGER */
 780:./lwip-2.1.2/src/api/api_msg.c ****   conn->flags = init_flags;
 781:./lwip-2.1.2/src/api/api_msg.c ****   return conn;
 782:./lwip-2.1.2/src/api/api_msg.c **** free_and_return:
 783:./lwip-2.1.2/src/api/api_msg.c ****   memp_free(MEMP_NETCONN, conn);
 784:./lwip-2.1.2/src/api/api_msg.c ****   return NULL;
 785:./lwip-2.1.2/src/api/api_msg.c **** }
 786:./lwip-2.1.2/src/api/api_msg.c **** 
 787:./lwip-2.1.2/src/api/api_msg.c **** /**
 788:./lwip-2.1.2/src/api/api_msg.c ****  * Delete a netconn and all its resources.
 789:./lwip-2.1.2/src/api/api_msg.c ****  * The pcb is NOT freed (since we might not be in the right thread context do this).
 790:./lwip-2.1.2/src/api/api_msg.c ****  *
 791:./lwip-2.1.2/src/api/api_msg.c ****  * @param conn the netconn to free
 792:./lwip-2.1.2/src/api/api_msg.c ****  */
 793:./lwip-2.1.2/src/api/api_msg.c **** void
 794:./lwip-2.1.2/src/api/api_msg.c **** netconn_free(struct netconn *conn)
 795:./lwip-2.1.2/src/api/api_msg.c **** {
 796:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("PCB must be deallocated outside this function", conn->pcb.tcp == NULL);
 797:./lwip-2.1.2/src/api/api_msg.c **** 
 798:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_NETCONN_FULLDUPLEX
 799:./lwip-2.1.2/src/api/api_msg.c ****   /* in fullduplex, netconn is drained here */
 800:./lwip-2.1.2/src/api/api_msg.c ****   netconn_drain(conn);
 801:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 802:./lwip-2.1.2/src/api/api_msg.c **** 
 803:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("recvmbox must be deallocated before calling this function",
 804:./lwip-2.1.2/src/api/api_msg.c ****               !sys_mbox_valid(&conn->recvmbox));
 805:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 806:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("acceptmbox must be deallocated before calling this function",
 807:./lwip-2.1.2/src/api/api_msg.c ****               !sys_mbox_valid(&conn->acceptmbox));
 808:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 809:./lwip-2.1.2/src/api/api_msg.c **** 
 810:./lwip-2.1.2/src/api/api_msg.c **** #if !LWIP_NETCONN_SEM_PER_THREAD
 811:./lwip-2.1.2/src/api/api_msg.c ****   sys_sem_free(&conn->op_completed);
 812:./lwip-2.1.2/src/api/api_msg.c ****   sys_sem_set_invalid(&conn->op_completed);
 813:./lwip-2.1.2/src/api/api_msg.c **** #endif
 814:./lwip-2.1.2/src/api/api_msg.c **** 
 815:./lwip-2.1.2/src/api/api_msg.c ****   memp_free(MEMP_NETCONN, conn);
 816:./lwip-2.1.2/src/api/api_msg.c **** }
 817:./lwip-2.1.2/src/api/api_msg.c **** 
 818:./lwip-2.1.2/src/api/api_msg.c **** /**
 819:./lwip-2.1.2/src/api/api_msg.c ****  * Delete rcvmbox and acceptmbox of a netconn and free the left-over data in
 820:./lwip-2.1.2/src/api/api_msg.c ****  * these mboxes
 821:./lwip-2.1.2/src/api/api_msg.c ****  *
 822:./lwip-2.1.2/src/api/api_msg.c ****  * @param conn the netconn to free
 823:./lwip-2.1.2/src/api/api_msg.c ****  * @bytes_drained bytes drained from recvmbox
 824:./lwip-2.1.2/src/api/api_msg.c ****  * @accepts_drained pending connections drained from acceptmbox
 825:./lwip-2.1.2/src/api/api_msg.c ****  */
 826:./lwip-2.1.2/src/api/api_msg.c **** static void
 827:./lwip-2.1.2/src/api/api_msg.c **** netconn_drain(struct netconn *conn)
 828:./lwip-2.1.2/src/api/api_msg.c **** {
 829:./lwip-2.1.2/src/api/api_msg.c ****   void *mem;
 830:./lwip-2.1.2/src/api/api_msg.c **** 
 831:./lwip-2.1.2/src/api/api_msg.c ****   /* This runs when mbox and netconn are marked as closed,
 832:./lwip-2.1.2/src/api/api_msg.c ****      so we don't need to lock against rx packets */
 833:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_NETCONN_FULLDUPLEX
 834:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("netconn marked closed", conn->flags & NETCONN_FLAG_MBOXINVALID);
 835:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 836:./lwip-2.1.2/src/api/api_msg.c **** 
 837:./lwip-2.1.2/src/api/api_msg.c ****   /* Delete and drain the recvmbox. */
 838:./lwip-2.1.2/src/api/api_msg.c ****   if (sys_mbox_valid(&conn->recvmbox)) {
 839:./lwip-2.1.2/src/api/api_msg.c ****     while (sys_mbox_tryfetch(&conn->recvmbox, &mem) != SYS_MBOX_EMPTY) {
 840:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_NETCONN_FULLDUPLEX
 841:./lwip-2.1.2/src/api/api_msg.c ****       if (!lwip_netconn_is_deallocated_msg(mem))
 842:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 843:./lwip-2.1.2/src/api/api_msg.c ****       {
 844:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 845:./lwip-2.1.2/src/api/api_msg.c ****         if (NETCONNTYPE_GROUP(conn->type) == NETCONN_TCP) {
 846:./lwip-2.1.2/src/api/api_msg.c ****           err_t err;
 847:./lwip-2.1.2/src/api/api_msg.c ****           if (!lwip_netconn_is_err_msg(mem, &err)) {
 848:./lwip-2.1.2/src/api/api_msg.c ****             pbuf_free((struct pbuf *)mem);
 849:./lwip-2.1.2/src/api/api_msg.c ****           }
 850:./lwip-2.1.2/src/api/api_msg.c ****         } else
 851:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 852:./lwip-2.1.2/src/api/api_msg.c ****         {
 853:./lwip-2.1.2/src/api/api_msg.c ****           netbuf_delete((struct netbuf *)mem);
 854:./lwip-2.1.2/src/api/api_msg.c ****         }
 855:./lwip-2.1.2/src/api/api_msg.c ****       }
 856:./lwip-2.1.2/src/api/api_msg.c ****     }
 857:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_free(&conn->recvmbox);
 858:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_set_invalid(&conn->recvmbox);
 859:./lwip-2.1.2/src/api/api_msg.c ****   }
 860:./lwip-2.1.2/src/api/api_msg.c **** 
 861:./lwip-2.1.2/src/api/api_msg.c ****   /* Delete and drain the acceptmbox. */
 862:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 863:./lwip-2.1.2/src/api/api_msg.c ****   if (sys_mbox_valid(&conn->acceptmbox)) {
 864:./lwip-2.1.2/src/api/api_msg.c ****     while (sys_mbox_tryfetch(&conn->acceptmbox, &mem) != SYS_MBOX_EMPTY) {
 865:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_NETCONN_FULLDUPLEX
 866:./lwip-2.1.2/src/api/api_msg.c ****       if (!lwip_netconn_is_deallocated_msg(mem))
 867:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 868:./lwip-2.1.2/src/api/api_msg.c ****       {
 869:./lwip-2.1.2/src/api/api_msg.c ****         err_t err;
 870:./lwip-2.1.2/src/api/api_msg.c ****         if (!lwip_netconn_is_err_msg(mem, &err)) {
 871:./lwip-2.1.2/src/api/api_msg.c ****           struct netconn *newconn = (struct netconn *)mem;
 872:./lwip-2.1.2/src/api/api_msg.c ****           /* Only tcp pcbs have an acceptmbox, so no need to check conn->type */
 873:./lwip-2.1.2/src/api/api_msg.c ****           /* pcb might be set to NULL already by err_tcp() */
 874:./lwip-2.1.2/src/api/api_msg.c ****           /* drain recvmbox */
 875:./lwip-2.1.2/src/api/api_msg.c ****           netconn_drain(newconn);
 876:./lwip-2.1.2/src/api/api_msg.c ****           if (newconn->pcb.tcp != NULL) {
 877:./lwip-2.1.2/src/api/api_msg.c ****             tcp_abort(newconn->pcb.tcp);
 878:./lwip-2.1.2/src/api/api_msg.c ****             newconn->pcb.tcp = NULL;
 879:./lwip-2.1.2/src/api/api_msg.c ****           }
 880:./lwip-2.1.2/src/api/api_msg.c ****           netconn_free(newconn);
 881:./lwip-2.1.2/src/api/api_msg.c ****         }
 882:./lwip-2.1.2/src/api/api_msg.c ****       }
 883:./lwip-2.1.2/src/api/api_msg.c ****     }
 884:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_free(&conn->acceptmbox);
 885:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_set_invalid(&conn->acceptmbox);
 886:./lwip-2.1.2/src/api/api_msg.c ****   }
 887:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_TCP */
 888:./lwip-2.1.2/src/api/api_msg.c **** }
 889:./lwip-2.1.2/src/api/api_msg.c **** 
 890:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_NETCONN_FULLDUPLEX
 891:./lwip-2.1.2/src/api/api_msg.c **** static void
 892:./lwip-2.1.2/src/api/api_msg.c **** netconn_mark_mbox_invalid(struct netconn *conn)
 893:./lwip-2.1.2/src/api/api_msg.c **** {
 894:./lwip-2.1.2/src/api/api_msg.c ****   int i, num_waiting;
 895:./lwip-2.1.2/src/api/api_msg.c ****   void *msg = LWIP_CONST_CAST(void *, &netconn_deleted);
 896:./lwip-2.1.2/src/api/api_msg.c **** 
 897:./lwip-2.1.2/src/api/api_msg.c ****   /* Prevent new calls/threads from reading from the mbox */
 898:./lwip-2.1.2/src/api/api_msg.c ****   conn->flags |= NETCONN_FLAG_MBOXINVALID;
 899:./lwip-2.1.2/src/api/api_msg.c **** 
 900:./lwip-2.1.2/src/api/api_msg.c ****   SYS_ARCH_LOCKED(num_waiting = conn->mbox_threads_waiting);
 901:./lwip-2.1.2/src/api/api_msg.c ****   for (i = 0; i < num_waiting; i++) {
 902:./lwip-2.1.2/src/api/api_msg.c ****     if (sys_mbox_valid_val(conn->recvmbox)) {
 903:./lwip-2.1.2/src/api/api_msg.c ****       sys_mbox_trypost(&conn->recvmbox, msg);
 904:./lwip-2.1.2/src/api/api_msg.c ****     } else {
 905:./lwip-2.1.2/src/api/api_msg.c ****       sys_mbox_trypost(&conn->acceptmbox, msg);
 906:./lwip-2.1.2/src/api/api_msg.c ****     }
 907:./lwip-2.1.2/src/api/api_msg.c ****   }
 908:./lwip-2.1.2/src/api/api_msg.c **** }
 909:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_NETCONN_FULLDUPLEX */
 910:./lwip-2.1.2/src/api/api_msg.c **** 
 911:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_TCP
 912:./lwip-2.1.2/src/api/api_msg.c **** /**
 913:./lwip-2.1.2/src/api/api_msg.c ****  * Internal helper function to close a TCP netconn: since this sometimes
 914:./lwip-2.1.2/src/api/api_msg.c ****  * doesn't work at the first attempt, this function is called from multiple
 915:./lwip-2.1.2/src/api/api_msg.c ****  * places.
 916:./lwip-2.1.2/src/api/api_msg.c ****  *
 917:./lwip-2.1.2/src/api/api_msg.c ****  * @param conn the TCP netconn to close
 918:./lwip-2.1.2/src/api/api_msg.c ****  */
 919:./lwip-2.1.2/src/api/api_msg.c **** static err_t
 920:./lwip-2.1.2/src/api/api_msg.c **** lwip_netconn_do_close_internal(struct netconn *conn  WRITE_DELAYED_PARAM)
 921:./lwip-2.1.2/src/api/api_msg.c **** {
 922:./lwip-2.1.2/src/api/api_msg.c ****   err_t err;
 923:./lwip-2.1.2/src/api/api_msg.c ****   u8_t shut, shut_rx, shut_tx, shut_close;
 924:./lwip-2.1.2/src/api/api_msg.c ****   u8_t close_finished = 0;
 925:./lwip-2.1.2/src/api/api_msg.c ****   struct tcp_pcb *tpcb;
 926:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_LINGER
 927:./lwip-2.1.2/src/api/api_msg.c ****   u8_t linger_wait_required = 0;
 928:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_LINGER */
 929:./lwip-2.1.2/src/api/api_msg.c **** 
 930:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("invalid conn", (conn != NULL));
 931:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("this is for tcp netconns only", (NETCONNTYPE_GROUP(conn->type) == NETCONN_TCP));
 932:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("conn must be in state NETCONN_CLOSE", (conn->state == NETCONN_CLOSE));
 933:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("pcb already closed", (conn->pcb.tcp != NULL));
 934:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("conn->current_msg != NULL", conn->current_msg != NULL);
 935:./lwip-2.1.2/src/api/api_msg.c **** 
 936:./lwip-2.1.2/src/api/api_msg.c ****   tpcb = conn->pcb.tcp;
 937:./lwip-2.1.2/src/api/api_msg.c ****   shut = conn->current_msg->msg.sd.shut;
 938:./lwip-2.1.2/src/api/api_msg.c ****   shut_rx = shut & NETCONN_SHUT_RD;
 939:./lwip-2.1.2/src/api/api_msg.c ****   shut_tx = shut & NETCONN_SHUT_WR;
 940:./lwip-2.1.2/src/api/api_msg.c ****   /* shutting down both ends is the same as closing
 941:./lwip-2.1.2/src/api/api_msg.c ****      (also if RD or WR side was shut down before already) */
 942:./lwip-2.1.2/src/api/api_msg.c ****   if (shut == NETCONN_SHUT_RDWR) {
 943:./lwip-2.1.2/src/api/api_msg.c ****     shut_close = 1;
 944:./lwip-2.1.2/src/api/api_msg.c ****   } else if (shut_rx &&
 945:./lwip-2.1.2/src/api/api_msg.c ****              ((tpcb->state == FIN_WAIT_1) ||
 946:./lwip-2.1.2/src/api/api_msg.c ****               (tpcb->state == FIN_WAIT_2) ||
 947:./lwip-2.1.2/src/api/api_msg.c ****               (tpcb->state == CLOSING))) {
 948:./lwip-2.1.2/src/api/api_msg.c ****     shut_close = 1;
 949:./lwip-2.1.2/src/api/api_msg.c ****   } else if (shut_tx && ((tpcb->flags & TF_RXCLOSED) != 0)) {
 950:./lwip-2.1.2/src/api/api_msg.c ****     shut_close = 1;
 951:./lwip-2.1.2/src/api/api_msg.c ****   } else {
 952:./lwip-2.1.2/src/api/api_msg.c ****     shut_close = 0;
 953:./lwip-2.1.2/src/api/api_msg.c ****   }
 954:./lwip-2.1.2/src/api/api_msg.c **** 
 955:./lwip-2.1.2/src/api/api_msg.c ****   /* Set back some callback pointers */
 956:./lwip-2.1.2/src/api/api_msg.c ****   if (shut_close) {
 957:./lwip-2.1.2/src/api/api_msg.c ****     tcp_arg(tpcb, NULL);
 958:./lwip-2.1.2/src/api/api_msg.c ****   }
 959:./lwip-2.1.2/src/api/api_msg.c ****   if (tpcb->state == LISTEN) {
 960:./lwip-2.1.2/src/api/api_msg.c ****     tcp_accept(tpcb, NULL);
 961:./lwip-2.1.2/src/api/api_msg.c ****   } else {
 962:./lwip-2.1.2/src/api/api_msg.c ****     /* some callbacks have to be reset if tcp_close is not successful */
 963:./lwip-2.1.2/src/api/api_msg.c ****     if (shut_rx) {
 964:./lwip-2.1.2/src/api/api_msg.c ****       tcp_recv(tpcb, NULL);
 965:./lwip-2.1.2/src/api/api_msg.c ****       tcp_accept(tpcb, NULL);
 966:./lwip-2.1.2/src/api/api_msg.c ****     }
 967:./lwip-2.1.2/src/api/api_msg.c ****     if (shut_tx) {
 968:./lwip-2.1.2/src/api/api_msg.c ****       tcp_sent(tpcb, NULL);
 969:./lwip-2.1.2/src/api/api_msg.c ****     }
 970:./lwip-2.1.2/src/api/api_msg.c ****     if (shut_close) {
 971:./lwip-2.1.2/src/api/api_msg.c ****       tcp_poll(tpcb, NULL, 0);
 972:./lwip-2.1.2/src/api/api_msg.c ****       tcp_err(tpcb, NULL);
 973:./lwip-2.1.2/src/api/api_msg.c ****     }
 974:./lwip-2.1.2/src/api/api_msg.c ****   }
 975:./lwip-2.1.2/src/api/api_msg.c ****   /* Try to close the connection */
 976:./lwip-2.1.2/src/api/api_msg.c ****   if (shut_close) {
 977:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_LINGER
 978:./lwip-2.1.2/src/api/api_msg.c ****     /* check linger possibilites before calling tcp_close */
 979:./lwip-2.1.2/src/api/api_msg.c ****     err = ERR_OK;
 980:./lwip-2.1.2/src/api/api_msg.c ****     /* linger enabled/required at all? (i.e. is there untransmitted data left?) */
 981:./lwip-2.1.2/src/api/api_msg.c ****     if ((conn->linger >= 0) && (conn->pcb.tcp->unsent || conn->pcb.tcp->unacked)) {
 982:./lwip-2.1.2/src/api/api_msg.c ****       if ((conn->linger == 0)) {
 983:./lwip-2.1.2/src/api/api_msg.c ****         /* data left but linger prevents waiting */
 984:./lwip-2.1.2/src/api/api_msg.c ****         tcp_abort(tpcb);
 985:./lwip-2.1.2/src/api/api_msg.c ****         tpcb = NULL;
 986:./lwip-2.1.2/src/api/api_msg.c ****       } else if (conn->linger > 0) {
 987:./lwip-2.1.2/src/api/api_msg.c ****         /* data left and linger says we should wait */
 988:./lwip-2.1.2/src/api/api_msg.c ****         if (netconn_is_nonblocking(conn)) {
 989:./lwip-2.1.2/src/api/api_msg.c ****           /* data left on a nonblocking netconn -> cannot linger */
 990:./lwip-2.1.2/src/api/api_msg.c ****           err = ERR_WOULDBLOCK;
 991:./lwip-2.1.2/src/api/api_msg.c ****         } else if ((s32_t)(sys_now() - conn->current_msg->msg.sd.time_started) >=
 992:./lwip-2.1.2/src/api/api_msg.c ****                    (conn->linger * 1000)) {
 993:./lwip-2.1.2/src/api/api_msg.c ****           /* data left but linger timeout has expired (this happens on further
 994:./lwip-2.1.2/src/api/api_msg.c ****              calls to this function through poll_tcp */
 995:./lwip-2.1.2/src/api/api_msg.c ****           tcp_abort(tpcb);
 996:./lwip-2.1.2/src/api/api_msg.c ****           tpcb = NULL;
 997:./lwip-2.1.2/src/api/api_msg.c ****         } else {
 998:./lwip-2.1.2/src/api/api_msg.c ****           /* data left -> need to wait for ACK after successful close */
 999:./lwip-2.1.2/src/api/api_msg.c ****           linger_wait_required = 1;
1000:./lwip-2.1.2/src/api/api_msg.c ****         }
1001:./lwip-2.1.2/src/api/api_msg.c ****       }
1002:./lwip-2.1.2/src/api/api_msg.c ****     }
1003:./lwip-2.1.2/src/api/api_msg.c ****     if ((err == ERR_OK) && (tpcb != NULL))
1004:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_LINGER */
1005:./lwip-2.1.2/src/api/api_msg.c ****     {
1006:./lwip-2.1.2/src/api/api_msg.c ****       err = tcp_close(tpcb);
1007:./lwip-2.1.2/src/api/api_msg.c ****     }
1008:./lwip-2.1.2/src/api/api_msg.c ****   } else {
1009:./lwip-2.1.2/src/api/api_msg.c ****     err = tcp_shutdown(tpcb, shut_rx, shut_tx);
1010:./lwip-2.1.2/src/api/api_msg.c ****   }
1011:./lwip-2.1.2/src/api/api_msg.c ****   if (err == ERR_OK) {
1012:./lwip-2.1.2/src/api/api_msg.c ****     close_finished = 1;
1013:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_LINGER
1014:./lwip-2.1.2/src/api/api_msg.c ****     if (linger_wait_required) {
1015:./lwip-2.1.2/src/api/api_msg.c ****       /* wait for ACK of all unsent/unacked data by just getting called again */
1016:./lwip-2.1.2/src/api/api_msg.c ****       close_finished = 0;
1017:./lwip-2.1.2/src/api/api_msg.c ****       err = ERR_INPROGRESS;
1018:./lwip-2.1.2/src/api/api_msg.c ****     }
1019:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_LINGER */
1020:./lwip-2.1.2/src/api/api_msg.c ****   } else {
1021:./lwip-2.1.2/src/api/api_msg.c ****     if (err == ERR_MEM) {
1022:./lwip-2.1.2/src/api/api_msg.c ****       /* Closing failed because of memory shortage, try again later. Even for
1023:./lwip-2.1.2/src/api/api_msg.c ****          nonblocking netconns, we have to wait since no standard socket application
1024:./lwip-2.1.2/src/api/api_msg.c ****          is prepared for close failing because of resource shortage.
1025:./lwip-2.1.2/src/api/api_msg.c ****          Check the timeout: this is kind of an lwip addition to the standard sockets:
1026:./lwip-2.1.2/src/api/api_msg.c ****          we wait for some time when failing to allocate a segment for the FIN */
1027:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_SNDTIMEO || LWIP_SO_LINGER
1028:./lwip-2.1.2/src/api/api_msg.c ****       s32_t close_timeout = LWIP_TCP_CLOSE_TIMEOUT_MS_DEFAULT;
1029:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_SNDTIMEO
1030:./lwip-2.1.2/src/api/api_msg.c ****       if (conn->send_timeout > 0) {
1031:./lwip-2.1.2/src/api/api_msg.c ****         close_timeout = conn->send_timeout;
1032:./lwip-2.1.2/src/api/api_msg.c ****       }
1033:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_SNDTIMEO */
1034:./lwip-2.1.2/src/api/api_msg.c **** #if LWIP_SO_LINGER
1035:./lwip-2.1.2/src/api/api_msg.c ****       if (conn->linger >= 0) {
1036:./lwip-2.1.2/src/api/api_msg.c ****         /* use linger timeout (seconds) */
1037:./lwip-2.1.2/src/api/api_msg.c ****         close_timeout = conn->linger * 1000U;
1038:./lwip-2.1.2/src/api/api_msg.c ****       }
1039:./lwip-2.1.2/src/api/api_msg.c **** #endif
1040:./lwip-2.1.2/src/api/api_msg.c ****       if ((s32_t)(sys_now() - conn->current_msg->msg.sd.time_started) >= close_timeout) {
1041:./lwip-2.1.2/src/api/api_msg.c **** #else /* LWIP_SO_SNDTIMEO || LWIP_SO_LINGER */
1042:./lwip-2.1.2/src/api/api_msg.c ****       if (conn->current_msg->msg.sd.polls_left == 0) {
1043:./lwip-2.1.2/src/api/api_msg.c **** #endif /* LWIP_SO_SNDTIMEO || LWIP_SO_LINGER */
1044:./lwip-2.1.2/src/api/api_msg.c ****         close_finished = 1;
1045:./lwip-2.1.2/src/api/api_msg.c ****         if (shut_close) {
1046:./lwip-2.1.2/src/api/api_msg.c ****           /* in this case, we want to RST the connection */
1047:./lwip-2.1.2/src/api/api_msg.c ****           tcp_abort(tpcb);
1048:./lwip-2.1.2/src/api/api_msg.c ****           err = ERR_OK;
1049:./lwip-2.1.2/src/api/api_msg.c ****         }
1050:./lwip-2.1.2/src/api/api_msg.c ****       }
1051:./lwip-2.1.2/src/api/api_msg.c ****     } else {

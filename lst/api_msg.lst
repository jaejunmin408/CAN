1128:./lwip-2.1.2/src/api/api_msg.c ****       op_completed_sem = LWIP_API_MSG_SEM(msg->conn->current_msg);
1129:./lwip-2.1.2/src/api/api_msg.c ****       msg->conn->current_msg->err = ERR_CLSD;

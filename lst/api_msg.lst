 213:./inc/cmsis_gcc.h **** /**
 214:./inc/cmsis_gcc.h ****   \brief   Get Control Register
 215:./inc/cmsis_gcc.h ****   \details Returns the content of the Control Register.
 216:./inc/cmsis_gcc.h ****   \return               Control Register value
 217:./inc/cmsis_gcc.h ****  */
 218:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __get_CONTROL(void)

 345:./lwip-2.1.2/src/api/api_msg.c **** /**
 346:./lwip-2.1.2/src/api/api_msg.c ****  * Poll callback function for TCP netconns.
 347:./lwip-2.1.2/src/api/api_msg.c ****  * Wakes up an application thread that waits for a connection to close
 348:./lwip-2.1.2/src/api/api_msg.c ****  * or data to be sent. The application thread then takes the
 349:./lwip-2.1.2/src/api/api_msg.c ****  * appropriate action to go on.
 350:./lwip-2.1.2/src/api/api_msg.c ****  *
 351:./lwip-2.1.2/src/api/api_msg.c ****  * Signals the conn->sem.
 352:./lwip-2.1.2/src/api/api_msg.c ****  * netconn_close waits for conn->sem if closing failed.
 353:./lwip-2.1.2/src/api/api_msg.c ****  *
 354:./lwip-2.1.2/src/api/api_msg.c ****  * @see tcp.h (struct tcp_pcb.poll) for parameters and return value
 355:./lwip-2.1.2/src/api/api_msg.c ****  */
 356:./lwip-2.1.2/src/api/api_msg.c **** static err_t
 357:./lwip-2.1.2/src/api/api_msg.c **** poll_tcp(void *arg, struct tcp_pcb *pcb)
 358:./lwip-2.1.2/src/api/api_msg.c **** {
 359:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *conn = (struct netconn *)arg;
 360:./lwip-2.1.2/src/api/api_msg.c **** 
 361:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_UNUSED_ARG(pcb);
 362:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("conn != NULL", (conn != NULL));
 363:./lwip-2.1.2/src/api/api_msg.c **** 
 364:./lwip-2.1.2/src/api/api_msg.c ****   if (conn->state == NETCONN_WRITE) {
 365:./lwip-2.1.2/src/api/api_msg.c ****     lwip_netconn_do_writemore(conn  WRITE_DELAYED);
 366:./lwip-2.1.2/src/api/api_msg.c ****   } else if (conn->state == NETCONN_CLOSE) {
 367:./lwip-2.1.2/src/api/api_msg.c **** #if !LWIP_SO_SNDTIMEO && !LWIP_SO_LINGER
 368:./lwip-2.1.2/src/api/api_msg.c ****     if (conn->current_msg && conn->current_msg->msg.sd.polls_left) {
 369:./lwip-2.1.2/src/api/api_msg.c ****       conn->current_msg->msg.sd.polls_left--;
 370:./lwip-2.1.2/src/api/api_msg.c ****     }
 371:./lwip-2.1.2/src/api/api_msg.c **** #endif /* !LWIP_SO_SNDTIMEO && !LWIP_SO_LINGER */
 372:./lwip-2.1.2/src/api/api_msg.c ****     lwip_netconn_do_close_internal(conn  WRITE_DELAYED);
 373:./lwip-2.1.2/src/api/api_msg.c ****   }
 374:./lwip-2.1.2/src/api/api_msg.c ****   /* @todo: implement connect timeout here? */
 375:./lwip-2.1.2/src/api/api_msg.c **** 
 376:./lwip-2.1.2/src/api/api_msg.c ****   /* Did a nonblocking write fail before? Then check available write-space. */
 377:./lwip-2.1.2/src/api/api_msg.c ****   if (conn->flags & NETCONN_FLAG_CHECK_WRITESPACE) {
 378:./lwip-2.1.2/src/api/api_msg.c ****     /* If the queued byte- or pbuf-count drops below the configured low-water limit,
 379:./lwip-2.1.2/src/api/api_msg.c ****        let select mark this pcb as writable again. */
 380:./lwip-2.1.2/src/api/api_msg.c ****     if ((conn->pcb.tcp != NULL) && (tcp_sndbuf(conn->pcb.tcp) > TCP_SNDLOWAT) &&
 381:./lwip-2.1.2/src/api/api_msg.c ****         (tcp_sndqueuelen(conn->pcb.tcp) < TCP_SNDQUEUELOWAT)) {
 382:./lwip-2.1.2/src/api/api_msg.c ****       netconn_clear_flags(conn, NETCONN_FLAG_CHECK_WRITESPACE);
 383:./lwip-2.1.2/src/api/api_msg.c ****       API_EVENT(conn, NETCONN_EVT_SENDPLUS, 0);
 384:./lwip-2.1.2/src/api/api_msg.c ****     }
 385:./lwip-2.1.2/src/api/api_msg.c ****   }
 386:./lwip-2.1.2/src/api/api_msg.c **** 
 387:./lwip-2.1.2/src/api/api_msg.c ****   return ERR_OK;
 388:./lwip-2.1.2/src/api/api_msg.c **** }
 389:./lwip-2.1.2/src/api/api_msg.c **** 
 390:./lwip-2.1.2/src/api/api_msg.c **** /**
 391:./lwip-2.1.2/src/api/api_msg.c ****  * Sent callback function for TCP netconns.
 392:./lwip-2.1.2/src/api/api_msg.c ****  * Signals the conn->sem and calls API_EVENT.
 393:./lwip-2.1.2/src/api/api_msg.c ****  * netconn_write waits for conn->sem if send buffer is low.
 394:./lwip-2.1.2/src/api/api_msg.c ****  *
 395:./lwip-2.1.2/src/api/api_msg.c ****  * @see tcp.h (struct tcp_pcb.sent) for parameters and return value
 396:./lwip-2.1.2/src/api/api_msg.c ****  */
 397:./lwip-2.1.2/src/api/api_msg.c **** static err_t
 398:./lwip-2.1.2/src/api/api_msg.c **** sent_tcp(void *arg, struct tcp_pcb *pcb, u16_t len)
 399:./lwip-2.1.2/src/api/api_msg.c **** {
 400:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *conn = (struct netconn *)arg;
 401:./lwip-2.1.2/src/api/api_msg.c **** 
 402:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_UNUSED_ARG(pcb);
 403:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("conn != NULL", (conn != NULL));
 404:./lwip-2.1.2/src/api/api_msg.c **** 
 405:./lwip-2.1.2/src/api/api_msg.c ****   if (conn) {
 406:./lwip-2.1.2/src/api/api_msg.c ****     if (conn->state == NETCONN_WRITE) {
 407:./lwip-2.1.2/src/api/api_msg.c ****       lwip_netconn_do_writemore(conn  WRITE_DELAYED);
 408:./lwip-2.1.2/src/api/api_msg.c ****     } else if (conn->state == NETCONN_CLOSE) {
 409:./lwip-2.1.2/src/api/api_msg.c ****       lwip_netconn_do_close_internal(conn  WRITE_DELAYED);
 410:./lwip-2.1.2/src/api/api_msg.c ****     }
 411:./lwip-2.1.2/src/api/api_msg.c **** 
 412:./lwip-2.1.2/src/api/api_msg.c ****     /* If the queued byte- or pbuf-count drops below the configured low-water limit,
 413:./lwip-2.1.2/src/api/api_msg.c ****        let select mark this pcb as writable again. */
 414:./lwip-2.1.2/src/api/api_msg.c ****     if ((conn->pcb.tcp != NULL) && (tcp_sndbuf(conn->pcb.tcp) > TCP_SNDLOWAT) &&
 415:./lwip-2.1.2/src/api/api_msg.c ****         (tcp_sndqueuelen(conn->pcb.tcp) < TCP_SNDQUEUELOWAT)) {
 416:./lwip-2.1.2/src/api/api_msg.c ****       netconn_clear_flags(conn, NETCONN_FLAG_CHECK_WRITESPACE);
 417:./lwip-2.1.2/src/api/api_msg.c ****       API_EVENT(conn, NETCONN_EVT_SENDPLUS, len);
 418:./lwip-2.1.2/src/api/api_msg.c ****     }
 419:./lwip-2.1.2/src/api/api_msg.c ****   }
 420:./lwip-2.1.2/src/api/api_msg.c **** 
 421:./lwip-2.1.2/src/api/api_msg.c ****   return ERR_OK;
 422:./lwip-2.1.2/src/api/api_msg.c **** }
 423:./lwip-2.1.2/src/api/api_msg.c **** 
 424:./lwip-2.1.2/src/api/api_msg.c **** /**
 425:./lwip-2.1.2/src/api/api_msg.c ****  * Error callback function for TCP netconns.
 426:./lwip-2.1.2/src/api/api_msg.c ****  * Signals conn->sem, posts to all conn mboxes and calls API_EVENT.
 427:./lwip-2.1.2/src/api/api_msg.c ****  * The application thread has then to decide what to do.
 428:./lwip-2.1.2/src/api/api_msg.c ****  *
 429:./lwip-2.1.2/src/api/api_msg.c ****  * @see tcp.h (struct tcp_pcb.err) for parameters
 430:./lwip-2.1.2/src/api/api_msg.c ****  */
 431:./lwip-2.1.2/src/api/api_msg.c **** static void
 432:./lwip-2.1.2/src/api/api_msg.c **** err_tcp(void *arg, err_t err)
 433:./lwip-2.1.2/src/api/api_msg.c **** {
 434:./lwip-2.1.2/src/api/api_msg.c ****   struct netconn *conn;
 435:./lwip-2.1.2/src/api/api_msg.c ****   enum netconn_state old_state;
 436:./lwip-2.1.2/src/api/api_msg.c ****   void *mbox_msg;
 437:./lwip-2.1.2/src/api/api_msg.c ****   SYS_ARCH_DECL_PROTECT(lev);
 438:./lwip-2.1.2/src/api/api_msg.c **** 
 439:./lwip-2.1.2/src/api/api_msg.c ****   conn = (struct netconn *)arg;
 440:./lwip-2.1.2/src/api/api_msg.c ****   LWIP_ASSERT("conn != NULL", (conn != NULL));
 441:./lwip-2.1.2/src/api/api_msg.c **** 
 442:./lwip-2.1.2/src/api/api_msg.c ****   SYS_ARCH_PROTECT(lev);
 443:./lwip-2.1.2/src/api/api_msg.c **** 
 444:./lwip-2.1.2/src/api/api_msg.c ****   /* when err is called, the pcb is deallocated, so delete the reference */
 445:./lwip-2.1.2/src/api/api_msg.c ****   conn->pcb.tcp = NULL;
 446:./lwip-2.1.2/src/api/api_msg.c ****   /* store pending error */
 447:./lwip-2.1.2/src/api/api_msg.c ****   conn->pending_err = err;
 448:./lwip-2.1.2/src/api/api_msg.c ****   /* prevent application threads from blocking on 'recvmbox'/'acceptmbox' */
 449:./lwip-2.1.2/src/api/api_msg.c ****   conn->flags |= NETCONN_FLAG_MBOXCLOSED;
 450:./lwip-2.1.2/src/api/api_msg.c **** 
 451:./lwip-2.1.2/src/api/api_msg.c ****   /* reset conn->state now before waking up other threads */
 452:./lwip-2.1.2/src/api/api_msg.c ****   old_state = conn->state;
 453:./lwip-2.1.2/src/api/api_msg.c ****   conn->state = NETCONN_NONE;
 454:./lwip-2.1.2/src/api/api_msg.c **** 
 455:./lwip-2.1.2/src/api/api_msg.c ****   SYS_ARCH_UNPROTECT(lev);
 456:./lwip-2.1.2/src/api/api_msg.c **** 
 457:./lwip-2.1.2/src/api/api_msg.c ****   /* Notify the user layer about a connection error. Used to signal select. */
 458:./lwip-2.1.2/src/api/api_msg.c ****   API_EVENT(conn, NETCONN_EVT_ERROR, 0);
 459:./lwip-2.1.2/src/api/api_msg.c ****   /* Try to release selects pending on 'read' or 'write', too.
 460:./lwip-2.1.2/src/api/api_msg.c ****      They will get an error if they actually try to read or write. */
 461:./lwip-2.1.2/src/api/api_msg.c ****   API_EVENT(conn, NETCONN_EVT_RCVPLUS, 0);
 462:./lwip-2.1.2/src/api/api_msg.c ****   API_EVENT(conn, NETCONN_EVT_SENDPLUS, 0);
 463:./lwip-2.1.2/src/api/api_msg.c **** 
 464:./lwip-2.1.2/src/api/api_msg.c ****   mbox_msg = lwip_netconn_err_to_msg(err);
 465:./lwip-2.1.2/src/api/api_msg.c ****   /* pass error message to recvmbox to wake up pending recv */
 466:./lwip-2.1.2/src/api/api_msg.c ****   if (NETCONN_MBOX_VALID(conn, &conn->recvmbox)) {
 467:./lwip-2.1.2/src/api/api_msg.c ****     /* use trypost to prevent deadlock */
 468:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_trypost(&conn->recvmbox, mbox_msg);
 469:./lwip-2.1.2/src/api/api_msg.c ****   }
 470:./lwip-2.1.2/src/api/api_msg.c ****   /* pass error message to acceptmbox to wake up pending accept */
 471:./lwip-2.1.2/src/api/api_msg.c ****   if (NETCONN_MBOX_VALID(conn, &conn->acceptmbox)) {
 472:./lwip-2.1.2/src/api/api_msg.c ****     /* use trypost to preven deadlock */
 473:./lwip-2.1.2/src/api/api_msg.c ****     sys_mbox_trypost(&conn->acceptmbox, mbox_msg);
 474:./lwip-2.1.2/src/api/api_msg.c ****   }
 475:./lwip-2.1.2/src/api/api_msg.c **** 
 476:./lwip-2.1.2/src/api/api_msg.c ****   if ((old_state == NETCONN_WRITE) || (old_state == NETCONN_CLOSE) ||
 477:./lwip-2.1.2/src/api/api_msg.c ****       (old_state == NETCONN_CONNECT)) {
 478:./lwip-2.1.2/src/api/api_msg.c ****     /* calling lwip_netconn_do_writemore/lwip_netconn_do_close_internal is not necessary
 479:./lwip-2.1.2/src/api/api_msg.c ****        since the pcb has already been deleted! */
 480:./lwip-2.1.2/src/api/api_msg.c ****     int was_nonblocking_connect = IN_NONBLOCKING_CONNECT(conn);
 481:./lwip-2.1.2/src/api/api_msg.c ****     SET_NONBLOCKING_CONNECT(conn, 0);
 482:./lwip-2.1.2/src/api/api_msg.c **** 
 483:./lwip-2.1.2/src/api/api_msg.c ****     if (!was_nonblocking_connect) {
 484:./lwip-2.1.2/src/api/api_msg.c ****       sys_sem_t *op_completed_sem;
 485:./lwip-2.1.2/src/api/api_msg.c ****       /* set error return code */
 486:./lwip-2.1.2/src/api/api_msg.c ****       LWIP_ASSERT("conn->current_msg != NULL", conn->current_msg != NULL);
 487:./lwip-2.1.2/src/api/api_msg.c ****       if (old_state == NETCONN_CLOSE) {
 488:./lwip-2.1.2/src/api/api_msg.c ****         /* let close succeed: the connection is closed after all... */
 489:./lwip-2.1.2/src/api/api_msg.c ****         conn->current_msg->err = ERR_OK;
 490:./lwip-2.1.2/src/api/api_msg.c ****       } else {
 491:./lwip-2.1.2/src/api/api_msg.c ****         /* Write and connect fail */
 492:./lwip-2.1.2/src/api/api_msg.c ****         conn->current_msg->err = err;
 493:./lwip-2.1.2/src/api/api_msg.c ****       }
 494:./lwip-2.1.2/src/api/api_msg.c ****       op_completed_sem = LWIP_API_MSG_SEM(conn->current_msg);
 495:./lwip-2.1.2/src/api/api_msg.c ****       LWIP_ASSERT("inavlid op_completed_sem", sys_sem_valid(op_completed_sem));
 496:./lwip-2.1.2/src/api/api_msg.c ****       conn->current_msg = NULL;
 497:./lwip-2.1.2/src/api/api_msg.c ****       /* wake up the waiting task */
 498:./lwip-2.1.2/src/api/api_msg.c ****       sys_sem_signal(op_completed_sem);
 499:./lwip-2.1.2/src/api/api_msg.c ****     } else {
 500:./lwip-2.1.2/src/api/api_msg.c ****       /* @todo: test what happens for error on nonblocking connect */
 501:./lwip-2.1.2/src/api/api_msg.c ****     }
 502:./lwip-2.1.2/src/api/api_msg.c ****   } else {
 503:./lwip-2.1.2/src/api/api_msg.c ****     LWIP_ASSERT("conn->current_msg == NULL", conn->current_msg == NULL);
 504:./lwip-2.1.2/src/api/api_msg.c ****   }
 505:./lwip-2.1.2/src/api/api_msg.c **** }
 506:./lwip-2.1.2/src/api/api_msg.c **** 

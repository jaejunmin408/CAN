 900:./inc/cmsis_gcc.h ****   \brief   No Operation
 901:./inc/cmsis_gcc.h ****   \details No Operation does nothing. This instruction can be used for code alignment purposes.
 902:./inc/cmsis_gcc.h ****  */
 903:./inc/cmsis_gcc.h **** #define __NOP()                             __ASM volatile ("nop")
 904:./inc/cmsis_gcc.h **** 
 905:./inc/cmsis_gcc.h **** /**
 906:./inc/cmsis_gcc.h ****   \brief   Wait For Interrupt
 907:./inc/cmsis_gcc.h ****   \details Wait For Interrupt is a hint instruction that suspends execution until one of a number o
 908:./inc/cmsis_gcc.h ****  */
 909:./inc/cmsis_gcc.h **** #define __WFI()                             __ASM volatile ("wfi")
 910:./inc/cmsis_gcc.h **** 
 911:./inc/cmsis_gcc.h **** 
 912:./inc/cmsis_gcc.h **** /**
 913:./inc/cmsis_gcc.h ****   \brief   Wait For Event
 914:./inc/cmsis_gcc.h ****   \details Wait For Event is a hint instruction that permits the processor to enter
 915:./inc/cmsis_gcc.h ****            a low-power state until one of a number of events occurs.
 916:./inc/cmsis_gcc.h ****  */
 917:./inc/cmsis_gcc.h **** #define __WFE()                             __ASM volatile ("wfe")
 918:./inc/cmsis_gcc.h **** 
 919:./inc/cmsis_gcc.h **** 
 920:./inc/cmsis_gcc.h **** /**
 921:./inc/cmsis_gcc.h ****   \brief   Send Event

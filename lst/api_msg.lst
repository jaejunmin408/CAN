 795:./inc/cmsis_gcc.h ****     (!defined (__ARM_FEATURE_CMSE) || (__ARM_FEATURE_CMSE < 3)))
 796:./inc/cmsis_gcc.h ****   // without main extensions, the non-secure MSPLIM is RAZ/WI
 797:./inc/cmsis_gcc.h ****   (void)MainStackPtrLimit;
 798:./inc/cmsis_gcc.h **** #else

 899:./lwip-2.1.2/src/core/ipv4/etharp.c **** /**
 900:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * Send an ARP request for the given IP address and/or queue a packet.
 901:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 902:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was not yet in the cache, a pending ARP cache entry
 903:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * is added and an ARP request is sent for the given address. The packet
 904:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * is queued on this entry.
 905:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 906:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was already pending in the cache, a new ARP request
 907:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * is sent for the given address. The packet is queued on this entry.
 908:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 909:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was already stable in the cache, and a packet is
 910:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * given, it is directly sent and no ARP request is sent out.
 911:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 912:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was already stable in the cache, and no packet is
 913:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * given, an ARP request is sent out.
 914:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 915:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param netif The lwIP network interface on which ipaddr
 916:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * must be queried for.
 917:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param ipaddr The IP address to be resolved.
 918:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param q If non-NULL, a pbuf that must be delivered to the IP address.
 919:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * q is not freed by this function.
 920:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 921:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @note q must only be ONE packet, not a packet queue!
 922:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 923:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @return
 924:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_BUF Could not make room for Ethernet header.
 925:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_MEM Hardware address unknown, and no more ARP entries available
 926:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *   to query for address or queue the packet.
 927:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_MEM Could not queue packet due to memory shortage.
 928:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_RTE No route to destination (no gateway to external networks).
 929:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_ARG Non-unicast address given, those will not appear in ARP cache.
 930:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 931:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
 932:./lwip-2.1.2/src/core/ipv4/etharp.c **** err_t
 933:./lwip-2.1.2/src/core/ipv4/etharp.c **** etharp_query(struct netif *netif, const ip4_addr_t *ipaddr, struct pbuf *q)
 934:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 935:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct eth_addr *srcaddr = (struct eth_addr *)netif->hwaddr;
 936:./lwip-2.1.2/src/core/ipv4/etharp.c ****   err_t result = ERR_MEM;
 937:./lwip-2.1.2/src/core/ipv4/etharp.c ****   int is_new_entry = 0;
 938:./lwip-2.1.2/src/core/ipv4/etharp.c ****   s16_t i_err;
 939:./lwip-2.1.2/src/core/ipv4/etharp.c ****   netif_addr_idx_t i;
 940:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 941:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* non-unicast address? */
 942:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (ip4_addr_isbroadcast(ipaddr, netif) ||
 943:./lwip-2.1.2/src/core/ipv4/etharp.c ****       ip4_addr_ismulticast(ipaddr) ||
 944:./lwip-2.1.2/src/core/ipv4/etharp.c ****       ip4_addr_isany(ipaddr)) {
 945:./lwip-2.1.2/src/core/ipv4/etharp.c ****     LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_query: will not add non-unicast IP address 
 946:./lwip-2.1.2/src/core/ipv4/etharp.c ****     return ERR_ARG;
 947:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 948:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 949:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* find entry in ARP cache, ask to create entry if queueing packet */
 950:./lwip-2.1.2/src/core/ipv4/etharp.c ****   i_err = etharp_find_entry(ipaddr, ETHARP_FLAG_TRY_HARD, netif);
 951:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 952:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* could not find or create entry? */
 953:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (i_err < 0) {
 954:./lwip-2.1.2/src/core/ipv4/etharp.c ****     LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_query: could not create ARP entry\n"));
 955:./lwip-2.1.2/src/core/ipv4/etharp.c ****     if (q) {
 956:./lwip-2.1.2/src/core/ipv4/etharp.c ****       LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_query: packet dropped\n"));
 957:./lwip-2.1.2/src/core/ipv4/etharp.c ****       ETHARP_STATS_INC(etharp.memerr);
 958:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 959:./lwip-2.1.2/src/core/ipv4/etharp.c ****     return (err_t)i_err;
 960:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 961:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("type overflow", (size_t)i_err < NETIF_ADDR_IDX_MAX);
 962:./lwip-2.1.2/src/core/ipv4/etharp.c ****   i = (netif_addr_idx_t)i_err;
 963:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 964:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* mark a fresh entry as pending (we just sent a request) */
 965:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (arp_table[i].state == ETHARP_STATE_EMPTY) {
 966:./lwip-2.1.2/src/core/ipv4/etharp.c ****     is_new_entry = 1;
 967:./lwip-2.1.2/src/core/ipv4/etharp.c ****     arp_table[i].state = ETHARP_STATE_PENDING;
 968:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* record network interface for re-sending arp request in etharp_tmr */
 969:./lwip-2.1.2/src/core/ipv4/etharp.c ****     arp_table[i].netif = netif;
 970:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 971:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 972:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* { i is either a STABLE or (new or existing) PENDING entry } */
 973:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("arp_table[i].state == PENDING or STABLE",
 974:./lwip-2.1.2/src/core/ipv4/etharp.c ****               ((arp_table[i].state == ETHARP_STATE_PENDING) ||
 975:./lwip-2.1.2/src/core/ipv4/etharp.c ****                (arp_table[i].state >= ETHARP_STATE_STABLE)));
 976:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 977:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* do we have a new entry? or an implicit query request? */
 978:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (is_new_entry || (q == NULL)) {
 979:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* try to resolve it; send out ARP request */
 980:./lwip-2.1.2/src/core/ipv4/etharp.c ****     result = etharp_request(netif, ipaddr);
 981:./lwip-2.1.2/src/core/ipv4/etharp.c ****     if (result != ERR_OK) {
 982:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* ARP request couldn't be sent */
 983:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* We don't re-send arp request in etharp_tmr, but we still queue packets,
 984:./lwip-2.1.2/src/core/ipv4/etharp.c ****          since this failure could be temporary, and the next packet calling
 985:./lwip-2.1.2/src/core/ipv4/etharp.c ****          etharp_query again could lead to sending the queued packets. */
 986:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 987:./lwip-2.1.2/src/core/ipv4/etharp.c ****     if (q == NULL) {
 988:./lwip-2.1.2/src/core/ipv4/etharp.c ****       return result;
 989:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 990:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 991:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 992:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* packet given? */
 993:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("q != NULL", q != NULL);

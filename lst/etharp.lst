 133:./lwip-2.1.2/src/core/ipv4/etharp.c **** static err_t etharp_request_dst(struct netif *netif, const ip4_addr_t *ipaddr, const struct eth_add
 134:./lwip-2.1.2/src/core/ipv4/etharp.c **** static err_t etharp_raw(struct netif *netif,
 135:./lwip-2.1.2/src/core/ipv4/etharp.c ****                         const struct eth_addr *ethsrc_addr, const struct eth_addr *ethdst_addr,
 136:./lwip-2.1.2/src/core/ipv4/etharp.c ****                         const struct eth_addr *hwsrc_addr, const ip4_addr_t *ipsrc_addr,
 137:./lwip-2.1.2/src/core/ipv4/etharp.c ****                         const struct eth_addr *hwdst_addr, const ip4_addr_t *ipdst_addr,
 138:./lwip-2.1.2/src/core/ipv4/etharp.c ****                         const u16_t opcode);
 139:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 140:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if ARP_QUEUEING
 141:./lwip-2.1.2/src/core/ipv4/etharp.c **** /**
 142:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * Free a complete queue of etharp entries
 143:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 144:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param q a qeueue of etharp_q_entry's to free
 145:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
 146:./lwip-2.1.2/src/core/ipv4/etharp.c **** static void
 147:./lwip-2.1.2/src/core/ipv4/etharp.c **** free_etharp_q(struct etharp_q_entry *q)
 148:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 149:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct etharp_q_entry *r;
 150:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("q != NULL", q != NULL);
 151:./lwip-2.1.2/src/core/ipv4/etharp.c ****   while (q) {
 152:./lwip-2.1.2/src/core/ipv4/etharp.c ****     r = q;
 153:./lwip-2.1.2/src/core/ipv4/etharp.c ****     q = q->next;
 154:./lwip-2.1.2/src/core/ipv4/etharp.c ****     LWIP_ASSERT("r->p != NULL", (r->p != NULL));
 155:./lwip-2.1.2/src/core/ipv4/etharp.c ****     pbuf_free(r->p);
 156:./lwip-2.1.2/src/core/ipv4/etharp.c ****     memp_free(MEMP_ARP_QUEUE, r);
 157:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 158:./lwip-2.1.2/src/core/ipv4/etharp.c **** }
 159:./lwip-2.1.2/src/core/ipv4/etharp.c **** #else /* ARP_QUEUEING */
 160:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 161:./lwip-2.1.2/src/core/ipv4/etharp.c **** /** Compatibility define: free the queued pbuf */
 162:./lwip-2.1.2/src/core/ipv4/etharp.c **** #define free_etharp_q(q) pbuf_free(q)
 163:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 164:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* ARP_QUEUEING */
 165:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 166:./lwip-2.1.2/src/core/ipv4/etharp.c **** /** Clean up ARP table entries */
 167:./lwip-2.1.2/src/core/ipv4/etharp.c **** static void
 168:./lwip-2.1.2/src/core/ipv4/etharp.c **** etharp_free_entry(int i)
 169:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 170:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* remove from SNMP ARP index tree */
 171:./lwip-2.1.2/src/core/ipv4/etharp.c ****   mib2_remove_arp_entry(arp_table[i].netif, &arp_table[i].ipaddr);
 172:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* and empty packet queue */
 173:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (arp_table[i].q != NULL) {
 174:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* remove all queued packets */
 175:./lwip-2.1.2/src/core/ipv4/etharp.c ****     LWIP_DEBUGF(ETHARP_DEBUG, ("etharp_free_entry: freeing entry %"U16_F", packet queue %p.\n", (u1
 176:./lwip-2.1.2/src/core/ipv4/etharp.c ****     free_etharp_q(arp_table[i].q);
 177:./lwip-2.1.2/src/core/ipv4/etharp.c ****     arp_table[i].q = NULL;
 178:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 179:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* recycle entry for re-use */
 180:./lwip-2.1.2/src/core/ipv4/etharp.c ****   arp_table[i].state = ETHARP_STATE_EMPTY;
 181:./lwip-2.1.2/src/core/ipv4/etharp.c **** #ifdef LWIP_DEBUG
 182:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* for debugging, clean out the complete entry */
 183:./lwip-2.1.2/src/core/ipv4/etharp.c ****   arp_table[i].ctime = 0;
 184:./lwip-2.1.2/src/core/ipv4/etharp.c ****   arp_table[i].netif = NULL;
 185:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ip4_addr_set_zero(&arp_table[i].ipaddr);
 186:./lwip-2.1.2/src/core/ipv4/etharp.c ****   arp_table[i].ethaddr = ethzero;
 187:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* LWIP_DEBUG */
 188:./lwip-2.1.2/src/core/ipv4/etharp.c **** }
 189:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 190:./lwip-2.1.2/src/core/ipv4/etharp.c **** /**
 191:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * Clears expired entries in the ARP table.
 192:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 193:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * This function should be called every ARP_TMR_INTERVAL milliseconds (1 second),
 194:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * in order to expire entries in the ARP table.
 195:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
 196:./lwip-2.1.2/src/core/ipv4/etharp.c **** void
 197:./lwip-2.1.2/src/core/ipv4/etharp.c **** etharp_tmr(void)
 198:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 199:./lwip-2.1.2/src/core/ipv4/etharp.c ****   int i;
 200:./lwip-2.1.2/src/core/ipv4/etharp.c **** 

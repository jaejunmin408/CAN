 858:./lwip-2.1.2/src/core/ipv4/etharp.c ****       netif_addr_idx_t etharp_cached_entry = netif->hints->addr_hint;
 859:./lwip-2.1.2/src/core/ipv4/etharp.c ****       if (etharp_cached_entry < ARP_TABLE_SIZE) {
 860:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* LWIP_NETIF_HWADDRHINT */
 861:./lwip-2.1.2/src/core/ipv4/etharp.c ****         if ((arp_table[etharp_cached_entry].state >= ETHARP_STATE_STABLE) &&
 862:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if ETHARP_TABLE_MATCH_NETIF
 863:./lwip-2.1.2/src/core/ipv4/etharp.c ****             (arp_table[etharp_cached_entry].netif == netif) &&
 864:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif
 865:./lwip-2.1.2/src/core/ipv4/etharp.c ****             (ip4_addr_cmp(dst_addr, &arp_table[etharp_cached_entry].ipaddr))) {
 866:./lwip-2.1.2/src/core/ipv4/etharp.c ****           /* the per-pcb-cached entry is stable and the right one! */
 867:./lwip-2.1.2/src/core/ipv4/etharp.c ****           ETHARP_STATS_INC(etharp.cachehit);
 868:./lwip-2.1.2/src/core/ipv4/etharp.c ****           return etharp_output_to_arp_index(netif, q, etharp_cached_entry);
 869:./lwip-2.1.2/src/core/ipv4/etharp.c ****         }
 870:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if LWIP_NETIF_HWADDRHINT
 871:./lwip-2.1.2/src/core/ipv4/etharp.c ****       }
 872:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 873:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* LWIP_NETIF_HWADDRHINT */
 874:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 875:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* find stable entry: do this here since this is a critical path for
 876:./lwip-2.1.2/src/core/ipv4/etharp.c ****        throughput and etharp_find_entry() is kind of slow */
 877:./lwip-2.1.2/src/core/ipv4/etharp.c ****     for (i = 0; i < ARP_TABLE_SIZE; i++) {
 878:./lwip-2.1.2/src/core/ipv4/etharp.c ****       if ((arp_table[i].state >= ETHARP_STATE_STABLE) &&
 879:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if ETHARP_TABLE_MATCH_NETIF
 880:./lwip-2.1.2/src/core/ipv4/etharp.c ****           (arp_table[i].netif == netif) &&
 881:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif
 882:./lwip-2.1.2/src/core/ipv4/etharp.c ****           (ip4_addr_cmp(dst_addr, &arp_table[i].ipaddr))) {
 883:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* found an existing, stable entry */
 884:./lwip-2.1.2/src/core/ipv4/etharp.c ****         ETHARP_SET_ADDRHINT(netif, i);

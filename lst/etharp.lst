 989:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 990:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 991:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 992:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* packet given? */
 993:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("q != NULL", q != NULL);
 994:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* stable entry? */
 995:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (arp_table[i].state >= ETHARP_STATE_STABLE) {
 996:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* we have a valid IP->Ethernet address mapping */
 997:./lwip-2.1.2/src/core/ipv4/etharp.c ****     ETHARP_SET_ADDRHINT(netif, i);

 695:./lwip-2.1.2/src/core/ipv4/etharp.c ****                           for_us ? ETHARP_FLAG_TRY_HARD : ETHARP_FLAG_FIND_ONLY);
 696:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 697:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* now act on the message itself */
 698:./lwip-2.1.2/src/core/ipv4/etharp.c ****   switch (hdr->opcode) {
 699:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* ARP request? */
 700:./lwip-2.1.2/src/core/ipv4/etharp.c ****     case PP_HTONS(ARP_REQUEST):
 701:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* ARP request. If it asked for our address, we send out a
 702:./lwip-2.1.2/src/core/ipv4/etharp.c ****        * reply. In any case, we time-stamp any existing ARP entry,
 703:./lwip-2.1.2/src/core/ipv4/etharp.c ****        * and possibly send out an IP packet that was queued on it. */
 704:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 705:./lwip-2.1.2/src/core/ipv4/etharp.c ****       LWIP_DEBUGF (ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_input: incoming ARP request\n"));
 706:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* ARP request for our address? */
 707:./lwip-2.1.2/src/core/ipv4/etharp.c ****       if (for_us) {
 708:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* send ARP response */
 709:./lwip-2.1.2/src/core/ipv4/etharp.c ****         etharp_raw(netif,

 744:./lwip-2.1.2/src/core/ipv4/etharp.c **** /** Just a small helper function that sends a pbuf to an ethernet address
 745:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * in the arp_table specified by the index 'arp_idx'.
 746:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
 747:./lwip-2.1.2/src/core/ipv4/etharp.c **** static err_t
 748:./lwip-2.1.2/src/core/ipv4/etharp.c **** etharp_output_to_arp_index(struct netif *netif, struct pbuf *q, netif_addr_idx_t arp_idx)
 749:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 750:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("arp_table[arp_idx].state >= ETHARP_STATE_STABLE",
 751:./lwip-2.1.2/src/core/ipv4/etharp.c ****               arp_table[arp_idx].state >= ETHARP_STATE_STABLE);
 752:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* if arp table entry is about to expire: re-request it,
 753:./lwip-2.1.2/src/core/ipv4/etharp.c ****      but only if its state is ETHARP_STATE_STABLE to prevent flooding the
 754:./lwip-2.1.2/src/core/ipv4/etharp.c ****      network with ARP requests if this address is used frequently. */
 755:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (arp_table[arp_idx].state == ETHARP_STATE_STABLE) {
 756:./lwip-2.1.2/src/core/ipv4/etharp.c ****     if (arp_table[arp_idx].ctime >= ARP_AGE_REREQUEST_USED_BROADCAST) {
 757:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* issue a standard request using broadcast */
 758:./lwip-2.1.2/src/core/ipv4/etharp.c ****       if (etharp_request(netif, &arp_table[arp_idx].ipaddr) == ERR_OK) {
 759:./lwip-2.1.2/src/core/ipv4/etharp.c ****         arp_table[arp_idx].state = ETHARP_STATE_STABLE_REREQUESTING_1;
 760:./lwip-2.1.2/src/core/ipv4/etharp.c ****       }
 761:./lwip-2.1.2/src/core/ipv4/etharp.c ****     } else if (arp_table[arp_idx].ctime >= ARP_AGE_REREQUEST_USED_UNICAST) {
 762:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* issue a unicast request (for 15 seconds) to prevent unnecessary broadcast */
 763:./lwip-2.1.2/src/core/ipv4/etharp.c ****       if (etharp_request_dst(netif, &arp_table[arp_idx].ipaddr, &arp_table[arp_idx].ethaddr) == ERR
 764:./lwip-2.1.2/src/core/ipv4/etharp.c ****         arp_table[arp_idx].state = ETHARP_STATE_STABLE_REREQUESTING_1;
 765:./lwip-2.1.2/src/core/ipv4/etharp.c ****       }
 766:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 767:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 768:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 769:./lwip-2.1.2/src/core/ipv4/etharp.c ****   return ethernet_output(netif, q, (struct eth_addr *)(netif->hwaddr), &arp_table[arp_idx].ethaddr,
 770:./lwip-2.1.2/src/core/ipv4/etharp.c **** }
 771:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 772:./lwip-2.1.2/src/core/ipv4/etharp.c **** /**
 773:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * Resolve and fill-in Ethernet address header for outgoing IP packet.
 774:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 775:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * For IP multicast and broadcast, corresponding Ethernet addresses
 776:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * are selected and the packet is transmitted on the link.
 777:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *

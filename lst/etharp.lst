 711:./lwip-2.1.2/src/core/ipv4/etharp.c ****                    (struct eth_addr *)netif->hwaddr, netif_ip4_addr(netif),
 712:./lwip-2.1.2/src/core/ipv4/etharp.c ****                    &hdr->shwaddr, &sipaddr,
 713:./lwip-2.1.2/src/core/ipv4/etharp.c ****                    ARP_REPLY);
 714:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* we are not configured? */
 715:./lwip-2.1.2/src/core/ipv4/etharp.c ****       } else if (ip4_addr_isany_val(*netif_ip4_addr(netif))) {
 716:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* { for_us == 0 and netif->ip_addr.addr == 0 } */
 717:./lwip-2.1.2/src/core/ipv4/etharp.c ****         LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_input: we are unconfigured, ARP request
 718:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* request was not directed to us */
 719:./lwip-2.1.2/src/core/ipv4/etharp.c ****       } else {
 720:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* { for_us == 0 and netif->ip_addr.addr != 0 } */
 721:./lwip-2.1.2/src/core/ipv4/etharp.c ****         LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_input: ARP request was not for us.\n"))
 722:./lwip-2.1.2/src/core/ipv4/etharp.c ****       }
 723:./lwip-2.1.2/src/core/ipv4/etharp.c ****       break;
 724:./lwip-2.1.2/src/core/ipv4/etharp.c ****     case PP_HTONS(ARP_REPLY):
 725:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* ARP reply. We already updated the ARP cache earlier. */
 726:./lwip-2.1.2/src/core/ipv4/etharp.c ****       LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_input: incoming ARP reply\n"));
 727:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if (LWIP_DHCP && DHCP_DOES_ARP_CHECK)
 728:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* DHCP wants to know about ARP replies from any host with an

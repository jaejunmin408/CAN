 788:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * or the return type of either etharp_query() or ethernet_output().
 789:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
 790:./lwip-2.1.2/src/core/ipv4/etharp.c **** err_t
 791:./lwip-2.1.2/src/core/ipv4/etharp.c **** etharp_output(struct netif *netif, struct pbuf *q, const ip4_addr_t *ipaddr)
 792:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 793:./lwip-2.1.2/src/core/ipv4/etharp.c ****   const struct eth_addr *dest;
 794:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct eth_addr mcastaddr;

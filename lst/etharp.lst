 886:./lwip-2.1.2/src/core/ipv4/etharp.c ****       }
 887:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 888:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* no stable entry found, use the (slower) query function:
 889:./lwip-2.1.2/src/core/ipv4/etharp.c ****        queue on destination Ethernet address belonging to ipaddr */
 890:./lwip-2.1.2/src/core/ipv4/etharp.c ****     return etharp_query(netif, dst_addr, q);
 891:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 892:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 893:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* continuation for multicast/broadcast destinations */
 894:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* obtain source Ethernet address of the given interface */
 895:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* send packet directly on the link */
 896:./lwip-2.1.2/src/core/ipv4/etharp.c ****   return ethernet_output(netif, q, (struct eth_addr *)(netif->hwaddr), dest, ETHTYPE_IP);
 897:./lwip-2.1.2/src/core/ipv4/etharp.c **** }

 731:./lwip-2.1.2/src/core/ipv4/etharp.c ****        * @todo How should we handle redundant (fail-over) interfaces? */
 732:./lwip-2.1.2/src/core/ipv4/etharp.c ****       dhcp_arp_reply(netif, &sipaddr);
 733:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* (LWIP_DHCP && DHCP_DOES_ARP_CHECK) */
 734:./lwip-2.1.2/src/core/ipv4/etharp.c ****       break;
 735:./lwip-2.1.2/src/core/ipv4/etharp.c ****     default:
 736:./lwip-2.1.2/src/core/ipv4/etharp.c ****       LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_input: ARP unknown opcode type %"S16_F"\n

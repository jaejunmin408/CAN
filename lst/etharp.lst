  64:./lwip-2.1.2/src/core/ipv4/etharp.c **** /** Re-request a used ARP entry 1 minute before it would expire to prevent
  65:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *  breaking a steadily used connection because the ARP entry timed out. */
  66:./lwip-2.1.2/src/core/ipv4/etharp.c **** #define ARP_AGE_REREQUEST_USED_UNICAST   (ARP_MAXAGE - 30)
  67:./lwip-2.1.2/src/core/ipv4/etharp.c **** #define ARP_AGE_REREQUEST_USED_BROADCAST (ARP_MAXAGE - 15)
  68:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
  69:./lwip-2.1.2/src/core/ipv4/etharp.c **** /** the time an ARP entry stays pending after first request,
  70:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *  for ARP_TMR_INTERVAL = 1000, this is
  71:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *  10 seconds.
  72:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
  73:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *  @internal Keep this number at least 2, otherwise it might
  74:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *  run out instantly if the timeout occurs directly after a request.
  75:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
  76:./lwip-2.1.2/src/core/ipv4/etharp.c **** #define ARP_MAXPENDING 5
  77:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
  78:./lwip-2.1.2/src/core/ipv4/etharp.c **** /** ARP states */
  79:./lwip-2.1.2/src/core/ipv4/etharp.c **** enum etharp_state {
  80:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ETHARP_STATE_EMPTY = 0,
  81:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ETHARP_STATE_PENDING,
  82:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ETHARP_STATE_STABLE,
  83:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ETHARP_STATE_STABLE_REREQUESTING_1,
  84:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ETHARP_STATE_STABLE_REREQUESTING_2
  85:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if ETHARP_SUPPORT_STATIC_ENTRIES
  86:./lwip-2.1.2/src/core/ipv4/etharp.c ****   , ETHARP_STATE_STATIC
  87:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* ETHARP_SUPPORT_STATIC_ENTRIES */
  88:./lwip-2.1.2/src/core/ipv4/etharp.c **** };
  89:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
  90:./lwip-2.1.2/src/core/ipv4/etharp.c **** struct etharp_entry {
  91:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if ARP_QUEUEING
  92:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /** Pointer to queue of pending outgoing packets on this ARP entry. */
  93:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct etharp_q_entry *q;
  94:./lwip-2.1.2/src/core/ipv4/etharp.c **** #else /* ARP_QUEUEING */
  95:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /** Pointer to a single pending outgoing packet on this ARP entry. */

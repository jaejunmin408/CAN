  97:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* ARP_QUEUEING */
  98:./lwip-2.1.2/src/core/ipv4/etharp.c ****   ip4_addr_t ipaddr;
  99:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct netif *netif;
 100:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct eth_addr ethaddr;
 101:./lwip-2.1.2/src/core/ipv4/etharp.c ****   u16_t ctime;
 102:./lwip-2.1.2/src/core/ipv4/etharp.c ****   u8_t state;
 103:./lwip-2.1.2/src/core/ipv4/etharp.c **** };

 655:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if ((hdr->hwtype != PP_HTONS(LWIP_IANA_HWTYPE_ETHERNET)) ||
 656:./lwip-2.1.2/src/core/ipv4/etharp.c ****       (hdr->hwlen != ETH_HWADDR_LEN) ||

 899:./lwip-2.1.2/src/core/ipv4/etharp.c **** /**
 900:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * Send an ARP request for the given IP address and/or queue a packet.
 901:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 902:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was not yet in the cache, a pending ARP cache entry
 903:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * is added and an ARP request is sent for the given address. The packet
 904:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * is queued on this entry.
 905:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 906:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was already pending in the cache, a new ARP request
 907:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * is sent for the given address. The packet is queued on this entry.
 908:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 909:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was already stable in the cache, and a packet is
 910:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * given, it is directly sent and no ARP request is sent out.
 911:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 912:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * If the IP address was already stable in the cache, and no packet is
 913:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * given, an ARP request is sent out.
 914:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 915:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param netif The lwIP network interface on which ipaddr
 916:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * must be queried for.
 917:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param ipaddr The IP address to be resolved.
 918:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @param q If non-NULL, a pbuf that must be delivered to the IP address.
 919:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * q is not freed by this function.
 920:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 921:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @note q must only be ONE packet, not a packet queue!
 922:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 923:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * @return
 924:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_BUF Could not make room for Ethernet header.
 925:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_MEM Hardware address unknown, and no more ARP entries available
 926:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *   to query for address or queue the packet.
 927:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_MEM Could not queue packet due to memory shortage.
 928:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_RTE No route to destination (no gateway to external networks).
 929:./lwip-2.1.2/src/core/ipv4/etharp.c ****  * - ERR_ARG Non-unicast address given, those will not appear in ARP cache.
 930:./lwip-2.1.2/src/core/ipv4/etharp.c ****  *
 931:./lwip-2.1.2/src/core/ipv4/etharp.c ****  */
 932:./lwip-2.1.2/src/core/ipv4/etharp.c **** err_t
 933:./lwip-2.1.2/src/core/ipv4/etharp.c **** etharp_query(struct netif *netif, const ip4_addr_t *ipaddr, struct pbuf *q)
 934:./lwip-2.1.2/src/core/ipv4/etharp.c **** {
 935:./lwip-2.1.2/src/core/ipv4/etharp.c ****   struct eth_addr *srcaddr = (struct eth_addr *)netif->hwaddr;
 936:./lwip-2.1.2/src/core/ipv4/etharp.c ****   err_t result = ERR_MEM;

 960:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 961:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("type overflow", (size_t)i_err < NETIF_ADDR_IDX_MAX);
 962:./lwip-2.1.2/src/core/ipv4/etharp.c ****   i = (netif_addr_idx_t)i_err;
 963:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 964:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* mark a fresh entry as pending (we just sent a request) */
 965:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (arp_table[i].state == ETHARP_STATE_EMPTY) {
 966:./lwip-2.1.2/src/core/ipv4/etharp.c ****     is_new_entry = 1;
 967:./lwip-2.1.2/src/core/ipv4/etharp.c ****     arp_table[i].state = ETHARP_STATE_PENDING;
 968:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* record network interface for re-sending arp request in etharp_tmr */
 969:./lwip-2.1.2/src/core/ipv4/etharp.c ****     arp_table[i].netif = netif;
 970:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 971:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 972:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* { i is either a STABLE or (new or existing) PENDING entry } */
 973:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("arp_table[i].state == PENDING or STABLE",
 974:./lwip-2.1.2/src/core/ipv4/etharp.c ****               ((arp_table[i].state == ETHARP_STATE_PENDING) ||
 975:./lwip-2.1.2/src/core/ipv4/etharp.c ****                (arp_table[i].state >= ETHARP_STATE_STABLE)));
 976:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 977:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* do we have a new entry? or an implicit query request? */
 978:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (is_new_entry || (q == NULL)) {
 979:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* try to resolve it; send out ARP request */

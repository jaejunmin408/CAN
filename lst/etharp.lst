 941:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* non-unicast address? */
 942:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (ip4_addr_isbroadcast(ipaddr, netif) ||
 943:./lwip-2.1.2/src/core/ipv4/etharp.c ****       ip4_addr_ismulticast(ipaddr) ||
 944:./lwip-2.1.2/src/core/ipv4/etharp.c ****       ip4_addr_isany(ipaddr)) {
 945:./lwip-2.1.2/src/core/ipv4/etharp.c ****     LWIP_DEBUGF(ETHARP_DEBUG | LWIP_DBG_TRACE, ("etharp_query: will not add non-unicast IP address 

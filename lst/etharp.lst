 676:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* Copy struct ip4_addr_wordaligned to aligned ip4_addr, to support compilers without
 677:./lwip-2.1.2/src/core/ipv4/etharp.c ****    * structure packing (not using structure copy which breaks strict-aliasing rules). */
 678:./lwip-2.1.2/src/core/ipv4/etharp.c ****   IPADDR_WORDALIGNED_COPY_TO_IP4_ADDR_T(&sipaddr, &hdr->sipaddr);
 679:./lwip-2.1.2/src/core/ipv4/etharp.c ****   IPADDR_WORDALIGNED_COPY_TO_IP4_ADDR_T(&dipaddr, &hdr->dipaddr);
 680:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 681:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* this interface is not configured? */
 682:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (ip4_addr_isany_val(*netif_ip4_addr(netif))) {
 683:./lwip-2.1.2/src/core/ipv4/etharp.c ****     for_us = 0;
 684:./lwip-2.1.2/src/core/ipv4/etharp.c ****   } else {
 685:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* ARP packet directed to us? */
 686:./lwip-2.1.2/src/core/ipv4/etharp.c ****     for_us = (u8_t)ip4_addr_cmp(&dipaddr, netif_ip4_addr(netif));
 687:./lwip-2.1.2/src/core/ipv4/etharp.c ****   }
 688:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 689:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* ARP message directed to us?

 983:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* We don't re-send arp request in etharp_tmr, but we still queue packets,
 984:./lwip-2.1.2/src/core/ipv4/etharp.c ****          since this failure could be temporary, and the next packet calling
 985:./lwip-2.1.2/src/core/ipv4/etharp.c ****          etharp_query again could lead to sending the queued packets. */
 986:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }

 796:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 797:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT_CORE_LOCKED();
 798:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("netif != NULL", netif != NULL);
 799:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("q != NULL", q != NULL);
 800:./lwip-2.1.2/src/core/ipv4/etharp.c ****   LWIP_ASSERT("ipaddr != NULL", ipaddr != NULL);
 801:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 802:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* Determine on destination hardware address. Broadcasts and multicasts
 803:./lwip-2.1.2/src/core/ipv4/etharp.c ****    * are special, other IP addresses are looked up in the ARP table. */
 804:./lwip-2.1.2/src/core/ipv4/etharp.c **** 
 805:./lwip-2.1.2/src/core/ipv4/etharp.c ****   /* broadcast destination IP address? */
 806:./lwip-2.1.2/src/core/ipv4/etharp.c ****   if (ip4_addr_isbroadcast(ipaddr, netif)) {
 807:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* broadcast on Ethernet also */
 808:./lwip-2.1.2/src/core/ipv4/etharp.c ****     dest = (const struct eth_addr *)&ethbroadcast;
 809:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* multicast destination IP address? */
 810:./lwip-2.1.2/src/core/ipv4/etharp.c ****   } else if (ip4_addr_ismulticast(ipaddr)) {
 811:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* Hash IP multicast address to MAC address.*/
 812:./lwip-2.1.2/src/core/ipv4/etharp.c ****     mcastaddr.addr[0] = LL_IP4_MULTICAST_ADDR_0;
 813:./lwip-2.1.2/src/core/ipv4/etharp.c ****     mcastaddr.addr[1] = LL_IP4_MULTICAST_ADDR_1;
 814:./lwip-2.1.2/src/core/ipv4/etharp.c ****     mcastaddr.addr[2] = LL_IP4_MULTICAST_ADDR_2;
 815:./lwip-2.1.2/src/core/ipv4/etharp.c ****     mcastaddr.addr[3] = ip4_addr2(ipaddr) & 0x7f;
 816:./lwip-2.1.2/src/core/ipv4/etharp.c ****     mcastaddr.addr[4] = ip4_addr3(ipaddr);
 817:./lwip-2.1.2/src/core/ipv4/etharp.c ****     mcastaddr.addr[5] = ip4_addr4(ipaddr);
 818:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* destination Ethernet address is multicast */
 819:./lwip-2.1.2/src/core/ipv4/etharp.c ****     dest = &mcastaddr;
 820:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* unicast destination IP address? */
 821:./lwip-2.1.2/src/core/ipv4/etharp.c ****   } else {
 822:./lwip-2.1.2/src/core/ipv4/etharp.c ****     netif_addr_idx_t i;
 823:./lwip-2.1.2/src/core/ipv4/etharp.c ****     /* outside local network? if so, this can neither be a global broadcast nor
 824:./lwip-2.1.2/src/core/ipv4/etharp.c ****        a subnet broadcast. */
 825:./lwip-2.1.2/src/core/ipv4/etharp.c ****     if (!ip4_addr_netcmp(ipaddr, netif_ip4_addr(netif), netif_ip4_netmask(netif)) &&
 826:./lwip-2.1.2/src/core/ipv4/etharp.c ****         !ip4_addr_islinklocal(ipaddr)) {
 827:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if LWIP_AUTOIP
 828:./lwip-2.1.2/src/core/ipv4/etharp.c ****       struct ip_hdr *iphdr = LWIP_ALIGNMENT_CAST(struct ip_hdr *, q->payload);
 829:./lwip-2.1.2/src/core/ipv4/etharp.c ****       /* According to RFC 3297, chapter 2.6.2 (Forwarding Rules), a packet with
 830:./lwip-2.1.2/src/core/ipv4/etharp.c ****          a link-local source address must always be "directly to its destination
 831:./lwip-2.1.2/src/core/ipv4/etharp.c ****          on the same physical link. The host MUST NOT send the packet to any
 832:./lwip-2.1.2/src/core/ipv4/etharp.c ****          router for forwarding". */
 833:./lwip-2.1.2/src/core/ipv4/etharp.c ****       if (!ip4_addr_islinklocal(&iphdr->src))
 834:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* LWIP_AUTOIP */
 835:./lwip-2.1.2/src/core/ipv4/etharp.c ****       {
 836:./lwip-2.1.2/src/core/ipv4/etharp.c **** #ifdef LWIP_HOOK_ETHARP_GET_GW
 837:./lwip-2.1.2/src/core/ipv4/etharp.c ****         /* For advanced routing, a single default gateway might not be enough, so get
 838:./lwip-2.1.2/src/core/ipv4/etharp.c ****            the IP address of the gateway to handle the current destination address. */
 839:./lwip-2.1.2/src/core/ipv4/etharp.c ****         dst_addr = LWIP_HOOK_ETHARP_GET_GW(netif, ipaddr);
 840:./lwip-2.1.2/src/core/ipv4/etharp.c ****         if (dst_addr == NULL)
 841:./lwip-2.1.2/src/core/ipv4/etharp.c **** #endif /* LWIP_HOOK_ETHARP_GET_GW */
 842:./lwip-2.1.2/src/core/ipv4/etharp.c ****         {
 843:./lwip-2.1.2/src/core/ipv4/etharp.c ****           /* interface has default gateway? */
 844:./lwip-2.1.2/src/core/ipv4/etharp.c ****           if (!ip4_addr_isany_val(*netif_ip4_gw(netif))) {
 845:./lwip-2.1.2/src/core/ipv4/etharp.c ****             /* send to hardware address of default gateway IP address */
 846:./lwip-2.1.2/src/core/ipv4/etharp.c ****             dst_addr = netif_ip4_gw(netif);
 847:./lwip-2.1.2/src/core/ipv4/etharp.c ****             /* no default gateway available */
 848:./lwip-2.1.2/src/core/ipv4/etharp.c ****           } else {
 849:./lwip-2.1.2/src/core/ipv4/etharp.c ****             /* no route to destination error (default gateway missing) */
 850:./lwip-2.1.2/src/core/ipv4/etharp.c ****             return ERR_RTE;
 851:./lwip-2.1.2/src/core/ipv4/etharp.c ****           }
 852:./lwip-2.1.2/src/core/ipv4/etharp.c ****         }
 853:./lwip-2.1.2/src/core/ipv4/etharp.c ****       }
 854:./lwip-2.1.2/src/core/ipv4/etharp.c ****     }
 855:./lwip-2.1.2/src/core/ipv4/etharp.c **** #if LWIP_NETIF_HWADDRHINT
 856:./lwip-2.1.2/src/core/ipv4/etharp.c ****     if (netif->hints != NULL) {

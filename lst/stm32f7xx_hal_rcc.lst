1004:./inc/cmsis_gcc.h ****   return (int16_t)__builtin_bswap16(value);
1005:./inc/cmsis_gcc.h **** #else
1006:./inc/cmsis_gcc.h ****   int16_t result;
1007:./inc/cmsis_gcc.h **** 
1008:./inc/cmsis_gcc.h ****   __ASM volatile ("revsh %0, %1" : __CMSIS_GCC_OUT_REG (result) : __CMSIS_GCC_USE_REG (value) );
1009:./inc/cmsis_gcc.h ****   return result;
1010:./inc/cmsis_gcc.h **** #endif
1011:./inc/cmsis_gcc.h **** }

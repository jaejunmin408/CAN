 939:./inc/cmsis_gcc.h **** /**
 940:./inc/cmsis_gcc.h ****   \brief   Data Synchronization Barrier
 941:./inc/cmsis_gcc.h ****   \details Acts as a special kind of Data Memory Barrier.
 942:./inc/cmsis_gcc.h ****            It completes when all explicit memory accesses before this instruction complete.
 943:./inc/cmsis_gcc.h ****  */
 944:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __DSB(void)
 945:./inc/cmsis_gcc.h **** {

 821:./src/stm32f7xx_hal_rcc.c ****   }
 822:./src/stm32f7xx_hal_rcc.c **** 
 823:./src/stm32f7xx_hal_rcc.c ****   /* Decreasing the number of wait states because of lower CPU frequency */

 947:./inc/cmsis_gcc.h **** }
 948:./inc/cmsis_gcc.h **** 
 949:./inc/cmsis_gcc.h **** 
 950:./inc/cmsis_gcc.h **** /**
 951:./inc/cmsis_gcc.h ****   \brief   Data Memory Barrier
 952:./inc/cmsis_gcc.h ****   \details Ensures the apparent order of the explicit memory operations before
 953:./inc/cmsis_gcc.h ****            and after the instruction, without ensuring their completion.
 954:./inc/cmsis_gcc.h ****  */
 955:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE void __DMB(void)
 956:./inc/cmsis_gcc.h **** {
 957:./inc/cmsis_gcc.h ****   __ASM volatile ("dmb 0xF":::"memory");
 958:./inc/cmsis_gcc.h **** }

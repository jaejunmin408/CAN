 698:./src/stm32f7xx_hal_rcc.c **** /**
 699:./src/stm32f7xx_hal_rcc.c ****   * @brief  Initializes the CPU, AHB and APB busses clocks according to the specified
 700:./src/stm32f7xx_hal_rcc.c ****   *         parameters in the RCC_ClkInitStruct.
 701:./src/stm32f7xx_hal_rcc.c ****   * @param  RCC_ClkInitStruct pointer to an RCC_OscInitTypeDef structure that
 702:./src/stm32f7xx_hal_rcc.c ****   *         contains the configuration information for the RCC peripheral.
 703:./src/stm32f7xx_hal_rcc.c ****   * @param  FLatency FLASH Latency, this parameter depend on device selected
 704:./src/stm32f7xx_hal_rcc.c ****   *
 705:./src/stm32f7xx_hal_rcc.c ****   * @note   The SystemCoreClock CMSIS variable is used to store System Clock Frequency
 706:./src/stm32f7xx_hal_rcc.c ****   *         and updated by HAL_RCC_GetHCLKFreq() function called within this function
 707:./src/stm32f7xx_hal_rcc.c ****   *
 708:./src/stm32f7xx_hal_rcc.c ****   * @note   The HSI is used (enabled by hardware) as system clock source after
 709:./src/stm32f7xx_hal_rcc.c ****   *         startup from Reset, wake-up from STOP and STANDBY mode, or in case
 710:./src/stm32f7xx_hal_rcc.c ****   *         of failure of the HSE used directly or indirectly as system clock
 711:./src/stm32f7xx_hal_rcc.c ****   *         (if the Clock Security System CSS is enabled).
 712:./src/stm32f7xx_hal_rcc.c ****   *
 713:./src/stm32f7xx_hal_rcc.c ****   * @note   A switch from one clock source to another occurs only if the target
 714:./src/stm32f7xx_hal_rcc.c ****   *         clock source is ready (clock stable after startup delay or PLL locked).
 715:./src/stm32f7xx_hal_rcc.c ****   *         If a clock source which is not yet ready is selected, the switch will
 716:./src/stm32f7xx_hal_rcc.c ****   *         occur when the clock source will be ready.
 717:./src/stm32f7xx_hal_rcc.c ****   *         You can use HAL_RCC_GetClockConfig() function to know which clock is
 718:./src/stm32f7xx_hal_rcc.c ****   *         currently used as system clock source.
 719:./src/stm32f7xx_hal_rcc.c ****   * @note   Depending on the device voltage range, the software has to set correctly
 720:./src/stm32f7xx_hal_rcc.c ****   *         HPRE[3:0] bits to ensure that HCLK not exceed the maximum allowed frequency
 721:./src/stm32f7xx_hal_rcc.c ****   *         (for more details refer to section above "Initialization/de-initialization functions")
 722:./src/stm32f7xx_hal_rcc.c ****   * @retval None
 723:./src/stm32f7xx_hal_rcc.c ****   */
 724:./src/stm32f7xx_hal_rcc.c **** HAL_StatusTypeDef HAL_RCC_ClockConfig(RCC_ClkInitTypeDef  *RCC_ClkInitStruct, uint32_t FLatency)
 725:./src/stm32f7xx_hal_rcc.c **** {
 726:./src/stm32f7xx_hal_rcc.c ****   uint32_t tickstart = 0;
 727:./src/stm32f7xx_hal_rcc.c **** 

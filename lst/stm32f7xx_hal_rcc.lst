 729:./src/stm32f7xx_hal_rcc.c ****   if (RCC_ClkInitStruct == NULL)
 730:./src/stm32f7xx_hal_rcc.c ****   {
 731:./src/stm32f7xx_hal_rcc.c ****     return HAL_ERROR;
 732:./src/stm32f7xx_hal_rcc.c ****   }
 733:./src/stm32f7xx_hal_rcc.c **** 
 734:./src/stm32f7xx_hal_rcc.c ****   /* Check the parameters */
 735:./src/stm32f7xx_hal_rcc.c ****   assert_param(IS_RCC_CLOCKTYPE(RCC_ClkInitStruct->ClockType));
 736:./src/stm32f7xx_hal_rcc.c ****   assert_param(IS_FLASH_LATENCY(FLatency));
 737:./src/stm32f7xx_hal_rcc.c **** 
 738:./src/stm32f7xx_hal_rcc.c ****   /* To correctly read data from FLASH memory, the number of wait states (LATENCY)
 739:./src/stm32f7xx_hal_rcc.c ****      must be correctly programmed according to the frequency of the CPU clock
 740:./src/stm32f7xx_hal_rcc.c ****      (HCLK) and the supply voltage of the device. */
 741:./src/stm32f7xx_hal_rcc.c **** 
 742:./src/stm32f7xx_hal_rcc.c ****   /* Increasing the CPU frequency */
 743:./src/stm32f7xx_hal_rcc.c ****   if (FLatency > __HAL_FLASH_GET_LATENCY())
 744:./src/stm32f7xx_hal_rcc.c ****   {
 745:./src/stm32f7xx_hal_rcc.c ****     /* Program the new number of wait states to the LATENCY bits in the FLASH_ACR register */
 746:./src/stm32f7xx_hal_rcc.c ****     __HAL_FLASH_SET_LATENCY(FLatency);
 747:./src/stm32f7xx_hal_rcc.c **** 
 748:./src/stm32f7xx_hal_rcc.c ****     /* Check that the new number of wait states is taken into account to access the Flash
 749:./src/stm32f7xx_hal_rcc.c ****     memory by reading the FLASH_ACR register */
 750:./src/stm32f7xx_hal_rcc.c ****     if (__HAL_FLASH_GET_LATENCY() != FLatency)
 751:./src/stm32f7xx_hal_rcc.c ****     {
 752:./src/stm32f7xx_hal_rcc.c ****       return HAL_ERROR;
 753:./src/stm32f7xx_hal_rcc.c ****     }
 754:./src/stm32f7xx_hal_rcc.c ****   }
 755:./src/stm32f7xx_hal_rcc.c **** 
 756:./src/stm32f7xx_hal_rcc.c ****   /*-------------------------- HCLK Configuration --------------------------*/
 757:./src/stm32f7xx_hal_rcc.c ****   if (((RCC_ClkInitStruct->ClockType) & RCC_CLOCKTYPE_HCLK) == RCC_CLOCKTYPE_HCLK)
 758:./src/stm32f7xx_hal_rcc.c ****   {
 759:./src/stm32f7xx_hal_rcc.c ****     /* Set the highest APBx dividers in order to ensure that we do not go through
 760:./src/stm32f7xx_hal_rcc.c ****        a non-spec phase whatever we decrease or increase HCLK. */
 761:./src/stm32f7xx_hal_rcc.c ****     if (((RCC_ClkInitStruct->ClockType) & RCC_CLOCKTYPE_PCLK1) == RCC_CLOCKTYPE_PCLK1)
 762:./src/stm32f7xx_hal_rcc.c ****     {
 763:./src/stm32f7xx_hal_rcc.c ****       MODIFY_REG(RCC->CFGR, RCC_CFGR_PPRE1, RCC_HCLK_DIV16);
 764:./src/stm32f7xx_hal_rcc.c ****     }
 765:./src/stm32f7xx_hal_rcc.c **** 
 766:./src/stm32f7xx_hal_rcc.c ****     if (((RCC_ClkInitStruct->ClockType) & RCC_CLOCKTYPE_PCLK2) == RCC_CLOCKTYPE_PCLK2)
 767:./src/stm32f7xx_hal_rcc.c ****     {
 768:./src/stm32f7xx_hal_rcc.c ****       MODIFY_REG(RCC->CFGR, RCC_CFGR_PPRE2, (RCC_HCLK_DIV16 << 3));
 769:./src/stm32f7xx_hal_rcc.c ****     }
 770:./src/stm32f7xx_hal_rcc.c **** 
 771:./src/stm32f7xx_hal_rcc.c ****     /* Set the new HCLK clock divider */
 772:./src/stm32f7xx_hal_rcc.c ****     assert_param(IS_RCC_HCLK(RCC_ClkInitStruct->AHBCLKDivider));
 773:./src/stm32f7xx_hal_rcc.c ****     MODIFY_REG(RCC->CFGR, RCC_CFGR_HPRE, RCC_ClkInitStruct->AHBCLKDivider);
 774:./src/stm32f7xx_hal_rcc.c ****   }
 775:./src/stm32f7xx_hal_rcc.c **** 
 776:./src/stm32f7xx_hal_rcc.c ****   /*------------------------- SYSCLK Configuration ---------------------------*/
 777:./src/stm32f7xx_hal_rcc.c ****   if (((RCC_ClkInitStruct->ClockType) & RCC_CLOCKTYPE_SYSCLK) == RCC_CLOCKTYPE_SYSCLK)
 778:./src/stm32f7xx_hal_rcc.c ****   {

1021:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __ROR(uint32_t op1, uint32_t op2)
1022:./inc/cmsis_gcc.h **** {
1023:./inc/cmsis_gcc.h ****   op2 %= 32U;
1024:./inc/cmsis_gcc.h ****   if (op2 == 0U)
1025:./inc/cmsis_gcc.h ****   {
1026:./inc/cmsis_gcc.h ****     return op1;
1027:./inc/cmsis_gcc.h ****   }
1028:./inc/cmsis_gcc.h ****   return (op1 >> op2) | (op1 << (32U - op2));
1029:./inc/cmsis_gcc.h **** }

 886:./inc/cmsis_gcc.h **** /* Define macros for porting to both thumb1 and thumb2.
 887:./inc/cmsis_gcc.h ****  * For thumb1, use low register (r0-r7), specified by constraint "l"
 888:./inc/cmsis_gcc.h ****  * Otherwise, use general registers, specified by constraint "r" */
 889:./inc/cmsis_gcc.h **** #if defined (__thumb__) && !defined (__thumb2__)
 890:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=l" (r)
 891:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+l" (r)
 892:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "l" (r)
 893:./inc/cmsis_gcc.h **** #else
 894:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_OUT_REG(r) "=r" (r)
 895:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_RW_REG(r) "+r" (r)
 896:./inc/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "r" (r)
 897:./inc/cmsis_gcc.h **** #endif

 973:./inc/cmsis_gcc.h **** 
 974:./inc/cmsis_gcc.h ****   __ASM volatile ("rev %0, %1" : __CMSIS_GCC_OUT_REG (result) : __CMSIS_GCC_USE_REG (value) );
 975:./inc/cmsis_gcc.h ****   return result;
 976:./inc/cmsis_gcc.h **** #endif
 977:./inc/cmsis_gcc.h **** }
 978:./inc/cmsis_gcc.h **** 

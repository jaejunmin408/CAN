 961:./inc/cmsis_gcc.h **** /**
 962:./inc/cmsis_gcc.h ****   \brief   Reverse byte order (32 bit)
 963:./inc/cmsis_gcc.h ****   \details Reverses the byte order in unsigned integer value. For example, 0x12345678 becomes 0x785
 964:./inc/cmsis_gcc.h ****   \param [in]    value  Value to reverse
 965:./inc/cmsis_gcc.h ****   \return               Reversed value
 966:./inc/cmsis_gcc.h ****  */
 967:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __REV(uint32_t value)
 968:./inc/cmsis_gcc.h **** {
 969:./inc/cmsis_gcc.h **** #if (__GNUC__ > 4) || (__GNUC__ == 4 && __GNUC_MINOR__ >= 5)
 970:./inc/cmsis_gcc.h ****   return __builtin_bswap32(value);
 971:./inc/cmsis_gcc.h **** #else

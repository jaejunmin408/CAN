 785:./src/stm32f7xx_hal_rcc.c ****       if (__HAL_RCC_GET_FLAG(RCC_FLAG_HSERDY) == RESET)
 786:./src/stm32f7xx_hal_rcc.c ****       {
 787:./src/stm32f7xx_hal_rcc.c ****         return HAL_ERROR;
 788:./src/stm32f7xx_hal_rcc.c ****       }
 789:./src/stm32f7xx_hal_rcc.c ****     }
 790:./src/stm32f7xx_hal_rcc.c ****     /* PLL is selected as System Clock Source */
 791:./src/stm32f7xx_hal_rcc.c ****     else if (RCC_ClkInitStruct->SYSCLKSource == RCC_SYSCLKSOURCE_PLLCLK)
 792:./src/stm32f7xx_hal_rcc.c ****     {
 793:./src/stm32f7xx_hal_rcc.c ****       /* Check the PLL ready flag */
 794:./src/stm32f7xx_hal_rcc.c ****       if (__HAL_RCC_GET_FLAG(RCC_FLAG_PLLRDY) == RESET)
 795:./src/stm32f7xx_hal_rcc.c ****       {
 796:./src/stm32f7xx_hal_rcc.c ****         return HAL_ERROR;
 797:./src/stm32f7xx_hal_rcc.c ****       }
 798:./src/stm32f7xx_hal_rcc.c ****     }
 799:./src/stm32f7xx_hal_rcc.c ****     /* HSI is selected as System Clock Source */
 800:./src/stm32f7xx_hal_rcc.c ****     else
 801:./src/stm32f7xx_hal_rcc.c ****     {
 802:./src/stm32f7xx_hal_rcc.c ****       /* Check the HSI ready flag */
 803:./src/stm32f7xx_hal_rcc.c ****       if (__HAL_RCC_GET_FLAG(RCC_FLAG_HSIRDY) == RESET)
 804:./src/stm32f7xx_hal_rcc.c ****       {
 805:./src/stm32f7xx_hal_rcc.c ****         return HAL_ERROR;
 806:./src/stm32f7xx_hal_rcc.c ****       }
 807:./src/stm32f7xx_hal_rcc.c ****     }

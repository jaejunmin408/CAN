 368:./inc/core_cm7.h **** #define xPSR_ICI_IT_2_Msk                  (3UL << xPSR_ICI_IT_2_Pos)                     /*!< xPSR
 369:./inc/core_cm7.h **** 
 370:./inc/core_cm7.h **** #define xPSR_T_Pos                         24U                                            /*!< xPSR
 371:./inc/core_cm7.h **** #define xPSR_T_Msk                         (1UL << xPSR_T_Pos)                            /*!< xPSR
 372:./inc/core_cm7.h **** 
 373:./inc/core_cm7.h **** #define xPSR_GE_Pos                        16U                                            /*!< xPSR
 374:./inc/core_cm7.h **** #define xPSR_GE_Msk                        (0xFUL << xPSR_GE_Pos)                         /*!< xPSR

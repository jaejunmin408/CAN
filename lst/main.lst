2230:./inc/core_cm7.h **** /* Cache Size ID Register Macros */
2231:./inc/core_cm7.h **** #define CCSIDR_WAYS(x)         (((x) & SCB_CCSIDR_ASSOCIATIVITY_Msk) >> SCB_CCSIDR_ASSOCIATIVITY_Po
2232:./inc/core_cm7.h **** #define CCSIDR_SETS(x)         (((x) & SCB_CCSIDR_NUMSETS_Msk      ) >> SCB_CCSIDR_NUMSETS_Pos     
2233:./inc/core_cm7.h **** 
2234:./inc/core_cm7.h **** #define __SCB_DCACHE_LINE_SIZE  32U /*!< Cortex-M7 cache line size is fixed to 32 bytes (8 words). 
2235:./inc/core_cm7.h **** #define __SCB_ICACHE_LINE_SIZE  32U /*!< Cortex-M7 cache line size is fixed to 32 bytes (8 words). 
2236:./inc/core_cm7.h **** 
2237:./inc/core_cm7.h **** /**
2238:./inc/core_cm7.h ****   \brief   Enable I-Cache
2239:./inc/core_cm7.h ****   \details Turns on I-Cache
2240:./inc/core_cm7.h ****   */
2241:./inc/core_cm7.h **** __STATIC_FORCEINLINE void SCB_EnableICache (void)
2242:./inc/core_cm7.h **** {
2243:./inc/core_cm7.h ****   #if defined (__ICACHE_PRESENT) && (__ICACHE_PRESENT == 1U)
2244:./inc/core_cm7.h ****     if (SCB->CCR & SCB_CCR_IC_Msk) return;  /* return if ICache is already enabled */
2245:./inc/core_cm7.h **** 
2246:./inc/core_cm7.h ****     __DSB();
2247:./inc/core_cm7.h ****     __ISB();
2248:./inc/core_cm7.h ****     SCB->ICIALLU = 0UL;                     /* invalidate I-Cache */
2249:./inc/core_cm7.h ****     __DSB();
2250:./inc/core_cm7.h ****     __ISB();
2251:./inc/core_cm7.h ****     SCB->CCR |=  (uint32_t)SCB_CCR_IC_Msk;  /* enable I-Cache */
2252:./inc/core_cm7.h ****     __DSB();
2253:./inc/core_cm7.h ****     __ISB();
2254:./inc/core_cm7.h ****   #endif
2255:./inc/core_cm7.h **** }
2256:./inc/core_cm7.h **** 
2257:./inc/core_cm7.h **** 
2258:./inc/core_cm7.h **** /**
2259:./inc/core_cm7.h ****   \brief   Disable I-Cache
2260:./inc/core_cm7.h ****   \details Turns off I-Cache
2261:./inc/core_cm7.h ****   */
2262:./inc/core_cm7.h **** __STATIC_FORCEINLINE void SCB_DisableICache (void)
2263:./inc/core_cm7.h **** {

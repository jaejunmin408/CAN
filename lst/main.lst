2287:./inc/core_cm7.h ****   #endif
2288:./inc/core_cm7.h **** }
2289:./inc/core_cm7.h **** 
2290:./inc/core_cm7.h **** 
2291:./inc/core_cm7.h **** /**
2292:./inc/core_cm7.h ****   \brief   I-Cache Invalidate by address
2293:./inc/core_cm7.h ****   \details Invalidates I-Cache for the given address.
2294:./inc/core_cm7.h ****            I-Cache is invalidated starting from a 32 byte aligned address in 32 byte granularity.
2295:./inc/core_cm7.h ****            I-Cache memory blocks which are part of given address + given size are invalidated.
2296:./inc/core_cm7.h ****   \param[in]   addr    address
2297:./inc/core_cm7.h ****   \param[in]   isize   size of memory block (in number of bytes)
2298:./inc/core_cm7.h **** */
2299:./inc/core_cm7.h **** __STATIC_FORCEINLINE void SCB_InvalidateICache_by_Addr (void *addr, int32_t isize)
2300:./inc/core_cm7.h **** {
2301:./inc/core_cm7.h ****   #if defined (__ICACHE_PRESENT) && (__ICACHE_PRESENT == 1U)
2302:./inc/core_cm7.h ****     if ( isize > 0 ) {
2303:./inc/core_cm7.h ****        int32_t op_size = isize + (((uint32_t)addr) & (__SCB_ICACHE_LINE_SIZE - 1U));
2304:./inc/core_cm7.h ****       uint32_t op_addr = (uint32_t)addr /* & ~(__SCB_ICACHE_LINE_SIZE - 1U) */;
2305:./inc/core_cm7.h **** 
2306:./inc/core_cm7.h ****       __DSB();
2307:./inc/core_cm7.h **** 
2308:./inc/core_cm7.h ****       do {
2309:./inc/core_cm7.h ****         SCB->ICIMVAU = op_addr;             /* register accepts only 32byte aligned values, only bi
2310:./inc/core_cm7.h ****         op_addr += __SCB_ICACHE_LINE_SIZE;
2311:./inc/core_cm7.h ****         op_size -= __SCB_ICACHE_LINE_SIZE;
2312:./inc/core_cm7.h ****       } while ( op_size > 0 );
2313:./inc/core_cm7.h **** 
2314:./inc/core_cm7.h ****       __DSB();
2315:./inc/core_cm7.h ****       __ISB();
2316:./inc/core_cm7.h ****     }
2317:./inc/core_cm7.h ****   #endif
2318:./inc/core_cm7.h **** }
2319:./inc/core_cm7.h **** 
2320:./inc/core_cm7.h **** 
2321:./inc/core_cm7.h **** /**
2322:./inc/core_cm7.h ****   \brief   Enable D-Cache
2323:./inc/core_cm7.h ****   \details Turns on D-Cache
2324:./inc/core_cm7.h ****   */
2325:./inc/core_cm7.h **** __STATIC_FORCEINLINE void SCB_EnableDCache (void)
2326:./inc/core_cm7.h **** {
2327:./inc/core_cm7.h ****   #if defined (__DCACHE_PRESENT) && (__DCACHE_PRESENT == 1U)
2328:./inc/core_cm7.h ****     uint32_t ccsidr;
2329:./inc/core_cm7.h ****     uint32_t sets;
2330:./inc/core_cm7.h ****     uint32_t ways;
2331:./inc/core_cm7.h **** 
2332:./inc/core_cm7.h ****     if (SCB->CCR & SCB_CCR_DC_Msk) return;  /* return if DCache is already enabled */
2333:./inc/core_cm7.h **** 
2334:./inc/core_cm7.h ****     SCB->CSSELR = 0U;                       /* select Level 1 data cache */
2335:./inc/core_cm7.h ****     __DSB();
2336:./inc/core_cm7.h **** 
2337:./inc/core_cm7.h ****     ccsidr = SCB->CCSIDR;
2338:./inc/core_cm7.h **** 
2339:./inc/core_cm7.h ****                                             /* invalidate D-Cache */
2340:./inc/core_cm7.h ****     sets = (uint32_t)(CCSIDR_SETS(ccsidr));
2341:./inc/core_cm7.h ****     do {
2342:./inc/core_cm7.h ****       ways = (uint32_t)(CCSIDR_WAYS(ccsidr));
2343:./inc/core_cm7.h ****       do {
2344:./inc/core_cm7.h ****         SCB->DCISW = (((sets << SCB_DCISW_SET_Pos) & SCB_DCISW_SET_Msk) |
2345:./inc/core_cm7.h ****                       ((ways << SCB_DCISW_WAY_Pos) & SCB_DCISW_WAY_Msk)  );
2346:./inc/core_cm7.h ****         #if defined ( __CC_ARM )
2347:./inc/core_cm7.h ****           __schedule_barrier();
2348:./inc/core_cm7.h ****         #endif
2349:./inc/core_cm7.h ****       } while (ways-- != 0U);
2350:./inc/core_cm7.h ****     } while(sets-- != 0U);
2351:./inc/core_cm7.h ****     __DSB();
2352:./inc/core_cm7.h **** 
2353:./inc/core_cm7.h ****     SCB->CCR |=  (uint32_t)SCB_CCR_DC_Msk;  /* enable D-Cache */
2354:./inc/core_cm7.h **** 
2355:./inc/core_cm7.h ****     __DSB();
2356:./inc/core_cm7.h ****     __ISB();
2357:./inc/core_cm7.h ****   #endif
2358:./inc/core_cm7.h **** }
2359:./inc/core_cm7.h **** 
2360:./inc/core_cm7.h **** 

2265:./inc/core_cm7.h ****     __DSB();
2266:./inc/core_cm7.h ****     __ISB();
2267:./inc/core_cm7.h ****     SCB->CCR &= ~(uint32_t)SCB_CCR_IC_Msk;  /* disable I-Cache */
2268:./inc/core_cm7.h ****     SCB->ICIALLU = 0UL;                     /* invalidate I-Cache */
2269:./inc/core_cm7.h ****     __DSB();
2270:./inc/core_cm7.h ****     __ISB();
2271:./inc/core_cm7.h ****   #endif
2272:./inc/core_cm7.h **** }
2273:./inc/core_cm7.h **** 
2274:./inc/core_cm7.h **** 
2275:./inc/core_cm7.h **** /**
2276:./inc/core_cm7.h ****   \brief   Invalidate I-Cache
2277:./inc/core_cm7.h ****   \details Invalidates I-Cache
2278:./inc/core_cm7.h ****   */
2279:./inc/core_cm7.h **** __STATIC_FORCEINLINE void SCB_InvalidateICache (void)
2280:./inc/core_cm7.h **** {

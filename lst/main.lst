 357:./inc/core_cm7.h **** 
 358:./inc/core_cm7.h **** #define xPSR_C_Pos                         29U                                            /*!< xPSR
 359:./inc/core_cm7.h **** #define xPSR_C_Msk                         (1UL << xPSR_C_Pos)                            /*!< xPSR
 360:./inc/core_cm7.h **** 
 361:./inc/core_cm7.h **** #define xPSR_V_Pos                         28U                                            /*!< xPSR

  79:./inc/core_cm7.h ****       #define __FPU_USED       1U
  80:./inc/core_cm7.h ****     #else
  81:./inc/core_cm7.h ****       #error "Compiler generates FPU instructions for a device without an FPU (check __FPU_PRESENT)
  82:./inc/core_cm7.h ****       #define __FPU_USED       0U
  83:./inc/core_cm7.h ****     #endif
  84:./inc/core_cm7.h ****   #else

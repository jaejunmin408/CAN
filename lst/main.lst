2183:./inc/core_cm7.h **** /* ##########################  FPU functions  #################################### */
2184:./inc/core_cm7.h **** /**
2185:./inc/core_cm7.h ****   \ingroup  CMSIS_Core_FunctionInterface
2186:./inc/core_cm7.h ****   \defgroup CMSIS_Core_FpuFunctions FPU Functions
2187:./inc/core_cm7.h ****   \brief    Function that provides FPU type.
2188:./inc/core_cm7.h ****   @{
2189:./inc/core_cm7.h ****  */
2190:./inc/core_cm7.h **** 
2191:./inc/core_cm7.h **** /**
2192:./inc/core_cm7.h ****   \brief   get FPU type
2193:./inc/core_cm7.h ****   \details returns the FPU type
2194:./inc/core_cm7.h ****   \returns
2195:./inc/core_cm7.h ****    - \b  0: No FPU
2196:./inc/core_cm7.h ****    - \b  1: Single precision FPU
2197:./inc/core_cm7.h ****    - \b  2: Double + Single precision FPU
2198:./inc/core_cm7.h ****  */
2199:./inc/core_cm7.h **** __STATIC_INLINE uint32_t SCB_GetFPUType(void)
2200:./inc/core_cm7.h **** {
2201:./inc/core_cm7.h ****   uint32_t mvfr0;
2202:./inc/core_cm7.h **** 
2203:./inc/core_cm7.h ****   mvfr0 = SCB->MVFR0;
2204:./inc/core_cm7.h ****   if      ((mvfr0 & (FPU_MVFR0_Single_precision_Msk | FPU_MVFR0_Double_precision_Msk)) == 0x220U)
2205:./inc/core_cm7.h ****   {
2206:./inc/core_cm7.h ****     return 2U;           /* Double + Single precision FPU */
2207:./inc/core_cm7.h ****   }
2208:./inc/core_cm7.h ****   else if ((mvfr0 & (FPU_MVFR0_Single_precision_Msk | FPU_MVFR0_Double_precision_Msk)) == 0x020U)
2209:./inc/core_cm7.h ****   {
2210:./inc/core_cm7.h ****     return 1U;           /* Single precision FPU */
2211:./inc/core_cm7.h ****   }
2212:./inc/core_cm7.h ****   else
2213:./inc/core_cm7.h ****   {
2214:./inc/core_cm7.h ****     return 0U;           /* No FPU */
2215:./inc/core_cm7.h ****   }
2216:./inc/core_cm7.h **** }
2217:./inc/core_cm7.h **** 
2218:./inc/core_cm7.h **** /*@} end of CMSIS_Core_FpuFunctions */

  24:./src/task04.c **** void printCanMsg(const CANRxMsgDMA_t* msg)
  25:./src/task04.c **** {
  26:./src/task04.c ****     // CAN BUS 번호
  27:./src/task04.c ****     printf("%7d | ", msg->hBus);
  28:./src/task04.c **** 
  29:./src/task04.c ****     // CAN FD ID
  30:./src/task04.c ****     printf("0x%08X | ", msg->id);
  31:./src/task04.c **** 
  32:./src/task04.c ****     // DLC
  33:./src/task04.c ****     printf("%3d | ", msg->dlc);
  34:./src/task04.c **** 
  35:./src/task04.c ****     // DATA
  36:./src/task04.c ****     for (int i = 0; i < msg->dlc; i++) {
  37:./src/task04.c ****         printf("%02X ", msg->data8[i]);
  38:./src/task04.c ****     }
  39:./src/task04.c **** 
  40:./src/task04.c ****     printf("\n");
  41:./src/task04.c **** }

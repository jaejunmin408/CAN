 655:./lwip-2.1.2/src/core/udp.c ****       if (src_ip == NULL) {
 656:./lwip-2.1.2/src/core/udp.c ****         /* No suitable source address was found. */
 657:./lwip-2.1.2/src/core/udp.c ****         return ERR_RTE;
 658:./lwip-2.1.2/src/core/udp.c ****       }
 659:./lwip-2.1.2/src/core/udp.c ****     } else {
 660:./lwip-2.1.2/src/core/udp.c ****       /* use UDP PCB local IPv6 address as source address, if still valid. */
 661:./lwip-2.1.2/src/core/udp.c ****       if (netif_get_ip6_addr_match(netif, ip_2_ip6(&pcb->local_ip)) < 0) {
 662:./lwip-2.1.2/src/core/udp.c ****         /* Address isn't valid anymore. */

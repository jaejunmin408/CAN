  94:./lwip-2.1.2/src/core/udp.c **** /**
  95:./lwip-2.1.2/src/core/udp.c ****  * Allocate a new local UDP port.
  96:./lwip-2.1.2/src/core/udp.c ****  *
  97:./lwip-2.1.2/src/core/udp.c ****  * @return a new (free) local UDP port number
  98:./lwip-2.1.2/src/core/udp.c ****  */
  99:./lwip-2.1.2/src/core/udp.c **** static u16_t
 100:./lwip-2.1.2/src/core/udp.c **** udp_new_port(void)
 101:./lwip-2.1.2/src/core/udp.c **** {
 102:./lwip-2.1.2/src/core/udp.c ****   u16_t n = 0;
 103:./lwip-2.1.2/src/core/udp.c ****   struct udp_pcb *pcb;
 104:./lwip-2.1.2/src/core/udp.c **** 
 105:./lwip-2.1.2/src/core/udp.c **** again:
 106:./lwip-2.1.2/src/core/udp.c ****   if (udp_port++ == UDP_LOCAL_PORT_RANGE_END) {
 107:./lwip-2.1.2/src/core/udp.c ****     udp_port = UDP_LOCAL_PORT_RANGE_START;
 108:./lwip-2.1.2/src/core/udp.c ****   }
 109:./lwip-2.1.2/src/core/udp.c ****   /* Check all PCBs. */
 110:./lwip-2.1.2/src/core/udp.c ****   for (pcb = udp_pcbs; pcb != NULL; pcb = pcb->next) {
 111:./lwip-2.1.2/src/core/udp.c ****     if (pcb->local_port == udp_port) {
 112:./lwip-2.1.2/src/core/udp.c ****       if (++n > (UDP_LOCAL_PORT_RANGE_END - UDP_LOCAL_PORT_RANGE_START)) {
 113:./lwip-2.1.2/src/core/udp.c ****         return 0;
 114:./lwip-2.1.2/src/core/udp.c ****       }
 115:./lwip-2.1.2/src/core/udp.c ****       goto again;
 116:./lwip-2.1.2/src/core/udp.c ****     }
 117:./lwip-2.1.2/src/core/udp.c ****   }
 118:./lwip-2.1.2/src/core/udp.c ****   return udp_port;
 119:./lwip-2.1.2/src/core/udp.c **** }
 120:./lwip-2.1.2/src/core/udp.c **** 
 121:./lwip-2.1.2/src/core/udp.c **** /** Common code to see if the current input packet matches the pcb
 122:./lwip-2.1.2/src/core/udp.c ****  * (current input packet is accessed via ip(4/6)_current_* macros)
 123:./lwip-2.1.2/src/core/udp.c ****  *
 124:./lwip-2.1.2/src/core/udp.c ****  * @param pcb pcb to check
 125:./lwip-2.1.2/src/core/udp.c ****  * @param inp network interface on which the datagram was received (only used for IPv4)
 126:./lwip-2.1.2/src/core/udp.c ****  * @param broadcast 1 if his is an IPv4 broadcast (global or subnet-only), 0 otherwise (only used f
 127:./lwip-2.1.2/src/core/udp.c ****  * @return 1 on match, 0 otherwise
 128:./lwip-2.1.2/src/core/udp.c ****  */
 129:./lwip-2.1.2/src/core/udp.c **** static u8_t
 130:./lwip-2.1.2/src/core/udp.c **** udp_input_local_match(struct udp_pcb *pcb, struct netif *inp, u8_t broadcast)
 131:./lwip-2.1.2/src/core/udp.c **** {
 132:./lwip-2.1.2/src/core/udp.c ****   LWIP_UNUSED_ARG(inp);       /* in IPv6 only case */
 133:./lwip-2.1.2/src/core/udp.c ****   LWIP_UNUSED_ARG(broadcast); /* in IPv6 only case */
 134:./lwip-2.1.2/src/core/udp.c **** 
 135:./lwip-2.1.2/src/core/udp.c ****   LWIP_ASSERT("udp_input_local_match: invalid pcb", pcb != NULL);
 136:./lwip-2.1.2/src/core/udp.c ****   LWIP_ASSERT("udp_input_local_match: invalid netif", inp != NULL);
 137:./lwip-2.1.2/src/core/udp.c **** 
 138:./lwip-2.1.2/src/core/udp.c ****   /* check if PCB is bound to specific netif */
 139:./lwip-2.1.2/src/core/udp.c ****   if ((pcb->netif_idx != NETIF_NO_INDEX) &&
 140:./lwip-2.1.2/src/core/udp.c ****       (pcb->netif_idx != netif_get_index(ip_data.current_input_netif))) {
 141:./lwip-2.1.2/src/core/udp.c ****     return 0;
 142:./lwip-2.1.2/src/core/udp.c ****   }
 143:./lwip-2.1.2/src/core/udp.c **** 
 144:./lwip-2.1.2/src/core/udp.c ****   /* Dual-stack: PCBs listening to any IP type also listen to any IP address */
 145:./lwip-2.1.2/src/core/udp.c ****   if (IP_IS_ANY_TYPE_VAL(pcb->local_ip)) {
 146:./lwip-2.1.2/src/core/udp.c **** #if LWIP_IPV4 && IP_SOF_BROADCAST_RECV
 147:./lwip-2.1.2/src/core/udp.c ****     if ((broadcast != 0) && !ip_get_option(pcb, SOF_BROADCAST)) {
 148:./lwip-2.1.2/src/core/udp.c ****       return 0;
 149:./lwip-2.1.2/src/core/udp.c ****     }
 150:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_IPV4 && IP_SOF_BROADCAST_RECV */
 151:./lwip-2.1.2/src/core/udp.c ****     return 1;
 152:./lwip-2.1.2/src/core/udp.c ****   }
 153:./lwip-2.1.2/src/core/udp.c **** 
 154:./lwip-2.1.2/src/core/udp.c ****   /* Only need to check PCB if incoming IP version matches PCB IP version */
 155:./lwip-2.1.2/src/core/udp.c ****   if (IP_ADDR_PCB_VERSION_MATCH_EXACT(pcb, ip_current_dest_addr())) {
 156:./lwip-2.1.2/src/core/udp.c **** #if LWIP_IPV4
 157:./lwip-2.1.2/src/core/udp.c ****     /* Special case: IPv4 broadcast: all or broadcasts in my subnet
 158:./lwip-2.1.2/src/core/udp.c ****      * Note: broadcast variable can only be 1 if it is an IPv4 broadcast */
 159:./lwip-2.1.2/src/core/udp.c ****     if (broadcast != 0) {
 160:./lwip-2.1.2/src/core/udp.c **** #if IP_SOF_BROADCAST_RECV
 161:./lwip-2.1.2/src/core/udp.c ****       if (ip_get_option(pcb, SOF_BROADCAST))
 162:./lwip-2.1.2/src/core/udp.c **** #endif /* IP_SOF_BROADCAST_RECV */
 163:./lwip-2.1.2/src/core/udp.c ****       {
 164:./lwip-2.1.2/src/core/udp.c ****         if (ip4_addr_isany(ip_2_ip4(&pcb->local_ip)) ||
 165:./lwip-2.1.2/src/core/udp.c ****             ((ip4_current_dest_addr()->addr == IPADDR_BROADCAST)) ||
 166:./lwip-2.1.2/src/core/udp.c ****             ip4_addr_netcmp(ip_2_ip4(&pcb->local_ip), ip4_current_dest_addr(), netif_ip4_netmask(in
 167:./lwip-2.1.2/src/core/udp.c ****           return 1;
 168:./lwip-2.1.2/src/core/udp.c ****         }
 169:./lwip-2.1.2/src/core/udp.c ****       }
 170:./lwip-2.1.2/src/core/udp.c ****     } else
 171:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_IPV4 */
 172:./lwip-2.1.2/src/core/udp.c ****       /* Handle IPv4 and IPv6: all or exact match */
 173:./lwip-2.1.2/src/core/udp.c ****       if (ip_addr_isany(&pcb->local_ip) || ip_addr_cmp(&pcb->local_ip, ip_current_dest_addr())) {
 174:./lwip-2.1.2/src/core/udp.c ****         return 1;
 175:./lwip-2.1.2/src/core/udp.c ****       }
 176:./lwip-2.1.2/src/core/udp.c ****   }
 177:./lwip-2.1.2/src/core/udp.c **** 
 178:./lwip-2.1.2/src/core/udp.c ****   return 0;
 179:./lwip-2.1.2/src/core/udp.c **** }
 180:./lwip-2.1.2/src/core/udp.c **** 
 181:./lwip-2.1.2/src/core/udp.c **** /**
 182:./lwip-2.1.2/src/core/udp.c ****  * Process an incoming UDP datagram.
 183:./lwip-2.1.2/src/core/udp.c ****  *
 184:./lwip-2.1.2/src/core/udp.c ****  * Given an incoming UDP datagram (as a chain of pbufs) this function
 185:./lwip-2.1.2/src/core/udp.c ****  * finds a corresponding UDP PCB and hands over the pbuf to the pcbs
 186:./lwip-2.1.2/src/core/udp.c ****  * recv function. If no pcb is found or the datagram is incorrect, the
 187:./lwip-2.1.2/src/core/udp.c ****  * pbuf is freed.
 188:./lwip-2.1.2/src/core/udp.c ****  *
 189:./lwip-2.1.2/src/core/udp.c ****  * @param p pbuf to be demultiplexed to a UDP PCB (p->payload pointing to the UDP header)
 190:./lwip-2.1.2/src/core/udp.c ****  * @param inp network interface on which the datagram was received.
 191:./lwip-2.1.2/src/core/udp.c ****  *
 192:./lwip-2.1.2/src/core/udp.c ****  */
 193:./lwip-2.1.2/src/core/udp.c **** void
 194:./lwip-2.1.2/src/core/udp.c **** udp_input(struct pbuf *p, struct netif *inp)

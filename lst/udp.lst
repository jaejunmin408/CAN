 445:./lwip-2.1.2/src/core/udp.c **** /**
 446:./lwip-2.1.2/src/core/udp.c ****  * @ingroup udp_raw
 447:./lwip-2.1.2/src/core/udp.c ****  * Sends the pbuf p using UDP. The pbuf is not deallocated.
 448:./lwip-2.1.2/src/core/udp.c ****  *
 449:./lwip-2.1.2/src/core/udp.c ****  *
 450:./lwip-2.1.2/src/core/udp.c ****  * @param pcb UDP PCB used to send the data.
 451:./lwip-2.1.2/src/core/udp.c ****  * @param p chain of pbuf's to be sent.
 452:./lwip-2.1.2/src/core/udp.c ****  *
 453:./lwip-2.1.2/src/core/udp.c ****  * The datagram will be sent to the current remote_ip & remote_port
 454:./lwip-2.1.2/src/core/udp.c ****  * stored in pcb. If the pcb is not bound to a port, it will
 455:./lwip-2.1.2/src/core/udp.c ****  * automatically be bound to a random port.
 456:./lwip-2.1.2/src/core/udp.c ****  *
 457:./lwip-2.1.2/src/core/udp.c ****  * @return lwIP error code.
 458:./lwip-2.1.2/src/core/udp.c ****  * - ERR_OK. Successful. No error occurred.
 459:./lwip-2.1.2/src/core/udp.c ****  * - ERR_MEM. Out of memory.
 460:./lwip-2.1.2/src/core/udp.c ****  * - ERR_RTE. Could not find route to destination address.
 461:./lwip-2.1.2/src/core/udp.c ****  * - ERR_VAL. No PCB or PCB is dual-stack
 462:./lwip-2.1.2/src/core/udp.c ****  * - More errors could be returned by lower protocol layers.
 463:./lwip-2.1.2/src/core/udp.c ****  *
 464:./lwip-2.1.2/src/core/udp.c ****  * @see udp_disconnect() udp_sendto()
 465:./lwip-2.1.2/src/core/udp.c ****  */
 466:./lwip-2.1.2/src/core/udp.c **** err_t
 467:./lwip-2.1.2/src/core/udp.c **** udp_send(struct udp_pcb *pcb, struct pbuf *p)
 468:./lwip-2.1.2/src/core/udp.c **** {
 469:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_send: invalid pcb", pcb != NULL, return ERR_ARG);
 470:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_send: invalid pbuf", p != NULL, return ERR_ARG);
 471:./lwip-2.1.2/src/core/udp.c **** 
 472:./lwip-2.1.2/src/core/udp.c ****   if (IP_IS_ANY_TYPE_VAL(pcb->remote_ip)) {
 473:./lwip-2.1.2/src/core/udp.c ****     return ERR_VAL;
 474:./lwip-2.1.2/src/core/udp.c ****   }
 475:./lwip-2.1.2/src/core/udp.c **** 
 476:./lwip-2.1.2/src/core/udp.c ****   /* send to the packet using remote ip and port stored in the pcb */
 477:./lwip-2.1.2/src/core/udp.c ****   return udp_sendto(pcb, p, &pcb->remote_ip, pcb->remote_port);
 478:./lwip-2.1.2/src/core/udp.c **** }
 479:./lwip-2.1.2/src/core/udp.c **** 
 480:./lwip-2.1.2/src/core/udp.c **** #if LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP
 481:./lwip-2.1.2/src/core/udp.c **** /** @ingroup udp_raw
 482:./lwip-2.1.2/src/core/udp.c ****  * Same as udp_send() but with checksum
 483:./lwip-2.1.2/src/core/udp.c ****  */
 484:./lwip-2.1.2/src/core/udp.c **** err_t
 485:./lwip-2.1.2/src/core/udp.c **** udp_send_chksum(struct udp_pcb *pcb, struct pbuf *p,
 486:./lwip-2.1.2/src/core/udp.c ****                 u8_t have_chksum, u16_t chksum)
 487:./lwip-2.1.2/src/core/udp.c **** {
 488:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_send_chksum: invalid pcb", pcb != NULL, return ERR_ARG);
 489:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_send_chksum: invalid pbuf", p != NULL, return ERR_ARG);
 490:./lwip-2.1.2/src/core/udp.c **** 
 491:./lwip-2.1.2/src/core/udp.c ****   if (IP_IS_ANY_TYPE_VAL(pcb->remote_ip)) {
 492:./lwip-2.1.2/src/core/udp.c ****     return ERR_VAL;
 493:./lwip-2.1.2/src/core/udp.c ****   }
 494:./lwip-2.1.2/src/core/udp.c **** 
 495:./lwip-2.1.2/src/core/udp.c ****   /* send to the packet using remote ip and port stored in the pcb */
 496:./lwip-2.1.2/src/core/udp.c ****   return udp_sendto_chksum(pcb, p, &pcb->remote_ip, pcb->remote_port,
 497:./lwip-2.1.2/src/core/udp.c ****                            have_chksum, chksum);
 498:./lwip-2.1.2/src/core/udp.c **** }
 499:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP */
 500:./lwip-2.1.2/src/core/udp.c **** 
 501:./lwip-2.1.2/src/core/udp.c **** /**
 502:./lwip-2.1.2/src/core/udp.c ****  * @ingroup udp_raw
 503:./lwip-2.1.2/src/core/udp.c ****  * Send data to a specified address using UDP.
 504:./lwip-2.1.2/src/core/udp.c ****  *
 505:./lwip-2.1.2/src/core/udp.c ****  * @param pcb UDP PCB used to send the data.
 506:./lwip-2.1.2/src/core/udp.c ****  * @param p chain of pbuf's to be sent.
 507:./lwip-2.1.2/src/core/udp.c ****  * @param dst_ip Destination IP address.
 508:./lwip-2.1.2/src/core/udp.c ****  * @param dst_port Destination UDP port.
 509:./lwip-2.1.2/src/core/udp.c ****  *
 510:./lwip-2.1.2/src/core/udp.c ****  * dst_ip & dst_port are expected to be in the same byte order as in the pcb.
 511:./lwip-2.1.2/src/core/udp.c ****  *
 512:./lwip-2.1.2/src/core/udp.c ****  * If the PCB already has a remote address association, it will
 513:./lwip-2.1.2/src/core/udp.c ****  * be restored after the data is sent.
 514:./lwip-2.1.2/src/core/udp.c ****  *
 515:./lwip-2.1.2/src/core/udp.c ****  * @return lwIP error code (@see udp_send for possible error codes)
 516:./lwip-2.1.2/src/core/udp.c ****  *
 517:./lwip-2.1.2/src/core/udp.c ****  * @see udp_disconnect() udp_send()
 518:./lwip-2.1.2/src/core/udp.c ****  */
 519:./lwip-2.1.2/src/core/udp.c **** err_t
 520:./lwip-2.1.2/src/core/udp.c **** udp_sendto(struct udp_pcb *pcb, struct pbuf *p,
 521:./lwip-2.1.2/src/core/udp.c ****            const ip_addr_t *dst_ip, u16_t dst_port)
 522:./lwip-2.1.2/src/core/udp.c **** {
 523:./lwip-2.1.2/src/core/udp.c **** #if LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP
 524:./lwip-2.1.2/src/core/udp.c ****   return udp_sendto_chksum(pcb, p, dst_ip, dst_port, 0, 0);
 525:./lwip-2.1.2/src/core/udp.c **** }
 526:./lwip-2.1.2/src/core/udp.c **** 
 527:./lwip-2.1.2/src/core/udp.c **** /** @ingroup udp_raw
 528:./lwip-2.1.2/src/core/udp.c ****  * Same as udp_sendto(), but with checksum */
 529:./lwip-2.1.2/src/core/udp.c **** err_t
 530:./lwip-2.1.2/src/core/udp.c **** udp_sendto_chksum(struct udp_pcb *pcb, struct pbuf *p, const ip_addr_t *dst_ip,
 531:./lwip-2.1.2/src/core/udp.c ****                   u16_t dst_port, u8_t have_chksum, u16_t chksum)
 532:./lwip-2.1.2/src/core/udp.c **** {
 533:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP */
 534:./lwip-2.1.2/src/core/udp.c ****   struct netif *netif;
 535:./lwip-2.1.2/src/core/udp.c **** 
 536:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_sendto: invalid pcb", pcb != NULL, return ERR_ARG);
 537:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_sendto: invalid pbuf", p != NULL, return ERR_ARG);
 538:./lwip-2.1.2/src/core/udp.c ****   LWIP_ERROR("udp_sendto: invalid dst_ip", dst_ip != NULL, return ERR_ARG);
 539:./lwip-2.1.2/src/core/udp.c **** 
 540:./lwip-2.1.2/src/core/udp.c ****   if (!IP_ADDR_PCB_VERSION_MATCH(pcb, dst_ip)) {
 541:./lwip-2.1.2/src/core/udp.c ****     return ERR_VAL;
 542:./lwip-2.1.2/src/core/udp.c ****   }
 543:./lwip-2.1.2/src/core/udp.c **** 
 544:./lwip-2.1.2/src/core/udp.c ****   LWIP_DEBUGF(UDP_DEBUG | LWIP_DBG_TRACE, ("udp_send\n"));
 545:./lwip-2.1.2/src/core/udp.c **** 
 546:./lwip-2.1.2/src/core/udp.c ****   if (pcb->netif_idx != NETIF_NO_INDEX) {
 547:./lwip-2.1.2/src/core/udp.c ****     netif = netif_get_by_index(pcb->netif_idx);
 548:./lwip-2.1.2/src/core/udp.c ****   } else {
 549:./lwip-2.1.2/src/core/udp.c **** #if LWIP_MULTICAST_TX_OPTIONS
 550:./lwip-2.1.2/src/core/udp.c ****     netif = NULL;
 551:./lwip-2.1.2/src/core/udp.c ****     if (ip_addr_ismulticast(dst_ip)) {
 552:./lwip-2.1.2/src/core/udp.c ****       /* For IPv6, the interface to use for packets with a multicast destination
 553:./lwip-2.1.2/src/core/udp.c ****        * is specified using an interface index. The same approach may be used for
 554:./lwip-2.1.2/src/core/udp.c ****        * IPv4 as well, in which case it overrides the IPv4 multicast override
 555:./lwip-2.1.2/src/core/udp.c ****        * address below. Here we have to look up the netif by going through the
 556:./lwip-2.1.2/src/core/udp.c ****        * list, but by doing so we skip a route lookup. If the interface index has
 557:./lwip-2.1.2/src/core/udp.c ****        * gone stale, we fall through and do the regular route lookup after all. */
 558:./lwip-2.1.2/src/core/udp.c ****       if (pcb->mcast_ifindex != NETIF_NO_INDEX) {
 559:./lwip-2.1.2/src/core/udp.c ****         netif = netif_get_by_index(pcb->mcast_ifindex);
 560:./lwip-2.1.2/src/core/udp.c ****       }
 561:./lwip-2.1.2/src/core/udp.c **** #if LWIP_IPV4
 562:./lwip-2.1.2/src/core/udp.c ****       else
 563:./lwip-2.1.2/src/core/udp.c **** #if LWIP_IPV6
 564:./lwip-2.1.2/src/core/udp.c ****         if (IP_IS_V4(dst_ip))
 565:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_IPV6 */
 566:./lwip-2.1.2/src/core/udp.c ****         {
 567:./lwip-2.1.2/src/core/udp.c ****           /* IPv4 does not use source-based routing by default, so we use an
 568:./lwip-2.1.2/src/core/udp.c ****              administratively selected interface for multicast by default.
 569:./lwip-2.1.2/src/core/udp.c ****              However, this can be overridden by setting an interface address
 570:./lwip-2.1.2/src/core/udp.c ****              in pcb->mcast_ip4 that is used for routing. If this routing lookup
 571:./lwip-2.1.2/src/core/udp.c ****              fails, we try regular routing as though no override was set. */
 572:./lwip-2.1.2/src/core/udp.c ****           if (!ip4_addr_isany_val(pcb->mcast_ip4) &&
 573:./lwip-2.1.2/src/core/udp.c ****               !ip4_addr_cmp(&pcb->mcast_ip4, IP4_ADDR_BROADCAST)) {
 574:./lwip-2.1.2/src/core/udp.c ****             netif = ip4_route_src(ip_2_ip4(&pcb->local_ip), &pcb->mcast_ip4);
 575:./lwip-2.1.2/src/core/udp.c ****           }
 576:./lwip-2.1.2/src/core/udp.c ****         }
 577:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_IPV4 */
 578:./lwip-2.1.2/src/core/udp.c ****     }
 579:./lwip-2.1.2/src/core/udp.c **** 
 580:./lwip-2.1.2/src/core/udp.c ****     if (netif == NULL)
 581:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_MULTICAST_TX_OPTIONS */
 582:./lwip-2.1.2/src/core/udp.c ****     {
 583:./lwip-2.1.2/src/core/udp.c ****       /* find the outgoing network interface for this packet */
 584:./lwip-2.1.2/src/core/udp.c ****       netif = ip_route(&pcb->local_ip, dst_ip);
 585:./lwip-2.1.2/src/core/udp.c ****     }
 586:./lwip-2.1.2/src/core/udp.c ****   }
 587:./lwip-2.1.2/src/core/udp.c **** 
 588:./lwip-2.1.2/src/core/udp.c ****   /* no outgoing network interface could be found? */
 589:./lwip-2.1.2/src/core/udp.c ****   if (netif == NULL) {
 590:./lwip-2.1.2/src/core/udp.c ****     LWIP_DEBUGF(UDP_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("udp_send: No route to "));
 591:./lwip-2.1.2/src/core/udp.c ****     ip_addr_debug_print(UDP_DEBUG | LWIP_DBG_LEVEL_SERIOUS, dst_ip);
 592:./lwip-2.1.2/src/core/udp.c ****     LWIP_DEBUGF(UDP_DEBUG, ("\n"));
 593:./lwip-2.1.2/src/core/udp.c ****     UDP_STATS_INC(udp.rterr);
 594:./lwip-2.1.2/src/core/udp.c ****     return ERR_RTE;
 595:./lwip-2.1.2/src/core/udp.c ****   }
 596:./lwip-2.1.2/src/core/udp.c **** #if LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP
 597:./lwip-2.1.2/src/core/udp.c ****   return udp_sendto_if_chksum(pcb, p, dst_ip, dst_port, netif, have_chksum, chksum);
 598:./lwip-2.1.2/src/core/udp.c **** #else /* LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP */
 599:./lwip-2.1.2/src/core/udp.c ****   return udp_sendto_if(pcb, p, dst_ip, dst_port, netif);
 600:./lwip-2.1.2/src/core/udp.c **** #endif /* LWIP_CHECKSUM_ON_COPY && CHECKSUM_GEN_UDP */
 601:./lwip-2.1.2/src/core/udp.c **** }

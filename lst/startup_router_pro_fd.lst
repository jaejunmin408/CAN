 120:./inc/cmsis_gcc.h **** /* #########################  Startup and Lowlevel Init  ######################## */
 121:./inc/cmsis_gcc.h **** 
 122:./inc/cmsis_gcc.h **** #ifndef __PROGRAM_START
 123:./inc/cmsis_gcc.h **** 
 124:./inc/cmsis_gcc.h **** /**
 125:./inc/cmsis_gcc.h ****   \brief   Initializes data and bss sections
 126:./inc/cmsis_gcc.h ****   \details This default implementations initialized all data and additional bss
 127:./inc/cmsis_gcc.h ****            sections relying on .copy.table and .zero.table specified properly
 128:./inc/cmsis_gcc.h ****            in the used linker script.
 129:./inc/cmsis_gcc.h ****   
 130:./inc/cmsis_gcc.h ****  */
 131:./inc/cmsis_gcc.h **** __STATIC_FORCEINLINE __NO_RETURN void __cmsis_start(void)
 132:./inc/cmsis_gcc.h **** {
 133:./inc/cmsis_gcc.h ****   extern void _start(void) __NO_RETURN;
 134:./inc/cmsis_gcc.h ****   
 135:./inc/cmsis_gcc.h ****   typedef struct {
 136:./inc/cmsis_gcc.h ****     uint32_t const* src;
 137:./inc/cmsis_gcc.h ****     uint32_t* dest;
 138:./inc/cmsis_gcc.h ****     uint32_t  wlen;
 139:./inc/cmsis_gcc.h ****   } __copy_table_t;
 140:./inc/cmsis_gcc.h ****   
 141:./inc/cmsis_gcc.h ****   typedef struct {
 142:./inc/cmsis_gcc.h ****     uint32_t* dest;
 143:./inc/cmsis_gcc.h ****     uint32_t  wlen;
 144:./inc/cmsis_gcc.h ****   } __zero_table_t;
 145:./inc/cmsis_gcc.h ****   
 146:./inc/cmsis_gcc.h ****   extern const __copy_table_t __copy_table_start__;
 147:./inc/cmsis_gcc.h ****   extern const __copy_table_t __copy_table_end__;
 148:./inc/cmsis_gcc.h ****   extern const __zero_table_t __zero_table_start__;
 149:./inc/cmsis_gcc.h ****   extern const __zero_table_t __zero_table_end__;
 150:./inc/cmsis_gcc.h **** 
 151:./inc/cmsis_gcc.h ****   for (__copy_table_t const* pTable = &__copy_table_start__; pTable < &__copy_table_end__; ++pTable
 152:./inc/cmsis_gcc.h ****     for(uint32_t i=0u; i<pTable->wlen; ++i) {
 153:./inc/cmsis_gcc.h ****       pTable->dest[i] = pTable->src[i];
 154:./inc/cmsis_gcc.h ****     }
 155:./inc/cmsis_gcc.h ****   }
 156:./inc/cmsis_gcc.h ****  
 157:./inc/cmsis_gcc.h ****   for (__zero_table_t const* pTable = &__zero_table_start__; pTable < &__zero_table_end__; ++pTable
 158:./inc/cmsis_gcc.h ****     for(uint32_t i=0u; i<pTable->wlen; ++i) {
 159:./inc/cmsis_gcc.h ****       pTable->dest[i] = 0u;
 160:./inc/cmsis_gcc.h ****     }
 161:./inc/cmsis_gcc.h ****   }
 162:./inc/cmsis_gcc.h ****  
 163:./inc/cmsis_gcc.h ****   _start();
 164:./inc/cmsis_gcc.h **** }
 165:./inc/cmsis_gcc.h ****   
 166:./inc/cmsis_gcc.h **** #define __PROGRAM_START           __cmsis_start
 167:./inc/cmsis_gcc.h **** #endif

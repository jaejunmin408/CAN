  70:./lwip-2.1.2/src/core/ipv4/icmp.c **** /**
  71:./lwip-2.1.2/src/core/ipv4/icmp.c ****  * Processes ICMP input packets, called from ip_input().
  72:./lwip-2.1.2/src/core/ipv4/icmp.c ****  *
  73:./lwip-2.1.2/src/core/ipv4/icmp.c ****  * Currently only processes icmp echo requests and sends
  74:./lwip-2.1.2/src/core/ipv4/icmp.c ****  * out the echo response.
  75:./lwip-2.1.2/src/core/ipv4/icmp.c ****  *
  76:./lwip-2.1.2/src/core/ipv4/icmp.c ****  * @param p the icmp echo request packet, p->payload pointing to the icmp header
  77:./lwip-2.1.2/src/core/ipv4/icmp.c ****  * @param inp the netif on which this packet was received
  78:./lwip-2.1.2/src/core/ipv4/icmp.c ****  */
  79:./lwip-2.1.2/src/core/ipv4/icmp.c **** void
  80:./lwip-2.1.2/src/core/ipv4/icmp.c **** icmp_input(struct pbuf *p, struct netif *inp)
  81:./lwip-2.1.2/src/core/ipv4/icmp.c **** {
  82:./lwip-2.1.2/src/core/ipv4/icmp.c ****   u8_t type;
  83:./lwip-2.1.2/src/core/ipv4/icmp.c **** #ifdef LWIP_DEBUG
  84:./lwip-2.1.2/src/core/ipv4/icmp.c ****   u8_t code;
  85:./lwip-2.1.2/src/core/ipv4/icmp.c **** #endif /* LWIP_DEBUG */
  86:./lwip-2.1.2/src/core/ipv4/icmp.c ****   struct icmp_echo_hdr *iecho;
  87:./lwip-2.1.2/src/core/ipv4/icmp.c ****   const struct ip_hdr *iphdr_in;
  88:./lwip-2.1.2/src/core/ipv4/icmp.c ****   u16_t hlen;
  89:./lwip-2.1.2/src/core/ipv4/icmp.c ****   const ip4_addr_t *src;
  90:./lwip-2.1.2/src/core/ipv4/icmp.c **** 
  91:./lwip-2.1.2/src/core/ipv4/icmp.c ****   ICMP_STATS_INC(icmp.recv);
  92:./lwip-2.1.2/src/core/ipv4/icmp.c ****   MIB2_STATS_INC(mib2.icmpinmsgs);
  93:./lwip-2.1.2/src/core/ipv4/icmp.c **** 
  94:./lwip-2.1.2/src/core/ipv4/icmp.c ****   iphdr_in = ip4_current_header();
  95:./lwip-2.1.2/src/core/ipv4/icmp.c ****   hlen = IPH_HL_BYTES(iphdr_in);
  96:./lwip-2.1.2/src/core/ipv4/icmp.c ****   if (hlen < IP_HLEN) {
  97:./lwip-2.1.2/src/core/ipv4/icmp.c ****     LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: short IP header (%"S16_F" bytes) received\n", hlen));
  98:./lwip-2.1.2/src/core/ipv4/icmp.c ****     goto lenerr;
  99:./lwip-2.1.2/src/core/ipv4/icmp.c ****   }
 100:./lwip-2.1.2/src/core/ipv4/icmp.c ****   if (p->len < sizeof(u16_t) * 2) {
 101:./lwip-2.1.2/src/core/ipv4/icmp.c ****     LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: short ICMP (%"U16_F" bytes) received\n", p->tot_len));
 102:./lwip-2.1.2/src/core/ipv4/icmp.c ****     goto lenerr;
 103:./lwip-2.1.2/src/core/ipv4/icmp.c ****   }
 104:./lwip-2.1.2/src/core/ipv4/icmp.c **** 
 105:./lwip-2.1.2/src/core/ipv4/icmp.c ****   type = *((u8_t *)p->payload);
 106:./lwip-2.1.2/src/core/ipv4/icmp.c **** #ifdef LWIP_DEBUG
 107:./lwip-2.1.2/src/core/ipv4/icmp.c ****   code = *(((u8_t *)p->payload) + 1);
 108:./lwip-2.1.2/src/core/ipv4/icmp.c ****   /* if debug is enabled but debug statement below is somehow disabled: */
 109:./lwip-2.1.2/src/core/ipv4/icmp.c ****   LWIP_UNUSED_ARG(code);
 110:./lwip-2.1.2/src/core/ipv4/icmp.c **** #endif /* LWIP_DEBUG */
 111:./lwip-2.1.2/src/core/ipv4/icmp.c ****   switch (type) {
 112:./lwip-2.1.2/src/core/ipv4/icmp.c ****     case ICMP_ER:
 113:./lwip-2.1.2/src/core/ipv4/icmp.c ****       /* This is OK, echo reply might have been parsed by a raw PCB
 114:./lwip-2.1.2/src/core/ipv4/icmp.c ****          (as obviously, an echo request has been sent, too). */
 115:./lwip-2.1.2/src/core/ipv4/icmp.c ****       MIB2_STATS_INC(mib2.icmpinechoreps);
 116:./lwip-2.1.2/src/core/ipv4/icmp.c ****       break;
 117:./lwip-2.1.2/src/core/ipv4/icmp.c ****     case ICMP_ECHO:
 118:./lwip-2.1.2/src/core/ipv4/icmp.c ****       MIB2_STATS_INC(mib2.icmpinechos);
 119:./lwip-2.1.2/src/core/ipv4/icmp.c ****       src = ip4_current_dest_addr();
 120:./lwip-2.1.2/src/core/ipv4/icmp.c ****       /* multicast destination address? */
 121:./lwip-2.1.2/src/core/ipv4/icmp.c ****       if (ip4_addr_ismulticast(ip4_current_dest_addr())) {
 122:./lwip-2.1.2/src/core/ipv4/icmp.c **** #if LWIP_MULTICAST_PING
 123:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* For multicast, use address of receiving interface as source address */
 124:./lwip-2.1.2/src/core/ipv4/icmp.c ****         src = netif_ip4_addr(inp);
 125:./lwip-2.1.2/src/core/ipv4/icmp.c **** #else /* LWIP_MULTICAST_PING */
 126:./lwip-2.1.2/src/core/ipv4/icmp.c ****         LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: Not echoing to multicast pings\n"));
 127:./lwip-2.1.2/src/core/ipv4/icmp.c ****         goto icmperr;
 128:./lwip-2.1.2/src/core/ipv4/icmp.c **** #endif /* LWIP_MULTICAST_PING */
 129:./lwip-2.1.2/src/core/ipv4/icmp.c ****       }
 130:./lwip-2.1.2/src/core/ipv4/icmp.c ****       /* broadcast destination address? */
 131:./lwip-2.1.2/src/core/ipv4/icmp.c ****       if (ip4_addr_isbroadcast(ip4_current_dest_addr(), ip_current_netif())) {
 132:./lwip-2.1.2/src/core/ipv4/icmp.c **** #if LWIP_BROADCAST_PING
 133:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* For broadcast, use address of receiving interface as source address */
 134:./lwip-2.1.2/src/core/ipv4/icmp.c ****         src = netif_ip4_addr(inp);
 135:./lwip-2.1.2/src/core/ipv4/icmp.c **** #else /* LWIP_BROADCAST_PING */
 136:./lwip-2.1.2/src/core/ipv4/icmp.c ****         LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: Not echoing to broadcast pings\n"));
 137:./lwip-2.1.2/src/core/ipv4/icmp.c ****         goto icmperr;
 138:./lwip-2.1.2/src/core/ipv4/icmp.c **** #endif /* LWIP_BROADCAST_PING */
 139:./lwip-2.1.2/src/core/ipv4/icmp.c ****       }
 140:./lwip-2.1.2/src/core/ipv4/icmp.c ****       LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: ping\n"));
 141:./lwip-2.1.2/src/core/ipv4/icmp.c ****       if (p->tot_len < sizeof(struct icmp_echo_hdr)) {
 142:./lwip-2.1.2/src/core/ipv4/icmp.c ****         LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: bad ICMP echo received\n"));
 143:./lwip-2.1.2/src/core/ipv4/icmp.c ****         goto lenerr;
 144:./lwip-2.1.2/src/core/ipv4/icmp.c ****       }
 145:./lwip-2.1.2/src/core/ipv4/icmp.c **** #if CHECKSUM_CHECK_ICMP
 146:./lwip-2.1.2/src/core/ipv4/icmp.c ****       IF__NETIF_CHECKSUM_ENABLED(inp, NETIF_CHECKSUM_CHECK_ICMP) {
 147:./lwip-2.1.2/src/core/ipv4/icmp.c ****         if (inet_chksum_pbuf(p) != 0) {
 148:./lwip-2.1.2/src/core/ipv4/icmp.c ****           LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: checksum failed for received ICMP echo\n"));
 149:./lwip-2.1.2/src/core/ipv4/icmp.c ****           pbuf_free(p);
 150:./lwip-2.1.2/src/core/ipv4/icmp.c ****           ICMP_STATS_INC(icmp.chkerr);
 151:./lwip-2.1.2/src/core/ipv4/icmp.c ****           MIB2_STATS_INC(mib2.icmpinerrors);
 152:./lwip-2.1.2/src/core/ipv4/icmp.c ****           return;
 153:./lwip-2.1.2/src/core/ipv4/icmp.c ****         }
 154:./lwip-2.1.2/src/core/ipv4/icmp.c ****       }
 155:./lwip-2.1.2/src/core/ipv4/icmp.c **** #endif
 156:./lwip-2.1.2/src/core/ipv4/icmp.c **** #if LWIP_ICMP_ECHO_CHECK_INPUT_PBUF_LEN
 157:./lwip-2.1.2/src/core/ipv4/icmp.c ****       if (pbuf_add_header(p, hlen + PBUF_LINK_HLEN + PBUF_LINK_ENCAPSULATION_HLEN)) {
 158:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* p is not big enough to contain link headers
 159:./lwip-2.1.2/src/core/ipv4/icmp.c ****          * allocate a new one and copy p into it
 160:./lwip-2.1.2/src/core/ipv4/icmp.c ****          */
 161:./lwip-2.1.2/src/core/ipv4/icmp.c ****         struct pbuf *r;
 162:./lwip-2.1.2/src/core/ipv4/icmp.c ****         u16_t alloc_len = (u16_t)(p->tot_len + hlen);
 163:./lwip-2.1.2/src/core/ipv4/icmp.c ****         if (alloc_len < p->tot_len) {
 164:./lwip-2.1.2/src/core/ipv4/icmp.c ****           LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: allocating new pbuf failed (tot_len overflow)\n"));
 165:./lwip-2.1.2/src/core/ipv4/icmp.c ****           goto icmperr;
 166:./lwip-2.1.2/src/core/ipv4/icmp.c ****         }
 167:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* allocate new packet buffer with space for link headers */
 168:./lwip-2.1.2/src/core/ipv4/icmp.c ****         r = pbuf_alloc(PBUF_LINK, alloc_len, PBUF_RAM);
 169:./lwip-2.1.2/src/core/ipv4/icmp.c ****         if (r == NULL) {
 170:./lwip-2.1.2/src/core/ipv4/icmp.c ****           LWIP_DEBUGF(ICMP_DEBUG, ("icmp_input: allocating new pbuf failed\n"));
 171:./lwip-2.1.2/src/core/ipv4/icmp.c ****           goto icmperr;
 172:./lwip-2.1.2/src/core/ipv4/icmp.c ****         }
 173:./lwip-2.1.2/src/core/ipv4/icmp.c ****         if (r->len < hlen + sizeof(struct icmp_echo_hdr)) {
 174:./lwip-2.1.2/src/core/ipv4/icmp.c ****           LWIP_DEBUGF(ICMP_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("first pbuf cannot hold the ICMP header
 175:./lwip-2.1.2/src/core/ipv4/icmp.c ****           pbuf_free(r);
 176:./lwip-2.1.2/src/core/ipv4/icmp.c ****           goto icmperr;
 177:./lwip-2.1.2/src/core/ipv4/icmp.c ****         }
 178:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* copy the ip header */
 179:./lwip-2.1.2/src/core/ipv4/icmp.c ****         MEMCPY(r->payload, iphdr_in, hlen);
 180:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* switch r->payload back to icmp header (cannot fail) */
 181:./lwip-2.1.2/src/core/ipv4/icmp.c ****         if (pbuf_remove_header(r, hlen)) {
 182:./lwip-2.1.2/src/core/ipv4/icmp.c ****           LWIP_ASSERT("icmp_input: moving r->payload to icmp header failed\n", 0);
 183:./lwip-2.1.2/src/core/ipv4/icmp.c ****           pbuf_free(r);
 184:./lwip-2.1.2/src/core/ipv4/icmp.c ****           goto icmperr;
 185:./lwip-2.1.2/src/core/ipv4/icmp.c ****         }
 186:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* copy the rest of the packet without ip header */
 187:./lwip-2.1.2/src/core/ipv4/icmp.c ****         if (pbuf_copy(r, p) != ERR_OK) {
 188:./lwip-2.1.2/src/core/ipv4/icmp.c ****           LWIP_DEBUGF(ICMP_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("icmp_input: copying to new pbuf failed
 189:./lwip-2.1.2/src/core/ipv4/icmp.c ****           pbuf_free(r);
 190:./lwip-2.1.2/src/core/ipv4/icmp.c ****           goto icmperr;
 191:./lwip-2.1.2/src/core/ipv4/icmp.c ****         }
 192:./lwip-2.1.2/src/core/ipv4/icmp.c ****         /* free the original p */

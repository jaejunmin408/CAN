 350:./lwip-2.1.2/src/core/tcp_out.c **** /**
 351:./lwip-2.1.2/src/core/tcp_out.c ****  * @ingroup tcp_raw
 352:./lwip-2.1.2/src/core/tcp_out.c ****  * Write data for sending (but does not send it immediately).
 353:./lwip-2.1.2/src/core/tcp_out.c ****  *
 354:./lwip-2.1.2/src/core/tcp_out.c ****  * It waits in the expectation of more data being sent soon (as
 355:./lwip-2.1.2/src/core/tcp_out.c ****  * it can send them more efficiently by combining them together).
 356:./lwip-2.1.2/src/core/tcp_out.c ****  * To prompt the system to send data now, call tcp_output() after
 357:./lwip-2.1.2/src/core/tcp_out.c ****  * calling tcp_write().
 358:./lwip-2.1.2/src/core/tcp_out.c ****  * 
 359:./lwip-2.1.2/src/core/tcp_out.c ****  * This function enqueues the data pointed to by the argument dataptr. The length of
 360:./lwip-2.1.2/src/core/tcp_out.c ****  * the data is passed as the len parameter. The apiflags can be one or more of:
 361:./lwip-2.1.2/src/core/tcp_out.c ****  * - TCP_WRITE_FLAG_COPY: indicates whether the new memory should be allocated
 362:./lwip-2.1.2/src/core/tcp_out.c ****  *   for the data to be copied into. If this flag is not given, no new memory
 363:./lwip-2.1.2/src/core/tcp_out.c ****  *   should be allocated and the data should only be referenced by pointer. This
 364:./lwip-2.1.2/src/core/tcp_out.c ****  *   also means that the memory behind dataptr must not change until the data is
 365:./lwip-2.1.2/src/core/tcp_out.c ****  *   ACKed by the remote host
 366:./lwip-2.1.2/src/core/tcp_out.c ****  * - TCP_WRITE_FLAG_MORE: indicates that more data follows. If this is omitted,
 367:./lwip-2.1.2/src/core/tcp_out.c ****  *   the PSH flag is set in the last segment created by this call to tcp_write.
 368:./lwip-2.1.2/src/core/tcp_out.c ****  *   If this flag is given, the PSH flag is not set.
 369:./lwip-2.1.2/src/core/tcp_out.c ****  *
 370:./lwip-2.1.2/src/core/tcp_out.c ****  * The tcp_write() function will fail and return ERR_MEM if the length
 371:./lwip-2.1.2/src/core/tcp_out.c ****  * of the data exceeds the current send buffer size or if the length of
 372:./lwip-2.1.2/src/core/tcp_out.c ****  * the queue of outgoing segment is larger than the upper limit defined
 373:./lwip-2.1.2/src/core/tcp_out.c ****  * in lwipopts.h. The number of bytes available in the output queue can
 374:./lwip-2.1.2/src/core/tcp_out.c ****  * be retrieved with the tcp_sndbuf() function.
 375:./lwip-2.1.2/src/core/tcp_out.c ****  *
 376:./lwip-2.1.2/src/core/tcp_out.c ****  * The proper way to use this function is to call the function with at
 377:./lwip-2.1.2/src/core/tcp_out.c ****  * most tcp_sndbuf() bytes of data. If the function returns ERR_MEM,
 378:./lwip-2.1.2/src/core/tcp_out.c ****  * the application should wait until some of the currently enqueued
 379:./lwip-2.1.2/src/core/tcp_out.c ****  * data has been successfully received by the other host and try again.
 380:./lwip-2.1.2/src/core/tcp_out.c ****  *
 381:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb Protocol control block for the TCP connection to enqueue data for.
 382:./lwip-2.1.2/src/core/tcp_out.c ****  * @param arg Pointer to the data to be enqueued for sending.
 383:./lwip-2.1.2/src/core/tcp_out.c ****  * @param len Data length in bytes
 384:./lwip-2.1.2/src/core/tcp_out.c ****  * @param apiflags combination of following flags :
 385:./lwip-2.1.2/src/core/tcp_out.c ****  * - TCP_WRITE_FLAG_COPY (0x01) data will be copied into memory belonging to the stack
 386:./lwip-2.1.2/src/core/tcp_out.c ****  * - TCP_WRITE_FLAG_MORE (0x02) for TCP connection, PSH flag will not be set on last segment sent,
 387:./lwip-2.1.2/src/core/tcp_out.c ****  * @return ERR_OK if enqueued, another err_t on error
 388:./lwip-2.1.2/src/core/tcp_out.c ****  */
 389:./lwip-2.1.2/src/core/tcp_out.c **** err_t
 390:./lwip-2.1.2/src/core/tcp_out.c **** tcp_write(struct tcp_pcb *pcb, const void *arg, u16_t len, u8_t apiflags)
 391:./lwip-2.1.2/src/core/tcp_out.c **** {
 392:./lwip-2.1.2/src/core/tcp_out.c ****   struct pbuf *concat_p = NULL;
 393:./lwip-2.1.2/src/core/tcp_out.c ****   struct tcp_seg *last_unsent = NULL, *seg = NULL, *prev_seg = NULL, *queue = NULL;
 394:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t pos = 0; /* position in 'arg' data */
 395:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t queuelen;
 396:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optlen;
 397:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optflags = 0;
 398:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE
 399:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t oversize = 0;
 400:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t oversize_used = 0;
 401:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
 402:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t oversize_add = 0;
 403:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK*/
 404:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE */
 405:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t extendlen = 0;
 406:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 407:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t concat_chksum = 0;
 408:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t concat_chksum_swapped = 0;
 409:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t concat_chksummed = 0;
 410:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 411:./lwip-2.1.2/src/core/tcp_out.c ****   err_t err;
 412:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t mss_local;
 413:./lwip-2.1.2/src/core/tcp_out.c **** 
 414:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ERROR("tcp_write: invalid pcb", pcb != NULL, return ERR_ARG);
 415:./lwip-2.1.2/src/core/tcp_out.c **** 
 416:./lwip-2.1.2/src/core/tcp_out.c ****   /* don't allocate segments bigger than half the maximum window we ever received */
 417:./lwip-2.1.2/src/core/tcp_out.c ****   mss_local = LWIP_MIN(pcb->mss, TCPWND_MIN16(pcb->snd_wnd_max / 2));
 418:./lwip-2.1.2/src/core/tcp_out.c ****   mss_local = mss_local ? mss_local : pcb->mss;
 419:./lwip-2.1.2/src/core/tcp_out.c **** 
 420:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT_CORE_LOCKED();
 421:./lwip-2.1.2/src/core/tcp_out.c **** 
 422:./lwip-2.1.2/src/core/tcp_out.c **** #if LWIP_NETIF_TX_SINGLE_PBUF
 423:./lwip-2.1.2/src/core/tcp_out.c ****   /* Always copy to try to create single pbufs for TX */
 424:./lwip-2.1.2/src/core/tcp_out.c ****   apiflags |= TCP_WRITE_FLAG_COPY;
 425:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* LWIP_NETIF_TX_SINGLE_PBUF */
 426:./lwip-2.1.2/src/core/tcp_out.c **** 
 427:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_DEBUGF(TCP_OUTPUT_DEBUG, ("tcp_write(pcb=%p, data=%p, len=%"U16_F", apiflags=%"U16_F")\n",
 428:./lwip-2.1.2/src/core/tcp_out.c ****                                  (void *)pcb, arg, len, (u16_t)apiflags));
 429:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ERROR("tcp_write: arg == NULL (programmer violates API)",
 430:./lwip-2.1.2/src/core/tcp_out.c ****              arg != NULL, return ERR_ARG;);
 431:./lwip-2.1.2/src/core/tcp_out.c **** 
 432:./lwip-2.1.2/src/core/tcp_out.c ****   err = tcp_write_checks(pcb, len);
 433:./lwip-2.1.2/src/core/tcp_out.c ****   if (err != ERR_OK) {
 434:./lwip-2.1.2/src/core/tcp_out.c ****     return err;
 435:./lwip-2.1.2/src/core/tcp_out.c ****   }
 436:./lwip-2.1.2/src/core/tcp_out.c ****   queuelen = pcb->snd_queuelen;
 437:./lwip-2.1.2/src/core/tcp_out.c **** 
 438:./lwip-2.1.2/src/core/tcp_out.c **** #if LWIP_TCP_TIMESTAMPS
 439:./lwip-2.1.2/src/core/tcp_out.c ****   if ((pcb->flags & TF_TIMESTAMP)) {
 440:./lwip-2.1.2/src/core/tcp_out.c ****     /* Make sure the timestamp option is only included in data segments if we
 441:./lwip-2.1.2/src/core/tcp_out.c ****        agreed about it with the remote host. */
 442:./lwip-2.1.2/src/core/tcp_out.c ****     optflags = TF_SEG_OPTS_TS;
 443:./lwip-2.1.2/src/core/tcp_out.c ****     optlen = LWIP_TCP_OPT_LENGTH_SEGMENT(TF_SEG_OPTS_TS, pcb);
 444:./lwip-2.1.2/src/core/tcp_out.c ****     /* ensure that segments can hold at least one data byte... */
 445:./lwip-2.1.2/src/core/tcp_out.c ****     mss_local = LWIP_MAX(mss_local, LWIP_TCP_OPT_LEN_TS + 1);
 446:./lwip-2.1.2/src/core/tcp_out.c ****   } else
 447:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* LWIP_TCP_TIMESTAMPS */
 448:./lwip-2.1.2/src/core/tcp_out.c ****   {
 449:./lwip-2.1.2/src/core/tcp_out.c ****     optlen = LWIP_TCP_OPT_LENGTH_SEGMENT(0, pcb);
 450:./lwip-2.1.2/src/core/tcp_out.c ****   }
 451:./lwip-2.1.2/src/core/tcp_out.c **** 
 452:./lwip-2.1.2/src/core/tcp_out.c **** 
 453:./lwip-2.1.2/src/core/tcp_out.c ****   /*
 454:./lwip-2.1.2/src/core/tcp_out.c ****    * TCP segmentation is done in three phases with increasing complexity:
 455:./lwip-2.1.2/src/core/tcp_out.c ****    *
 456:./lwip-2.1.2/src/core/tcp_out.c ****    * 1. Copy data directly into an oversized pbuf.
 457:./lwip-2.1.2/src/core/tcp_out.c ****    * 2. Chain a new pbuf to the end of pcb->unsent.
 458:./lwip-2.1.2/src/core/tcp_out.c ****    * 3. Create new segments.
 459:./lwip-2.1.2/src/core/tcp_out.c ****    *
 460:./lwip-2.1.2/src/core/tcp_out.c ****    * We may run out of memory at any point. In that case we must
 461:./lwip-2.1.2/src/core/tcp_out.c ****    * return ERR_MEM and not change anything in pcb. Therefore, all
 462:./lwip-2.1.2/src/core/tcp_out.c ****    * changes are recorded in local variables and committed at the end
 463:./lwip-2.1.2/src/core/tcp_out.c ****    * of the function. Some pcb fields are maintained in local copies:
 464:./lwip-2.1.2/src/core/tcp_out.c ****    *
 465:./lwip-2.1.2/src/core/tcp_out.c ****    * queuelen = pcb->snd_queuelen
 466:./lwip-2.1.2/src/core/tcp_out.c ****    * oversize = pcb->unsent_oversize
 467:./lwip-2.1.2/src/core/tcp_out.c ****    *
 468:./lwip-2.1.2/src/core/tcp_out.c ****    * These variables are set consistently by the phases:
 469:./lwip-2.1.2/src/core/tcp_out.c ****    *
 470:./lwip-2.1.2/src/core/tcp_out.c ****    * seg points to the last segment tampered with.
 471:./lwip-2.1.2/src/core/tcp_out.c ****    *
 472:./lwip-2.1.2/src/core/tcp_out.c ****    * pos records progress as data is segmented.
 473:./lwip-2.1.2/src/core/tcp_out.c ****    */
 474:./lwip-2.1.2/src/core/tcp_out.c **** 
 475:./lwip-2.1.2/src/core/tcp_out.c ****   /* Find the tail of the unsent queue. */
 476:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->unsent != NULL) {
 477:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t space;
 478:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t unsent_optlen;
 479:./lwip-2.1.2/src/core/tcp_out.c **** 
 480:./lwip-2.1.2/src/core/tcp_out.c ****     /* @todo: this could be sped up by keeping last_unsent in the pcb */
 481:./lwip-2.1.2/src/core/tcp_out.c ****     for (last_unsent = pcb->unsent; last_unsent->next != NULL;
 482:./lwip-2.1.2/src/core/tcp_out.c ****          last_unsent = last_unsent->next);
 483:./lwip-2.1.2/src/core/tcp_out.c **** 
 484:./lwip-2.1.2/src/core/tcp_out.c ****     /* Usable space at the end of the last unsent segment */
 485:./lwip-2.1.2/src/core/tcp_out.c ****     unsent_optlen = LWIP_TCP_OPT_LENGTH_SEGMENT(last_unsent->flags, pcb);
 486:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("mss_local is too small", mss_local >= last_unsent->len + unsent_optlen);
 487:./lwip-2.1.2/src/core/tcp_out.c ****     space = mss_local - (last_unsent->len + unsent_optlen);
 488:./lwip-2.1.2/src/core/tcp_out.c **** 
 489:./lwip-2.1.2/src/core/tcp_out.c ****     /*
 490:./lwip-2.1.2/src/core/tcp_out.c ****      * Phase 1: Copy data directly into an oversized pbuf.
 491:./lwip-2.1.2/src/core/tcp_out.c ****      *
 492:./lwip-2.1.2/src/core/tcp_out.c ****      * The number of bytes copied is recorded in the oversize_used
 493:./lwip-2.1.2/src/core/tcp_out.c ****      * variable. The actual copying is done at the bottom of the
 494:./lwip-2.1.2/src/core/tcp_out.c ****      * function.
 495:./lwip-2.1.2/src/core/tcp_out.c ****      */
 496:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE
 497:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
 498:./lwip-2.1.2/src/core/tcp_out.c ****     /* check that pcb->unsent_oversize matches last_unsent->oversize_left */
 499:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("unsent_oversize mismatch (pcb vs. last_unsent)",
 500:./lwip-2.1.2/src/core/tcp_out.c ****                 pcb->unsent_oversize == last_unsent->oversize_left);
 501:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
 502:./lwip-2.1.2/src/core/tcp_out.c ****     oversize = pcb->unsent_oversize;
 503:./lwip-2.1.2/src/core/tcp_out.c ****     if (oversize > 0) {
 504:./lwip-2.1.2/src/core/tcp_out.c ****       LWIP_ASSERT("inconsistent oversize vs. space", oversize <= space);
 505:./lwip-2.1.2/src/core/tcp_out.c ****       seg = last_unsent;
 506:./lwip-2.1.2/src/core/tcp_out.c ****       oversize_used = LWIP_MIN(space, LWIP_MIN(oversize, len));
 507:./lwip-2.1.2/src/core/tcp_out.c ****       pos += oversize_used;
 508:./lwip-2.1.2/src/core/tcp_out.c ****       oversize -= oversize_used;
 509:./lwip-2.1.2/src/core/tcp_out.c ****       space -= oversize_used;
 510:./lwip-2.1.2/src/core/tcp_out.c ****     }
 511:./lwip-2.1.2/src/core/tcp_out.c ****     /* now we are either finished or oversize is zero */
 512:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("inconsistent oversize vs. len", (oversize == 0) || (pos == len));
 513:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE */
 514:./lwip-2.1.2/src/core/tcp_out.c **** 
 515:./lwip-2.1.2/src/core/tcp_out.c **** #if !LWIP_NETIF_TX_SINGLE_PBUF
 516:./lwip-2.1.2/src/core/tcp_out.c ****     /*
 517:./lwip-2.1.2/src/core/tcp_out.c ****      * Phase 2: Chain a new pbuf to the end of pcb->unsent.
 518:./lwip-2.1.2/src/core/tcp_out.c ****      *
 519:./lwip-2.1.2/src/core/tcp_out.c ****      * As an exception when NOT copying the data, if the given data buffer
 520:./lwip-2.1.2/src/core/tcp_out.c ****      * directly follows the last unsent data buffer in memory, extend the last
 521:./lwip-2.1.2/src/core/tcp_out.c ****      * ROM pbuf reference to the buffer, thus saving a ROM pbuf allocation.
 522:./lwip-2.1.2/src/core/tcp_out.c ****      *
 523:./lwip-2.1.2/src/core/tcp_out.c ****      * We don't extend segments containing SYN/FIN flags or options
 524:./lwip-2.1.2/src/core/tcp_out.c ****      * (len==0). The new pbuf is kept in concat_p and pbuf_cat'ed at
 525:./lwip-2.1.2/src/core/tcp_out.c ****      * the end.
 526:./lwip-2.1.2/src/core/tcp_out.c ****      *
 527:./lwip-2.1.2/src/core/tcp_out.c ****      * This phase is skipped for LWIP_NETIF_TX_SINGLE_PBUF as we could only execute
 528:./lwip-2.1.2/src/core/tcp_out.c ****      * it after rexmit puts a segment from unacked to unsent and at this point,
 529:./lwip-2.1.2/src/core/tcp_out.c ****      * oversize info is lost.
 530:./lwip-2.1.2/src/core/tcp_out.c ****      */
 531:./lwip-2.1.2/src/core/tcp_out.c ****     if ((pos < len) && (space > 0) && (last_unsent->len > 0)) {
 532:./lwip-2.1.2/src/core/tcp_out.c ****       u16_t seglen = LWIP_MIN(space, len - pos);
 533:./lwip-2.1.2/src/core/tcp_out.c ****       seg = last_unsent;
 534:./lwip-2.1.2/src/core/tcp_out.c **** 
 535:./lwip-2.1.2/src/core/tcp_out.c ****       /* Create a pbuf with a copy or reference to seglen bytes. We
 536:./lwip-2.1.2/src/core/tcp_out.c ****        * can use PBUF_RAW here since the data appears in the middle of
 537:./lwip-2.1.2/src/core/tcp_out.c ****        * a segment. A header will never be prepended. */
 538:./lwip-2.1.2/src/core/tcp_out.c ****       if (apiflags & TCP_WRITE_FLAG_COPY) {
 539:./lwip-2.1.2/src/core/tcp_out.c ****         /* Data is copied */
 540:./lwip-2.1.2/src/core/tcp_out.c ****         if ((concat_p = tcp_pbuf_prealloc(PBUF_RAW, seglen, space, &oversize, pcb, apiflags, 1)) ==
 541:./lwip-2.1.2/src/core/tcp_out.c ****           LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS,
 542:./lwip-2.1.2/src/core/tcp_out.c ****                       ("tcp_write : could not allocate memory for pbuf copy size %"U16_F"\n",
 543:./lwip-2.1.2/src/core/tcp_out.c ****                        seglen));
 544:./lwip-2.1.2/src/core/tcp_out.c ****           goto memerr;
 545:./lwip-2.1.2/src/core/tcp_out.c ****         }
 546:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
 547:./lwip-2.1.2/src/core/tcp_out.c ****         oversize_add = oversize;
 548:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
 549:./lwip-2.1.2/src/core/tcp_out.c ****         TCP_DATA_COPY2(concat_p->payload, (const u8_t *)arg + pos, seglen, &concat_chksum, &concat_
 550:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 551:./lwip-2.1.2/src/core/tcp_out.c ****         concat_chksummed += seglen;
 552:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 553:./lwip-2.1.2/src/core/tcp_out.c ****         queuelen += pbuf_clen(concat_p);
 554:./lwip-2.1.2/src/core/tcp_out.c ****       } else {
 555:./lwip-2.1.2/src/core/tcp_out.c ****         /* Data is not copied */
 556:./lwip-2.1.2/src/core/tcp_out.c ****         /* If the last unsent pbuf is of type PBUF_ROM, try to extend it. */
 557:./lwip-2.1.2/src/core/tcp_out.c ****         struct pbuf *p;
 558:./lwip-2.1.2/src/core/tcp_out.c ****         for (p = last_unsent->p; p->next != NULL; p = p->next);
 559:./lwip-2.1.2/src/core/tcp_out.c ****         if (((p->type_internal & (PBUF_TYPE_FLAG_STRUCT_DATA_CONTIGUOUS | PBUF_TYPE_FLAG_DATA_VOLAT
 560:./lwip-2.1.2/src/core/tcp_out.c ****             (const u8_t *)p->payload + p->len == (const u8_t *)arg) {
 561:./lwip-2.1.2/src/core/tcp_out.c ****           LWIP_ASSERT("tcp_write: ROM pbufs cannot be oversized", pos == 0);
 562:./lwip-2.1.2/src/core/tcp_out.c ****           extendlen = seglen;
 563:./lwip-2.1.2/src/core/tcp_out.c ****         } else {
 564:./lwip-2.1.2/src/core/tcp_out.c ****           if ((concat_p = pbuf_alloc(PBUF_RAW, seglen, PBUF_ROM)) == NULL) {
 565:./lwip-2.1.2/src/core/tcp_out.c ****             LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS,
 566:./lwip-2.1.2/src/core/tcp_out.c ****                         ("tcp_write: could not allocate memory for zero-copy pbuf\n"));
 567:./lwip-2.1.2/src/core/tcp_out.c ****             goto memerr;
 568:./lwip-2.1.2/src/core/tcp_out.c ****           }
 569:./lwip-2.1.2/src/core/tcp_out.c ****           /* reference the non-volatile payload data */
 570:./lwip-2.1.2/src/core/tcp_out.c ****           ((struct pbuf_rom *)concat_p)->payload = (const u8_t *)arg + pos;
 571:./lwip-2.1.2/src/core/tcp_out.c ****           queuelen += pbuf_clen(concat_p);
 572:./lwip-2.1.2/src/core/tcp_out.c ****         }
 573:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 574:./lwip-2.1.2/src/core/tcp_out.c ****         /* calculate the checksum of nocopy-data */
 575:./lwip-2.1.2/src/core/tcp_out.c ****         tcp_seg_add_chksum(~inet_chksum((const u8_t *)arg + pos, seglen), seglen,
 576:./lwip-2.1.2/src/core/tcp_out.c ****                            &concat_chksum, &concat_chksum_swapped);
 577:./lwip-2.1.2/src/core/tcp_out.c ****         concat_chksummed += seglen;
 578:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 579:./lwip-2.1.2/src/core/tcp_out.c ****       }
 580:./lwip-2.1.2/src/core/tcp_out.c **** 
 581:./lwip-2.1.2/src/core/tcp_out.c ****       pos += seglen;
 582:./lwip-2.1.2/src/core/tcp_out.c ****     }
 583:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* !LWIP_NETIF_TX_SINGLE_PBUF */
 584:./lwip-2.1.2/src/core/tcp_out.c ****   } else {
 585:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE
 586:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("unsent_oversize mismatch (pcb->unsent is NULL)",
 587:./lwip-2.1.2/src/core/tcp_out.c ****                 pcb->unsent_oversize == 0);
 588:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE */
 589:./lwip-2.1.2/src/core/tcp_out.c ****   }
 590:./lwip-2.1.2/src/core/tcp_out.c **** 
 591:./lwip-2.1.2/src/core/tcp_out.c ****   /*
 592:./lwip-2.1.2/src/core/tcp_out.c ****    * Phase 3: Create new segments.
 593:./lwip-2.1.2/src/core/tcp_out.c ****    *
 594:./lwip-2.1.2/src/core/tcp_out.c ****    * The new segments are chained together in the local 'queue'
 595:./lwip-2.1.2/src/core/tcp_out.c ****    * variable, ready to be appended to pcb->unsent.
 596:./lwip-2.1.2/src/core/tcp_out.c ****    */
 597:./lwip-2.1.2/src/core/tcp_out.c ****   while (pos < len) {
 598:./lwip-2.1.2/src/core/tcp_out.c ****     struct pbuf *p;
 599:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t left = len - pos;
 600:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t max_len = mss_local - optlen;
 601:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t seglen = LWIP_MIN(left, max_len);
 602:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 603:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t chksum = 0;
 604:./lwip-2.1.2/src/core/tcp_out.c ****     u8_t chksum_swapped = 0;
 605:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 606:./lwip-2.1.2/src/core/tcp_out.c **** 
 607:./lwip-2.1.2/src/core/tcp_out.c ****     if (apiflags & TCP_WRITE_FLAG_COPY) {
 608:./lwip-2.1.2/src/core/tcp_out.c ****       /* If copy is set, memory should be allocated and data copied
 609:./lwip-2.1.2/src/core/tcp_out.c ****        * into pbuf */
 610:./lwip-2.1.2/src/core/tcp_out.c ****       if ((p = tcp_pbuf_prealloc(PBUF_TRANSPORT, seglen + optlen, mss_local, &oversize, pcb, apifla
 611:./lwip-2.1.2/src/core/tcp_out.c ****         LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_write : could not allocate mem
 612:./lwip-2.1.2/src/core/tcp_out.c ****         goto memerr;
 613:./lwip-2.1.2/src/core/tcp_out.c ****       }
 614:./lwip-2.1.2/src/core/tcp_out.c ****       LWIP_ASSERT("tcp_write: check that first pbuf can hold the complete seglen",
 615:./lwip-2.1.2/src/core/tcp_out.c ****                   (p->len >= seglen));
 616:./lwip-2.1.2/src/core/tcp_out.c ****       TCP_DATA_COPY2((char *)p->payload + optlen, (const u8_t *)arg + pos, seglen, &chksum, &chksum
 617:./lwip-2.1.2/src/core/tcp_out.c ****     } else {
 618:./lwip-2.1.2/src/core/tcp_out.c ****       /* Copy is not set: First allocate a pbuf for holding the data.
 619:./lwip-2.1.2/src/core/tcp_out.c ****        * Since the referenced data is available at least until it is
 620:./lwip-2.1.2/src/core/tcp_out.c ****        * sent out on the link (as it has to be ACKed by the remote
 621:./lwip-2.1.2/src/core/tcp_out.c ****        * party) we can safely use PBUF_ROM instead of PBUF_REF here.
 622:./lwip-2.1.2/src/core/tcp_out.c ****        */
 623:./lwip-2.1.2/src/core/tcp_out.c ****       struct pbuf *p2;
 624:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE
 625:./lwip-2.1.2/src/core/tcp_out.c ****       LWIP_ASSERT("oversize == 0", oversize == 0);
 626:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE */
 627:./lwip-2.1.2/src/core/tcp_out.c ****       if ((p2 = pbuf_alloc(PBUF_TRANSPORT, seglen, PBUF_ROM)) == NULL) {
 628:./lwip-2.1.2/src/core/tcp_out.c ****         LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_write: could not allocate memo
 629:./lwip-2.1.2/src/core/tcp_out.c ****         goto memerr;
 630:./lwip-2.1.2/src/core/tcp_out.c ****       }
 631:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 632:./lwip-2.1.2/src/core/tcp_out.c ****       /* calculate the checksum of nocopy-data */
 633:./lwip-2.1.2/src/core/tcp_out.c ****       chksum = ~inet_chksum((const u8_t *)arg + pos, seglen);
 634:./lwip-2.1.2/src/core/tcp_out.c ****       if (seglen & 1) {
 635:./lwip-2.1.2/src/core/tcp_out.c ****         chksum_swapped = 1;
 636:./lwip-2.1.2/src/core/tcp_out.c ****         chksum = SWAP_BYTES_IN_WORD(chksum);
 637:./lwip-2.1.2/src/core/tcp_out.c ****       }
 638:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 639:./lwip-2.1.2/src/core/tcp_out.c ****       /* reference the non-volatile payload data */
 640:./lwip-2.1.2/src/core/tcp_out.c ****       ((struct pbuf_rom *)p2)->payload = (const u8_t *)arg + pos;
 641:./lwip-2.1.2/src/core/tcp_out.c **** 
 642:./lwip-2.1.2/src/core/tcp_out.c ****       /* Second, allocate a pbuf for the headers. */
 643:./lwip-2.1.2/src/core/tcp_out.c ****       if ((p = pbuf_alloc(PBUF_TRANSPORT, optlen, PBUF_RAM)) == NULL) {
 644:./lwip-2.1.2/src/core/tcp_out.c ****         /* If allocation fails, we have to deallocate the data pbuf as
 645:./lwip-2.1.2/src/core/tcp_out.c ****          * well. */
 646:./lwip-2.1.2/src/core/tcp_out.c ****         pbuf_free(p2);
 647:./lwip-2.1.2/src/core/tcp_out.c ****         LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_write: could not allocate memo
 648:./lwip-2.1.2/src/core/tcp_out.c ****         goto memerr;
 649:./lwip-2.1.2/src/core/tcp_out.c ****       }
 650:./lwip-2.1.2/src/core/tcp_out.c ****       /* Concatenate the headers and data pbufs together. */
 651:./lwip-2.1.2/src/core/tcp_out.c ****       pbuf_cat(p/*header*/, p2/*data*/);
 652:./lwip-2.1.2/src/core/tcp_out.c ****     }
 653:./lwip-2.1.2/src/core/tcp_out.c **** 
 654:./lwip-2.1.2/src/core/tcp_out.c ****     queuelen += pbuf_clen(p);
 655:./lwip-2.1.2/src/core/tcp_out.c **** 
 656:./lwip-2.1.2/src/core/tcp_out.c ****     /* Now that there are more segments queued, we check again if the
 657:./lwip-2.1.2/src/core/tcp_out.c ****      * length of the queue exceeds the configured maximum or

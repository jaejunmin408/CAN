1193:./lwip-2.1.2/src/core/tcp_out.c **** tcp_build_sack_option(const struct tcp_pcb *pcb, u32_t *opts, u8_t num_sacks)
1194:./lwip-2.1.2/src/core/tcp_out.c **** {
1195:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t i;
1196:./lwip-2.1.2/src/core/tcp_out.c **** 
1197:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_build_sack_option: invalid pcb", pcb != NULL);
1198:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_build_sack_option: invalid opts", opts != NULL);
1199:./lwip-2.1.2/src/core/tcp_out.c **** 
1200:./lwip-2.1.2/src/core/tcp_out.c ****   /* Pad with two NOP options to make everything nicely aligned.
1201:./lwip-2.1.2/src/core/tcp_out.c ****      We add the length (of just the SACK option, not the NOPs in front of it),
1202:./lwip-2.1.2/src/core/tcp_out.c ****      which is 2B of header, plus 8B for each SACK. */

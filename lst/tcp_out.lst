1283:./lwip-2.1.2/src/core/tcp_out.c ****                 ("tcp_output: snd_wnd %"TCPWNDSIZE_F", cwnd %"TCPWNDSIZE_F", wnd %"U32_F
1284:./lwip-2.1.2/src/core/tcp_out.c ****                  ", effwnd %"U32_F", seq %"U32_F", ack %"U32_F"\n",
1285:./lwip-2.1.2/src/core/tcp_out.c ****                  pcb->snd_wnd, pcb->cwnd, wnd,
1286:./lwip-2.1.2/src/core/tcp_out.c ****                  lwip_ntohl(seg->tcphdr->seqno) - pcb->lastack + seg->len,
1287:./lwip-2.1.2/src/core/tcp_out.c ****                  lwip_ntohl(seg->tcphdr->seqno), pcb->lastack));
1288:./lwip-2.1.2/src/core/tcp_out.c ****   }
1289:./lwip-2.1.2/src/core/tcp_out.c **** 
1290:./lwip-2.1.2/src/core/tcp_out.c ****   netif = tcp_route(pcb, &pcb->local_ip, &pcb->remote_ip);
1291:./lwip-2.1.2/src/core/tcp_out.c ****   if (netif == NULL) {
1292:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_RTE;
1293:./lwip-2.1.2/src/core/tcp_out.c ****   }
1294:./lwip-2.1.2/src/core/tcp_out.c **** 
1295:./lwip-2.1.2/src/core/tcp_out.c ****   /* If we don't have a local IP address, we get one from netif */
1296:./lwip-2.1.2/src/core/tcp_out.c ****   if (ip_addr_isany(&pcb->local_ip)) {
1297:./lwip-2.1.2/src/core/tcp_out.c ****     const ip_addr_t *local_ip = ip_netif_get_local_ip(netif, &pcb->remote_ip);
1298:./lwip-2.1.2/src/core/tcp_out.c ****     if (local_ip == NULL) {
1299:./lwip-2.1.2/src/core/tcp_out.c ****       return ERR_RTE;
1300:./lwip-2.1.2/src/core/tcp_out.c ****     }
1301:./lwip-2.1.2/src/core/tcp_out.c ****     ip_addr_copy(pcb->local_ip, *local_ip);
1302:./lwip-2.1.2/src/core/tcp_out.c ****   }
1303:./lwip-2.1.2/src/core/tcp_out.c **** 
1304:./lwip-2.1.2/src/core/tcp_out.c ****   /* Handle the current segment not fitting within the window */
1305:./lwip-2.1.2/src/core/tcp_out.c ****   if (lwip_ntohl(seg->tcphdr->seqno) - pcb->lastack + seg->len > wnd) {
1306:./lwip-2.1.2/src/core/tcp_out.c ****     /* We need to start the persistent timer when the next unsent segment does not fit
1307:./lwip-2.1.2/src/core/tcp_out.c ****      * within the remaining (could be 0) send window and RTO timer is not running (we
1308:./lwip-2.1.2/src/core/tcp_out.c ****      * have no in-flight data). If window is still too small after persist timer fires,
1309:./lwip-2.1.2/src/core/tcp_out.c ****      * then we split the segment. We don't consider the congestion window since a cwnd
1310:./lwip-2.1.2/src/core/tcp_out.c ****      * smaller than 1 SMSS implies in-flight data
1311:./lwip-2.1.2/src/core/tcp_out.c ****      */
1312:./lwip-2.1.2/src/core/tcp_out.c ****     if (wnd == pcb->snd_wnd && pcb->unacked == NULL && pcb->persist_backoff == 0) {
1313:./lwip-2.1.2/src/core/tcp_out.c ****       pcb->persist_cnt = 0;
1314:./lwip-2.1.2/src/core/tcp_out.c ****       pcb->persist_backoff = 1;
1315:./lwip-2.1.2/src/core/tcp_out.c ****       pcb->persist_probe = 0;
1316:./lwip-2.1.2/src/core/tcp_out.c ****     }
1317:./lwip-2.1.2/src/core/tcp_out.c ****     /* We need an ACK, but can't send data now, so send an empty ACK */
1318:./lwip-2.1.2/src/core/tcp_out.c ****     if (pcb->flags & TF_ACK_NOW) {
1319:./lwip-2.1.2/src/core/tcp_out.c ****       return tcp_send_empty_ack(pcb);
1320:./lwip-2.1.2/src/core/tcp_out.c ****     }
1321:./lwip-2.1.2/src/core/tcp_out.c ****     goto output_done;
1322:./lwip-2.1.2/src/core/tcp_out.c ****   }
1323:./lwip-2.1.2/src/core/tcp_out.c ****   /* Stop persist timer, above conditions are not active */
1324:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->persist_backoff = 0;
1325:./lwip-2.1.2/src/core/tcp_out.c **** 
1326:./lwip-2.1.2/src/core/tcp_out.c ****   /* useg should point to last segment on unacked queue */
1327:./lwip-2.1.2/src/core/tcp_out.c ****   useg = pcb->unacked;
1328:./lwip-2.1.2/src/core/tcp_out.c ****   if (useg != NULL) {
1329:./lwip-2.1.2/src/core/tcp_out.c ****     for (; useg->next != NULL; useg = useg->next);
1330:./lwip-2.1.2/src/core/tcp_out.c ****   }
1331:./lwip-2.1.2/src/core/tcp_out.c ****   /* data available and window allows it to be sent? */
1332:./lwip-2.1.2/src/core/tcp_out.c ****   while (seg != NULL &&
1333:./lwip-2.1.2/src/core/tcp_out.c ****          lwip_ntohl(seg->tcphdr->seqno) - pcb->lastack + seg->len <= wnd) {
1334:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("RST not expected here!",
1335:./lwip-2.1.2/src/core/tcp_out.c ****                 (TCPH_FLAGS(seg->tcphdr) & TCP_RST) == 0);
1336:./lwip-2.1.2/src/core/tcp_out.c ****     /* Stop sending if the nagle algorithm would prevent it
1337:./lwip-2.1.2/src/core/tcp_out.c ****      * Don't stop:
1338:./lwip-2.1.2/src/core/tcp_out.c ****      * - if tcp_write had a memory error before (prevent delayed ACK timeout) or
1339:./lwip-2.1.2/src/core/tcp_out.c ****      * - if FIN was already enqueued for this PCB (SYN is always alone in a segment -
1340:./lwip-2.1.2/src/core/tcp_out.c ****      *   either seg->next != NULL or pcb->unacked == NULL;
1341:./lwip-2.1.2/src/core/tcp_out.c ****      *   RST is no sent using tcp_write/tcp_output.
1342:./lwip-2.1.2/src/core/tcp_out.c ****      */
1343:./lwip-2.1.2/src/core/tcp_out.c ****     if ((tcp_do_output_nagle(pcb) == 0) &&
1344:./lwip-2.1.2/src/core/tcp_out.c ****         ((pcb->flags & (TF_NAGLEMEMERR | TF_FIN)) == 0)) {
1345:./lwip-2.1.2/src/core/tcp_out.c ****       break;
1346:./lwip-2.1.2/src/core/tcp_out.c ****     }
1347:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CWND_DEBUG
1348:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_CWND_DEBUG, ("tcp_output: snd_wnd %"TCPWNDSIZE_F", cwnd %"TCPWNDSIZE_F", wnd %"
1349:./lwip-2.1.2/src/core/tcp_out.c ****                                  pcb->snd_wnd, pcb->cwnd, wnd,
1350:./lwip-2.1.2/src/core/tcp_out.c ****                                  lwip_ntohl(seg->tcphdr->seqno) + seg->len -
1351:./lwip-2.1.2/src/core/tcp_out.c ****                                  pcb->lastack,
1352:./lwip-2.1.2/src/core/tcp_out.c ****                                  lwip_ntohl(seg->tcphdr->seqno), pcb->lastack, i));
1353:./lwip-2.1.2/src/core/tcp_out.c ****     ++i;
1354:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CWND_DEBUG */
1355:./lwip-2.1.2/src/core/tcp_out.c **** 
1356:./lwip-2.1.2/src/core/tcp_out.c ****     if (pcb->state != SYN_SENT) {
1357:./lwip-2.1.2/src/core/tcp_out.c ****       TCPH_SET_FLAG(seg->tcphdr, TCP_ACK);
1358:./lwip-2.1.2/src/core/tcp_out.c ****     }
1359:./lwip-2.1.2/src/core/tcp_out.c **** 
1360:./lwip-2.1.2/src/core/tcp_out.c ****     err = tcp_output_segment(seg, pcb, netif);
1361:./lwip-2.1.2/src/core/tcp_out.c ****     if (err != ERR_OK) {

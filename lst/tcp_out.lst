1461:./lwip-2.1.2/src/core/tcp_out.c ****   int seg_chksum_was_swapped = 0;
1462:./lwip-2.1.2/src/core/tcp_out.c **** #endif
1463:./lwip-2.1.2/src/core/tcp_out.c **** 
1464:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_output_segment: invalid seg", seg != NULL);
1465:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_output_segment: invalid pcb", pcb != NULL);
1466:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_output_segment: invalid netif", netif != NULL);
1467:./lwip-2.1.2/src/core/tcp_out.c **** 
1468:./lwip-2.1.2/src/core/tcp_out.c ****   if (tcp_output_segment_busy(seg)) {
1469:./lwip-2.1.2/src/core/tcp_out.c ****     /* This should not happen: rexmit functions should have checked this.
1470:./lwip-2.1.2/src/core/tcp_out.c ****        However, since this function modifies p->len, we must not continue in this case. */
1471:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_RTO_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_output_segment: segment busy\n"));
1472:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_OK;
1473:./lwip-2.1.2/src/core/tcp_out.c ****   }
1474:./lwip-2.1.2/src/core/tcp_out.c **** 
1475:./lwip-2.1.2/src/core/tcp_out.c ****   /* The TCP header has already been constructed, but the ackno and
1476:./lwip-2.1.2/src/core/tcp_out.c ****    wnd fields remain. */
1477:./lwip-2.1.2/src/core/tcp_out.c ****   seg->tcphdr->ackno = lwip_htonl(pcb->rcv_nxt);
1478:./lwip-2.1.2/src/core/tcp_out.c **** 

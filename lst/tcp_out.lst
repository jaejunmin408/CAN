1163:./lwip-2.1.2/src/core/tcp_out.c **** {
1164:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t num_sacks = 0;
1165:./lwip-2.1.2/src/core/tcp_out.c **** 
1166:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_get_num_sacks: invalid pcb", pcb != NULL);
1167:./lwip-2.1.2/src/core/tcp_out.c **** 
1168:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->flags & TF_SACK) {

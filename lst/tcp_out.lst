 696:./lwip-2.1.2/src/core/tcp_out.c ****   /*
 697:./lwip-2.1.2/src/core/tcp_out.c ****    * All three segmentation phases were successful. We can commit the
 698:./lwip-2.1.2/src/core/tcp_out.c ****    * transaction.
 699:./lwip-2.1.2/src/core/tcp_out.c ****    */
 700:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
 701:./lwip-2.1.2/src/core/tcp_out.c ****   if ((last_unsent != NULL) && (oversize_add != 0)) {
 702:./lwip-2.1.2/src/core/tcp_out.c ****     last_unsent->oversize_left += oversize_add;
 703:./lwip-2.1.2/src/core/tcp_out.c ****   }
 704:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
 705:./lwip-2.1.2/src/core/tcp_out.c **** 
 706:./lwip-2.1.2/src/core/tcp_out.c ****   /*
 707:./lwip-2.1.2/src/core/tcp_out.c ****    * Phase 1: If data has been added to the preallocated tail of
 708:./lwip-2.1.2/src/core/tcp_out.c ****    * last_unsent, we update the length fields of the pbuf chain.
 709:./lwip-2.1.2/src/core/tcp_out.c ****    */
 710:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE
 711:./lwip-2.1.2/src/core/tcp_out.c ****   if (oversize_used > 0) {
 712:./lwip-2.1.2/src/core/tcp_out.c ****     struct pbuf *p;
 713:./lwip-2.1.2/src/core/tcp_out.c ****     /* Bump tot_len of whole chain, len of tail */
 714:./lwip-2.1.2/src/core/tcp_out.c ****     for (p = last_unsent->p; p; p = p->next) {
 715:./lwip-2.1.2/src/core/tcp_out.c ****       p->tot_len += oversize_used;
 716:./lwip-2.1.2/src/core/tcp_out.c ****       if (p->next == NULL) {
 717:./lwip-2.1.2/src/core/tcp_out.c ****         TCP_DATA_COPY((char *)p->payload + p->len, arg, oversize_used, last_unsent);
 718:./lwip-2.1.2/src/core/tcp_out.c ****         p->len += oversize_used;
 719:./lwip-2.1.2/src/core/tcp_out.c ****       }
 720:./lwip-2.1.2/src/core/tcp_out.c ****     }
 721:./lwip-2.1.2/src/core/tcp_out.c ****     last_unsent->len += oversize_used;
 722:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
 723:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("last_unsent->oversize_left >= oversize_used",
 724:./lwip-2.1.2/src/core/tcp_out.c ****                 last_unsent->oversize_left >= oversize_used);
 725:./lwip-2.1.2/src/core/tcp_out.c ****     last_unsent->oversize_left -= oversize_used;
 726:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
 727:./lwip-2.1.2/src/core/tcp_out.c ****   }
 728:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->unsent_oversize = oversize;
 729:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE */
 730:./lwip-2.1.2/src/core/tcp_out.c **** 
 731:./lwip-2.1.2/src/core/tcp_out.c ****   /*
 732:./lwip-2.1.2/src/core/tcp_out.c ****    * Phase 2: concat_p can be concatenated onto last_unsent->p, unless we
 733:./lwip-2.1.2/src/core/tcp_out.c ****    * determined that the last ROM pbuf can be extended to include the new data.
 734:./lwip-2.1.2/src/core/tcp_out.c ****    */
 735:./lwip-2.1.2/src/core/tcp_out.c ****   if (concat_p != NULL) {
 736:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("tcp_write: cannot concatenate when pcb->unsent is empty",
 737:./lwip-2.1.2/src/core/tcp_out.c ****                 (last_unsent != NULL));
 738:./lwip-2.1.2/src/core/tcp_out.c ****     pbuf_cat(last_unsent->p, concat_p);
 739:./lwip-2.1.2/src/core/tcp_out.c ****     last_unsent->len += concat_p->tot_len;
 740:./lwip-2.1.2/src/core/tcp_out.c ****   } else if (extendlen > 0) {
 741:./lwip-2.1.2/src/core/tcp_out.c ****     struct pbuf *p;
 742:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("tcp_write: extension of reference requires reference",
 743:./lwip-2.1.2/src/core/tcp_out.c ****                 last_unsent != NULL && last_unsent->p != NULL);
 744:./lwip-2.1.2/src/core/tcp_out.c ****     for (p = last_unsent->p; p->next != NULL; p = p->next) {
 745:./lwip-2.1.2/src/core/tcp_out.c ****       p->tot_len += extendlen;
 746:./lwip-2.1.2/src/core/tcp_out.c ****     }
 747:./lwip-2.1.2/src/core/tcp_out.c ****     p->tot_len += extendlen;
 748:./lwip-2.1.2/src/core/tcp_out.c ****     p->len += extendlen;
 749:./lwip-2.1.2/src/core/tcp_out.c ****     last_unsent->len += extendlen;
 750:./lwip-2.1.2/src/core/tcp_out.c ****   }
 751:./lwip-2.1.2/src/core/tcp_out.c **** 
 752:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY

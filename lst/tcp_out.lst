 130:./lwip-2.1.2/src/core/tcp_out.c **** /* tcp_route: common code that returns a fixed bound netif or calls ip_route */
 131:./lwip-2.1.2/src/core/tcp_out.c **** static struct netif *
 132:./lwip-2.1.2/src/core/tcp_out.c **** tcp_route(const struct tcp_pcb *pcb, const ip_addr_t *src, const ip_addr_t *dst)
 133:./lwip-2.1.2/src/core/tcp_out.c **** {
 134:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_UNUSED_ARG(src); /* in case IPv4-only and source-based routing is disabled */
 135:./lwip-2.1.2/src/core/tcp_out.c **** 
 136:./lwip-2.1.2/src/core/tcp_out.c ****   if ((pcb != NULL) && (pcb->netif_idx != NETIF_NO_INDEX)) {
 137:./lwip-2.1.2/src/core/tcp_out.c ****     return netif_get_by_index(pcb->netif_idx);
 138:./lwip-2.1.2/src/core/tcp_out.c ****   } else {
 139:./lwip-2.1.2/src/core/tcp_out.c ****     return ip_route(src, dst);
 140:./lwip-2.1.2/src/core/tcp_out.c ****   }
 141:./lwip-2.1.2/src/core/tcp_out.c **** }

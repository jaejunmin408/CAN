 676:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 677:./lwip-2.1.2/src/core/tcp_out.c **** 
 678:./lwip-2.1.2/src/core/tcp_out.c ****     /* first segment of to-be-queued data? */
 679:./lwip-2.1.2/src/core/tcp_out.c ****     if (queue == NULL) {
 680:./lwip-2.1.2/src/core/tcp_out.c ****       queue = seg;
 681:./lwip-2.1.2/src/core/tcp_out.c ****     } else {

1394:./lwip-2.1.2/src/core/tcp_out.c ****             cur_seg = &((*cur_seg)->next );
1395:./lwip-2.1.2/src/core/tcp_out.c ****           }
1396:./lwip-2.1.2/src/core/tcp_out.c ****           seg->next = (*cur_seg);
1397:./lwip-2.1.2/src/core/tcp_out.c ****           (*cur_seg) = seg;
1398:./lwip-2.1.2/src/core/tcp_out.c ****         } else {
1399:./lwip-2.1.2/src/core/tcp_out.c ****           /* add segment to tail of unacked list */

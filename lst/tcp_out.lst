1365:./lwip-2.1.2/src/core/tcp_out.c ****     }
1366:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
1367:./lwip-2.1.2/src/core/tcp_out.c ****     seg->oversize_left = 0;
1368:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
1369:./lwip-2.1.2/src/core/tcp_out.c ****     pcb->unsent = seg->next;
1370:./lwip-2.1.2/src/core/tcp_out.c ****     if (pcb->state != SYN_SENT) {
1371:./lwip-2.1.2/src/core/tcp_out.c ****       tcp_clear_flags(pcb, TF_ACK_DELAY | TF_ACK_NOW);
1372:./lwip-2.1.2/src/core/tcp_out.c ****     }
1373:./lwip-2.1.2/src/core/tcp_out.c ****     snd_nxt = lwip_ntohl(seg->tcphdr->seqno) + TCP_TCPLEN(seg);
1374:./lwip-2.1.2/src/core/tcp_out.c ****     if (TCP_SEQ_LT(pcb->snd_nxt, snd_nxt)) {

1489:./lwip-2.1.2/src/core/tcp_out.c ****   }
1490:./lwip-2.1.2/src/core/tcp_out.c **** 
1491:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->rcv_ann_right_edge = pcb->rcv_nxt + pcb->rcv_ann_wnd;
1492:./lwip-2.1.2/src/core/tcp_out.c **** 
1493:./lwip-2.1.2/src/core/tcp_out.c ****   /* Add any requested options.  NB MSS option is only set on SYN
1494:./lwip-2.1.2/src/core/tcp_out.c ****      packets, so ignore it here */
1495:./lwip-2.1.2/src/core/tcp_out.c ****   /* cast through void* to get rid of alignment warnings */
1496:./lwip-2.1.2/src/core/tcp_out.c ****   opts = (u32_t *)(void *)(seg->tcphdr + 1);
1497:./lwip-2.1.2/src/core/tcp_out.c ****   if (seg->flags & TF_SEG_OPTS_MSS) {
1498:./lwip-2.1.2/src/core/tcp_out.c ****     u16_t mss;

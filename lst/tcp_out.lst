1670:./lwip-2.1.2/src/core/tcp_out.c ****   /* Record the next byte following retransmit */
1671:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->rto_end = lwip_ntohl(seg->tcphdr->seqno) + TCP_TCPLEN(seg);
1672:./lwip-2.1.2/src/core/tcp_out.c ****   /* Don't take any RTT measurements after retransmitting. */
1673:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->rttest = 0;
1674:./lwip-2.1.2/src/core/tcp_out.c **** 
1675:./lwip-2.1.2/src/core/tcp_out.c ****   return ERR_OK;
1676:./lwip-2.1.2/src/core/tcp_out.c **** }

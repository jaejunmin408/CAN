 659:./lwip-2.1.2/src/core/tcp_out.c ****     if (queuelen > LWIP_MIN(TCP_SND_QUEUELEN, TCP_SNDQUEUELEN_OVERFLOW)) {
 660:./lwip-2.1.2/src/core/tcp_out.c ****       LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_write: queue too long %"U16_F" (
 661:./lwip-2.1.2/src/core/tcp_out.c ****                   queuelen, (int)TCP_SND_QUEUELEN));
 662:./lwip-2.1.2/src/core/tcp_out.c ****       pbuf_free(p);
 663:./lwip-2.1.2/src/core/tcp_out.c ****       goto memerr;
 664:./lwip-2.1.2/src/core/tcp_out.c ****     }
 665:./lwip-2.1.2/src/core/tcp_out.c **** 
 666:./lwip-2.1.2/src/core/tcp_out.c ****     if ((seg = tcp_create_segment(pcb, p, 0, pcb->snd_lbb + pos, optflags)) == NULL) {
 667:./lwip-2.1.2/src/core/tcp_out.c ****       goto memerr;
 668:./lwip-2.1.2/src/core/tcp_out.c ****     }

 298:./lwip-2.1.2/src/core/tcp_out.c **** /** Checks if tcp_write is allowed or not (checks state, snd_buf and snd_queuelen).
 299:./lwip-2.1.2/src/core/tcp_out.c ****  *
 300:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb the tcp pcb to check for
 301:./lwip-2.1.2/src/core/tcp_out.c ****  * @param len length of data to send (checked agains snd_buf)
 302:./lwip-2.1.2/src/core/tcp_out.c ****  * @return ERR_OK if tcp_write is allowed to proceed, another err_t otherwise
 303:./lwip-2.1.2/src/core/tcp_out.c ****  */
 304:./lwip-2.1.2/src/core/tcp_out.c **** static err_t
 305:./lwip-2.1.2/src/core/tcp_out.c **** tcp_write_checks(struct tcp_pcb *pcb, u16_t len)
 306:./lwip-2.1.2/src/core/tcp_out.c **** {
 307:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_write_checks: invalid pcb", pcb != NULL);
 308:./lwip-2.1.2/src/core/tcp_out.c **** 
 309:./lwip-2.1.2/src/core/tcp_out.c ****   /* connection is in invalid state for data transmission? */
 310:./lwip-2.1.2/src/core/tcp_out.c ****   if ((pcb->state != ESTABLISHED) &&
 311:./lwip-2.1.2/src/core/tcp_out.c ****       (pcb->state != CLOSE_WAIT) &&
 312:./lwip-2.1.2/src/core/tcp_out.c ****       (pcb->state != SYN_SENT) &&
 313:./lwip-2.1.2/src/core/tcp_out.c ****       (pcb->state != SYN_RCVD)) {
 314:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_STATE | LWIP_DBG_LEVEL_SEVERE, ("tcp_write() called in 
 315:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_CONN;
 316:./lwip-2.1.2/src/core/tcp_out.c ****   } else if (len == 0) {
 317:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_OK;
 318:./lwip-2.1.2/src/core/tcp_out.c ****   }
 319:./lwip-2.1.2/src/core/tcp_out.c **** 
 320:./lwip-2.1.2/src/core/tcp_out.c ****   /* fail on too much data */
 321:./lwip-2.1.2/src/core/tcp_out.c ****   if (len > pcb->snd_buf) {
 322:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SEVERE, ("tcp_write: too much data (len=%"U16_F" 
 323:./lwip-2.1.2/src/core/tcp_out.c ****                 len, pcb->snd_buf));
 324:./lwip-2.1.2/src/core/tcp_out.c ****     tcp_set_flags(pcb, TF_NAGLEMEMERR);
 325:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_MEM;
 326:./lwip-2.1.2/src/core/tcp_out.c ****   }
 327:./lwip-2.1.2/src/core/tcp_out.c **** 
 328:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_DEBUGF(TCP_QLEN_DEBUG, ("tcp_write: queuelen: %"TCPWNDSIZE_F"\n", (tcpwnd_size_t)pcb->snd_qu
 329:./lwip-2.1.2/src/core/tcp_out.c **** 
 330:./lwip-2.1.2/src/core/tcp_out.c ****   /* If total number of pbufs on the unsent/unacked queues exceeds the
 331:./lwip-2.1.2/src/core/tcp_out.c ****    * configured maximum, return an error */
 332:./lwip-2.1.2/src/core/tcp_out.c ****   /* check for configured max queuelen and possible overflow */
 333:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->snd_queuelen >= LWIP_MIN(TCP_SND_QUEUELEN, (TCP_SNDQUEUELEN_OVERFLOW + 1))) {
 334:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SEVERE, ("tcp_write: too long queue %"U16_F" (max
 335:./lwip-2.1.2/src/core/tcp_out.c ****                 pcb->snd_queuelen, (u16_t)TCP_SND_QUEUELEN));
 336:./lwip-2.1.2/src/core/tcp_out.c ****     TCP_STATS_INC(tcp.memerr);
 337:./lwip-2.1.2/src/core/tcp_out.c ****     tcp_set_flags(pcb, TF_NAGLEMEMERR);
 338:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_MEM;
 339:./lwip-2.1.2/src/core/tcp_out.c ****   }
 340:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->snd_queuelen != 0) {
 341:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("tcp_write: pbufs on queue => at least one queue non-empty",
 342:./lwip-2.1.2/src/core/tcp_out.c ****                 pcb->unacked != NULL || pcb->unsent != NULL);
 343:./lwip-2.1.2/src/core/tcp_out.c ****   } else {
 344:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("tcp_write: no pbufs on queue => both queues empty",
 345:./lwip-2.1.2/src/core/tcp_out.c ****                 pcb->unacked == NULL && pcb->unsent == NULL);
 346:./lwip-2.1.2/src/core/tcp_out.c ****   }
 347:./lwip-2.1.2/src/core/tcp_out.c ****   return ERR_OK;
 348:./lwip-2.1.2/src/core/tcp_out.c **** }

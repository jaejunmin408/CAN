1646:./lwip-2.1.2/src/core/tcp_out.c ****     if (tcp_output_segment_busy(seg)) {
1647:./lwip-2.1.2/src/core/tcp_out.c ****       LWIP_DEBUGF(TCP_RTO_DEBUG, ("tcp_rexmit_rto: segment busy\n"));
1648:./lwip-2.1.2/src/core/tcp_out.c ****       return ERR_VAL;
1649:./lwip-2.1.2/src/core/tcp_out.c ****     }
1650:./lwip-2.1.2/src/core/tcp_out.c ****   }
1651:./lwip-2.1.2/src/core/tcp_out.c ****   if (tcp_output_segment_busy(seg)) {
1652:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_RTO_DEBUG, ("tcp_rexmit_rto: segment busy\n"));
1653:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
1654:./lwip-2.1.2/src/core/tcp_out.c ****   }
1655:./lwip-2.1.2/src/core/tcp_out.c ****   /* concatenate unsent queue after unacked queue */

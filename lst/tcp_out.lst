1383:./lwip-2.1.2/src/core/tcp_out.c ****         useg = seg;
1384:./lwip-2.1.2/src/core/tcp_out.c ****         /* unacked list is not empty? */
1385:./lwip-2.1.2/src/core/tcp_out.c ****       } else {

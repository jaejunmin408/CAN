1001:./lwip-2.1.2/src/core/tcp_out.c **** tcp_send_fin(struct tcp_pcb *pcb)
1002:./lwip-2.1.2/src/core/tcp_out.c **** {
1003:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_send_fin: invalid pcb", pcb != NULL);
1004:./lwip-2.1.2/src/core/tcp_out.c **** 
1005:./lwip-2.1.2/src/core/tcp_out.c ****   /* first, try to add the fin to the last unsent segment */
1006:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->unsent != NULL) {
1007:./lwip-2.1.2/src/core/tcp_out.c ****     struct tcp_seg *last_unsent;
1008:./lwip-2.1.2/src/core/tcp_out.c ****     for (last_unsent = pcb->unsent; last_unsent->next != NULL;
1009:./lwip-2.1.2/src/core/tcp_out.c ****          last_unsent = last_unsent->next);
1010:./lwip-2.1.2/src/core/tcp_out.c **** 
1011:./lwip-2.1.2/src/core/tcp_out.c ****     if ((TCPH_FLAGS(last_unsent->tcphdr) & (TCP_SYN | TCP_FIN | TCP_RST)) == 0) {
1012:./lwip-2.1.2/src/core/tcp_out.c ****       /* no SYN/FIN/RST flag in the header, we can add the FIN flag */
1013:./lwip-2.1.2/src/core/tcp_out.c ****       TCPH_SET_FLAG(last_unsent->tcphdr, TCP_FIN);
1014:./lwip-2.1.2/src/core/tcp_out.c ****       tcp_set_flags(pcb, TF_FIN);
1015:./lwip-2.1.2/src/core/tcp_out.c ****       return ERR_OK;
1016:./lwip-2.1.2/src/core/tcp_out.c ****     }
1017:./lwip-2.1.2/src/core/tcp_out.c ****   }
1018:./lwip-2.1.2/src/core/tcp_out.c ****   /* no data, no length, flags, copy=1, no optdata */
1019:./lwip-2.1.2/src/core/tcp_out.c ****   return tcp_enqueue_flags(pcb, TCP_FIN);
1020:./lwip-2.1.2/src/core/tcp_out.c **** }

1401:./lwip-2.1.2/src/core/tcp_out.c ****           useg = useg->next;
1402:./lwip-2.1.2/src/core/tcp_out.c ****         }
1403:./lwip-2.1.2/src/core/tcp_out.c ****       }
1404:./lwip-2.1.2/src/core/tcp_out.c ****       /* do not queue empty segments on the unacked list */
1405:./lwip-2.1.2/src/core/tcp_out.c ****     } else {

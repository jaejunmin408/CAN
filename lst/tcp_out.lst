1716:./lwip-2.1.2/src/core/tcp_out.c **** /**
1717:./lwip-2.1.2/src/core/tcp_out.c ****  * Requeue the first unacked segment for retransmission
1718:./lwip-2.1.2/src/core/tcp_out.c ****  *
1719:./lwip-2.1.2/src/core/tcp_out.c ****  * Called by tcp_receive() for fast retransmit.
1720:./lwip-2.1.2/src/core/tcp_out.c ****  *
1721:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb the tcp_pcb for which to retransmit the first unacked segment
1722:./lwip-2.1.2/src/core/tcp_out.c ****  */
1723:./lwip-2.1.2/src/core/tcp_out.c **** err_t
1724:./lwip-2.1.2/src/core/tcp_out.c **** tcp_rexmit(struct tcp_pcb *pcb)
1725:./lwip-2.1.2/src/core/tcp_out.c **** {
1726:./lwip-2.1.2/src/core/tcp_out.c ****   struct tcp_seg *seg;
1727:./lwip-2.1.2/src/core/tcp_out.c ****   struct tcp_seg **cur_seg;
1728:./lwip-2.1.2/src/core/tcp_out.c **** 
1729:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_rexmit: invalid pcb", pcb != NULL);
1730:./lwip-2.1.2/src/core/tcp_out.c **** 
1731:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->unacked == NULL) {
1732:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
1733:./lwip-2.1.2/src/core/tcp_out.c ****   }
1734:./lwip-2.1.2/src/core/tcp_out.c **** 
1735:./lwip-2.1.2/src/core/tcp_out.c ****   seg = pcb->unacked;
1736:./lwip-2.1.2/src/core/tcp_out.c **** 
1737:./lwip-2.1.2/src/core/tcp_out.c ****   /* Give up if the segment is still referenced by the netif driver
1738:./lwip-2.1.2/src/core/tcp_out.c ****      due to deferred transmission. */
1739:./lwip-2.1.2/src/core/tcp_out.c ****   if (tcp_output_segment_busy(seg)) {
1740:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_RTO_DEBUG, ("tcp_rexmit busy\n"));
1741:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
1742:./lwip-2.1.2/src/core/tcp_out.c ****   }
1743:./lwip-2.1.2/src/core/tcp_out.c **** 
1744:./lwip-2.1.2/src/core/tcp_out.c ****   /* Move the first unacked segment to the unsent queue */
1745:./lwip-2.1.2/src/core/tcp_out.c ****   /* Keep the unsent queue sorted. */
1746:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->unacked = seg->next;
1747:./lwip-2.1.2/src/core/tcp_out.c **** 
1748:./lwip-2.1.2/src/core/tcp_out.c ****   cur_seg = &(pcb->unsent);
1749:./lwip-2.1.2/src/core/tcp_out.c ****   while (*cur_seg &&
1750:./lwip-2.1.2/src/core/tcp_out.c ****          TCP_SEQ_LT(lwip_ntohl((*cur_seg)->tcphdr->seqno), lwip_ntohl(seg->tcphdr->seqno))) {
1751:./lwip-2.1.2/src/core/tcp_out.c ****     cur_seg = &((*cur_seg)->next );
1752:./lwip-2.1.2/src/core/tcp_out.c ****   }
1753:./lwip-2.1.2/src/core/tcp_out.c ****   seg->next = *cur_seg;
1754:./lwip-2.1.2/src/core/tcp_out.c ****   *cur_seg = seg;
1755:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE
1756:./lwip-2.1.2/src/core/tcp_out.c ****   if (seg->next == NULL) {
1757:./lwip-2.1.2/src/core/tcp_out.c ****     /* the retransmitted segment is last in unsent, so reset unsent_oversize */
1758:./lwip-2.1.2/src/core/tcp_out.c ****     pcb->unsent_oversize = 0;
1759:./lwip-2.1.2/src/core/tcp_out.c ****   }
1760:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE */
1761:./lwip-2.1.2/src/core/tcp_out.c **** 
1762:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->nrtx < 0xFF) {
1763:./lwip-2.1.2/src/core/tcp_out.c ****     ++pcb->nrtx;
1764:./lwip-2.1.2/src/core/tcp_out.c ****   }
1765:./lwip-2.1.2/src/core/tcp_out.c **** 
1766:./lwip-2.1.2/src/core/tcp_out.c ****   /* Don't take any rtt measurements after retransmitting. */
1767:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->rttest = 0;
1768:./lwip-2.1.2/src/core/tcp_out.c **** 
1769:./lwip-2.1.2/src/core/tcp_out.c ****   /* Do the actual retransmission. */
1770:./lwip-2.1.2/src/core/tcp_out.c ****   MIB2_STATS_INC(mib2.tcpretranssegs);
1771:./lwip-2.1.2/src/core/tcp_out.c ****   /* No need to call tcp_output: we are always called from tcp_input()
1772:./lwip-2.1.2/src/core/tcp_out.c ****      and thus tcp_output directly returns. */
1773:./lwip-2.1.2/src/core/tcp_out.c ****   return ERR_OK;
1774:./lwip-2.1.2/src/core/tcp_out.c **** }

1171:./lwip-2.1.2/src/core/tcp_out.c ****     /* The first SACK takes up 12 bytes (it includes SACK header and two NOP options),
1172:./lwip-2.1.2/src/core/tcp_out.c ****        each additional one - 8 bytes. */

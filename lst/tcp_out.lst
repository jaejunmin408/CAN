1638:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
1639:./lwip-2.1.2/src/core/tcp_out.c ****   }
1640:./lwip-2.1.2/src/core/tcp_out.c **** 
1641:./lwip-2.1.2/src/core/tcp_out.c ****   /* Move all unacked segments to the head of the unsent queue.
1642:./lwip-2.1.2/src/core/tcp_out.c ****      However, give up if any of the unsent pbufs are still referenced by the
1643:./lwip-2.1.2/src/core/tcp_out.c ****      netif driver due to deferred transmission. No point loading the link further
1644:./lwip-2.1.2/src/core/tcp_out.c ****      if it is struggling to flush its buffered writes. */
1645:./lwip-2.1.2/src/core/tcp_out.c ****   for (seg = pcb->unacked; seg->next != NULL; seg = seg->next) {
1646:./lwip-2.1.2/src/core/tcp_out.c ****     if (tcp_output_segment_busy(seg)) {
1647:./lwip-2.1.2/src/core/tcp_out.c ****       LWIP_DEBUGF(TCP_RTO_DEBUG, ("tcp_rexmit_rto: segment busy\n"));
1648:./lwip-2.1.2/src/core/tcp_out.c ****       return ERR_VAL;
1649:./lwip-2.1.2/src/core/tcp_out.c ****     }
1650:./lwip-2.1.2/src/core/tcp_out.c ****   }
1651:./lwip-2.1.2/src/core/tcp_out.c ****   if (tcp_output_segment_busy(seg)) {
1652:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_RTO_DEBUG, ("tcp_rexmit_rto: segment busy\n"));
1653:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
1654:./lwip-2.1.2/src/core/tcp_out.c ****   }
1655:./lwip-2.1.2/src/core/tcp_out.c ****   /* concatenate unsent queue after unacked queue */
1656:./lwip-2.1.2/src/core/tcp_out.c ****   seg->next = pcb->unsent;
1657:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
1658:./lwip-2.1.2/src/core/tcp_out.c ****   /* if last unsent changed, we need to update unsent_oversize */
1659:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->unsent == NULL) {
1660:./lwip-2.1.2/src/core/tcp_out.c ****     pcb->unsent_oversize = seg->oversize_left;
1661:./lwip-2.1.2/src/core/tcp_out.c ****   }
1662:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
1663:./lwip-2.1.2/src/core/tcp_out.c ****   /* unsent queue is the concatenated queue (of unacked, unsent) */
1664:./lwip-2.1.2/src/core/tcp_out.c ****   pcb->unsent = pcb->unacked;

1777:./lwip-2.1.2/src/core/tcp_out.c **** /**
1778:./lwip-2.1.2/src/core/tcp_out.c ****  * Handle retransmission after three dupacks received
1779:./lwip-2.1.2/src/core/tcp_out.c ****  *
1780:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb the tcp_pcb for which to retransmit the first unacked segment
1781:./lwip-2.1.2/src/core/tcp_out.c ****  */
1782:./lwip-2.1.2/src/core/tcp_out.c **** void
1783:./lwip-2.1.2/src/core/tcp_out.c **** tcp_rexmit_fast(struct tcp_pcb *pcb)
1784:./lwip-2.1.2/src/core/tcp_out.c **** {
1785:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_rexmit_fast: invalid pcb", pcb != NULL);
1786:./lwip-2.1.2/src/core/tcp_out.c **** 
1787:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->unacked != NULL && !(pcb->flags & TF_INFR)) {
1788:./lwip-2.1.2/src/core/tcp_out.c ****     /* This is fast retransmit. Retransmit the first unacked segment. */
1789:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_FR_DEBUG,
1790:./lwip-2.1.2/src/core/tcp_out.c ****                 ("tcp_receive: dupacks %"U16_F" (%"U32_F
1791:./lwip-2.1.2/src/core/tcp_out.c ****                  "), fast retransmit %"U32_F"\n",
1792:./lwip-2.1.2/src/core/tcp_out.c ****                  (u16_t)pcb->dupacks, pcb->lastack,
1793:./lwip-2.1.2/src/core/tcp_out.c ****                  lwip_ntohl(pcb->unacked->tcphdr->seqno)));
1794:./lwip-2.1.2/src/core/tcp_out.c ****     if (tcp_rexmit(pcb) == ERR_OK) {
1795:./lwip-2.1.2/src/core/tcp_out.c ****       /* Set ssthresh to half of the minimum of the current
1796:./lwip-2.1.2/src/core/tcp_out.c ****        * cwnd and the advertised window */
1797:./lwip-2.1.2/src/core/tcp_out.c ****       pcb->ssthresh = LWIP_MIN(pcb->cwnd, pcb->snd_wnd) / 2;
1798:./lwip-2.1.2/src/core/tcp_out.c **** 
1799:./lwip-2.1.2/src/core/tcp_out.c ****       /* The minimum value for ssthresh should be 2 MSS */
1800:./lwip-2.1.2/src/core/tcp_out.c ****       if (pcb->ssthresh < (2U * pcb->mss)) {
1801:./lwip-2.1.2/src/core/tcp_out.c ****         LWIP_DEBUGF(TCP_FR_DEBUG,
1802:./lwip-2.1.2/src/core/tcp_out.c ****                     ("tcp_receive: The minimum value for ssthresh %"TCPWNDSIZE_F
1803:./lwip-2.1.2/src/core/tcp_out.c ****                      " should be min 2 mss %"U16_F"...\n",
1804:./lwip-2.1.2/src/core/tcp_out.c ****                      pcb->ssthresh, (u16_t)(2 * pcb->mss)));
1805:./lwip-2.1.2/src/core/tcp_out.c ****         pcb->ssthresh = 2 * pcb->mss;
1806:./lwip-2.1.2/src/core/tcp_out.c ****       }
1807:./lwip-2.1.2/src/core/tcp_out.c **** 
1808:./lwip-2.1.2/src/core/tcp_out.c ****       pcb->cwnd = pcb->ssthresh + 3 * pcb->mss;
1809:./lwip-2.1.2/src/core/tcp_out.c ****       tcp_set_flags(pcb, TF_INFR);
1810:./lwip-2.1.2/src/core/tcp_out.c **** 
1811:./lwip-2.1.2/src/core/tcp_out.c ****       /* Reset the retransmission timer to prevent immediate rto retransmissions */
1812:./lwip-2.1.2/src/core/tcp_out.c ****       pcb->rtime = 0;
1813:./lwip-2.1.2/src/core/tcp_out.c ****     }
1814:./lwip-2.1.2/src/core/tcp_out.c ****   }
1815:./lwip-2.1.2/src/core/tcp_out.c **** }

 670:./lwip-2.1.2/src/core/tcp_out.c ****     seg->oversize_left = oversize;
 671:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
 672:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 673:./lwip-2.1.2/src/core/tcp_out.c ****     seg->chksum = chksum;
 674:./lwip-2.1.2/src/core/tcp_out.c ****     seg->chksum_swapped = chksum_swapped;

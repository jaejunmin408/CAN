 143:./lwip-2.1.2/src/core/tcp_out.c **** /**
 144:./lwip-2.1.2/src/core/tcp_out.c ****  * Create a TCP segment with prefilled header.
 145:./lwip-2.1.2/src/core/tcp_out.c ****  *
 146:./lwip-2.1.2/src/core/tcp_out.c ****  * Called by @ref tcp_write, @ref tcp_enqueue_flags and @ref tcp_split_unsent_seg
 147:./lwip-2.1.2/src/core/tcp_out.c ****  *
 148:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb Protocol control block for the TCP connection.
 149:./lwip-2.1.2/src/core/tcp_out.c ****  * @param p pbuf that is used to hold the TCP header.
 150:./lwip-2.1.2/src/core/tcp_out.c ****  * @param hdrflags TCP flags for header.
 151:./lwip-2.1.2/src/core/tcp_out.c ****  * @param seqno TCP sequence number of this packet
 152:./lwip-2.1.2/src/core/tcp_out.c ****  * @param optflags options to include in TCP header
 153:./lwip-2.1.2/src/core/tcp_out.c ****  * @return a new tcp_seg pointing to p, or NULL.
 154:./lwip-2.1.2/src/core/tcp_out.c ****  * The TCP header is filled in except ackno and wnd.
 155:./lwip-2.1.2/src/core/tcp_out.c ****  * p is freed on failure.
 156:./lwip-2.1.2/src/core/tcp_out.c ****  */
 157:./lwip-2.1.2/src/core/tcp_out.c **** static struct tcp_seg *
 158:./lwip-2.1.2/src/core/tcp_out.c **** tcp_create_segment(const struct tcp_pcb *pcb, struct pbuf *p, u8_t hdrflags, u32_t seqno, u8_t optf
 159:./lwip-2.1.2/src/core/tcp_out.c **** {
 160:./lwip-2.1.2/src/core/tcp_out.c ****   struct tcp_seg *seg;
 161:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optlen;
 162:./lwip-2.1.2/src/core/tcp_out.c **** 
 163:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_create_segment: invalid pcb", pcb != NULL);
 164:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_create_segment: invalid pbuf", p != NULL);
 165:./lwip-2.1.2/src/core/tcp_out.c **** 
 166:./lwip-2.1.2/src/core/tcp_out.c ****   optlen = LWIP_TCP_OPT_LENGTH_SEGMENT(optflags, pcb);
 167:./lwip-2.1.2/src/core/tcp_out.c **** 
 168:./lwip-2.1.2/src/core/tcp_out.c ****   if ((seg = (struct tcp_seg *)memp_malloc(MEMP_TCP_SEG)) == NULL) {
 169:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_create_segment: no memory.\n"));
 170:./lwip-2.1.2/src/core/tcp_out.c ****     pbuf_free(p);
 171:./lwip-2.1.2/src/core/tcp_out.c ****     return NULL;
 172:./lwip-2.1.2/src/core/tcp_out.c ****   }
 173:./lwip-2.1.2/src/core/tcp_out.c ****   seg->flags = optflags;
 174:./lwip-2.1.2/src/core/tcp_out.c ****   seg->next = NULL;
 175:./lwip-2.1.2/src/core/tcp_out.c ****   seg->p = p;
 176:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("p->tot_len >= optlen", p->tot_len >= optlen);
 177:./lwip-2.1.2/src/core/tcp_out.c ****   seg->len = p->tot_len - optlen;
 178:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE_DBGCHECK
 179:./lwip-2.1.2/src/core/tcp_out.c ****   seg->oversize_left = 0;
 180:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_OVERSIZE_DBGCHECK */
 181:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 182:./lwip-2.1.2/src/core/tcp_out.c ****   seg->chksum = 0;
 183:./lwip-2.1.2/src/core/tcp_out.c ****   seg->chksum_swapped = 0;
 184:./lwip-2.1.2/src/core/tcp_out.c ****   /* check optflags */
 185:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("invalid optflags passed: TF_SEG_DATA_CHECKSUMMED",
 186:./lwip-2.1.2/src/core/tcp_out.c ****               (optflags & TF_SEG_DATA_CHECKSUMMED) == 0);
 187:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 188:./lwip-2.1.2/src/core/tcp_out.c **** 
 189:./lwip-2.1.2/src/core/tcp_out.c ****   /* build TCP header */
 190:./lwip-2.1.2/src/core/tcp_out.c ****   if (pbuf_add_header(p, TCP_HLEN)) {
 191:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_DEBUGF(TCP_OUTPUT_DEBUG | LWIP_DBG_LEVEL_SERIOUS, ("tcp_create_segment: no room for TCP he
 192:./lwip-2.1.2/src/core/tcp_out.c ****     TCP_STATS_INC(tcp.err);
 193:./lwip-2.1.2/src/core/tcp_out.c ****     tcp_seg_free(seg);
 194:./lwip-2.1.2/src/core/tcp_out.c ****     return NULL;
 195:./lwip-2.1.2/src/core/tcp_out.c ****   }
 196:./lwip-2.1.2/src/core/tcp_out.c ****   seg->tcphdr = (struct tcp_hdr *)seg->p->payload;
 197:./lwip-2.1.2/src/core/tcp_out.c ****   seg->tcphdr->src = lwip_htons(pcb->local_port);
 198:./lwip-2.1.2/src/core/tcp_out.c ****   seg->tcphdr->dest = lwip_htons(pcb->remote_port);
 199:./lwip-2.1.2/src/core/tcp_out.c ****   seg->tcphdr->seqno = lwip_htonl(seqno);
 200:./lwip-2.1.2/src/core/tcp_out.c ****   /* ackno is set in tcp_output */
 201:./lwip-2.1.2/src/core/tcp_out.c ****   TCPH_HDRLEN_FLAGS_SET(seg->tcphdr, (5 + optlen / 4), hdrflags);
 202:./lwip-2.1.2/src/core/tcp_out.c ****   /* wnd and chksum are set in tcp_output */
 203:./lwip-2.1.2/src/core/tcp_out.c ****   seg->tcphdr->urgp = 0;

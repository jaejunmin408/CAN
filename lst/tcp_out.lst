1382:./lwip-2.1.2/src/core/tcp_out.c ****         pcb->unacked = seg;
1383:./lwip-2.1.2/src/core/tcp_out.c ****         useg = seg;
1384:./lwip-2.1.2/src/core/tcp_out.c ****         /* unacked list is not empty? */
1385:./lwip-2.1.2/src/core/tcp_out.c ****       } else {
1386:./lwip-2.1.2/src/core/tcp_out.c ****         /* In the case of fast retransmit, the packet should not go to the tail
1387:./lwip-2.1.2/src/core/tcp_out.c ****          * of the unacked queue, but rather somewhere before it. We need to check for
1388:./lwip-2.1.2/src/core/tcp_out.c ****          * this case. -STJ Jul 27, 2004 */
1389:./lwip-2.1.2/src/core/tcp_out.c ****         if (TCP_SEQ_LT(lwip_ntohl(seg->tcphdr->seqno), lwip_ntohl(useg->tcphdr->seqno))) {

1387:./lwip-2.1.2/src/core/tcp_out.c ****          * of the unacked queue, but rather somewhere before it. We need to check for
1388:./lwip-2.1.2/src/core/tcp_out.c ****          * this case. -STJ Jul 27, 2004 */
1389:./lwip-2.1.2/src/core/tcp_out.c ****         if (TCP_SEQ_LT(lwip_ntohl(seg->tcphdr->seqno), lwip_ntohl(useg->tcphdr->seqno))) {
1390:./lwip-2.1.2/src/core/tcp_out.c ****           /* add segment to before tail of unacked list, keeping the list sorted */
1391:./lwip-2.1.2/src/core/tcp_out.c ****           struct tcp_seg **cur_seg = &(pcb->unacked);
1392:./lwip-2.1.2/src/core/tcp_out.c ****           while (*cur_seg &&
1393:./lwip-2.1.2/src/core/tcp_out.c ****                  TCP_SEQ_LT(lwip_ntohl((*cur_seg)->tcphdr->seqno), lwip_ntohl(seg->tcphdr->seqno)))
1394:./lwip-2.1.2/src/core/tcp_out.c ****             cur_seg = &((*cur_seg)->next );
1395:./lwip-2.1.2/src/core/tcp_out.c ****           }
1396:./lwip-2.1.2/src/core/tcp_out.c ****           seg->next = (*cur_seg);
1397:./lwip-2.1.2/src/core/tcp_out.c ****           (*cur_seg) = seg;
1398:./lwip-2.1.2/src/core/tcp_out.c ****         } else {

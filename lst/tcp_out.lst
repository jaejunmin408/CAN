1278:./lwip-2.1.2/src/core/tcp_out.c ****     }
1279:./lwip-2.1.2/src/core/tcp_out.c ****     /* nothing to send: shortcut out of here */
1280:./lwip-2.1.2/src/core/tcp_out.c ****     goto output_done;
1281:./lwip-2.1.2/src/core/tcp_out.c ****   } else {

  94:./lwip-2.1.2/src/core/tcp_out.c **** /* Define some copy-macros for checksum-on-copy so that the code looks
  95:./lwip-2.1.2/src/core/tcp_out.c ****    nicer by preventing too many ifdef's. */
  96:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
  97:./lwip-2.1.2/src/core/tcp_out.c **** #define TCP_DATA_COPY(dst, src, len, seg) do { \
  98:./lwip-2.1.2/src/core/tcp_out.c ****   tcp_seg_add_chksum(LWIP_CHKSUM_COPY(dst, src, len), \
  99:./lwip-2.1.2/src/core/tcp_out.c ****                      len, &seg->chksum, &seg->chksum_swapped); \
 100:./lwip-2.1.2/src/core/tcp_out.c ****   seg->flags |= TF_SEG_DATA_CHECKSUMMED; } while(0)
 101:./lwip-2.1.2/src/core/tcp_out.c **** #define TCP_DATA_COPY2(dst, src, len, chksum, chksum_swapped)  \
 102:./lwip-2.1.2/src/core/tcp_out.c ****   tcp_seg_add_chksum(LWIP_CHKSUM_COPY(dst, src, len), len, chksum, chksum_swapped);
 103:./lwip-2.1.2/src/core/tcp_out.c **** #else /* TCP_CHECKSUM_ON_COPY*/
 104:./lwip-2.1.2/src/core/tcp_out.c **** #define TCP_DATA_COPY(dst, src, len, seg)                     MEMCPY(dst, src, len)
 105:./lwip-2.1.2/src/core/tcp_out.c **** #define TCP_DATA_COPY2(dst, src, len, chksum, chksum_swapped) MEMCPY(dst, src, len)
 106:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY*/
 107:./lwip-2.1.2/src/core/tcp_out.c **** 
 108:./lwip-2.1.2/src/core/tcp_out.c **** /** Define this to 1 for an extra check that the output checksum is valid
 109:./lwip-2.1.2/src/core/tcp_out.c ****  * (usefule when the checksum is generated by the application, not the stack) */
 110:./lwip-2.1.2/src/core/tcp_out.c **** #ifndef TCP_CHECKSUM_ON_COPY_SANITY_CHECK
 111:./lwip-2.1.2/src/core/tcp_out.c **** #define TCP_CHECKSUM_ON_COPY_SANITY_CHECK   0
 112:./lwip-2.1.2/src/core/tcp_out.c **** #endif
 113:./lwip-2.1.2/src/core/tcp_out.c **** /* Allow to override the failure of sanity check from warning to e.g. hard failure */
 114:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY_SANITY_CHECK
 115:./lwip-2.1.2/src/core/tcp_out.c **** #ifndef TCP_CHECKSUM_ON_COPY_SANITY_CHECK_FAIL
 116:./lwip-2.1.2/src/core/tcp_out.c **** #define TCP_CHECKSUM_ON_COPY_SANITY_CHECK_FAIL(msg) LWIP_DEBUGF(TCP_DEBUG | LWIP_DBG_LEVEL_WARNING,
 117:./lwip-2.1.2/src/core/tcp_out.c **** #endif
 118:./lwip-2.1.2/src/core/tcp_out.c **** #endif
 119:./lwip-2.1.2/src/core/tcp_out.c **** 
 120:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_OVERSIZE

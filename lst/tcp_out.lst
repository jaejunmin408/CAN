1636:./lwip-2.1.2/src/core/tcp_out.c **** 
1637:./lwip-2.1.2/src/core/tcp_out.c ****   if (pcb->unacked == NULL) {
1638:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
1639:./lwip-2.1.2/src/core/tcp_out.c ****   }
1640:./lwip-2.1.2/src/core/tcp_out.c **** 
1641:./lwip-2.1.2/src/core/tcp_out.c ****   /* Move all unacked segments to the head of the unsent queue.
1642:./lwip-2.1.2/src/core/tcp_out.c ****      However, give up if any of the unsent pbufs are still referenced by the
1643:./lwip-2.1.2/src/core/tcp_out.c ****      netif driver due to deferred transmission. No point loading the link further
1644:./lwip-2.1.2/src/core/tcp_out.c ****      if it is struggling to flush its buffered writes. */

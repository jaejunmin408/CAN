1422:./lwip-2.1.2/src/core/tcp_out.c **** /** Check if a segment's pbufs are used by someone else than TCP.
1423:./lwip-2.1.2/src/core/tcp_out.c ****  * This can happen on retransmission if the pbuf of this segment is still
1424:./lwip-2.1.2/src/core/tcp_out.c ****  * referenced by the netif driver due to deferred transmission.
1425:./lwip-2.1.2/src/core/tcp_out.c ****  * This is the case (only!) if someone down the TX call path called
1426:./lwip-2.1.2/src/core/tcp_out.c ****  * pbuf_ref() on one of the pbufs!
1427:./lwip-2.1.2/src/core/tcp_out.c ****  *
1428:./lwip-2.1.2/src/core/tcp_out.c ****  * @arg seg the tcp segment to check
1429:./lwip-2.1.2/src/core/tcp_out.c ****  * @return 1 if ref != 1, 0 if ref == 1
1430:./lwip-2.1.2/src/core/tcp_out.c ****  */
1431:./lwip-2.1.2/src/core/tcp_out.c **** static int
1432:./lwip-2.1.2/src/core/tcp_out.c **** tcp_output_segment_busy(const struct tcp_seg *seg)
1433:./lwip-2.1.2/src/core/tcp_out.c **** {
1434:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_output_segment_busy: invalid seg", seg != NULL);
1435:./lwip-2.1.2/src/core/tcp_out.c **** 
1436:./lwip-2.1.2/src/core/tcp_out.c ****   /* We only need to check the first pbuf here:
1437:./lwip-2.1.2/src/core/tcp_out.c ****      If a pbuf is queued for transmission, a driver calls pbuf_ref(),
1438:./lwip-2.1.2/src/core/tcp_out.c ****      which only changes the ref count of the first pbuf */
1439:./lwip-2.1.2/src/core/tcp_out.c ****   if (seg->p->ref != 1) {
1440:./lwip-2.1.2/src/core/tcp_out.c ****     /* other reference found */
1441:./lwip-2.1.2/src/core/tcp_out.c ****     return 1;
1442:./lwip-2.1.2/src/core/tcp_out.c ****   }
1443:./lwip-2.1.2/src/core/tcp_out.c ****   /* no other references found */
1444:./lwip-2.1.2/src/core/tcp_out.c ****   return 0;
1445:./lwip-2.1.2/src/core/tcp_out.c **** }
1446:./lwip-2.1.2/src/core/tcp_out.c **** 
1447:./lwip-2.1.2/src/core/tcp_out.c **** /**
1448:./lwip-2.1.2/src/core/tcp_out.c ****  * Called by tcp_output() to actually send a TCP segment over IP.
1449:./lwip-2.1.2/src/core/tcp_out.c ****  *
1450:./lwip-2.1.2/src/core/tcp_out.c ****  * @param seg the tcp_seg to send
1451:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb the tcp_pcb for the TCP connection used to send the segment
1452:./lwip-2.1.2/src/core/tcp_out.c ****  * @param netif the netif used to send the segment
1453:./lwip-2.1.2/src/core/tcp_out.c ****  */
1454:./lwip-2.1.2/src/core/tcp_out.c **** static err_t
1455:./lwip-2.1.2/src/core/tcp_out.c **** tcp_output_segment(struct tcp_seg *seg, struct tcp_pcb *pcb, struct netif *netif)
1456:./lwip-2.1.2/src/core/tcp_out.c **** {
1457:./lwip-2.1.2/src/core/tcp_out.c ****   err_t err;
1458:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t len;

1376:./lwip-2.1.2/src/core/tcp_out.c ****     }
1377:./lwip-2.1.2/src/core/tcp_out.c ****     /* put segment on unacknowledged list if length > 0 */
1378:./lwip-2.1.2/src/core/tcp_out.c ****     if (TCP_TCPLEN(seg) > 0) {
1379:./lwip-2.1.2/src/core/tcp_out.c ****       seg->next = NULL;
1380:./lwip-2.1.2/src/core/tcp_out.c ****       /* unacked list is empty? */

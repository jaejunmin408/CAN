 835:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t remainder;
 836:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t offset;
 837:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 838:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t chksum = 0;
 839:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t chksum_swapped = 0;

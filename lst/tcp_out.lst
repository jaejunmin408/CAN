 809:./lwip-2.1.2/src/core/tcp_out.c ****   }
 810:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_DEBUGF(TCP_QLEN_DEBUG | LWIP_DBG_STATE, ("tcp_write: %"S16_F" (with mem err)\n", pcb->snd_qu
 811:./lwip-2.1.2/src/core/tcp_out.c ****   return ERR_MEM;
 812:./lwip-2.1.2/src/core/tcp_out.c **** }
 813:./lwip-2.1.2/src/core/tcp_out.c **** 
 814:./lwip-2.1.2/src/core/tcp_out.c **** /**
 815:./lwip-2.1.2/src/core/tcp_out.c ****  * Split segment on the head of the unsent queue.  If return is not
 816:./lwip-2.1.2/src/core/tcp_out.c ****  * ERR_OK, existing head remains intact
 817:./lwip-2.1.2/src/core/tcp_out.c ****  *
 818:./lwip-2.1.2/src/core/tcp_out.c ****  * The split is accomplished by creating a new TCP segment and pbuf
 819:./lwip-2.1.2/src/core/tcp_out.c ****  * which holds the remainder payload after the split.  The original
 820:./lwip-2.1.2/src/core/tcp_out.c ****  * pbuf is trimmed to new length.  This allows splitting of read-only
 821:./lwip-2.1.2/src/core/tcp_out.c ****  * pbufs
 822:./lwip-2.1.2/src/core/tcp_out.c ****  *
 823:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb the tcp_pcb for which to split the unsent head
 824:./lwip-2.1.2/src/core/tcp_out.c ****  * @param split the amount of payload to remain in the head
 825:./lwip-2.1.2/src/core/tcp_out.c ****  */
 826:./lwip-2.1.2/src/core/tcp_out.c **** err_t
 827:./lwip-2.1.2/src/core/tcp_out.c **** tcp_split_unsent_seg(struct tcp_pcb *pcb, u16_t split)
 828:./lwip-2.1.2/src/core/tcp_out.c **** {
 829:./lwip-2.1.2/src/core/tcp_out.c ****   struct tcp_seg *seg = NULL, *useg = NULL;
 830:./lwip-2.1.2/src/core/tcp_out.c ****   struct pbuf *p = NULL;
 831:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optlen;
 832:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optflags;
 833:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t split_flags;
 834:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t remainder_flags;
 835:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t remainder;
 836:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t offset;
 837:./lwip-2.1.2/src/core/tcp_out.c **** #if TCP_CHECKSUM_ON_COPY
 838:./lwip-2.1.2/src/core/tcp_out.c ****   u16_t chksum = 0;
 839:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t chksum_swapped = 0;
 840:./lwip-2.1.2/src/core/tcp_out.c ****   struct pbuf *q;
 841:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */
 842:./lwip-2.1.2/src/core/tcp_out.c **** 
 843:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("tcp_split_unsent_seg: invalid pcb", pcb != NULL);
 844:./lwip-2.1.2/src/core/tcp_out.c **** 
 845:./lwip-2.1.2/src/core/tcp_out.c ****   useg = pcb->unsent;
 846:./lwip-2.1.2/src/core/tcp_out.c ****   if (useg == NULL) {
 847:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_MEM;
 848:./lwip-2.1.2/src/core/tcp_out.c ****   }
 849:./lwip-2.1.2/src/core/tcp_out.c **** 
 850:./lwip-2.1.2/src/core/tcp_out.c ****   if (split == 0) {
 851:./lwip-2.1.2/src/core/tcp_out.c ****     LWIP_ASSERT("Can't split segment into length 0", 0);
 852:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_VAL;
 853:./lwip-2.1.2/src/core/tcp_out.c ****   }
 854:./lwip-2.1.2/src/core/tcp_out.c **** 
 855:./lwip-2.1.2/src/core/tcp_out.c ****   if (useg->len <= split) {
 856:./lwip-2.1.2/src/core/tcp_out.c ****     return ERR_OK;
 857:./lwip-2.1.2/src/core/tcp_out.c ****   }
 858:./lwip-2.1.2/src/core/tcp_out.c **** 
 859:./lwip-2.1.2/src/core/tcp_out.c ****   LWIP_ASSERT("split <= mss", split <= pcb->mss);

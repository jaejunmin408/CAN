 278:./lwip-2.1.2/src/core/tcp_out.c **** /** Add a checksum of newly added data to the segment.
 279:./lwip-2.1.2/src/core/tcp_out.c ****  *
 280:./lwip-2.1.2/src/core/tcp_out.c ****  * Called by tcp_write and tcp_split_unsent_seg.
 281:./lwip-2.1.2/src/core/tcp_out.c ****  */
 282:./lwip-2.1.2/src/core/tcp_out.c **** static void
 283:./lwip-2.1.2/src/core/tcp_out.c **** tcp_seg_add_chksum(u16_t chksum, u16_t len, u16_t *seg_chksum,
 284:./lwip-2.1.2/src/core/tcp_out.c ****                    u8_t *seg_chksum_swapped)
 285:./lwip-2.1.2/src/core/tcp_out.c **** {
 286:./lwip-2.1.2/src/core/tcp_out.c ****   u32_t helper;
 287:./lwip-2.1.2/src/core/tcp_out.c ****   /* add chksum to old chksum and fold to u16_t */
 288:./lwip-2.1.2/src/core/tcp_out.c ****   helper = chksum + *seg_chksum;
 289:./lwip-2.1.2/src/core/tcp_out.c ****   chksum = FOLD_U32T(helper);
 290:./lwip-2.1.2/src/core/tcp_out.c ****   if ((len & 1) != 0) {
 291:./lwip-2.1.2/src/core/tcp_out.c ****     *seg_chksum_swapped = 1 - *seg_chksum_swapped;
 292:./lwip-2.1.2/src/core/tcp_out.c ****     chksum = SWAP_BYTES_IN_WORD(chksum);
 293:./lwip-2.1.2/src/core/tcp_out.c ****   }
 294:./lwip-2.1.2/src/core/tcp_out.c ****   *seg_chksum = chksum;
 295:./lwip-2.1.2/src/core/tcp_out.c **** }
 296:./lwip-2.1.2/src/core/tcp_out.c **** #endif /* TCP_CHECKSUM_ON_COPY */

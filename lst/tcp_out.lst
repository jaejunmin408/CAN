 814:./lwip-2.1.2/src/core/tcp_out.c **** /**
 815:./lwip-2.1.2/src/core/tcp_out.c ****  * Split segment on the head of the unsent queue.  If return is not
 816:./lwip-2.1.2/src/core/tcp_out.c ****  * ERR_OK, existing head remains intact
 817:./lwip-2.1.2/src/core/tcp_out.c ****  *
 818:./lwip-2.1.2/src/core/tcp_out.c ****  * The split is accomplished by creating a new TCP segment and pbuf
 819:./lwip-2.1.2/src/core/tcp_out.c ****  * which holds the remainder payload after the split.  The original
 820:./lwip-2.1.2/src/core/tcp_out.c ****  * pbuf is trimmed to new length.  This allows splitting of read-only
 821:./lwip-2.1.2/src/core/tcp_out.c ****  * pbufs
 822:./lwip-2.1.2/src/core/tcp_out.c ****  *
 823:./lwip-2.1.2/src/core/tcp_out.c ****  * @param pcb the tcp_pcb for which to split the unsent head
 824:./lwip-2.1.2/src/core/tcp_out.c ****  * @param split the amount of payload to remain in the head
 825:./lwip-2.1.2/src/core/tcp_out.c ****  */
 826:./lwip-2.1.2/src/core/tcp_out.c **** err_t
 827:./lwip-2.1.2/src/core/tcp_out.c **** tcp_split_unsent_seg(struct tcp_pcb *pcb, u16_t split)
 828:./lwip-2.1.2/src/core/tcp_out.c **** {
 829:./lwip-2.1.2/src/core/tcp_out.c ****   struct tcp_seg *seg = NULL, *useg = NULL;
 830:./lwip-2.1.2/src/core/tcp_out.c ****   struct pbuf *p = NULL;
 831:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optlen;
 832:./lwip-2.1.2/src/core/tcp_out.c ****   u8_t optflags;

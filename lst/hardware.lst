1734:./inc/core_cm7.h **** /**
1735:./inc/core_cm7.h ****   \ingroup    CMSIS_core_register
1736:./inc/core_cm7.h ****   \defgroup   CMSIS_core_bitfield     Core register bit field macros
1737:./inc/core_cm7.h ****   \brief      Macros for use with bit field definitions (xxx_Pos, xxx_Msk).
1738:./inc/core_cm7.h ****   @{
1739:./inc/core_cm7.h ****  */
1740:./inc/core_cm7.h **** 
1741:./inc/core_cm7.h **** /**
1742:./inc/core_cm7.h ****   \brief   Mask and shift a bit field value for use in a register bit range.
1743:./inc/core_cm7.h ****   \param[in] field  Name of the register bit field.
1744:./inc/core_cm7.h ****   \param[in] value  Value of the bit field. This parameter is interpreted as an uint32_t type.
1745:./inc/core_cm7.h ****   \return           Masked and shifted value.
1746:./inc/core_cm7.h **** */
1747:./inc/core_cm7.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1748:./inc/core_cm7.h **** 
1749:./inc/core_cm7.h **** /**
1750:./inc/core_cm7.h ****   \brief     Mask and shift a register value to extract a bit filed value.
1751:./inc/core_cm7.h ****   \param[in] field  Name of the register bit field.
1752:./inc/core_cm7.h ****   \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
1753:./inc/core_cm7.h ****   \return           Masked and shifted bit field value.
1754:./inc/core_cm7.h **** */
1755:./inc/core_cm7.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
1756:./inc/core_cm7.h **** 
1757:./inc/core_cm7.h **** /*@} end of group CMSIS_core_bitfield */
1758:./inc/core_cm7.h **** 

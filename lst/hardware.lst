2095:./inc/core_cm7.h **** /**
2096:./inc/core_cm7.h ****   \brief   Decode Priority
2097:./inc/core_cm7.h ****   \details Decodes an interrupt priority value with a given priority group to
2098:./inc/core_cm7.h ****            preemptive priority value and subpriority value.
2099:./inc/core_cm7.h ****            In case of a conflict between priority grouping and available
2100:./inc/core_cm7.h ****            priority bits (__NVIC_PRIO_BITS) the smallest possible priority group is set.
2101:./inc/core_cm7.h ****   \param [in]         Priority   Priority value, which can be retrieved with the function \ref NVIC
2102:./inc/core_cm7.h ****   \param [in]     PriorityGroup  Used priority group.
2103:./inc/core_cm7.h ****   \param [out] pPreemptPriority  Preemptive priority value (starting from 0).
2104:./inc/core_cm7.h ****   \param [out]     pSubPriority  Subpriority value (starting from 0).
2105:./inc/core_cm7.h ****  */
2106:./inc/core_cm7.h **** __STATIC_INLINE void NVIC_DecodePriority (uint32_t Priority, uint32_t PriorityGroup, uint32_t* cons
2107:./inc/core_cm7.h **** {
2108:./inc/core_cm7.h ****   uint32_t PriorityGroupTmp = (PriorityGroup & (uint32_t)0x07UL);   /* only values 0..7 are used   
2109:./inc/core_cm7.h ****   uint32_t PreemptPriorityBits;
2110:./inc/core_cm7.h ****   uint32_t SubPriorityBits;
2111:./inc/core_cm7.h **** 
2112:./inc/core_cm7.h ****   PreemptPriorityBits = ((7UL - PriorityGroupTmp) > (uint32_t)(__NVIC_PRIO_BITS)) ? (uint32_t)(__NV
2113:./inc/core_cm7.h ****   SubPriorityBits     = ((PriorityGroupTmp + (uint32_t)(__NVIC_PRIO_BITS)) < (uint32_t)7UL) ? (uint
2114:./inc/core_cm7.h **** 
2115:./inc/core_cm7.h ****   *pPreemptPriority = (Priority >> SubPriorityBits) & (uint32_t)((1UL << (PreemptPriorityBits)) - 1
2116:./inc/core_cm7.h ****   *pSubPriority     = (Priority                   ) & (uint32_t)((1UL << (SubPriorityBits    )) - 1
2117:./inc/core_cm7.h **** }
2118:./inc/core_cm7.h **** 
2119:./inc/core_cm7.h **** 
2120:./inc/core_cm7.h **** /**
2121:./inc/core_cm7.h ****   \brief   Set Interrupt Vector
2122:./inc/core_cm7.h ****   \details Sets an interrupt vector in SRAM based interrupt vector table.
2123:./inc/core_cm7.h ****            The interrupt number can be positive to specify a device specific interrupt,
2124:./inc/core_cm7.h ****            or negative to specify a processor exception.
2125:./inc/core_cm7.h ****            VTOR must been relocated to SRAM before.
2126:./inc/core_cm7.h ****   \param [in]   IRQn      Interrupt number
2127:./inc/core_cm7.h ****   \param [in]   vector    Address of interrupt handler function
2128:./inc/core_cm7.h ****  */
2129:./inc/core_cm7.h **** __STATIC_INLINE void __NVIC_SetVector(IRQn_Type IRQn, uint32_t vector)
2130:./inc/core_cm7.h **** {
2131:./inc/core_cm7.h ****   uint32_t vectors = (uint32_t )SCB->VTOR;
2132:./inc/core_cm7.h ****   (* (int *) (vectors + ((int32_t)IRQn + NVIC_USER_IRQ_OFFSET) * 4)) = vector;
2133:./inc/core_cm7.h ****   __DSB();
2134:./inc/core_cm7.h **** }
2135:./inc/core_cm7.h **** 
2136:./inc/core_cm7.h **** 
2137:./inc/core_cm7.h **** /**
2138:./inc/core_cm7.h ****   \brief   Get Interrupt Vector
2139:./inc/core_cm7.h ****   \details Reads an interrupt vector from interrupt vector table.
2140:./inc/core_cm7.h ****            The interrupt number can be positive to specify a device specific interrupt,
2141:./inc/core_cm7.h ****            or negative to specify a processor exception.
2142:./inc/core_cm7.h ****   \param [in]   IRQn      Interrupt number.
2143:./inc/core_cm7.h ****   \return                 Address of interrupt handler function
2144:./inc/core_cm7.h ****  */
2145:./inc/core_cm7.h **** __STATIC_INLINE uint32_t __NVIC_GetVector(IRQn_Type IRQn)
2146:./inc/core_cm7.h **** {
2147:./inc/core_cm7.h ****   uint32_t vectors = (uint32_t )SCB->VTOR;
2148:./inc/core_cm7.h ****   return (uint32_t)(* (int *) (vectors + ((int32_t)IRQn + NVIC_USER_IRQ_OFFSET) * 4));
2149:./inc/core_cm7.h **** }
2150:./inc/core_cm7.h **** 

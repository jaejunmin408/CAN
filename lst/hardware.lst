2060:./inc/core_cm7.h ****   }
2061:./inc/core_cm7.h ****   else
2062:./inc/core_cm7.h ****   {
2063:./inc/core_cm7.h ****     return(((uint32_t)SCB->SHPR[(((uint32_t)IRQn) & 0xFUL)-4UL] >> (8U - __NVIC_PRIO_BITS)));

 556:./lwip-2.1.2/src/core/ipv4/dhcp.c ****                 ("dhcp_t1_timeout(): must renew\n"));
 557:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     /* This slightly different to RFC2131: DHCPREQUEST will be sent from state
 558:./lwip-2.1.2/src/core/ipv4/dhcp.c ****        DHCP_STATE_RENEWING, not DHCP_STATE_BOUND */
 559:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     dhcp_renew(netif);

 309:./lwip-2.1.2/src/core/ipv4/dhcp.c ****               (s16_t)netif->name[1]));
 310:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   dhcp_set_state(dhcp, DHCP_STATE_CHECKING);
 311:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   /* create an ARP query for the offered IP address, expecting that no host
 312:./lwip-2.1.2/src/core/ipv4/dhcp.c ****      responds, as the IP address should not be in use. */
 313:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   result = etharp_query(netif, &dhcp->offered_ip_addr, NULL);
 314:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   if (result != ERR_OK) {
 315:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_LEVEL_WARNING, ("dhcp_check: could not perfo
 316:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   }
 317:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   if (dhcp->tries < 255) {
 318:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     dhcp->tries++;
 319:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   }
 320:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   msecs = 500;
 321:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   dhcp->request_timeout = (u16_t)((msecs + DHCP_FINE_TIMER_MSECS - 1) / DHCP_FINE_TIMER_MSECS);
 322:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_check(): set request timeout %"U
 323:./lwip-2.1.2/src/core/ipv4/dhcp.c **** }
 324:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #endif /* DHCP_DOES_ARP_CHECK */

 872:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       break;
 873:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     case DHCP_STATE_OFF:
 874:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       /* stay off */
 875:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       break;
 876:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     default:
 877:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       LWIP_ASSERT("invalid dhcp->state", dhcp->state <= DHCP_STATE_BACKING_OFF);
 878:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       /* INIT/REQUESTING/CHECKING/BACKING_OFF restart with new 'rid' because the
 879:./lwip-2.1.2/src/core/ipv4/dhcp.c ****          state changes, SELECTING: continue with current 'rid' as we stay in the
 880:./lwip-2.1.2/src/core/ipv4/dhcp.c ****          same state */
 881:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #if LWIP_DHCP_AUTOIP_COOP

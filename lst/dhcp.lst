 130:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /** Option handling: options are parsed in dhcp_parse_reply
 131:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * and saved in an array where other functions can load them from.
 132:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * This might be moved into the struct dhcp (not necessarily since
 133:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * lwIP is single-threaded and the array is only used while in recv
 134:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * callback). */
 135:./lwip-2.1.2/src/core/ipv4/dhcp.c **** enum dhcp_option_idx {
 136:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_OVERLOAD = 0,
 137:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_MSG_TYPE,
 138:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_SERVER_ID,
 139:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_LEASE_TIME,
 140:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_T1,
 141:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_T2,
 142:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_SUBNET_MASK,
 143:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_ROUTER,
 144:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #if LWIP_DHCP_PROVIDE_DNS_SERVERS
 145:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_DNS_SERVER,
 146:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_DNS_SERVER_LAST = DHCP_OPTION_IDX_DNS_SERVER + LWIP_DHCP_PROVIDE_DNS_SERVERS - 1,
 147:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #endif /* LWIP_DHCP_PROVIDE_DNS_SERVERS */
 148:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #if LWIP_DHCP_GET_NTP_SRV
 149:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_NTP_SERVER,
 150:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_NTP_SERVER_LAST = DHCP_OPTION_IDX_NTP_SERVER + LWIP_DHCP_MAX_NTP_SERVERS - 1,
 151:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #endif /* LWIP_DHCP_GET_NTP_SRV */
 152:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   DHCP_OPTION_IDX_MAX
 153:./lwip-2.1.2/src/core/ipv4/dhcp.c **** };
 154:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 155:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /** Holds the decoded option values, only valid while in dhcp_recv.
 156:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     @todo: move this into struct dhcp? */
 157:./lwip-2.1.2/src/core/ipv4/dhcp.c **** u32_t dhcp_rx_options_val[DHCP_OPTION_IDX_MAX];
 158:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /** Holds a flag which option was received and is contained in dhcp_rx_options_val,
 159:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     only valid while in dhcp_recv.

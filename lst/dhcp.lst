 180:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #define dhcp_option_given(dhcp, idx)          (dhcp_rx_options_given[idx] != 0)
 181:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #define dhcp_got_option(dhcp, idx)            (dhcp_rx_options_given[idx] = 1)

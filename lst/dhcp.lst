 562:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp->t1_renew_time = (u16_t)((dhcp->t2_timeout - dhcp->lease_used) / 2);
 563:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     }
 564:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   }
 565:./lwip-2.1.2/src/core/ipv4/dhcp.c **** }
 566:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 567:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /**
 568:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * The rebind period has timed out.
 569:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  *
 570:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * @param netif the netif under DHCP control
 571:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  */
 572:./lwip-2.1.2/src/core/ipv4/dhcp.c **** static void
 573:./lwip-2.1.2/src/core/ipv4/dhcp.c **** dhcp_t2_timeout(struct netif *netif)
 574:./lwip-2.1.2/src/core/ipv4/dhcp.c **** {
 575:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   struct dhcp *dhcp = netif_dhcp_data(netif);
 576:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 

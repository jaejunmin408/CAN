 425:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /**
 426:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * The DHCP timer that checks for lease renewal/rebind timeouts.
 427:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * Must be called once a minute (see @ref DHCP_COARSE_TIMER_SECS).
 428:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  */
 429:./lwip-2.1.2/src/core/ipv4/dhcp.c **** void
 430:./lwip-2.1.2/src/core/ipv4/dhcp.c **** dhcp_coarse_tmr(void)
 431:./lwip-2.1.2/src/core/ipv4/dhcp.c **** {
 432:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   struct netif *netif;
 433:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE, ("dhcp_coarse_tmr()\n"));
 434:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   /* iterate through all network interfaces */
 435:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   NETIF_FOREACH(netif) {
 436:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     /* only act on DHCP configured interfaces */
 437:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     struct dhcp *dhcp = netif_dhcp_data(netif);
 438:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     if ((dhcp != NULL) && (dhcp->state != DHCP_STATE_OFF)) {
 439:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       /* compare lease time to expire timeout */
 440:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       if (dhcp->t0_timeout && (++dhcp->lease_used == dhcp->t0_timeout)) {
 441:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_coarse_tmr(): t0 timeout\n
 442:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* this clients' lease time has expired */
 443:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp_release_and_stop(netif);
 444:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp_start(netif);
 445:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* timer is active (non zero), and triggers (zeroes) now? */
 446:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       } else if (dhcp->t2_rebind_time && (dhcp->t2_rebind_time-- == 1)) {
 447:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_coarse_tmr(): t2 timeout\n
 448:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* this clients' rebind timeout triggered */
 449:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp_t2_timeout(netif);
 450:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* timer is active (non zero), and triggers (zeroes) now */
 451:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       } else if (dhcp->t1_renew_time && (dhcp->t1_renew_time-- == 1)) {
 452:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_coarse_tmr(): t1 timeout\n
 453:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* this clients' renewal timeout triggered */
 454:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp_t1_timeout(netif);
 455:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       }
 456:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     }
 457:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   }
 458:./lwip-2.1.2/src/core/ipv4/dhcp.c **** }
 459:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 460:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /**
 461:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * DHCP transaction timeout handling (this function must be called every 500ms,
 462:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * see @ref DHCP_FINE_TIMER_MSECS).
 463:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  *
 464:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * A DHCP server is expected to respond within a short period of time.
 465:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * This timer checks whether an outstanding DHCP request is timed out.
 466:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  */
 467:./lwip-2.1.2/src/core/ipv4/dhcp.c **** void
 468:./lwip-2.1.2/src/core/ipv4/dhcp.c **** dhcp_fine_tmr(void)
 469:./lwip-2.1.2/src/core/ipv4/dhcp.c **** {
 470:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   struct netif *netif;
 471:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   /* loop through netif's */
 472:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   NETIF_FOREACH(netif) {
 473:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     struct dhcp *dhcp = netif_dhcp_data(netif);
 474:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     /* only act on DHCP configured interfaces */
 475:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     if (dhcp != NULL) {
 476:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       /* timer is active (non zero), and is about to trigger now */
 477:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       if (dhcp->request_timeout > 1) {
 478:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp->request_timeout--;
 479:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       } else if (dhcp->request_timeout == 1) {
 480:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp->request_timeout--;
 481:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* { dhcp->request_timeout == 0 } */
 482:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_fine_tmr(): request timeou
 483:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         /* this client's request timeout triggered */
 484:./lwip-2.1.2/src/core/ipv4/dhcp.c ****         dhcp_timeout(netif);
 485:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       }
 486:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     }
 487:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   }
 488:./lwip-2.1.2/src/core/ipv4/dhcp.c **** }
 489:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 490:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /**
 491:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * A DHCP negotiation transaction, or ARP request, has timed out.
 492:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  *
 493:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * The timer that was started with the DHCP or ARP request has
 494:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * timed out, indicating no response was received in time.
 495:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  *
 496:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * @param netif the netif under DHCP control
 497:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  */
 498:./lwip-2.1.2/src/core/ipv4/dhcp.c **** static void
 499:./lwip-2.1.2/src/core/ipv4/dhcp.c **** dhcp_timeout(struct netif *netif)
 500:./lwip-2.1.2/src/core/ipv4/dhcp.c **** {
 501:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   struct dhcp *dhcp = netif_dhcp_data(netif);
 502:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 503:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE, ("dhcp_timeout()\n"));
 504:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   /* back-off period has passed, or server selection timed out */
 505:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   if ((dhcp->state == DHCP_STATE_BACKING_OFF) || (dhcp->state == DHCP_STATE_SELECTING)) {
 506:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE, ("dhcp_timeout(): restarting discovery\n"));
 507:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     dhcp_discover(netif);
 508:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     /* receiving the requested lease timed out */
 509:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   } else if (dhcp->state == DHCP_STATE_REQUESTING) {
 510:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_timeout(): REQUESTING, DHCP re
 511:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     if (dhcp->tries <= 5) {
 512:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_select(netif);
 513:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     } else {
 514:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_timeout(): REQUESTING, relea
 515:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_release_and_stop(netif);
 516:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_start(netif);
 517:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     }
 518:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #if DHCP_DOES_ARP_CHECK
 519:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     /* received no ARP reply for the offered address (which is good) */
 520:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   } else if (dhcp->state == DHCP_STATE_CHECKING) {
 521:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_TRACE | LWIP_DBG_STATE, ("dhcp_timeout(): CHECKING, ARP reque
 522:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     if (dhcp->tries <= 1) {
 523:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_check(netif);
 524:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       /* no ARP replies on the offered address,
 525:./lwip-2.1.2/src/core/ipv4/dhcp.c ****          looks like the IP address is indeed free */
 526:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     } else {
 527:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       /* bind the interface to the offered address */
 528:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_bind(netif);
 529:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     }
 530:./lwip-2.1.2/src/core/ipv4/dhcp.c **** #endif /* DHCP_DOES_ARP_CHECK */
 531:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   } else if (dhcp->state == DHCP_STATE_REBOOTING) {
 532:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     if (dhcp->tries < REBOOT_TRIES) {
 533:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_reboot(netif);
 534:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     } else {
 535:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       dhcp_discover(netif);
 536:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     }
 537:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   }
 538:./lwip-2.1.2/src/core/ipv4/dhcp.c **** }
 539:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 540:./lwip-2.1.2/src/core/ipv4/dhcp.c **** /**
 541:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * The renewal period has timed out.
 542:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  *
 543:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  * @param netif the netif under DHCP control
 544:./lwip-2.1.2/src/core/ipv4/dhcp.c ****  */
 545:./lwip-2.1.2/src/core/ipv4/dhcp.c **** static void
 546:./lwip-2.1.2/src/core/ipv4/dhcp.c **** dhcp_t1_timeout(struct netif *netif)
 547:./lwip-2.1.2/src/core/ipv4/dhcp.c **** {
 548:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   struct dhcp *dhcp = netif_dhcp_data(netif);
 549:./lwip-2.1.2/src/core/ipv4/dhcp.c **** 
 550:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   LWIP_DEBUGF(DHCP_DEBUG | LWIP_DBG_STATE, ("dhcp_t1_timeout()\n"));
 551:./lwip-2.1.2/src/core/ipv4/dhcp.c ****   if ((dhcp->state == DHCP_STATE_REQUESTING) || (dhcp->state == DHCP_STATE_BOUND) ||
 552:./lwip-2.1.2/src/core/ipv4/dhcp.c ****       (dhcp->state == DHCP_STATE_RENEWING)) {
 553:./lwip-2.1.2/src/core/ipv4/dhcp.c ****     /* just retry to renew - note that the rebind timer (t2) will
 554:./lwip-2.1.2/src/core/ipv4/dhcp.c ****      * eventually time-out if renew tries fail. */

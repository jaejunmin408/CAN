   1:./lwip-2.1.2/src/core/def.c **** /**
   2:./lwip-2.1.2/src/core/def.c ****  * @file
   3:./lwip-2.1.2/src/core/def.c ****  * Common functions used throughout the stack.
   4:./lwip-2.1.2/src/core/def.c ****  *
   5:./lwip-2.1.2/src/core/def.c ****  * These are reference implementations of the byte swapping functions.
   6:./lwip-2.1.2/src/core/def.c ****  * Again with the aim of being simple, correct and fully portable.
   7:./lwip-2.1.2/src/core/def.c ****  * Byte swapping is the second thing you would want to optimize. You will
   8:./lwip-2.1.2/src/core/def.c ****  * need to port it to your architecture and in your cc.h:
   9:./lwip-2.1.2/src/core/def.c ****  *
  10:./lwip-2.1.2/src/core/def.c ****  * \#define lwip_htons(x) your_htons
  11:./lwip-2.1.2/src/core/def.c ****  * \#define lwip_htonl(x) your_htonl
  12:./lwip-2.1.2/src/core/def.c ****  *
  13:./lwip-2.1.2/src/core/def.c ****  * Note lwip_ntohs() and lwip_ntohl() are merely references to the htonx counterparts.
  14:./lwip-2.1.2/src/core/def.c ****  *
  15:./lwip-2.1.2/src/core/def.c ****  * If you \#define them to htons() and htonl(), you should
  16:./lwip-2.1.2/src/core/def.c ****  * \#define LWIP_DONT_PROVIDE_BYTEORDER_FUNCTIONS to prevent lwIP from
  17:./lwip-2.1.2/src/core/def.c ****  * defining htonx/ntohx compatibility macros.
  18:./lwip-2.1.2/src/core/def.c **** 
  19:./lwip-2.1.2/src/core/def.c ****  * @defgroup sys_nonstandard Non-standard functions
  20:./lwip-2.1.2/src/core/def.c ****  * @ingroup sys_layer
  21:./lwip-2.1.2/src/core/def.c ****  * lwIP provides default implementations for non-standard functions.
  22:./lwip-2.1.2/src/core/def.c ****  * These can be mapped to OS functions to reduce code footprint if desired.
  23:./lwip-2.1.2/src/core/def.c ****  * All defines related to this section must not be placed in lwipopts.h,
  24:./lwip-2.1.2/src/core/def.c ****  * but in arch/cc.h!
  25:./lwip-2.1.2/src/core/def.c ****  * These options cannot be \#defined in lwipopts.h since they are not options
  26:./lwip-2.1.2/src/core/def.c ****  * of lwIP itself, but options of the lwIP port to your system.
  27:./lwip-2.1.2/src/core/def.c ****  */

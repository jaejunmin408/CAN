  53:./lwip-2.1.2/src/api/tcpip.c **** #define TCPIP_MSG_VAR_REF(name)     API_VAR_REF(name)
  54:./lwip-2.1.2/src/api/tcpip.c **** #define TCPIP_MSG_VAR_DECLARE(name) API_VAR_DECLARE(struct tcpip_msg, name)
  55:./lwip-2.1.2/src/api/tcpip.c **** #define TCPIP_MSG_VAR_ALLOC(name)   API_VAR_ALLOC(struct tcpip_msg, MEMP_TCPIP_MSG_API, name, ERR_M
  56:./lwip-2.1.2/src/api/tcpip.c **** #define TCPIP_MSG_VAR_FREE(name)    API_VAR_FREE(MEMP_TCPIP_MSG_API, name)
  57:./lwip-2.1.2/src/api/tcpip.c **** 
  58:./lwip-2.1.2/src/api/tcpip.c **** /* global variables */
  59:./lwip-2.1.2/src/api/tcpip.c **** static tcpip_init_done_fn tcpip_init_done;
  60:./lwip-2.1.2/src/api/tcpip.c **** static void *tcpip_init_done_arg;
  61:./lwip-2.1.2/src/api/tcpip.c **** static sys_mbox_t tcpip_mbox;
  62:./lwip-2.1.2/src/api/tcpip.c **** 
  63:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_CORE_LOCKING
  64:./lwip-2.1.2/src/api/tcpip.c **** /** The global semaphore to lock the stack. */
  65:./lwip-2.1.2/src/api/tcpip.c **** sys_mutex_t lock_tcpip_core;
  66:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_CORE_LOCKING */
  67:./lwip-2.1.2/src/api/tcpip.c **** 
  68:./lwip-2.1.2/src/api/tcpip.c **** static void tcpip_thread_handle_msg(struct tcpip_msg *msg);
  69:./lwip-2.1.2/src/api/tcpip.c **** 
  70:./lwip-2.1.2/src/api/tcpip.c **** #if !LWIP_TIMERS
  71:./lwip-2.1.2/src/api/tcpip.c **** /* wait for a message with timers disabled (e.g. pass a timer-check trigger into tcpip_thread) */
  72:./lwip-2.1.2/src/api/tcpip.c **** #define TCPIP_MBOX_FETCH(mbox, msg) sys_mbox_fetch(mbox, msg)
  73:./lwip-2.1.2/src/api/tcpip.c **** #else /* !LWIP_TIMERS */
  74:./lwip-2.1.2/src/api/tcpip.c **** /* wait for a message, timeouts are processed while waiting */
  75:./lwip-2.1.2/src/api/tcpip.c **** #define TCPIP_MBOX_FETCH(mbox, msg) tcpip_timeouts_mbox_fetch(mbox, msg)
  76:./lwip-2.1.2/src/api/tcpip.c **** /**
  77:./lwip-2.1.2/src/api/tcpip.c ****  * Wait (forever) for a message to arrive in an mbox.
  78:./lwip-2.1.2/src/api/tcpip.c ****  * While waiting, timeouts are processed.
  79:./lwip-2.1.2/src/api/tcpip.c ****  *
  80:./lwip-2.1.2/src/api/tcpip.c ****  * @param mbox the mbox to fetch the message from
  81:./lwip-2.1.2/src/api/tcpip.c ****  * @param msg the place to store the message
  82:./lwip-2.1.2/src/api/tcpip.c ****  */
  83:./lwip-2.1.2/src/api/tcpip.c **** static void
  84:./lwip-2.1.2/src/api/tcpip.c **** tcpip_timeouts_mbox_fetch(sys_mbox_t *mbox, void **msg)
  85:./lwip-2.1.2/src/api/tcpip.c **** {
  86:./lwip-2.1.2/src/api/tcpip.c ****   u32_t sleeptime, res;
  87:./lwip-2.1.2/src/api/tcpip.c **** 
  88:./lwip-2.1.2/src/api/tcpip.c **** again:
  89:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT_CORE_LOCKED();
  90:./lwip-2.1.2/src/api/tcpip.c **** 
  91:./lwip-2.1.2/src/api/tcpip.c ****   sleeptime = sys_timeouts_sleeptime();
  92:./lwip-2.1.2/src/api/tcpip.c ****   if (sleeptime == SYS_TIMEOUTS_SLEEPTIME_INFINITE) {
  93:./lwip-2.1.2/src/api/tcpip.c ****     UNLOCK_TCPIP_CORE();
  94:./lwip-2.1.2/src/api/tcpip.c ****     sys_arch_mbox_fetch(mbox, msg, 0);
  95:./lwip-2.1.2/src/api/tcpip.c ****     LOCK_TCPIP_CORE();
  96:./lwip-2.1.2/src/api/tcpip.c ****     return;
  97:./lwip-2.1.2/src/api/tcpip.c ****   } else if (sleeptime == 0) {
  98:./lwip-2.1.2/src/api/tcpip.c ****     sys_check_timeouts();
  99:./lwip-2.1.2/src/api/tcpip.c ****     /* We try again to fetch a message from the mbox. */
 100:./lwip-2.1.2/src/api/tcpip.c ****     goto again;
 101:./lwip-2.1.2/src/api/tcpip.c ****   }
 102:./lwip-2.1.2/src/api/tcpip.c **** 
 103:./lwip-2.1.2/src/api/tcpip.c ****   UNLOCK_TCPIP_CORE();
 104:./lwip-2.1.2/src/api/tcpip.c ****   res = sys_arch_mbox_fetch(mbox, msg, sleeptime);
 105:./lwip-2.1.2/src/api/tcpip.c ****   LOCK_TCPIP_CORE();
 106:./lwip-2.1.2/src/api/tcpip.c ****   if (res == SYS_ARCH_TIMEOUT) {
 107:./lwip-2.1.2/src/api/tcpip.c ****     /* If a SYS_ARCH_TIMEOUT value is returned, a timeout occurred
 108:./lwip-2.1.2/src/api/tcpip.c ****        before a message could be fetched. */
 109:./lwip-2.1.2/src/api/tcpip.c ****     sys_check_timeouts();
 110:./lwip-2.1.2/src/api/tcpip.c ****     /* We try again to fetch a message from the mbox. */
 111:./lwip-2.1.2/src/api/tcpip.c ****     goto again;
 112:./lwip-2.1.2/src/api/tcpip.c ****   }
 113:./lwip-2.1.2/src/api/tcpip.c **** }
 114:./lwip-2.1.2/src/api/tcpip.c **** #endif /* !LWIP_TIMERS */
 115:./lwip-2.1.2/src/api/tcpip.c **** 
 116:./lwip-2.1.2/src/api/tcpip.c **** /**
 117:./lwip-2.1.2/src/api/tcpip.c ****  * The main lwIP thread. This thread has exclusive access to lwIP core functions
 118:./lwip-2.1.2/src/api/tcpip.c ****  * (unless access to them is not locked). Other threads communicate with this
 119:./lwip-2.1.2/src/api/tcpip.c ****  * thread using message boxes.
 120:./lwip-2.1.2/src/api/tcpip.c ****  *
 121:./lwip-2.1.2/src/api/tcpip.c ****  * It also starts all the timers to make sure they are running in the right
 122:./lwip-2.1.2/src/api/tcpip.c ****  * thread context.
 123:./lwip-2.1.2/src/api/tcpip.c ****  *
 124:./lwip-2.1.2/src/api/tcpip.c ****  * @param arg unused argument
 125:./lwip-2.1.2/src/api/tcpip.c ****  */
 126:./lwip-2.1.2/src/api/tcpip.c **** static void
 127:./lwip-2.1.2/src/api/tcpip.c **** tcpip_thread(void *arg)
 128:./lwip-2.1.2/src/api/tcpip.c **** {
 129:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 130:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_UNUSED_ARG(arg);
 131:./lwip-2.1.2/src/api/tcpip.c **** 
 132:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_MARK_TCPIP_THREAD();
 133:./lwip-2.1.2/src/api/tcpip.c **** 
 134:./lwip-2.1.2/src/api/tcpip.c ****   LOCK_TCPIP_CORE();
 135:./lwip-2.1.2/src/api/tcpip.c ****   if (tcpip_init_done != NULL) {
 136:./lwip-2.1.2/src/api/tcpip.c ****     tcpip_init_done(tcpip_init_done_arg);
 137:./lwip-2.1.2/src/api/tcpip.c ****   }
 138:./lwip-2.1.2/src/api/tcpip.c **** 
 139:./lwip-2.1.2/src/api/tcpip.c ****   while (1) {                          /* MAIN Loop */
 140:./lwip-2.1.2/src/api/tcpip.c ****     LWIP_TCPIP_THREAD_ALIVE();
 141:./lwip-2.1.2/src/api/tcpip.c ****     /* wait for a message, timeouts are processed while waiting */
 142:./lwip-2.1.2/src/api/tcpip.c ****     TCPIP_MBOX_FETCH(&tcpip_mbox, (void **)&msg);
 143:./lwip-2.1.2/src/api/tcpip.c ****     if (msg == NULL) {
 144:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: invalid message: NULL\n"));
 145:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_ASSERT("tcpip_thread: invalid message", 0);
 146:./lwip-2.1.2/src/api/tcpip.c ****       continue;
 147:./lwip-2.1.2/src/api/tcpip.c ****     }
 148:./lwip-2.1.2/src/api/tcpip.c ****     tcpip_thread_handle_msg(msg);
 149:./lwip-2.1.2/src/api/tcpip.c ****   }
 150:./lwip-2.1.2/src/api/tcpip.c **** }
 151:./lwip-2.1.2/src/api/tcpip.c **** 
 152:./lwip-2.1.2/src/api/tcpip.c **** /* Handle a single tcpip_msg
 153:./lwip-2.1.2/src/api/tcpip.c ****  * This is in its own function for access by tests only.
 154:./lwip-2.1.2/src/api/tcpip.c ****  */
 155:./lwip-2.1.2/src/api/tcpip.c **** static void
 156:./lwip-2.1.2/src/api/tcpip.c **** tcpip_thread_handle_msg(struct tcpip_msg *msg)
 157:./lwip-2.1.2/src/api/tcpip.c **** {
 158:./lwip-2.1.2/src/api/tcpip.c ****   switch (msg->type) {
 159:./lwip-2.1.2/src/api/tcpip.c **** #if !LWIP_TCPIP_CORE_LOCKING
 160:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_API:
 161:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: API message %p\n", (void *)msg));
 162:./lwip-2.1.2/src/api/tcpip.c ****       msg->msg.api_msg.function(msg->msg.api_msg.msg);
 163:./lwip-2.1.2/src/api/tcpip.c ****       break;
 164:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_API_CALL:
 165:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: API CALL message %p\n", (void *)msg));
 166:./lwip-2.1.2/src/api/tcpip.c ****       msg->msg.api_call.arg->err = msg->msg.api_call.function(msg->msg.api_call.arg);
 167:./lwip-2.1.2/src/api/tcpip.c ****       sys_sem_signal(msg->msg.api_call.sem);
 168:./lwip-2.1.2/src/api/tcpip.c ****       break;
 169:./lwip-2.1.2/src/api/tcpip.c **** #endif /* !LWIP_TCPIP_CORE_LOCKING */
 170:./lwip-2.1.2/src/api/tcpip.c **** 
 171:./lwip-2.1.2/src/api/tcpip.c **** #if !LWIP_TCPIP_CORE_LOCKING_INPUT
 172:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_INPKT:
 173:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: PACKET %p\n", (void *)msg));
 174:./lwip-2.1.2/src/api/tcpip.c ****       if (msg->msg.inp.input_fn(msg->msg.inp.p, msg->msg.inp.netif) != ERR_OK) {
 175:./lwip-2.1.2/src/api/tcpip.c ****         pbuf_free(msg->msg.inp.p);
 176:./lwip-2.1.2/src/api/tcpip.c ****       }
 177:./lwip-2.1.2/src/api/tcpip.c ****       memp_free(MEMP_TCPIP_MSG_INPKT, msg);
 178:./lwip-2.1.2/src/api/tcpip.c ****       break;
 179:./lwip-2.1.2/src/api/tcpip.c **** #endif /* !LWIP_TCPIP_CORE_LOCKING_INPUT */
 180:./lwip-2.1.2/src/api/tcpip.c **** 
 181:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_TIMEOUT && LWIP_TIMERS
 182:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_TIMEOUT:
 183:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: TIMEOUT %p\n", (void *)msg));
 184:./lwip-2.1.2/src/api/tcpip.c ****       sys_timeout(msg->msg.tmo.msecs, msg->msg.tmo.h, msg->msg.tmo.arg);
 185:./lwip-2.1.2/src/api/tcpip.c ****       memp_free(MEMP_TCPIP_MSG_API, msg);
 186:./lwip-2.1.2/src/api/tcpip.c ****       break;
 187:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_UNTIMEOUT:
 188:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: UNTIMEOUT %p\n", (void *)msg));
 189:./lwip-2.1.2/src/api/tcpip.c ****       sys_untimeout(msg->msg.tmo.h, msg->msg.tmo.arg);
 190:./lwip-2.1.2/src/api/tcpip.c ****       memp_free(MEMP_TCPIP_MSG_API, msg);
 191:./lwip-2.1.2/src/api/tcpip.c ****       break;
 192:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_TIMEOUT && LWIP_TIMERS */
 193:./lwip-2.1.2/src/api/tcpip.c **** 
 194:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_CALLBACK:
 195:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: CALLBACK %p\n", (void *)msg));
 196:./lwip-2.1.2/src/api/tcpip.c ****       msg->msg.cb.function(msg->msg.cb.ctx);
 197:./lwip-2.1.2/src/api/tcpip.c ****       memp_free(MEMP_TCPIP_MSG_API, msg);
 198:./lwip-2.1.2/src/api/tcpip.c ****       break;
 199:./lwip-2.1.2/src/api/tcpip.c **** 
 200:./lwip-2.1.2/src/api/tcpip.c ****     case TCPIP_MSG_CALLBACK_STATIC:
 201:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: CALLBACK_STATIC %p\n", (void *)msg));
 202:./lwip-2.1.2/src/api/tcpip.c ****       msg->msg.cb.function(msg->msg.cb.ctx);
 203:./lwip-2.1.2/src/api/tcpip.c ****       break;
 204:./lwip-2.1.2/src/api/tcpip.c **** 
 205:./lwip-2.1.2/src/api/tcpip.c ****     default:
 206:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_thread: invalid message: %d\n", msg->type));
 207:./lwip-2.1.2/src/api/tcpip.c ****       LWIP_ASSERT("tcpip_thread: invalid message", 0);
 208:./lwip-2.1.2/src/api/tcpip.c ****       break;
 209:./lwip-2.1.2/src/api/tcpip.c ****   }
 210:./lwip-2.1.2/src/api/tcpip.c **** }
 211:./lwip-2.1.2/src/api/tcpip.c **** 
 212:./lwip-2.1.2/src/api/tcpip.c **** #ifdef TCPIP_THREAD_TEST
 213:./lwip-2.1.2/src/api/tcpip.c **** /** Work on queued items in single-threaded test mode */
 214:./lwip-2.1.2/src/api/tcpip.c **** int
 215:./lwip-2.1.2/src/api/tcpip.c **** tcpip_thread_poll_one(void)
 216:./lwip-2.1.2/src/api/tcpip.c **** {
 217:./lwip-2.1.2/src/api/tcpip.c ****   int ret = 0;
 218:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 219:./lwip-2.1.2/src/api/tcpip.c **** 
 220:./lwip-2.1.2/src/api/tcpip.c ****   if (sys_arch_mbox_tryfetch(&tcpip_mbox, (void **)&msg) != SYS_ARCH_TIMEOUT) {
 221:./lwip-2.1.2/src/api/tcpip.c ****     LOCK_TCPIP_CORE();
 222:./lwip-2.1.2/src/api/tcpip.c ****     if (msg != NULL) {
 223:./lwip-2.1.2/src/api/tcpip.c ****       tcpip_thread_handle_msg(msg);
 224:./lwip-2.1.2/src/api/tcpip.c ****       ret = 1;
 225:./lwip-2.1.2/src/api/tcpip.c ****     }
 226:./lwip-2.1.2/src/api/tcpip.c ****     UNLOCK_TCPIP_CORE();
 227:./lwip-2.1.2/src/api/tcpip.c ****   }
 228:./lwip-2.1.2/src/api/tcpip.c ****   return ret;
 229:./lwip-2.1.2/src/api/tcpip.c **** }
 230:./lwip-2.1.2/src/api/tcpip.c **** #endif
 231:./lwip-2.1.2/src/api/tcpip.c **** 
 232:./lwip-2.1.2/src/api/tcpip.c **** /**
 233:./lwip-2.1.2/src/api/tcpip.c ****  * Pass a received packet to tcpip_thread for input processing
 234:./lwip-2.1.2/src/api/tcpip.c ****  *
 235:./lwip-2.1.2/src/api/tcpip.c ****  * @param p the received packet
 236:./lwip-2.1.2/src/api/tcpip.c ****  * @param inp the network interface on which the packet was received
 237:./lwip-2.1.2/src/api/tcpip.c ****  * @param input_fn input function to call
 238:./lwip-2.1.2/src/api/tcpip.c ****  */
 239:./lwip-2.1.2/src/api/tcpip.c **** err_t
 240:./lwip-2.1.2/src/api/tcpip.c **** tcpip_inpkt(struct pbuf *p, struct netif *inp, netif_input_fn input_fn)
 241:./lwip-2.1.2/src/api/tcpip.c **** {
 242:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_CORE_LOCKING_INPUT
 243:./lwip-2.1.2/src/api/tcpip.c ****   err_t ret;
 244:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_DEBUGF(TCPIP_DEBUG, ("tcpip_inpkt: PACKET %p/%p\n", (void *)p, (void *)inp));
 245:./lwip-2.1.2/src/api/tcpip.c ****   LOCK_TCPIP_CORE();
 246:./lwip-2.1.2/src/api/tcpip.c ****   ret = input_fn(p, inp);
 247:./lwip-2.1.2/src/api/tcpip.c ****   UNLOCK_TCPIP_CORE();
 248:./lwip-2.1.2/src/api/tcpip.c ****   return ret;
 249:./lwip-2.1.2/src/api/tcpip.c **** #else /* LWIP_TCPIP_CORE_LOCKING_INPUT */
 250:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 251:./lwip-2.1.2/src/api/tcpip.c **** 
 252:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 253:./lwip-2.1.2/src/api/tcpip.c **** 
 254:./lwip-2.1.2/src/api/tcpip.c ****   msg = (struct tcpip_msg *)memp_malloc(MEMP_TCPIP_MSG_INPKT);
 255:./lwip-2.1.2/src/api/tcpip.c ****   if (msg == NULL) {
 256:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 257:./lwip-2.1.2/src/api/tcpip.c ****   }
 258:./lwip-2.1.2/src/api/tcpip.c **** 
 259:./lwip-2.1.2/src/api/tcpip.c ****   msg->type = TCPIP_MSG_INPKT;
 260:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.inp.p = p;
 261:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.inp.netif = inp;
 262:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.inp.input_fn = input_fn;
 263:./lwip-2.1.2/src/api/tcpip.c ****   if (sys_mbox_trypost(&tcpip_mbox, msg) != ERR_OK) {
 264:./lwip-2.1.2/src/api/tcpip.c ****     memp_free(MEMP_TCPIP_MSG_INPKT, msg);
 265:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 266:./lwip-2.1.2/src/api/tcpip.c ****   }
 267:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 268:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_CORE_LOCKING_INPUT */
 269:./lwip-2.1.2/src/api/tcpip.c **** }
 270:./lwip-2.1.2/src/api/tcpip.c **** 
 271:./lwip-2.1.2/src/api/tcpip.c **** /**
 272:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 273:./lwip-2.1.2/src/api/tcpip.c ****  * Pass a received packet to tcpip_thread for input processing with
 274:./lwip-2.1.2/src/api/tcpip.c ****  * ethernet_input or ip_input. Don't call directly, pass to netif_add()
 275:./lwip-2.1.2/src/api/tcpip.c ****  * and call netif->input().
 276:./lwip-2.1.2/src/api/tcpip.c ****  *
 277:./lwip-2.1.2/src/api/tcpip.c ****  * @param p the received packet, p->payload pointing to the Ethernet header or
 278:./lwip-2.1.2/src/api/tcpip.c ****  *          to an IP header (if inp doesn't have NETIF_FLAG_ETHARP or
 279:./lwip-2.1.2/src/api/tcpip.c ****  *          NETIF_FLAG_ETHERNET flags)
 280:./lwip-2.1.2/src/api/tcpip.c ****  * @param inp the network interface on which the packet was received
 281:./lwip-2.1.2/src/api/tcpip.c ****  */
 282:./lwip-2.1.2/src/api/tcpip.c **** err_t
 283:./lwip-2.1.2/src/api/tcpip.c **** tcpip_input(struct pbuf *p, struct netif *inp)
 284:./lwip-2.1.2/src/api/tcpip.c **** {
 285:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_ETHERNET
 286:./lwip-2.1.2/src/api/tcpip.c ****   if (inp->flags & (NETIF_FLAG_ETHARP | NETIF_FLAG_ETHERNET)) {
 287:./lwip-2.1.2/src/api/tcpip.c ****     return tcpip_inpkt(p, inp, ethernet_input);
 288:./lwip-2.1.2/src/api/tcpip.c ****   } else
 289:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_ETHERNET */
 290:./lwip-2.1.2/src/api/tcpip.c ****     return tcpip_inpkt(p, inp, ip_input);
 291:./lwip-2.1.2/src/api/tcpip.c **** }
 292:./lwip-2.1.2/src/api/tcpip.c **** 
 293:./lwip-2.1.2/src/api/tcpip.c **** /**
 294:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 295:./lwip-2.1.2/src/api/tcpip.c ****  * Call a specific function in the thread context of
 296:./lwip-2.1.2/src/api/tcpip.c ****  * tcpip_thread for easy access synchronization.
 297:./lwip-2.1.2/src/api/tcpip.c ****  * A function called in that way may access lwIP core code
 298:./lwip-2.1.2/src/api/tcpip.c ****  * without fearing concurrent access.
 299:./lwip-2.1.2/src/api/tcpip.c ****  * Blocks until the request is posted.
 300:./lwip-2.1.2/src/api/tcpip.c ****  * Must not be called from interrupt context!
 301:./lwip-2.1.2/src/api/tcpip.c ****  *
 302:./lwip-2.1.2/src/api/tcpip.c ****  * @param function the function to call
 303:./lwip-2.1.2/src/api/tcpip.c ****  * @param ctx parameter passed to f
 304:./lwip-2.1.2/src/api/tcpip.c ****  * @return ERR_OK if the function was called, another err_t if not
 305:./lwip-2.1.2/src/api/tcpip.c ****  *
 306:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_try_callback
 307:./lwip-2.1.2/src/api/tcpip.c ****  */
 308:./lwip-2.1.2/src/api/tcpip.c **** err_t
 309:./lwip-2.1.2/src/api/tcpip.c **** tcpip_callback(tcpip_callback_fn function, void *ctx)
 310:./lwip-2.1.2/src/api/tcpip.c **** {
 311:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 312:./lwip-2.1.2/src/api/tcpip.c **** 
 313:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 314:./lwip-2.1.2/src/api/tcpip.c **** 
 315:./lwip-2.1.2/src/api/tcpip.c ****   msg = (struct tcpip_msg *)memp_malloc(MEMP_TCPIP_MSG_API);
 316:./lwip-2.1.2/src/api/tcpip.c ****   if (msg == NULL) {
 317:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 318:./lwip-2.1.2/src/api/tcpip.c ****   }
 319:./lwip-2.1.2/src/api/tcpip.c **** 
 320:./lwip-2.1.2/src/api/tcpip.c ****   msg->type = TCPIP_MSG_CALLBACK;
 321:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.cb.function = function;
 322:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.cb.ctx = ctx;
 323:./lwip-2.1.2/src/api/tcpip.c **** 
 324:./lwip-2.1.2/src/api/tcpip.c ****   sys_mbox_post(&tcpip_mbox, msg);
 325:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 326:./lwip-2.1.2/src/api/tcpip.c **** }
 327:./lwip-2.1.2/src/api/tcpip.c **** 
 328:./lwip-2.1.2/src/api/tcpip.c **** /**
 329:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 330:./lwip-2.1.2/src/api/tcpip.c ****  * Call a specific function in the thread context of
 331:./lwip-2.1.2/src/api/tcpip.c ****  * tcpip_thread for easy access synchronization.
 332:./lwip-2.1.2/src/api/tcpip.c ****  * A function called in that way may access lwIP core code
 333:./lwip-2.1.2/src/api/tcpip.c ****  * without fearing concurrent access.
 334:./lwip-2.1.2/src/api/tcpip.c ****  * Does NOT block when the request cannot be posted because the
 335:./lwip-2.1.2/src/api/tcpip.c ****  * tcpip_mbox is full, but returns ERR_MEM instead.
 336:./lwip-2.1.2/src/api/tcpip.c ****  * Can be called from interrupt context.
 337:./lwip-2.1.2/src/api/tcpip.c ****  *
 338:./lwip-2.1.2/src/api/tcpip.c ****  * @param function the function to call
 339:./lwip-2.1.2/src/api/tcpip.c ****  * @param ctx parameter passed to f
 340:./lwip-2.1.2/src/api/tcpip.c ****  * @return ERR_OK if the function was called, another err_t if not
 341:./lwip-2.1.2/src/api/tcpip.c ****  *
 342:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_callback
 343:./lwip-2.1.2/src/api/tcpip.c ****  */
 344:./lwip-2.1.2/src/api/tcpip.c **** err_t
 345:./lwip-2.1.2/src/api/tcpip.c **** tcpip_try_callback(tcpip_callback_fn function, void *ctx)
 346:./lwip-2.1.2/src/api/tcpip.c **** {
 347:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 348:./lwip-2.1.2/src/api/tcpip.c **** 
 349:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 350:./lwip-2.1.2/src/api/tcpip.c **** 
 351:./lwip-2.1.2/src/api/tcpip.c ****   msg = (struct tcpip_msg *)memp_malloc(MEMP_TCPIP_MSG_API);
 352:./lwip-2.1.2/src/api/tcpip.c ****   if (msg == NULL) {
 353:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 354:./lwip-2.1.2/src/api/tcpip.c ****   }
 355:./lwip-2.1.2/src/api/tcpip.c **** 
 356:./lwip-2.1.2/src/api/tcpip.c ****   msg->type = TCPIP_MSG_CALLBACK;
 357:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.cb.function = function;
 358:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.cb.ctx = ctx;
 359:./lwip-2.1.2/src/api/tcpip.c **** 
 360:./lwip-2.1.2/src/api/tcpip.c ****   if (sys_mbox_trypost(&tcpip_mbox, msg) != ERR_OK) {
 361:./lwip-2.1.2/src/api/tcpip.c ****     memp_free(MEMP_TCPIP_MSG_API, msg);
 362:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 363:./lwip-2.1.2/src/api/tcpip.c ****   }
 364:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 365:./lwip-2.1.2/src/api/tcpip.c **** }
 366:./lwip-2.1.2/src/api/tcpip.c **** 
 367:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_TIMEOUT && LWIP_TIMERS
 368:./lwip-2.1.2/src/api/tcpip.c **** /**
 369:./lwip-2.1.2/src/api/tcpip.c ****  * call sys_timeout in tcpip_thread
 370:./lwip-2.1.2/src/api/tcpip.c ****  *
 371:./lwip-2.1.2/src/api/tcpip.c ****  * @param msecs time in milliseconds for timeout
 372:./lwip-2.1.2/src/api/tcpip.c ****  * @param h function to be called on timeout
 373:./lwip-2.1.2/src/api/tcpip.c ****  * @param arg argument to pass to timeout function h
 374:./lwip-2.1.2/src/api/tcpip.c ****  * @return ERR_MEM on memory error, ERR_OK otherwise
 375:./lwip-2.1.2/src/api/tcpip.c ****  */
 376:./lwip-2.1.2/src/api/tcpip.c **** err_t
 377:./lwip-2.1.2/src/api/tcpip.c **** tcpip_timeout(u32_t msecs, sys_timeout_handler h, void *arg)
 378:./lwip-2.1.2/src/api/tcpip.c **** {
 379:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 380:./lwip-2.1.2/src/api/tcpip.c **** 
 381:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 382:./lwip-2.1.2/src/api/tcpip.c **** 
 383:./lwip-2.1.2/src/api/tcpip.c ****   msg = (struct tcpip_msg *)memp_malloc(MEMP_TCPIP_MSG_API);
 384:./lwip-2.1.2/src/api/tcpip.c ****   if (msg == NULL) {
 385:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 386:./lwip-2.1.2/src/api/tcpip.c ****   }
 387:./lwip-2.1.2/src/api/tcpip.c **** 
 388:./lwip-2.1.2/src/api/tcpip.c ****   msg->type = TCPIP_MSG_TIMEOUT;
 389:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.tmo.msecs = msecs;
 390:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.tmo.h = h;
 391:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.tmo.arg = arg;
 392:./lwip-2.1.2/src/api/tcpip.c ****   sys_mbox_post(&tcpip_mbox, msg);
 393:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 394:./lwip-2.1.2/src/api/tcpip.c **** }
 395:./lwip-2.1.2/src/api/tcpip.c **** 
 396:./lwip-2.1.2/src/api/tcpip.c **** /**
 397:./lwip-2.1.2/src/api/tcpip.c ****  * call sys_untimeout in tcpip_thread
 398:./lwip-2.1.2/src/api/tcpip.c ****  *
 399:./lwip-2.1.2/src/api/tcpip.c ****  * @param h function to be called on timeout
 400:./lwip-2.1.2/src/api/tcpip.c ****  * @param arg argument to pass to timeout function h
 401:./lwip-2.1.2/src/api/tcpip.c ****  * @return ERR_MEM on memory error, ERR_OK otherwise
 402:./lwip-2.1.2/src/api/tcpip.c ****  */
 403:./lwip-2.1.2/src/api/tcpip.c **** err_t
 404:./lwip-2.1.2/src/api/tcpip.c **** tcpip_untimeout(sys_timeout_handler h, void *arg)
 405:./lwip-2.1.2/src/api/tcpip.c **** {
 406:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg;
 407:./lwip-2.1.2/src/api/tcpip.c **** 
 408:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 409:./lwip-2.1.2/src/api/tcpip.c **** 
 410:./lwip-2.1.2/src/api/tcpip.c ****   msg = (struct tcpip_msg *)memp_malloc(MEMP_TCPIP_MSG_API);
 411:./lwip-2.1.2/src/api/tcpip.c ****   if (msg == NULL) {
 412:./lwip-2.1.2/src/api/tcpip.c ****     return ERR_MEM;
 413:./lwip-2.1.2/src/api/tcpip.c ****   }
 414:./lwip-2.1.2/src/api/tcpip.c **** 
 415:./lwip-2.1.2/src/api/tcpip.c ****   msg->type = TCPIP_MSG_UNTIMEOUT;
 416:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.tmo.h = h;
 417:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.tmo.arg = arg;
 418:./lwip-2.1.2/src/api/tcpip.c ****   sys_mbox_post(&tcpip_mbox, msg);
 419:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 420:./lwip-2.1.2/src/api/tcpip.c **** }
 421:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_TIMEOUT && LWIP_TIMERS */
 422:./lwip-2.1.2/src/api/tcpip.c **** 
 423:./lwip-2.1.2/src/api/tcpip.c **** 
 424:./lwip-2.1.2/src/api/tcpip.c **** /**
 425:./lwip-2.1.2/src/api/tcpip.c ****  * Sends a message to TCPIP thread to call a function. Caller thread blocks on
 426:./lwip-2.1.2/src/api/tcpip.c ****  * on a provided semaphore, which ist NOT automatically signalled by TCPIP thread,
 427:./lwip-2.1.2/src/api/tcpip.c ****  * this has to be done by the user.
 428:./lwip-2.1.2/src/api/tcpip.c ****  * It is recommended to use LWIP_TCPIP_CORE_LOCKING since this is the way
 429:./lwip-2.1.2/src/api/tcpip.c ****  * with least runtime overhead.
 430:./lwip-2.1.2/src/api/tcpip.c ****  *
 431:./lwip-2.1.2/src/api/tcpip.c ****  * @param fn function to be called from TCPIP thread
 432:./lwip-2.1.2/src/api/tcpip.c ****  * @param apimsg argument to API function
 433:./lwip-2.1.2/src/api/tcpip.c ****  * @param sem semaphore to wait on
 434:./lwip-2.1.2/src/api/tcpip.c ****  * @return ERR_OK if the function was called, another err_t if not
 435:./lwip-2.1.2/src/api/tcpip.c ****  */
 436:./lwip-2.1.2/src/api/tcpip.c **** err_t
 437:./lwip-2.1.2/src/api/tcpip.c **** tcpip_send_msg_wait_sem(tcpip_callback_fn fn, void *apimsg, sys_sem_t *sem)
 438:./lwip-2.1.2/src/api/tcpip.c **** {
 439:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_CORE_LOCKING
 440:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_UNUSED_ARG(sem);
 441:./lwip-2.1.2/src/api/tcpip.c ****   LOCK_TCPIP_CORE();
 442:./lwip-2.1.2/src/api/tcpip.c ****   fn(apimsg);
 443:./lwip-2.1.2/src/api/tcpip.c ****   UNLOCK_TCPIP_CORE();
 444:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 445:./lwip-2.1.2/src/api/tcpip.c **** #else /* LWIP_TCPIP_CORE_LOCKING */
 446:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_DECLARE(msg);
 447:./lwip-2.1.2/src/api/tcpip.c **** 
 448:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("semaphore not initialized", sys_sem_valid(sem));
 449:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 450:./lwip-2.1.2/src/api/tcpip.c **** 
 451:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_ALLOC(msg);
 452:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).type = TCPIP_MSG_API;
 453:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).msg.api_msg.function = fn;
 454:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).msg.api_msg.msg = apimsg;
 455:./lwip-2.1.2/src/api/tcpip.c ****   sys_mbox_post(&tcpip_mbox, &TCPIP_MSG_VAR_REF(msg));
 456:./lwip-2.1.2/src/api/tcpip.c ****   sys_arch_sem_wait(sem, 0);
 457:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_FREE(msg);
 458:./lwip-2.1.2/src/api/tcpip.c ****   return ERR_OK;
 459:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_CORE_LOCKING */
 460:./lwip-2.1.2/src/api/tcpip.c **** }
 461:./lwip-2.1.2/src/api/tcpip.c **** 
 462:./lwip-2.1.2/src/api/tcpip.c **** /**
 463:./lwip-2.1.2/src/api/tcpip.c ****  * Synchronously calls function in TCPIP thread and waits for its completion.
 464:./lwip-2.1.2/src/api/tcpip.c ****  * It is recommended to use LWIP_TCPIP_CORE_LOCKING (preferred) or
 465:./lwip-2.1.2/src/api/tcpip.c ****  * LWIP_NETCONN_SEM_PER_THREAD.
 466:./lwip-2.1.2/src/api/tcpip.c ****  * If not, a semaphore is created and destroyed on every call which is usually
 467:./lwip-2.1.2/src/api/tcpip.c ****  * an expensive/slow operation.
 468:./lwip-2.1.2/src/api/tcpip.c ****  * @param fn Function to call
 469:./lwip-2.1.2/src/api/tcpip.c ****  * @param call Call parameters
 470:./lwip-2.1.2/src/api/tcpip.c ****  * @return Return value from tcpip_api_call_fn
 471:./lwip-2.1.2/src/api/tcpip.c ****  */
 472:./lwip-2.1.2/src/api/tcpip.c **** err_t
 473:./lwip-2.1.2/src/api/tcpip.c **** tcpip_api_call(tcpip_api_call_fn fn, struct tcpip_api_call_data *call)
 474:./lwip-2.1.2/src/api/tcpip.c **** {
 475:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_CORE_LOCKING
 476:./lwip-2.1.2/src/api/tcpip.c ****   err_t err;
 477:./lwip-2.1.2/src/api/tcpip.c ****   LOCK_TCPIP_CORE();
 478:./lwip-2.1.2/src/api/tcpip.c ****   err = fn(call);
 479:./lwip-2.1.2/src/api/tcpip.c ****   UNLOCK_TCPIP_CORE();
 480:./lwip-2.1.2/src/api/tcpip.c ****   return err;
 481:./lwip-2.1.2/src/api/tcpip.c **** #else /* LWIP_TCPIP_CORE_LOCKING */
 482:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_DECLARE(msg);
 483:./lwip-2.1.2/src/api/tcpip.c **** 
 484:./lwip-2.1.2/src/api/tcpip.c **** #if !LWIP_NETCONN_SEM_PER_THREAD
 485:./lwip-2.1.2/src/api/tcpip.c ****   err_t err = sys_sem_new(&call->sem, 0);
 486:./lwip-2.1.2/src/api/tcpip.c ****   if (err != ERR_OK) {
 487:./lwip-2.1.2/src/api/tcpip.c ****     return err;
 488:./lwip-2.1.2/src/api/tcpip.c ****   }
 489:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_NETCONN_SEM_PER_THREAD */
 490:./lwip-2.1.2/src/api/tcpip.c **** 
 491:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 492:./lwip-2.1.2/src/api/tcpip.c **** 
 493:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_ALLOC(msg);
 494:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).type = TCPIP_MSG_API_CALL;
 495:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).msg.api_call.arg = call;
 496:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).msg.api_call.function = fn;
 497:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_NETCONN_SEM_PER_THREAD
 498:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).msg.api_call.sem = LWIP_NETCONN_THREAD_SEM_GET();
 499:./lwip-2.1.2/src/api/tcpip.c **** #else /* LWIP_NETCONN_SEM_PER_THREAD */
 500:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_REF(msg).msg.api_call.sem = &call->sem;
 501:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_NETCONN_SEM_PER_THREAD */
 502:./lwip-2.1.2/src/api/tcpip.c ****   sys_mbox_post(&tcpip_mbox, &TCPIP_MSG_VAR_REF(msg));
 503:./lwip-2.1.2/src/api/tcpip.c ****   sys_arch_sem_wait(TCPIP_MSG_VAR_REF(msg).msg.api_call.sem, 0);
 504:./lwip-2.1.2/src/api/tcpip.c ****   TCPIP_MSG_VAR_FREE(msg);
 505:./lwip-2.1.2/src/api/tcpip.c **** 
 506:./lwip-2.1.2/src/api/tcpip.c **** #if !LWIP_NETCONN_SEM_PER_THREAD
 507:./lwip-2.1.2/src/api/tcpip.c ****   sys_sem_free(&call->sem);
 508:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_NETCONN_SEM_PER_THREAD */
 509:./lwip-2.1.2/src/api/tcpip.c **** 
 510:./lwip-2.1.2/src/api/tcpip.c ****   return call->err;
 511:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_CORE_LOCKING */
 512:./lwip-2.1.2/src/api/tcpip.c **** }
 513:./lwip-2.1.2/src/api/tcpip.c **** 
 514:./lwip-2.1.2/src/api/tcpip.c **** /**
 515:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 516:./lwip-2.1.2/src/api/tcpip.c ****  * Allocate a structure for a static callback message and initialize it.
 517:./lwip-2.1.2/src/api/tcpip.c ****  * The message has a special type such that lwIP never frees it.
 518:./lwip-2.1.2/src/api/tcpip.c ****  * This is intended to be used to send "static" messages from interrupt context,
 519:./lwip-2.1.2/src/api/tcpip.c ****  * e.g. the message is allocated once and posted several times from an IRQ
 520:./lwip-2.1.2/src/api/tcpip.c ****  * using tcpip_callbackmsg_trycallback().
 521:./lwip-2.1.2/src/api/tcpip.c ****  * Example usage: Trigger execution of an ethernet IRQ DPC routine in lwIP thread context.
 522:./lwip-2.1.2/src/api/tcpip.c ****  * 
 523:./lwip-2.1.2/src/api/tcpip.c ****  * @param function the function to call
 524:./lwip-2.1.2/src/api/tcpip.c ****  * @param ctx parameter passed to function
 525:./lwip-2.1.2/src/api/tcpip.c ****  * @return a struct pointer to pass to tcpip_callbackmsg_trycallback().
 526:./lwip-2.1.2/src/api/tcpip.c ****  *
 527:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_callbackmsg_trycallback()
 528:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_callbackmsg_delete()
 529:./lwip-2.1.2/src/api/tcpip.c ****  */
 530:./lwip-2.1.2/src/api/tcpip.c **** struct tcpip_callback_msg *
 531:./lwip-2.1.2/src/api/tcpip.c **** tcpip_callbackmsg_new(tcpip_callback_fn function, void *ctx)
 532:./lwip-2.1.2/src/api/tcpip.c **** {
 533:./lwip-2.1.2/src/api/tcpip.c ****   struct tcpip_msg *msg = (struct tcpip_msg *)memp_malloc(MEMP_TCPIP_MSG_API);
 534:./lwip-2.1.2/src/api/tcpip.c ****   if (msg == NULL) {
 535:./lwip-2.1.2/src/api/tcpip.c ****     return NULL;
 536:./lwip-2.1.2/src/api/tcpip.c ****   }
 537:./lwip-2.1.2/src/api/tcpip.c ****   msg->type = TCPIP_MSG_CALLBACK_STATIC;
 538:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.cb.function = function;
 539:./lwip-2.1.2/src/api/tcpip.c ****   msg->msg.cb.ctx = ctx;
 540:./lwip-2.1.2/src/api/tcpip.c ****   return (struct tcpip_callback_msg *)msg;
 541:./lwip-2.1.2/src/api/tcpip.c **** }
 542:./lwip-2.1.2/src/api/tcpip.c **** 
 543:./lwip-2.1.2/src/api/tcpip.c **** /**
 544:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 545:./lwip-2.1.2/src/api/tcpip.c ****  * Free a callback message allocated by tcpip_callbackmsg_new().
 546:./lwip-2.1.2/src/api/tcpip.c ****  *
 547:./lwip-2.1.2/src/api/tcpip.c ****  * @param msg the message to free
 548:./lwip-2.1.2/src/api/tcpip.c ****  *
 549:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_callbackmsg_new()
 550:./lwip-2.1.2/src/api/tcpip.c ****  */
 551:./lwip-2.1.2/src/api/tcpip.c **** void
 552:./lwip-2.1.2/src/api/tcpip.c **** tcpip_callbackmsg_delete(struct tcpip_callback_msg *msg)
 553:./lwip-2.1.2/src/api/tcpip.c **** {
 554:./lwip-2.1.2/src/api/tcpip.c ****   memp_free(MEMP_TCPIP_MSG_API, msg);
 555:./lwip-2.1.2/src/api/tcpip.c **** }
 556:./lwip-2.1.2/src/api/tcpip.c **** 
 557:./lwip-2.1.2/src/api/tcpip.c **** /**
 558:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 559:./lwip-2.1.2/src/api/tcpip.c ****  * Try to post a callback-message to the tcpip_thread tcpip_mbox.
 560:./lwip-2.1.2/src/api/tcpip.c ****  *
 561:./lwip-2.1.2/src/api/tcpip.c ****  * @param msg pointer to the message to post
 562:./lwip-2.1.2/src/api/tcpip.c ****  * @return sys_mbox_trypost() return code
 563:./lwip-2.1.2/src/api/tcpip.c ****  *
 564:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_callbackmsg_new()
 565:./lwip-2.1.2/src/api/tcpip.c ****  */
 566:./lwip-2.1.2/src/api/tcpip.c **** err_t
 567:./lwip-2.1.2/src/api/tcpip.c **** tcpip_callbackmsg_trycallback(struct tcpip_callback_msg *msg)
 568:./lwip-2.1.2/src/api/tcpip.c **** {
 569:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 570:./lwip-2.1.2/src/api/tcpip.c ****   return sys_mbox_trypost(&tcpip_mbox, msg);
 571:./lwip-2.1.2/src/api/tcpip.c **** }
 572:./lwip-2.1.2/src/api/tcpip.c **** 
 573:./lwip-2.1.2/src/api/tcpip.c **** /**
 574:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 575:./lwip-2.1.2/src/api/tcpip.c ****  * Try to post a callback-message to the tcpip_thread mbox.
 576:./lwip-2.1.2/src/api/tcpip.c ****  * Same as @ref tcpip_callbackmsg_trycallback but calls sys_mbox_trypost_fromisr(),
 577:./lwip-2.1.2/src/api/tcpip.c ****  * mainly to help FreeRTOS, where calls differ between task level and ISR level.
 578:./lwip-2.1.2/src/api/tcpip.c ****  *
 579:./lwip-2.1.2/src/api/tcpip.c ****  * @param msg pointer to the message to post
 580:./lwip-2.1.2/src/api/tcpip.c ****  * @return sys_mbox_trypost_fromisr() return code (without change, so this
 581:./lwip-2.1.2/src/api/tcpip.c ****  *         knowledge can be used to e.g. propagate "bool needs_scheduling")
 582:./lwip-2.1.2/src/api/tcpip.c ****  *
 583:./lwip-2.1.2/src/api/tcpip.c ****  * @see tcpip_callbackmsg_new()
 584:./lwip-2.1.2/src/api/tcpip.c ****  */
 585:./lwip-2.1.2/src/api/tcpip.c **** err_t
 586:./lwip-2.1.2/src/api/tcpip.c **** tcpip_callbackmsg_trycallback_fromisr(struct tcpip_callback_msg *msg)
 587:./lwip-2.1.2/src/api/tcpip.c **** {
 588:./lwip-2.1.2/src/api/tcpip.c ****   LWIP_ASSERT("Invalid mbox", sys_mbox_valid_val(tcpip_mbox));
 589:./lwip-2.1.2/src/api/tcpip.c ****   return sys_mbox_trypost_fromisr(&tcpip_mbox, msg);
 590:./lwip-2.1.2/src/api/tcpip.c **** }
 591:./lwip-2.1.2/src/api/tcpip.c **** 
 592:./lwip-2.1.2/src/api/tcpip.c **** /**
 593:./lwip-2.1.2/src/api/tcpip.c ****  * @ingroup lwip_os
 594:./lwip-2.1.2/src/api/tcpip.c ****  * Initialize this module:
 595:./lwip-2.1.2/src/api/tcpip.c ****  * - initialize all sub modules
 596:./lwip-2.1.2/src/api/tcpip.c ****  * - start the tcpip_thread
 597:./lwip-2.1.2/src/api/tcpip.c ****  *
 598:./lwip-2.1.2/src/api/tcpip.c ****  * @param initfunc a function to call when tcpip_thread is running and finished initializing
 599:./lwip-2.1.2/src/api/tcpip.c ****  * @param arg argument to pass to initfunc
 600:./lwip-2.1.2/src/api/tcpip.c ****  */
 601:./lwip-2.1.2/src/api/tcpip.c **** void
 602:./lwip-2.1.2/src/api/tcpip.c **** tcpip_init(tcpip_init_done_fn initfunc, void *arg)
 603:./lwip-2.1.2/src/api/tcpip.c **** {
 604:./lwip-2.1.2/src/api/tcpip.c ****   lwip_init();
 605:./lwip-2.1.2/src/api/tcpip.c **** 
 606:./lwip-2.1.2/src/api/tcpip.c ****   tcpip_init_done = initfunc;
 607:./lwip-2.1.2/src/api/tcpip.c ****   tcpip_init_done_arg = arg;
 608:./lwip-2.1.2/src/api/tcpip.c ****   if (sys_mbox_new(&tcpip_mbox, TCPIP_MBOX_SIZE) != ERR_OK) {
 609:./lwip-2.1.2/src/api/tcpip.c ****     LWIP_ASSERT("failed to create tcpip_thread mbox", 0);
 610:./lwip-2.1.2/src/api/tcpip.c ****   }
 611:./lwip-2.1.2/src/api/tcpip.c **** #if LWIP_TCPIP_CORE_LOCKING
 612:./lwip-2.1.2/src/api/tcpip.c ****   if (sys_mutex_new(&lock_tcpip_core) != ERR_OK) {
 613:./lwip-2.1.2/src/api/tcpip.c ****     LWIP_ASSERT("failed to create lock_tcpip_core", 0);
 614:./lwip-2.1.2/src/api/tcpip.c ****   }
 615:./lwip-2.1.2/src/api/tcpip.c **** #endif /* LWIP_TCPIP_CORE_LOCKING */
 616:./lwip-2.1.2/src/api/tcpip.c **** 
 617:./lwip-2.1.2/src/api/tcpip.c ****   sys_thread_new(TCPIP_THREAD_NAME, tcpip_thread, NULL, TCPIP_THREAD_STACKSIZE, TCPIP_THREAD_PRIO);
 618:./lwip-2.1.2/src/api/tcpip.c **** }
 619:./lwip-2.1.2/src/api/tcpip.c **** 

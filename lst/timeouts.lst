 135:./lwip-2.1.2/src/core/timeouts.c **** /** global variable that shows if the tcp timer is currently scheduled or not */
 136:./lwip-2.1.2/src/core/timeouts.c **** static int tcpip_tcp_timer_active;
 137:./lwip-2.1.2/src/core/timeouts.c **** 
 138:./lwip-2.1.2/src/core/timeouts.c **** /**
 139:./lwip-2.1.2/src/core/timeouts.c ****  * Timer callback function that calls tcp_tmr() and reschedules itself.
 140:./lwip-2.1.2/src/core/timeouts.c ****  *
 141:./lwip-2.1.2/src/core/timeouts.c ****  * @param arg unused argument
 142:./lwip-2.1.2/src/core/timeouts.c ****  */
 143:./lwip-2.1.2/src/core/timeouts.c **** static void
 144:./lwip-2.1.2/src/core/timeouts.c **** tcpip_tcp_timer(void *arg)
 145:./lwip-2.1.2/src/core/timeouts.c **** {
 146:./lwip-2.1.2/src/core/timeouts.c ****   LWIP_UNUSED_ARG(arg);
 147:./lwip-2.1.2/src/core/timeouts.c **** 
 148:./lwip-2.1.2/src/core/timeouts.c ****   /* call TCP timer handler */
 149:./lwip-2.1.2/src/core/timeouts.c ****   tcp_tmr();
 150:./lwip-2.1.2/src/core/timeouts.c ****   /* timer still needed? */
 151:./lwip-2.1.2/src/core/timeouts.c ****   if (tcp_active_pcbs || tcp_tw_pcbs) {
 152:./lwip-2.1.2/src/core/timeouts.c ****     /* restart timer */
 153:./lwip-2.1.2/src/core/timeouts.c ****     sys_timeout(TCP_TMR_INTERVAL, tcpip_tcp_timer, NULL);
 154:./lwip-2.1.2/src/core/timeouts.c ****   } else {
 155:./lwip-2.1.2/src/core/timeouts.c ****     /* disable timer */
 156:./lwip-2.1.2/src/core/timeouts.c ****     tcpip_tcp_timer_active = 0;
 157:./lwip-2.1.2/src/core/timeouts.c ****   }
 158:./lwip-2.1.2/src/core/timeouts.c **** }
 159:./lwip-2.1.2/src/core/timeouts.c **** 
 160:./lwip-2.1.2/src/core/timeouts.c **** /**
 161:./lwip-2.1.2/src/core/timeouts.c ****  * Called from TCP_REG when registering a new PCB:
 162:./lwip-2.1.2/src/core/timeouts.c ****  * the reason is to have the TCP timer only running when
 163:./lwip-2.1.2/src/core/timeouts.c ****  * there are active (or time-wait) PCBs.
 164:./lwip-2.1.2/src/core/timeouts.c ****  */
 165:./lwip-2.1.2/src/core/timeouts.c **** void
 166:./lwip-2.1.2/src/core/timeouts.c **** tcp_timer_needed(void)
 167:./lwip-2.1.2/src/core/timeouts.c **** {
 168:./lwip-2.1.2/src/core/timeouts.c ****   LWIP_ASSERT_CORE_LOCKED();
 169:./lwip-2.1.2/src/core/timeouts.c **** 
 170:./lwip-2.1.2/src/core/timeouts.c ****   /* timer is off but needed again? */
 171:./lwip-2.1.2/src/core/timeouts.c ****   if (!tcpip_tcp_timer_active && (tcp_active_pcbs || tcp_tw_pcbs)) {
 172:./lwip-2.1.2/src/core/timeouts.c ****     /* enable and start timer */
 173:./lwip-2.1.2/src/core/timeouts.c ****     tcpip_tcp_timer_active = 1;
 174:./lwip-2.1.2/src/core/timeouts.c ****     sys_timeout(TCP_TMR_INTERVAL, tcpip_tcp_timer, NULL);
 175:./lwip-2.1.2/src/core/timeouts.c ****   }
 176:./lwip-2.1.2/src/core/timeouts.c **** }
 177:./lwip-2.1.2/src/core/timeouts.c **** #endif /* LWIP_TCP */

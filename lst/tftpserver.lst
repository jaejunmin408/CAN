 271:./inc/core_cm7.h **** /**
 272:./inc/core_cm7.h ****   \brief  Union type to access the Application Program Status Register (APSR).
 273:./inc/core_cm7.h ****  */
 274:./inc/core_cm7.h **** typedef union
 275:./inc/core_cm7.h **** {
 276:./inc/core_cm7.h ****   struct
 277:./inc/core_cm7.h ****   {
 278:./inc/core_cm7.h ****     uint32_t _reserved0:16;              /*!< bit:  0..15  Reserved */
 279:./inc/core_cm7.h ****     uint32_t GE:4;                       /*!< bit: 16..19  Greater than or Equal flags */
 280:./inc/core_cm7.h ****     uint32_t _reserved1:7;               /*!< bit: 20..26  Reserved */
 281:./inc/core_cm7.h ****     uint32_t Q:1;                        /*!< bit:     27  Saturation condition flag */
 282:./inc/core_cm7.h ****     uint32_t V:1;                        /*!< bit:     28  Overflow condition code flag */
 283:./inc/core_cm7.h ****     uint32_t C:1;                        /*!< bit:     29  Carry condition code flag */
 284:./inc/core_cm7.h ****     uint32_t Z:1;                        /*!< bit:     30  Zero condition code flag */
 285:./inc/core_cm7.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 286:./inc/core_cm7.h ****   } b;                                   /*!< Structure used for bit  access */
 287:./inc/core_cm7.h ****   uint32_t w;                            /*!< Type      used for word access */
 288:./inc/core_cm7.h **** } APSR_Type;
 289:./inc/core_cm7.h **** 
 290:./inc/core_cm7.h **** /* APSR Register Definitions */
 291:./inc/core_cm7.h **** #define APSR_N_Pos                         31U                                            /*!< APSR
 292:./inc/core_cm7.h **** #define APSR_N_Msk                         (1UL << APSR_N_Pos)                            /*!< APSR
 293:./inc/core_cm7.h **** 
 294:./inc/core_cm7.h **** #define APSR_Z_Pos                         30U                                            /*!< APSR
 295:./inc/core_cm7.h **** #define APSR_Z_Msk                         (1UL << APSR_Z_Pos)                            /*!< APSR
 296:./inc/core_cm7.h **** 
 297:./inc/core_cm7.h **** #define APSR_C_Pos                         29U                                            /*!< APSR
 298:./inc/core_cm7.h **** #define APSR_C_Msk                         (1UL << APSR_C_Pos)                            /*!< APSR
 299:./inc/core_cm7.h **** 
 300:./inc/core_cm7.h **** #define APSR_V_Pos                         28U                                            /*!< APSR
 301:./inc/core_cm7.h **** #define APSR_V_Msk                         (1UL << APSR_V_Pos)                            /*!< APSR
 302:./inc/core_cm7.h **** 
 303:./inc/core_cm7.h **** #define APSR_Q_Pos                         27U                                            /*!< APSR
 304:./inc/core_cm7.h **** #define APSR_Q_Msk                         (1UL << APSR_Q_Pos)                            /*!< APSR
 305:./inc/core_cm7.h **** 
 306:./inc/core_cm7.h **** #define APSR_GE_Pos                        16U                                            /*!< APSR
 307:./inc/core_cm7.h **** #define APSR_GE_Msk                        (0xFUL << APSR_GE_Pos)                         /*!< APSR
 308:./inc/core_cm7.h **** 
 309:./inc/core_cm7.h **** 
 310:./inc/core_cm7.h **** /**
 311:./inc/core_cm7.h ****   \brief  Union type to access the Interrupt Program Status Register (IPSR).
 312:./inc/core_cm7.h ****  */
 313:./inc/core_cm7.h **** typedef union
 314:./inc/core_cm7.h **** {
 315:./inc/core_cm7.h ****   struct
 316:./inc/core_cm7.h ****   {
 317:./inc/core_cm7.h ****     uint32_t ISR:9;                      /*!< bit:  0.. 8  Exception number */
 318:./inc/core_cm7.h ****     uint32_t _reserved0:23;              /*!< bit:  9..31  Reserved */
 319:./inc/core_cm7.h ****   } b;                                   /*!< Structure used for bit  access */
 320:./inc/core_cm7.h ****   uint32_t w;                            /*!< Type      used for word access */
 321:./inc/core_cm7.h **** } IPSR_Type;
 322:./inc/core_cm7.h **** 
 323:./inc/core_cm7.h **** /* IPSR Register Definitions */
 324:./inc/core_cm7.h **** #define IPSR_ISR_Pos                        0U                                            /*!< IPSR
 325:./inc/core_cm7.h **** #define IPSR_ISR_Msk                       (0x1FFUL /*<< IPSR_ISR_Pos*/)                  /*!< IPSR
 326:./inc/core_cm7.h **** 
 327:./inc/core_cm7.h **** 
 328:./inc/core_cm7.h **** /**
 329:./inc/core_cm7.h ****   \brief  Union type to access the Special-Purpose Program Status Registers (xPSR).
 330:./inc/core_cm7.h ****  */
 331:./inc/core_cm7.h **** typedef union
 332:./inc/core_cm7.h **** {
 333:./inc/core_cm7.h ****   struct
 334:./inc/core_cm7.h ****   {
 335:./inc/core_cm7.h ****     uint32_t ISR:9;                      /*!< bit:  0.. 8  Exception number */
 336:./inc/core_cm7.h ****     uint32_t _reserved0:1;               /*!< bit:      9  Reserved */
 337:./inc/core_cm7.h ****     uint32_t ICI_IT_1:6;                 /*!< bit: 10..15  ICI/IT part 1 */
 338:./inc/core_cm7.h ****     uint32_t GE:4;                       /*!< bit: 16..19  Greater than or Equal flags */
 339:./inc/core_cm7.h ****     uint32_t _reserved1:4;               /*!< bit: 20..23  Reserved */
 340:./inc/core_cm7.h ****     uint32_t T:1;                        /*!< bit:     24  Thumb bit */
 341:./inc/core_cm7.h ****     uint32_t ICI_IT_2:2;                 /*!< bit: 25..26  ICI/IT part 2 */
 342:./inc/core_cm7.h ****     uint32_t Q:1;                        /*!< bit:     27  Saturation condition flag */
 343:./inc/core_cm7.h ****     uint32_t V:1;                        /*!< bit:     28  Overflow condition code flag */
 344:./inc/core_cm7.h ****     uint32_t C:1;                        /*!< bit:     29  Carry condition code flag */
 345:./inc/core_cm7.h ****     uint32_t Z:1;                        /*!< bit:     30  Zero condition code flag */
 346:./inc/core_cm7.h ****     uint32_t N:1;                        /*!< bit:     31  Negative condition code flag */
 347:./inc/core_cm7.h ****   } b;                                   /*!< Structure used for bit  access */
 348:./inc/core_cm7.h ****   uint32_t w;                            /*!< Type      used for word access */
 349:./inc/core_cm7.h **** } xPSR_Type;
 350:./inc/core_cm7.h **** 
 351:./inc/core_cm7.h **** /* xPSR Register Definitions */
 352:./inc/core_cm7.h **** #define xPSR_N_Pos                         31U                                            /*!< xPSR
 353:./inc/core_cm7.h **** #define xPSR_N_Msk                         (1UL << xPSR_N_Pos)                            /*!< xPSR
 354:./inc/core_cm7.h **** 
 355:./inc/core_cm7.h **** #define xPSR_Z_Pos                         30U                                            /*!< xPSR
 356:./inc/core_cm7.h **** #define xPSR_Z_Msk                         (1UL << xPSR_Z_Pos)                            /*!< xPSR
 357:./inc/core_cm7.h **** 
 358:./inc/core_cm7.h **** #define xPSR_C_Pos                         29U                                            /*!< xPSR
 359:./inc/core_cm7.h **** #define xPSR_C_Msk                         (1UL << xPSR_C_Pos)                            /*!< xPSR
 360:./inc/core_cm7.h **** 
 361:./inc/core_cm7.h **** #define xPSR_V_Pos                         28U                                            /*!< xPSR
 362:./inc/core_cm7.h **** #define xPSR_V_Msk                         (1UL << xPSR_V_Pos)                            /*!< xPSR
 363:./inc/core_cm7.h **** 
 364:./inc/core_cm7.h **** #define xPSR_Q_Pos                         27U                                            /*!< xPSR
 365:./inc/core_cm7.h **** #define xPSR_Q_Msk                         (1UL << xPSR_Q_Pos)                            /*!< xPSR
 366:./inc/core_cm7.h **** 
 367:./inc/core_cm7.h **** #define xPSR_ICI_IT_2_Pos                  25U                                            /*!< xPSR
 368:./inc/core_cm7.h **** #define xPSR_ICI_IT_2_Msk                  (3UL << xPSR_ICI_IT_2_Pos)                     /*!< xPSR
 369:./inc/core_cm7.h **** 
 370:./inc/core_cm7.h **** #define xPSR_T_Pos                         24U                                            /*!< xPSR
 371:./inc/core_cm7.h **** #define xPSR_T_Msk                         (1UL << xPSR_T_Pos)                            /*!< xPSR
 372:./inc/core_cm7.h **** 
 373:./inc/core_cm7.h **** #define xPSR_GE_Pos                        16U                                            /*!< xPSR
 374:./inc/core_cm7.h **** #define xPSR_GE_Msk                        (0xFUL << xPSR_GE_Pos)                         /*!< xPSR
 375:./inc/core_cm7.h **** 
 376:./inc/core_cm7.h **** #define xPSR_ICI_IT_1_Pos                  10U                                            /*!< xPSR
 377:./inc/core_cm7.h **** #define xPSR_ICI_IT_1_Msk                  (0x3FUL << xPSR_ICI_IT_1_Pos)                  /*!< xPSR
 378:./inc/core_cm7.h **** 
 379:./inc/core_cm7.h **** #define xPSR_ISR_Pos                        0U                                            /*!< xPSR
 380:./inc/core_cm7.h **** #define xPSR_ISR_Msk                       (0x1FFUL /*<< xPSR_ISR_Pos*/)                  /*!< xPSR
 381:./inc/core_cm7.h **** 

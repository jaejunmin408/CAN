 383:./inc/core_cm7.h **** /**
 384:./inc/core_cm7.h ****   \brief  Union type to access the Control Registers (CONTROL).
 385:./inc/core_cm7.h ****  */
 386:./inc/core_cm7.h **** typedef union
 387:./inc/core_cm7.h **** {
 388:./inc/core_cm7.h ****   struct
 389:./inc/core_cm7.h ****   {
 390:./inc/core_cm7.h ****     uint32_t nPRIV:1;                    /*!< bit:      0  Execution privilege in Thread mode */
 391:./inc/core_cm7.h ****     uint32_t SPSEL:1;                    /*!< bit:      1  Stack to be used */
 392:./inc/core_cm7.h ****     uint32_t FPCA:1;                     /*!< bit:      2  FP extension active flag */
 393:./inc/core_cm7.h ****     uint32_t _reserved0:29;              /*!< bit:  3..31  Reserved */
 394:./inc/core_cm7.h ****   } b;                                   /*!< Structure used for bit  access */
 395:./inc/core_cm7.h ****   uint32_t w;                            /*!< Type      used for word access */
 396:./inc/core_cm7.h **** } CONTROL_Type;

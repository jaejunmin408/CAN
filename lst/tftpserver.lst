 144:./inc/core_cm7.h ****   #else
 145:./inc/core_cm7.h ****     #define __FPU_USED         0U
 146:./inc/core_cm7.h ****   #endif
 147:./inc/core_cm7.h **** 
 148:./inc/core_cm7.h **** #elif defined ( __CSMC__ )
 149:./inc/core_cm7.h ****   #if ( __CSMC__ & 0x400U)
 150:./inc/core_cm7.h ****     #if defined (__FPU_PRESENT) && (__FPU_PRESENT == 1U)
 151:./inc/core_cm7.h ****       #define __FPU_USED       1U
 152:./inc/core_cm7.h ****     #else
 153:./inc/core_cm7.h ****       #error "Compiler generates FPU instructions for a device without an FPU (check __FPU_PRESENT)
 154:./inc/core_cm7.h ****       #define __FPU_USED       0U
 155:./inc/core_cm7.h ****     #endif
 156:./inc/core_cm7.h ****   #else
 157:./inc/core_cm7.h ****     #define __FPU_USED         0U
 158:./inc/core_cm7.h ****   #endif
 159:./inc/core_cm7.h **** 
 160:./inc/core_cm7.h **** #endif
 161:./inc/core_cm7.h **** 

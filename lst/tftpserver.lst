 199:./inc/cmsis_gcc.h **** }
 200:./inc/cmsis_gcc.h **** 
 201:./inc/cmsis_gcc.h **** 
 202:./inc/cmsis_gcc.h **** /**
 203:./inc/cmsis_gcc.h ****   \brief   Disable IRQ Interrupts

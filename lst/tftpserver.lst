 353:./src/tftpserver.c ****   * @param  pbuf: pointer on packet buffer
 354:./src/tftpserver.c ****   * @param  addr: pointer on the receive IP address
 355:./src/tftpserver.c ****   * @param  port: receive port number
 356:./src/tftpserver.c ****   * @retval None
 357:./src/tftpserver.c ****   */
 358:./src/tftpserver.c **** static void IAP_tftp_recv_callback(void *arg, struct udp_pcb *upcb, struct pbuf *pkt_buf,
 359:./src/tftpserver.c ****                         const ip_addr_t *addr, u16_t port)
 360:./src/tftpserver.c **** {
 361:./src/tftpserver.c **** 
 362:./src/tftpserver.c ****     char tmp1[40], tmp2[40];
 363:./src/tftpserver.c ****     if (TAG_ADDRESS->valid_flag == 0xA5A5A5A5) {
 364:./src/tftpserver.c ****       static uint32_t Flash_Write_Address2;
 365:./src/tftpserver.c **** 
 366:./src/tftpserver.c ****       sprintf(tmp1, "[BOOT]  Backup : %s\n",TAG_ADDRESS->filename);
 367:./src/tftpserver.c ****       udp_client_send(tmp1);
 368:./src/tftpserver.c ****       HAL_FLASH_Unlock();
 369:./src/tftpserver.c ****   	  FLASH_Backup_Erase(BACKUP_FLASH_FIRST_PAGE_ADDRESS);
 370:./src/tftpserver.c **** 
 371:./src/tftpserver.c ****   	  Flash_Write_Address2 = BACKUP_FLASH_FIRST_PAGE_ADDRESS;
 372:./src/tftpserver.c ****   	  uint32_t *src_data = (uint32_t*)USER_FLASH_FIRST_PAGE_ADDRESS;
 373:./src/tftpserver.c ****   	  uint16_t data_len = ( TAG_ADDRESS->size + 1024 ) / 4;
 374:./src/tftpserver.c ****   	  uint32_t result = FLASH_If_Write(&Flash_Write_Address2, src_data ,data_len);
 375:./src/tftpserver.c ****   	  if( result != 0)
 376:./src/tftpserver.c ****   		  {
 377:./src/tftpserver.c ****           sprintf(tmp2, "[BOOT]  fail Backup, error : %lu\n", result);
 378:./src/tftpserver.c ****           udp_client_send(tmp2);
 379:./src/tftpserver.c ****   		  }
 380:./src/tftpserver.c ****   	  else
 381:./src/tftpserver.c ****   		  {
 382:./src/tftpserver.c ****   			  //printf("[BOOT]  success backup\n");
 383:./src/tftpserver.c ****   		  }
 384:./src/tftpserver.c ****   	  }
 385:./src/tftpserver.c ****   tftp_opcode op;
 386:./src/tftpserver.c ****   struct udp_pcb *upcb_tftp_data;
 387:./src/tftpserver.c ****   err_t err;
 388:./src/tftpserver.c **** 
 389:./src/tftpserver.c **** #ifdef USE_PRINT
 390:./src/tftpserver.c ****   uint32_t i;
 391:./src/tftpserver.c ****   char filename[40],message[46], *ptr;
 392:./src/tftpserver.c **** #endif
 393:./src/tftpserver.c **** 
 394:./src/tftpserver.c ****   /* create new UDP PCB structure */
 395:./src/tftpserver.c ****   upcb_tftp_data = udp_new();
 396:./src/tftpserver.c ****   if (!upcb_tftp_data)
 397:./src/tftpserver.c ****   {
 398:./src/tftpserver.c ****     /* Error creating PCB. Out of Memory  */
 399:./src/tftpserver.c **** #ifdef USE_PRINT
 400:./src/tftpserver.c ****     udp_client_send("Can not create pcb1 \n");
 401:./src/tftpserver.c **** #endif
 402:./src/tftpserver.c ****     return;
 403:./src/tftpserver.c ****   }
 404:./src/tftpserver.c **** 
 405:./src/tftpserver.c ****   /* bind to port 0 to receive next available free port */
 406:./src/tftpserver.c ****   /* NOTE:  This is how TFTP works.  There is a UDP PCB for the standard port
 407:./src/tftpserver.c ****   * 69 which al transactions begin communication on, however, _all_ subsequent
 408:./src/tftpserver.c ****   * transactions for a given "stream" occur on another port  */
 409:./src/tftpserver.c ****   err = udp_bind(upcb_tftp_data, IP_ADDR_ANY, 0);
 410:./src/tftpserver.c ****   if (err != ERR_OK)
 411:./src/tftpserver.c ****   {
 412:./src/tftpserver.c ****     /* Unable to bind to port */
 413:./src/tftpserver.c **** #ifdef USE_PRINT
 414:./src/tftpserver.c ****     udp_client_send("Can not create pcb2 \n");
 415:./src/tftpserver.c **** #endif
 416:./src/tftpserver.c ****     return;
 417:./src/tftpserver.c ****   }
 418:./src/tftpserver.c **** 
 419:./src/tftpserver.c ****   op = IAP_tftp_decode_op(pkt_buf->payload);
 420:./src/tftpserver.c ****   if (op != TFTP_WRQ)
 421:./src/tftpserver.c ****   {
 422:./src/tftpserver.c ****     /* remove PCB */
 423:./src/tftpserver.c **** #ifdef USE_PRINT
 424:./src/tftpserver.c ****     udp_client_send("Bad TFTP opcode \n");
 425:./src/tftpserver.c **** #endif
 426:./src/tftpserver.c ****     udp_remove(upcb_tftp_data);
 427:./src/tftpserver.c ****   }
 428:./src/tftpserver.c ****   else
 429:./src/tftpserver.c ****   {
 430:./src/tftpserver.c ****     
 431:./src/tftpserver.c **** #ifdef USE_PRINT
 432:./src/tftpserver.c ****     ptr = pkt_buf->payload;
 433:./src/tftpserver.c ****     ptr = ptr +2;
 434:./src/tftpserver.c ****     /*extract file name info */
 435:./src/tftpserver.c ****     i= 0;
 436:./src/tftpserver.c ****     while (*(ptr+i)!=0x0)
 437:./src/tftpserver.c ****     {
 438:./src/tftpserver.c ****       i++;
 439:./src/tftpserver.c ****     }
 440:./src/tftpserver.c ****     strncpy(filename, ptr, i+1);
 441:./src/tftpserver.c **** 
 442:./src/tftpserver.c ****     sprintf(message, "[BOOT]  New : %s\n",filename);
 443:./src/tftpserver.c ****     udp_client_send(message);
 444:./src/tftpserver.c **** #endif
 445:./src/tftpserver.c ****      
 446:./src/tftpserver.c ****     /* Start the TFTP write mode*/
 447:./src/tftpserver.c ****     IAP_tftp_process_write(upcb_tftp_data, addr, port);
 448:./src/tftpserver.c ****   }
 449:./src/tftpserver.c ****   pbuf_free(pkt_buf);
 450:./src/tftpserver.c **** }

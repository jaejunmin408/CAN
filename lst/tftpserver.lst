 438:./inc/core_cm7.h **** /* Software Triggered Interrupt Register Definitions */
 439:./inc/core_cm7.h **** #define NVIC_STIR_INTID_Pos                 0U                                         /*!< STIR: I
 440:./inc/core_cm7.h **** #define NVIC_STIR_INTID_Msk                (0x1FFUL /*<< NVIC_STIR_INTID_Pos*/)        /*!< STIR: I
 441:./inc/core_cm7.h **** 
 442:./inc/core_cm7.h **** /*@} end of group CMSIS_NVIC */
